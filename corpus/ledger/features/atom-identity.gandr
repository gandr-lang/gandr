/// `atom-identity`: Identity at a sealed type.
/// Implemented: a sealed type's interface names its identity, a reflexive relation whose singletons contract onto reflexivity; based path induction runs over its evidence in a family reading neither entry, and in families of identities at the atom whose relation returns the unit's code or an identity of it.
/// Not implemented: J along a lawful atom's evidence into a product fibre, a computed relation or a higher representation.
///
/// - owes: #2053
/// - see: #1854 — `carriedAlong`
/// - see: #1937 — `backAlong`
/// - see: #1960 — `overAlong`, `pathContraction`, `pathBack`
/// - see: #1959 — `pathRelated`
//! A sealed atom whose type member states an identity system: a relation, its
//! reflexivity and the transport law contracting the singleton of each point
//! onto its reflexivity. The relation is then the atom's identity type, so its
//! evidence between two points is a path between them
//! [Program-2013-homotopy_type_theory_univalent_foundations_mathematics], §
//! 5.8, Theorem 5.8.2.
//!
//! - cites: [Program-2013-homotopy_type_theory_univalent_foundations_mathematics]
//!
//! [Program-2013-homotopy_type_theory_univalent_foundations_mathematics]: https://arxiv.org/abs/1308.0729 "Univalent Foundations Program, Homotopy Type Theory: Univalent Foundations of Mathematics"

/// Any two points of the unit type are related, by the unit type.
@[ checks ]
def related(a : Unit, b : Unit) -> Type { return Unit }

/// Every point is related to itself.
@[ checks ]
def reflexivity(a : Unit) -> related(a, a) { unit }

/// The transport law: each point `b` that `a` relates to, with its evidence,
/// is the centre `a` with its reflexivity (Theorem 5.8.2, (iv)).
@[ checks ]
def contraction(a : Unit, b : Unit, r : related(a, b)) -> Path[.A = #{ y : Unit, s : related(a, y) }](
  (b, r),
  (a, reflexivity(a))
) { (unit, unit) }

/// The unit type sealed, relating its points by `related`.
module Point :> #{ type T, origin : T, other : T } where {
  /// The sealed points, whose identity is the relation `related`.
  @[ identity((related, reflexivity, contraction)) ]
  @[ checks ]
  type T = Unit;

  /// One point.
  @[ checks ]
  def origin = unit;

  /// Another point, related to the first.
  @[ checks ]
  def other = unit;
}

/// The relation's evidence between two sealed points is a path between them.
@[ checks ]
def originOther : Path(Point.origin, Point.other) = unit ;

/// Based path induction along that evidence, in a family that reads neither
/// the point nor the path: the evidence is no reflexivity, and the transport
/// returns the element given.
@[ checks ]
def carriedAlong : Path(
  Path.walk(
    (y : Point.T, Path[.A = Point.T](Point.origin, y)) => Unit,
    originOther,
    Path.here(Point.origin),
    Path.here(originOther),
    unit
  ),
  unit
) = Path.here(unit) ;

/// Based path induction at the sealed type (the HoTT book's § 1.12.1): a
/// path from `origin` reversed by transport in the family of paths back to
/// `origin`, reflexivity at `origin` carried to the path's end.
@[ checks ]
def backToOrigin(
  b : Point.T,
  q : Path(Point.origin, b)
) -> Path(b, Point.origin) {
  Path.walk(
    (y : Point.T, Path[.A = Point.T](Point.origin, y)) => Path[.A = Point.T](y, Point.origin),
    q,
    Path.here(Point.origin),
    Path.here(q),
    Path.here(Point.origin)
  )
}

/// Based path induction in the family of paths back to `origin`, along the
/// relation's evidence: each fibre of the family is the relation's, the unit
/// type, so the transport is that type's one inhabitant.
@[ checks ]
def backAlong : Path[.A = Path[.A = Point.T](Point.other, Point.origin)](
  Path.walk(
    (y : Point.T, Path[.A = Point.T](Point.origin, y)) => Path[.A = Point.T](y, Point.origin),
    originOther,
    Path.here(Point.origin),
    Path.here(originOther),
    Path.here(Point.origin)
  ),
  unit
) = Path.here(unit) ;

/// Based path induction along the evidence in the family of the identities
/// of the singleton's own paths: each fibre is an identity of the relation's,
/// the unit type, and so the unit type too.
@[ checks ]
def overAlong : Path[.A = Path[.A = Path[.A = Point.T](Point.origin, Point.other)](originOther, originOther)](
  Path.walk(
    (y : Point.T, z : Path[.A = Point.T](Point.origin, y)) => Path[.A = Path[.A = Point.T](Point.origin, y)](
      z,
      z
    ),
    originOther,
    Path.here(Point.origin),
    Path.here(originOther),
    Path.here(Path.here(Point.origin))
  ),
  unit
) = Path.here(unit) ;

/// Two points of the unit type, related by the paths between them: each
/// fibre of this relation is an identity of the unit type, not the unit type
/// itself.
@[ checks ]
def pathRelated(a : Unit, b : Unit) -> Type { return type(Path[.A = Unit](a, b)) }

/// Every point related to itself by its reflexivity.
@[ checks ]
def pathReflexivity(a : Unit) -> pathRelated(a, a) { Path.here(a) }

/// The transport law at the paths of the unit type: an identity of the
/// unit type, and one over it, is the unit.
@[ checks ]
def pathContraction(a : Unit, b : Unit, r : pathRelated(a, b)) -> Path[.A = #{ y : Unit, s : pathRelated(a, y) }](
  (b, r),
  (a, pathReflexivity(a))
) { (unit, unit) }

/// The unit type sealed, relating its points by the paths between them.
module PathPoint :> #{ type T, origin : T, other : T } where {
  /// The sealed points, whose identity is the relation `pathRelated`.
  @[ identity((pathRelated, pathReflexivity, pathContraction)) ]
  @[ checks ]
  type T = Unit;

  /// One point.
  @[ checks ]
  def origin = unit;

  /// Another point, related to the first.
  @[ checks ]
  def other = unit;
}

/// The relation's evidence between the two points: a path of the unit type,
/// which is the unit.
@[ checks ]
def pathOriginOther : Path(PathPoint.origin, PathPoint.other) = unit ;

/// Based path induction along that evidence in the family of paths back to
/// `origin`: each fibre is the relation's, an identity of the unit type, so
/// the transport is the unit.
@[ checks ]
def pathBack : Path[.A = Path[.A = PathPoint.T](PathPoint.other, PathPoint.origin)](
  Path.walk(
    (y : PathPoint.T, Path[.A = PathPoint.T](PathPoint.origin, y)) => Path[.A = PathPoint.T](
      y,
      PathPoint.origin
    ),
    pathOriginOther,
    Path.here(PathPoint.origin),
    Path.here(pathOriginOther),
    Path.here(PathPoint.origin)
  ),
  unit
) = Path.here(unit) ;
