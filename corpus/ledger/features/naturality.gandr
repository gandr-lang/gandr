/// `naturality`: a term's naturality along a path in one of its arguments, the action of the term on that path.
///
/// Implemented: `std.math.path` holds `natural`, the operation at one variable, a homotopy's naturality along a path. `assoc_nat` states the associator's naturality in its first argument, at the square that Example 1.3 of the paper states. Its term is `natural` at the associator, and the kernel replays it. `natassoc` writes the same naturality as the filler generator over the 3-chain, `fill[5, 7](chain(3), t, (fa, g, h))`.
///
/// The square is the type Catt answers for `assoc [a] g h`. Its source is the associator at `fm`, then `fa` whiskered by `Path.step(g, h)`. Its target is `fa` whiskered by `g` and then by `h`, then the associator at `fp`. `natural` acts on `fa` by the composite function instead, so `apComp` carries its target side to the two whiskers.
///
/// The filler generator whiskers by a transport along `fa`, which converts with `std.math.path`'s `whiskerRight`, the level-two composite. `natassoc` states the square by `whiskerRight`. At `fa = Path.here(fm)` both squares reduce to the associator, and `natassocAtHere` relates the two terms there by `Path.here`. At a general `fa` the two terms are two inductions on `fa`, and neither converts with the other. `natassocAgrees` relates them by a path, the induction on `fa` from `natassocAtHere`.
///
/// - see: library/std/src/math/path.gandr
/// - see: #3711 — the paper, arXiv:2501.11620, and its Example 1.3
/// - see: #3922 — `natural`, and this instance of it
/// - see: crates/surface-corpus/README.md

// `ap`, `apComp`, `assoc`, `natural`, `whiskerRight`.
import std.math.path (ap, apComp, assoc, natural, whiskerRight);

/// The associator's naturality in its first argument: the square whose sides are the associators at `fm` and `fp` and whose other sides whisker `fa`.
def assoc_nat(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(fp, Path.step(g, h))),
  Path.step(assoc(A, x, y, z, w, fm, g, h), whiskerRight(A, x, y, w, fm, fp, fa, Path.step(g, h))),
  Path.step(whiskerRight(
    A,
    x,
    z,
    w,
    Path.step(fm, g),
    Path.step(fp, g),
    whiskerRight(A, x, y, z, fm, fp, fa, g),
    h
  ), assoc(A, x, y, z, w, fp, g, h))
) {
  Path.step(natural(
    Path(A, x, y),
    Path(A, x, w),
    (fun (q : Path(A, x, y)) { Path.step(Path.step(q, g), h) } : Path(A, x, y) => Path(A, x, w)),
    (fun (q : Path(A, x, y)) { Path.step(q, Path.step(g, h)) } : Path(A, x, y) => Path(A, x, w)),
    (fun (q : Path(A, x, y)) { assoc(A, x, y, z, w, q, g, h) } : (q : Path(A, x, y)) => Path(Path(A, x, w), Path.step(Path.step(q, g), h), Path.step(q, Path.step(g, h)))),
    fm,
    fp,
    fa
  ), whiskerRight(
    Path(A, x, w),
    Path.step(Path.step(fm, g), h),
    Path.step(Path.step(fp, g), h),
    Path.step(fp, Path.step(g, h)),
    ap(Path(A, x, y), Path(A, x, w), (fun (q : Path(A, x, y)) { Path.step(Path.step(q, g), h) } : Path(A, x, y) => Path(A, x, w)), fm, fp, fa),
    whiskerRight(A, x, z, w, Path.step(fm, g), Path.step(fp, g), whiskerRight(A, x, y, z, fm, fp, fa, g), h),
    apComp(
      Path(A, x, y),
      Path(A, x, z),
      Path(A, x, w),
      (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
      (fun (r : Path(A, x, z)) { Path.step(r, h) } : Path(A, x, z) => Path(A, x, w)),
      fm,
      fp,
      fa
    ),
    assoc(A, x, y, z, w, fp, g, h)
  ))
}

/// The associator, curried over the 3-chain's cells: the generator `natassoc` fills.
def assocGenerator(A : Type, x : A, y : A, z : A, w : A) -> (f : Path(A, x, y)) => (g : Path(A, y, z)) => (h : Path(A, z, w)) => Path(Path(A, x, w), Path.step(Path.step(f, g), h), Path.step(f, Path.step(g, h))) {
  thunk { fun (f) { thunk { fun (g) { thunk { fun (h) { assoc(A, x, y, z, w, f, g, h) } } } } } }
}

/// The associator's naturality in its first argument as the filler generator writes it.
def natassoc(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(fp, Path.step(g, h))),
  Path.step(assoc(A, x, y, z, w, fm, g, h), whiskerRight(A, x, y, w, fm, fp, fa, Path.step(g, h))),
  Path.step(whiskerRight(A, x, z, w, Path.step(fm, g), Path.step(fp, g), whiskerRight(A, x, y, z, fm, fp, fa, g), h), assoc(A, x, y, z, w, fp, g, h))
) {
  fill[5, 7](chain(3), assocGenerator(A, x, y, z, w), (fa, g, h))
}

/// The same naturality over the level-two shape `[3](1, 0, 0)`: `fa` a column of one 2-cell, and `g` and `h` columns of none.
def natassocColumns(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(fp, Path.step(g, h))),
  Path.step(assoc(A, x, y, z, w, fm, g, h), whiskerRight(A, x, y, w, fm, fp, fa, Path.step(g, h))),
  Path.step(whiskerRight(A, x, z, w, Path.step(fm, g), Path.step(fp, g), whiskerRight(A, x, y, z, fm, fp, fa, g), h), assoc(A, x, y, z, w, fp, g, h))
) {
  fill[6, 11](chain(3, (1, 0, 0)), assocGenerator(A, x, y, z, w), (fa, g, h))
}

/// At `Path.here(fm)` the filler generator's square and `assoc_nat` convert.
def natassocAtHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(
    Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(fm, Path.step(g, h))),
    Path.step(assoc(A, x, y, z, w, fm, g, h), whiskerRight(A, x, y, w, fm, fm, Path.here(fm), Path.step(g, h))),
    Path.step(whiskerRight(A, x, z, w, Path.step(fm, g), Path.step(fm, g), whiskerRight(A, x, y, z, fm, fm, Path.here(fm), g), h), assoc(A, x, y, z, w, fm, g, h))
  ),
  natassoc(A, x, y, z, w, fm, fm, Path.here(fm), g, h),
  assoc_nat(A, x, y, z, w, fm, fm, Path.here(fm), g, h)
) {
  Path.here(assoc_nat(A, x, y, z, w, fm, fm, Path.here(fm), g, h))
}

/// At every `fa` the filler generator's square and `assoc_nat` agree by a path: based path induction on `fa` from their agreement at `Path.here(fm)` (#4120).
def natassocAgrees(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(
    Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(fp, Path.step(g, h))),
    Path.step(assoc(A, x, y, z, w, fm, g, h), whiskerRight(A, x, y, w, fm, fp, fa, Path.step(g, h))),
    Path.step(whiskerRight(A, x, z, w, Path.step(fm, g), Path.step(fp, g), whiskerRight(A, x, y, z, fm, fp, fa, g), h), assoc(A, x, y, z, w, fp, g, h))
  ),
  natassoc(A, x, y, z, w, fm, fp, fa, g, h),
  assoc_nat(A, x, y, z, w, fm, fp, fa, g, h)
) {
  Path.walk(
    (v : Path(A, x, y), k : Path(Path(A, x, y), fm, v)) => Path(
      Path(
        Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(v, Path.step(g, h))),
        Path.step(assoc(A, x, y, z, w, fm, g, h), whiskerRight(A, x, y, w, fm, v, k, Path.step(g, h))),
        Path.step(whiskerRight(A, x, z, w, Path.step(fm, g), Path.step(v, g), whiskerRight(A, x, y, z, fm, v, k, g), h), assoc(A, x, y, z, w, v, g, h))
      ),
      natassoc(A, x, y, z, w, fm, v, k, g, h),
      assoc_nat(A, x, y, z, w, fm, v, k, g, h)
    ),
    fa,
    Path.here(fm),
    Path.here(fa),
    natassocAtHere(A, x, y, z, w, fm, g, h)
  )
}
