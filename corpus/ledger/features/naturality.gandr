/// `naturality`: a term's naturality along a path in one of its arguments, the action of the term on that path.
///
/// Implemented: `assoc_nat` states the associator's naturality in its first argument. Its type is the square that Example 1.3 of the paper states. Its sides whisker the path of paths `fa` by `whiskerRight`. Based path induction on `fa` proves it, and the kernel replays the proof.
///
/// The square is the type Catt answers for `assoc [a] g h`. Its source is the associator at `fm`, then `fa` whiskered by `g then h`. Its target is `fa` whiskered by `g` and then by `h`, then the associator at `fp`.
///
/// - see: library/math/src/path.gandr
/// - see: #3711 — the paper, arXiv:2501.11620, and its Example 1.3
/// - see: crates/surface-corpus/README.md

// `assoc`, `whiskerRight`.
import "../../../library/math/src/path.gandr";

/// The associator's naturality in its first argument: the square whose sides are the associators at `fm` and `fp` and whose other sides whisker `fa`.
def assoc_nat(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(Path(A, x, w), (fm then g) then h, fp then (g then h)),
  assoc(A, x, y, z, w, fm, g, h) then whiskerRight(A, x, y, w, fm, fp, fa, g then h),
  whiskerRight(
    A,
    x,
    z,
    w,
    fm then g,
    fp then g,
    whiskerRight(A, x, y, z, fm, fp, fa, g),
    h
  ) then assoc(A, x, y, z, w, fp, g, h)
) {
  transport(
    (kp : Path(A, x, y), e : Path(Path(A, x, y), fm, kp)) => Path(
      Path(Path(A, x, w), (fm then g) then h, kp then (g then h)),
      assoc(A, x, y, z, w, fm, g, h) then whiskerRight(A, x, y, w, fm, kp, e, g then h),
      whiskerRight(
        A,
        x,
        z,
        w,
        fm then g,
        kp then g,
        whiskerRight(A, x, y, z, fm, kp, e, g),
        h
      ) then assoc(A, x, y, z, w, kp, g, h)
    ),
    fa,
    here(fm),
    here(fa),
    here(assoc(A, x, y, z, w, fm, g, h))
  )
}
