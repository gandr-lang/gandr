/// `indexed-data`: Indexed data families.
/// Implemented: data families over value indices, written as the kind `Nat -> Type` or as a named telescope whose later index types read the earlier ones, whose case checks each arm at its constructor's fields with one equation per index. The solution of an equation with a variable side refines its arm. At a family of one index, the case leaves out an arm whose constructor stands apart.
/// Not implemented: pruning at several indices, injectivity at a match, and a constructor of an indexed family written at an index; #1314 owes the first, #3515 the second and #4027 the third.
// Vectors: lists indexed by their length, a family whose constructors each
// state the index their value stands at (Dybjer, _Inductive families_,
// doi:10.1007/BF01211308). The kind `Nat -> Type` reads the length's type
// before the universe; `VNil` stands at zero and `VCons` at the successor of
// its tail's length, so a vector's type says how long it is. What a vector
// refuses is in the pathological twin.

// The naturals the lengths count in.
import "../../model/data/data-base.gandr" ;

/// Vectors of elements of `a`, indexed by their length.
@[ checks ]
data Vec(a : Type) : Nat -> Type {
  VNil : Vec(a, Zero);
  VCons : (n : Nat, head : a, tail : Vec(a, n)) --> Vec(a, Succ(n));
}

/// The vector of one integer, one long.
@[ checks ]
def single() -> Vec(Integer, Succ(Zero)) {
  VCons(Zero, 3, (VNil : Vec(Integer, Zero)))
}

/// A vector of two integers, two long: each `VCons` one past its tail.
@[ checks ]
def pair() -> Vec(Integer, Succ(Succ(Zero))) {
  VCons(
    Succ(Zero),
    1,
    (VCons(Zero, 2, (VNil : Vec(Integer, Zero))) : Vec(Integer, Succ(Zero)))
  )
}

/// A vector of `a` marked at its length: the indices a named telescope, the
/// type of the vector reading the length before it.
@[ checks ]
data Sized(a : Type) : (n : Nat, v : Vec(a, n)) --> Type {
  Measured : (n : Nat, v : Vec(a, n)) --> Sized(a, n, v);
}

/// A vector of integers, marked at its length.
@[ checks ]
def measured(n : Nat, v : Vec(Integer, n)) -> Sized(Integer, n, v) {
  Measured(n, v)
}
