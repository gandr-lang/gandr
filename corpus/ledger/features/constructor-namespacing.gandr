/// `constructor-namespacing`: Constructor names namespaced by family.
/// Implemented: a constructor named by its family, `Family.Constructor`, in a pattern and in a value, and bare where its name resolves to it.
/// Not implemented: two data families sharing a constructor name in one source, and a bare name resolved by uniqueness among imports; #2713 owes it.
@[ checks ]
data Shape : Type {
  Dot : Shape;
  Line : (length : Integer) --> Shape;
}

/// The length of a line, zero for a dot, each matched by its qualified name.
@[ checks ]
def length(s : Shape) -> Integer {
  case s {
    Shape.Dot => 0,
    Shape.Line(n) => n
  }
}

/// A line built by its qualified name.
@[ runs("3") ]
def measured() -> Integer { length(Shape.Line(3)) }
