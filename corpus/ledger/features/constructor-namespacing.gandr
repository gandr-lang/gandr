/// `constructor-namespacing`: Constructor names namespaced by family.
/// Implemented: a constructor named by its family, `Family.Constructor`, in a
/// pattern and in a value, and bare where its name resolves to it; two data
/// families of one source that share a constructor name, each named through its
/// family, and the refusal of a bare name that more than one family declares; a
/// multi-output constructor's port as `Family.Constructor(e).l`, its record as
/// `Family.Constructor(e)`, and its port pattern; a name the family lacks
/// refused as its unknown member.
/// Not implemented: the choice of a shared bare name by the scrutinee's or the
/// expected type, and a data block's rule terms that name
/// its constructors qualified.
///
/// - owes: #5691 — a shared bare name chosen by its type
/// - owes: #4293 — rule terms naming a data block's constructors qualified
@[checks]
data Shape : Type where
  | Dot : Shape
  | Line : (length : Integer) --> Shape

/// The length of a line, zero for a dot, each matched by its qualified name.
@[checks]
def length(s : Shape) -> Integer =
  match s where
    | Shape.Dot => 0
    | Shape.Line(n) => n

/// A line built by its qualified name.
@[runs("3")]
def measured() -> Integer { length (Shape.Line 3) }

/// A mark on a page, whose `Dot` shares its name with a shape's.
@[checks]
data Mark : Type where
  | Dot : Mark
  | Dash : Mark

/// A mark's width. The match names each mark through its family.
@[checks]
def width(m : Mark) -> Integer =
  match m where
    | Mark.Dot => 1
    | Mark.Dash => 3

/// A dot's width, built through its family.
@[runs("1")]
def dotted() -> Integer { width Mark.Dot }

/// A shared subterm with two ports.
@[checks]
data Expr : Type where
  | Lit : (n : Integer) --> Expr
  | Share : (e : Expr) --> (left : Expr, right : Expr)

/// The size of an expression, each port matched by its qualified name.
@[checks]
def rec size(e : Expr) -> -F Integer =
  match e where
    | Expr.Lit(n) => return 1
    | Expr.Share(x).left => size[<] x
    | Expr.Share(x).right => size[<] x

/// A port built by its qualified name.
@[runs("1")]
def shared() -> -F Integer { size (Expr.Share (Expr.Lit 7)).right }

/// The record of both ports, built by the qualified name.
@[checks]
def ports : *{left : Expr, right : Expr} = Expr.Share (Expr.Lit 7);
