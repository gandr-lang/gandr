/// `exact-reals`: exact real arithmetic beside the kernel, which a program reaches through `std.reals.Eff`.
/// Implemented: the host interface holds seven operations. `admit` and `enclose` read a plan, and `decide`, `step`, `checkpoint`, `restore` and `report` decide its open root by a machine. The checker replays each certificate before a reply, and only such a certificate makes a machine hold or fail.
/// Not implemented: no source runs the overt existential or the compact universal through the driver, and the corpus holds no pathological case of stage C.
///
/// - owes: #5705
/// - see: `corpus/model/reals/sqrt-two.gandr` — the square root of two through `gandr run`
/// - see: `corpus/model/reals/comparison.gandr` — a comparison that holds
/// - see: `corpus/model/reals/resume.gandr` — a machine restored from its checkpoint
/// - see: `corpus/model/reals/trigonometry.gandr` — π, the cosine and the angle of a point

// The exact reals' host interface.
import std.reals;

/// The lower end of an enclosure of the root of `plan` no wider than `2^-k`.
pub def lower(plan : String, k : Integer) -> [std.reals.Eff] String =
  let held = std.reals.admit plan
  let *{low, high} = std.reals.enclose held k
  low

/// `lower` under a handler of this source, a second model of `std.reals.Eff`.
/// The handler holds one plan and answers each enclosure with `1` and `3/2`.
@[ runs("\"1p0\"") ]
def lowerModelled() -> String =
  handle r : std.reals.Eff {
    lower "" 1
  } with {
    | pure(x) => pure x
    | oper admit(plan, k) => k 0
    | oper enclose(asked, k) => k "1p0" "3p-1"
    | oper decide(asked, k) => k "holds" 0
    | oper step(machine, k) => k "holds" machine
    | oper checkpoint(machine, k) => k ""
    | oper restore(text, k) => k 0
    | oper report(machine, k) => k #[0, 0, 0]
  }

/// The verdict on the open root of `plan` after at most `quanta` quanta.
pub def verdict(plan : String, quanta : Integer) -> [std.reals.Eff] String =
  let held = std.reals.admit plan
  let *{named, machine} = std.reals.decide held quanta
  named

/// `verdict` under a handler of this source, a second model of
/// `std.reals.Eff` whose each budget ends `exhausted`.
@[ runs("\"exhausted\"") ]
def verdictModelled() -> String =
  handle r : std.reals.Eff {
    verdict "" 1
  } with {
    | pure(x) => pure x
    | oper admit(plan, k) => k 0
    | oper enclose(asked, k) => k "1p0" "3p-1"
    | oper decide(asked, k) => k "exhausted" 0
    | oper step(machine, k) => k "exhausted" machine
    | oper checkpoint(machine, k) => k ""
    | oper restore(text, k) => k 0
    | oper report(machine, k) => k #[1, 2, 0]
  }
