/// `deployment-offers` places a world only at a site whose offer answers the
/// row the world requires.
///
/// Implemented: a world states as a row what a role at the world needs.
/// A manifold's check judges each row against the offer of its site.
/// The host that serves a world grants the host interfaces of its row.
/// Not implemented: no host answers a label of the row with the offer's model.
/// No host serves the endpoint of a translation.
///
/// The requirement travels with the program and the offer stays with the site,
/// so nothing of the deployment enters the program's identity.
///
/// - owes: #6546 — a label of the row at run, answered by the offer's model
/// - owes: #6271 — the endpoint a translation hosts
/// - see: corpus/model/deployments/offers.site.gandr
/// - see: corpus/model/deployments/offers.manifold.gandr
/// - see: corpus/pathological/worlds/offers.gandr
/// - see: corpus/pathological/worlds/offered.gandr
/// - see: corpus/pathological/worlds/requires.gandr
/// - see: crates/surface-driver/tests/cli.rs
/// - see: crates/surface-driver/tests/net.rs

// The console's host interface.
import std.io;

/// What a role at `far` reads and writes: values held by key.
pub theory Store where
  /// The store holds values of this sort.
  sort V : Type+;
  /// What a computation over the store answers.
  sort C : Type;
  /// Reads the value at `key`.
  oper get : (key : V, k : pi+ (v : V). C) --> C;
  /// Holds `value` at `key`.
  oper put : (key : V, value : V, k : C) --> C;

/// The world the entry runs at.
pub world near;

/// The world the work runs at: the console, and a store of strings under
/// `store`.
pub world far requires [std.io.Console.Eff, store : Store with sort V = String];
