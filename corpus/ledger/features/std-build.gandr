/// `std-build`: The standard library's manifest theories.
/// Implemented: `std.build`, `library/std/src/build.gandr`, states `Versioned` and `Toolchain`, which `Project` joins once, `Presentation`, `Gandr.Package`, including `Project` and `Presentation`, and `Gandr.Workspace`, including `Project`, which a package source's and a workspace's models implement, `Gandr.Module`, which no source models yet, and no type of a dependency, which an import's coordinate names (#4527); every field of a package but what it asks of the toolchain, its `name`, `version`, `authors`, `licence`, `documentation`, `endpoint` and `spelling`, is inert, read only by the manifest step and another inert field (#3029), while `gandr`, `features` and `systems` are content (#3135); a source under any root imports it by name, `import std.build (Gandr);`.
/// Not implemented: `authors`, `features` and `systems` are no lists, which #2993 owes.

import std.build (Gandr);

/// A package's model, every field but what it asks of the toolchain inert:
/// only the manifest step reads them (#3029).
pub module Package : Model(Gandr.Package) where {
  /// The package's name, which the manifest records it by.
  def name = "probe";
  /// The version the package releases at.
  @[ runs("\"0.1.0\"") ]
  def version = "0.1.0";
  /// The package's authors.
  def authors = "The gandr authors";
  /// The licence, an SPDX expression.
  def licence = "MIT OR Apache-2.0";
  /// The address the package's documentation stands at.
  def documentation = "https://github.com/gandr-lang/gandr";
  /// The address a resolver may fetch the package from.
  def endpoint = "https://github.com/gandr-lang/gandr";
  /// The least language version the sources ask for.
  def gandr = ">= 0.0";
  /// The features the sources use: none.
  def features = "";
  /// The systems the package builds on: any.
  def systems = "";
  /// The spelling the package asks for: the reader's own.
  def spelling = "";
}
