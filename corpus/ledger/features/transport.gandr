/// `Path.walk`: `Path.walk(P, p, x)` moves `x` along the path `p` in the family `P`; along reflexivity it keeps the value.
@[ checks ]
def along_here : Path(Integer, Path.walk(fun (X) { X }, Path.here(Integer), 2), 2) ;
def along_here = Path.here(2) ;

/// The same transport, run.
@[ runs("2") ]
def along_here_run : () => Integer ;
def along_here_run = thunk { Path.walk(fun (X) { X }, Path.here(Integer), 2) } ;
