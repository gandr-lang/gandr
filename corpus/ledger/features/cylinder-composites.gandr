/// `cylinder-composites`: squares and triangles of paths compose at dimension 2, as Catt's built-ins compose them, and `fill` and suspension compose cylinders and cones at dimension 3.
///
/// Implemented: the module holds the composite of two squares side by side, the stack of two squares and the composite of two triangles over one apex. Each stands in two readings, and the kernel replays each. The Path reading is the term Catt's built-in prints. The cells reading is its whiskers as level-two composites joined by `Path.step`, with no associator written. The composite at `n + 1` is `fill` at the composite at `n`: Example 1.2 at `n = 2`, and the level-two `fill` over `[2](1, 1)` at `n = 3`, its points fixed. `cattCylinder3` states the type Catt answers for `cylcomp(3,1,3)` at identity verticals and inhabits it by `cylinderFill3`. Along dimension 2, `cylinderSuspended3` and `coneSuspended3` state the types Catt prints for `cylcomp(3,2,3)` and `conecomp(3,2,3)`. Each is a composite at `n = 2` at a path type, beside the interchangers `j⁻` and `j⁺`.
///
/// Not implemented: the other composites along dimension 1 at dimension 3, with their verticals free.
///
/// Each composite at reflexivities computes, so each declaration but `cattCylinder3` states a composite of reflexivities and proves it by reflexivity. `cattCylinder3` holds its cells free.
///
/// - owes: #4240 — the other composites along dimension 1 at dimension 3
/// - see: library/std/src/math/cylinder.gandr
/// - see: #3712 — the composites at dimension 2, written from Catt's terms
/// - see: #3931 — the composite at `n + 1` as `fill` at the composite at `n`
/// - see: #3833 — `cylcomp(3,1,3)` at identity verticals beside Catt's type
/// - see: #3963 — the composites at dimension 2 in the cells reading
/// - see: #4198 — the composites along dimension 2 by suspension

// `cylinderComposite2`, `cylinderStack2`, `coneComposite2`, `cylinderFill2`, `cylinderFillAt2`, `cylinderFill3`, `liftHorizontal`, `cylinderCompositeCells2`, `cylinderStackCells2`, `coneCompositeCells2`, `cylinderSuspended3`, `coneSuspended3`.
import std.math.cylinder (cylinderComposite2, cylinderStack2, coneComposite2, cylinderFill2, cylinderFillAt2, cylinderFill3, liftHorizontal, cylinderCompositeCells2, cylinderStackCells2, coneCompositeCells2, cylinderSuspended3, coneSuspended3);

// `whiskerLeft` and `whiskerRight`.
import std.math.path (whiskerLeft, whiskerRight);

/// Two squares of reflexivities side by side compose to the reflexivity of the reflexivity.
def cylinderCompositeAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  cylinderComposite2
    A
    x
    x (Path.here x)
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    x (Path.here x)
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// Two squares of reflexivities filled side by side reduce to the reflexivity of the reflexivity, as Catt's composite does.
def cylinderFillAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  cylinderFill2
    A
    x
    x (Path.here x)
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    x (Path.here x)
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// A stack of two squares of reflexivities composes to the reflexivity of the reflexivity.
def cylinderStackAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  cylinderStack2
    A
    x
    x (Path.here x)
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// Two triangles of reflexivities over one apex compose to the reflexivity of the reflexivity.
def coneCompositeAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  coneComposite2
    A
    x
    x (Path.here x)
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// Two squares of reflexivities side by side compose in the cells reading to the reflexivity of the reflexivity.
def cylinderCompositeCellsAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  cylinderCompositeCells2
    A
    x
    x (Path.here x)
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    x (Path.here x)
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// A stack of two squares of reflexivities composes in the cells reading to the reflexivity of the reflexivity.
def cylinderStackCellsAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  cylinderStackCells2
    A
    x
    x (Path.here x)
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    x
    (((x (Path.here x)) (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// Two triangles of reflexivities over one apex compose in the cells reading to the reflexivity of the reflexivity.
def coneCompositeCellsAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](
  coneCompositeCells2
    A
    x
    x (Path.here x)
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x)),
  Path.here (Path.here x)
) =
  Path.here (Path.here (Path.here x))

/// Two 3-cylinders of reflexivities along a shared square compose to the reflexivity of the reflexivity of the reflexivity.
def cylinderSuspendedAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](Path.here (Path.here x), Path.here (Path.here x))](
  cylinderSuspended3
    A
    x
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    x
    (((((((((((((x (Path.here x)) (Path.here x)) (Path.here (Path.here x))) (Path.here x)) (Path.here x)) (Path.here (Path.here x))) (Path.here (Path.here x))) (Path.here (Path.here (Path.here x)))) (Path.here x)) (Path.here (Path.here x))) (Path.here x)) (Path.here (Path.here x))) (Path.here (Path.here x))) (Path.here (Path.here (Path.here x))),
  Path.here (Path.here (Path.here x))
) =
  Path.here (Path.here (Path.here (Path.here x)))

/// Two 3-cones of reflexivities along a shared triangle compose to the reflexivity of the reflexivity of the reflexivity.
def coneSuspendedAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = Path[.A = A](x, x)](Path.here x, Path.here x)](Path.here (Path.here x), Path.here (Path.here x))](
  coneSuspended3
    A
    x
    ((x (Path.here x)) (Path.here x)) (Path.here (Path.here x))
    ((((((((x (Path.here x)) (Path.here x)) (Path.here (Path.here x))) (Path.here (Path.here x))) (Path.here (Path.here (Path.here x)))) (Path.here x)) (Path.here (Path.here x))) (Path.here (Path.here x))) (Path.here (Path.here (Path.here x))),
  Path.here (Path.here (Path.here x))
) =
  Path.here (Path.here (Path.here (Path.here x)))

/// Catt's `cylcomp(2,1,2)` at identity verticals, its points fixed.
def cattSquare(
  A : Type,
  x : A,
  y : A,
  z : A,
  f0 : Path[.A = A](x, y),
  f1 : Path(x, y),
  a : Path[.A = Path[.A = A](x, y)](f0, f1),
  g0 : Path(y, z),
  g1 : Path(y, z),
  b : Path[.A = Path[.A = A](y, z)](g0, g1)
) -> Path[.A = Path[.A = A](x, z)](Path.step f0 g0, Path.step f1 g1) =
  cylinderComposite2 A x y f0 x y (f1 (Path.here x)) (Path.here y) a z g0 z g1 (Path.here z) b

/// Catt's horizontal composite: the right whisker of `fa`, then the left whisker of `ga`.
def cattHorizontal(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp)
) -> Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step fp gp) =
  (Path.step (whiskerRight A x y z fm fp fa gm)) (whiskerLeft A x y z fp gm gp ga)

/// The generated square and Catt's agree at a reflexive first cell, by induction on the second.
def squaresAgreeAtHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  g0 : Path(y, z),
  g1 : Path(y, z),
  b : Path[.A = Path[.A = A](y, z)](g0, g1)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f g0, Path.step f g1)](
  cylinderFillAt2 A x y z f f (Path.here f) g0 g1 b,
  cattSquare A x y z f f (Path.here f) g0 g1 b
) =
  Path.walk ((w : Path[.A = A](y, z), m : Path[.A = Path[.A = A](y, z)](g0, w)) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f g0, Path.step f w)](
      cylinderFillAt2 A x y z f f (Path.here f) g0 w m,
      cattSquare A x y z f f (Path.here f) g0 w m
    ))
    ((b (Path.here g0)) (Path.here b)) (Path.here (Path.here (Path.step f g0)))

/// The generated square and Catt's agree, by induction on the first cell.
def squaresAgree(
  A : Type,
  x : A,
  y : A,
  z : A,
  f0 : Path[.A = A](x, y),
  f1 : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f0, f1),
  g0 : Path(y, z),
  g1 : Path(y, z),
  b : Path[.A = Path[.A = A](y, z)](g0, g1)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f0 g0, Path.step f1 g1)](
  cylinderFillAt2 A x y z f0 f1 a g0 g1 b,
  cattSquare A x y z f0 f1 a g0 g1 b
) =
  Path.walk ((v : Path[.A = A](x, y), k : Path[.A = Path[.A = A](x, y)](f0, v)) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f0 g0, Path.step v g1)](
      cylinderFillAt2 A x y z f0 v k g0 g1 b,
      cattSquare A x y z f0 v k g0 g1 b
    ))
    ((a (Path.here f0)) (Path.here a)) (squaresAgreeAtHere A x y z f0 g0 g1 b)

/// Catt's horizontal composite and the generated one agree at a reflexive first cell, by induction on the second.
def horizontalsAgreeAtHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f gm, Path.step f gp)](
  cattHorizontal A x y z f f (Path.here f) gm gp ga,
  liftHorizontal A x y z f f (Path.here f) gm gp ga
) =
  Path.walk ((w : Path[.A = A](y, z), m : Path[.A = Path[.A = A](y, z)](gm, w)) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f gm, Path.step f w)](
      cattHorizontal A x y z f f (Path.here f) gm w m,
      liftHorizontal A x y z f f (Path.here f) gm w m
    ))
    ((ga (Path.here gm)) (Path.here ga)) (Path.here (Path.here (Path.step f gm)))

/// Catt's horizontal composite and the generated one agree, by induction on the first cell.
def horizontalsAgree(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step fp gp)](
  cattHorizontal A x y z fm fp fa gm gp ga,
  liftHorizontal A x y z fm fp fa gm gp ga
) =
  Path.walk ((v : Path[.A = A](x, y), k : Path[.A = Path[.A = A](x, y)](fm, v)) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step v gp)](
      cattHorizontal A x y z fm v k gm gp ga,
      liftHorizontal A x y z fm v k gm gp ga
    ))
    ((fa (Path.here fm)) (Path.here fa)) (horizontalsAgreeAtHere A x y z fm gm gp ga)

/// Catt's right whisker by the identity is the unit law, by induction on the 2-path.
def whiskerHereRight(
  A : Type,
  x : A,
  z : A,
  h0 : Path(x, z),
  h1 : Path(x, z),
  h : Path[.A = Path[.A = A](x, z)](h0, h1)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](h0, h1)](
  whiskerRight A x z z h0 h1 h (Path.here z),
  h
) =
  Path.walk ((v : Path[.A = A](x, z), k : Path[.A = Path[.A = A](x, z)](h0, v)) -> Path[.A = Path[.A = Path[.A = A](x, z)](h0, v)](
      whiskerRight A x z z h0 v k (Path.here z),
      k
    ))
    ((h (Path.here h0)) (Path.here h)) (Path.here (Path.here h0))

/// Catt's left whisker by the identity is the unit law, by induction on the 2-path.
def whiskerHereLeft(
  A : Type,
  x : A,
  z : A,
  h0 : Path(x, z),
  h1 : Path(x, z),
  h : Path[.A = Path[.A = A](x, z)](h0, h1)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](h0, h1)](
  whiskerLeft A x x z (Path.here x) h0 h1 h,
  h
) =
  Path.walk ((v : Path[.A = A](x, z), k : Path[.A = Path[.A = A](x, z)](h0, v)) -> Path[.A = Path[.A = Path[.A = A](x, z)](h0, v)](
      whiskerLeft A x x z (Path.here x) h0 v k,
      k
    ))
    ((h (Path.here h0)) (Path.here h)) (Path.here (Path.here h0))

/// Catt's source without its whisker by the identity at `z`.
def unwhiskerSource(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  pm : Path(x, y),
  pp : Path[.A = A](x, y),
  pa : Path[.A = Path[.A = A](x, y)](pm, pp),
  am : Path[.A = Path[.A = A](x, y)](fm, pm),
  ap : Path[.A = Path[.A = A](x, y)](fp, pp),
  aa : Path[.A = Path[.A = Path[.A = A](x, y)](fm, pp)](Path.step am pa, Path.step fa ap),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp),
  qm : Path(y, z),
  qp : Path(y, z),
  qa : Path[.A = Path[.A = A](y, z)](qm, qp),
  km : Path[.A = Path[.A = A](y, z)](gm, qm),
  kp : Path[.A = Path[.A = A](y, z)](gp, qp),
  ka : Path[.A = Path[.A = Path[.A = A](y, z)](gm, qp)](Path.step km qa, Path.step ga kp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step pp qp)](
  (Path.step (whiskerRight
    A
    x
    z
    (((z (Path.step fm gm)) (Path.step fp gp)) (cattHorizontal A x y z fm fp fa gm gp ga)) (Path.here z))) (cattSquare A x y z fp pp ap gp qp kp),
  (Path.step (cattHorizontal A x y z fm fp fa gm gp ga)) (cattSquare
    A
    x
    y
    z
    fp
    pp
    ap
    gp
    qp
    kp)
) =
  (((((((whiskerRight (type(Path[.A = A](x, z)))) (Path.step fm gm)) (Path.step fp gp)) (Path.step pp qp)) (whiskerRight
      A
      x
      z
      (((z (Path.step fm gm)) (Path.step fp gp)) (cattHorizontal A x y z fm fp fa gm gp ga)) (Path.here z))) (cattHorizontal A x y z fm fp fa gm gp ga)) (whiskerHereRight
      A
      x
      ((z (Path.step fm gm)) (Path.step fp gp)) (cattHorizontal A x y z fm fp fa gm gp ga))) (cattSquare A x y z fp pp ap gp qp kp)

/// The step takes Catt's horizontal composite in the source to the generated one.
def liftSource(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  pm : Path(x, y),
  pp : Path[.A = A](x, y),
  pa : Path[.A = Path[.A = A](x, y)](pm, pp),
  am : Path[.A = Path[.A = A](x, y)](fm, pm),
  ap : Path[.A = Path[.A = A](x, y)](fp, pp),
  aa : Path[.A = Path[.A = Path[.A = A](x, y)](fm, pp)](Path.step am pa, Path.step fa ap),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp),
  qm : Path(y, z),
  qp : Path(y, z),
  qa : Path[.A = Path[.A = A](y, z)](qm, qp),
  km : Path[.A = Path[.A = A](y, z)](gm, qm),
  kp : Path[.A = Path[.A = A](y, z)](gp, qp),
  ka : Path[.A = Path[.A = Path[.A = A](y, z)](gm, qp)](Path.step km qa, Path.step ga kp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step pp qp)](
  (Path.step (cattHorizontal A x y z fm fp fa gm gp ga)) (cattSquare
    A
    x
    y
    z
    fp
    pp
    ap
    gp
    qp
    kp),
  (Path.step (liftHorizontal A x y z fm fp fa gm gp ga)) (cattSquare
    A
    x
    y
    z
    fp
    pp
    ap
    gp
    qp
    kp)
) =
  (((((((whiskerRight (type(Path[.A = A](x, z)))) (Path.step fm gm)) (Path.step fp gp)) (Path.step pp qp)) (cattHorizontal A x y z fm fp fa gm gp ga)) (liftHorizontal A x y z fm fp fa gm gp ga)) (horizontalsAgree A x y z fm fp fa gm gp ga)) (cattSquare A x y z fp pp ap gp qp kp)

/// The step takes Catt's square in the source to `fill`'s.
def fillSource(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  pm : Path(x, y),
  pp : Path[.A = A](x, y),
  pa : Path[.A = Path[.A = A](x, y)](pm, pp),
  am : Path[.A = Path[.A = A](x, y)](fm, pm),
  ap : Path[.A = Path[.A = A](x, y)](fp, pp),
  aa : Path[.A = Path[.A = Path[.A = A](x, y)](fm, pp)](Path.step am pa, Path.step fa ap),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp),
  qm : Path(y, z),
  qp : Path(y, z),
  qa : Path[.A = Path[.A = A](y, z)](qm, qp),
  km : Path[.A = Path[.A = A](y, z)](gm, qm),
  kp : Path[.A = Path[.A = A](y, z)](gp, qp),
  ka : Path[.A = Path[.A = Path[.A = A](y, z)](gm, qp)](Path.step km qa, Path.step ga kp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step pp qp)](
  (Path.step (liftHorizontal A x y z fm fp fa gm gp ga)) (cattSquare
    A
    x
    y
    z
    fp
    pp
    ap
    gp
    qp
    kp),
  (Path.step (liftHorizontal A x y z fm fp fa gm gp ga)) (cylinderFillAt2
    A
    x
    y
    z
    fp
    pp
    ap
    gp
    qp
    kp)
) =
  (((((((whiskerLeft (type(Path[.A = A](x, z)))) (Path.step fm gm)) (Path.step fp gp)) (Path.step pp qp)) (liftHorizontal A x y z fm fp fa gm gp ga)) (cattSquare A x y z fp pp ap gp qp kp)) (cylinderFillAt2 A x y z fp pp ap gp qp kp)) (Path.back (squaresAgree A x y z fp pp ap gp qp kp))

/// The generated composite, `cylinderFill3`, from source to target.
def fillComposite(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  pm : Path(x, y),
  pp : Path[.A = A](x, y),
  pa : Path[.A = Path[.A = A](x, y)](pm, pp),
  am : Path[.A = Path[.A = A](x, y)](fm, pm),
  ap : Path[.A = Path[.A = A](x, y)](fp, pp),
  aa : Path[.A = Path[.A = Path[.A = A](x, y)](fm, pp)](Path.step am pa, Path.step fa ap),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp),
  qm : Path(y, z),
  qp : Path(y, z),
  qa : Path[.A = Path[.A = A](y, z)](qm, qp),
  km : Path[.A = Path[.A = A](y, z)](gm, qm),
  kp : Path[.A = Path[.A = A](y, z)](gp, qp),
  ka : Path[.A = Path[.A = Path[.A = A](y, z)](gm, qp)](Path.step km qa, Path.step ga kp)
