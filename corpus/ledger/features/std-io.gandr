/// `std-io`: `print`, `eprint` and `read_line` write standard output and standard error and read standard input through the console capability `main` opens from its authority.

import std.authority (Authority, console);
import std.io (print, eprint, read_line);

/// A line read from standard input, written back to standard output, and a
/// note on standard error.
pub def echo(authority : Authority) -> [std.io.Console.Eff, std.io.Stderr.Eff, std.io.Stdin.Eff] Unit {
  let line = read_line(console(authority));
  print(console(authority), line);
  eprint(console(authority), "echoed")
}
