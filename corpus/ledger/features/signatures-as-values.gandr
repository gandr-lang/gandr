/// `signatures-as-values`: a `theory` block presents a sort and its operations
/// as one value of `Theory`, which an ordinary function reads by `case`.
theory Monoid where
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);

/// One per operation of a presentation's chain, zero at its end.
def rec operations(chain : Theory) -> Integer =
  match chain where
    | Oper(name, inputs, outputs, rest) => { let r = operations[<] rest; r + 1 }
    | _ => 0

/// The number of operations a presentation declares.
def arity(presented : Theory) -> Integer =
  match presented where
    | Presents(sorts, opers, rules) => operations opers
    | _ => 0

/// `Monoid` declares two operations.
@[runs("2")]
def counted() -> Integer = arity Monoid;
