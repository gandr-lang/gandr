@![features((
  "data-parameters",
  "identity-types",
  "let-statements",
  "pattern-matching",
  "signatures-as-values",
  "structural-recursion",
  "universes"
))]

/// `theory-terms`: a theory's closed terms as a type, its rules
/// the type's conversion.
///
/// Implemented: `Terms(S)` exists for a theory of one plain sort whose rules
/// present a type. It has one constructor per operation, written `S.op` in a
/// term and in a pattern. The theory's rules are its conversion. `Terms S s`
/// exists for one sort of a theory of several sorts. For an indexed sort it is
/// a family over the terms of the index sort.
///
/// Not implemented: the model of the terms, the fold over a model, and an index
/// with a variable.
///
/// The unit's two cancellations convert a term to the unit. A case on the terms
/// checks where its arms agree on the terms each rule identifies, as the terms'
/// own fold does. A monoid's terms are refused `RuleNotPresentable` at
/// `Terms(S)`.
///
/// - owes: #4148 — the terms as a model of their theory and a derived fold
/// - owes: #4149 — a fold over a model value
/// - owes: #4150 — an operation across two plain sorts, and an index with a
///   variable
/// - see: corpus/model/desc/theory-terms.gandr
/// - see: corpus/model/desc/terms-of-a-sort.gandr

/// A unital magma's signature.
theory Mag where
  /// The carrier.
  sort M : Type
  /// The unit.
  oper one : M
  /// The product.
  oper mul : (x : M, y : M) --> M
  /// The unit on the left.
  rule unitL : mul one x <=> x
  /// The unit on the right.
  rule unitR : mul x one <=> x

/// The unit cancels on both sides, so the product converts to the unit.
def cancelled : Path[.A = Terms Mag] (Mag.mul Mag.one (Mag.mul Mag.one Mag.one)) Mag.one = Path.here
  Mag.one

/// The terms' fold into themselves: each rule's two sides convert under it.
def rec copy(t : Terms Mag) -> Terms Mag =
  match t where
    | Mag.one => Mag.one
    | Mag.mul x y => Mag.mul (copy[<] x) (copy[<] y)

/// A term with one product, built and folded.
@[runs("Mag.mul Mag.one Mag.one")]
def copied() -> Terms Mag = copy (Mag.mul Mag.one Mag.one);
