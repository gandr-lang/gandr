/// `record-width-subtyping`: a record with more labels stands where one with
/// fewer is expected.
def first(p : *{x : Integer}) -> Integer =
  p.x

/// A record with a label `first` never asks for, passed where it asks
/// for `x` alone.
@[runs("3")]
def wide() -> Integer = first (*{.x = 3, .y = 4});
