/// `derived-rules`: Derived rules at a model (derive r : l <=> r in T).
/// Implemented: `derive r : l <=> r in T`, an equation the theory's completed rules prove, proved for every model as a path over the model's fields and read as the member `T.r`.
/// Not implemented: a theory with an indexed sort or a nested model; #1301 owes it.
// A rule a theory's completion derives, stated as a declaration of its own
// and proved for every model: `derive r : l <=> r in T` holds when the
// theory's completed rules rewrite both sides to one normal form, and the
// rewrites are the proof. The group's laws derive the inverse of a product:
// each rule completion derived on the way is proved first, from the two paths
// of its certificate, then the statement from both sides' rewrites to their
// common normal form (Knuth and Bendix, _Simple Word Problems in Universal
// Algebras_, 1970, § 7). The rule is read at a model as the theory's member
// `Group.invMul`.

// The group's unit, associativity and inverse laws.
import "../../model/identity/group-laws.gandr" ;

/// The inverse of a product, in every group.
@[ checks ]
derive invMul : inv(mul(x, y)) <=> mul(inv(y), inv(x)) in Group

/// A bit.
@[ checks ]
data Bit : Type where {
  | Zero : Bit
  | One : Bit
}

/// Exclusive or.
@[ checks ]
def xor(a : Bit, b : Bit) -> Bit {
  match a {
    Zero => b,
    One => match b {
      Zero => One,
      One => Zero,
    },
  }
}

/// The group of order two: zero is the unit, exclusive or the product, and
/// each bit its own inverse; the two elements the presentation names are one
/// and zero.
module Parity : Model(Group) where {
  type G = Bit;
  def e = Zero;
  def a = One;
  def b = Zero;
  def inv(x : Bit) -> Bit { x }
  def mul(x : Bit, y : Bit) -> Bit { xor(x, y) }
  @[ checks ]
  def unitL(x : Bit) -> Path(Bit, mul(e, x), x) { Path.here(x) }
  @[ checks ]
  def unitR(x : Bit) -> Path(Bit, mul(x, e), x) {
    match x {
      Zero => Path.here(Zero),
      One => Path.here(One),
    }
  }
  @[ checks ]
  def assoc(x : Bit, y : Bit, z : Bit) -> Path(Bit, mul(mul(x, y), z), mul(x, mul(y, z))) {
    match x {
      Zero => Path.here(xor(y, z)),
      One => match y {
        Zero => Path.here(xor(One, z)),
        One => match z {
          Zero => Path.here(Zero),
          One => Path.here(One),
        },
      },
    }
  }
  @[ checks ]
  def invInv(x : Bit) -> Path(Bit, inv(inv(x)), x) { Path.here(x) }
  @[ checks ]
  def invE() -> Path(Bit, inv(e), e) { Path.here(Zero) }
  @[ checks ]
  def invL(x : Bit) -> Path(Bit, mul(inv(x), x), e) {
    match x {
      Zero => Path.here(Zero),
      One => Path.here(Zero),
    }
  }
}

/// The parity group, as a model.
@[ checks ]
def parityGroup : Model(Group) = pack Parity at Model(Group) ;

/// The derived rule read at the parity group, at one and zero: both sides are
/// one.
@[ checks ]
def invMulParity() -> Path(Bit, One, One) {
  let law = Group.invMul(parityGroup);
  law(One, Zero)
}
