/// `filler-generator`: a cell over a chain of paths lifts along the cells it takes as paths of paths.
///
/// Implemented: `fill[n, k](chain(m), t, d)` checks its generator `t` as a function of the chain's cells, or of its whole pasting context, into a path type. Each entry of `d` that is a path one layer deeper is an entry of `X`. The node's type is the square from `Path.step(t[X⁻], v ↑ X)` to `Path.step(u ↑ X, t[X⁺])`, each lift a whisker. Based path induction proves it, each vertex path of `X` first and then each cell of `X`, and the kernel replays the proof. The printer and the formatter write the form back as it is written, and `natassoc` fills the associator over the 3-chain. Examples 1.1 to 1.3 of the paper are rows below, each at the type Catt answers, Example 1.3 at the associator over all three cells. At level two, `fill[n, k](chain(m, (a₁, …, aₘ)), t, cells)` names `X` by its columns: a column of one 2-cell for each cell of `X`, and an empty column for each other cell. Level two certifies the shape at the stratum. Over the pasting context of a level-two shape, its points fixed, `t` takes each column's 1-cells and 2-cells in order. Each column is a chain one level up, and the sides of `t` compose the columns' first 1-cells and their last. Example 1.4 is a row below, at constant verticals.
///
/// Not implemented: the agreement of `natassoc` with `assoc_nat` at a general cell, the composites at dimension 3 at Catt's types with their verticals free, and the `Flow` and bridge instances.
///
/// Over a `Path.here` cell the filler reduces to `Path.here`, which `walkAtHere` states and proves by reflexivity.
///
/// - owes: #4120 — the agreement of `natassoc` with `assoc_nat` at a general cell
/// - owes: #3833 — the composites at dimension 3 at Catt's types, their verticals free
/// - owes: #4093 — the `Flow` instance
/// - owes: #642 — the bridge instance
/// - see: corpus/ledger/diagnostics/NoFiller.gandr
/// - see: corpus/ledger/features/naturality.gandr
/// - see: #4129 — `associatorNatural`

// `assoc`.
import std.math.path (assoc);

/// One cell, its own reflexivity: the generator over the 1-chain.
def selfLoop(A : Type, x : A, y : A) -> (f : Path(x, y)) -> Path[.A = Path[.A = A](x, y)](f, f) =
  thunk { fun (f) { Path.here f } }

/// The 1-chain's cell lifts along `fa`, and its sides compose the generator's reflexivities with `fa`.
def oneCell(
  A : Type,
  x : A,
  y : A,
  fm : Path(x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp)
) -> Path[.A = Path[.A = Path[.A = A](x, y)](fm, fp)](
  Path.step (Path.here fm) fa,
  Path.step fa (Path.here fp)
) =
  ((fill[1, 3] (chain 1)) (selfLoop A x y)) fa

/// Two cells' composite, answered by its declared type.
def composite(A : Type, x : A, y : A, z : A, f : Path(x, y), g : Path(y, z)) -> Path(
  x,
  z
) =
  Path.step f g

/// Two cells, the reflexivity of their composite: the generator over the 2-chain.
def selfComposite(A : Type, x : A, y : A, z : A) -> (f : Path(x, y)) -> ((g : Path[.A = A](
  y,
  z
)) -> Path[.A = Path[.A = A](x, z)](Path.step f g, Path.step f g)) =
  thunk { fun (f) { thunk { fun (g) { Path.here (composite A x y z f g) } } } }

/// The right whisker of `fa` by `g`: the transport along `fa` the generator lifts the first cell by.
def rightWhisker(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path(y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fp g) =
  Path.walk (fun (a) { type(Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step a g)) }) fa (Path.here (Path.step fm g))

/// The left whisker of `ga` by `f`: the transport along `ga` the generator lifts the second cell by.
def leftWhisker(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp)
) -> Path[.A = Path[.A = A](x, z)](Path.step f gm, Path.step f gp) =
  Path.walk (fun (a) { type(Path[.A = Path[.A = A](x, z)](Path.step f gm, Path.step f a)) }) ga (Path.here (Path.step f gm))

/// The 2-chain's first cell lifts along `fa`, and each side whiskers `fa` by `g`.
def firstLifted(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path(y, z)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fp g)](
  (Path.step (Path.here (Path.step fm g))) (rightWhisker A x y z fm fp fa g),
  (Path.step (rightWhisker A x y z fm fp fa g)) (Path.here (Path.step fp g))
) =
  ((fill[5, 7] (chain 2)) (selfComposite A x y z)) (*{fa, g})

/// The 2-chain's second cell lifts along `ga`, and each side whiskers `ga` by `f`.
def secondLifted(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f gm, Path.step f gp)](
  (Path.step (Path.here (Path.step f gm))) (leftWhisker A x y z f gm gp ga),
  (Path.step (leftWhisker A x y z f gm gp ga)) (Path.here (Path.step f gp))
) =
  ((fill[5, 7] (chain 2)) (selfComposite A x y z)) (*{f, ga})

/// The horizontal composite of `fa` and `ga`: `fa` whiskered by `gm`, then `ga` whiskered by `fp`.
def horizontal(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp)
) -> Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step fp gp) =
  (Path.step (rightWhisker A x y z fm fp fa gm)) (leftWhisker A x y z fp gm gp ga)

/// The associator as the generator over the 3-chain.
def associated(A : Type, x : A, y : A, z : A, w : A) -> (f : Path(x, y)) -> ((g : Path[.A = A](
  y,
  z
)) -> ((h : Path[.A = A](z, w)) -> Path[.A = Path[.A = A](x, w)](Path.step (Path.step f g) h, Path.step f (Path.step g h)))) =
  thunk { fun (f) { thunk { fun (g) { thunk { fun (h) { assoc A x y z w f g h } } } } } }

/// Example 1.3 at `{f, g, h}`: every cell lifts, and the square is the one Catt answers for `assoc ↑ {f, g, h}`.
/// Its lifts nest a whisker inside a horizontal composite, and the kernel replays the endpoints it relates.
def associatorNatural(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  gm : Path[.A = A](y, z),
  gp : Path[.A = A](y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp),
  hm : Path(z, w),
  hp : Path(z, w),
  ha : Path[.A = Path[.A = A](z, w)](hm, hp)
) -> Path[.A = Path[.A = Path[.A = A](x, w)](Path.step (Path.step fm gm) hm, Path.step fp (Path.step gp hp))](
  (Path.step (assoc A x y z w fm gm hm)) (horizontal
    A
    x
    y
    w
    fm
    fp
    ((fa (Path.step gm hm)) (Path.step gp hp)) (horizontal A y z w gm gp ga hm hp ha)),
  (Path.step (horizontal
    A
    x
    z
    ((w (Path.step fm gm)) (Path.step fp gp)) (horizontal A x y z fm fp fa gm gp ga)
    hm
    hp
    ha)) (assoc A x y z w fp gp hp)
) =
  ((fill[5, 7] (chain 3)) (associated A x y z w)) (*{fa, ga, ha})

/// The same lift at level two: the whisker `[2](1, 0)` names `fa` as the column of one 2-cell and `g` as a column of none.
def firstLiftedColumns(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path(y, z)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fp g)](
  (Path.step (Path.here (Path.step fm g))) (rightWhisker A x y z fm fp fa g),
  (Path.step (rightWhisker A x y z fm fp fa g)) (Path.here (Path.step fp g))
) =
  ((fill[4, 9] (chain 2 (*{1, 0}))) (selfComposite A x y z)) (*{fa, g})

/// The first cell's fill along `Path.here(fm)` reduces to the reflexivity of the generator's value.
def walkAtHere(A : Type, x : A, y : A, z : A, fm : Path[.A = A](x, y), g : Path(y, z)) -> Path[.A = Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fm g)](Path.here (Path.step fm g), Path.here (Path.step fm g))](
  firstLifted A x y z fm fm (Path.here fm) g,
  Path.here (Path.here (Path.step fm g))
) =
  Path.here (Path.here (Path.here (Path.step fm g)))

/// Two cells' composite as a curried function: the generator of dimension one over the 2-chain.
def composed(A : Type, x : A, y : A, z : A) -> (f : Path(x, y)) -> ((g : Path[.A = A](y, z)) -> Path[.A = A](
  x,
  z
)) =
  thunk { fun (f) { thunk { fun (g) { composite A x y z f g } } } }

/// Example 1.1: the composite is natural in its first cell, `(f ∗ g) ↑ {f}`. Catt answers a path from `Path.step(fm, g)` to `Path.step(fp, g)`, which `Path.step`'s unit laws meet.
def naturalInFirst(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path(x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path(y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fp g) =
  ((fill[5, 7] (chain 2)) (composed A x y z)) (*{fa, g})

/// The 2-chain's pasting context into its composite: the generator of dimension one over `x, y, f, z, g`.
def composedOver(A : Type) -> (x : A) -> ((y : A) -> ((f : Path[.A = A](x, y)) -> ((z : A) -> ((g : Path[.A = A](
  y,
  z
)) -> Path[.A = A](x, z))))) =
  thunk {
    fun (x) {
      thunk {
        fun (y) {
          thunk { fun (f) { thunk { fun (z) { thunk { fun (g) { composite A x y z f g } } } } } }
        }
      }
    }
  }

/// Example 1.2: the composite is natural in its whole context, `(f ∗ g) ↑ {x, f, y, g, z}`. Each cell of `X` is a square over its vertices' paths, and Catt answers the square from `Path.step(Path.step(fm, gm), za)` to `Path.step(xa, Path.step(fp, gp))`.
def naturalInContext(
  A : Type,
  xm : A,
  xp : A,
  xa : Path(xm, xp),
  ym : A,
  yp : A,
  ya : Path(ym, yp),
  zm : A,
  zp : A,
  za : Path(zm, zp),
  fm : Path(xm, ym),
  fp : Path(xp, yp),
  fa : Path[.A = Path[.A = A](xm, yp)](Path.step fm ya, Path.step xa fp),
  gm : Path(ym, zm),
  gp : Path(yp, zp),
  ga : Path[.A = Path[.A = A](ym, zp)](Path.step gm za, Path.step ya gp)
) -> Path[.A = Path[.A = A](xm, zp)](Path.step (Path.step fm gm) za, Path.step xa (Path.step fp gp)) =
  ((fill[5, 7] (chain 2)) (composedOver A)) (*{xa, ya, fa, za, ga})

/// The horizontal composite of two 2-cells as a curried function: the generator over the pasting context of `[2](1, 1)`, its points fixed.
def horizontalOver(A : Type, x : A, y : A, z : A) -> (f : Path(x, y)) -> ((p : Path[.A = A](x, y)) -> ((a : Path[.A = Path[.A = A](x, y)](
  f,
  p
)) -> ((g : Path[.A = A](y, z)) -> ((q : Path[.A = A](y, z)) -> ((b : Path[.A = Path[.A = A](y, z)](g, q)) -> Path[.A = Path[.A = A](x, z)](
  Path.step f g,
  Path.step p q
)))))) =
  thunk { fun (f) { thunk { fun (p) { thunk { fun (a) { thunk { fun (g) { thunk { fun (q) { thunk { fun (b) { horizontal A x y z f p a g q b } } } } } } } } } } } }

/// Example 1.4: the horizontal composite is natural in `{f, a, p, g, b, q}`, two 3-cylinders side by side at constant verticals. Each 2-cell of `X` is a square over its 1-cells' paths, and each side of the square composes the columns' first 1-cells or their last.
def cylinderComposite3(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path(x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  pm : Path(x, y),
  pp : Path[.A = A](x, y),
  pa : Path[.A = Path[.A = A](x, y)](pm, pp),
  am : Path[.A = Path[.A = A](x, y)](fm, pm),
  ap : Path[.A = Path[.A = A](x, y)](fp, pp),
  aa : Path[.A = Path[.A = Path[.A = A](x, y)](fm, pp)](Path.step am pa, Path.step fa ap),
  gm : Path(y, z),
  gp : Path(y, z),
  ga : Path[.A = Path[.A = A](y, z)](gm, gp),
  qm : Path(y, z),
  qp : Path(y, z),
  qa : Path[.A = Path[.A = A](y, z)](qm, qp),
  bm : Path[.A = Path[.A = A](y, z)](gm, qm),
  bp : Path[.A = Path[.A = A](y, z)](gp, qp),
  bb : Path[.A = Path[.A = Path[.A = A](y, z)](gm, qp)](Path.step bm qa, Path.step ga bp)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm gm, Path.step pp qp)](
  (Path.step (horizontal A x y z fm pm am gm qm bm)) (horizontal A x y z pm pp pa qm qp qa),
  (Path.step (horizontal A x y z fm fp fa gm gp ga)) (horizontal A x y z fp pp ap gp qp bp)
) =
  ((fill[5, 11] (chain 2 (*{1, 1}))) (horizontalOver A x y z)) (*{fa, pa, aa, ga, qa, bb})
