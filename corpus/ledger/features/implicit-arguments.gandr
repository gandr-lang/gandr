/// `implicit-arguments`: Implicit arguments.
/// Implemented: rungs A and B: implicits in one prefix block, supply by name through the slot, a solver binding only forced solutions, and the spine pass making each omitted implicit a hole the kernel never meets.
/// Not implemented: rung C; #315 owes it.
// Implicit parameters: the telescope `@[a : Type]` after a function's name
// binds parameters a use supplies by name in the instantiation slot,
// `same[a = Integer](3)`, in any order (#315). The implicit and the explicit
// parameters merge into one telescope, each after every parameter its type
// names, ties kept in the written order; which ones are implicit is the
// declaration's metadata, so the declared type is the one the function written
// with every parameter explicit, in the merged order, has. A call that omits
// its implicits has each one solved from its arguments and the type it is
// checked against (#1216). What refuses is in
// `../pathological/classifier/implicit-telescope.gandr`.

/// The identity at a type supplied by name.
@[ checks ]
def same @[a : Type] (y : a) -> a { y }

/// `same` at the integers, supplied by name.
@[ runs("3") ]
def sameRun() -> Integer { same[a = Integer](3) }

/// `same` with its implicit omitted: the argument `3` determines `a`.
@[ runs("3") ]
def sameInferred() -> Integer { same(3) }

/// The first of two values of two types, both implicit.
@[ checks ]
def first @[a : Type, b : Type] (x : a, y : b) -> a { x }

/// `first` supplied with its implicits in the written order.
@[ runs("5") ]
def firstRun() -> Integer { first[a = Integer, b = Unit](5, unit) }

/// `first` supplied with its implicits the other way round: a resident names
/// its implicit, so the order the slot writes them in is free.
@[ runs("5") ]
def firstSwapped() -> Integer { first[b = Unit, a = Integer](5, unit) }

/// `first` with both implicits omitted, each determined by its own argument.
@[ runs("5") ]
def firstInferred() -> Integer { first(5, unit) }

/// An implicit whose type names an explicit parameter written after it: the
/// merge binds `t` first, so `x : t` reads it.
@[ checks ]
def chosen @[x : t] (t : Type) -> t { x }

/// `chosen` at the integers, its implicit supplied by name.
@[ runs("7") ]
def chosenRun() -> Integer { chosen[x = 7](Integer) }

/// A stage and an implicit in one telescope: the stage quantifies the
/// signature and binds no value, the implicit binds the first parameter.
@[ checks ]
def kept @[i : Size, a : Type] (n : Integer, y : a) -> a { y }

/// `kept` with its implicit supplied by name.
@[ runs("4") ]
def keptRun() -> Integer { kept[a = Integer](0, 4) }

/// `kept` with its implicit omitted: the stage binds no value, and the second
/// argument determines `a`.
@[ runs("4") ]
def keptInferred() -> Integer { kept(0, 4) }

/// `same` called at a type the definition binds: the solution for `a` is the
/// parameter `t`, which the call stands under.
@[ checks ]
def sameAt(t : Type, y : t) -> t { same(y) }

/// A function taking a function of a type and a value of it, the result type
/// of that function implicit.
@[ checks ]
def konst @[b : Type] (f : (t : Type, t) => b) -> Integer { 1 }

/// `konst` with its implicit omitted: the lambda returns an integer under its
/// own binders, and `b` is solved as `Integer`, which names none of them.
@[ runs("1") ]
def konstInferred() -> Integer { konst(fn (t) { fn (y) { 0 } }) }

/// A function applied to the integer it is passed.
@[ checks ]
def apply(f : Integer => Integer, x : Integer) -> Integer { f(x) }

/// `same` passed as a value, its implicit supplied where it is taken: the
/// function applied to its implicits alone is a function of the rest.
@[ runs("3") ]
def passedRun() -> Integer { apply(same[a = Integer], 3) }

/// A function applied to a value of the type it is passed, the function
/// implicit: its type names `t`, so the merge binds `t` before it.
@[ checks ]
def applyAt @[g : t => t] (t : Type, v : t) -> t { g(v) }

/// `applyAt` passed as a value with `g` supplied: the supply opens a lambda
/// for `t`, which `g`'s type names, and is a function of a type and a value
/// of it (#1498).
@[ checks ]
def identityAt : (t : Type, t) => t = applyAt[g = fn (y) { y }] ;

/// `identityAt` at the integers.
@[ runs("5") ]
def identityRun() -> Integer { identityAt(Integer, 5) }

/// The integers' addition, a member of a module.
module Adding {
  /// The sum of two integers.
  @[ checks ]
  def plus(x : Integer, y : Integer) -> Integer { x + y }
}

/// A value combined with itself, the combination and its carrier implicit.
@[ checks ]
def twice @[m : Type, combine : (m, m) => m] (x : m) -> m { combine(x, x) }

/// `twice` with its combination supplied by a module path: a resident's value
/// runs to the slot's next `,` or its `]` (#1188).
@[ runs("6") ]
def twiceRun() -> Integer { twice[m = Integer, combine = Adding.plus](3) }

/// The explicit twin of `same`: the function `same`'s implicit makes explicit
/// runs as the same curried function.
@[ runs("fn (a) { fn (b) { b } }") ]
def sameExplicit(a : Type, y : a) -> a { y }
