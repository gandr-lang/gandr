/// `call-by-push-value`: a value definition and a computation definition; `-F`
/// returns a value, `thunk` suspends a computation and `become` runs it.
def answer = 42;

/// A computation returning the answer plus one.
def next() -> Integer =
  answer + 1

/// The computation suspended as a value; a run forces it.
@[runs("43")]
def stepped() -> Integer = become next ();
