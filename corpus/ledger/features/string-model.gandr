/// `string-model`: A string written in the language.
/// Implemented: a string written in the language: inline bytes or a counted buffer, UTF-8 code points, a C reading's trailing zero, copy-on-write, the in-place write a one-holder string licenses, and lent views.
/// Not implemented: replacing the builtin `String` with it.
///
/// - owes: #3555
//! The strings subject's shared declarations, imported by every source that
//! reads them (`import "../../model/strings/string-base.gandr" ;`): where a
//! string's bytes live, and the byte lists every claim reads and builds. A
//! string is a value: a copy is a new string, and no write to one is seen
//! through another
//! [Racordon-2022-implementation_strategies_mutable_value_semantics]. Short
//! strings keep their bytes inline and long ones share a buffer until a write,
//! as the C++ and Rust small-string representations do.
//!
//! - cites: [Racordon-2022-implementation_strategies_mutable_value_semantics]
//!
//! [Racordon-2022-implementation_strategies_mutable_value_semantics]: https://doi.org/10.5381/jot.2022.21.2.a2 "Racordon et al., Implementation strategies for mutable value semantics"

// The lists the bytes are held in.
import "../../model/data/data-base.gandr" ;

/// Where a string's bytes live: inline, in the string itself, when they fit;
/// otherwise in a buffer on the heap that every copy of the string shares,
/// beside the number of strings that hold it.
@[ checks ]
data Repr : Type where
  | Inline : (bytes : List(Integer)) --> Repr
  | Shared : (holders : Integer, bytes : List(Integer)) --> Repr

/// The bytes a string holds, wherever they live.
@[ checks ]
def bytes(s : Repr) -> List(Integer) =
  match s where
    | Inline(bs) => bs
    | Shared(n, bs) => bs

/// The number of bytes in a list.
@[ checks ]
def rec count(bs : List(Integer)) -> Integer =
  match bs where
    | Nil => 0
    | Cons(b, rest) => { let n = count[<] rest; n + 1 }

/// One byte list followed by another.
@[ checks ]
def rec concat(xs : List(Integer), ys : List(Integer)) -> List(Integer) =
  match xs where
    | Nil => ys
    | Cons(x, rest) => (Cons x (concat[<] rest ys) : List(Integer))

/// The number of bytes a string keeps inline, its terminating zero included.
@[ runs("24") ]
def inlineCapacity : Integer = 24 ;
