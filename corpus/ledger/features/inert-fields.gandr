/// `inert-fields`: A theory's inert operations and inert definitions.
/// Implemented: a theory's operation marked `@[ inert ]` is a field the
/// manifest step reads; a model's component for it is inert, an `include`
/// carries the mark, a top-level definition marked `@[ inert ]` is inert too,
/// another inert declaration reads an inert one, and a declaration that is not
/// inert and reads one is refused `InertRead`
/// (`corpus/ledger/diagnostics/InertRead.gandr`); a package's address leaves
/// every inert declaration out.
/// A release: its version, a field no content reads.
theory Released where {
  /// The version.
  @[inert]
  oper version : String;
}

/// A family's release.
module Family : Model(Released) where {
  /// The family's version.
  @[runs("\"0.1.0\"")]
  def version = "0.1.0";
}

/// A package of the family, its version read inert from inert.
module Member : Model(Released) where {
  /// The version, the family's.
  @[runs("\"0.1.0\"")]
  def version = Family.version;
}

/// The member's version, read by an inert definition.
@[inert]
@[runs("\"0.1.0\"")]
def released = Member.version;
