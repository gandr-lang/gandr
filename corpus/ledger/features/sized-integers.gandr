/// `sized-integers`: Sized integer arithmetic.
/// Implemented: each width has the `wrapping_`, `saturating_` and `checked_`
/// arithmetic of Rust's integer. Each width also has its division, its
/// bitwise forms, `checked_shl`, `checked_shr` and its comparisons.
/// Not implemented: no stencil runs a width form, and no method form calls
/// one. The `checked_div` with a reason is not in yet.
///
/// - owes: #8002 — the machine word, its stencils and the latency bound
/// - owes: #8003 — the method form
/// - owes: #7968 — the checked division with a named reason
// Each width has the operations of Rust's integer of the same name. A
// `checked_` form answers `w + Unit`, with the absence on the right.

/// The greatest `u8` plus one wraps to zero.
@[runs("0u8")]
def wrapped_u8() -> u8 = u8.wrapping_add 255u8 1u8;

/// The greatest `u8` plus one stays at the greatest.
@[runs("255u8")]
def saturated_u8() -> u8 = u8.saturating_add 255u8 1u8;

/// The greatest `u8` plus one is absent.
@[runs("+{.1 = *{}}")]
def checked_u8() -> u8 + Unit = u8.checked_add 255u8 1u8;

/// A shift by the bit count is absent.
@[runs("+{.1 = *{}}")]
def shifted_u32() -> u32 + Unit = u32.checked_shl 1u32 32u32;
