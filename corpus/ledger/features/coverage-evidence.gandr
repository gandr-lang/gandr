/// `coverage-evidence`: Coverage as replayable evidence.
/// Implemented: a semantic coverage verdict the kernel replays, fed by unification: a pattern hole's arms covered by the canonical cover.
/// Not implemented: index refinement and local matching equations; a hole whose cover cannot be derived is refused as undecided by name; #391 owes it.
// A match whose every arm is written covers its scrutinee, and a hole in an
// arm's body leaves it covering: the term is owed, the arm is decided. The
// twin in `pathological/holes/` leaves an arm to a pattern hole.

/// Three colours, one arm each.
@[ checks ]
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

/// Every colour has its arm.
@[ checks ]
def classify(c : Color) -> Integer {
  case c {
    Red => 0,
    Green => 1,
    Blue => 2
  }
}

/// `Green`'s arm is written and its body is a hole: the arm that runs is
/// decided, only its result is not.
@[ checks ]
def sketch(c : Color) -> Integer {
  case c {
    Red => 0,
    Green => ?,
    Blue => 2
  }
}
