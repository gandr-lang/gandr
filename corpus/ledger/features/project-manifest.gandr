/// `project-manifest`: A package, its root and its manifest.
/// Implemented: a package is the sources beside its `lib.gandr`, found from any path in it, and `gandr check` writes `gandr.toml` at its root from the library's `Package` model, refusing a hand edit as drift.
/// Not implemented: membership names, `import foo.bar`, and `workspace.gandr`; #2687 owes them.

/// The model a library declares: what `gandr check` records in `gandr.toml`.
pub module Package : Model(Gandr.Package) {
  def name = "hello";
  def version = "0.1.0";
}

/// The name the manifest records, read by its path.
@[ runs("\"hello\"") ]
def recorded = Package.name;
