/// `effect-theories`: effects as theories with laws, handled by capability scopes and named in rows.
///
/// State's laws are the rules of global state, each oriented by the path order.
/// Put-get descends by branch selection, and put-put by its subterm.
/// Overlapping laws join in the second-order reading.
///
/// A capability scope takes a theory as its interface and is checked as a model of it, its subject normalised by the laws.
/// A returner's row names the theory at the sorts it fixes, and a scope at those sorts discharges the call.
/// A fixed type may name a parameter, and each scope and exercise reads it where it stands.
///
/// - see: Cooper, "The marriage of effects and rewrites" (2023), § 2.1 — the laws of global state
/// - see: `corpus/model/effects/state-handler.gandr` — a handler answering each operation at a fixed sort
/// - see: #2116 — the overlapping laws join
/// - see: #2844 — the row names a theory at the sorts it fixes
/// - see: #2881 — a fixed type names a parameter

/// The operations alone, reading and storing a state of sort `S`, with no law.
@[ checks ]
theory State {
  /// The sort of the stored state, a value type.
  sort S : Type+;
  /// The carrier, the type each operation answers in.
  sort C : Type;
  /// Reading passes the current state to what runs after.
  oper get : (k : pi+ (s : S) . C) --> C;
  /// Storing replaces the state before what runs after.
  oper put : (s : S, k : C) --> C;
}

/// State with the put-get law alone.
@[ checks ]
theory StatePutGet {
  /// The sort of the stored state, a value type.
  sort S : Type+;
  /// The carrier, the type each operation answers in.
  sort C : Type;
  /// Reading passes the current state to what runs after.
  oper get : (k : pi+ (s : S) . C) --> C;
  /// Storing replaces the state before what runs after.
  oper put : (s : S, k : C) --> C;
  /// Storing then reading continues at the stored value, a branch selection because no operation returns `S`.
  rule putGet : put(s, get(bind t . k(t))) <=> put(s, k(s));
}

/// State with the put-put law alone.
@[ checks ]
theory StatePutPut {
  /// The sort of the stored state, a value type.
  sort S : Type+;
  /// The carrier, the type each operation answers in.
  sort C : Type;
  /// Reading passes the current state to what runs after.
  oper get : (k : pi+ (s : S) . C) --> C;
  /// Storing replaces the state before what runs after.
  oper put : (s : S, k : C) --> C;
  /// Storing twice keeps the second value.
  rule putPut : put(s, put(u, k)) <=> put(u, k);
}

/// State with put-get and put-put, whose overlap joins because both reducts store the second value and continue at it.
@[ checks ]
theory StatePutLaws {
  /// The sort of the stored state, a value type.
  sort S : Type+;
  /// The carrier, the type each operation answers in.
  sort C : Type;
  /// Reading passes the current state to what runs after.
  oper get : (k : pi+ (s : S) . C) --> C;
  /// Storing replaces the state before what runs after.
  oper put : (s : S, k : C) --> C;
  /// Storing then reading continues at the stored value.
  rule putGet : put(s, get(bind t . k(t))) <=> put(s, k(s));
  /// Storing twice keeps the second value.
  rule putPut : put(s, put(u, k)) <=> put(u, k);
}

/// State with the get-get law, which overlaps itself through its pattern and joins.
@[ checks ]
theory StateGetGet {
  /// The sort of the stored state, a value type.
  sort S : Type+;
  /// The carrier, the type each operation answers in.
  sort C : Type;
  /// Reading passes the current state to what runs after.
  oper get : (k : pi+ (s : S) . C) --> C;
  /// Reading twice reads once and continues at that state for both reads.
  rule getGet : get(bind s . get(bind t . k(s, t))) <=> get(bind s . k(s, s));
}

/// A scope over get-get reads once, because its subject normalises to one read before it runs.
/// The handler answers four, so the scope runs to eight.
@[ runs("8") ]
def readTwice() -> Integer {
  handle st : StateGetGet with sort S = Integer {
    run a <- st.get();
    run b <- st.get();
    pure a + b
  } with {
    pure(x) => pure x,
    oper get(k) => k(4)
  }
}

/// A returner whose row names `State` at `Integer`, its instance `st` a capability over `get` and `put`.
@[ checks ]
def readState() -> [st : State with sort S = Integer] Integer {
  st.get()
}

/// A scope over `State` at `Integer` discharges the row and answers the read with seven.
@[ runs("7") ]
def readUnderScope() -> Integer {
  handle s : State with sort S = Integer {
    readState()
  } with {
    pure(x) => pure x,
    oper get(k) => k(7),
    oper put(v, k) => k()
  }
}

/// A scope over `State` whose manifest fixes `S` to the parameter `a`, answering a read with `x`.
@[ checks ]
def readGiven @[a : Type] (x : a) -> a {
  handle s : State with sort S = a {
    s.get()
  } with {
    pure(y) => pure y,
    oper get(k) => k(x),
    oper put(v, k) => k()
  }
}

/// The scope at `Integer` answers the read with the seven it is given.
@[ runs("7") ]
def readGivenSeven() -> Integer {
  readGiven(7)
}

/// A returner whose row fixes `S` to the parameter `a`, its instance `st` a capability at that type.
@[ checks ]
def readAt(a : Type) -> [st : State with sort S = a] a {
  st.get()
}

/// A scope over `State` at `Integer` discharges the row at `Integer` and answers the read with seven.
@[ runs("7") ]
def readAtUnderScope() -> Integer {
  handle s : State with sort S = Integer {
    readAt(Integer)
  } with {
    pure(x) => pure x,
    oper get(k) => k(7),
    oper put(v, k) => k()
  }
}
