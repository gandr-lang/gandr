/// `effect-theories`: Effects as theories with laws.
/// Implemented: an effect as a theory of its operations whose laws the path order orients, a capability scope taking a theory as its interface and checked as a model of it, a scope answered by a module that models the theory, a scope's subject normalised by the theory's laws before it runs, and a returner's row naming the theory at the sorts it fixes, `-F [st : State with sort S = Integer] A`, discharged by a scope at those sorts.
// State as a theory: `get` passes the state to what runs after it, and `put`
// replaces the state before what runs after it. The laws are the rules of
// global state in Cooper, "The marriage of effects and rewrites" (2023),
// § 2.1, each oriented by the path order.
//
// A put stores a value: no operation returns the sort `S`, so only
// constructors and variables build a term of it. A continuation instantiated
// at the stored value selects one branch of the abstraction a `get` holds and
// calls no operation, so put-get descends as Cooper's branch selection does.
// Two of the laws in one theory overlap, and get-get overlaps itself through
// its pattern; each pair joins in the second-order reading.

/// The operations alone: reading the state of sort `S` into what runs after,
/// and storing a value of it before what runs after. A handler answers each
/// with the sort fixed (`state-handler.gandr`).
@[ checks ]
theory State {
  sort S : Type+;
  sort C : Type;
  oper get : (k : pi+ (s : S) . C) --> C;
  oper put : (s : S, k : C) --> C;
}

/// Storing a value and then reading the state is storing it and continuing
/// at it.
@[ checks ]
theory StatePutGet {
  sort S : Type+;
  sort C : Type;
  oper get : (k : pi+ (s : S) . C) --> C;
  oper put : (s : S, k : C) --> C;
  rule putGet : put(s, get(bind t . k(t))) <=> put(s, k(s));
}

/// Storing twice keeps the second value.
@[ checks ]
theory StatePutPut {
  sort S : Type+;
  sort C : Type;
  oper get : (k : pi+ (s : S) . C) --> C;
  oper put : (s : S, k : C) --> C;
  rule putPut : put(s, put(u, k)) <=> put(u, k);
}

/// Put-get and put-put together. Put-put's continuation can be a `get`, so
/// its inner `put` is a put-get redex; both reducts store the second value
/// and continue at it (#2116).
@[ checks ]
theory StatePutLaws {
  sort S : Type+;
  sort C : Type;
  oper get : (k : pi+ (s : S) . C) --> C;
  oper put : (s : S, k : C) --> C;
  rule putGet : put(s, get(bind t . k(t))) <=> put(s, k(s));
  rule putPut : put(s, put(u, k)) <=> put(u, k);
}

/// Reading twice is reading once at the same state. The inner `get` is an
/// instance of the rule's own left side through its pattern, and both
/// reducts read once and continue at that state three times (#2116).
@[ checks ]
theory StateGetGet {
  sort S : Type+;
  sort C : Type;
  oper get : (k : pi+ (s : S) . C) --> C;
  rule getGet : get(bind s . get(bind t . k(s, t))) <=> get(bind s . k(s, s));
}

/// Reading twice under a scope over get-get: before it runs, the subject
/// normalises by the law to one read, `b` bound to `a`, so the handler
/// answers one `get` and the scope runs to four twice.
@[ runs("8") ]
def readTwice() -> Integer {
  handle st : StateGetGet with sort S = Integer {
    run a <- st.get();
    run b <- st.get();
    pure a + b
  } with {
    pure(x) => pure x,
    oper get(k) => k(4)
  }
}

/// A returner whose row names the theory at its sort: `st` is its instance,
/// a capability over `get` and `put` with the state an `Integer`.
@[ checks ]
def readState() -> [st : State with sort S = Integer] Integer {
  st.get()
}

/// A scope over `State` at the same sort discharges the row: the call's
/// instance is the scope's capability, and the handler answers the read
/// with seven.
@[ runs("7") ]
def readUnderScope() -> Integer {
  handle s : State with sort S = Integer {
    readState()
  } with {
    pure(x) => pure x,
    oper get(k) => k(7),
    oper put(v, k) => k()
  }
}
