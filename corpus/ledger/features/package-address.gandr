/// `package-address`: A package's address.
/// Implemented: a package's address digests each item its sources declare, as its path and its content key, every inert component of its models left out and what a model asks of the toolchain kept; `gandr check` prints it on the manifest's line, and `gandr.toml` does not carry it.

// The manifest theories, from `std.package` by its path.
import "../../../library/std/src/package.gandr";

/// The package's model: every field but what it asks of the toolchain inert,
/// so an edit to any of those leaves the address where it was.
pub module Package : Model(Gandr.Package) {
  /// The name the manifest records.
  def name = "hello";
  /// The version the manifest records.
  def version = "0.1.0";
  /// The package's authors.
  def authors = "The gandr authors";
  /// The licence, an SPDX expression.
  def licence = "MIT OR Apache-2.0";
  /// The address the package's documentation stands at.
  def documentation = "https://github.com/gandr-lang/gandr";
  /// The address a resolver may fetch the package from.
  def endpoint = "https://github.com/gandr-lang/gandr";
  /// The least language version the sources ask for: content, so an edit to
  /// it moves the address (#3135).
  def gandr = ">= 0.0";
  /// The features the sources use, content as `gandr` is.
  def features = "project-manifest";
  /// The systems the package builds on, content as `gandr` is.
  def systems = "";
}

/// The package's content: an edit to it moves the address.
@[ runs("\"hello, world\"") ]
pub def greeting = "hello, world";
