/// `second-order-rules`: Second-order rules.
/// Implemented: a rule over a binding operation, instantiation `t(u)`, the abstraction `bind x . t` at a port, sorted at its binders, oriented by HORPO's metavariable case, its critical pairs joined in the second-order reading, and an inspected call fired in that reading.
/// Not implemented: two binders at one port, which waits on the grammar; completing a parting pair; a law relating a term at its port.
///
/// - owes: #2347
/// - owes: #1324
/// - owes: #2361
/// - see: #2328 — `LetOverlap`
/// - see: #2966 — `LetOverlap`
//! Second-order rules. A rule whose right side applies a variable that a
//! binding port of its left side binds instantiates it: `t(u)` substitutes `u`
//! for the variable `t`'s port binds, one argument per bound variable
//! [Klop-1993-combinatory_reduction_systems_introduction_and_survey]. The rules
//! terminate by the higher-order recursive path order
//! [Jouannaud-1999-the_higher_order_recursive_path_ordering]: the instantiation
//! is below an application that holds the variable and every argument directly.
//! A pair a second-order rule takes part in is found by pattern unification and
//! joined in the second-order reading
//! [Mayr-1998-higher_order_rewrite_systems_and_their_confluence].
//!
//! - cites: [Jouannaud-1999-the_higher_order_recursive_path_ordering]
//! - cites: [Klop-1993-combinatory_reduction_systems_introduction_and_survey]
//! - cites: [Mayr-1998-higher_order_rewrite_systems_and_their_confluence]
//!
//! [Jouannaud-1999-the_higher_order_recursive_path_ordering]: https://doi.org/10.1109/LICS.1999.782635 "Jouannaud and Rubio, The higher-order recursive path ordering"
//! [Klop-1993-combinatory_reduction_systems_introduction_and_survey]: https://doi.org/10.1016/0304-3975(93)90091-7 "Klop, van Oostrom and van Raamsdonk, Combinatory reduction systems: introduction and survey"
//! [Mayr-1998-higher_order_rewrite_systems_and_their_confluence]: https://doi.org/10.1016/S0304-3975(97)00143-6 "Mayr and Nipkow, Higher-order rewrite systems and their confluence"

/// ζ: `let` binds a term over its body, and its rule substitutes the bound
/// term into the body.
@[ checks ]
theory Let where
  sort Tm : Type+;
  oper let : (u : Tm, t : (x : Tm) -> Tm) --> Tm;
  rule zeta : let u t <=> t u;

/// A body binding two terms is instantiated at two arguments, outermost
/// binder first.
@[ checks ]
theory LetPair where
  sort Tm : Type+;
  oper let2 : (u : Tm, v : Tm, t : (x : Tm) -> (y : Tm) -> Tm) --> Tm;
  rule zeta2 : let2 u v t <=> t u v;

/// ζ beside first-order rules whose pair parts: completion joins `f`'s two
/// rules as it would without ζ, which overlaps neither.
@[ checks ]
theory LetBeside where
  sort Tm : Type+;
  oper zero : () --> Tm;
  oper one : () --> Tm;
  oper f : (a : Tm) --> Tm;
  oper let : (u : Tm, t : (x : Tm) -> Tm) --> Tm;
  rule zeta : let u t <=> t u;
  rule fZero : f a <=> zero ();
  rule fOne : f a <=> one ();

/// ζ beside a rule rewriting `let` at `zero()`: their left sides overlap at
/// the root, both reducts are `t(zero())`, and an inspected call
/// fires both by substitution, the inner `let` at `x` and the outer at
/// `zero()`.
@[ normalizes("let(zero, bind x . let(x, bind y . y)) ~> zero") ]
theory LetOverlap where
  sort Tm : Type+;
  oper zero : () --> Tm;
  oper let : (u : Tm, t : (x : Tm) -> Tm) --> Tm;
  rule zeta : let u t <=> t u;
  rule zetaZero : let (zero ()) t <=> t (zero ());

/// ζ's right side is the instantiation of `t`, which the presentation keeps
/// as an `Inst` node.
@[ runs("1") ]
def instantiates() -> Integer { match Let {
  | Presents(sorts, opers, rules) => match rules where
    | Rule(name, left, right, rest) => match right where
      | Inst(variable, arguments) => 1
      | _ => 0
    | _ => 0
  | _ => 0
} }
