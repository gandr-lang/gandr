/// `bicontextual-kernel-key` keys the kernel's check memo by the binders a goal's judgement reads.
///
/// Implemented: every kernel node carries the free indices it mentions from its mint, the check gathers each goal's support from the binders its judgement read, and it records the goal's memo entry over them, so one goal under two contexts that differ only where it did not read is one memo entry.
///
/// Each branch of the case in `side` answers `n` under the field its constructor binds, a natural in one branch and a flag in the other.
/// The two goals read `n` and not the field, so the memo serves the second the first's entry and the kernel checks `n` once.
///
/// - see: crates/kernel-term/src/support.rs
/// - see: crates/kernel-core/src/support.rs

/// The naturals `side` answers.
data Nat : Type {
  /// Zero.
  Zero : Nat;
  /// The natural after `n`.
  Succ : (n : Nat) --> Nat;
}

/// A flag, on or off.
data Flag : Type {
  /// On.
  On : Flag;
  /// Off.
  Off : Flag;
}

/// A natural or a flag.
data Either : Type {
  /// A natural.
  Count : (m : Nat) --> Either;
  /// A flag.
  Mark : (f : Flag) --> Either;
}

/// Answers `n` whichever side `e` takes, each branch under the field it binds.
def side(n : Nat, e : Either) -> -F Nat {
  case e -> -F Nat {
    Count(_m) => n,
    Mark(_f) => n
  }
}

/// The flag side answers the natural `side` takes first.
@[ runs("Succ(Zero)") ]
def marked() -> -F Nat {
  side(Succ(Zero), Mark(On))
}
