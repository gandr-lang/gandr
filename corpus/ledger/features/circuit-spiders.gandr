/// `circuit-spiders`: Spiders on a marked sort.
/// Implemented: a theory sort carries the attribute `@[ frobenius ]`. A circuit rule that merges or splits its wires on that sort reads as a diagram, modulo the Frobenius laws.
/// Not implemented: no rule rewrites with the spiders, and a model of a theory with such a rule is refused.
///
/// - owes: #5741
//! A sort that carries a special commutative Frobenius algebra, and a circuit
//! rule whose wires merge on it. The rule writes no node for the merge: its
//! wire map repeats the name `z`. The merge is a spider, as in Coecke and
//! Kissinger's picture calculus [Coecke-Kissinger-2017-picturing_quantum_processes].
//!
//! - cites: [Coecke-Kissinger-2017-picturing_quantum_processes]
//!
//! [Coecke-Kissinger-2017-picturing_quantum_processes]: https://doi.org/10.1017/9781316219317 "Coecke and Kissinger, Picturing Quantum Processes"

/// `Qubit` marks its sort, so a circuit rule may merge and split its wires.
theory Qubit where
  /// A wire that merges and splits.
  @[ frobenius ]
  sort Q : Type;
  /// A node with one input and one output.
  oper f : (a : Q) --> (b : Q);
  /// A second node of the same shape.
  oper g : (a : Q) --> (b : Q);

  /// `f` and `g` both write `z`: one spider merges their outputs.
  rule merge : (data x : Q, data y : Q) <=> (z : Q) {
    node : f(x) --> (z);
    node : g(y) --> (z);
  };
