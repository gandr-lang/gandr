/// `nested-operation-laws`: Operations nested in a law or a call.
/// Implemented: a theory's call nesting an operation where a value is read normalizes over terms under the block's oriented rules, each operation over an indexed sort carrying the indices its sorting fixes, and an ill-sorted call refused; a law nesting an operation over an indexed sort is read, completed and decided with those indices, an index at a sort the laws rewrite left off, so a whisker's laws read over objects.
/// Not implemented: a family's rule nesting an operation, a law whose carried indices apply an operation with indices of its own, and a law whose sides sort only modulo the block's rules, are refused `UndescribedMember.NestedOperation`; #1510 and #522 owe them.
// A choice that commits to its left branch once a cut stands there, over a
// sort graded by how a computation may end (#2792): `orBot(cut, fail)` nests
// two operations where the cell layer reads values, so it normalizes over
// terms, `fail` carrying the grade `top` its sorting fixes.

/// Choice with cut over a grade-indexed sort: `cutLeft` commits to the left
/// branch whatever grade the right one stands at.
@[ normalizes("orBot(cut, fail) ~> cut") ]
theory GradedCut {
  sort Grade : Type;
  sort M(g : Grade) : Type;

  oper bot : () --> Grade;
  oper top : () --> Grade;
  oper cut : () --> M(bot());
  oper fail : () --> M(top());
  oper orBot : (x : M(bot()), y : M(e)) --> M(bot());

  rule cutLeft : orBot(x, y) ==> x;
}

/// A category's shape: its laws over `Hom(dom, cod)` are read with the
/// objects each composite stands at, so the unit laws agree at
/// `comp(id(a), id(a))`.
theory Category {
  sort Ob : Type;
  sort Hom(dom : Ob, cod : Ob) : Type;

  oper id : (a : Ob) --> Hom(a, a);
  oper comp : (f : Hom(a, b), g : Hom(b, c)) --> Hom(a, c);

  rule unitL : comp(id(a), f) ==> f;
  rule unitR : comp(f, id(b)) ==> f;
  rule assoc : comp(comp(f, g), h) ==> comp(f, comp(g, h));
}

/// 2-cells between homs: the laws rewrite homs, so a 2-cell carries no hom,
/// and a whisker carries only the objects its hom stands between. A whisker
/// distributes over vertical composition, which the laws decide (#1510).
theory TwoCells {
  sort Ob : Type;
  sort Hom(dom : Ob, cod : Ob) : Type;
  sort Two(src : Hom(x, y), tgt : Hom(x, y)) : Type;

  oper id : (a : Ob) --> Hom(a, a);
  oper comp : (f : Hom(a, b), g : Hom(b, c)) --> Hom(a, c);
  oper vcomp : (s : Two(f, g), t : Two(g, k)) --> Two(f, k);
  oper whiskerR : (s : Two(f, g), h : Hom(b, c)) --> Two(comp(f, h), comp(g, h));

  rule unitL : comp(id(a), f) ==> f;
  rule unitR : comp(f, id(b)) ==> f;
  rule assoc : comp(comp(f, g), h) ==> comp(f, comp(g, h));
  rule vassoc : vcomp(vcomp(s, t), u) ==> vcomp(s, vcomp(t, u));
  rule whiskerDist : whiskerR(vcomp(s, t), h) ==> vcomp(whiskerR(s, h), whiskerR(t, h));
}

/// Views of an edited morphism: `fuse` and `step` rewrite `view(edit(f))`
/// two ways, so completion derives `view(patch(f)) ==> fresh(f)` over the
/// objects `f` stands at, and the kernel replays it from its peak.
theory EditedViews {
  sort Ob : Type;
  sort Hom(dom : Ob, cod : Ob) : Type;

  oper view : (f : Hom(x, y)) --> Hom(x, y);
  oper edit : (f : Hom(x, y)) --> Hom(x, y);
  oper patch : (f : Hom(x, y)) --> Hom(x, y);
  oper fresh : (f : Hom(x, y)) --> Hom(x, y);

  rule fuse : view(edit(f)) ==> fresh(f);
  rule step : edit(f) ==> patch(f);
}
