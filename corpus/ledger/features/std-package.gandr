/// `std-package`: The standard library's manifest theories.
/// Implemented: `std.package`, `library/std/src/package.gandr`, states `Versioned`, `Gandr.Package` and `Gandr.Workspace`, which a library's and a workspace's models implement, `Gandr.Module`, which no source models yet, and `Dependency` and `Coordinate`, which a library's `dependencies` lists (#3072); every field of a package, its `name`, `version`, `authors`, `licence`, `documentation` and `endpoint`, is inert, read only by the manifest step and another inert field (#3029); a source imports it by the relative path to its source, from under any root.
/// Not implemented: no source imports `std.package` by name, which #533 owes; `authors` is no list, and `dependencies` is no operation of `Gandr.Package`, which #2993 owes.

// The manifest theories, from `std.package` by its path.
import "../../../library/std/src/package.gandr";

/// A package's model, every field inert: only the manifest step reads them
/// (#3029).
pub module Package : Model(Gandr.Package) {
  /// The package's name, which the manifest records it by.
  def name = "probe";
  /// The version the package releases at.
  @[ runs("\"0.1.0\"") ]
  def version = "0.1.0";
  /// The package's authors.
  def authors = "The gandr authors";
  /// The licence, an SPDX expression.
  def licence = "MIT OR Apache-2.0";
  /// The address the package's documentation stands at.
  def documentation = "https://github.com/gandr-lang/gandr";
  /// The address a resolver may fetch the package from.
  def endpoint = "https://github.com/gandr-lang/gandr";
}

/// The package's dependencies: each an alias and the path its root stands at.
@[ runs("nil") ]
pub def dependencies : List(Dependency) = [];
