@![features((
  "call-by-push-value",
  "dependent-functions",
  "effect-handlers",
  "let-statements",
  "signatures-as-values",
  "universes"
))]

/// `UninterfacedMember`: a member of the theory a scope handles that it cannot
/// read as an operation, here the value sort no manifest fixes.
theory Stored where
  sort S : Type+
  sort C : Type
  oper get : (k : (s : S) -> C) --> C

@[refuses("UninterfacedMember")]
def unfixed() -> Integer =
  effect st : Stored {
    pure 1
  } handle {
    | pure(x) => pure x
    | oper get(k) => k 4
  }
