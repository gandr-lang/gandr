/// `ArmsDisagree`: two arms of an offer leaving an endpoint in different states.
@[ refuses("ArmsDisagree") ]
def seat_arms_leave_it_apart() -> -F Unit {
  let desk = fork (seat : &{ next : end, retire : end }) {
    offer(seat) { next => close(seat), retire => pure unit }
  };
  select(desk, next);
  close(desk)
}
