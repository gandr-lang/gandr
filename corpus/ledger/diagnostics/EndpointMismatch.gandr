@![features((
  "data-parameters",
  "identity-types",
  "let-statements",
  "products-and-sums",
  "records"
))]

/// `EndpointMismatch`: reflexivity met a path type whose endpoints its point
/// does not both convert to.
@[refuses("EndpointMismatch")]
def etaSwapped(e : Integer * Integer) -> Path *{e.1, e.0} e =
  Path.here e
