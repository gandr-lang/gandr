/// `ViewOfNoPlace`: a view block after a call of no method answering a place.
///
/// An integer's methods.
module Sized {
  /// The width, read from an integer lent for reading: a method answering no place.
  @[ checks ]
  def size(self : shared Integer) -> -F Integer { pure 2 }
}

@[ refuses("ViewOfNoPlace") ]
def sized() -> -F Integer {
  hold n = 3;
  n.size() as w { pure w }
}
