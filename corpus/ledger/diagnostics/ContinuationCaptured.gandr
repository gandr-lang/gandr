/// `ContinuationCaptured`: a continuation holding an obligation named where its end may run other than once.
module Cancel :> #{
  type Join = !String. end,
  notes : String
} where {
  /// The path a task reads.
  @[ checks ]
  def notes = "notes";
}

@[ refuses("ContinuationCaptured") ]
def leaked() -> -F Unit {
  handle c : Proc {
    let found = fork (task : Cancel.Join) {
      send(task, Cancel.notes);
      close(task)
    };
    c.exit(1);
    let text = recv(found);
    close(found)
  } with {
    pure(x) => pure x,
    oper exit(code, k) => force thunk { k(unit) }
  }
}
