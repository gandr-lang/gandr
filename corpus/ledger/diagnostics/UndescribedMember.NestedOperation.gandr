/// `UndescribedMember.NestedOperation`: a member the description does not read: a rule with an operation nested in producer position.
@[ refuses("UndescribedMember.NestedOperation") ]
theory GradedChoice {
  sort Grade : Type;
  sort M(g : Grade) : Type;

  oper bot : () --> Grade;
  oper meet : (a : Grade, b : Grade) --> Grade;
  oper cut : () --> M(bot());
  oper or : (x : M(d), y : M(e)) --> M(meet(d, e));

  rule meetBot : meet(bot(), e) ==> bot();
  rule cutLeft : or(cut(), y) ==> cut();
}
