/// `UnderivedRule`: a `derive` declaration whose two sides the theory's rules rewrite to different normal forms.
@[ checks ]
theory Involution {
  sort G : Type;
  oper inv : (x : G) --> G;
  rule invInv : inv(inv(x)) <=> x;
}

@[ refuses("UnderivedRule") ]
derive fixed : inv(x) <=> x in Involution
