/// `StaticLambdaArgument`: a type operator passed where a dynamic parameter needs a value.
@[ runs("fun (a) { unit }") ]
def use(f : Type -> Type) -> -F Unit { return unit }

@[ refuses("StaticLambdaArgument") ]
def at_a_dynamic_parameter : +U (-F Unit) ;

def at_a_dynamic_parameter = thunk { use(fun (X) { type(#{X, X}) }) } ;
