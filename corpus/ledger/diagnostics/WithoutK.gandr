@![features(("data-parameters", "explicit-exits", "identity-types", "let-statements", "pattern-matching"))]

/// `WithoutK`: a path matched against reflexivity, `here`.
@[refuses("WithoutK")]
def uip(n : Integer, p : Path n n, q : Path n n) -> Path[.A = Path[.A = Integer] n n] p q =
  match p { | here => match q { | here => return Path.here p } }
