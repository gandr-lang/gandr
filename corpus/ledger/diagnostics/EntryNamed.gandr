/// `EntryNamed`: an entry named from another declaration.
module Seat :> *{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = Dispatch >? rec turn => +{
    report : Report >! &{next : turn, retire : end},
    handoff : Handoff >! end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} where {
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  @[checks]
  def task = "task";
  /// A report it sends.
  @[checks]
  def progress = "progress";
  /// The notes it hands off.
  @[checks]
  def notes = "notes";
}

world operator;

world seat;

@[entry(*{operator, seat})]
def collect() -> Seat.Report =
  migrate [seat] { pure Seat.progress }

@[refuses("EntryNamed")]
@[entry(*{operator, seat})]
def relayed() -> Seat.Report =
  collect ()
