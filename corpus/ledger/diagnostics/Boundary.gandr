@![features(("dependent-functions", "directed-paths", "let-statements", "modules", "pattern-matching", "products-and-sums", "records"))]

/// `Boundary`: a function flow's boundary that runs against its variance.
module Schema where {
  type Old = String * Integer;
  type New = Integer * String;
  @[checks]
  def toNew(old : Old) -> New =
    match old where
      | *{name, age} => *{age, name}
  @[checks]
  def upgrade : Flow[.A = Type](Old, New) = Flow.into toNew;
  @[refuses("Boundary")]
  def reader : Flow[.A = Type](Old -> Integer, New -> Integer) = Flow.arrow
    upgrade
    (Flow.stay Integer);
}
