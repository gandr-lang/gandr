/// `Boundary`: a function flow's boundary that runs against its variance.
module Schema where {
  type Old = String * Integer;
  type New = Integer * String;
  @[ checks ]
  def toNew(old : Old) -> -F New {
    match old {
      #{name, age} => (age, name)
    }
  }
  @[ checks ]
  def upgrade : Flow(Type, Old, New) ;
  def upgrade = Flow.into(toNew) ;
  @[ refuses("Boundary") ]
  def reader : Flow(Type, Old => Integer, New => Integer) ;
  def reader = Flow.arrow(upgrade, Flow.stay(Integer)) ;
}
