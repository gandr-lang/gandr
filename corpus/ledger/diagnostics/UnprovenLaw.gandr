/// `UnprovenLaw`: a law of a module's model the module neither proves nor admits.
///
/// The theory the model derives from.
@[ checks ]
theory Reflexive {
  sort Carrier : Type;
  oper alike : (a : Carrier, b : Carrier) --> Bool;
  law refl : (a : Carrier) => Path(Bool, alike(a, a), true);
}

@[ refuses("UnprovenLaw") ]
module Unproven : Model(Reflexive) with sort Carrier = Integer {
  def alike(a : Integer, b : Integer) -> Bool { true }
}
