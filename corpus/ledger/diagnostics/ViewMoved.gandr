@![features((
  "call-by-push-value",
  "let-statements",
  "native-primitives",
  "records",
  "temporary-access"
))]

/// `ViewMoved`: an abort of a view whose value held at grade one a
/// read moved out.
def succ(n : Integer) -> Integer =
  pure n + 1

@[refuses("ViewMoved")]
def moved_then_aborted() -> Integer =
  var[1] c = 0
  access c as v { let n = succ v; abort v; pure n } unwind { pure *{} }
