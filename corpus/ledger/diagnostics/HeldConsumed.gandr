/// `HeldConsumed`: a held slot read, accessed or consumed after a consumed
/// receiver ended its hold, or consumed on one arm of an offer and
/// not on another.
/// An integer's methods.
module Taken where {
  /// The integer, taken.
  @[checks]
  def take(self : consumed Integer) -> Integer = pure self;
  /// The integer, read.
  @[checks]
  def look(self : shared Integer) -> Integer = pure 1;
}

@[refuses("HeldConsumed")]
def readAfterTaken() -> Integer =
  var n = 3
  let m = n.take ()
  n.look ()
