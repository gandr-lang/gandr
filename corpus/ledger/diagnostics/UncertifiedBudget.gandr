/// `UncertifiedBudget`: univalence over a catalogue of more shape classes than
/// the stratum budget.
theory Magma where
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);

def exchange(b : Bool) -> Bool =
  match b where
    | true => +{.1 = *{}}
    | false => +{.0 = *{}}

def keep(e : +{Unit}) -> +{Unit} =
  e

def raised = ua[
  2,
  4
] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});

@[refuses("UncertifiedBudget")]
def crowded = ua[
  1,
  8
] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});
