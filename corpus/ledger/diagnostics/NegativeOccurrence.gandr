@![features(("data-parameters", "dependent-functions", "nominal-data", "universes"))]

/// `NegativeOccurrence`: a data declaration's own family occurs under a
/// function's domain where no stage reaches it.
data Two : Type where
  | L : Two
  | R : Two

@[refuses("NegativeOccurrence")]
data Lop(a : Type) : Type where
  | MkLop : (f : Lop Two -> Two) --> Lop a
