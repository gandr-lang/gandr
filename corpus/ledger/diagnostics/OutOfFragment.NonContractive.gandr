/// `OutOfFragment.NonContractive`: a form out of the fragment: the form is a
/// `mu` whose body is a `mu` or a recursion variable, so the protocol recurses
/// before any action.
@[refuses("OutOfFragment.NonContractive")]
def recursion_before_any_action() -> Unit =
  let desk = fork (seat : rec turn => turn) { close seat };
  close desk
