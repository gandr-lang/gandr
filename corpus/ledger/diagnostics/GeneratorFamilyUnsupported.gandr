/// `GeneratorFamilyUnsupported`: a fill whose lifted cell is a directed flow, a family with no filler yet.
///
/// - owes: #4093 — the fill over a flow of paths, `alongFlow`

/// One cell, its own reflexivity: the generator over the 1-chain.
@[ checks ]
def selfLoop(A : Type, x : A, y : A) -> (f : Path(x, y)) -> Path[.A = Path[.A = A](x, y)](f, f) =
  thunk { fun (f) { Path.here f } }

/// The fill over a path of paths, the `Path` instance.
@[ checks ]
def alongPath(A : Type, x : A, y : A, fm : Path(x, y), fp : Path(x, y), fa : Path[.A = Path[.A = A](x, y)](fm, fp)) -> Path[.A = Path[.A = Path[.A = A](x, y)](fm, fp)](
  Path.step (Path.here fm) fa,
  Path.step fa (Path.here fp)
) =
  fill[1, 3] (chain 1) (selfLoop A x y) fa

/// The same fill over a flow of paths, whose instance is not built yet.
@[ refuses("GeneratorFamilyUnsupported") ]
def alongFlow(A : Type, x : A, y : A, fm : Path(x, y), fp : Path(x, y), fa : Flow[.A = Path(x, y)](fm, fp)) -> Path[.A = Path[.A = A](x, y)](fm, fp) =
  fill[1, 3] (chain 1) (selfLoop A x y) fa
