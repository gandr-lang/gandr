/// `FeatureUndeclared`: a source that declares its language features uses one
/// that the declaration does not state. The head declares `modules`, which the
/// module `Inner` uses, and the mark `deprecated` is a form of the feature
/// `deprecation`.
@![features("modules")]

@[refuses("FeatureUndeclared")]
@[deprecated]
def one() -> Integer = 1;

module Inner where {
  def two() -> Integer = 2;
}
