/// `ContinuationUnspent`: an operation clause owing its continuation, which holds an obligation, finishing without resuming or abandoning it.
module Cancel :> #{
  type Join = !String. end,
  notes : String
} where {
  /// The path a task reads.
  @[ checks ]
  def notes = "notes";
}

@[ refuses("ContinuationUnspent") ]
def dropped() -> -F Unit {
  handle c : Proc {
    let found = fork (task : Cancel.Join) {
      send(task, Cancel.notes);
      close(task)
    };
    c.exit(1);
    let text = recv(found);
    close(found)
  } with {
    pure(x) => pure x,
    oper exit(code, k) => pure unit
  }
}
