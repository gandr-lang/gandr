/// `SessionNotSubtype`: a `Flow.sim` whose source does not simulate its target.
module Evolution where {
  type SeatEnd = String >? rec turn => +{
    report : String >! &{next : turn, retire : end},
    handoff : String >! end
  };
  type SeatEnd′ = String >? rec turn => +{
    report : String >! &{next : turn, retire : end},
    handoff : String >! end,
    pause : String >! turn
  };
  @[refuses("SessionNotSubtype")]
  def narrowed : Flow[.A = Type](SeatEnd′, SeatEnd) = Flow.sim SeatEnd′ SeatEnd;
}
