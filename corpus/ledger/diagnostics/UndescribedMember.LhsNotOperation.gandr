/// `UndescribedMember.LhsNotOperation`: a member the description does not read:
/// a rule whose left side is no operation application.
@[refuses("UndescribedMember.LhsNotOperation")]
theory Shared where
  sort Nat : Type;
  oper f : (a : Nat) --> (b : Nat);

  rule stray : (rule p : Nat ==> Nat, data x : Nat) ==> (o : Nat) {
    node : p(x) ==> (m);
    node : f(m) --> (n);
  };
