/// `UncertifiedCondition`: univalence over a catalogue whose site fails the
/// corolla or the Segal condition.
theory Magma where
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);

def exchange(b : Bool) -> Bool =
  match b where
    | true => +{.1 = *{}}
    | false => +{.0 = *{}}

def keep(e : +{Unit}) -> +{Unit} =
  e

def raised = ua[
  2,
  4
] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});

@[refuses("UncertifiedCondition")]
def empty = ua[
  1,
  0
] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});
