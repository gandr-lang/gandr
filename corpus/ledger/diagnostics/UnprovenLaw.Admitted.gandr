/// `UnprovenLaw.Admitted`: a law of a module's model admitted at a carrier the host does not provide.
///
/// The theory the model derives from.
@[ checks ]
theory Reflexive {
  sort Carrier : Type;
  oper alike : (a : Carrier, b : Carrier) --> Bool;
  law refl : (a : Carrier) => Path(Bool, alike(a, a), true);
}

/// One value, of a type the source writes.
@[ checks ]
data Lone : Type {
  Alone : Lone;
}

/// The model at `Lone`.
module Admitting : Model(Reflexive) with sort Carrier = Lone {
  def alike(a : Lone, b : Lone) -> Bool { true }
  @[ refuses("UnprovenLaw.Admitted") ]
  law refl admitted;
}
