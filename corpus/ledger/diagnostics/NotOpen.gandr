@![features((
  "call-by-push-value",
  "dependent-functions",
  "let-statements",
  "located-judgements",
  "records",
  "temporary-access",
  "thunks-and-force"
))]

/// `NotOpen`: a handle crossing to another world over a thunk reached through a
/// variable, which carries no image.
world operator

world seat

@[refuses("NotOpen")]
@[entry(*{operator, seat})]
def heldThunk() -> -F ((() -> Integer) at seat) =
  migrate [seat] {
    let later : () -> Integer = thunk { pure 3 }
    (hold later)
  }
