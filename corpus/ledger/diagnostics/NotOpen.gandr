/// `NotOpen`: a handle crossing to another world over a thunk reached through a variable, which carries no image.
@[ checks ]
world operator;

@[ checks ]
world seat;

@[ refuses("NotOpen") ]
@[ entry((operator, seat)) ]
def heldThunk() -> -F ((() => Integer) at seat) {
  migrate [seat] {
    run later : () => Integer <- pure thunk { pure 3 };
    (hold later)
  }
}
