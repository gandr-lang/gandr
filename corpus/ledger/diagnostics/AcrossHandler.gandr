@![features(("call-by-push-value", "effect-handlers", "explicit-exits", "imports", "let-statements", "modules", "records"))]

/// `AcrossHandler`: a `become` in a handled subject, or a `break` or a
/// `continue` there whose loop holds the scope.

// Early exit's host interface.
import std.process;

/// A `become` inside the subject of a handled scope.
@[refuses("AcrossHandler")]
def became() -> Integer =
  effect c : std.process.Exit.Eff {
    become one ()
  } handle {
    | pure(x) => pure x
    | oper exit(code, k) => k *{}
  }
