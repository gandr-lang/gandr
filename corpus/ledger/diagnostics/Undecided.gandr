/// `Undecided`: a claim the machine cannot decide: a `ua` whose translator branches on a lazy record's entry, which the machine does not observe.
theory Magma {
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);
}

@[ checks ]
def keep(e : +{Unit}) -> -F +{Unit} {
  e
}

@[ checks ]
def flag() -> &{get : -F Bool} {
  &{.get => true}
}

@[ checks ]
def observed(m : +U &{get : -F Bool}) -> Bool {
  m.get
}

@[ checks ]
def measured(b : Bool) -> -F Bool {
  if observed(flag) {
    case b {
      true => +{.1 = unit},
      false => +{.0 = unit}
    }
  } else {
    b
  }
}

@[ refuses("Undecided") ]
def compared = ua[
  1,
  4
](Magma, Magma, #{.mul = measured, .one = keep}, #{.mul = measured, .one = keep}) ;
