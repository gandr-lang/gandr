/// `NotAnAbstractType`: a member typed at an abstract type whose declaration was refused.
module Seat :> #{
  mobile type Report,
  progress : Report
} where {
  @[ refuses("MarkUnfounded") ]
  type Report = +U (Integer -> -F Integer);
  @[ refuses("NotAnAbstractType") ]
  def progress = thunk { fun (x) { return x } };
}
