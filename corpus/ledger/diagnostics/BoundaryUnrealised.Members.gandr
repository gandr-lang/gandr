/// `BoundaryUnrealised.Members`: an `extern "rust"` block whose `boundary` attribute names more rows than it declares members.
// The boundary check reads `admitBlock` here, whatever the listing names.
import std.boundary (Arg, NoCode, Plain, Row);
import std.layout (U32);

/// Two `u32` to a `u32`.
def addRow : Row = Row (Arg (Plain U32) (Arg (Plain U32) NoCode)) (Plain U32);

@[ boundary(*{addRow, addRow}), refuses("BoundaryUnrealised.Members") ]
extern "rust" from "twice" as Twice {
  def add(x : u32, n : u32) -> u32;
}
