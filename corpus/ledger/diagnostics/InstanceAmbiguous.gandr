/// `InstanceAmbiguous`: a call omitting an instance where several of its interface stand.

// The console's host interface.
import std.io;

/// A line printed through the console instance the row labels `out`.
def say() -> [out : std.io.Console.Eff] Unit {
  out.print("said")
}

@[ refuses("InstanceAmbiguous") ]
def ambiguous() -> Integer {
  handle a : std.io.Console.Eff {
    handle b : std.io.Console.Eff {
      say();
      pure 0
    } with {
      pure(x) => pure x,
      oper print(line, k) => pure 2
    }
  } with {
    pure(x) => pure x,
    oper print(line, k) => pure 1
  }
}
