@![features(("capabilities", "effect-handlers", "explicit-exits", "imports", "modules", "records"))]

/// `CapabilityEscaped`: a scoped capability that would outlive its region.

// Early exit's host interface.
import std.process

/// A scope that returns its own capability.
@[refuses("CapabilityEscaped")]
def leak() -> Cap[exit] = effect c : std.process.Exit.Eff {
  return c
} handle {
  | pure(x) => x
  | oper exit(code, k) => k *{}
};
