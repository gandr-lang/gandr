/// `OpenedElsewhere`: an opening `let x at w` writing another world than the
/// one its handle stands at.
module Seat :> *{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = Dispatch >? rec turn => +{
    report : Report >! &{next : turn, retire : end},
    handoff : Handoff >! end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} where {
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  @[checks]
  def task = "task";
  /// A report it sends.
  @[checks]
  def progress = "progress";
  /// The notes it hands off.
  @[checks]
  def notes = "notes";
}

world operator;

world seat;

@[refuses("OpenedElsewhere")]
@[entry(operator)]
def openedHere(report : Seat.Report at seat) -> Seat.Report =
  let written at operator = report
  pure written
