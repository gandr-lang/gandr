@![features((
  "call-by-push-value",
  "effect-handlers",
  "imports",
  "let-statements",
  "modules",
  "records"
))]

/// `BufferReturnedTwice`: a placed buffer handed back a second time.

// The ring's host interface.
import std.io

/// Frees one buffer twice in one scope.
@[refuses("BufferReturnedTwice")]
def freedTwice() -> Unit =
  effect r : std.io.Ring.Eff do
    let b = r.alloc 4096
    let first = r.free b
    r.free b
  handle
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
