/// `HandlerCoverage`: handler clauses do not cover their interface exactly.

// Early exit's host interface.
import std.process;

/// A handler of early exit with no clause for `exit`.
@[refuses("HandlerCoverage")]
def asked() -> -F Integer =
  handle c : std.process.Exit.Eff {
    pure 1
  } with {
    | pure(x) => pure x
  }
