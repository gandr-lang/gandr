/// `CapabilityCaptured`: a migration under a former that may run it
/// other than once.
module Seat :> *{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = Dispatch >? rec turn => +{
    report : Report >! &{next : turn, retire : end},
    handoff : Handoff >! end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} where {
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  @[checks]
  def task = "task";
  /// A report it sends.
  @[checks]
  def progress = "progress";
  /// The notes it hands off.
  @[checks]
  def notes = "notes";
}

world operator;

world seat;

@[refuses("CapabilityCaptured")]
@[entry(*{operator, seat})]
def suspended() -> () -> Seat.Report =
  pure thunk { migrate [seat] { pure Seat.progress } }
