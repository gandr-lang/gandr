/// `DerivedComponent`: a model writing a component under the name of a rule its theory derives.
@[ checks ]
theory Involution {
  sort G : Type;
  oper inv : (x : G) --> G;
  rule invInv : inv(inv(x)) <=> x;
}

@[ checks ]
derive invFour : inv(inv(inv(inv(x)))) <=> x in Involution

module Same : Model(Involution) {
  type G = Integer;
  def inv(x : Integer) -> Integer { x }
  def invInv(x : Integer) -> Path(Integer, inv(inv(x)), x) { here(x) }
  @[ refuses("DerivedComponent") ]
  def invFour(x : Integer) -> Path(Integer, inv(inv(inv(inv(x)))), x) { here(x) }
}
