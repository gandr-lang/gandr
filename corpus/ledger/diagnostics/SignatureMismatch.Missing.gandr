/// `SignatureMismatch.Missing`: an import at a signature that states a member its source exports no `pub` declaration of.
@[ refuses("SignatureMismatch.Missing") ]
theory Wider {
  oper answer : Integer;
  oper extra : Integer;
}

// The source declares `answer` and no `extra`.
import "../syntax/pub-declaration.gandr" as declared : Wider;

@[ refuses("SignatureMismatch.Missing") ]
def relayed = declared.answer;
