/// `ComonoidAbsent`: a binder of the intuitionistic zone holds a qubit, which has no copy and no discard.

// The qubit type, which carries no comonoid.
import std.quantum (Qubit);

/// Takes a qubit at `->`, whose binder may use it any number of times.
@[ refuses("ComonoidAbsent") ]
def keep(q : Qubit) -> Qubit = q ;
