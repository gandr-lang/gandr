/// `InstanceUnanswered`: a call omitting an instance where none of
/// its interface stands.

// The console's host interface.
import std.io;

/// A line printed through the console instance the row labels `out`.
def say() -> [out : std.io.Console.Eff] Unit =
  out.print "said"

@[refuses("InstanceUnanswered")]
def unanswered() -> [std.io.Console.Eff] Unit =
  say ()
