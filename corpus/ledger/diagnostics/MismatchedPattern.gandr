/// `MismatchedPattern`: a case arm naming a constructor of another data type
/// than the first arm's.
data Bit : Type where
  | Zero : Bit
  | One : Bit

data Box : Type where
  | Boxed : (n : Integer) --> Box

@[refuses("MismatchedPattern")]
def mixed(b : Bit) -> Integer =
  match b where
    | Zero => return 0
    | Boxed(n) => return n
