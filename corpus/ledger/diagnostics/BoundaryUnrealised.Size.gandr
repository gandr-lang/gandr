/// `BoundaryUnrealised.Size`: an `extern "rust"` block whose member declares a type of another size than its row's.
// The boundary check reads `admitBlock` here, whatever the listing names.
import std.boundary (Arg, NoCode, Plain, Row);
import std.layout (U32);

/// Two `u32` to a `u32`.
def addRow : Row = (Row ((Arg (Plain U32)) (Arg (Plain U32) NoCode))) (Plain U32);

@[ boundary(addRow), refuses("BoundaryUnrealised.Size") ]
extern "rust" from "counted" as Counted {
  def add(x : u32, n : u64) -> u32;
}
