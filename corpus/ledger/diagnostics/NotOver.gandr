/// `NotOver`: a telescope transport's second identity that does not lie over its path.
@[ checks ]
data Circle : Type where {
  | Base
  | loop : Base <-> Base
}

@[ normalizes("S(S(P(P(S(Z))))) ~> S(Z)") ]
data Int : Type where {
  | Z
  | S(x : Int)
  | P(x : Int)
  rule S(P(x)) <=> x;
  rule P(S(x)) <=> x;
}

@[ checks ]
data Nat : Type where {
  | Zero
  | Succ(n : Nat)
}

@[ refuses("NotOver") ]
def astray(a: Nat, b: Nat, q: Path(Nat, a, b), v: Nat) -> -F Nat {
  transport(+U ((y : Nat) -> (z : Path(Nat, a, y)) -> -F Nat), q, here(a), here(here(a)), v)
}
