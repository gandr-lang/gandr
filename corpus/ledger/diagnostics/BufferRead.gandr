@![features(("buffer-tokens", "call-by-push-value", "effect-handlers", "imports", "let-statements", "modules", "records"))]

/// `BufferRead`: a placed buffer read other than by the send, the operation or
/// the resumption that returns it.

// The native buffer a receive places live.
import std.buffer (Buf);

// The ring's host interface.
import std.io;

/// Copies a buffer the ring holds live, then frees it.
@[refuses("BufferRead")]
def readWhileHeld() -> Unit =
  effect r : std.io.Ring.Eff {
    let b = r.alloc 4096
    let copied : Buf = b
    r.free b
  } handle {
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
  }
