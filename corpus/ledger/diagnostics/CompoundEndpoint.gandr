@![features((
  "call-by-push-value",
  "data-parameters",
  "dependent-functions",
  "explicit-exits",
  "let-statements",
  "nominal-data",
  "thunks-and-force",
  "universes"
))]

/// `CompoundEndpoint`: a compound endpoint whose computation returns
/// no pure value.
@[checks, form(explicit)]
data Two : Type where
  | L : Two
  | R : Two

@[refuses("CompoundEndpoint")]
def curried(g : +U (Two -> Two -> -F Type), v : g L) -> -F Two =
  return L
