/// `CapabilityForged`: a term standing at a capability type that is
/// no capability hypothesis.

// The filesystem's host interface.
import std.fs;

/// Reads a file through a capability that grants reading.
def peek(c : Cap { read }) -> [std.fs.Eff] String =
  c.read "notes"

@[refuses("CapabilityForged")]
def forged() -> [std.fs.Eff] String =
  peek "fs"
