/// `Elsewhere`: a hypothesis or a resident used at a world other than its own.
module Seat :> #{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = ?Dispatch. mu turn. +{
    report : !Report. &{ next : turn, retire : end },
    handoff : !Handoff. end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} {
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  @[ checks ]
  def task = "task";
  /// A report it sends.
  @[ checks ]
  def progress = "progress";
  /// The notes it hands off.
  @[ checks ]
  def notes = "notes";
}

@[ checks ]
world operator ;

@[ checks ]
world seat ;

@[ refuses("Elsewhere") ]
@[ entry(operator) ]
def readHere(report : Seat.Report at seat) -> -F Seat.Report {
  leta written = report;
  pure written
}
