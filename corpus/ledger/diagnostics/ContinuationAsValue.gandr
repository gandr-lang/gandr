@![features((
  "call-by-push-value",
  "data-parameters",
  "effect-handlers",
  "imports",
  "let-statements",
  "modules",
  "records",
  "session-types"
))]

/// `ContinuationAsValue`: a continuation holding an obligation read as a value,
/// other than as what a resumption or an abandonment ends.

// Early exit's host interface.
import std.process

/// A task's join protocol and the path it reads.
module Cancel :> *{
  type Join = String >! end,
  notes : String
} where {
  /// The path a task reads.
  @[checks]
  def notes = "notes"
}

def resume_stack(j : Stack (-F Unit) (-F Unit)) -> Unit =
  j *{}

@[refuses("ContinuationAsValue")]
def handed() -> Unit =
  effect c : std.process.Exit.Eff do
    let found = fork (task : Cancel.Join) do
      send task Cancel.notes
      close task
    c.exit 1
    let text = recv found
    close found
  handle
    | pure(x) => pure x
    | oper exit(code, k) => resume_stack k
