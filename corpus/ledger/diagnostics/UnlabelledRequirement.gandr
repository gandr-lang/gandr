/// `UnlabelledRequirement`: a world requiring an effect theory under no label, so its code cannot perform it.
pub theory Store {
  sort V : Type+;
  sort C : Type;
  oper get : (key : V, k : pi+ (v : V). C) --> C;
}

@[ refuses("UnlabelledRequirement") ]
pub world far requires [Store with sort V = String];
