/// `RulesUncompleted`: two rules of a block rewriting one term to two normal forms no rule the path order orients joins.
@[ refuses("RulesUncompleted") ]
theory Leaked {
  boundary Two { p, q };
  face left = {p};
  sort Val : Type;

  oper zero : Val;
  ext Cell = Val on left is zero;

  rule leaked : outCellp(inCell(yq)) ==> yq;
}
