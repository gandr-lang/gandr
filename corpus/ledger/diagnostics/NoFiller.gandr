/// `NoFiller`: a fill asked for a square its generator does not make.
// `Circle`, `Base`, `loop`.
import "../../model/identity/circle-base.gandr" ;

/// One cell, its own reflexivity: the generator over the 1-chain.
@[ checks ]
def selfLoop(A : Type, x : A, y : A) -> (f : Path[.A = A](x, y)) => Path[.A = Path[.A = A](x, y)](f, f) {
  thunk { fun (f) { Path.here(f) } }
}

/// The square the generator makes at a path of paths from `loop` to itself.
@[ checks ]
def made(a : Path[.A = Path[.A = Circle](Base, Base)](loop, loop)) -> Path[.A = Path[.A = Path[.A = Circle](Base, Base)](loop, loop)](
  Path.step(Path.here(loop), a),
  Path.step(a, Path.here(loop))
) {
  fill[1, 3](chain(1), selfLoop(Circle, Base, Base), (a))
}

/// The same fill asked for a path from `loop` to `Path.here(Base)`, which no square of the generator is.
@[ refuses("NoFiller") ]
def unmade(a : Path[.A = Path[.A = Circle](Base, Base)](loop, loop)) -> Path[.A = Path[.A = Circle](Base, Base)](loop, Path.here(Base)) {
  fill[1, 3](chain(1), selfLoop(Circle, Base, Base), (a))
}
