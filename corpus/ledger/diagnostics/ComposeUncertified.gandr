/// `ComposeUncertified`: a composite at a degree no chain of
/// the catalogue reaches.
@[checks]
def certified(A : Type, x : A, y : A, z : A, p : Path(x, y), q : Path(y, z)) -> Path(x, z) =
  compose[3, 5] (chain 2) (p, q)

@[refuses("ComposeUncertified")]
def uncertified(A : Type, x : A, y : A, z : A, p : Path(x, y), q : Path(y, z)) -> Path(x, z) =
  compose[0, 5] (chain 2) (p, q)
