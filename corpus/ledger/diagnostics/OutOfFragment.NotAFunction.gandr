/// `OutOfFragment.NotAFunction`: a form out of the fragment: the form is `Path.ap` at a constructor, which is not a function.
data Circle : Type where {
  | Base : Circle
  | loop : Base <-> Base
}

@[ refuses("OutOfFragment.NotAFunction") ]
def cong_at_point : Path(Circle, Base, Base) ;

def cong_at_point = Path.ap(Base, loop) ;
