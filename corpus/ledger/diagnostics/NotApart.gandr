/// `NotApart`: a case of no branches over a path type whose endpoints are not shown apart.
data Empty : Type where {}

data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S(P(x)) <=> x;
  rule : P(S(x)) <=> x;
}

@[ refuses("NotApart") ]
def agree(e : Path(Int, S(P(Z)), Z)) -> -F Empty {
  case e {}
}
