/// `StageNotCarried`: a transport moves a value of a recursion along a path whose carrier is not a set.
data Circle : Type where
  | Base : Circle
  | loop : Base <-> Base

data Nat : Type where
  | Zero : Nat
  | Succ : (n : Nat) --> Nat

@[ refuses("StageNotCarried") ]
def rec alongLoop(n : Nat, q : Path(Base, Base)) -> Nat =
  match n where
    | Zero => Zero
    | Succ(m) => Succ (alongLoop[<] (Path.walk (fun (x) { Nat }) q m) q)
