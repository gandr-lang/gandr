/// `StageNotCarried`: a transport moves a value of a recursion along a path whose carrier is not a set.
data Circle : Type where {
  | Base : Circle
  | loop : Base <-> Base
}

data Nat : Type where {
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
}

@[ refuses("StageNotCarried") ]
def rec alongLoop(n : Nat, q : Path(Circle, Base, Base)) -> Nat {
  match n {
    Zero => Zero,
    Succ(m) => Succ(alongLoop[<](transport(\x. Nat, q, m), q))
  }
}
