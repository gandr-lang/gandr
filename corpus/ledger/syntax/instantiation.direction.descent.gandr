@![features((
  "let-statements",
  "nominal-data",
  "pattern-matching",
  "structural-recursion",
  "universes"
))]

/// `instantiation.direction.descent`: a recursive call made on
/// a smaller argument.
data Nat : Type where
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
def rec down(n : Nat) -> Nat =
  match n where
    | Zero => n
    | Succ p => down[<] p
