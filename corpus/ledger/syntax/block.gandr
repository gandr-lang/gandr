/// `block`: a block: statements, then the computation it ends in.
@[ checks ]
def answer() -> -F Integer {
  run n <- { pure 40 };
  let one = 1;
  let m : Integer = n + one;
  return m + one
}

/// A value a `let` names is the value itself where the name is read.
@[ checks ]
def three() -> -F Path(Integer, 3, 3) {
  let x = 3;
  return here(x)
}

/// A `var` holds a value over the rest of its block; an access writes it.
@[ checks ]
def counted() -> -F Integer {
  var c = 1;
  access c as v { resume(v, v + 1) };
  pure c
}

/// An assignment writes a held place: `=` the right side's value, `+=`, `-=`
/// and `*=` the operator over the place's value and it, the right side read
/// before the place is lent.
@[ checks ]
def assigned() -> -F Integer {
  var n = 1;
  n = n + 1;
  n *= 3;
  n -= 1;
  return n
}

/// A `var` may state its value's type, which a list needs to be read.
@[ checks ]
def listed() -> -F Integer {
  var xs : List(Integer) = #[1, 2];
  xs.#[0] += 1;
  return 0
}
