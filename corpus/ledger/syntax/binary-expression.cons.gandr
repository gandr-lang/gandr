/// `binary_expression.cons`: path cons: a step before the rest of a path, written with its glyph and in ASCII.
@[ checks ]
data Circle : Type where {
  | Base : Circle
  | loop : Base <-> Base
}
@[ checks ]
def flipped : Path(Circle, Base, Base) = back(loop) ∷ Path.here(Base) ;
@[ checks ]
def flippedAscii : Path(Circle, Base, Base) = back(loop) :: Path.here(Base) ;
