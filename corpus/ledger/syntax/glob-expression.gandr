/// `glob_expression`: a globular structure: its cells and its homs.
/// The checker does not reach this form yet: no type `Glob` is declared for
/// it to answer, so the signature is refused first.
///
/// - owes: #1207
@[refuses("UnresolvedTypeHead")]
def path_glob(A : Type) -> Glob =
  glob {
    cells = A;
    hom (x, y) = path_glob (Path x y);
  }
