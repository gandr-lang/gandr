/// `index_expression`: the place a method's body answers, its receiver at an index.

// The native finite lists.
import std.list (List);

/// A list's element at an index, as a method's place.
module Places where {
  @[ checks ]
  def nth[m : Mode](self : m List(Integer), i : Integer) -> -F View[m](Integer) { self.#[i] }
}
