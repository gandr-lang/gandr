@![features(("call-by-push-value", "data-parameters", "equivalence-record", "let-statements", "records"))]

/// `isomorphism_type`: an isomorphism type, written with its glyph and as the
/// call of `Iso`.
def turned(i : Integer ≅ Integer) -> Unit =
  pure *{}
def turnedAscii(i : Iso Integer Integer) -> Unit =
  pure *{}
