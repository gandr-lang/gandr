/// `cons_pattern`: a path cons pattern: a step and the rest of the path,
/// written with its glyph and in ASCII.
data Circle : Type where
  | Base : Circle
  | loop : Base <-> Base
data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) <=> x;
  rule : P (S x) <=> x;
}
def rec wind(p : Path Base Base) -> Int =
  match p where
    | here => Z
    | loop ∷ q => S (wind[<] q)
    | back(loop) ∷ q => P (wind[<] q)
def rec windAscii(p : Path Base Base) -> Int =
  match p where
    | here => Z
    | loop :: q => S (windAscii[<] q)
    | back(loop) :: q => P (windAscii[<] q)
