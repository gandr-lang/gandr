/// `bare_record_field`: the retired field of a record literal written with
/// no dot, `*{ l = e }`. A field of a literal supplies a name, so it writes
/// the dot, `*{ .l = e }`. The lowering refuses the undotted field, and the
/// refusal names it.
///
/// A record type binds its labels, and it keeps them bare, `*{ l : T }`.
type Config = *{host : String, port : Integer};
@[refuses("RetiredSpelling.bare_record_field")]
def local : Config = *{host = "localhost", port = 443};
