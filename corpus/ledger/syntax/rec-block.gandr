/// `rec_block`: a recursive group: definitions that may name each other.
data Nat : Type where
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
rec {
  @[checks]
  def rec even(n : Nat) -> Integer =
    match n where
      | Zero => 1
      | Succ(p) => odd[<] p
  @[checks]
  def rec odd(n : Nat) -> Integer =
    match n where
      | Zero => 0
      | Succ(p) => even[<] p
}
