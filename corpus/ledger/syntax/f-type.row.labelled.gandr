/// `f_type.row.labelled`: a computation type with the capabilities it uses,
/// an interface whole and an instance by its label, open through a row
/// variable after the bar.

// The console's host interface.
import std.io;

/// A computation that returns at once under a row open after the bar.
@[ checks ]
def idle[r : Row]() -> -F [Partial, d : std.io.Console.Eff | r] Unit {
  pure unit
}
