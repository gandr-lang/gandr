@![features((
  "data-parameters",
  "dependent-functions",
  "modules",
  "nominal-data",
  "products-and-sums",
  "records",
  "signatures-as-values",
  "universes"
))]

/// `type_path`: a type named through a module, applied when it is a family,
/// or a call of a function the module declares. A path also names a term
/// where an operand of a type reads it, as `Two.word` names an operation of
/// the theory `Two`.
theory Two where
  /// A width.
  sort Width : Type
  /// The width of a word.
  oper word : Width

/// A piece that its width indexes.
data Fragment : Terms Two -> Type where {
  /// The piece of width `w`.
  | Piece : (w : Terms Two) --> Fragment w
}

module Counter where
  type Pair(a : Type) = a * a
  def same(a : Type) -> Type = a
def twin(p : Fragment Two.word) -> Counter.same (Counter.Pair Integer) = *{1, 2};
