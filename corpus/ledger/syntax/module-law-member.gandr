/// `module_law_member`: a module body admitting its model's law at a host primitive.
theory Reflexive where {
  sort Carrier : Type;
  oper alike : (a : Carrier, b : Carrier) --> Bool;
  law refl : (a : Carrier) => Path(Bool, alike(a, a), true);
}

/// The host's integers, decided by the host's equality, its reflexivity
/// admitted.
module ReflexiveInteger : Model(Reflexive) with sort Carrier = Integer where {
  def alike(a : Integer, b : Integer) -> Bool { int.eq(a, b) }
  law refl admitted;
}
