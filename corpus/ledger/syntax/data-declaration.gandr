/// `data_declaration`: a datatype: its family head and one generator per constructor, a field at the unrestricted grade written with its glyph and in ASCII.
@[ checks ]
data Box : Type {
  Wrap : (ω n : Integer) --> Box;
}
@[ checks ]
data BoxAscii : Type {
  WrapAscii : (inf n : Integer) --> BoxAscii;
}
