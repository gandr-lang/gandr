/// `data_declaration`: a datatype: its family head, `where`, and one member per
/// constructor opened by a bar, a field at the unrestricted grade written with
/// its glyph and in ASCII.
data Box : Type where
  | Wrap : (n[ω] : Integer) --> Box
data BoxAscii : Type where
  | WrapAscii : (n[inf] : Integer) --> BoxAscii
