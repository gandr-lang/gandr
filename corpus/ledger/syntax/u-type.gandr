@![features(("call-by-push-value", "let-statements", "records", "thunks-and-force"))]

/// `u_type`: a thunk type at the unrestricted grade, written with its glyph
/// and in ASCII.
@[checks]
def later(k : +U[ω] (-F Integer)) -> -F Unit =
  pure *{}
@[checks]
def laterAscii(k : +U[inf] (-F Integer)) -> -F Unit =
  pure *{}
