/// `attributed_module_member`: an attributed definition inside a module body,
/// its linear tail written with its glyph and in ASCII.
module Kept where {
  @[doc("The parameter, taken once.")] def kept(x : Integer) ⊸ Integer = x;
}
module KeptAscii where {
  @[doc("The parameter, taken once.")] def keptAscii(x : Integer) -o Integer = x;
}
