/// `boundary`: names the row each member of an `extern "rust"` block is admitted against.
data Scalar : Type {
  U32 : Scalar;
}
data Code : Type {
  Plain : (s : Scalar) --> Code;
}
data Coded : Type {
  NoCoded : Coded;
  Coded : (name : String, c : Code, rest : Coded) --> Coded;
}
data Signature : Type {
  Signature : (params : Coded, result : Code) --> Signature;
}
data Signatures : Type {
  NoSignature : Signatures;
  Member : (s : Signature, rest : Signatures) --> Signatures;
}
data Row : Type {
  Row : (result : Code) --> Row;
}
data Rows : Type {
  NoRow : Rows;
  Named : (r : Row, rest : Rows) --> Rows;
}
data Admission : Type {
  Admitted : Admission;
}
def admitBlock(ss : Signatures, rs : Rows) -> Admission {
  Admitted
}
def addRow : Row = Row(Plain(U32));
@[ boundary(addRow) ]
@[ checks ]
extern "rust" from "adder" as Adder {
  def add(x : u32) -> u32;
}
