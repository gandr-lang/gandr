// This source uses named session types as endpoint parameters.
//
// A program names its protocol once.
// Each endpoint uses that name.
// A top-level type can name the protocol.
// A module manifest component can name the protocol.
// An alias can name either type.
//
// The lowering resolves each name to its definition's type.
// The lowering places a parameter when that type is a session type.
//
// - see: #4703

/// A module that names the desk's protocol as a manifest component.
module Desk where
  /// The desk's side: it receives one number and closes.
  type Ask = ?Integer. end;

/// The seat's side of a one-number report, named at the top level.
type Tell = !Integer. end;
/// `Report` names the seat's side as `Tell` does.
type Report = Tell;

/// A desk that hears one number on the endpoint a module's protocol names.
def hearsOne(operator : Desk.Ask) -> Integer =
  let heard = recv operator
  close operator
  pure heard

/// A seat that tells one number on the endpoint a name for a name types.
def tellsOne(seat : Report) -> Unit =
  send seat 2
  close seat

/// A fork at the module's protocol, whose child hears one number.
@[ runs("*{}") ]
def forkedAtModule() -> Unit =
  let seat = fork (operator : Desk.Ask) { let heard = hearsOne operator; pure *{} };
  send seat 1
  close seat

/// A fork at the top-level protocol, whose child tells its parent one number.
@[ runs("2") ]
def forkedAtName() -> Integer =
  let desk = fork (seat : Tell) { tellsOne seat };
  let heard = recv desk
  close desk
  pure heard
