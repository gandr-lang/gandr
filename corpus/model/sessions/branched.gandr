// A case runs one of its arms, so each arm acts on an endpoint from where the
// case found it.
//
// An offer's arms already act on an endpoint this way. A case is the same
// choice, made by a value instead of by the peer.
//
// Every arm leaves each endpoint as the first arm leaves it. The endpoint then
// stands at one state after the case, whichever arm ran.
//
// - see: #4707

/// Each branch of an `if` closes the seat the caller hands it.
def closing(seat : end, early : Bool) -> Unit =
  if early { close(seat) } else { close(seat) }

/// Each arm of a match sends its own number, and the close after the match
/// acts on the seat as both arms leave it.
def reportsByMatch(seat : !Integer. end, early : Bool) -> Unit =
  match early
    | true => send(seat, 1)
    | false => send(seat, 2)
  close(seat)

/// A seat that reports until it has nothing more to say. The test of a
/// `while` is a case, and what follows the loop runs in its false branch.
def draining(seat : mu open. +{more : !Integer. open, done : end}, more : Bool) -> Unit =
  while more {
    select(seat, more);
    send(seat, 1)
  };
  select(seat, done)
  close(seat)

/// A desk that hears one report from a seat closing on its late branch.
@[ runs("2") ]
def hearsOneReport() -> Integer =
  let seat = fork (desk : end) { closing desk false };
  close(seat)
  let desk = fork (report : !Integer. end) { reportsByMatch report false };
  let heard = recv(desk)
  close(desk)
  pure heard

/// A desk that hears a seat's reports until the seat selects `done`.
def hearing(desk : mu open. &{more : ?Integer. open, done : end}) -> Unit =
  loop {
    offer(desk) {
      | more => { let heard = recv(desk); continue }
      | done => { close(desk); break }
    }
  }

/// A desk that follows a seat which has nothing more to report.
@[ runs("*{}") ]
def drained() -> Unit =
  let desk = fork (seat : mu open. +{more : !Integer. open, done : end}) {
    draining seat false
  };
  hearing desk
