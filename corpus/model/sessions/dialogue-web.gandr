//! This source records a dialogue between a seat and its operator.
//!
//! The recorder orders moves from both endpoints.
//! The seat uses the left endpoint.
//! The operator uses the right endpoint.
//! The causal web gives the dialogue's logical time.
//! Each endpoint preserves its move order.
//!
//! Each send precedes its receipt.
//! Two logs can commute independent moves.
//! These logs describe one dialogue.
//! `decompose` returns the web's modular decomposition as data.
//!
//! - cites: [Mazurkiewicz-1987-trace_theory]
//! - cites: [Gallai-1967-transitiv_orientierbare_graphen]
//!
//! [Mazurkiewicz-1987-trace_theory]: https://doi.org/10.1007/3-540-17906-2_30 "Mazurkiewicz, Trace Theory"
//! [Gallai-1967-transitiv_orientierbare_graphen]: https://doi.org/10.1007/BF02020961 "Gallai, Transitiv orientierbare Graphen"

// The native session formers.
import std.session (Dialogue);

// The seat's protocol and its messages.
import "./seat-base.gandr";
// The modular decomposition of a dialogue's web.
import std.buffer (Web);

/// `retiring` records a report and a retirement.
/// Its web is series-parallel.
@[ decomposes(
  series
    (event right 0)
    (event left 0)
    (event left 1)
    (parallel (event left 2) (event right 1))
    (event right 2)
    (event right 3)
    (parallel (series (event left 3) (event left 4)) (event right 4))
) ]
pub def retiring : Dialogue Seat.SeatEnd = dialogue
  (right (sent Seat.task))
  (left (received Seat.task))
  (left (selected report))
  (left (sent Seat.progress))
  (right (offered report))
  (right (received Seat.progress))
  (right (selected retire))
  (left (offered retire))
  (left closed)
  (right closed);

/// `retiringLater` records the same dialogue with the offer before the report.
/// Its web has no prime node.
@[ decomposes(primes = 0) ]
def retiringLater : Dialogue Seat.SeatEnd = dialogue
  (right (sent Seat.task))
  (left (received Seat.task))
  (left (selected report))
  (right (offered report))
  (left (sent Seat.progress))
  (right (received Seat.progress))
  (right (selected retire))
  (left (offered retire))
  (right closed)
  (left closed);

/// `commuted` proves that both logs share their moves and receipts.
/// Reflexivity proves the path.
def commuted : Path[.A = Dialogue Seat.SeatEnd](retiring, retiringLater) = Path.here retiring;

/// `sameWeb` proves that both logs decompose to one web.
/// `decompose` reads each dialogue.
def sameWeb : Path[.A = Web](
  decompose retiring,
  decompose retiringLater
) = Path.here (decompose retiring);

/// `handedOff` records a handoff with a prime web node.
/// `N` forms a factor with the operator's receipt and close.
@[ decomposes(
  series
    (event right 0)
    (event left 0)
    (event left 1)
    (prime (event left 2) (event left 3) (event right 1) (series (event right 2) (event right 3)))
) ]
pub def handedOff : Dialogue Seat.SeatEnd = dialogue
  (right (sent Seat.task))
  (left (received Seat.task))
  (left (selected handoff))
  (left (sent Seat.notes))
  (left closed)
  (right (offered handoff))
  (right (received Seat.notes))
  (right closed);
