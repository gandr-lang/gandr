// This source drops endpoints at `end`.
//
// `drop c` executes `close c`.
// The checker admits `drop` after an endpoint's protocol ends.
//
// The checker closes the endpoint when it processes `drop`.
//
// - see: #1054

/// `finished` selects `done` and drops both endpoints.
/// The selection precedes the drops.
@[
  runs("*{}"),
  traces(decomposes
    seat
    (series (event left 0) (parallel (event left 1) (series (event right 0) (event right 1)))))
]
def finished() -> Unit =
  let desk = fork (seat : +{done : end}) { select seat done; drop seat };
  offer desk { | done => drop desk }

/// `mixed` closes one fork endpoint and drops the other.
/// Each action ends its endpoint.
@[runs("*{}"), traces(decomposes seat (parallel (event left 0) (event right 0)))]
def mixed() -> Unit =
  let desk = fork (seat : end) { close seat };
  drop desk
