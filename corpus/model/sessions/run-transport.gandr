// A recorded run carried along a path between its protocol's payload types:
// each payload the protocol reads at the path moves by the path's forward
// map, every move and every other payload kept. A run is a finite trace, so
// it is covariant in every payload type, sent or received. The machine runs
// the transport as a match on the run's moves, to the run conversion gives.

/// A bit.
pub data Bit : Type where {
  | Zero : Bit
  | One : Bit
}

/// An answer.
pub data Answer : Type where {
  | No : Answer
  | Yes : Answer
}

/// A bit read as an answer.
def decode(b : Bit) -> Answer {
  match b {
    Zero => No,
    One => Yes,
  }
}

/// An answer written as a bit.
def encode(a : Answer) -> Bit {
  match a {
    No => Zero,
    Yes => One,
  }
}

/// Encoding a decoded bit gives the bit back.
def encoded(b : Bit) -> Path(Bit, encode(decode(b)), b) {
  match b {
    Zero => Path.here(Zero),
    One => Path.here(One),
  }
}

/// Decoding an encoded answer gives the answer back.
def decoded(a : Answer) -> Path(Answer, decode(encode(a)), a) {
  match a {
    No => Path.here(No),
    Yes => Path.here(Yes),
  }
}

/// The bits and the answers are one type, by univalence.
pub def codes : Path(Type, Bit, Answer) = ua((decode, ((encode, encoded), (encode, decoded))));

/// A protocol that hears a bit, and one that hears an answer.
module Ask where {
  type Coded = ?Bit. end;
  type Decoded = ?Answer. end;
}

/// A run that heard a one.
def heard : Run(Ask.Coded) = recorded(received(One), closed);

/// Carried along the path, the run heard the one decoded: a yes.
def heardDecoded : Path(
  Run(Ask.Decoded),
  Path.walk(fun (X) { Run(type(?X. end)) }, codes, heard),
  recorded(received(Yes), closed)
) = Path.here(recorded(received(Yes), closed));

/// The payload moves: the carried run is no run that heard a no.
@[ refuses("EndpointMismatch") ]
def heardKept : Path(
  Run(Ask.Decoded),
  Path.walk(fun (X) { Run(type(?X. end)) }, codes, heard),
  recorded(received(No), closed)
) = Path.here(recorded(received(No), closed));

/// The carried run, computed.
def heardRun() -> Run(Ask.Decoded) {
  Path.walk(fun (X) { Run(type(?X. end)) }, codes, heard)
}

/// On the machine the carried run hears the yes, as it does by conversion.
@[ runs("recorded(received(Yes), closed)") ]
def decodedRun() -> Run(Ask.Decoded) { heardRun() }
