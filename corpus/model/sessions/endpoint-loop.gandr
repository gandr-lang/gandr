// A loop drives an endpoint through a recursive protocol, one pass per turn
// of the protocol.
//
// A loop's passes are the passes of one fixpoint, and an endpoint bound
// outside it would be captured by every pass. The loop threads the endpoint
// instead, as it threads a held slot.
//
// The lowering hands the endpoint to the loop's first pass and places it again
// in each pass. The first pass takes it at the state the loop starts in, the
// loop head's state, and `continue` hands it on at that state again. A loop
// whose every pass acts on its endpoint before it runs again follows its
// protocol, so it owes no `Partial`.
//
// - see: #4502
// - see: #4705

/// A desk following a seat's reports until it retires: each report is one
/// pass, and the retirement closes the endpoint and leaves the loop.
def follow(operator : mu open. &{
  report : ?Integer. open,
  retire : ?Integer. end
}) -> Unit {
  loop {
    offer(operator) {
      report => { let next = recv(operator); continue },
      retire => { let last = recv(operator); close(operator); break }
    }
  }
}

/// A desk counting a seat's reports in a held slot until it retires: the loop
/// threads the count beside the endpoint.
def tally(operator : mu open. &{
  report : ?Integer. open,
  retire : ?Integer. end
}) -> Integer {
  var seen = 0;
  loop {
    offer(operator) {
      report => { let next = recv(operator); access seen as v { resume(v, v + 1) }; continue },
      retire => { let last = recv(operator); close(operator); break }
    }
  };
  pure seen
}

/// A seat that reports twice and retires, followed by a forked desk.
@[ runs("unit") ]
def followed() -> Unit {
  let seat = fork (operator : mu open. &{
    report : ?Integer. open,
    retire : ?Integer. end
  }) { follow(operator) };
  select(seat, report);
  send(seat, 1);
  select(seat, report);
  send(seat, 2);
  select(seat, retire);
  send(seat, 3);
  close(seat)
}
