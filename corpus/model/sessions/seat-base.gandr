// The sessions subject's shared declarations, written once and imported by
// every source that reads them (`import "./seat-base.gandr";`): a seat's
// protocol as a recursive session type (Honda, Vasconcelos and Kubo,
// _Language Primitives and Type Discipline for Structured
// Communication-Based Programming_, doi:10.1007/BFb0053567) — a dispatch
// received, then reports and the choice to continue or retire, or a handoff
// that ends it — and the messages a seat exchanges.

/// A seat: its message types sealed behind the interface, the protocol it
/// serves, and one message of each type. A report is marked `mobile`: its
/// representation may cross from the seat's world back to the one that
/// dispatched it (`../worlds/seat-and-operator.gandr`).
pub module Seat :> #{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = ?Dispatch. mu turn. +{
    report : !Report. &{next : turn, retire : end},
    handoff : !Handoff. end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} {
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  def task = "task";
  /// A report it sends.
  def progress = "progress";
  /// The notes it hands off.
  def notes = "notes";
}
