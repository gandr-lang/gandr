//! This source defines common declarations for session sources.
//!
//! `Seat` defines a recursive session protocol.
//! The protocol receives a dispatch.
//! The seat can report.
//! The seat can continue.
//! The seat can retire.
//!
//! The seat can send a handoff.
//! The handoff ends the protocol.
//! `Seat` defines the messages that its protocol exchanges.
//! Every session source imports these declarations.
//! The checker verifies the protocol and its message types.
//!
//! - see: `../worlds/seat-and-operator.gandr` — `Report` crosses worlds
//! - cites: [Honda-1998-language_primitives_type_discipline_structured_communicationbased_programming]
//!
//! [Honda-1998-language_primitives_type_discipline_structured_communicationbased_programming]: https://doi.org/10.1007/BFb0053567 "Honda, Vasconcelos and Kubo, Language Primitives and Type Discipline for Structured Communication-Based Programming"

/// `Seat` seals its message types behind an interface.
/// `Seat` defines its protocol, its messages, and a mobile report.
pub module Seat :> *{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = ?Dispatch. mu turn. +{
    report : !Report. &{next : turn, retire : end},
    handoff : !Handoff. end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} where
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  def task = "task";
  /// A report it sends.
  def progress = "progress";
  /// The seat sends these handoff notes.
  def notes = "notes";
