//! The prefixes of a seat's protocol: the record of the moves a seat has made
//! so far, admitted while its run is still open, as a monitor checks a session
//! one message at a time
//! [Bocchi-2017-monitoring_networks_through_multiparty_session_types].
//! `Prefix(S)` holds every record the protocol accepts so far, complete or not;
//! `Run(S)` holds only the complete ones (`./seat-evolution.gandr`).
//!
//! - see: #1861 — `reporting`
//! - cites: [Bocchi-2017-monitoring_networks_through_multiparty_session_types]
//!
//! [Bocchi-2017-monitoring_networks_through_multiparty_session_types]: https://doi.org/10.1016/j.tcs.2017.02.009 "Bocchi, Chen, Demangeon, Honda and Yoshida, Monitoring Networks through Multiparty Session Types"

// The native session formers.
import std.session (Prefix);

// The seat's protocol and its messages.
import "./seat-base.gandr";

/// The seat before its first move: the empty record is a prefix.
def unstarted : Prefix(Seat.SeatEnd) = recorded ();

/// A seat that took its task and reported, its next move the offer to go on
/// or retire: open, so a prefix.
pub def reporting : Prefix(Seat.SeatEnd) = recorded
  (received Seat.task)
  (selected report)
  (sent Seat.progress);

/// On the machine the prefix reads back as the moves it records.
@[ runs("recorded(received(\"task\"), selected(report), sent(\"progress\"))") ]
def shown() -> Prefix(Seat.SeatEnd) { reporting }

/// A run the seat completed is a prefix too.
def retired : Prefix(Seat.SeatEnd) = recorded
  (received Seat.task)
  (selected report)
  (sent Seat.progress)
  (offered retire)
  closed;

/// A seat that reports forever has no complete run, and every record of it
/// is a prefix: two reports so far.
def reportedTwice : Prefix(mu more. !(Seat.Report). more) = recorded
  (sent Seat.progress)
  (sent Seat.progress);
