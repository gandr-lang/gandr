// A function's parameter at a session type is an endpoint its body drives to
// its end.
//
// A session action acts only on a linear binder, and a parameter binds in the
// intuitionistic zone. The placement moves the parameter into one linear
// binder of its name, which shadows it.
//
// The lowering wraps the body in the placement. The checker opens the
// parameter as an endpoint at its session type, and the readmission erases
// the placement to its body. A call spends the caller's endpoint whole, as a
// send delegates one, and the callee holds it from then on.
//
// - see: #1862
// - see: #4501
// - see: #4687 — not implemented: running a placed endpoint

/// A parameter at `end` that its body closes.
def finish(seat : end) -> Unit {
  close(seat)
}

/// A parameter that receives a number, then closes, and answers the number.
def answer(seat : ?Integer. end) -> Integer {
  let count = recv(seat);
  close(seat);
  count
}

/// An intuitionistic parameter beside a parameter at a session type: the
/// placement counts apart from the parameters before it.
def report(note : String, seat : !String. end) -> Unit {
  send(seat, note);
  close(seat)
}

/// A fork's child that hands its end to `finish`, which closes it.
def handed() -> Unit {
  let desk = fork (seat : end) { finish(seat) };
  close(desk)
}
