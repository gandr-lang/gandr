//! This source exchanges a seat protocol run between two endpoints.
//!
//! `fork` opens a channel at the seat's session type.
//! The forked side serves that endpoint.
//! The desk drives the dual protocol.
//! The desk handles every branch that the seat can take.
//!
//! The checker verifies each endpoint against its session type.
//!
//! - cites: [Honda-1998-language_primitives_type_discipline_structured_communicationbased_programming]
//!
//! [Honda-1998-language_primitives_type_discipline_structured_communicationbased_programming]: https://doi.org/10.1007/BFb0053567 "Honda, Vasconcelos and Kubo, Language Primitives and Type Discipline for Structured Communication-Based Programming"

// The seat's protocol and its messages.
import "./seat-base.gandr";

/// `exchange` runs a desk that sends a task to a forked seat.
/// Five final moves form a prime node.
@[
  runs("*{}"),
  traces(decomposes
    seat
    (series
      (event right 0)
      (event left 0)
      (event left 1)
      (parallel (event left 2) (event right 1))
      (event right 2)
      (event right 3)
      (event left 3)
      (event left 4)
      (prime
        (event left 5)
        (event left 6)
        (event right 4)
        (series (event right 5) (event right 6)))))
]
def exchange() -> Unit =
  let desk = fork (seat : Seat.SeatEnd) {
    let task = recv seat;
    select seat report;
    send seat Seat.progress;
    offer seat {
      | next => { select seat handoff; send seat Seat.notes; close seat }
      | retire => close seat
    }
  };
  send desk Seat.task
  offer desk {
    | report => {
      let first = recv desk;
      select desk next;
      offer desk {
        | report => { let second = recv desk; select desk retire; close desk }
        | handoff => { let notes = recv desk; close desk }
      }
    }
    | handoff => { let notes = recv desk; close desk }
  }
