//! This source proves protocol equivalence with payload paths.
//!
//! Two protocols can encode messages differently.
//! Each unequal payload pair needs a path.
//! The session certificate carries each path to the kernel.
//! Bisimilarity follows the payload equivalence.
//! Gay and Hole relate payloads by type equality.
//!
//! A path generalises equality to an equivalence.
//! `Path.bisim` checks one path for each unequal payload pair.
//!
//! - cites: [Gay-2005-subtyping_session_types_pi_calculus]
//!
//! [Gay-2005-subtyping_session_types_pi_calculus]: https://doi.org/10.1007/s00236-005-0177-z "Gay and Hole, Subtyping for Session Types in the Pi Calculus"

/// A verdict of three cases nested to the right, renested to the left.
def toLeft(c : Unit + (Unit + Unit)) -> (Unit + Unit) + Unit =
  match c where
    | +{.0 = u} => +{.0 = +{.0 = u}}
    | +{.1 = +{.0 = u}} => +{.0 = +{.1 = u}}
    | +{.1 = +{.1 = u}} => +{.1 = u}

/// A verdict of three cases nested to the left, renested to the right.
def toRight(c : (Unit + Unit) + Unit) -> Unit + (Unit + Unit) =
  match c where
    | +{.0 = +{.0 = u}} => +{.0 = u}
    | +{.0 = +{.1 = u}} => +{.1 = +{.0 = u}}
    | +{.1 = u} => +{.1 = +{.1 = u}}

/// The two nestings are one type, the two maps inverse by computation.
def nestings : Path[.A = Type](Unit + (Unit + Unit), (Unit + Unit) + Unit) = equiv toLeft toRight;

/// `Judge` defines protocols with one or two verdicts.
/// It writes each protocol with either verdict nesting.
module Judge where
  type Right = ?(Unit + (Unit + Unit)). !Unit. end;
  type Left = ?((Unit + Unit) + Unit). !Unit. end;
  type RightTwice = ?(Unit + (Unit + Unit)). ?(Unit + (Unit + Unit)). end;
  type LeftTwice = ?((Unit + Unit) + Unit). ?((Unit + Unit) + Unit). end;

/// `renested` proves that the `Judge` protocols have one type.
/// `nestings` converts their verdict payloads.
def renested : Path[.A = Type](
  Judge.Right,
  Judge.Left
) = Path.bisim Judge.Right Judge.Left nestings;

/// `renestedTwice` proves equivalence for two verdict payload pairs.
/// It uses the two paths in protocol order.
def renestedTwice : Path[.A = Type](
  Judge.RightTwice,
  Judge.LeftTwice
) = Path.bisim Judge.RightTwice Judge.LeftTwice (*{nestings, nestings});
