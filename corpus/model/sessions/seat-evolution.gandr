// A seat's protocol evolved: session subtyping as a flow and equi-recursive
// unfolding as a path (Gay and Hole, _Subtyping for Session Types in the Pi
// Calculus_, doi:10.1007/s00236-005-0177-z). A protocol that adds a choice
// the seat may take is a supertype, so a recorded run of the old protocol
// rides forward to the new one; a run that takes the new choice is no run of
// the old.

// The seat's protocol and its messages.
import "./seat-base.gandr";

/// The seat's protocol, the protocol with a pause added, and the protocol
/// unrolled once, related by simulation and bisimulation.
pub module Evolution {
  type Dispatch = Seat.Dispatch;
  type Report = Seat.Report;
  type Handoff = Seat.Handoff;
  type SeatEnd = Seat.SeatEnd;
  type SeatEnd′ = ?Dispatch. mu turn. +{
    report : !Report. &{next : turn, retire : end},
    handoff : !Handoff. end,
    pause : !Report. turn
  };
  type SeatEnd2 = ?Dispatch. +{
    report : !Report. &{
      next : mu again. +{
        report : !Report. &{next : again, retire : end},
        handoff : !Handoff. end
      },
      retire : end
    },
    handoff : !Handoff. end
  };
  /// The old protocol flows to the one with the pause, by simulation.
  @[ checks ]
  def sub : Flow(Type, SeatEnd, SeatEnd′) = sim(SeatEnd, SeatEnd′);
  /// The protocol and its one-step unrolling are one type, by bisimulation.
  @[ checks ]
  def eq : Path(Type, SeatEnd, SeatEnd2) = bisim(SeatEnd, SeatEnd2);
  /// The stationary flow at the old protocol.
  @[ checks ]
  def kept : Flow(Type, SeatEnd, SeatEnd) = stay(SeatEnd);
  /// The stationary flow, then the simulation.
  @[ checks ]
  def widened() -> Flow(Type, SeatEnd, SeatEnd′) {
    kept then sub
  }
}

/// A recorded run of the old protocol: a task received, one report, retired.
def served : Run(Seat.SeatEnd) = recorded(
  received(Seat.task),
  selected(report),
  sent(Seat.progress),
  offered(retire),
  closed
);

/// A recorded run ridden forward along the simulation.
def forward(receipt : Run(Seat.SeatEnd)) -> Run(Evolution.SeatEnd′) {
  ride(\X. Run(X), Evolution.sub, receipt)
}

/// The old run ridden forward by a run: the record is unchanged.
@[ runs("recorded(received(\"task\"), selected(report), sent(\"progress\"), offered(retire), closed)") ]
def moved() -> Run(Evolution.SeatEnd′) { become forward(served) }

/// A run of the new protocol that takes the pause.
def paused : Run(Evolution.SeatEnd′) = recorded(
  received(Seat.task),
  selected(pause),
  sent(Seat.progress),
  selected(handoff),
  sent(Seat.notes),
  closed
);

/// The same record is no run of the old protocol, which has no pause.
@[ refuses("RunNotAdmitted") ]
def backward : Run(Seat.SeatEnd) = recorded(
  received(Seat.task),
  selected(pause),
  sent(Seat.progress),
  selected(handoff),
  sent(Seat.notes),
  closed
);
