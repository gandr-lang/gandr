// The wildcard: `_` written where a value is read stands for the term the
// equations force (#528). The elaborator answers it, not the author: the
// solver binds it only where a comparison forces a most general solution,
// the checker writes that solution in its place, and the kernel readmits the
// declaration as if the term were written by hand. A wildcard in an
// ascription's type is forced by the term it ascribes. A hole `?h` is the
// author's to fill. What refuses is in
// `../../pathological/holes/wildcard.gandr`.

/// The identity at a type passed explicitly.
pub def idAt(a : Type, y : a) -> a { y }

/// `idAt` with its type left to the argument: `3` forces `_` to `Integer`.
@[ runs("3") ]
def forced() -> Integer { idAt(_, 3) }

/// The first of two values, each of its own type, both types passed
/// explicitly.
def firstAt(a : Type, b : Type, x : a, y : b) -> a { x }

/// Both types left to the arguments, each forced by its own.
@[ runs("5") ]
def bothForced() -> Integer { become firstAt(_, _, 5, unit) }

/// The identity at a type supplied by name.
def same @[a : Type] (y : a) -> a { y }

/// The implicit supplied by name as a wildcard: the slot asks the solver for
/// what an omitted implicit would leave it.
@[ runs("3") ]
def slotForced() -> Integer { same[a = _](3) }

/// A path's right end left in an ascription's type: checking `here(3)`
/// against it forces the end to `3`, and the path runs as its two maps, both
/// the identity (#1979).
@[ runs("(thunk { fn (a) { a } }, thunk { fn (a) { a } })") ]
def endForced() -> Path(Integer, 3, 3) { (here(3) : Path(Integer, 3, _)) }

/// A definition its annotation signs, the path's right end left open: no
/// other type meets the annotation's, so `here(3)`'s point alone forces the
/// end (#1979).
def endSigned = (here(3) : Path(Integer, 3, _));

/// A path the caller passes, ascribed a type whose right end is left open:
/// the value bridge meets that end against the path's own and forces it
/// (#1979).
def endMet(q : Path(Integer, 3, 3)) -> Path(Integer, 3, 3) {
  (q : Path(Integer, 3, _))
}
