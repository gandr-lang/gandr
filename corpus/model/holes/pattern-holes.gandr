// A pattern hole stands for an arm not yet written, at the top of a match or
// inside a constructor's payload. A hole leaves which arm runs undecided, so
// the checker refuses the match by name until coverage reads holes (#391).
// `pathological/holes/` refuses each shape on its own.

/// Three colours.
@[ checks ]
data Shade : Type {
  Crimson : Shade;
  Olive : Shade;
  Navy : Shade;
}

/// A hole between two arms (#391).
@[ refuses("UndecidedCoverage") ]
def rank(c : Shade) -> -F Integer {
  case c {
    Crimson => 0,
    ? => 1,
    Navy => 2
  }
}

/// An integer, or none.
@[ checks ]
data Option : Type {
  NoValue : Option;
  Value : (x : Integer) --> Option;
}

/// A hole inside a payload (#391).
@[ refuses("UndecidedCoverage") ]
def weigh(m : Option) -> -F Integer {
  case m {
    Value(?) => 100,
    NoValue => 200
  }
}

/// The run target weighs nothing: it checks against `weigh`'s signature,
/// whose body the hole above leaves refused, so it is not run.
@[ checks ]
weigh(NoValue)
