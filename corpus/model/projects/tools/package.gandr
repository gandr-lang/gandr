// #2687: a workspace's second member, its `package.gandr` alone at its root,
// its version read from the workspace it sits in.
import "../workspace.gandr";

/// What this package reads of `hello`: its greeting, a string.
pub theory Greeting where {
  /// The greeting `hello` exports.
  oper welcome : String;
}

// The sibling package this one depends on, found at its coordinate and read
// through `gandr.lock` (#3072, #4527), at the signature above: its `welcome`
// and no other member (#3098).
import "path:../hello" as hello : Greeting;
// The manifest theories.
import std.build (Gandr);

/// The package: its name, the version its workspace states, and the rest of
/// what `gandr.toml` records.
pub module Package : Model(Gandr.Package) where {
  /// The name the manifest records.
  def name = "tools";
  /// The version, the workspace's.
  def version = Workspace.version;
  /// The package's authors.
  def authors = "The gandr authors";
  /// The licence, an SPDX expression.
  def licence = "MIT OR Apache-2.0";
  /// The address the package's documentation stands at.
  def documentation = "https://github.com/gandr-lang/gandr";
  /// The address a resolver may fetch the package from.
  def endpoint = "https://github.com/gandr-lang/gandr";
  /// The language version, the workspace's.
  def gandr = Workspace.gandr;
  /// The features the sources use: the workspace's, the lock that reads its
  /// dependency, and the import at a signature.
  def features = "project-manifest, package-lock, package-signature";
  /// The systems the package builds on, the workspace's.
  def systems = Workspace.systems;
  /// The spelling the package asks an editor to show its sources in, over
  /// the user's own: ASCII.
  def spelling = "ascii";
}

/// hello's greeting, which the alias reads through the lock.
@[ runs("\"hello, world\"") ]
pub def relayed = hello.welcome;
