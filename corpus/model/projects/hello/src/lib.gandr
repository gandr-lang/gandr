// #2687: a package is the sources beside its library, `src/lib.gandr`,
// rooted at the directory above `src`. The library declares the package's
// model, and `gandr check` writes `gandr.toml` at the root from it.

/// The package: its name and its version, as `gandr.toml` records them.
pub module Package : Model(Gandr.Package) {
  def name = "hello";
  def version = "0.1.0";
}
