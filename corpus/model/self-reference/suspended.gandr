//! `suspended` resumes an access that holds a view of a variable.
//!
//! The reified stack retains the view outside its source frame. The checker
//! reports `ViewEscaped` for the `dangling` source.
//! A suspended computation reaches its locals in the window of its frame,
//! never by an address into itself.
//!
//! The source imports the host early exit interface.
//! The handler resumes after `exit`. The source runs to `12`.
//!
//! Rust uses `Pin` from RFC 2349 for a self-borrowing future.
//! C++ keeps such an object immobile by convention.
//! - see: #1183 — `suspended`
import std.process;

/// `suspended` reads a view after its stack resumes.
@[ runs("12") ]
def suspended() -> Integer =
  var x = 5
  let r : Integer = handle c : std.process.Exit.Eff {
    access x as v { c.exit 1; resume v (v + 7) };
    pure 0
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => k *{}
  };
  pure x
