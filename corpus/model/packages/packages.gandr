// An existential package hides its representation type: two counters at
// different types share one package type, and a consumer reads either
// without knowing which. The lowering admits no package type, `pack` or
// `unpack` yet (#1108).

/// Opens a counter and reads its seed through its own reader.
@[ refuses("OutOfFragment.unpack_statement") ]
def consume(p : package [T] +U[ω] (-F #{read : +U[ω] (T -> -F Integer), seed : T})) -> -F Integer {
  unpack m : package [T] +U[ω] (-F #{read : +U[ω] (T -> -F Integer), seed : T}) = p;
  run r <- force m;
  run f <- r.read;
  run s <- r.seed;
  f(s)
}

/// A counter over integers, packed.
@[ refuses("OutOfFragment.package_type") ]
def int_counter : package [T] +U[ω] (-F #{read : +U[ω] (T -> -F Integer), seed : T});
def int_counter = pack [Integer] thunk {
  return #{read = thunk { fn (n : Integer) { return n } }, seed = 7}
};

/// A counter over strings, packed at the same package type.
@[ refuses("OutOfFragment.package_type") ]
def text_counter : package [T] +U[ω] (-F #{read : +U[ω] (T -> -F Integer), seed : T});
def text_counter = pack [String] thunk {
  return #{read = thunk { fn (s : String) { return 42 } }, seed = "seven"}
};

/// Both counters read and summed; `consume`'s type is unknown while it is
/// refused (#1108).
@[ refuses("UnknownConstant") ]
def total() -> Integer {
  run a <- consume(int_counter);
  run b <- consume(text_counter);
  return (a + b)
}

/// A call of `total`: it checks against `total`'s signature, whose body is
/// refused above, so it is not run.
def totalled() -> Integer { total() }
