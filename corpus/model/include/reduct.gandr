//! `reduct` reads an included theory from an extension model.
//!
//! `Monoid.Semigroup` forgets the monoid members outside `Semigroup`. The
//! checker applies this reduct when it requires a semigroup.
//!
//! `endoManifest` restores its carrier before it restricts its members.
//!
//! - see: #1092
//! - see: #2136

// The source imports the included theories and the endomorphism model.
import "./monoid.gandr";

/// `endoMonoid` packs `Endo` at `Monoid`.
pub def endoMonoid : Model(Monoid) = pack Endo at Model(Monoid);

/// `endoSemigroup` packs `Endo` at its included `Semigroup`.
def endoSemigroup : Model(Semigroup) = pack Endo at Model(Semigroup);

/// `restricted` compares the named reduct with the packed semigroup model.
def restricted : Path(
  endoSemigroup,
  Monoid.Semigroup endoMonoid
) = Path.here endoSemigroup;

/// `multiplies` reads the multiplication field of a semigroup model.
pub def multiplies(s : Model(Semigroup)) -> Integer =
  match s where
    | *{.mul = m} => 0

/// `asSemigroup` gives the checker an endomorphism monoid when it requires a semigroup.
@[ runs("0") ]
def asSemigroup() -> Integer { multiplies endoMonoid }

/// `throughTheDiamond` reads either inclusion route to `Semigroup`.
def throughTheDiamond(m : Model(UnitAndZero)) -> Integer =
  multiplies m

/// `endoManifest` writes the endomorphism monoid with its carrier.
pub def endoManifest : Model(Monoid) with sort M = (Integer -> Integer) = *{
  Endo.mul,
  *{Endo.one, *{Endo.assoc, *{Endo.unitL, Endo.unitR}}}
};

/// `manifestAsSemigroup` reads the manifest model as a semigroup.
@[ runs("0") ]
def manifestAsSemigroup() -> Integer { multiplies endoManifest }

/// `manifestDiamond` reads either manifest inclusion route to `Semigroup`.
def manifestDiamond(u : Model(UnitAndZero) with sort M = Unit) -> Integer =
  multiplies u
