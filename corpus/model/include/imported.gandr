// Including an imported theory (#1224): a theory is a named presentation a
// client imports, so `include` names a block of a source its source imports
// unqualified as it names one of its own. The imported monoid is extended by
// a chosen element; a model of the extension gives the monoid's members and
// the element, and runs.

// The semigroup and the monoid.
import "./monoid.gandr" ;

/// A monoid with a chosen element.
@[ checks ]
theory PointedMonoid {
  include Monoid;
  oper point : () --> M;
}

/// The functions on the integers under composition, pointed at the
/// successor.
module Successor : Model(PointedMonoid) {
  type M = Integer => Integer;

  /// `f` then `g`, applied.
  def andThen(
    f : Integer => Integer,
    g : Integer => Integer,
    x : Integer
  ) -> Integer {
    g(f(x))
  }

  /// The identity function.
  def ident(x : Integer) -> Integer { x }

  /// The successor.
  def succ(x : Integer) -> Integer { x + 1 }

  def mul(
    f : Integer => Integer,
    g : Integer => Integer
  ) -> Integer => Integer {
    thunk { andThen(f, g) }
  }

  def one() -> Integer => Integer { ident }

  def point() -> Integer => Integer { succ }

  /// Associativity, included through the monoid.
  @[ checks ]
  def assoc(
    f : Integer => Integer,
    g : Integer => Integer,
    h : Integer => Integer
  ) -> Path(Integer => Integer, mul(mul(f, g), h), mul(f, mul(g, h))) {
    here(thunk { andThen(f, thunk { andThen(g, h) }) })
  }

  /// The left unit law, included.
  @[ checks ]
  def unitL(f : Integer => Integer) -> Path(
    Integer => Integer,
    mul(one(), f),
    f
  ) {
    here(f)
  }

  /// The right unit law, included.
  @[ checks ]
  def unitR(f : Integer => Integer) -> Path(
    Integer => Integer,
    mul(f, one()),
    f
  ) {
    here(f)
  }
}

/// The chosen element, then doubling, at three.
@[ runs("8") ]
def pointed() -> Integer {
  run p <- Successor.point() ;
  run h <- Successor.mul(p, fn (n) { n * 2 }) ;
  h(3)
}
