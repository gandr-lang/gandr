// What a domhringr stage performs besides its session's moves, each effect a
// theory of its operations with its first-order laws. A session's protocol
// stays a session type: the ordered, linear channel is not an effect.
//
// Each theory's documentation states what it commutes with. Every row is a
// set whatever commutes; the commutation table decides which operations the
// fusion pass may reorder. A commutation past an operation that answers a
// value is a law over continuations, each operation taking what runs after
// it and `bind x . …` binding the value it answers; those laws follow the
// effects, one theory per law. An effect commuting with nothing has no law
// to write.
//
// The instance an effect is performed at (a store, a task's journal, a
// sink) is the label a row names it by, not a second theory.

/// The record plane's content-addressed values: a put answers the value's
/// digest, and the digest gets the value back. A put is idempotent, so the
/// store commutes with every effect. One instance.
@[ checks ]
theory Store {
  sort Value : Type;
  sort Digest : Type;
  oper put : (v : Value) --> Digest;
  oper get : (d : Digest) --> Value;
  rule getPut : get(put(v)) ==> v;
}

/// A fold's entries, appended in order: an append answers the entry's
/// index, and the index reads the entry back. Two appends do not commute,
/// so a journal commutes with nothing of its own kind. One instance per
/// task.
@[ checks ]
theory Journal {
  sort Entry : Type;
  sort Index : Type;
  oper append : (e : Entry) --> Index;
  oper read : (i : Index) --> Entry;
  rule readAppend : read(append(e)) ==> e;
}

/// An outside oracle asked a question, answering a readout. No law holds of
/// an outside endpoint: an answer repeats only under a pinned seed and
/// model. A judge commutes with `Store` and `Trace`, not with `Clock`. One
/// instance per endpoint.
@[ checks ]
theory Judge {
  sort Question : Type;
  sort Readout : Type;
  oper ask : (q : Question) --> Readout;
}

/// A read-only lookup of a name's claim, such as a host's address or a
/// tree's identity. Reading twice is reading once, and a witness commutes
/// with every effect but `Clock`. One instance.
@[ checks ]
theory Witness {
  sort Name : Type;
  sort Claim : Type;
  oper lookup : (n : Name) --> Claim;
}

/// The time now, and a token that expires after a duration. `now` does not
/// commute with any operation that takes time, so a clock commutes with
/// nothing. One instance.
@[ checks ]
theory Clock {
  sort Instant : Type;
  sort Duration : Type;
  sort Token : Type;
  oper now : () --> Instant;
  oper deadline : (d : Duration) --> Token;
}

/// A draw from a distribution. No law holds of a draw; an instance under a
/// fixed seed is deterministic, as a `Store` is. A draw commutes with every
/// effect. One instance per seed.
@[ checks ]
theory Random {
  sort Distribution : Type;
  sort Draw : Type;
  oper sample : (d : Distribution) --> Draw;
}

/// A write-only sink of events. An emit commutes with every read, and two
/// emits to one sink do not commute. One instance per sink.
@[ checks ]
theory Trace {
  sort Event : Type;
  oper emit : (e : Event) --> Unit;
}

/// A refused dispatch or a dead seat: a raise answers nothing, its result the
/// empty type `Void`, so nothing after it runs, and under linearity whatever
/// unwinds releases its holds. A raise commutes with nothing. One instance
/// per protocol.
@[ checks ]
theory Fail {
  sort Reason : Type;
  oper raise : (r : Reason) --> Void;
}

/// An asynchronous interruption of the work a token names: the response is
/// decoupled from the call, so an interrupt commutes with nothing. One
/// instance per dispatch.
@[ checks ]
theory Cancel {
  sort Token : Type;
  oper interrupt : (t : Token) --> Unit;
}

/// A put is idempotent: putting a value twice is putting it once.
@[ checks ]
theory StoreIdempotent {
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  rule idem : put(v, bind d . put(v, k)) <=> put(v, k);
}

/// A lookup is read-only: looking a name up twice is looking it up once.
@[ checks ]
theory WitnessIdempotent {
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper lookup : (n : Name, k : pi+ (c : Claim) . C) --> C;
  rule idem : lookup(n, bind c . lookup(n, k)) <=> lookup(n, k);
}

/// The store commutes with every effect, a lookup among them: a put before
/// a lookup is the lookup before the put.
@[ checks ]
theory StoreWitness {
  sort Value : Type+;
  sort Digest : Type+;
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  oper lookup : (n : Name, k : pi+ (c : Claim) . C) --> C;
  rule commute : put(v, bind d . lookup(n, bind c . k(d, c))) <=> lookup(
    n,
    bind c . put(v, bind d . k(d, c))
  );
}

/// An emit commutes with every read, a lookup among them.
@[ checks ]
theory TraceWitness {
  sort Event : Type+;
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper emit : (e : Event, k : C) --> C;
  oper lookup : (n : Name, k : pi+ (c : Claim) . C) --> C;
  rule commute : emit(e, lookup(n, k)) <=> lookup(n, bind c . emit(e, k(c)));
}

/// An emit commutes with a journal's read, though appends do not commute.
@[ checks ]
theory TraceJournal {
  sort Event : Type+;
  sort Index : Type+;
  sort Entry : Type+;
  sort C : Type;
  oper emit : (e : Event, k : C) --> C;
  oper read : (i : Index, k : pi+ (x : Entry) . C) --> C;
  rule commute : emit(e, read(i, k)) <=> read(i, bind x . emit(e, k(x)));
}

/// A judge commutes with the store: asking before a put is asking after it.
@[ checks ]
theory JudgeStore {
  sort Question : Type+;
  sort Readout : Type+;
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper ask : (q : Question, k : pi+ (r : Readout) . C) --> C;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  rule commute : ask(q, bind r . put(v, bind d . k(r, d))) <=> put(
    v,
    bind d . ask(q, bind r . k(r, d))
  );
}

/// A judge commutes with a trace: an emit before the question is an emit
/// after it.
@[ checks ]
theory JudgeTrace {
  sort Question : Type+;
  sort Readout : Type+;
  sort Event : Type+;
  sort C : Type;
  oper ask : (q : Question, k : pi+ (r : Readout) . C) --> C;
  oper emit : (e : Event, k : C) --> C;
  rule commute : emit(e, ask(q, k)) <=> ask(q, bind r . emit(e, k(r)));
}

/// A draw commutes with every effect, an emit among them.
@[ checks ]
theory RandomTrace {
  sort Distribution : Type+;
  sort Draw : Type+;
  sort Event : Type+;
  sort C : Type;
  oper sample : (s : Distribution, k : pi+ (x : Draw) . C) --> C;
  oper emit : (e : Event, k : C) --> C;
  rule commute : emit(e, sample(s, k)) <=> sample(s, bind x . emit(e, k(x)));
}
