// This source defines non-session effects of a domhringr stage.
//
// A row names each effect instance. A session remains a linear channel type.
//
// The commutation rules state which operations fusion may reorder.
// A commutation past an operation that answers a value is a law over
// continuations. An effect that commutes with nothing has no law to write.
//
// - see: `../../pathological/effects/domhringr.gandr` — invalid continuation ports

/// `Store` puts values and gets them by digest.
/// It has one instance and commutes with every effect.
theory Store where
  sort Value : Type;
  sort Digest : Type;
  oper put : (v : Value) --> Digest;
  oper get : (d : Digest) --> Value;
  rule getPut : get (put v) ==> v;

/// `Journal` appends entries and reads them by index.
/// It has one instance for each task, and two appends do not commute.
theory Journal where
  sort Entry : Type;
  sort Index : Type;
  oper append : (e : Entry) --> Index;
  oper read : (i : Index) --> Entry;
  rule readAppend : read (append e) ==> e;

/// `Judge` asks an external endpoint for a readout.
/// It has one instance for each endpoint.
/// Limits: no law holds of an outside endpoint, and an answer repeats only
/// under a pinned seed and model.
theory Judge where
  sort Question : Type;
  sort Readout : Type;
  oper ask : (q : Question) --> Readout;

/// `Witness` retrieves a claim by name.
/// It has one instance and commutes with every effect except `Clock`.
theory Witness where
  sort Name : Type;
  sort Claim : Type;
  oper lookup : (n : Name) --> Claim;

/// `Clock` creates instants and deadline tokens.
/// It has one instance and commutes with nothing, because `now` does not
/// commute with an operation that takes time.
theory Clock where
  sort Instant : Type;
  sort Duration : Type;
  sort Token : Type;
  oper now : () --> Instant;
  oper deadline : (d : Duration) --> Token;

/// `Random` samples a distribution.
/// It has one instance for each seed and commutes with every effect.
/// Limits: no law holds of a draw.
theory Random where
  sort Distribution : Type;
  sort Draw : Type;
  oper sample : (d : Distribution) --> Draw;

/// `Trace` emits events to a sink.
/// It has one instance for each sink, and an emit commutes with every read
/// but not with an emit to the same sink.
theory Trace where
  sort Event : Type;
  oper emit : (e : Event) --> Unit;

/// `Fail` raises a reason and returns `Void`.
/// It has one instance for each protocol, commutes with nothing, and its
/// unwind releases each linear hold.
theory Fail where
  sort Reason : Type;
  oper raise : (r : Reason) --> Void;

/// `Cancel` interrupts the work named by a token.
/// It has one instance for each dispatch and commutes with nothing.
theory Cancel where
  sort Token : Type;
  oper interrupt : (t : Token) --> Unit;

/// `StoreIdempotent` collapses two equal puts.
theory StoreIdempotent where
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest). C) --> C;
  rule idem : put v (bind d. (put v k)) <=> put v k;

/// `WitnessIdempotent` collapses two equal lookups.
theory WitnessIdempotent where
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper lookup : (n : Name, k : pi+ (c : Claim). C) --> C;
  rule idem : lookup n (bind c. (lookup n k)) <=> lookup n k;

/// `StoreWitness` commutes a put and a lookup.
theory StoreWitness where
  sort Value : Type+;
  sort Digest : Type+;
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest). C) --> C;
  oper lookup : (n : Name, k : pi+ (c : Claim). C) --> C;
  rule commute : put v (bind d. (lookup n (bind c. (k d c)))) <=> lookup
    n
    (bind c. (put v (bind d. (k d c))));

/// `TraceWitness` commutes an emit and a lookup.
theory TraceWitness where
  sort Event : Type+;
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper emit : (e : Event, k : C) --> C;
  oper lookup : (n : Name, k : pi+ (c : Claim). C) --> C;
  rule commute : emit e (lookup n k) <=> lookup n (bind c. (emit e (k c)));

/// `TraceJournal` commutes an emit and a journal read.
theory TraceJournal where
  sort Event : Type+;
  sort Index : Type+;
  sort Entry : Type+;
  sort C : Type;
  oper emit : (e : Event, k : C) --> C;
  oper read : (i : Index, k : pi+ (x : Entry). C) --> C;
  rule commute : emit e (read i k) <=> read i (bind x. (emit e (k x)));

/// `JudgeStore` commutes an ask and a put.
theory JudgeStore where
  sort Question : Type+;
  sort Readout : Type+;
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper ask : (q : Question, k : pi+ (r : Readout). C) --> C;
  oper put : (v : Value, k : pi+ (d : Digest). C) --> C;
  rule commute : ask q (bind r. (put v (bind d. (k r d)))) <=> put
    v
    (bind d. (ask q (bind r. (k r d))));

/// `JudgeTrace` commutes an ask and an emit.
theory JudgeTrace where
  sort Question : Type+;
  sort Readout : Type+;
  sort Event : Type+;
  sort C : Type;
  oper ask : (q : Question, k : pi+ (r : Readout). C) --> C;
  oper emit : (e : Event, k : C) --> C;
  rule commute : emit e (ask q k) <=> ask q (bind r. (emit e (k r)));

/// `RandomTrace` commutes a sample and an emit.
theory RandomTrace where
  sort Distribution : Type+;
  sort Draw : Type+;
  sort Event : Type+;
  sort C : Type;
  oper sample : (s : Distribution, k : pi+ (x : Draw). C) --> C;
  oper emit : (e : Event, k : C) --> C;
  rule commute : emit e (sample s k) <=> sample s (bind x. (emit e (k x)));
