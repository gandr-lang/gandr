// Rows as data: two effects in one row, each handler a fold that answers the
// operation at the front of the row and forwards the rest, so handling
// peels the row one effect at a time down to `Void`, where a program is its
// result. The kernel replays every declaration here, so a program's row is
// a claim it re-derives: an operation outside the row is a kernel type
// error.

// `Either`, `StateOp` and `Prog`.
import "./tree.gandr";

/// Exceptions' operation: raise a code.
pub data ExnOp : Type {
  Raise : (code : Integer) --> ExnOp;
}

/// What an exception handler answers: raised with a code, or returned.
pub data Outcome(a : Type) : Type {
  Raised : (code : Integer) --> Outcome(a);
  Returned : (x : a) --> Outcome(a);
}

/// State answered at the front of the row from the state `s`, the rest of
/// the row forwarded.
pub def rec runState(e : Type, a : Type, p : Prog(Either(StateOp, e), a), s : Integer) -> Prog(e, a) {
  case p {
    Done(x) => (Done(x) : Prog(e, a)),
    Op(o, k) => case o {
      Left(Get) => runState[<](e, a, k(s), s),
      Left(Put(t)) => runState[<](e, a, k(0), t),
      Right(other) => (Op(other, fn (r) {
        runState[<](e, a, k(r), s)
      }) : Prog(e, a))
    }
  }
}

/// Exceptions answered at the front of the row, the rest of the row
/// forwarded: a raise ends the program with its code.
pub def rec runExn(e : Type, a : Type, p : Prog(Either(ExnOp, e), a)) -> Prog(e, Outcome(a)) {
  case p {
    Done(x) => (Done(Returned(x)) : Prog(e, Outcome(a))),
    Op(o, k) => case o {
      Left(Raise(c)) => (Done(Raised(c)) : Prog(e, Outcome(a))),
      Right(other) => (Op(other, fn (r) {
        runExn[<](e, a, k(r))
      }) : Prog(e, Outcome(a)))
    }
  }
}

/// A program with nothing left in its row is its result.
pub def pureOf(a : Type, p : Prog(Void, a)) -> a {
  case p {
    Done(x) => x,
    Op(o, _k) => case o {}
  }
}

/// Over exceptions, then state: read, store one more, read again, and answer
/// ten times the second read.
pub def guarded : Prog(Either(ExnOp, Either(StateOp, Void)), Integer) = Op(Right(Left(Get)), fn (a) {
  (Op(Right(Left(Put(a + 1))), fn (_u) {
    (Op(Right(Left(Get)), fn (b) {
      (Done(b * 10) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
    }) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
  }) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
});

/// Over the same row: read, then raise what was read.
def raising : Prog(Either(ExnOp, Either(StateOp, Void)), Integer) = Op(Right(Left(Get)), fn (a) {
  (Op(Left(Raise(a)), fn (_r) {
    (Done(0) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
  }) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
});

/// Over state alone: read, and answer what was read.
def quiet : Prog(Either(StateOp, Void), Integer) = Op(
  Left(Get),
  fn (a) { (Done(a) : Prog(Either(StateOp, Void), Integer)) }
);

/// Over exceptions alone: raise four.
def failing : Prog(Either(ExnOp, Void), Integer) = Op(
  Left(Raise(4)),
  fn (_r) { (Done(0) : Prog(Either(ExnOp, Void), Integer)) }
);

/// Exceptions peeled, then state from four, then nothing left: the second
/// read sees the stored five. Each handler is called at the row it leaves,
/// an applied type passed for its type parameter (#2512).
@[ runs("Returned(50)") ]
def handled() -> Outcome(Integer) {
  run p <- runExn(Either(StateOp, Void), Integer, guarded);
  pureOf(Outcome(Integer), runState(Void, Outcome(Integer), p, 4))
}

/// The raise ends the program with the state it read.
@[ runs("Raised(4)") ]
def handledRaise() -> Outcome(Integer) {
  run p <- runExn(Either(StateOp, Void), Integer, raising);
  pureOf(Outcome(Integer), runState(Void, Outcome(Integer), p, 4))
}
