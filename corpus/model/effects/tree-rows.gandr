// This source handles rows as explicit effect trees.
//
// Each handler answers the front operation and forwards the remaining row.
//
// The kernel replays each row declaration.
//
// - see: #2512 — `handled`

// `Either`, `StateOp` and `Prog`.
import "./tree.gandr";

/// `ExnOp` raises an integer code.
pub data ExnOp : Type where
  | Raise : (code : Integer) --> ExnOp

/// `Outcome` holds a raised code or a returned value.
pub data Outcome(a : Type) : Type where
  | Raised : (code : Integer) --> Outcome(a)
  | Returned : (x : a) --> Outcome(a)

/// `runState` handles state at the front and forwards the remaining row.
pub def rec runState(e : Type, a : Type, p : Prog(Either(StateOp, e), a), s : Integer) -> Prog(e, a) =
  match p where
    | Done(x) => (Done x : Prog(e, a))
    | Op(o, k) => match o where
      | Left(Get) => runState[<] e a (k s) s
      | Left(Put(t)) => runState[<] e a (k 0) t
      | Right(other) => (Op other (fun (r) {
        runState[<] e a (k r) s
      }) : Prog(e, a))

/// `runExn` handles exceptions at the front and forwards the remaining row.
pub def rec runExn(e : Type, a : Type, p : Prog(Either(ExnOp, e), a)) -> Prog(e, Outcome(a)) =
  match p where
    | Done(x) => (Done (Returned x) : Prog(e, Outcome(a)))
    | Op(o, k) => match o where
      | Left(Raise(c)) => (Done (Raised c) : Prog(e, Outcome(a)))
      | Right(other) => (Op other (fun (r) {
        runExn[<] e a (k r)
      }) : Prog(e, Outcome(a)))

/// `pureOf` extracts a result from an empty row.
pub def pureOf(a : Type, p : Prog(Void, a)) -> a =
  match p where
    | Done(x) => x
    | Op(o, _k) => match o {}

/// `guarded` reads state, stores its successor and returns the next read.
pub def guarded : Prog(Either(ExnOp, Either(StateOp, Void)), Integer) = Op (Right (Left Get)) (fun (a) {
  (Op (Right (Left (Put (a + 1)))) (fun (_u) {
    (Op (Right (Left Get)) (fun (b) {
      (Done (b * 10) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
    }) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
  }) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
});

/// `raising` reads state and raises the value it reads.
def raising : Prog(Either(ExnOp, Either(StateOp, Void)), Integer) = Op (Right (Left Get)) (fun (a) {
  (Op (Left (Raise a)) (fun (_r) {
    (Done 0 : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
  }) : Prog(Either(ExnOp, Either(StateOp, Void)), Integer))
});

/// `quiet` reads state from a state-only row.
def quiet : Prog(Either(StateOp, Void), Integer) = Op (Left Get) (fun (a) {
  (Done a : Prog(Either(StateOp, Void), Integer))
});

/// `failing` raises four from an exception-only row.
def failing : Prog(Either(ExnOp, Void), Integer) = Op (Left (Raise 4)) (fun (_r) {
  (Done 0 : Prog(Either(ExnOp, Void), Integer))
});

/// `handled` removes exceptions and state from `guarded`.
@[ runs("Returned 50") ]
def handled() -> Outcome(Integer) =
  let p = runExn (Either StateOp Void) Integer guarded
  pureOf (Outcome Integer) (runState Void (Outcome Integer) p 4)

/// `handledRaise` returns the exception from `raising`.
@[ runs("Raised 4") ]
def handledRaise() -> Outcome(Integer) =
  let p = runExn (Either StateOp Void) Integer raising
  pureOf (Outcome Integer) (runState Void (Outcome Integer) p 4)
