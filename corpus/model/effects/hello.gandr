// Hello, world: a program printing a line through `std`, handed the ambient
// authority by `gandr run`.
//
// Authority enters a program in one place, as `main`'s parameter, and the
// program prints through a capability opened from it. Nothing reaches the
// standard streams through the ambient `Console` interface.
//
// `console` narrows the authority to the standard streams, and `print` writes
// one line through them. `gandr run hello.gandr` prints `hello, world!` and
// exits 0.
//
// - see: `../../../library/std/src/authority.gandr` — `Authority` and
//   `console`
// - see: `../../../library/std/src/console.gandr` — `print`
// - see: #2970 — `std.authority` and `std.console`

// `Authority`, `console`.
import "../../../library/std/src/authority.gandr";

// `print`.
import "../../../library/std/src/console.gandr";

/// The entry: it opens the console from its authority and prints its greeting.
def main(authority : Authority) -> [Console] Unit {
  print(console(authority), "hello, world!")
}
