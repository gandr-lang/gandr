// This source runs a greeting through standard output.
//
// `gandr run` passes `Authority` to `main`. The program opens a console from
// that authority.
//
// `print` emits one line through the console.
//
// - see: `../../../library/std/src/authority.gandr` — `Authority`, `console`
// - see: `../../../library/std/src/io.gandr` — `print`
// - see: #2970 — `std.authority`, `std.io`

// `main` gets `Authority`. It opens a console.
import std.authority (Authority, console);
// `print` sends output through the console.
import std.io (print);

/// `main` opens its console and prints a greeting.
def main(authority : Authority) -> [std.io.Console.Eff] Unit =
  print (console authority) "hello, world!"
