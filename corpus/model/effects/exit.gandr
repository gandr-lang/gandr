// This source tests deep handlers for exit and console effects.
//
// The bridge represents a handled body as a free-model tree. The handler
// folds that tree.
//
// The kernel checks the tree and its fold.
//
// - see: `tree-exit.gandr` — handler folds

// The console's host interface.
import std.io;
// Early exit's host interface.
import std.process;

/// `resumed` resumes the exit continuation.
@[ runs("101") ]
def resumed() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// `answered` returns nine.
@[ runs("9") ]
def answered() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => pure 9
  }

/// `coded` returns the exit payload.
@[ runs("5") ]
def coded() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => pure code
  }

/// `summed` adds codes from nested exits.
@[ runs("108") ]
def summed() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 3;
    c.exit 4;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => {
      let rest = k *{};
      pure rest + code
    }
  }

/// `printed` counts console prints.
@[ runs("2") ]
def printed() -> Integer =
  handle out : std.io.Console.Eff {
    out.print "one";
    out.print "two";
    pure 7
  } with {
    | pure(x) => pure 0
    | oper print(line, k) => {
      let rest = k *{};
      pure rest + 1
    }
  }
