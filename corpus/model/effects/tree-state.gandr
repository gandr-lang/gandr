// State as data: `state-handler.gandr`'s programs written as trees and its
// handlers as folds of the tree, twice: over the row of state alone,
// `tree.gandr`'s `Prog`, and over `State`'s free model, one constructor per
// operation, as the kernel replays the native `constant`. Each runs to what
// the native handler runs to, and the kernel replays every declaration here.

// `Either`, `StateOp` and `Prog`.
import "./tree.gandr" ;

/// `constant`'s subject as a tree: read, store what was read, read again,
/// and answer the two reads and one.
def constantTree : Prog(Either(StateOp, Void), Integer) = Op(Left(Get), fn (a) {
  (Op(Left(Put(a)), fn (_u) {
    (Op(Left(Get), fn (b) {
      (Done(a + b + 1) : Prog(Either(StateOp, Void), Integer))
    }) : Prog(Either(StateOp, Void), Integer))
  }) : Prog(Either(StateOp, Void), Integer))
}) ;

/// `constant`'s clauses as a fold: every read is answered four, and a store
/// is forgotten.
def rec answeringFour(p : Prog(Either(StateOp, Void), Integer)) -> Integer {
  case p {
    Done(x) => x,
    Op(o, k) => case o {
      Left(Get) => answeringFour[<](k(4)),
      Left(Put(_s)) => answeringFour[<](k(0)),
      Right(none) => case none {}
    }
  }
}

/// Nine, as `constant` runs to.
@[ runs("9") ]
def constantByFold() -> Integer { answeringFour(constantTree) }

/// `answeredByPassing`'s subject as a tree: store four, read twice, and
/// answer ten times the first read and the second.
def passingTree : Prog(Either(StateOp, Void), Integer) = Op(Left(Put(4)), fn (_u) {
  (Op(Left(Get), fn (a) {
    (Op(Left(Get), fn (b) {
      (Done(a * 10 + b) : Prog(Either(StateOp, Void), Integer))
    }) : Prog(Either(StateOp, Void), Integer))
  }) : Prog(Either(StateOp, Void), Integer))
}) ;

/// The state-passing model as a fold: a read is answered the current state,
/// and a store replaces it.
def rec passingState(p : Prog(Either(StateOp, Void), Integer), s : Integer) -> Integer {
  case p {
    Done(x) => x,
    Op(o, k) => case o {
      Left(Get) => passingState[<](k(s), s),
      Left(Put(t)) => passingState[<](k(0), t),
      Right(none) => case none {}
    }
  }
}

/// Forty-four from a zero state, as `answeredFromZero` runs to.
@[ runs("44") ]
def passingByFold() -> Integer { passingState(passingTree, 0) }

/// `State`'s free model at an integer state: the body's result, or one
/// constructor per operation, each holding its payload and the continuation
/// awaiting its reply. `get` holds the unit and awaits the state; `put` holds
/// the state and awaits the unit.
data StateModel(a : Type) : Type {
  Answer : (x : a) --> StateModel(a);
  Read : (u : Unit, k : Integer => StateModel(a)) --> StateModel(a);
  Write : (s : Integer, k : Unit => StateModel(a)) --> StateModel(a);
}

/// `constant`'s subject as a program of the model.
def constantProgram : StateModel(Integer) = Read(unit, fn (a) {
  (Write(a, fn (_u) {
    (Read(unit, fn (b) { (Answer(a + b + 1) : StateModel(Integer)) }) : StateModel(Integer))
  }) : StateModel(Integer))
}) ;

/// `constant`'s clauses as the model's fold: a read resumes at four, and a
/// store resumes at the unit.
def rec constantFold(p : StateModel(Integer)) -> Integer {
  case p {
    Answer(x) => x,
    Read(_u, k) => constantFold[<](k(4)),
    Write(_s, k) => constantFold[<](k(unit))
  }
}

/// Nine, as `constant` runs to.
@[ runs("9") ]
def constantByModel() -> Integer { constantFold(constantProgram) }
