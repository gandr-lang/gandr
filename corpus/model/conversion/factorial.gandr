//! Factorial by recursion and by iteration agree, and a factorial is even.
//!
//! Grégoire and Leroy time factorial on unary naturals, its parity, and two
//! factorial terms with one normal form. The parity reads back one constant,
//! so the run dominates it.
//!
//! One path compares the recursive and the iterative factorial of six. The other
//! states that the factorial of five is even.
//!
//! - cites: [Gregoire-2002-a_compiled_implementation_of_strong_reduction], § 6
//! - see: #2282 — the benchmark set
//!
//! [Gregoire-2002-a_compiled_implementation_of_strong_reduction]: https://doi.org/10.1145/581478.581501 "Grégoire and Leroy, A compiled implementation of strong reduction"

// The free naturals.
import "../data/data-base.gandr";

// The products and the numeral four.
import "./conversion-base.gandr";

/// Factorial by recursion, which forms the product on the way back.
def rec fact(n : Nat) -> Nat =
  match n
    | Zero => Succ Zero
    | Succ(m) => (times (Succ m)) (fact[<] m)

/// Factorial by iteration, the product carried in an accumulator.
def rec factFrom(n : Nat, acc : Nat) -> Nat =
  match n
    | Zero => acc
    | Succ(m) => factFrom[<] m (times acc (Succ m))

/// Whether a natural is even.
def rec even(n : Nat) -> Bool =
  match n
    | Zero => true
    | Succ(m) => match even[<] m
      | true => false
      | false => true

/// The two definitions agree at six.
def factAgrees() -> Path(fact (Succ (Succ four)), (factFrom (Succ (Succ four))) (Succ Zero)) =
  Path.here (fact (Succ (Succ four)))

/// The factorial of five is even.
def factEven() -> Path(even (fact (Succ four)), true) =
  Path.here true
