//! `spokenFirst` has a task speak before the parent asks it.
//!
//! The task's send, the parent receipt and the parent answer reverse the forced
//! chain. A forced web does not settle this run.
//!
//! The task sends notes, then reads the parent answer. The annotations state
//! the web the runner reports against a forced web.
//!
//! - see: `forced.gandr` — the same exchange, asked first
//! - see: #3338 — the run trace and the web a source states for a channel
// The import gives the task protocols.
import "./task-base.gandr";

/// A task sends notes before it reads its parent's answer.
@[
  runs("*{}"),
  traces(decomposes
    task
    (series
      (event left 0)
      (event right 0)
      (event right 1)
      (parallel (series (event left 1) (event left 2)) (event right 2))))
]
def spokenFirst() -> Unit =
  let heard = fork (task : Task.Volunteer) {
    send task Task.notes;
    let answer = recv task;
    close task
  };
  let told = recv heard
  send heard told
  close heard
