//! The tasks subject's shared declarations, written once and imported by every
//! source that reads them (`import "./task-base.gandr";`): a task forked as its
//! parent's peer hands back what it found over its end. A fork is the parallel
//! product of two strategies and an operation a move of one of them
//! [Mellies-2020-concurrent_separation_logic_meets_template_games]; the parent
//! joins its task by reading the end to its close, so no task outlives its
//! parent, as no task outlives the nursery that started it in Trio.
//!
//! - cites: [Mellies-2020-concurrent_separation_logic_meets_template_games]
//!
//! [Mellies-2020-concurrent_separation_logic_meets_template_games]: https://doi.org/10.1145/3373718.3394762 "Melliès and Stefanesco, Concurrent Separation Logic Meets Template Games"

/// A task: the protocols its end carries back to the parent, and the path it
/// reads.
pub module Task :> #{
  type Join = !String. end,
  type Relay = ?String. !String. end,
  type Volunteer = !String. ?String. end,
  notes : String
} where {
  /// The path a task reads.
  def notes = "notes";
}
