//! `independent` forks two tasks whose plays do not order each other.
//!
//! Each task sends notes on its end. Each channel web is series-parallel
//! without a prime node, whatever order the parent joins the tasks in.
//!
//! The parent joins the tasks in reverse fork order. The annotations state each
//! channel's prime count.
//!
//! - see: `forced.gandr` — a task whose reply waits on its request
//! - see: #3338 — the run trace and the web a source states for a channel
// The import gives the task protocols.
import "./task-base.gandr";

/// A parent joins two tasks in reverse fork order.
@[ runs("*{}"), traces(primes scout 0), traces(primes scribe 0) ]
def independent() -> Unit =
  let scouted = fork (scout : Task.Join) {
    send scout Task.notes;
    close scout
  };
  let scribed = fork (scribe : Task.Join) {
    send scribe Task.notes;
    close scribe
  };
  let written = recv scribed
  close scribed
  let found = recv scouted
  close scouted
