// One builtin of each namespace over its simplest values: negation, division
// and remainder, a list's length and element, and string append and length.
// Each is reached by projection from its namespace, which the lowering admits
// for the native primitives alone (#1170) and for no other builtin yet
// (#1106), but where the definition's value is first a computation with no
// stated type. Division and append with their types stated check and run.

/// Negation of a comparison. A comparison is a computation, and a definition
/// with no stated type reads its value where nothing infers that type.
@[ refuses("NotSynthesisable") ]
def not_small = bool.not(1 < 2);

/// Integer division, its argument a computation as above.
@[ refuses("NotSynthesisable") ]
def quotient = int.div(7, 2);

/// The remainder of a negative number, its argument a computation as above.
@[ refuses("NotSynthesisable") ]
def remainder = int.mod(-7, 2);

/// Integer division with its type stated, which checks; the namespace `int`
/// qualifies the path, and the path answers for it (#1170).
@[ checks ]
def quotientOf(c : Integer) -> -F Integer {
  run lead <- int.div(c, 64);
  lead
}

/// A list's length.
@[ refuses("OutOfFragment.projection_expression") ]
def size = list.length([1, 2, 3]);

/// A list's element at position one.
@[ refuses("OutOfFragment.projection_expression") ]
def second = list.get([10, 20, 30], 1);

/// Two strings, appended, the value a computation as above.
@[ refuses("NotSynthesisable") ]
def phrase = string.append("types are ", "machines");

/// Two strings appended with the type stated, which checks and runs: the
/// first string's characters, then the second's.
@[ runs("\"types are machines\"") ]
def stated() -> -F String {
  run joined <- string.append("types are ", "machines");
  joined
}

/// The appended string's length. The native `string` namespace holds
/// `append` alone, so `length` is no member of it (#1106).
@[ refuses("UnknownMember") ]
def letters = string.length(stated);

/// The run target appends an exclamation to the phrase, refused above, so it
/// names a declaration whose type is not known.
@[ refuses("UnknownConstant") ]
string.append(phrase, "!")
