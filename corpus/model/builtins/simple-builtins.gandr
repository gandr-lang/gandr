// This source tests basic builtin namespaces.
//
// It tests boolean negation, integer division and remainder, list access and
// string operations. An unstated computation type blocks a definition.
//
// The lowering admits native primitives only. Stated division, append and
// equality check and run. Other builtin namespace projections are refused.
//
// - see: #1170 — `quotientOf`
// - see: #1106 — `letters`

/// `not_small` negates a comparison. An unstated computation has no inferred
/// type.
@[refuses("NotSynthesisable")]
def not_small = bool.not (1 < 2);

/// `quotient` divides integers through an unstated computation.
@[refuses("NotSynthesisable")]
def quotient = int.div 7 2;

/// `remainder` takes the remainder of a negative integer.
@[refuses("NotSynthesisable")]
def remainder = int.mod (- 7) 2;

/// `quotientOf` divides an integer at a stated type. `int` qualifies its
/// native path.
def quotientOf(c : Integer) -> Integer =
  let lead = int.div c 64
  lead

/// `size` reads a list length.
@[refuses("OutOfFragment.projection_expression")]
def size = list.length (#[1, 2, 3]);

/// `second` reads a list element at position one.
@[refuses("OutOfFragment.projection_expression")]
def second = list.get (#[10, 20, 30]) 1;

/// `phrase` appends two strings through an unstated computation.
@[refuses("NotSynthesisable")]
def phrase = string.append "types are " "machines";

/// `stated` appends two strings at a stated type. It keeps their characters
/// in order.
@[runs("\"types are machines\"")]
def stated() -> String =
  let joined = string.append "types are " "machines"
  joined

/// `compared` compares two strings at a stated type. Their bytes differ.
@[runs("+{.1 = *{}}")]
def compared() -> Bool =
  let equal = string.eq "types are " "machines"
  equal

/// `letters` asks for a string length. The native namespace has no `length`
/// member.
@[refuses("UnknownMember")]
def letters = string.length stated;

/// `exclaimed` appends an exclamation to a rejected phrase. Its type is
/// unknown.
@[refuses("UnknownConstant")]
def exclaimed() -> String { string.append phrase "!" }
