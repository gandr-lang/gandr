// This source tests native list patterns.
//
// A list pattern names the empty list, elements, a rest binding and an
// as-pattern binding for the whole value.
//
// The compiler turns each pattern into a list case over the empty list and a
// cell. A recursive rest match descends structurally.
//
// - see: `pathological/builtins/list-patterns.gandr` — unmatched and mixed patterns

// This import provides native finite lists.
import std.list (List);

/// `Grade` records a rubric grade.
data Grade : Type where
  | Met : Grade
  | Unmet : Grade

/// `compose` returns `Unmet` when any grade is unmet. It returns `Met`
/// otherwise.
def rec compose(grades : List Grade) -> Grade =
  match grades where
    | #[] => Met
    | #[grade, ..rest] => match grade where
      | Unmet => Unmet
      | Met => compose[<] rest

/// `failing` has one unmet grade.
@[ runs("Unmet") ]
def failing() -> Grade =
  compose (#[Met, Unmet, Met])

/// Met grades alone pass it.
@[ runs("Met") ]
def passing() -> Grade =
  compose (#[Met, Met])

/// `shortLength` reads a list shape up to length three.
def shortLength(xs : List Integer) -> Integer =
  match xs where
    | #[] => 0
    | #[a] => 1
    | #[a, b] => 2
    | _ => 3

/// `two` matches the two-element pattern.
@[ runs("2") ]
def two() -> Integer =
  shortLength (#[7, 8])

/// `many` reaches the catch-all after every written length.
@[ runs("3") ]
def many() -> Integer =
  shortLength (#[7, 8, 9, 10])

/// `secondOf` reads the second element after the first.
def secondOf(xs : List Integer) -> Integer =
  match xs where
    | #[_, b, ..rest] => b
    | _ => 0

/// `eight` reads the second element of three.
@[ runs("8") ]
def eight() -> Integer =
  secondOf (#[7, 8, 9])

/// `headed` adds a list head to its short length. Its as-pattern binds the
/// whole matched list.
def headed(xs : List Integer) -> Integer =
  match xs where
    | all @ #[a, .._] => {
      let counted = shortLength all;
      a + counted
    }
    | #[] => 0

/// `seven` reads five and the two elements it heads.
@[ runs("7") ]
def seven() -> Integer =
  headed (#[5, 6])
