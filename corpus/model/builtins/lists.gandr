// This source creates native finite lists.
//
// `xs` has three integers at its stated element type.
//
// `prefixed` adds zero at the front. The lowering does not yet admit `++`.
//
// - see: #1544 — `xs`
// - see: #1997 — `prefixed`

// This import provides native finite lists.
import std.list (List);

/// `xs` is a three-element `List(Integer)`.
def xs = (#[1, 2, 3] : List Integer);

/// `prefixed` adds zero at the front. The lowering does not yet admit `++`.
@[refuses("OutOfFragment.binary_expression")]
def prefixed = #[0] ++ xs;
