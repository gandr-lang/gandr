// A list literal at a stated element type, and a list extended at its front.

/// Three integers, annotated as a list of them: the cons cells over `1`, `2`
/// and `3`, ending in the empty list (#1544).
def xs = ([1, 2, 3] : List(Integer));

/// The run target prepends a zero; the lowering admits no `++` yet (#1997).
@[ refuses("OutOfFragment.binary_expression") ]
[0] ++ xs
