// This source tests list operations that create new lists.
//
// The operations set, update, insert, remove, push, append and concatenate
// elements.
//
// The lowering does not yet admit selection from the `list` namespace.
//
// - see: #1106

// This import provides native finite lists.
import std.list (List);

/// `tens` is a three-element integer list.
def tens = (#[10, 20, 30] : List Integer);

/// `replaced` sets the element at position one.
@[refuses("OutOfFragment.projection_expression")]
def replaced = list.set tens 1 99;

/// `bumped` increments the element at position zero.
@[refuses("OutOfFragment.projection_expression")]
def bumped = list.update_at tens 0 (thunk { fun (n) { return n + 1 } });

/// `inserted` inserts an element at position one.
@[refuses("OutOfFragment.projection_expression")]
def inserted = list.insert_at tens 1 15;

/// `removed` removes the element at position zero.
@[refuses("OutOfFragment.projection_expression")]
def removed = list.remove_at tens 0;

/// `grown` pushes an element at the end.
@[refuses("OutOfFragment.projection_expression")]
def grown = list.push tens 40;

/// `appended` appends a second list.
@[refuses("OutOfFragment.projection_expression")]
def appended = list.append tens (#[40, 50]);

/// `concatenated` joins a list of lists.
@[refuses("OutOfFragment.projection_expression")]
def concatenated = list.concat (#[tens, #[40, 50]]);

/// `doubled_over_fifteen` doubles every element over fifteen. The lowering
/// does not read a `list` primitive.
@[refuses("OutOfFragment.projection_expression")]
def doubled_over_fifteen = list.update_where (thunk { fun (n) { return n > 15 } }) (thunk {
  fun (n) { return n * 2 }
}) tens;
