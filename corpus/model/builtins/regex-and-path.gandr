// This source tests regular-expression and path projections.
//
// The examples extract named captures and join a path with its base name and
// extension.
//
// The lowering does not yet admit selection from either namespace.
//
// - see: #1106

/// `caps` extracts a file stem and extension by name.
@[refuses("OutOfFragment.projection_expression")]
def caps = regex.extract "^(?<stem>.*)\\.(?<ext>gandr)$" "examples/demo.gandr";

/// `demo_path` joins a directory and file name.
@[refuses("OutOfFragment.projection_expression")]
def demo_path = path.join "examples" "demo.gandr";

/// `leaf` reads the joined path's final component.
@[refuses("OutOfFragment.projection_expression")]
def leaf = path.basename demo_path;

/// `suffix` reads the joined path's extension.
@[refuses("OutOfFragment.projection_expression")]
def suffix = path.extension demo_path;

/// `gathered` groups the rejected declarations. Its type is unknown.
@[refuses("UnknownConstant")]
def gathered = *{capture = caps, leaf = leaf, path_ext = suffix};
