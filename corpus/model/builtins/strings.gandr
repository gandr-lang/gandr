// The string operations of the `string` namespace: containment, equality,
// prefix and suffix, escaping and splitting. The native `string` namespace
// holds `append` and `eq` (`simple-builtins.gandr`), so the others name no
// member of it; scanning and escaping are planned text primitives (#318).
// Equality is written `==`, which resolves the prelude's `Eq` model of
// strings (#1832).

/// A string, named.
@[ checks ]
def slogan = "types are machines";

/// A statement before a named item, a stray: only a source's final expression
/// is its run target.
@[ refuses("OutOfFragment.WrongSort.declaration") ]
string.contains(slogan, "machine");

/// Equality: `==` between strings resolves the prelude's `EqString`, and a
/// slogan is itself.
@[ runs("+{.0 = unit}") ]
def same() -> Bool { slogan == "types are machines" }

/// A slogan is not another.
@[ runs("+{.1 = unit}") ]
def different() -> Bool { slogan == "types are types" }

/// Equality across types: the integer fixes the carrier `==` compares at, and
/// the string is not one.
@[ refuses("TypeMismatch") ]
def across() -> Bool { 3 == "three" }

/// Whether the string starts with a word.
@[ refuses("UnknownMember") ]
def has_prefix = string.starts_with(slogan, "types");

/// Whether the string ends with a word.
@[ refuses("UnknownMember") ]
def has_suffix = string.ends_with(slogan, "machines");

/// A path with its special characters escaped.
@[ refuses("UnknownMember") ]
def escaped = string.escape("a+b.txt");

/// The run target splits at a comma, which is no member of the native
/// `string` namespace.
@[ refuses("UnknownMember") ]
string.split("alpha,beta", ",")
