//! An abandoned stack runs the unwind of each access it captured, innermost
//! first, in place of the write-back it never reaches; its other frames never
//! run. Each captured frame's destructor runs in reverse order
//! [Congard-2025-linear_effects_exceptions_and_resource_safety]. An unwind that
//! calls a declaration owed its body blames the run, which shows the
//! abandonment ran it.
//!
//! - see: #1334 — `unwound`
//! - cites: [Congard-2025-linear_effects_exceptions_and_resource_safety]
//!
//! [Congard-2025-linear_effects_exceptions_and_resource_safety]: https://arxiv.org/abs/2510.23517 "Congard, Munch-Maccagnoni and Douence, Linear Effects, Exceptions, and Resource Safety"

// The native finite lists.
import std.list (List);
// Early exit's host interface.
import std.process;

/// A declaration owed its body: a run that calls it is blamed.
@[ owes(1) ]
def later : Integer -> Unit;

/// The rest of the scope abandoned while an access's view is open: the
/// access's unwind runs, and its call of `later` blames the run.
@[ runs("blame: `later` is owed its body") ]
def unwound() -> Integer =
  var x = 1
  let r : Integer = handle c : std.process.Exit.Eff {
    access x as v { let _ = c.exit 1; resume(v, 5) } unwind { later 1 };
    pure 0
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => { abandon k; pure 7 }
  };
  pure x

/// A list built where it runs.
def built(a : Integer) -> List(Integer) =
  pure cons a (cons 2 nil)

/// An abandoned access whose unwind reads a list the scope reads again after:
/// the unwind and the rest of the scope each hold the list.
@[ runs("cons 9 (cons 1 (cons 2 nil))") ]
def unwound_kept() -> List(Integer) =
  let ys = built 1
  var x = 1
  let r : Integer = handle c : std.process.Exit.Eff {
    access x as v { let _ = c.exit 1; resume(v, 5) } unwind { let _ = ys; pure *{} };
    pure 0
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => { abandon k; pure 7 }
  };
  pure cons 9 ys
