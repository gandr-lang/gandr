//! Abandoning the rest of a scope ends what it held without resuming it: an
//! access abandoned before its `resume` writes nothing back, so its hold keeps
//! the value it held. A handler clause that does not resume its continuation
//! discards it [Plotkin-2013-handling_algebraic_effects].
//!
//! - see: #1334 — `unwritten`
//! - cites: [Plotkin-2013-handling_algebraic_effects]
//!
//! [Plotkin-2013-handling_algebraic_effects]: https://doi.org/10.2168/LMCS-9(4:23)2013 "Plotkin and Pretnar, Handling Algebraic Effects"

// Early exit's host interface.
import std.process;

/// An access whose view the scope's clause abandons before its write-back:
/// the held value stays.
@[ runs("1") ]
def unwritten() -> Integer =
  var x = 1
  let r : Integer = handle c : std.process.Exit.Eff {
    access x as v { let _ = c.exit 1; resume v 5 } unwind { pure *{} };
    pure 0
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => { abandon k; pure 7 }
  };
  pure x
