//! An abandoned stack that holds a pending completion cancels it: the stack's
//! end of the kernel's protocol counts as ended, and the kernel's next action
//! is the one that observes the cancellation
//! [Fowler-2019-exceptional_asynchronous_session_types].
//!
//! - see: #1334 — `inFlight`
//! - cites: [Fowler-2019-exceptional_asynchronous_session_types]
//!
//! [Fowler-2019-exceptional_asynchronous_session_types]: https://doi.org/10.1145/3290341 "Fowler, Lindley, Morris and Decova, Exceptional Asynchronous Session Types"

// The ring's protocol and its entries.
import "../completion/ring-base.gandr";
// Early exit's host interface.
import std.process;

/// A read submitted and its completion abandoned in flight: the clause
/// abandons the rest that would reap it.
@[ runs("*{}") ]
def inFlight() -> Unit =
  handle c : std.process.Exit.Eff {
    let ring = fork (kernel : Ring.Submission) {
      let sqe = recv(kernel);
      send(kernel, Ring.done);
      close(kernel)
    };
    send(ring, Ring.read);
    c.exit 1;
    let cqe = recv(ring);
    close(ring)
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => abandon k
  }
