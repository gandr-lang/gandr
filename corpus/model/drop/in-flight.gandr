//! `in-flight` models an abandoned continuation with a pending completion.
//!
//! An abandoned continuation ends its stack's protocol.
//! The kernel observes cancellation in its next action.
//!
//! The program submits a read.
//! Its handler abandons the continuation that would receive the completion.
//!
//! - see: #1334 — `inFlight`
//! - cites: [Fowler-2019-exceptional_asynchronous_session_types]
//!
//! [Fowler-2019-exceptional_asynchronous_session_types]: https://doi.org/10.1145/3290341 "Fowler, Lindley, Morris and Decova, Exceptional Asynchronous Session Types"

// The import provides the ring protocol and its entries.
import "../completion/ring-base.gandr";
// The import provides the early-exit host interface.
import std.process;

/// The handler abandons the continuation that would receive a submitted read's
/// completion.
@[ runs("*{}") ]
def inFlight() -> Unit =
  handle c : std.process.Exit.Eff {
    let ring = fork (kernel : Ring.Submission) {
      let sqe = recv kernel;
      send kernel Ring.done;
      close kernel
    };
    send ring Ring.read;
    c.exit 1;
    let cqe = recv ring;
    close ring
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => abandon k
  }
