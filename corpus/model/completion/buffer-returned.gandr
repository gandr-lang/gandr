//! `buffer-returned` returns an allocated buffer after a mock ring completion.
//!
//! It keeps a buffer live exactly once from allocation to freeing. The
//! pathological twin refuses a buffer that a program does not return as
//! `BufferUnreturned`.
//!
//! The kernel owns the buffer while an operation is in flight
//! [boats-2020-notes_on_io_uring]. A `Ring.Eff` handler mints the buffer and
//! handles its return. The mock kernel sends it back before the continuation
//! resumes.
//!
//! - see: corpus/pathological/completion/buffer-misused.gandr
//! - cites: [boats-2020-notes_on_io_uring]
//!
//! [boats-2020-notes_on_io_uring]: https://without.boats/blog/io-uring/ "boats, Notes on io-uring"

// The native buffer a receive places live.
import std.buffer (Buf);

// The ring's host interface.
import std.io;

/// A buffer allocated and freed: the allocation places it live, and the free
/// hands it back to the scope that minted it. The `alloc` clause lends its
/// mint to a mock kernel, which fills it and hands it back with the
/// completion, before the clause resumes with it.
def bufferReturned() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => {
      let ring = fork (kernel : ?Buf. !Buf. end) {
        let held = recv kernel;
        send kernel held;
        close kernel
      };
      send ring b;
      let filled = recv ring;
      close ring;
      k filled
    }
    | oper free(b, k) => k *{}
  }

/// A buffer freed in each arm of a case: each arm starts from the buffer as
/// the case found it live, and every arm hands it back.
def freedInEachArm(flag : Bool) -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    match flag where
      | true => r.free b
      | false => r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
  }
