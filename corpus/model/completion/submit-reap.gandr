//! `submit-reap` sends a read and reaps its completion.
//!
//! A mock ring owes one completion for its submission. The pathological twin
//! refuses a submitted read with a pending completion as `LinearResidue`.
//!
//! The checker gives the submitter a pending completion after its send. The
//! mock kernel posts `done` and closes the ring.
//!
//! - see: corpus/pathological/completion/pending-dropped.gandr
//! - see: https://man7.org/linux/man-pages/man7/io_uring.7.html

// The ring's protocol and its entries.
import "./ring-base.gandr";

/// A read submitted to the mock kernel and its one completion reaped.
def submitThenReap() -> Unit =
  let ring = fork (kernel : Ring.Submission) {
    let sqe = recv kernel;
    send kernel Ring.done;
    close kernel
  };
  send ring Ring.read
  let cqe = recv ring
  close ring
