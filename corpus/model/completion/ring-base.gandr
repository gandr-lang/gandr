//! `ring-base` defines the mock ring protocols and entries.
//!
//! Each submission owes one completion. The pathological twins refuse a
//! completion left pending and a buffer reused before its completion.
//!
//! The checker gives the submitter a pending completion after it sends `read`.
//! The imported declarations give every completion source one protocol.
//!
//! - see: corpus/pathological/completion/pending-dropped.gandr
//! - see: corpus/pathological/completion/buffer-touched.gandr
//! - see: https://without.boats/blog/io-uring/

/// A ring: its entries sealed behind the interface, the protocol of one
/// submission as the kernel serves it, the buffer and the pending completion
/// on the submitter's side, the protocols that take a buffer, a pending
/// completion or a target's pending completion over a session, and one entry
/// of each kind.
pub module Ring :> *{
  type Sqe,
  type Cqe,
  type Submission = ?Sqe. !Cqe. end,
  type Buffer = end,
  type Pending = ?Cqe. end,
  type Moving = ?Buffer. !Cqe. end,
  type Reaping = ?Pending. end,
  type Cancelling = ?Pending. !Cqe. end,
  read : Sqe,
  done : Cqe
} where
  type Sqe = String;
  type Cqe = Integer;
  /// The entry a read submits.
  def read = "read";
  /// The result its completion posts.
  def done = 0;
