// The target's completion reaped before the cancellation's, every close
// written as a statement: a block ending in `close(e);` closes `e` and returns
// the unit, as one ending in `close(e)` does (#1205).

// The ring's protocol and its entries.
import "./ring-base.gandr";

/// The target's completion reaped first, each half and the body ending in a
/// closing statement.
def closedAsStatements() -> Unit {
  let pending = fork (target : Ring.Submission) {
    let sqe = recv(target);
    send(target, Ring.done);
    close(target);
  };
  let cancel = fork (canceller : Ring.Submission) {
    let sqe = recv(canceller);
    send(canceller, Ring.done);
    close(canceller);
  };
  send(pending, Ring.read);
  send(cancel, Ring.read);
  let first = recv(pending);
  let second = recv(cancel);
  close(pending);
  close(cancel);
}
