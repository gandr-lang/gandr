//! `cancel-orders` reaps a target and cancellation completion in either order.
//!
//! Cancellation and its target owe independent completions. Cancellation can
//! also take and reap the target's pending completion.
//!
//! The checker tracks each completion as a separate endpoint. `cancelConsumes`
//! transfers the pending endpoint to cancellation.
//!
//! - see: #1229

// The ring's protocol and its entries.
import "./ring-base.gandr";

/// The target's completion reaped before the cancellation's.
def targetFirst() -> Unit =
  let pending = fork (target : Ring.Submission) {
    let sqe = recv target;
    send target Ring.done;
    close target
  };
  let cancel = fork (canceller : Ring.Submission) {
    let sqe = recv canceller;
    send canceller Ring.done;
    close canceller
  };
  send pending Ring.read
  send cancel Ring.read
  let first = recv pending
  let second = recv cancel
  close pending
  close cancel

/// The cancellation's completion reaped before the target's.
def cancelFirst() -> Unit =
  let pending = fork (target : Ring.Submission) {
    let sqe = recv target;
    send target Ring.done;
    close target
  };
  let cancel = fork (canceller : Ring.Submission) {
    let sqe = recv canceller;
    send canceller Ring.done;
    close canceller
  };
  send pending Ring.read
  send cancel Ring.read
  let first = recv cancel
  let second = recv pending
  close cancel
  close pending

/// The target's pending completion moved into the cancellation, which reaps it
/// and then posts its own: the submitter keeps only the cancellation's.
def cancelConsumes() -> Unit =
  let pending = fork (target : Ring.Submission) {
    let sqe = recv target;
    send target Ring.done;
    close target
  };
  let cancel = fork (canceller : Ring.Cancelling) {
    let owed = recv canceller;
    let reaped = recv owed;
    close owed;
    send canceller Ring.done;
    close canceller
  };
  send pending Ring.read
  send cancel pending
  let own = recv cancel
  close cancel

/// The cancellation's protocol written out where its endpoint is bound,
/// a receive whose payload is itself a receive. It takes the target's pending
/// completion, reaps it and posts nothing of its own.
def cancelWrittenOut() -> Unit =
  let pending = fork (target : Ring.Submission) {
    let sqe = recv target;
    send target Ring.done;
    close target
  };
  let cancel = fork (canceller : ?(?(Ring.Cqe). end). end) {
    let owed = recv canceller;
    let reaped = recv owed;
    close owed;
    close canceller
  };
  send pending Ring.read
  send cancel pending
  close cancel
