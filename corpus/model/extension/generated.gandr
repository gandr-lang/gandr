// An extension type stated by its `ext` member: `ext Cell = Val on left is
// zero` declares the sort of cells of `Val` fixed to `zero` on the face
// `left`, and the face theory generates its signature — `inCell` introducing
// a cell by its values off the face, `outCellp` reading it at each point `p`,
// and the boundary, β and η laws among the block's rules (Tesla Zhang, _Three
// non-cubical applications of extension types_, arXiv:2311.05658). Each
// generated member is named for its point by the point's name. Over two
// points it is the signature `zero-fiber.gandr` writes by hand (#641).

/// The cells of `Val` over `Two` fixed to `zero` on `left`, with `c` a cell
/// nothing introduces. The boundary reads `zero` at `left` of every cell, `c`
/// included; β reads an introduced cell's value at the point off the face; η
/// rebuilds a cell from its value there.
@[ normalizes("cells(outCellp(c), outCellq(inCell(one)), inCell(outCellq(c))) ~> cells(zero, one, c)") ]
theory Generated {
  boundary Two { p, q };
  face left = {p};
  sort Val : Type;

  oper zero : Val;
  oper one : Val;
  ext Cell = Val on left is zero;
  oper c : Cell;
  oper cells : (b : Val, v : Val, e : Cell) --> Val;
}

/// Over three points with one on the face, a cell holds two values: `inWide`
/// takes both, β reads each back, and η rebuilds a cell from its two reads.
@[ normalizes("cells(outWidep(d), outWider(inWide(one, zero)), inWide(outWideq(d), outWider(d))) ~> cells(zero, zero, d)") ]
theory Wider {
  boundary Three { p, q, r };
  face left = {p};
  sort Val : Type;

  oper zero : Val;
  oper one : Val;
  ext Wide = Val on left is zero;
  oper d : Wide;
  oper cells : (b : Val, v : Val, e : Wide) --> Val;
}
