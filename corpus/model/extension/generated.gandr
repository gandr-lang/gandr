//! `Generated` and `Wider` state extension signatures over finite face theories.
//!
//! The signatures show the behaviour of `ext` over two and three points.
//!
//! The checker derives each boundary, β and η law from its `ext` member.
//!
//! - see: #641
//! - cites: [Zhang-2024-three_noncubical_applications_extension_types]
//!
//! [Zhang-2024-three_noncubical_applications_extension_types]: https://arxiv.org/abs/2311.05658 "Zhang, Three non-cubical applications of extension types"
//!
/// `Generated` states how `left` fixes `Val` cells to `zero` over `Two`.
/// `Generated` uses its boundary, β and η laws for `c` and cells from `inCell`.
@[ normalizes("cells(outCellp(c), outCellq(inCell(one)), inCell(outCellq(c))) ~> cells(zero, one, c)") ]
theory Generated where
  boundary Two { p, q };
  face left = {p};
  sort Val : Type;

  oper zero : Val;
  oper one : Val;
  ext Cell = Val on left is zero;
  oper c : Cell;
  oper cells : (b : Val, v : Val, e : Cell) --> Val;

/// `Wider` states how `left` fixes `Val` cells to `zero` over `Three`.
/// `Wider` uses its boundary, β and η laws for `d` and values from `inWide`.
@[ normalizes("cells(outWidep(d), outWider(inWide(one, zero)), inWide(outWideq(d), outWider(d))) ~> cells(zero, zero, d)") ]
theory Wider where
  boundary Three { p, q, r };
  face left = {p};
  sort Val : Type;

  oper zero : Val;
  oper one : Val;
  ext Wide = Val on left is zero;
  oper d : Wide;
  oper cells : (b : Val, v : Val, e : Wide) --> Val;
