// An extension type stated as the signature the face theory generates for it.
// `ext Val on left is zero` over the two points of `Two` is the type of cells
// fixed to `zero` on the face `left`: a cell holds its value off the face,
// `ins` introduces it and `outp`, `outq` read it at each point. The boundary,
// β and η are the signature's laws, so each holds by conversion, on a neutral
// cell as on an introduced one (Tesla Zhang, _Three non-cubical applications
// of extension types_, arXiv:2311.05658). The member `ext` generates this
// signature from its spelling (`generated.gandr`).

/// The cells of `Val` over `Two` fixed to `zero` on `left`, with `c` a cell
/// nothing introduces. The boundary reads `zero` at `left` of every cell, `c`
/// included; β reads an introduced cell's value at the point off the face; η
/// rebuilds a cell from its value there.
@[ normalizes("cells(outp(c), outq(ins(one)), ins(outq(c))) ~> cells(zero, one, c)") ]
theory ZeroFiber {
  boundary Two { p, q };
  face left = {p};
  sort Val : Type;
  sort Ext : Type;

  oper zero : Val;
  oper one : Val;
  oper c : Ext;
  oper cells : (b : Val, v : Val, e : Ext) --> Val;
  oper ins : (y : Val) --> Ext;
  oper outp : (e : Ext) --> Val;
  oper outq : (e : Ext) --> Val;

  rule boundary : outp(e) ==> zero();
  rule beta : outq(ins(y)) ==> y;
  rule eta : ins(outq(e)) ==> e;
}
