// A cancellation taken: the scope's clause abandons the rest of the scope,
// which holds its task's end, so the end is cancelled rather than left open.
//
// - see: #1334 — `cancelled`

// The task's protocol.
import "./cancel-base.gandr";
// Early exit's host interface.
import std.process;

/// A scope cancelled at its exit while its task's end is open.
@[ runs("*{}") ]
def cancelled() -> Unit =
  handle c : std.process.Exit.Eff {
    let found = fork (task : Cancel.Join) {
      send task Cancel.notes;
      close task
    };
    c.exit 1;
    let text = recv found;
    close found
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => abandon k
  }
