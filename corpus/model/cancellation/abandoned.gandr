//! `abandoned` gives a cancellation that abandons a task continuation.
//!
//! The exit clause abandons the rest of its scope. The exit clause cancels the task end.
//!
//! The handler starts a task. The task sends its note. The task closes. The exit operation abandons the continuation before a receive.
//!
//! - see: #1334 — `cancelled`
// The import gives the task protocol.
import "./cancel-base.gandr";
// The import gives the early-exit host interface.
import std.process;

/// A scope cancelled at its exit while its task's end is open.
@[ runs("*{}") ]
def cancelled() -> Unit =
  handle c : std.process.Exit.Eff {
    let found = fork (task : Cancel.Join) {
      send task Cancel.notes;
      close task
    };
    c.exit 1;
    let text = recv found;
    close found
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => abandon k
  }
