//! `cancel-base` gives the task protocol for cancellation sources.
//!
//! A task sends its note on `Join`. A cancellation clause resumes its scope once. The clause can abandon that scope. The clause cancels an abandoned end for its peer.
//!
//! Each cancellation source imports `Cancel`. The checker uses `Join` to type a parent end.
//!
//! - cites: [Fowler-2019-exceptional_asynchronous_session_types]
//!
//! [Fowler-2019-exceptional_asynchronous_session_types]: https://doi.org/10.1145/3290341 "Fowler, Lindley, Morris and Decova, Exceptional Asynchronous Session Types"

/// A task: the protocol its end carries back to the parent, and the path it
/// reads.
pub module Cancel :> *{
  type Join = !String. end,
  notes : String
} where
  /// The path a task reads.
  def notes = "notes";
