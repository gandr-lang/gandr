//! `resumed` gives a cancellation that resumes a task continuation.
//!
//! The exit clause resumes the rest of its scope once. The resumed continuation
//! reads the task end exactly once. The resumed continuation closes the task
//! end exactly once.
//!
//! The handler starts a task. The task sends its note. The task closes. The
//! exit operation resumes the continuation before a receive.
//!
//! - see: #1334 — `resumed`
// The import gives the task protocol.
import "./cancel-base.gandr";
// The import gives the early-exit host interface.
import std.process;

/// A scope resumes at its exit while its task's end stays open.
@[ runs("*{}") ]
def resumed() -> Unit =
  handle c : std.process.Exit.Eff {
    let found = fork (task : Cancel.Join) {
      send task Cancel.notes;
      close task
    };
    c.exit 1;
    let text = recv found;
    close found
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => k *{}
  }
