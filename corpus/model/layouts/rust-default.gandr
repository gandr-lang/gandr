// Rust's default layout as a program over codes. A type's code lists its
// fields' scalars (structs) or its variants' fields (enums), and the program
// places them as rustc places a `repr(Rust)` type: `univariant` sorts a
// struct's fields by alignment, largest first, its niche toward the start and,
// when that leaves the niche nearer the middle, toward the end; `enumLayout`
// builds the niche-filled and the tagged layouts and keeps the smaller, then
// the one with the larger niche, then the tagged one, a tag widened to the
// smallest first-field alignment (`compiler/rustc_abi/src/layout.rs`:
// `univariant`, `univariant_biased`, `layout_of_enum`). rustc is the
// authority on a Rust type's layout, and the program is checked against it:
// each layout below is what `rustc -Zprint-type-sizes` printed for the type
// (nightly 1.98.0, f28ac764c, 2026-06-23, x86_64-unknown-linux-gnu), and each
// `runs` re-checks it offline.
//
// | type | size | align | fields in memory order |
// | --- | --- | --- | --- |
// | `struct Mixed { a: u8, b: u32, c: u16 }` | 8 | 4 | `b` 0, `c` 4, `a` 6 |
// | `struct Wide { a: u8, b: u64, c: u8 }` | 16 | 8 | `b` 0, `a` 8, `c` 9 |
// | `struct Small { x: u16, y: u8 }` | 4 | 2 | `x` 0, `y` 2 |
// | `struct Flagged { a: u8, b: bool, c: u16 }` | 4 | 2 | `c` 0, `a` 2, `b` 3 |
// | `enum MaybeRef { Some(&u32), None }` | 8 | 8 | niche at 0; `Some.0` 0 |
// | `enum MaybeFlag { Set(bool), Unset }` | 1 | 1 | niche at 0; `Set.0` 0 |
// | `enum Either { Left(u32), Right(u16) }` | 8 | 4 | 2-byte tag; `Left.0` 4, `Right.0` 2 |
// | `enum Jagged { Full(u32, bool), Thin(u8) }` | 8 | 4 | 1-byte tag; `Full.1` 1, `Full.0` 4, `Thin.0` 1 |
// | `enum ThreeRef { First, Held(&u32), Last }` | 16 | 8 | 8-byte tag; `Held.0` 8 |
// | `enum ThreeFlag { First, Held(bool), Last }` | 1 | 1 | niche at 0; `Held.0` 0 |
//
// Not yet: a field that is itself an aggregate, an array or a zero-sized
// type, whose alignment group rustc derives from its size, waits for the
// program to run over levitated codes (#2343); a niche beyond `bool`'s and a
// reference's (`char`, `NonZero`, an enum's own) needs a theory of the
// target; `repr` attributes and targets other than x86-64 are not modelled.

/// A field's scalar type, its size its alignment on x86-64.
pub data Scalar : Type {
  /// `u8`.
  U8 : Scalar;
  /// `u16`.
  U16 : Scalar;
  /// `u32`.
  U32 : Scalar;
  /// `u64`.
  U64 : Scalar;
  /// `bool`, whose 254 values past `true` are invalid.
  Flag : Scalar;
  /// `&T`, whose null is invalid.
  Ref : Scalar;
}

/// A struct's fields in declaration order.
pub data Fields : Type {
  /// No more fields.
  Done : Fields;
  /// A named field, then the rest.
  Field : (name : String, ty : Scalar, rest : Fields) --> Fields;
}

/// An enum's variants in declaration order.
pub data Variants : Type {
  /// No more variants.
  NoVariant : Variants;
  /// A named variant with its fields, then the rest.
  Variant : (name : String, fields : Fields, rest : Variants) --> Variants;
}

/// Fields in memory order, each at its offset.
pub data Placed : Type {
  /// No more fields.
  End : Placed;
  /// A field at an offset, then the rest.
  At : (name : String, offset : Integer, rest : Placed) --> Placed;
}

/// A struct's layout as rustc prints it.
pub data Layout : Type {
  /// Size, alignment and the fields placed.
  Layout : (size : Integer, align : Integer, fields : Placed) --> Layout;
}

/// Where an enum keeps which variant it holds.
pub data Discriminant : Type {
  /// In the invalid values of the field at an offset.
  InNiche : (offset : Integer) --> Discriminant;
  /// In a tag of a size at offset zero.
  Tag : (size : Integer) --> Discriminant;
}

/// Each variant's fields placed, in declaration order.
pub data Arms : Type {
  /// No more variants.
  NoArm : Arms;
  /// A variant's fields placed, then the rest.
  Arm : (name : String, fields : Placed, rest : Arms) --> Arms;
}

/// An enum's layout as rustc prints it.
pub data EnumLayout : Type {
  /// Size, alignment, the discriminant and each variant's fields.
  EnumLayout : (
    size : Integer,
    align : Integer,
    discriminant : Discriminant,
    arms : Arms
  ) --> EnumLayout;
}

/// A layout's largest niche.
data Niche : Type {
  /// No field has invalid values.
  NoNiche : Niche;
  /// The field at an offset, its width, and how many invalid values it has.
  NicheAt : (offset : Integer, width : Integer, available : Integer) --> Niche;
}

/// A layout with its largest niche.
data Laid : Type {
  /// Size, alignment, the fields placed and the largest niche.
  Laid : (size : Integer, align : Integer, fields : Placed, niche : Niche) --> Laid;
}

/// Which end of its alignment group a struct's niche is sorted to.
data Bias : Type {
  /// Larger niches first.
  NicheFirst : Bias;
  /// Larger niches last.
  NicheLast : Bias;
}

/// How fields are ordered.
data Order : Type {
  /// A struct's: larger alignment first, then the niche toward the bias.
  InStruct : (bias : Bias) --> Order;
  /// A tagged variant's: smaller alignment first, then smaller niche.
  AfterTag : Order;
}

/// Each variant laid out.
data Laids : Type {
  /// No more variants.
  NoLaid : Laids;
  /// A variant's layout, then the rest.
  OneLaid : (name : String, laid : Laid, rest : Laids) --> Laids;
}

/// A layout with how many invalid values it leaves, or none.
data Filled : Type {
  /// No such layout.
  NoFill : Filled;
  /// The layout and its remaining niche.
  Filled : (layout : EnumLayout, remaining : Integer) --> Filled;
}

/// Variants placed around a niche, or a variant that does not fit.
data Fitted : Type {
  /// A variant fits neither before nor after the niche.
  Misfit : Fitted;
  /// Every variant placed.
  Fitted : (arms : Arms) --> Fitted;
}

/// A scalar's size, which is its alignment.
def bytes(s : Scalar) -> Integer {
  case s {
    U8 => 1,
    U16 => 2,
    U32 => 4,
    U64 => 8,
    Flag => 1,
    Ref => 8
  }
}

/// How many invalid values a scalar has.
def niche(s : Scalar) -> Integer {
  case s {
    U8 => 0,
    U16 => 0,
    U32 => 0,
    U64 => 0,
    Flag => 254,
    Ref => 1
  }
}

/// The larger of two integers.
def bigger(a : Integer, b : Integer) -> Integer {
  case a >= b {
    true => a,
    false => b
  }
}

/// The smaller of two integers.
def smaller(a : Integer, b : Integer) -> Integer {
  case a >= b {
    true => b,
    false => a
  }
}

/// Whether two integers are equal.
def same(a : Integer, b : Integer) -> Bool {
  case a >= b {
    true => b >= a,
    false => false
  }
}

/// One of two integers, by a condition.
def pick(c : Bool, yes : Integer, no : Integer) -> Integer {
  case c {
    true => yes,
    false => no
  }
}

/// An offset rounded up to an alignment.
def up(o : Integer, a : Integer) -> Integer {
  run q <- int.div(o + a - 1, a);
  q * a
}

/// Whether `a` is placed no later than `b` under an order.
def before(o : Order, a : Scalar, b : Scalar) -> Bool {
  run x <- bytes(a);
  run y <- bytes(b);
  run m <- niche(a);
  run n <- niche(b);
  case o {
    InStruct(bias) => case x >= y {
      false => false,
      true => case y >= x {
        false => true,
        true => case bias {
          NicheFirst => m >= n,
          NicheLast => n >= m
        }
      }
    },
    AfterTag => case y >= x {
      false => false,
      true => case x >= y {
        false => true,
        true => n >= m
      }
    }
  }
}

/// A field inserted into fields already in memory order, after every field it does not go before.
def rec insert(sorted : Fields, o : Order, n : String, s : Scalar) -> Fields {
  case sorted {
    Done => Field(n, s, Done),
    Field(m, t, rest) => {
      run first <- before(o, s, t);
      case first {
        true => Field(n, s, Field(m, t, rest)),
        false => Field(m, t, insert[<](rest, o, n, s))
      }
    }
  }
}

/// Fields in memory order, by a stable insertion sort, as rustc's `sort_by_key` is stable.
def rec order(fs : Fields, o : Order) -> Fields {
  case fs {
    Done => Done,
    Field(n, s, rest) => insert(order[<](rest, o), o, n, s)
  }
}

/// How many fields there are.
def rec count(fs : Fields) -> Integer {
  case fs {
    Done => 0,
    Field(n, s, rest) => {
      run c <- count[<](rest);
      c + 1
    }
  }
}

/// Fields placed from an offset, each rounded up to its alignment.
def rec placeFrom(fs : Fields, o : Integer) -> Placed {
  case fs {
    Done => End,
    Field(n, s, rest) => {
      run b <- bytes(s);
      run off <- up(o, b);
      At(n, off, placeFrom[<](rest, off + b))
    }
  }
}

/// Where the last field ends, placed from an offset.
def rec endFrom(fs : Fields, o : Integer) -> Integer {
  case fs {
    Done => o,
    Field(n, s, rest) => {
      run b <- bytes(s);
      run off <- up(o, b);
      endFrom[<](rest, off + b)
    }
  }
}

/// The largest alignment, one when there is none.
def rec widest(fs : Fields) -> Integer {
  case fs {
    Done => 1,
    Field(n, s, rest) => bigger(bytes(s), widest[<](rest))
  }
}

/// How many invalid values a niche has, none for no niche.
def room(n : Niche) -> Integer {
  case n {
    NoNiche => 0,
    NicheAt(off, width, available) => available
  }
}

/// The largest niche of fields placed from an offset, the first in memory order among equals.
def rec nicheFrom(fs : Fields, o : Integer, best : Niche) -> Niche {
  case fs {
    Done => best,
    Field(n, s, rest) => {
      run b <- bytes(s);
      run off <- up(o, b);
      run v <- niche(s);
      run held <- room(best);
      case held >= v {
        true => nicheFrom[<](rest, off + b, best),
        false => nicheFrom[<](rest, off + b, NicheAt(off, b, v))
      }
    }
  }
}

/// Fields in memory order laid out after a prefix of a size and an alignment.
def laidOut(sorted : Fields, prefix : Integer, prefixAlign : Integer) -> Laid {
  run w <- widest(sorted);
  run a <- bigger(w, prefixAlign);
  run e <- endFrom(sorted, prefix);
  Laid(up(e, a), a, placeFrom(sorted, prefix), nicheFrom(sorted, prefix, NoNiche))
}

/// A struct's fields laid out under a bias, as `univariant_biased` lays them out.
def biased(fs : Fields, bias : Bias) -> Laid {
  laidOut(order(fs, InStruct(bias)), 0, 1)
}

/// The niche's offset in a layout, zero for no niche.
def nicheOffset(l : Laid) -> Integer {
  case l {
    Laid(size, a, placed, n) => case n {
      NoNiche => 0,
      NicheAt(off, width, available) => off
    }
  }
}

/// A struct's layout, as `univariant` chooses it: niches first, unless niches last puts the niche further from both edges' padding.
def univariant(fs : Fields) -> Laid {
  run first <- biased(fs, NicheFirst);
  run c <- count(fs);
  case first {
    Laid(size, a, placed, n) => case n {
      NoNiche => first,
      NicheAt(head, width, available) => case c >= 2 {
        false => first,
        true => case head >= 1 {
          false => first,
          true => case size - head - width >= 1 {
            false => first,
            true => {
              run alt <- biased(fs, NicheLast);
              run altHead <- nicheOffset(alt);
              case altHead >= head + 1 {
                false => first,
                true => case altHead >= size - head - width + 1 {
                  false => first,
                  true => alt
                }
              }
            }
          }
        }
      }
    }
  }
}

/// A struct's layout: rustc's for a `repr(Rust)` struct of these fields.
pub def structLayout(fs : Fields) -> Layout {
  run l <- univariant(fs);
  case l {
    Laid(size, a, placed, n) => Layout(size, a, placed)
  }
}

/// Each variant laid out as a struct.
def rec asStructs(vs : Variants) -> Laids {
  case vs {
    NoVariant => NoLaid,
    Variant(n, fs, rest) => OneLaid(n, univariant(fs), asStructs[<](rest))
  }
}

/// Each variant laid out after a one-byte tag.
def rec afterTag(vs : Variants) -> Laids {
  case vs {
    NoVariant => NoLaid,
    Variant(n, fs, rest) => {
      run sorted <- order(fs, AfterTag);
      OneLaid(n, laidOut(sorted, 1, 1), afterTag[<](rest))
    }
  }
}

/// How many variants there are.
def rec variantCount(ls : Laids) -> Integer {
  case ls {
    NoLaid => 0,
    OneLaid(n, l, rest) => {
      run c <- variantCount[<](rest);
      c + 1
    }
  }
}

/// The largest alignment of the variants, one when there is none.
def rec widestOf(ls : Laids) -> Integer {
  case ls {
    NoLaid => 1,
    OneLaid(n, l, rest) => {
      run w <- widestOf[<](rest);
      case l {
        Laid(size, a, placed, nn) => bigger(a, w)
      }
    }
  }
}

/// The largest size of the variants, zero when there is none.
def rec largestSize(ls : Laids) -> Integer {
  case ls {
    NoLaid => 0,
    OneLaid(n, l, rest) => {
      run w <- largestSize[<](rest);
      case l {
        Laid(size, a, placed, nn) => bigger(size, w)
      }
    }
  }
}

/// The index of the last largest variant, counting from `i`, as `max_by_key` keeps the last.
def rec largestFrom(ls : Laids, i : Integer, bestIndex : Integer, bestSize : Integer) -> Integer {
  case ls {
    NoLaid => bestIndex,
    OneLaid(n, l, rest) => case l {
      Laid(size, a, placed, nn) => case size >= bestSize {
        true => largestFrom[<](rest, i + 1, i, size),
        false => largestFrom[<](rest, i + 1, bestIndex, bestSize)
      }
    }
  }
}

/// The variant at an index, counting from `i`; an empty layout past the end.
def rec laidAt(ls : Laids, i : Integer, want : Integer) -> Laid {
  case ls {
    NoLaid => Laid(0, 1, End, NoNiche),
    OneLaid(n, l, rest) => {
      run found <- same(i, want);
      case found {
        true => l,
        false => laidAt[<](rest, i + 1, want)
      }
    }
  }
}

/// Fields moved by an offset.
def rec shifted(p : Placed, by : Integer) -> Placed {
  case p {
    End => End,
    At(n, off, rest) => {
      run tail <- shifted[<](rest, by);
      At(n, off + by, tail)
    }
  }
}

/// Every variant but the largest placed before the niche or after it.
def rec around(
  ls : Laids,
  i : Integer,
  largest : Integer,
  off : Integer,
  width : Integer,
  size : Integer
) -> Fitted {
  case ls {
    NoLaid => Fitted(NoArm),
    OneLaid(n, l, rest) => {
      run tail <- around[<](rest, i + 1, largest, off, width, size);
      run isLargest <- same(i, largest);
      case tail {
        Misfit => Misfit,
        Fitted(arms) => case l {
          Laid(s, a, placed, nn) => case isLargest {
            true => Fitted(Arm(n, placed, arms)),
            false => case off >= s {
              true => Fitted(Arm(n, placed, arms)),
              false => {
                run after <- up(off + width, a);
                case size >= after + s {
                  true => Fitted(Arm(n, shifted(placed, after), arms)),
                  false => Misfit
                }
              }
            }
          }
        }
      }
    }
  }
}

/// The niche-filled layout: the largest variant's niche holds which of the variants around it is there.
def nicheFilled(ls : Laids) -> Filled {
  run n <- variantCount(ls);
  case n >= 2 {
    false => NoFill,
    true => {
      run big <- largestFrom(ls, 0, 0, 0 - 1);
      run l <- laidAt(ls, 0, big);
      run a <- widestOf(ls);
      run atStart <- same(big, 0);
      run atLast <- same(big, n - 1);
      run firstNeed <- pick(atStart, 1, 0);
      run lastNeed <- pick(atLast, n - 2, n - 1);
      run needed <- lastNeed - firstNeed + 1;
      case l {
        Laid(s, la, placed, nn) => case nn {
          NoNiche => NoFill,
          NicheAt(off, width, available) => case available >= needed {
            false => NoFill,
            true => {
              run size <- up(s, a);
              run fitted <- around(ls, 0, big, off, width, size);
              case fitted {
                Misfit => NoFill,
                Fitted(arms) => Filled(EnumLayout(size, a, InNiche(off), arms), available - needed)
              }
            }
          }
        }
      }
    }
  }
}

/// The smallest alignment of a variant's first field after the tag, 256 when no variant has a field.
def rec firstAlign(ls : Laids) -> Integer {
  case ls {
    NoLaid => 256,
    OneLaid(n, l, rest) => {
      run r <- firstAlign[<](rest);
      case l {
        Laid(size, a, placed, nn) => case placed {
          End => r,
          At(m, off, t) => smaller(a, r)
        }
      }
    }
  }
}

/// The variants' fields placed.
def rec armsOf(ls : Laids) -> Arms {
  case ls {
    NoLaid => NoArm,
    OneLaid(n, l, rest) => {
      run t <- armsOf[<](rest);
      case l {
        Laid(size, a, placed, nn) => Arm(n, placed, t)
      }
    }
  }
}

/// How many values a tag of a size holds.
def tagRange(t : Integer) -> Integer {
  case t >= 8 {
    true => 18446744073709551616,
    false => case t >= 4 {
      true => 4294967296,
      false => case t >= 2 {
        true => 65536,
        false => 256
      }
    }
  }
}

/// The tagged layout, its tag widened to the smallest first-field alignment.
def taggedFill(vs : Variants) -> Filled {
  run ls <- afterTag(vs);
  run n <- variantCount(ls);
  run a <- widestOf(ls);
  run s <- largestSize(ls);
  run size <- up(s, a);
  run start <- firstAlign(ls);
  run fits <- 8 >= start;
  run tag <- pick(fits, start, 1);
  run arms <- armsOf(ls);
  run range <- tagRange(tag);
  Filled(EnumLayout(size, a, Tag(tag), arms), range - n)
}

/// An enum's size.
def enumSize(l : EnumLayout) -> Integer {
  case l {
    EnumLayout(size, a, d, arms) => size
  }
}

/// An enum's layout: rustc's for a `repr(Rust)` enum of these variants.
pub def enumLayout(vs : Variants) -> EnumLayout {
  run ls <- asStructs(vs);
  run nl <- nicheFilled(ls);
  run tl <- taggedFill(vs);
  case tl {
    NoFill => EnumLayout(0, 1, Tag(0), NoArm),
    Filled(tlay, tniche) => case nl {
      NoFill => tlay,
      Filled(nlay, nniche) => {
        run ts <- enumSize(tlay);
        run ns <- enumSize(nlay);
        case ts >= ns + 1 {
          true => nlay,
          false => case ns >= ts + 1 {
            true => tlay,
            false => case nniche >= tniche + 1 {
              true => nlay,
              false => tlay
            }
          }
        }
      }
    }
  }
}

/// `struct Mixed { a: u8, b: u32, c: u16 }`.
pub def mixed : Fields = Field("a", U8, Field("b", U32, Field("c", U16, Done)));

/// Mixed's fields by alignment, largest first: rustc prints `b`, `c`, `a` in 8 bytes.
@[ runs("Layout(8, 4, At(\"b\", 0, At(\"c\", 4, At(\"a\", 6, End))))") ]
def mixedLayout() -> Layout { structLayout(mixed) }

/// Wide's two bytes share the eight after `b`: rustc prints `b`, `a`, `c` in 16 bytes.
@[ runs("Layout(16, 8, At(\"b\", 0, At(\"a\", 8, At(\"c\", 9, End))))") ]
def wideLayout() -> Layout { structLayout(Field("a", U8, Field("b", U64, Field("c", U8, Done)))) }

/// Small keeps its order: rustc prints `x`, `y` in 4 bytes.
@[ runs("Layout(4, 2, At(\"x\", 0, At(\"y\", 2, End)))") ]
def smallLayout() -> Layout { structLayout(Field("x", U16, Field("y", U8, Done))) }

/// Flagged's `bool` goes last, its niche at the end, not in the middle: rustc prints `c`, `a`, `b` in 4 bytes.
@[ runs("Layout(4, 2, At(\"c\", 0, At(\"a\", 2, At(\"b\", 3, End))))") ]
def flaggedLayout() -> Layout {
  structLayout(Field("a", U8, Field("b", Flag, Field("c", U16, Done))))
}

/// MaybeRef's `None` is the reference's null: rustc prints 8 bytes, no discriminant.
@[ runs("EnumLayout(8, 8, InNiche(0), Arm(\"Some\", At(\"0\", 0, End), Arm(\"None\", End, NoArm)))") ]
def maybeRefLayout() -> EnumLayout {
  enumLayout(Variant("Some", Field("0", Ref, Done), Variant("None", Done, NoVariant)))
}

/// MaybeFlag's `Unset` is a value no `bool` takes: rustc prints 1 byte.
@[ runs("EnumLayout(1, 1, InNiche(0), Arm(\"Set\", At(\"0\", 0, End), Arm(\"Unset\", End, NoArm)))") ]
def maybeFlagLayout() -> EnumLayout {
  enumLayout(Variant("Set", Field("0", Flag, Done), Variant("Unset", Done, NoVariant)))
}

/// Either has no niche, and its tag widens to `Right`'s alignment: rustc prints a 2-byte discriminant.
@[ runs("EnumLayout(8, 4, Tag(2), Arm(\"Left\", At(\"0\", 4, End), Arm(\"Right\", At(\"0\", 2, End), NoArm)))") ]
def eitherLayout() -> EnumLayout {
  enumLayout(Variant(
    "Left",
    Field("0", U32, Done),
    Variant("Right", Field("0", U16, Done), NoVariant)
  ))
}

/// Jagged fits `Thin` before `Full`'s niche in 8 bytes, as tagged does, and the tag's larger niche keeps it tagged: rustc prints a 1-byte discriminant.
@[ runs("EnumLayout(8, 4, Tag(1), Arm(\"Full\", At(\"1\", 1, At(\"0\", 4, End)), Arm(\"Thin\", At(\"0\", 1, End), NoArm)))") ]
def jaggedLayout() -> EnumLayout {
  enumLayout(Variant(
    "Full",
    Field("0", U32, Field("1", Flag, Done)),
    Variant("Thin", Field("0", U8, Done), NoVariant)
  ))
}

/// ThreeRef's reference has one invalid value for the three it would need, so it is tagged, the tag widened to 8: rustc prints 16 bytes.
@[ runs("EnumLayout(16, 8, Tag(8), Arm(\"First\", End, Arm(\"Held\", At(\"0\", 8, End), Arm(\"Last\", End, NoArm))))") ]
def threeRefLayout() -> EnumLayout {
  enumLayout(Variant(
    "First",
    Done,
    Variant("Held", Field("0", Ref, Done), Variant("Last", Done, NoVariant))
  ))
}

/// ThreeFlag's `bool` has room for all three: rustc prints 1 byte.
@[ runs("EnumLayout(1, 1, InNiche(0), Arm(\"First\", End, Arm(\"Held\", At(\"0\", 0, End), Arm(\"Last\", End, NoArm))))") ]
def threeFlagLayout() -> EnumLayout {
  enumLayout(Variant(
    "First",
    Done,
    Variant("Held", Field("0", Flag, Done), Variant("Last", Done, NoVariant))
  ))
}
