// Rust's default layout, as `std.layout` computes it, checked against rustc on
// eleven types.
//
// rustc is the authority on a Rust type's layout. The foreign boundary admits
// an extern by the layouts the program computes, so the program agrees with
// rustc wherever it answers.
//
// Each layout below is what `rustc -Zprint-type-sizes` printed for the type,
// and each `runs` re-checks it offline. The table after this head lists the
// eleven types. A field that is itself an aggregate has no code yet, and its twin
// is refused.
//
// - see: #2343 — not implemented: a field that is itself an aggregate, an
//   array or a zero-sized type, over levitated codes
// - see: `library/std/src/layout.gandr` — the program
// - see: `pathological/layouts/rust-default.gandr` — a struct field, refused

// rustc 1.98.0-nightly (f28ac764c 2026-06-23) for x86_64-unknown-linux-gnu:
//
// | type | size | align | fields in memory order |
// | --- | --- | --- | --- |
// | `struct Mixed { a: u8, b: u32, c: u16 }` | 8 | 4 | `b` 0, `c` 4, `a` 6 |
// | `struct Wide { a: u8, b: u64, c: u8 }` | 16 | 8 | `b` 0, `a` 8, `c` 9 |
// | `struct Small { x: u16, y: u8 }` | 4 | 2 | `x` 0, `y` 2 |
// | `struct Flagged { a: u8, b: bool, c: u16 }` | 4 | 2 | `c` 0, `a` 2, `b` 3 |
// | `struct Signed { a: i32, b: i64, c: u8 }` | 16 | 8 | `b` 0, `a` 8, `c` 12 |
// | `enum MaybeRef { Some(&u32), None }` | 8 | 8 | niche at 0; `Some.0` 0 |
// | `enum MaybeFlag { Set(bool), Unset }` | 1 | 1 | niche at 0; `Set.0` 0 |
// | `enum Either { Left(u32), Right(u16) }` | 8 | 4 | 2-byte tag; `Left.0` 4, `Right.0` 2 |
// | `enum Jagged { Full(u32, bool), Thin(u8) }` | 8 | 4 | 1-byte tag; `Full.1` 1, `Full.0` 4, `Thin.0` 1 |
// | `enum ThreeRef { First, Held(&u32), Last }` | 16 | 8 | 8-byte tag; `Held.0` 8 |
// | `enum ThreeFlag { First, Held(bool), Last }` | 1 | 1 | niche at 0; `Held.0` 0 |

// `Field`, `Done`, `Variant`, `NoVariant`, the scalars, `structLayout` and
// `enumLayout`.
import "../../../library/std/src/layout.gandr";

/// `struct Mixed { a: u8, b: u32, c: u16 }`.
pub def mixed : Fields = Field("a", U8, Field("b", U32, Field("c", U16, Done)));

/// Mixed's fields by alignment, largest first: rustc prints `b`, `c`, `a` in 8 bytes.
@[ runs("Layout(8, 4, At(\"b\", 0, At(\"c\", 4, At(\"a\", 6, End))))") ]
def mixedLayout() -> Layout { structLayout(mixed) }

/// Wide's two bytes share the eight after `b`: rustc prints `b`, `a`, `c` in 16 bytes.
@[ runs("Layout(16, 8, At(\"b\", 0, At(\"a\", 8, At(\"c\", 9, End))))") ]
def wideLayout() -> Layout { structLayout(Field("a", U8, Field("b", U64, Field("c", U8, Done)))) }

/// Small keeps its order: rustc prints `x`, `y` in 4 bytes.
@[ runs("Layout(4, 2, At(\"x\", 0, At(\"y\", 2, End)))") ]
def smallLayout() -> Layout { structLayout(Field("x", U16, Field("y", U8, Done))) }

/// Flagged's `bool` goes last, its niche at the end, not in the middle: rustc prints `c`, `a`, `b` in 4 bytes.
@[ runs("Layout(4, 2, At(\"c\", 0, At(\"a\", 2, At(\"b\", 3, End))))") ]
def flaggedLayout() -> Layout {
  structLayout(Field("a", U8, Field("b", Flag, Field("c", U16, Done))))
}

/// Signed's atoms take their unsigned widths: rustc prints `b`, `a`, `c` in 16 bytes.
@[ runs("Layout(16, 8, At(\"b\", 0, At(\"a\", 8, At(\"c\", 12, End))))") ]
def signedLayout() -> Layout {
  structLayout(Field("a", I32, Field("b", I64, Field("c", U8, Done))))
}

/// MaybeRef's `None` is the reference's null: rustc prints 8 bytes, no discriminant.
@[ runs("EnumLayout(8, 8, InNiche(0), Arm(\"Some\", At(\"0\", 0, End), Arm(\"None\", End, NoArm)))") ]
def maybeRefLayout() -> EnumLayout {
  enumLayout(Variant("Some", Field("0", Ref, Done), Variant("None", Done, NoVariant)))
}

/// MaybeFlag's `Unset` is a value no `bool` takes: rustc prints 1 byte.
@[ runs("EnumLayout(1, 1, InNiche(0), Arm(\"Set\", At(\"0\", 0, End), Arm(\"Unset\", End, NoArm)))") ]
def maybeFlagLayout() -> EnumLayout {
  enumLayout(Variant("Set", Field("0", Flag, Done), Variant("Unset", Done, NoVariant)))
}

/// Either has no niche, and its tag widens to `Right`'s alignment: rustc prints a 2-byte discriminant.
@[ runs("EnumLayout(8, 4, Tag(2), Arm(\"Left\", At(\"0\", 4, End), Arm(\"Right\", At(\"0\", 2, End), NoArm)))") ]
def eitherLayout() -> EnumLayout {
  enumLayout(Variant(
    "Left",
    Field("0", U32, Done),
    Variant("Right", Field("0", U16, Done), NoVariant)
  ))
}

/// Jagged fits `Thin` before `Full`'s niche in 8 bytes, as tagged does, and the tag's larger niche keeps it tagged: rustc prints a 1-byte discriminant.
@[ runs("EnumLayout(8, 4, Tag(1), Arm(\"Full\", At(\"1\", 1, At(\"0\", 4, End)), Arm(\"Thin\", At(\"0\", 1, End), NoArm)))") ]
def jaggedLayout() -> EnumLayout {
  enumLayout(Variant(
    "Full",
    Field("0", U32, Field("1", Flag, Done)),
    Variant("Thin", Field("0", U8, Done), NoVariant)
  ))
}

/// ThreeRef's reference has one invalid value for the three it would need, so it is tagged, the tag widened to 8: rustc prints 16 bytes.
@[ runs("EnumLayout(16, 8, Tag(8), Arm(\"First\", End, Arm(\"Held\", At(\"0\", 8, End), Arm(\"Last\", End, NoArm))))") ]
def threeRefLayout() -> EnumLayout {
  enumLayout(Variant(
    "First",
    Done,
    Variant("Held", Field("0", Ref, Done), Variant("Last", Done, NoVariant))
  ))
}

/// ThreeFlag's `bool` has room for all three: rustc prints 1 byte.
@[ runs("EnumLayout(1, 1, InNiche(0), Arm(\"First\", End, Arm(\"Held\", At(\"0\", 0, End), Arm(\"Last\", End, NoArm))))") ]
def threeFlagLayout() -> EnumLayout {
  enumLayout(Variant(
    "First",
    Done,
    Variant("Held", Field("0", Flag, Done), Variant("Last", Done, NoVariant))
  ))
}
