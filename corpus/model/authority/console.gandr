// A program handed the ambient authority, printing through the console it
// opens from it.
//
// Authority enters a program in one place, as `main`'s parameter, and never
// through a global. A Rust program on `cap-std` opens each handle from
// `ambient_authority()` the same way.
//
// `gandr run` hands `main` one capability that no handler introduced, so the
// host serves each print. `console` narrows it to `print` by subtyping, and
// `gandr run console.gandr` prints `hello, world!`.
//
// - see: `../../../library/std/src/authority.gandr` — `Authority` and
//   `console`
// - see: #2970 — the ambient authority `main` is given

// `Authority`, `console`.
import "../../../library/std/src/authority.gandr";

/// A greeting, printed through a capability that holds `print` alone.
pub def greet(console : Cap { print }) -> [Console] Unit {
  console.print("hello, world!")
}

/// The entry: it opens the console from its authority and greets.
def main(authority : Authority) -> [Console] Unit {
  greet(console(authority))
}
