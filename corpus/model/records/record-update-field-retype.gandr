// A record update may give a field a value of another type: the new record's
// type states the new one.

/// A cell with an integer count.
@[ checks ]
def cell = #{ count = 3, label = "start" };

/// `cell` with a string count, the retyped record stated.
@[ checks ]
def named : #{count : String, label : String} ;
def named = #{ cell | count = "three" } ;

/// The run target gives `count` a string: the record's `count` is the
/// string now.
@[ runs("#{.count = \"three\", .label = \"start\"}") ]
#{ cell | count = "three" }
