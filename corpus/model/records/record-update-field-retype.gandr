// This source tests record updates that change a field type.
//
// The update gives `count` a string value. The pathological twin refuses the
// stale integer record type.
//
// The stated result types check the new record type.
//
// - see: `pathological/records/record-update-stale-type.gandr` — `stale`

/// `cell` holds an integer count and a label.
def cell = *{count = 3, label = "start"};

/// `named` changes `cell.count` to a string.
def named : *{count : String, label : String} = *{cell | count = "three"};

/// `recounted` returns `cell` with a string count.
@[runs("*{.count = \"three\", .label = \"start\"}")]
def recounted() -> *{count : String, label : String} { *{cell | count = "three"} }
