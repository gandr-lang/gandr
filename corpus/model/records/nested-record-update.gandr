// A nested record is updated by updating the inner record and putting it back
// at its field.

/// A record holding a record.
@[ checks ]
def outer = #{ tag = "t", inner = #{ x = 1, y = 2 } };

/// The run target updates `inner.y`: the inner record updated, then put
/// back at `inner`. The base `outer.inner` is a projection, which the
/// lowering admits no expression of yet (#1106).
@[ refuses("OutOfFragment.projection_expression") ]
#{ outer | inner = #{ outer.inner | y = 9 } }
