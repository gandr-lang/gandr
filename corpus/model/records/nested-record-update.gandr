// A nested record is updated by updating the inner record and putting it back
// at its field.

/// A record holding a record.
def outer = #{tag = "t", inner = #{x = 1, y = 2}};

/// `inner.y` updated: the inner record, read off `outer` by its field,
/// updated, then put back at `inner`.
@[ runs("#{.inner = #{.x = 1, .y = 9}, .tag = \"t\"}") ]
def updated() -> #{tag : String, inner : #{x : Integer, y : Integer}} {
  #{outer | inner = #{outer.inner | y = 9}}
}
