// A record literal, a field inserted by the `record` namespace, and a field
// read back by name.

/// A record of two fields.
@[ checks ]
def base = #{name = "gandr", stars = 1};

/// The record with a third field inserted, reached by projection from the
/// `record` namespace, which the lowering admits for no builtin yet (#1106).
@[ refuses("OutOfFragment.projection_expression") ]
def extended = record.insert(base, "kind", "language");

/// The run target reads the inserted field back, through the `record`
/// namespace's projection (#1106).
@[ refuses("OutOfFragment.projection_expression") ]
record.get(extended, "kind")
