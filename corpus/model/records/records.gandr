// This source tests `record` namespace operations.
//
// The namespace inserts a field and reads it back by name.
//
// The lowering refuses `record` namespace projection.
//
// - see: #1106 — `extended`, `kind`

/// `base` holds a name and a star count.
def base = *{name = "gandr", stars = 1};

/// `extended` inserts `kind` into `base`.
@[ refuses("OutOfFragment.projection_expression") ]
def extended = record.insert base "kind" "language";

/// `kind` reads the inserted field from `extended`.
@[ refuses("OutOfFragment.projection_expression") ]
def kind = record.get extended "kind";
