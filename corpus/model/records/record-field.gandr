// This source tests native record field selection.
//
// Field selection reads fields from inferred and stated records. The
// pathological twin refuses an absent field and a nonrecord base.
//
// The evaluator selects fields in a body, binding and path endpoint.
//
// - see: `pathological/records/record-field-absent.gandr` — `lacking`, `unfielded`

/// `nest` holds a tag and an inner record.
def nest = *{tag = "t", inner = *{x = 1, y = 2}};

/// `innerOf` returns `nest`'s inner record.
@[ runs("*{.x = 1, .y = 2}") ]
def innerOf() -> *{x : Integer, y : Integer} { nest.inner }

/// `deepField` returns `y` from `nest`'s inner record.
@[ runs("2") ]
def deepField() -> Integer { nest.inner.y }

/// `boundField` reads `x` from the bound inner record.
@[ runs("1") ]
def boundField() -> Integer =
  let held = nest.inner
  held.x

/// `rebuilt` equates `nest` with its fields rebuilt as a record.
def rebuilt() -> Path[.A = *{tag : String, inner : *{x : Integer, y : Integer}}](
  *{.tag = nest.tag, .inner = nest.inner},
  nest
) =
  Path.here nest
