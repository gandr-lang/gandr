// A record updated at one field: a new record, the other fields kept.

/// A point of two fields.
@[ checks ]
def point = #{ x = 1, y = 2 };

/// The run target updates `x`; the lowering admits no record update yet
/// (#1110).
@[ refuses("OutOfFragment.record_update_expression") ]
#{ point | x = 9 }
