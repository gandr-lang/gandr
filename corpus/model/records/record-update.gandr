// This source tests a record update at one field.
//
// The update creates a new record and keeps its other fields.
//
// The run expectation checks the updated point.
//
// - see: `pathological/records/wide-record-update.gandr` — `updated`

/// `point` holds fields `x` and `y`.
def point = *{x = 1, y = 2};

/// `moved` changes `point.x` and keeps `point.y`.
@[ runs("*{.x = 9, .y = 2}") ]
def moved() -> *{x : Integer, y : Integer} { *{point | x = 9} }
