// A record update at a field the record lacks extends it with that field.

/// A record of one field.
def single = #{a = 1};

/// `single` extended at `b`, the record type it gains stated.
def pair : #{a : Integer, b : Integer} = #{single | b = 2};

/// The run target adds `b`: the record gains the field.
@[ runs("#{.a = 1, .b = 2}") ]
#{single | b = 2}
