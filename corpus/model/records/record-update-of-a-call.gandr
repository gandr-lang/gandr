// This source tests a record update whose base is a call.
//
// The call returns a record before the update changes its field.
//
// The evaluator keeps the call result fields that the update does not change.
//
// - see: `pathological/records/record-update-non-record.gandr` — `updated`

/// `placed` returns a point at `n` across and two up.
def placed(n : Integer) -> *{x : Integer, y : Integer} { *{x = n, y = 2} }

/// `moved_call` changes `x` in the record that `placed` returns.
@[ runs("*{.x = 9, .y = 2}") ]
def moved_call() -> *{x : Integer, y : Integer} { *{placed 1 | x = 9} }
