//! This source asks for inferred forms and a selected formatter spelling.
//!
//! `explicit_exits` and `explicit_runs` report each inferred form. `form`
//! selects the sugared spelling.
//!
//! The checker writes each requested form under its declaration. The formatter
//! renders the selected source spelling.
//!
//! - see: https://doc.rust-lang.org/reference/

/// An answer whose exit is written, as `explicit_exits` asks.
@[ checks, explicit_exits ]
def exitWritten() -> Integer =
  return 42

/// The same answer, bound by a written run, as `explicit_runs` asks.
@[ checks, explicit_runs ]
def runWritten() -> Integer =
  let m = exitWritten ()
  m

/// A value laid out in the sugared form.
@[ checks, form(sugared) ]
def sugared = 42;
