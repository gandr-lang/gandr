// Doc comments and the `doc` attribute, after the intra-doc links of rustdoc.
// A `[name]` in either resolves to a declaration of the source. A `[label]`
// resolves to a footer line `[label]: target` at the end of its run. A link
// that resolves to neither is refused.
//
// - see: _The rustdoc book_, § Linking to items by name

/// Returns its argument; [echo] does the same.
def identity(x : Integer) -> Integer {
  x
}

// Documented by the attribute, linking back to `identity`.
@[ checks, doc("Returns its argument, as [identity] does.") ]
def echo(x : Integer) -> Integer {
  x
}

/// Returns its argument, as the [book] does for Rust.
///
/// [book]: https://doc.rust-lang.org/rustdoc/write-documentation/linking-to-items-by-name.html
def cited(x : Integer) -> Integer {
  x
}

/// Points at [missing], which nothing declares.
@[ refuses("UnresolvedDocLink") ]
def stale = 1;
