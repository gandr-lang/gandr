//! `doc-and-deprecated` documents declarations and marks them as deprecated.
//!
//! Each deprecated use reports its recorded version and note when they exist.
//! The declaration itself still checks.
//!
//! The checker records each attribute on its declaration. The `deprecated`
//! lint reports every use. The attribute follows `#[deprecated]` of Rust (The
//! Rust Reference, § Diagnostic attributes).
//!
//! - see: corpus/pathological/attributes/ill-typed-deprecation.gandr
//! - see: https://doc.rust-lang.org/reference/

// Squaring, documented by its attribute and marked deprecated.
@[doc("Squares its argument.")]
@[deprecated(*{since = "0.2", note = "use square_checked"})]
def square(x : Integer) -> Integer =
  x * x

// Two uses of it: the function checks, and each use is reported with the
// version and the note.
def fourth(x : Integer) -> Integer =
  square (square x)

// A value marked bare, stating neither the version nor the note.
@[deprecated]
def legacy = 1;

// A use of the bare-marked value: it checks, and the use is reported.
def current = legacy;

// A module whose member is marked.
module Shapes where {
  // The side, marked with a note alone.
  @[checks]
  @[deprecated(*{note = "use area"})]
  def side = 2;
}

// A use of the member through its dotted path: it checks, and the use is
// reported at the member's name with the note.
def edge = Shapes.side;
