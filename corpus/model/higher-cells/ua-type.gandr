// This source applies univalence at a user-universe stratum code.
//
// `ua[1, 4]` makes the magma degree telescope a path in `Type`. `univalence`
// relates that path to an equivalence. `idtoequiv` packages the path.
//
// Transport of the package along `ua` agrees pointwise with transport along
// the path. A path between these paths remains owed.
//
// - see: `ua-by-hand.gandr` — the magma degree telescope path
// - see: `../identity/univalence-transports.gandr` — transport of a packaged path
// - see: `pathological/identity/univalence-owed.gandr` — the owed path
// - owes: #520 — the path between the two paths

// The magma, the swap and the unit's identity.
import "./magma-base.gandr";
// Univalence over the user universe: `idtoequiv`, `univalence`.
import "../identity/univalence.gandr";

/// `AtStratum` records the magma degree telescope and its swap path.
pub module AtStratum where
  type Tel = Unit * (+{Unit} * Bool);

  /// `opposite` is the magma swap path at degree one.
  def opposite : Path[.A = Type](Tel, Tel) = ua[
    1,
    4
  ] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});

  /// `atTel` gives univalence at the stratum code.
  def atTel() -> Path[.A = Type](Tel, Tel) ≃ (Tel ≃ Tel) =
    univalence Tel Tel

  /// `swapped` packages the stratum path as an equivalence.
  def swapped() -> Tel ≃ Tel =
    idtoequiv Tel Tel opposite

  /// `repackaged` equates transport of the package with transport of its path.
  def repackaged : Path[.A = Tel -> Tel](
    fun (x) { fwdAlong Tel Tel (ua (idtoequiv Tel Tel opposite)) x },
    fun (x) { fwdAlong Tel Tel opposite x }
  ) = Path.here (fun (x) { fwdAlong Tel Tel opposite x });
