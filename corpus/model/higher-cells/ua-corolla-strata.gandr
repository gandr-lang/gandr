// Univalence at the certified strata of a signature: `ua[n, k]` derives a
// path between two models' degree telescopes up to degree `n` over shapes of
// at most `k` vertices, each stage over its matching object (Shulman,
// _Univalence for Inverse Diagrams and Homotopy Canonicity_,
// doi:10.1017/S0960129514000565). From degree two the Segal condition
// certifies the stages above the corollas; a degree, a bound or a table the
// stratum does not certify is refused by name, and so is a catalogue of more
// shape classes than the stratum budget.

// The magma, the swap, the identity on the booleans and the unit's identity.
import "./magma-base.gandr";

/// The magma to itself by the swap, at degree two.
def raised = ua[
  2,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// Transport along it swaps the binary corolla's boolean and carries the
/// degree-two unit stage.
def lifts : Path(
  Unit * (+{Unit} * (Bool * Unit)),
  transport(\X. X, raised, (unit, (+{.0 = unit}, (+{.0 = unit}, unit)))),
  (unit, (+{.0 = unit}, (+{.1 = unit}, unit)))
) = here((unit, (+{.0 = unit}, (+{.1 = unit}, unit))));

/// The magma to itself by the swap at bound six and degree six, a catalogue
/// of 223 shape classes.
def six = ua[
  6,
  6
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// A degree no shape of the catalogue reaches is not certified.
@[ refuses("UncertifiedDegree") ]
def above = ua[
  5,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// A catalogue of no vertices fails the corolla condition.
@[ refuses("UncertifiedCondition") ]
def empty = ua[
  1,
  0
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// A bound past the largest a catalogue builds at is refused.
@[ refuses("UncertifiedAllowance") ]
def wide = ua[
  1,
  65
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// Bound eight holds more shape classes than the stratum budget.
@[ refuses("UncertifiedBudget") ]
def crowded = ua[
  1,
  8
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// The binary generator's corolla is larger than a bound of three.
@[ refuses("PastTheBound") ]
def short = ua[
  1,
  3
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// The swap and the identity are no inverse pair.
@[ refuses("NotInverse") ]
def lopsided = ua[
  1,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = boolId, .one = keep});

/// A table missing a corolla the signature inhabits.
@[ refuses("CorollaTables") ]
def partial = ua[1, 4](Magma, Magma, #{.mul = exchange}, #{.mul = exchange, .one = keep});

/// A table naming a generator the signature does not have.
@[ refuses("UnknownGenerator") ]
def misspelt = ua[
  1,
  4
](Magma, Magma, #{.mul = exchange, .zero = keep}, #{.mul = exchange, .one = keep});

/// A signature that is not declared.
@[ refuses("UnresolvedName") ]
def unnamed = ua[
  1,
  4
](Monoid, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});
