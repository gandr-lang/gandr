// Univalence at the corollas of a magma's signature, written by hand and
// checked against the derived `ua[1, 4]`.
//
// The hand definition shows what `ua` builds: reflexivity at the unit for
// the empty shape, then one `equiv` per corolla, nested to the right. Its
// directed twin is the same shape for flows, one `forward` per corolla.
//
// The module states the hand path beside the derived one and checks that
// they convert. Transport and a ride along each move the binary corolla's
// boolean. A ride that would reverse the flow is refused.
//
// - see: `pathological/higher-cells/ua-by-hand-unnatural.gandr` — the
//   naturality `ua` checks beyond the hand definition
// - see: `ua-corolla-strata.gandr` — the Segal certification from degree two
// - see: Shulman, _Univalence for Inverse Diagrams and Homotopy Canonicity_,
//   doi:10.1017/S0960129514000565
// - see: Gratzer, Weinberger and Buchholtz, _Directed univalence in
//   simplicial homotopy type theory_, arXiv:2407.09146

// The magma, the swap and the unit's identity.
import "./magma-base.gandr";

/// `ua[1, 4]` and its directed twin, each derived and written by hand.
module ByHand {
  type Tel = Unit * (+{Unit} * Bool);

  /// The derived path, by the swap at the binary corolla.
  @[ checks ]
  def opposite = ua[
    1,
    4
  ](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

  /// The same path written by hand.
  @[ checks ]
  def opposite_by_hand : Path(Type, Tel, Tel) = pathProduct(
    here(Unit),
    pathProduct(equiv(keep, keep), equiv(exchange, exchange))
  );

  /// The derived and the hand path convert.
  @[ checks ]
  def same : Path(Path(Type, Tel, Tel), opposite, opposite_by_hand) = here(opposite);

  /// Transport along the hand path swaps the binary corolla's boolean.
  @[ checks ]
  def moves : Path(
    Tel,
    transport(\X. X, opposite_by_hand, (unit, (+{.0 = unit}, +{.0 = unit}))),
    (unit, (+{.0 = unit}, +{.1 = unit}))
  ) = here((unit, (+{.0 = unit}, +{.1 = unit})));

  /// Transport along either path gives the same telescope.
  @[ checks ]
  def alike : Path(
    Tel,
    transport(\X. X, opposite, (unit, (+{.0 = unit}, +{.0 = unit}))),
    transport(\X. X, opposite_by_hand, (unit, (+{.0 = unit}, +{.0 = unit})))
  ) = here((unit, (+{.0 = unit}, +{.1 = unit})));

  /// The directed twin written by hand.
  @[ checks ]
  def opposite_dir_by_hand : Flow(Type, Tel, Tel) = flowProduct(
    stay(Unit),
    flowProduct(forward(keep), forward(exchange))
  );

  /// A telescope ridden along the directed twin.
  @[ checks ]
  def forth(t : Tel) -> Tel {
    ride(\X. X, opposite_dir_by_hand, t)
  }

  /// A telescope ridden forward by a run.
  @[ runs("(unit, (+{.0 = unit}, +{.1 = unit}))") ]
  def ridden : () => Tel = forth((unit, (+{.0 = unit}, +{.0 = unit})));

  /// Riding moves the telescope as transport does.
  @[ checks ]
  def rides : Path(
    Tel,
    ride(\X. X, opposite_dir_by_hand, (unit, (+{.0 = unit}, +{.0 = unit}))),
    (unit, (+{.0 = unit}, +{.1 = unit}))
  ) = here((unit, (+{.0 = unit}, +{.1 = unit})));

  /// A ride that would reverse the flow reads it contravariantly, refused.
  @[ refuses("NonCovariantMotive") ]
  def reversed() -> Flow(Type, Tel, Tel) {
    ride(\X. Flow(Type, X, Tel), opposite_dir_by_hand, stay(Tel))
  }
}
