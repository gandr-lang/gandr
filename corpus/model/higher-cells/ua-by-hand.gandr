//! This source writes a magma corolla path by hand.
//!
//! `ua[1, 4]` derives a path over the magma's corollas. The hand path starts
//! with unit reflexivity and nests one `equiv` for each corolla. Its directed
//! twin has one `Flow.into` for each corolla.
//!
//! The module checks conversion between the hand and derived paths. Transport
//! and a ride move the binary corolla's boolean. A reverse ride is refused.
//!
//! - see: `pathological/higher-cells/ua-by-hand-unnatural.gandr` — the
//!   naturality `ua` checks beyond the hand definition
//! - see: `ua-corolla-strata.gandr` — the Segal certification from degree two
//! - cites: [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]
//! - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
//!
//! [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]: https://doi.org/10.1017/S0960129514000565 "Shulman, Univalence for Inverse Diagrams and Homotopy Canonicity"
//! [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

// This import supplies the magma and its translators.
import "./magma-base.gandr";

/// `ByHand` holds derived and hand-written corolla paths.
module ByHand where {
  type Tel = Unit * (+{Unit} * Bool);

  /// `opposite` derives the path from the binary corolla swap.
  @[checks]
  def opposite = ua[
    1,
    4
  ] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});

  /// `opposite_by_hand` writes the same path by hand.
  @[checks]
  def opposite_by_hand : Path[.A = Type](Tel, Tel) = Path.product
    (Path.here (Unit))
    (Path.product (equiv keep keep) (equiv exchange exchange));

  /// `same` proves that the derived and hand paths convert.
  @[checks]
  def same : Path[.A = Path[.A = Type](Tel, Tel)](opposite, opposite_by_hand) = Path.here opposite;

  /// `moves` transports the binary corolla boolean along the hand path.
  @[checks]
  def moves : Path[.A = Tel](
    Path.walk (fun (X) { X }) opposite_by_hand (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}}),
    *{*{}, *{+{.0 = *{}}, +{.1 = *{}}}}
  ) = Path.here (*{*{}, *{+{.0 = *{}}, +{.1 = *{}}}});

  /// `alike` gives the same telescope from either path.
  @[checks]
  def alike : Path[.A = Tel](
    Path.walk (fun (X) { X }) opposite (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}}),
    Path.walk (fun (X) { X }) opposite_by_hand (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}})
  ) = Path.here (*{*{}, *{+{.0 = *{}}, +{.1 = *{}}}});

  /// `opposite_dir_by_hand` writes the directed twin by hand.
  @[checks]
  def opposite_dir_by_hand : Flow[.A = Type](Tel, Tel) = Flow.product
    (Flow.stay (Unit))
    (Flow.product (Flow.into keep) (Flow.into exchange));

  /// `forth` rides a telescope along the directed twin.
  @[checks]
  def forth(t : Tel) -> Tel =
    Flow.ride (fun (X) { X }) opposite_dir_by_hand t

  /// `ridden` runs the forward ride on one telescope.
  @[runs("*{*{}, *{+{.0 = *{}}, +{.1 = *{}}}}")]
  def ridden : () -> Tel = forth (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}});

  /// `rides` equates a directed ride with the transport result.
  @[checks]
  def rides : Path[.A = Tel](
    Flow.ride (fun (X) { X }) opposite_dir_by_hand (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}}),
    *{*{}, *{+{.0 = *{}}, +{.1 = *{}}}}
  ) = Path.here (*{*{}, *{+{.0 = *{}}, +{.1 = *{}}}});

  /// `reversed` refuses a contravariant directed ride.
  @[refuses("NonCovariantMotive")]
  def reversed() -> Flow[.A = Type](Tel, Tel) =
    Flow.ride (fun (X) { type(Flow[.A = Type](X, Tel)) }) opposite_dir_by_hand (Flow.stay Tel)
}
