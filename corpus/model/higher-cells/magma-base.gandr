//! This source defines common declarations for higher cells.
//!
//! `Magma` has one sort, a binary operation and a constant. `ua[n, k]` reads
//! its binary and constant corollas one degree at a time.
//!
//! Other sources import `Magma` and its translators. `exchange` swaps
//! booleans, `boolId` preserves them and `keep` preserves the unit injection.
//!
//! - cites: [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]
//!
//! [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]: https://doi.org/10.1017/S0960129514000565 "Shulman, Univalence for Inverse Diagrams and Homotopy Canonicity"

/// `Magma` defines one sort, one binary operation and one constant.
pub theory Magma where
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);

/// `exchange` swaps booleans. It translates the binary corolla.
pub def exchange(b : Bool) -> Bool =
  match b where
    | true => +{.1 = *{}}
    | false => +{.0 = *{}}

/// `boolId` preserves booleans. It differs from `exchange` and `Flow.stay`.
pub def boolId(b : Bool) -> Bool =
  b

/// `keep` preserves the constant corolla's only element.
pub def keep(e : +{Unit}) -> +{Unit} =
  e
