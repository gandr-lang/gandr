//! Univalence at the corollas of a signature: `ua[1, 4](Magma, Magma, f, g)`
//! is a path between the two models' degree telescopes, derived corolla by
//! corolla from the translator tables `f` and `g`
//! [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]. A
//! univalence map acts as a typoid function [Petrakis-2022-univalent_typoids].
//! Transport along it applies each corolla's translator, and two tables that
//! agree at every element give the same path.
//!
//! - cites: [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]
//! - cites: [Petrakis-2022-univalent_typoids]
//!
//! [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]: https://doi.org/10.1017/S0960129514000565 "Shulman, Univalence for Inverse Diagrams and Homotopy Canonicity"
//! [Petrakis-2022-univalent_typoids]: https://arxiv.org/abs/2205.06651 "Petrakis, Univalent Typoids"

// The magma, the swap, the identity on the booleans and the unit's identity.
import "./magma-base.gandr";

/// The swap three times, which is the swap.
def flip(b : Bool) -> Bool {
  let c = exchange(b);
  exchange(exchange(c))
}

/// The magma to itself by the swap at the binary corolla.
def opposite = ua[
  1,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep});

/// Transport along it swaps the binary corolla's boolean.
def moves : Path(
  Unit * (+{Unit} * Bool),
  Path.walk(fun (X) { X }, opposite, (unit, (+{.0 = unit}, +{.0 = unit}))),
  (unit, (+{.0 = unit}, +{.1 = unit}))
) = Path.here((unit, (+{.0 = unit}, +{.1 = unit})));

/// It does not leave the boolean where it was.
@[ refuses("EndpointMismatch") ]
def stays : Path(
  Unit * (+{Unit} * Bool),
  Path.walk(fun (X) { X }, opposite, (unit, (+{.0 = unit}, +{.0 = unit}))),
  (unit, (+{.0 = unit}, +{.0 = unit}))
) = Path.here((unit, (+{.0 = unit}, +{.0 = unit})));

/// The magma to itself by the swap written three times.
def reopposite = ua[1, 4](Magma, Magma, #{.mul = flip, .one = keep}, #{.mul = flip, .one = keep});

/// The swap and the swap three times agree at every boolean.
def agree : Path(Bool => Bool, exchange, flip) = Path.funext(exchange, flip);

/// The swap and the identity do not.
@[ refuses("PointwiseDistinct") ]
def disagree : Path(Bool => Bool, exchange, boolId) = Path.funext(exchange, boolId);
