// Univalence at the corollas of a signature: `ua[1, 4](Magma, Magma, f, g)`
// is a path between the two models' degree telescopes, derived corolla by
// corolla from the translator tables `f` and `g` (Shulman, _Univalence for
// Inverse Diagrams and Homotopy Canonicity_, doi:10.1017/S0960129514000565;
// a univalence map as a typoid function, Petrakis, _Univalent Typoids_,
// arXiv:2205.06651). Transport along it applies each corolla's translator,
// and two tables that agree at every element give the same path.

// The magma, the swap, the identity on the booleans and the unit's identity.
import "./magma-base.gandr" ;

/// The swap three times, which is the swap.
@[ checks ]
def flip(b : Bool) -> -F Bool {
  run c <- exchange(b);
  become exchange(exchange(c))
}

/// The magma to itself by the swap at the binary corolla.
@[ checks ]
def opposite = ua[
  1,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep}) ;

/// Transport along it swaps the binary corolla's boolean.
@[ checks ]
def moves : Path(
  Unit * (+{Unit} * Bool),
  transport(\X. X, opposite, (unit, (+{.0 = unit}, +{.0 = unit}))),
  (unit, (+{.0 = unit}, +{.1 = unit}))
) = here((unit, (+{.0 = unit}, +{.1 = unit}))) ;

/// It does not leave the boolean where it was.
@[ refuses("EndpointMismatch") ]
def stays : Path(
  Unit * (+{Unit} * Bool),
  transport(\X. X, opposite, (unit, (+{.0 = unit}, +{.0 = unit}))),
  (unit, (+{.0 = unit}, +{.0 = unit}))
) = here((unit, (+{.0 = unit}, +{.0 = unit}))) ;

/// The magma to itself by the swap written three times.
@[ checks ]
def reopposite = ua[1, 4](Magma, Magma, #{.mul = flip, .one = keep}, #{.mul = flip, .one = keep}) ;

/// The swap and the swap three times agree at every boolean.
@[ checks ]
def agree : Path(Bool => Bool, exchange, flip) = funext(exchange, flip) ;

/// The swap and the identity do not.
@[ refuses("PointwiseDistinct") ]
def disagree : Path(Bool => Bool, exchange, boolId) = funext(exchange, boolId) ;
