//! This source derives univalence paths at signature corollas.
//!
//! `ua[1, 4]` derives a path between the degree telescopes of two `Magma`
//! models. It reads their translator tables one corolla at a time.
//!
//! Transport applies each corolla translator. Tables that agree at every
//! element produce the same path. A univalence map acts as a typoid function.
//!
//! - cites: [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]
//! - cites: [Petrakis-2022-univalent_typoids]
//!
//! [Shulman-2015-univalence_inverse_diagrams_homotopy_canonicity]: https://doi.org/10.1017/S0960129514000565 "Shulman, Univalence for Inverse Diagrams and Homotopy Canonicity"
//! [Petrakis-2022-univalent_typoids]: https://arxiv.org/abs/2205.06651 "Petrakis, Univalent Typoids"

// The magma, the swap, the identity on the booleans and the unit's identity.
import "./magma-base.gandr";

/// `flip` applies `exchange` three times.
def flip(b : Bool) -> Bool =
  let c = exchange b
  exchange (exchange c)

/// `opposite` applies `exchange` at the binary corolla.
def opposite = ua[
  1,
  4
] Magma Magma (*{.mul = exchange, .one = keep}) (*{.mul = exchange, .one = keep});

/// `moves` transports a binary corolla boolean along `opposite`.
def moves : Path[.A = Unit * (+{Unit} * Bool)](
  Path.walk (fun (X) { X }) opposite (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}}),
  *{*{}, *{+{.0 = *{}}, +{.1 = *{}}}}
) = Path.here (*{*{}, *{+{.0 = *{}}, +{.1 = *{}}}});

/// `stays` refuses the unchanged boolean as the transport result.
@[refuses("EndpointMismatch")]
def stays : Path[.A = Unit * (+{Unit} * Bool)](
  Path.walk (fun (X) { X }) opposite (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}}),
  *{*{}, *{+{.0 = *{}}, +{.0 = *{}}}}
) = Path.here (*{*{}, *{+{.0 = *{}}, +{.0 = *{}}}});

/// `reopposite` applies `flip` at the binary corolla.
def reopposite = ua[1, 4] Magma Magma (*{.mul = flip, .one = keep}) (*{.mul = flip, .one = keep});

/// `agree` proves that `exchange` and `flip` agree at every boolean.
def agree : Path[.A = Bool -> Bool](exchange, flip) = Path.funext exchange flip;

/// `disagree` refuses `exchange` and `boolId` as pointwise equal.
@[refuses("PointwiseDistinct")]
def disagree : Path[.A = Bool -> Bool](exchange, boolId) = Path.funext exchange boolId;
