// Definitions a Rust caller runs on its own values, and a Rust function they
// call, admitted against its row.
//
// The first direction: Rust holds the composed program and calls a definition
// by name. The second: the `extern` block declares the Rust caller's `add` as
// an operation of the interface `Boundary`, and `quadrupled` performs it. No
// handler here answers it, so the run offers it to the Rust caller's host,
// which calls its own `add`. The block names `add`'s row, and its check admits
// the declared types against the row under Rust's default layout. No value
// crosses by layout yet: the runtime holds each argument and answer as itself.
//
// The Rust test composes this source, names each definition and calls it on
// values it builds, then reads the answer back. Each `runs` item below makes
// the same call from gandr, so both sides state one answer. `quadrupled` has
// none, since only the Rust caller answers `Boundary`.
//
// - see: #2901 — not implemented: values crossing by Rust's default layout
// - see: `crates/surface-dispatcher/tests/boundary.rs` — the Rust caller
// - see: `library/std/src/boundary.gandr` — `admitBlock`, which the block's
//   check runs
// - see: `model/interop/boundary/function-row.gandr` — the function row an
//   `extern` is admitted against

// `Row`, `Codes`, `Code` and `admitBlock`.
import "../../../../library/std/src/boundary.gandr";

// `U32`, the scalar a `u32` is coded as.
import "../../../../library/std/src/layout.gandr";

/// `add`'s row: two `u32` to a `u32`.
pub def addRow : Row = Row(Arg(Plain(U32), Arg(Plain(U32), NoCode)), Plain(U32));

/// The Rust caller's adder, `add(x: u32, n: u32) -> u32`. Its check admits it
/// against `addRow`.
@[ boundary(addRow) ]
extern "rust" from "boundary" as Boundary {
  def add(x : u32, n : u32) -> u32;
}

/// Four times its argument: Rust adds it to itself, then the sum to itself.
pub def quadrupled(x : u32) -> [Boundary] u32 {
  run y <- Boundary.add(x, x);
  Boundary.add(y, y)
}

/// Twice its argument.
pub def double(x : Integer) -> Integer { x + x }

/// The first less the second: the arguments' order decides the answer.
pub def less(x : Integer, y : Integer) -> Integer { x - y }

/// The function that adds `n`: a call answers it as a value, unapplied.
def adder(n : Integer) -> Integer => Integer {
  thunk { fn (x) { x + n } }
}

/// `double` at 21, as the Rust test calls it.
@[ runs("42") ]
def doubled() -> Integer { double(21) }

/// `less` at 19 and 7, as the Rust test calls it.
@[ runs("12") ]
def lessened() -> Integer { less(19, 7) }

/// `adder` at 5, applied to 7.
@[ runs("12") ]
def added() -> Integer {
  run add <- adder(5);
  add(7)
}
