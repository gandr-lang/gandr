//! This source shows access at list places.
//!
//! An access reads its index and lends its element.
//! An exclusive view writes its element back.
//!
//! The checker lends the held list as a whole.
//! Shared views can coexist on that list.
//!
//! - cites: [Rust-reference]
//!
//! [Rust-reference]: https://doc.rust-lang.org/reference/ "The Rust Project, The Rust Reference"

// The native finite lists.
import std.list (List);

/// `pair` supplies the list for each access.
/// Its declaration states the list type.
@[ runs("cons 1 (cons 2 nil)") ]
pub def pair : List(Integer) = cons 1 (cons 2 nil);

/// `second` reads the indexed element through a shared view.
@[ runs("2") ]
def second() -> Integer =
  var xs = pair
  access shared xs.#[1] as w { pure w }

/// `bumped` writes the indexed element back.
/// The rest of the list does not change.
@[ runs("cons 1 (cons 3 nil)") ]
def bumped() -> List(Integer) =
  var xs = pair
  access xs.#[1] as v { resume v (v + 1) };
  pure xs

/// A list of pairs built where it runs.
def tagged(a : Integer) -> List(Integer * Integer) =
  pure cons (a, 1) (cons (a, 2) (cons (a, 3) nil))

/// `rebuilt` writes an element after the head.
/// The runtime copies prefix cells, shares suffix cells and leaves fresh pairs unchanged.
@[ runs("cons *{9, 9} (cons *{1, 1} (cons *{5, 5} (cons *{1, 3} nil)))") ]
def rebuilt() -> List(Integer * Integer) =
  let l = tagged 1
  var xs = l
  access xs.#[1] as v { resume v *{5, 5} };
  pure cons (9, 9) xs

/// An abort writes nothing back: the list stands as it was.
@[ runs("cons 1 (cons 2 nil)") ]
def kept() -> List(Integer) =
  var xs = pair
  access xs.#[0] as v { abort v } unwind { pure *{} };
  pure xs

/// The index is any value where the access stands, here a parameter.
def indexed(i : Integer) -> Integer =
  var xs = pair
  access shared xs.#[i] as w { pure w }
