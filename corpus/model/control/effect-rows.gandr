// A returner's row is a row of interfaces: each interface's name holds its
// signature, no name twice, the names in no order of their own (#2269). Two
// rows that list the same interfaces in different orders are one row,
// sequencing joins the rows of the computations it runs, and a computation is
// read where a row holding more is asked: the set operations of a row
// (Hillerström and Lindley, "Liberating Effects with Rows and Handlers",
// Type-Driven Development 2016, § 2). What refuses is in
// `../../pathological/control/effect-rows.gandr`.

// `peek` reads through `std.fs.Eff`; `once` states `Partial`.
import "./capability-attenuate.gandr";
import "./divergence.gandr";

/// Reading a file, then a loop: the row joins `peek`'s `std.fs.Eff` and `once`'s
/// `Partial`.
def performsBoth(c : Cap { read }) -> [std.fs.Eff, Partial] Integer {
  let _ = peek(c);
  once(1)
}

/// The same interfaces listed the other way round are the same row:
/// `performsBoth`'s call stands at it unchanged.
def listedSwapped(c : Cap { read }) -> [Partial, std.fs.Eff] Integer { performsBoth(c) }

/// A suspended computation at one order is forced at the other.
def forcedAcross(t : +U (-F [Partial, std.fs.Eff] Integer)) -> [std.fs.Eff, Partial] Integer {
  force t
}

/// A computation at `[Partial]` is read where `[std.fs.Eff, Partial]` is asked, and runs.
@[ runs("3") ]
def widenedRow() -> [std.fs.Eff, Partial] Integer { once(3) }
