// This source shows theory effects with qualified paths.
//
// `Counter.Eff` lives under `Counter`.
//
// The checker names each effect at its home path.
//
// - see: ../../pathological/control/bare-effect.gandr
// - see: #4495

/// `Counter.Eff` declares a count effect.
theory Counter.Eff where
  sort C : Type;
  oper bump : (k : C) --> C;

/// A bump, through the instance `n` its row's label binds.
def tallied() -> [n : Counter.Eff] Integer =
  n.bump ()
  pure 0

/// The bump handled at seven: the scope's clause answers.
@[ runs("7") ]
def tallyHandled() -> Integer =
  handle c : Counter.Eff {
    tallied ()
  } with {
    | pure(x) => pure x
    | oper bump(k) => pure 7
  }
