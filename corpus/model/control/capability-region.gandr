//! This source shows capability regions.
//!
//! A capability stays in the region that introduces it.
//! An outer capability can enter an inner region.
//!
//! The checker orders regions by outlives.
//! It erases regions before execution.
//!
//! - cites: [Koronkevich-2025-type_universes_kripke_worlds]
//!
//! [Koronkevich-2025-type_universes_kripke_worlds]: https://doi.org/10.1145/3747532 "Koronkevich and Bowman, Type Universes as Kripke Worlds"

// Early exit's host interface.
import std.process;

/// `named` gives the scope capability its region type.
def named() -> Unit =
  handle c : std.process.Exit.Eff {
    let d : Cap { exit } at c = c;
    return *{}
  } with {
    | pure(x) => x
    | oper exit(code, k) => *{}
  }

/// A capability held for the whole run is not one a scope introduced: the
/// scope's capability would outlive its scope there.
@[refuses("CapabilityEscaped")]
def held() -> Unit =
  handle c : std.process.Exit.Eff {
    let d : Cap { exit } = c;
    return *{}
  } with {
    | pure(x) => x
    | oper exit(code, k) => *{}
  }

/// Inside a second scope the outer capability still names the outer region.
def outer() -> Unit =
  handle c : std.process.Exit.Eff {
    handle e : std.process.Exit.Eff {
      let d : Cap { exit } at c = c;
      return *{}
    } with {
      | pure(x) => x
      | oper exit(code, k) => *{}
    }
  } with {
    | pure(x) => x
    | oper exit(code, k) => *{}
  }

/// An outer capability can enter an inner region.
/// An inner capability cannot enter an outer region.
@[refuses("CapabilityEscaped")]
def swapped() -> Unit =
  handle c : std.process.Exit.Eff {
    handle e : std.process.Exit.Eff {
      let d : Cap { exit } at e = c;
      let f : Cap { exit } at c = e;
      return *{}
    } with {
      | pure(x) => x
      | oper exit(code, k) => *{}
    }
  } with {
    | pure(x) => x
    | oper exit(code, k) => *{}
  }

/// Only a scope capability names a region.
@[refuses("UnresolvedName")]
def unbound(c : Integer) -> Unit =
  handle e : std.process.Exit.Eff {
    let d : Cap { exit } at c = e;
    return *{}
  } with {
    | pure(x) => return x
    | oper exit(code, k) => return *{}
  }

/// `plain` keeps an integer until scope `c` ends.
/// `kept-view.gandr` shows a view in the same region.
def plain() -> Unit =
  handle c : std.process.Exit.Eff {
    let d : Integer at c = 1;
    return *{}
  } with {
    | pure(x) => x
    | oper exit(code, k) => *{}
  }
