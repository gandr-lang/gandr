//! A statement inside a block a binder reads. The statement is a split of its
//! unit result, and a split whose components its body's type does not read
//! synthesises that type, as a bind does: an elimination whose principal
//! premise synthesises synthesises [Dunfield-2019-bidirectional_typing].
//!
//! - see: #1374 — `statement`
//! - cites: [Dunfield-2019-bidirectional_typing]
//!
//! [Dunfield-2019-bidirectional_typing]: https://doi.org/10.1145/3450952 "Dunfield and Krishnaswami, Bidirectional Typing"

// Early exit's host interface.
import std.process;

/// An exit performed as a statement in a block a binder reads, the binder
/// stating no type: the block synthesises its last computation's type, and
/// the clause resumes the rest once.
@[ runs("0") ]
def statement() -> Integer =
  handle c : std.process.Exit.Eff {
    let n = { c.exit 1; pure 0 };
    pure n
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => k *{}
  }
