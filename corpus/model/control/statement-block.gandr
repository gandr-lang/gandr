//! This source shows statement blocks under binders.
//!
//! A statement splits its unit result.
//! A block can synthesise its final computation type.
//!
//! The checker reads a statement as an elimination.
//! A binder can infer the block result.
//!
//! - see: #1374 — `statement`
//! - cites: [Dunfield-2019-bidirectional_typing]
//!
//! [Dunfield-2019-bidirectional_typing]: https://doi.org/10.1145/3450952 "Dunfield and Krishnaswami, Bidirectional Typing"

// Early exit's host interface.
import std.process;

/// `statement` performs an exit in a bound block.
/// The checker synthesises the final computation type and resumes
/// the rest once.
@[ runs("0") ]
def statement() -> Integer =
  handle c : std.process.Exit.Eff {
    let n = { c.exit 1; pure 0 };
    pure n
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => k *{}
  }
