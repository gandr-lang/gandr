//! This source shows eliminators with written answers.
//!
//! An `if` or `case` can write its answer type.
//! Each arm then checks against that type.
//!
//! A `run` binding synthesises the written answer.
//! The checker treats the answer as an annotation.
//!
//! - see: #2089
//! - cites: [Dunfield-2019-bidirectional_typing]
//!
//! [Dunfield-2019-bidirectional_typing]: https://doi.org/10.1145/3450952 "Dunfield and Krishnaswami, Bidirectional Typing"

/// A conditional a `run` binds: its written answer types the bound value.
@[ runs("2") ]
def boundIf() -> Integer =
  let m = if true -> -F Integer { pure 1 } else { pure 0 };
  pure (m + 1)

/// A match over an integer, bound the same way: its case, under the
/// comparison it tests, answers what the match writes.
@[ runs("10") ]
def boundCase() -> Integer =
  let m = match 3 -> -F Integer { | 0 => pure 0 | _ => pure 5 };
  pure (m + m)

/// An `else if` chain whose head writes the answer: the head's answer types
/// the chain, and the later rung is checked against it.
@[ runs("1") ]
def chained() -> Integer =
  let m = if false -> -F Integer { pure 0 } else if true { pure 1 } else { pure 2 };
  pure m

/// A value type written as the answer reads as its returner, as a function's
/// result does: `-> Integer` answers `-F Integer`.
@[ runs("1") ]
def valued() -> Integer =
  let m = if true -> Integer { pure 1 } else { pure 2 };
  pure m

/// A conditional whose answer only the type written after its condition
/// states, bound by a `run` that reads its type off it.
@[ runs("1") ]
def chosen() -> Integer =
  let n = if true -> -F Integer { pure 1 } else { pure 2 };
  pure n
