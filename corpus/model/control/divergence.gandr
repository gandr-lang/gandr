// Divergence as a row entry (#1481). A loop the checker cannot see out of may
// run forever, so the function holding it states `Div` in its row: the host
// interface with no operation, which no handler eliminates. A caller of such a
// function holds `Div` in its own row, as it holds any interface its callee
// performs, so a function at the empty row returns. A call that returns and
// whose result nothing reads is the computation that follows it. What refuses
// is in `../../pathological/control/divergence.gandr`.

/// A loop that breaks only when one is below zero: it never returns, and its
/// row says it may not.
@[ checks ]
def spin(x : Bool) -> -F [Div] Bool {
  run y <- loop {
    run below <- 1 < 0;
    case below {
      true => break(x),
      false => continue,
    }
  };
  y
}

/// A caller of `spin` holds `Div` in its own row.
@[ checks ]
def spinOn(x : Bool) -> -F [Div] Bool {
  spin(x)
}

/// A loop that breaks at once states `Div` all the same: the row records what
/// the loop may do, not what one run of it does.
@[ checks ]
def once(x : Integer) -> -F [Div] Integer {
  run y <- loop { break(x) };
  y
}

/// It runs, at a row holding `Div`.
@[ runs("3") ]
def onceThree() -> -F [Div] Integer {
  once(3)
}

/// A recursive function that never calls itself runs its body once, so it
/// returns at the empty row.
@[ checks ]
def rec unused(x : Bool) -> Bool {
  x
}

/// A call at the empty row returns and nothing observes it but its value, so
/// a call whose value is never read is the computation that follows it: the
/// function calling `g` and dropping what it returns is `f`.
@[ checks ]
def unreadCall(a : Type, b : Type, f : a => b, g : a => b) -> Path(
  a => b,
  thunk { fn (x) { run v <- g(x); f(x) } },
  f
) {
  here(f)
}

/// Two unread calls in a row are dropped one after the other.
@[ checks ]
def unreadTwice(a : Type, b : Type, f : a => b, g : a => b, h : a => b) -> Path(
  a => b,
  thunk { fn (x) { run v <- g(x); run w <- h(x); f(x) } },
  f
) {
  here(f)
}

/// Applies `h` to `x`.
@[ checks ]
def apply(a : Type, b : Type, h : a => b, x : a) -> b {
  h(x)
}

/// The discard is a step of the dialogue the kernel replays from the
/// certificate: after it the call of `apply` unfolds, which the kernel's own
/// reading does not do under a binder.
@[ checks ]
def unreadApplied(a : Type, b : Type, f : a => b, g : a => b) -> Path(
  a => b,
  thunk { fn (x) { run v <- g(x); apply(a, b, f, x) } },
  f
) {
  here(f)
}
