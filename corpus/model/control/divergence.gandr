// This source shows `Partial` rows.
//
// A loop without an exit can run forever.
// A caller of such a loop carries `Partial`.
//
// The checker preserves `Partial` in each calling row.
// It drops unread calls only at the empty row.
//
// - see: #1481
// - see: ../../pathological/control/divergence.gandr

/// A loop that breaks only when one is below zero: it never returns, and its
/// row says it may not.
def spin(x : Bool) -> [Partial] Bool =
  let y = loop {
    let below = 1 < 0;
    match below where
      | true => break(x)
      | false => continue
  };
  y

/// A caller of `spin` holds `Partial` in its own row.
def spinOn(x : Bool) -> [Partial] Bool =
  spin x

/// `once` states `Partial` even though it breaks at once.
/// Its row records every possible loop behavior.
pub def once(x : Integer) -> [Partial] Integer =
  let y = loop { break(x) };
  y

/// It runs, at a row holding `Partial`.
@[ runs("3") ]
def onceThree() -> [Partial] Integer =
  once 3

/// A recursive function that never calls itself runs its body once, so it
/// returns at the empty row.
def rec unused(x : Bool) -> Bool =
  x

/// An unread empty-row call does not change the next computation.
/// `unreadCall` proves that equality.
def unreadCall(a : Type, b : Type, f : a -> b, g : a -> b) -> Path[.A = a -> b](
  fun (x) { let _ = g x; f x },
  f
) =
  Path.here f

/// `unreadTwice` drops two empty-row calls in sequence.
def unreadTwice(a : Type, b : Type, f : a -> b, g : a -> b, h : a -> b) -> Path[.A = a -> b](
  fun (x) { let _ = g x; let _ = h x; f x },
  f
) =
  Path.here f

/// Applies `h` to `x`.
def apply(a : Type, b : Type, h : a -> b, x : a) -> b =
  h x

/// The kernel replays the discard from its certificate.
/// It unfolds `apply` after the discard.
def unreadApplied(a : Type, b : Type, f : a -> b, g : a -> b) -> Path[.A = a -> b](
  fun (x) { let _ = g x; apply a b f x },
  f
) =
  Path.here f
