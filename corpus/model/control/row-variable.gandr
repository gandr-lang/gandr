//! This source shows open effect rows through variables.
//!
//! `log` adds the console interface and leaves `r` open.
//! A caller solves `r` from its required row.
//!
//! A handler removes the console interface.
//! It forwards the remaining row.
//!
//! - see: #2270
//! - see: ../../pathological/control/row-variable.gandr
//! - cites: [Hillerström-2016-liberating_effects_rows_handlers]
//!
//! [Hillerström-2016-liberating_effects_rows_handlers]: https://doi.org/10.1145/2976022.2976033 "Hillerström and Lindley, Liberating Effects with Rows and Handlers"

// The console's host interface.
import std.io;

/// `log` prints through the console interface.
/// Its row leaves `r` open.
pub def log[r : Row](s : String) -> [std.io.Console.Eff | r] Unit { std.io.Console.print s }

/// `logAlone` solves `r` as the empty row.
def logAlone() -> [std.io.Console.Eff] Unit { log "alone" }

/// `log` beside `Partial`: the call's `r` is `[Partial]`.
def logBeside() -> [std.io.Console.Eff, Partial] Unit { log "beside" }

/// `logSwapped` uses an equivalent row order.
/// The checker solves `r` as `Partial`.
def logSwapped() -> [Partial, std.io.Console.Eff] Unit { log "swapped" }

/// `quiet` handles the console interface.
/// It forwards row `r`.
def quiet[r : Row](s : String) -> [r] Unit =
  handle c : std.io.Console.Eff {
    log s
  } with {
    | pure(x) => pure x
    | oper print(line, k) => k *{}
  }

/// `quietRun` handles the printed line.
@[ runs("*{}") ]
def quietRun() -> Unit { quiet "handled" }

/// `quiet` beside `Partial`: the variable carries `Partial` through the handler.
def quietBeside() -> [Partial] Unit { quiet "forwarded" }
