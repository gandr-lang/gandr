// A returner's row may stay open through a row variable, an implicit of the
// kind `Row` (#2270): `log` prints through `std.io.Console.Eff` and leaves the rest of
// its row to its caller, so one definition is used under every row holding
// `std.io.Console.Eff`, the variable solved at each call by the row equation, and a
// handler of `std.io.Console.Eff` takes `[std.io.Console.Eff | r]` to `[r]`, forwarding the rest
// (Hillerström and Lindley, "Liberating Effects with Rows and Handlers",
// Type-Driven Development 2016, § 2.5 and § 3.3, T-HANDLER). What refuses is
// in `../../pathological/control/row-variable.gandr`.

/// A line printed through `std.io.Console.Eff`, the rest of the row left open: `r`
/// lacks `std.io.Console.Eff`, which the row writes beside it.
pub def log[r : Row](s : String) -> [std.io.Console.Eff | r] Unit { std.io.Console.print(s) }

/// `log` where the row is `std.io.Console.Eff` alone: the call's `r` is the empty row.
def logAlone() -> [std.io.Console.Eff] Unit { log("alone") }

/// `log` beside `Partial`: the call's `r` is `[Partial]`.
def logBeside() -> [std.io.Console.Eff, Partial] Unit { log("beside") }

/// `logBeside`'s row listed the other way round is the same row, so the
/// call's `r` is solved as the same `[Partial]`: one solution, not two that
/// convert.
def logSwapped() -> [Partial, std.io.Console.Eff] Unit { log("swapped") }

/// A handler of `std.io.Console.Eff` around `log`: the handled body's row is
/// `[std.io.Console.Eff | r]`, and what the handler leaves is `r`.
def quiet[r : Row](s : String) -> [r] Unit {
  handle c : std.io.Console.Eff {
    log(s)
  } with {
    pure(x) => pure x,
    oper print(line, k) => k(unit)
  }
}

/// `quiet` where nothing is left: it runs, the line handled.
@[ runs("unit") ]
def quietRun() -> Unit { quiet("handled") }

/// `quiet` beside `Partial`: the variable carries `Partial` through the handler.
def quietBeside() -> [Partial] Unit { quiet("forwarded") }
