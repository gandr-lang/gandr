//! This source shows capability attenuation.
//!
//! A wider capability can satisfy a narrower need.
//! A holder cannot use an operation outside its capability.
//!
//! The checker rejects an operation outside the stated authority.
//! The host grants the authority that a capability carries.
//! The discipline follows Dennis and Van Horn
//! [Dennis-1966-programming_semantics_for_multiprogrammed_computations] and the
//! 2006 thesis of Miller.
//!
//! - cites: [Dennis-1966-programming_semantics_for_multiprogrammed_computations]
//!
//! [Dennis-1966-programming_semantics_for_multiprogrammed_computations]: https://doi.org/10.1145/365230.365252 "Dennis and Van Horn, Programming Semantics for Multiprogrammed Computations"

// The filesystem's host interface.
import std.fs;

/// `fs` gives the host read and write authority.
@[owes(1)]
def fs : Cap { read, write };

/// A reader that asks only for reading.
pub def peek(c : Cap { read }) -> [std.fs.Eff] String =
  c.read "notes"

/// `granted` passes read and write authority to `peek`.
def granted() -> [std.fs.Eff] String =
  peek fs

/// A holder of reading alone cannot write.
@[refuses("CapabilityOutsideAuthority")]
def save(c : Cap { read }) -> [std.fs.Eff] Unit =
  c.write "notes" "draft"
