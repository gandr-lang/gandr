//! This source shows exits from effect handlers.
//!
//! An operation clause resumes or discards its continuation.
//! A `pure` value passes through the handler `pure` clause.
//!
//! A `return` exits the handler with its value.
//! The lowering records every `become` exit.
//!
//! - see: #1481 — `looped`
//! - see: #1387 — `resume_stack`
//! - see: #1651 — `Conts`
//! - cites: [Plotkin-2013-handling_algebraic_effects]
//!
//! [Plotkin-2013-handling_algebraic_effects]: https://doi.org/10.2168/LMCS-9(4:23)2013 "Plotkin and Pretnar, Handling Algebraic Effects"

// Early exit's host interface.
import std.process;

/// The operation's clause resumes the body, whose value passes through the
/// `pure` clause.
@[ runs("101") ]
def resumed() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// A `return` in the handled body leaves the handler, the `pure` clause
/// skipped.
def left(n : Integer) -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 1;
    return n
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// `left` at five, by a run.
@[ runs("5") ]
def left_run() -> Integer { become left 5 }

/// The operation's clause discards its continuation and answers for the
/// handler.
@[ runs("9") ]
def discarded() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    return 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => pure 9
  }

/// A `return` inside two handlers leaves both.
@[ runs("4") ]
def nested() -> Integer =
  handle a : std.process.Exit.Eff {
    handle b : std.process.Exit.Eff {
      return 4
    } with {
      | pure(x) => pure x + 10
      | oper exit(code, k) => k *{}
    }
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// A `case` whose one arm returns and whose other arm continues the body.
def branch(n : Integer) -> Integer =
  handle c : std.process.Exit.Eff {
    let m = match n {
      | 0 => return 8
      | _ => pure n
    };
    c.exit 2;
    pure m + 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// The returning arm, by a run.
@[ runs("8") ]
def branch_zero() -> Integer { become branch 0 }

/// The continuing arm, through the operation and the `pure` clause.
@[ runs("102") ]
def branch_one() -> Integer { become branch 1 }

/// `break` gives the loop value to its body.
/// `looped` carries `Partial` through the handler.
@[ runs("105") ]
def looped() -> [Partial] Integer =
  handle c : std.process.Exit.Eff {
    let v = loop {
      break(5)
    };
    pure v
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// A `return` inside a loop leaves the loop and the handler.
@[ runs("2") ]
def looped_out() -> [Partial] Integer =
  handle c : std.process.Exit.Eff {
    loop {
      return 2
    }
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => k *{}
  }

/// An operation clause that returns answers for the handler.
@[ runs("9") ]
def answered() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 1;
    pure 1
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => 9
  }

/// `Stack(C, D)` names a continuation type.
/// It states the computation it resumes and its result.
def dropped(k : Stack (-F Unit) (-F Integer)) -> Integer =
  9

/// This clause passes its continuation to a typed function.
/// The handler returns that function result.
@[ runs("9") ]
def handed_on() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    return 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => dropped k
  }

/// A function with a continuation type resumes the continuation it receives.
def resume_stack(j : Stack (-F Unit) (-F Integer)) -> Integer =
  j *{}

/// This clause calls `resume_stack` with its continuation.
/// The body then passes through the `pure` clause.
@[ runs("101") ]
def resumed_on() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => resume_stack k
  }

/// A type member can name a continuation type.
/// Its function resumes the continuation it receives.
module Conts where
  type K = Stack (-F Unit) (-F Integer);

  /// `resume_stack`, through the member.
  def aliased(j : K) -> Integer =
    j *{}

/// This clause passes its continuation to the member-typed function.
/// That function resumes the body.
@[ runs("101") ]
def resumed_aliased() -> Integer =
  handle c : std.process.Exit.Eff {
    c.exit 5;
    pure 1
  } with {
    | pure(x) => pure x + 100
    | oper exit(code, k) => Conts.aliased k
  }

/// A continuation runs from a computation, never from a value type.
@[ refuses("OutOfFragment.WrongSort") ]
def from_a_value(k : Stack(Integer, -F Integer)) -> -F Integer =
  return 9
