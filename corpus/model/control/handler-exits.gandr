// Effect handlers and the exits through them, after Plotkin and Pretnar,
// _Handling Algebraic Effects_ (doi:10.2168/LMCS-9(4:23)2013): an operation's
// clause may resume the handled body through its continuation or discard it,
// a body's `pure` value passes through the handler's `pure` clause, and a
// `return` leaves the handler with its value as it stands. A tail call is an
// exit too, so every `become` here is written: the exits are the subject.

/// The operation's clause resumes the body, whose value passes through the
/// `pure` clause.
@[ runs("101") ]
def resumed() -> -F Integer {
  handle c : Proc {
    c.exit(5);
    pure 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => k(unit)
  }
}

/// A `return` in the handled body leaves the handler, the `pure` clause
/// skipped.
@[ checks ]
def left(n : Integer) -> -F Integer {
  handle c : Proc {
    c.exit(1);
    return n
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => k(unit)
  }
}

/// `left` at five, by a run.
@[ runs("5") ]
def left_run() -> -F Integer { become left(5) }

/// The operation's clause discards its continuation and answers for the
/// handler.
@[ runs("9") ]
def discarded() -> -F Integer {
  handle c : Proc {
    c.exit(5);
    return 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => pure 9
  }
}

/// A `return` inside two handlers leaves both.
@[ runs("4") ]
def nested() -> -F Integer {
  handle a : Proc {
    handle b : Proc {
      return 4
    } with {
      pure(x) => pure x + 10,
      oper exit(code, k) => k(unit)
    }
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => k(unit)
  }
}

/// A `case` whose one arm returns and whose other arm continues the body.
@[ checks ]
def branch(n : Integer) -> -F Integer {
  handle c : Proc {
    run m <- case n {
      0 => return 8,
      _ => pure n,
    } ;
    c.exit(2);
    pure m + 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => k(unit)
  }
}

/// The returning arm, by a run.
@[ runs("8") ]
def branch_zero() -> -F Integer { become branch(0) }

/// The continuing arm, through the operation and the `pure` clause.
@[ runs("102") ]
def branch_one() -> -F Integer { become branch(1) }

/// A loop's `break` gives the loop's value to the body, which continues. The
/// loop may run forever, so the row states `Div` (#1481), and the handler of
/// `Proc` leaves it there.
@[ runs("105") ]
def looped() -> -F [Div] Integer {
  handle c : Proc {
    run v <- loop {
      break(5)
    } ;
    pure v
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => k(unit)
  }
}

/// A `return` inside a loop leaves the loop and the handler.
@[ runs("2") ]
def looped_out() -> -F [Div] Integer {
  handle c : Proc {
    loop {
      return 2
    }
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => k(unit)
  }
}

/// An operation clause that returns answers for the handler.
@[ runs("9") ]
def answered() -> -F Integer {
  handle c : Proc {
    c.exit(1);
    pure 1
  } with {
    pure(x) => pure x,
    oper exit(code, k) => 9
  }
}

/// A continuation's type is written `Stack(C, D)`, the computation it resumes
/// from and the one it ends as; a clause hands its continuation on by it.
@[ checks ]
def dropped(k : Stack(-F Unit, -F Integer)) -> -F Integer {
  9
}

/// A clause hands its continuation to a function stating the continuation's
/// type, and the handled body answers what that function returns.
@[ runs("9") ]
def handed_on() -> -F Integer {
  handle c : Proc {
    c.exit(5);
    return 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => dropped(k)
  }
}

/// A function stating a continuation's type resumes the continuation it is
/// handed, as the clause that bound it would (#1387).
@[ checks ]
def resume_stack(j : Stack(-F Unit, -F Integer)) -> -F Integer {
  j(unit)
}

/// A clause hands its continuation to `resume_stack`, which resumes the body;
/// the body's value passes through the `pure` clause, as in `resumed`.
@[ runs("101") ]
def resumed_on() -> -F Integer {
  handle c : Proc {
    c.exit(5);
    pure 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => resume_stack(k)
  }
}

/// A type member may abbreviate a continuation's type: a function stating the
/// member resumes the continuation it is handed as one stating the stack does
/// (#1651).
module Conts {
  type K = Stack(-F Unit, -F Integer);

  /// `resume_stack`, through the member.
  @[ checks ]
  def aliased(j : K) -> -F Integer {
    j(unit)
  }
}

/// A clause hands its continuation to the function stating the member, which
/// resumes the body.
@[ runs("101") ]
def resumed_aliased() -> -F Integer {
  handle c : Proc {
    c.exit(5);
    pure 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => Conts.aliased(k)
  }
}

/// A continuation runs from a computation, never from a value type.
@[ refuses("OutOfFragment.WrongSort") ]
def from_a_value(k : Stack(Integer, -F Integer)) -> -F Integer {
  return 9
}
