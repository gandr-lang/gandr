// A signature joined with its definition, `def x : T = e;`, is one item
// declaring both: the value is checked against the type, as it is when the
// two are written apart. The sugared form joins a signature with the
// definition directly after it; a comment or another item between them keeps
// the two (#2228).

/// Three, its type and value in one item.
@[ checks ]
def joinedThree : Integer = 3;

/// Four, apart: the comment between its halves keeps them so.
@[ checks ]
def apartFour : Integer;
// The value follows the comment.
def apartFour = 4;

/// Five, apart: the item between its halves keeps them so.
@[ checks ]
def apartFive : Integer;

/// Six, joined, between five's halves.
@[ checks ]
def joinedSix : Integer = 6;
/// Five's value, after the item between.
def apartFive = 5;

/// Each value, joined or apart, read where a value is asked.
@[ runs("18") ]
def joinedSum() -> Integer { joinedThree + apartFour + apartFive + joinedSix }
