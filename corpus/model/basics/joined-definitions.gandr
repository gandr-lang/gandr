// This source shows joined definitions.
//
// A joined item contains a signature and its definition.
// The checker checks its value against the signature type.
//
// The sugared form joins directly adjacent parts.
// A comment or another item keeps the parts apart.
//
// - see: #2228

/// Three, its type and value in one item.
def joinedThree : Integer = 3;

/// Four, apart: the comment between its halves keeps them so.
def apartFour : Integer;
// The value follows the comment.
def apartFour = 4;

/// Five, apart: the item between its halves keeps them so.
def apartFive : Integer;

/// `joinedSix` sits between the parts of `apartFive`.
def joinedSix : Integer = 6;
/// Five's value, after the item between.
def apartFive = 5;

/// The checker reads each joined or separate value where it expects a value.
@[runs("18")]
def joinedSum() -> Integer { joinedThree + apartFour + apartFive + joinedSix }
