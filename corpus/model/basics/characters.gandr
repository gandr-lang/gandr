// Characters: one Unicode scalar between single quotes, at the type `Char`.
// A character is an atom of its own, so `'a'` is no one-character string and
// neither converts to the other.

/// A letter at a stated `Char`.
@[ checks ]
def letter : Char = 'a' ;

/// An escape stands for the scalar it names, decoded as in a string.
@[ runs("'\\n'") ]
def newline() -> Char { '\n' }

/// A quote is escaped inside quotes of its own kind.
@[ runs("'\\''") ]
def quote() -> Char { '\'' }

/// A multibyte scalar is still one character.
@[ runs("'é'") ]
def accented() -> Char { 'é' }

/// The identity at `Char`.
@[ checks ]
def echo(c : Char) -> Char { c }

/// A character passes through a function at `Char` unchanged.
@[ runs("'z'") ]
def echoed() -> Char { become echo('z') }

/// A character is not a string.
@[ refuses("TypeMismatch") ]
def spelled : String = 'a' ;

/// Nor is a string a character.
@[ refuses("TypeMismatch") ]
def lettered : Char = "a" ;
