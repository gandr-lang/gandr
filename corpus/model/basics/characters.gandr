// This source shows `Char` literals.
//
// A `Char` contains one Unicode scalar.
// It differs from a one-character `String`.
//
// The parser reads scalars between single quotes.
//
// - see: `Char` — character literal type.

/// A letter at a stated `Char`.
def letter : Char = 'a';

/// An escape stands for the scalar it names, decoded as in a string.
@[ runs("'\\n'") ]
def newline() -> Char { '\n' }

/// This escape writes a quote inside matching quotes.
@[ runs("'\\''") ]
def quote() -> Char { '\'' }

/// A multibyte scalar is still one character.
@[ runs("'é'") ]
def accented() -> Char { 'é' }

/// The identity at `Char`.
def echo(c : Char) -> Char { c }

/// A character passes through a function at `Char` unchanged.
@[ runs("'z'") ]
def echoed() -> Char { echo 'z' }

/// A character is not a string.
@[ refuses("TypeMismatch") ]
def spelled : String = 'a';

/// Nor is a string a character.
@[ refuses("TypeMismatch") ]
def lettered : Char = "a";
