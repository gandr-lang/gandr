// This source writes explicit paired definitions.
//
// An explicit pair contains a signature and its following definition.
// The sugared form joins the pair.
//
// The parser retains each definition pair.
//
// - see: #2228

/// Three, its signature and definition apart.
@[checks, form(explicit)]
def pairedThree : Integer;
def pairedThree = 3;

/// `pairedAgain` reads the explicit pair.
@[runs("3")]
def pairedAgain() -> -F Integer { return pairedThree }
