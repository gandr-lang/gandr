// This source shows definitions that name values.
//
// A definition can name a value.
// Another definition can name that value again.
//
// The evaluator resolves each name to its value.
//
// - see: `greeting`, `shown` — definition lookup.

/// A string, named.
def greeting = "the value zone";

/// The named value, named again.
@[ runs("\"the value zone\"") ]
def shown = greeting;
