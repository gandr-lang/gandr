// This source shows product values.
//
// A pair names values.
// A triple forms a product chain whose positions select its values.
//
// The runtime returns a pair as a program result.
//
// - see: `point`, `triple` — product values.

/// Two integers, paired.
def point = *{1, 2};

/// Three values, the type written as a product chain.
def triple : Integer * String * Integer = *{3, "three", 4};

/// The middle of the three, selected by its place.
@[runs("\"three\"")]
def middle() -> String { triple.1 }

/// The last of the three, selected by its place.
@[runs("4")]
def last() -> Integer { triple.2 }

/// The pair, named again.
@[runs("*{1, 2}")]
def point_again = point;
