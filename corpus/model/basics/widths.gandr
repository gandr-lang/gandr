// Integers at a stated width: `u32`, `u64`, `i32` and `i64`, each an atom of
// its own. A literal states its width with a suffix and its digits must fit
// it, so no width is the integers and no width is another.

/// An unsigned word at a stated `u32`.
@[ checks ]
def word32 : u32 = 7u32;

/// The greatest `u64`.
@[ runs("18446744073709551615u64") ]
def greatest_u64() -> u64 { 18446744073709551615u64 }

/// The greatest `i32`.
@[ runs("2147483647i32") ]
def greatest_i32() -> i32 { 2147483647i32 }

/// Leading zeros are not part of the value.
@[ runs("7i64") ]
def padded_i64() -> i64 { 007i64 }

/// The identity at `i64`.
@[ checks ]
def same_i64(n : i64) -> i64 { n }

/// A width literal passes through a function at its width unchanged.
@[ runs("42i64") ]
def same_i64_called() -> i64 { same_i64(42i64) }

/// A width is not the integers.
@[ refuses("TypeMismatch") ]
def unbounded_u32 : Integer = 1u32;

/// Nor is one width another.
@[ refuses("TypeMismatch") ]
def narrowed_u64 : u32 = 1u64;

/// One past the greatest `i32` does not fit the width it states.
@[ refuses("MalformedLiteral") ]
def overflowed_i32 = 2147483648i32;
