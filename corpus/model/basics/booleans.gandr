// This source shows Boolean values.
//
// `true` and `false` provide the two units of `Bool`.
// They also stand as patterns.
//
// The checker reads them where it reads `Bool` values.
//
// - see: #1831 — `banded`

/// `banded` accepts bounds in millionths, low below high and high at most one
/// million.
/// It returns `false` when the test fails.
def banded(low : Integer, high : Integer) -> Bool =
  let below = low < high
  match below where
    | true => high <= 1000000
    | false => false

/// This band reverses its bounds. `banded` returns `false`.
@[ runs("+{.1 = *{}}") ]
def inverted() -> Bool { banded 750000 250000 }

/// A band low below high, the high one under one, is one.
@[ runs("+{.0 = *{}}") ]
def ordered() -> Bool { banded 200000 800000 }

/// `true` at a stated `Bool`.
def truth : Bool = true;

/// This pair checks each Boolean literal against its component.
@[ runs("*{+{.0 = *{}}, +{.1 = *{}}}") ]
def both() -> Bool * Bool { *{truth, false} }
