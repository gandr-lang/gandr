// This source shows arithmetic literals and operations.
//
// Integers and widths use literals.
// A definition can name a sum.
//
// The checker needs context to infer an unstated computation type.
//
// - see: #1109 — `floating_atoms`

/// The operators' precedence groups `2 * 3` first. An operator is a
/// computation, and a definition with no stated type reads its value where
/// nothing infers that computation's type.
@[ refuses("NotSynthesisable") ]
def total = 1 + 2 * 3;

/// One number at each integer width a suffix states.
def sized_atoms = *{1u32, *{2u64, *{3i32, 4i64}}};

/// This fixture writes each floating width.
/// The lowering accepts `f64` and does not yet accept `f32`.
@[ refuses("OutOfFragment.typed_number") ]
def floating_atoms = *{1.5f32, 2.5f64};

/// `summed` names the refused `total` declaration.
/// Its type is unknown.
@[ refuses("UnknownConstant") ]
def summed = total;
