// Data arrows state constructors, operations, rules and cells.
//
// A single shaft defines a constructor.
// A double shaft defines an operation.
// A left head makes an arrow invertible.
//
// Constructors build terms.
// Operations form terms.
// Rules compute terms.
// Cells add paths between terms.
//
// - see: `pathological/identity/directed-cell.gandr`

/// `IntOp` has two constructors, two rules and one operation.
/// The rules reduce both compositions to `x`, and the operation unfolds
/// to a predecessor.
@[normalizes("pred(S(S(Z))) ~> S(Z)")]
data IntOp : Type where {
  | Z : IntOp
  | S : (x : IntOp) --> IntOp
  | P : (x : IntOp) --> IntOp
  oper pred : (x : IntOp) --> IntOp;
  rule : P (S x) ==> x;
  rule : x <=> S (P x);
  rule : pred x <=> P x;
}

/// A rule identifies: `S(P(Z))` and `Z` are one term, so reflexivity proves
/// the path between them.
def collapsed : Path(S (P Z), Z) = Path.here Z;

/// The circle: one point and one invertible cell at it, bound as `loop :
/// Path[.A = Circle](Base, Base)`.
data Circle : Type where
  | Base : Circle
  | loop : Base <-> Base

/// A cell adds paths.
/// Its rules make `back(loop)` an inverse and reduce cancellation to
/// the empty word.
def cancelled : Path[.A = Path[.A = Circle](Base, Base)](
  Path.step loop (Path.back loop),
  Path.here Base
) = Path.here (Path.here Base);

/// A cell is not a rule: no rule identifies the loop with the empty word, so
/// reflexivity does not prove it.
@[refuses("EndpointMismatch")]
def notARule : Path[.A = Path[.A = Circle](Base, Base)](
  loop,
  Path.here Base
) = Path.here (Path.here Base);
