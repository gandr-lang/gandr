// The members a data block writes, side by side, and what each arrow does. A
// single shaft builds and a double shaft computes; a left head makes the
// arrow invertible (`surface-lowering`, `module/data`):
//
//   `S : (x : IntOp) --> IntOp`   a constructor: builds a term of the sort
//   `oper pred(x : IntOp) -> IntOp` an operation: a term former the rules compute
//   `rule P(S(x)) ==> x`           a rule: computes its left side to its right
//   `rule x <=> S(P(x))`           an invertible rule: one term spelled two
//                                  ways; the order chooses the direction
//   `loop : Base <-> Base`         an invertible cell: adds a path at a point
//   `loop : Base --> Base`         a directed cell: not minted, refused by name
//                                  (`pathological/identity/directed-cell.gandr`)
//
// A rule collapses terms the constructors build, so the type is their
// quotient; a cell adds a path between points the constructors build, so the
// paths at the point are the words over it. `IntOp` is presented by rules:
// `S(P(x))` is `x`. `Circle` carries a cell: `loop` is apart from `here(Base)`.
// The integers here carry an operation the base's do not, so they are named
// apart from them.

/// The integers: two constructors that cancel, one rule written directed and
/// one invertible, and an operation the rules compute. The directed rule runs
/// `P(S(x))` to `x` and nothing to `P(S(x))`; the invertible rule is read in
/// the direction the order admits, `S(P(x))` to `x`. The operation's own rule
/// unfolds it to a predecessor, which the directed rule then cancels.
@[ normalizes("pred(S(S(Z))) ~> S(Z)") ]
data IntOp : Type {
  Z : IntOp;
  S : (x : IntOp) --> IntOp;
  P : (x : IntOp) --> IntOp;
  oper pred(x : IntOp) -> IntOp;
  rule P(S(x)) ==> x;
  rule x <=> S(P(x));
  rule pred(x) <=> P(x);
}

/// A rule identifies: `S(P(Z))` and `Z` are one term, so reflexivity proves
/// the path between them.
@[ checks ]
def collapsed : Path(IntOp, S(P(Z)), Z) = here(Z);

/// The circle: one point and one invertible cell at it, bound as `loop :
/// Path(Circle, Base, Base)`.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// A cell adds: the loop's inverse is `back(loop)`, and the cancellation
/// `loop then back(loop)` is the empty word by the rules the cell mints on
/// its words.
@[ checks ]
def cancelled : Path(
  Path(Circle, Base, Base),
  loop then back(loop),
  here(Base)
) = here(here(Base));

/// A cell is not a rule: no rule identifies the loop with the empty word, so
/// reflexivity does not prove it.
@[ refuses("EndpointMismatch") ]
def notARule : Path(Path(Circle, Base, Base), loop, here(Base)) = here(here(Base));
