// Family arguments classify constructors.
//
// A data family gives each argument its type.
// Earlier arguments instantiate that type.
//
// `Inl(a)` needs no annotation in `Tagged(Integer, String, Inl(a))`.
//
// - see: #421

/// Two summands.
data SumOb(a : Type, b : Type) : Type where
  | Inl : (x : a) --> SumOb a b
  | Inr : (y : b) --> SumOb a b

/// A tag over a summand of the two types before it.
data Tagged(l : Type, r : Type, s : SumOb l r) : Type where
  | Tag : (n : Integer) --> Tagged l r s

/// Each summand stands as the family's third argument, at its place's type.
def keptTagged(
  a : Integer,
  b : String,
  t : Tagged Integer String (Inl a),
  u : Tagged Integer String (Inr b)
) -> Tagged Integer String (Inl a) =
  t

/// A `String` is no left summand of `SumOb(Integer, String)`.
@[refuses("TypeMismatch")]
def misplaced(b : String, t : Tagged Integer String (Inl b)) -> Integer =
  0
