// The folds over a polymorphic list — its length, appending and mapping — in
// each spelling an arm admits: a `return` after a `run`, the same with both
// elided, and the recursive call nested in the constructor it returns. A
// structural recursive call stands one stage below the list it was read from
// (Abel, _Termination checking with types_, doi:10.1051/ita:2004015); the
// list is the polymorphic one of Martin-Löf's type theory. They run at the
// naturals in `recursive-nat-lists.gandr`.

// The naturals and the lists.
import "./data-base.gandr" ;

/// The length of a list, returned.
@[ checks ]
def rec length(a : Type, xs : List(a)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => { run r <- length[<](a, rest); Succ(r) }
  }
}

/// The length of a list, the `return`s elided.
@[ checks ]
def rec length_elided(a : Type, xs : List(a)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => { run r <- length_elided[<](a, rest); Succ(r) }
  }
}

/// The length of a list, the recursive call nested in the successor.
@[ checks ]
def rec length_nested(a : Type, xs : List(a)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length_nested[<](a, rest))
  }
}

/// Appending two lists, returned.
@[ checks ]
def rec append(a : Type, ys : List(a), xs : List(a)) -> -F List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => { run r <- append[<](a, ys, rest); (Cons(x, r) : List(a)) }
  }
}

/// Appending two lists, the `return`s elided.
@[ checks ]
def rec append_elided(a : Type, ys : List(a), xs : List(a)) -> -F List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => { run r <- append_elided[<](a, ys, rest); (Cons(x, r) : List(a)) }
  }
}

/// Appending two lists, the recursive call nested in the constructor.
@[ checks ]
def rec append_nested(a : Type, ys : List(a), xs : List(a)) -> -F List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append_nested[<](a, ys, rest)) : List(a))
  }
}

/// Mapping a function over a list, returned.
@[ checks ]
def rec map(a : Type, b : Type, f : a => b, xs : List(a)) -> -F List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(
      x,
      rest
    ) => { run y <- f(x); run r <- map[<](a, b, f, rest); (Cons(y, r) : List(b)) }
  }
}

/// Mapping a function over a list, the `return`s elided.
@[ checks ]
def rec map_elided(a : Type, b : Type, f : a => b, xs : List(a)) -> -F List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(
      x,
      rest
    ) => { run y <- f(x); run r <- map_elided[<](a, b, f, rest); (Cons(y, r) : List(b)) }
  }
}

/// Mapping over a list, both calls nested in the constructor.
@[ checks ]
def rec map_nested(a : Type, b : Type, f : a => b, xs : List(a)) -> -F List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(x, rest) => (Cons(f(x), map_nested[<](a, b, f, rest)) : List(b))
  }
}
