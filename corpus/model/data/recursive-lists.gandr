// The folds over a polymorphic list — its length, appending and mapping — in
// the spellings an arm admits, each as the sugared form writes it: a `run`
// that only sequences a call, its result returned or the `return` elided, is
// written with the call nested in the constructor it returns. A structural
// recursive call stands one stage below the list it was read from (Abel,
// _Termination checking with types_, doi:10.1051/ita:2004015); the list is
// the polymorphic one of Martin-Löf's type theory. They run at the naturals
// in `recursive-nat-lists.gandr`.

// The naturals and the lists.
import "./data-base.gandr" ;

/// The length of a list, returned, the run written at its read.
@[ checks ]
def rec length(a : Type, xs : List(a)) -> Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length[<](a, rest))
  }
}

/// The length of a list, the `return`s elided, the run written at its read.
@[ checks ]
def rec length_elided(a : Type, xs : List(a)) -> Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length_elided[<](a, rest))
  }
}

/// The length of a list, the recursive call nested in the successor.
@[ checks ]
def rec length_nested(a : Type, xs : List(a)) -> Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length_nested[<](a, rest))
  }
}

/// Appending two lists, returned, the run written at its read.
@[ checks ]
def rec append(a : Type, ys : List(a), xs : List(a)) -> List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append[<](a, ys, rest)) : List(a))
  }
}

/// Appending two lists, the `return`s elided, the run written at its read.
@[ checks ]
def rec append_elided(a : Type, ys : List(a), xs : List(a)) -> List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append_elided[<](a, ys, rest)) : List(a))
  }
}

/// Appending two lists, the recursive call nested in the constructor.
@[ checks ]
def rec append_nested(a : Type, ys : List(a), xs : List(a)) -> List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append_nested[<](a, ys, rest)) : List(a))
  }
}

/// Mapping a function over a list, returned, the runs written at their reads.
@[ checks ]
def rec map(a : Type, b : Type, f : a => b, xs : List(a)) -> List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(x, rest) => (Cons(f(x), map[<](a, b, f, rest)) : List(b))
  }
}

/// Mapping a function over a list, the `return`s elided, the runs written at
/// their reads.
@[ checks ]
def rec map_elided(a : Type, b : Type, f : a => b, xs : List(a)) -> List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(x, rest) => (Cons(f(x), map_elided[<](a, b, f, rest)) : List(b))
  }
}

/// Mapping over a list, both calls nested in the constructor.
@[ checks ]
def rec map_nested(a : Type, b : Type, f : a => b, xs : List(a)) -> List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(x, rest) => (Cons(f(x), map_nested[<](a, b, f, rest)) : List(b))
  }
}
