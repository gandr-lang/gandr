/// This source calls recursions staged past their first parameter at named values.
///
/// It pins how the kernel unfolds a constant at a staged fixpoint's gate.
///
/// The lowering stages `le` under its second-parameter case. Its fixpoint takes
/// the first parameter as a leading argument. At a named value, the fixpoint
/// stops at the gate. The checker unfolds the name there. The kernel replays
/// this step at the staged argument before the gate opens.
///
/// - see: #3387
/// - see: #626
import "./data-base.gandr";

/// One, named.
def oneByName : Nat = Succ Zero;

/// Whether the first natural is at most the second.
def rec le(a : Nat, b : Nat) -> Bool =
  match a where
    | Zero => true
    | Succ(p) => match b where
      | Zero => false
      | Succ(q) => le[<] p q

/// Zero is at most one, the second argument through the name.
def zeroAtMostOne : Path(le Zero oneByName, true) = Path.here true;

/// One is at most one, both arguments through the name.
def oneAtMostOne : Path(le oneByName oneByName, true) = Path.here true;

/// Zero is at most three, a name reached through the name `two`.
def zeroAtMostThree : Path(le Zero three, true) = Path.here true;

/// One is at most three, the gate opening on a name at each call.
def oneAtMostThree : Path(le oneByName three, true) = Path.here true;

/// Three is not at most one.
def threeAboveOne : Path(le three oneByName, false) = Path.here false;

/// `leBoth` checks the first natural against each later natural.
/// It recurses on the third natural.
def rec leBoth(a : Nat, b : Nat, c : Nat) -> Bool =
  match a where
    | Zero => true
    | Succ(p) => match b where
      | Zero => false
      | Succ(q) => match c where
        | Zero => false
        | Succ(r) => leBoth[<] p q r

/// Zero comes first, and the third reaches its gate through a name.
def zeroFirst : Path(leBoth Zero oneByName three, true) = Path.here true;

/// Positive binary numerals, the high bit outermost.
data Pos : Type where
  /// One.
  | H : Pos
  /// Twice `p`.
  | O : (p : Pos) --> Pos
  /// Twice `p`, and one.
  | I : (p : Pos) --> Pos

/// How two positives compare.
data Cmp : Type where
  /// The first is below the second.
  | Lt : Cmp
  /// The two are equal.
  | Eq : Cmp
  /// The first is above the second.
  | Gt : Cmp

/// Two, named.
def twoPos : Pos = O H;

/// Compare two positives low bit first, `k` the verdict the lower bits gave.
def rec cmpPos(a : Pos, b : Pos, k : Cmp) -> Cmp =
  match a where
    | H => match b where
      | H => k
      | O(q) => Lt
      | I(q) => Lt
    | O(p) => match b where
      | H => Gt
      | O(q) => cmpPos[<] p q k
      | I(q) => cmpPos[<] p q Lt
    | I(p) => match b where
      | H => Gt
      | O(q) => cmpPos[<] p q Gt
      | I(q) => cmpPos[<] p q k

/// One is below two, the second positive through the name.
def oneBelowTwo : Path(cmpPos H twoPos Eq, Lt) = Path.here Lt;
