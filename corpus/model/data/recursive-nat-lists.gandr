// The folds over a list of naturals — its length, appending and mapping — in
// the spellings an arm admits, each as the sugared form writes it: a `run`
// that only sequences a call, its result returned or the `return` elided, is
// written with the call nested in the constructor, and a `run` written inside
// a constructor's field stays. Each spelling of one fold runs to the same
// value, and the polymorphic length of `recursive-lists.gandr` checks at the
// naturals. A structural recursive call stands one stage below the list it
// was read from (Abel, _Termination checking with types_,
// doi:10.1051/ita:2004015).

// The naturals, the numerals two and three, and the lists.
import "./data-base.gandr" ;

// The polymorphic length, read at the naturals.
import "./recursive-lists.gandr" ;

/// The length of a list of naturals, returned, the run written at its read.
@[ checks ]
def rec length_nat(xs : List(Nat)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length_nat[<](rest))
  }
}

/// The length of a list of naturals, the `return`s elided, the run written
/// at its read.
@[ checks ]
def rec length_nat_elided(xs : List(Nat)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length_nat_elided[<](rest))
  }
}

/// Appending lists of naturals, returned, the run written at its read.
@[ checks ]
def rec append_nat(ys : List(Nat), xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append_nat[<](ys, rest)) : List(Nat))
  }
}

/// Appending lists of naturals, the `return`s elided, the run written at its
/// read.
@[ checks ]
def rec append_nat_elided(ys : List(Nat), xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append_nat_elided[<](ys, rest)) : List(Nat))
  }
}

/// Mapping over a list of naturals, returned, the runs written at their reads.
@[ checks ]
def rec map_nat(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(f(x), map_nat[<](f, rest)) : List(Nat))
  }
}

/// Mapping over a list of naturals, the `return`s elided, the runs written at
/// their reads.
@[ checks ]
def rec map_nat_elided(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(f(x), map_nat_elided[<](f, rest)) : List(Nat))
  }
}

/// Mapping over a list of naturals, both calls nested.
@[ checks ]
def rec map_nat_nested(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(f(x), map_nat_nested[<](f, rest)) : List(Nat))
  }
}

/// Mapping over a list of naturals, both calls written `run` in the fields.
@[ checks ]
def rec map_nat_run(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(run f(x), run map_nat_run[<](f, rest)) : List(Nat))
  }
}

/// Two, then zero.
@[ runs("Cons(Succ(Succ(Zero)), Cons(Zero, Nil))") ]
def small : List(Nat) = (Cons(two, (Cons(Zero, (Nil : List(Nat))) : List(Nat))) : List(Nat)) ;

/// The successor, returned.
@[ runs("fn (a) { Succ(a) }") ]
def bump(n : Nat) -> -F Nat { Succ(n) }

/// The successor, the `return` elided.
@[ runs("fn (a) { Succ(a) }") ]
def bump_elided(n : Nat) -> -F Nat { Succ(n) }

/// The length of `small`.
@[ runs("Succ(Succ(Zero))") ]
def counted() -> -F Nat { become length_nat(small) }

/// The length of `small`, the `return`s elided.
@[ runs("Succ(Succ(Zero))") ]
def counted_elided : () => Nat = length_nat_elided(small) ;

/// `small` with three appended at its head.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Succ(Zero)), Cons(Zero, Nil)))") ]
def joined() -> -F List(Nat) {
  become append_nat(small, (Cons(three, (Nil : List(Nat))) : List(Nat)))
}

/// The same append, the `return`s elided.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Succ(Zero)), Cons(Zero, Nil)))") ]
def joined_elided : () => List(Nat) = append_nat_elided(
  small,
  (Cons(three, (Nil : List(Nat))) : List(Nat))
) ;

/// Each element of `small` bumped.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped() -> -F List(Nat) { become map_nat(bump, small) }

/// The same map, the `return`s elided.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped_elided : () => List(Nat) = map_nat_elided(bump_elided, small) ;

/// The same map, the calls nested.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped_nested : () => List(Nat) = map_nat_nested(bump, small) ;

/// The same map, the calls run in the fields.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped_run : () => List(Nat) = map_nat_run(bump, small) ;

/// The length of `small` at its element type, returned.
@[ checks ]
def lengthened() -> -F Nat { become length(Nat, small) }

/// The same length, the `return`s elided.
@[ checks ]
def lengthened_elided : () => Nat = length_elided(Nat, small) ;
