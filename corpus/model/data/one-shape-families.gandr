// Two data families of one shape are distinct types, equal only along the
// path a stated equivalence makes between them. `Celsius` and `Fahrenheit`
// each wrap an integer; the relabelling maps each constructor to the other's,
// and transport along `ua` of that equivalence carries `Cel(20)` to `Fah(20)`
// by a run: the HoTT book's § 2.10, Lemma 2.10.5, transport along `ua(e)` is
// `e`. The twin, `pathological/data/nominal-distinctness.gandr`, refuses the
// same value read as `Fahrenheit` with no path written.

/// A temperature in Celsius.
@[ checks ]
data Celsius : Type {
  Cel : (x : Integer) --> Celsius;
}

/// A temperature in Fahrenheit, of the same shape.
@[ checks ]
data Fahrenheit : Type {
  Fah : (x : Integer) --> Fahrenheit;
}

/// The relabelling forward: a Celsius value to the Fahrenheit value of its
/// integer.
@[ checks ]
def toFahrenheit(c : Celsius) -> -F Fahrenheit {
  case c { Cel(x) => Fah(x) }
}

/// The relabelling back.
@[ checks ]
def toCelsius(f : Fahrenheit) -> -F Celsius {
  case f { Fah(x) => Cel(x) }
}

/// Back after forward is the identity, constructor by constructor.
@[ checks ]
def celsiusRoundTrip(c : Celsius) -> -F Path(Celsius, toCelsius(toFahrenheit(c)), c) {
  case c { Cel(x) => here(Cel(x)) }
}

/// Forward after back is the identity.
@[ checks ]
def fahrenheitRoundTrip(f : Fahrenheit) -> -F Path(Fahrenheit, toFahrenheit(toCelsius(f)), f) {
  case f { Fah(x) => here(Fah(x)) }
}

/// The relabelling is an equivalence, its inverse on either side.
@[ checks ]
def relabel : Celsius ≃ Fahrenheit ;
def relabel = (toFahrenheit, ((toCelsius, celsiusRoundTrip), (toCelsius, fahrenheitRoundTrip))) ;

/// A Celsius value carried along the path the relabelling makes is the
/// Fahrenheit value of its integer, by a run: the book's Lemma 2.10.5.
@[ runs("Fah(20)") ]
def relabelled() -> -F Fahrenheit { transport(\X. X, ua(relabel), Cel(20)) }
