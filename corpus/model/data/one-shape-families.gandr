// Equal-shape data families remain distinct types.
//
// An equivalence path relates `Celsius` and `Fahrenheit`.
// Its relabelling maps each constructor to its counterpart.
//
// Transport along `ua` carries `Cel(20)` to `Fah(20)`.
// A reader uses a path to read the value as `Fahrenheit`.
//
// - see: #2140 — `carriedInTuple`, `carriedInField`, `carriedScrutinised`
// - see: `pathological/data/nominal-distinctness.gandr`

/// A temperature in Celsius.
data Celsius : Type where
  | Cel : (x : Integer) --> Celsius

/// A temperature in Fahrenheit, of the same shape.
data Fahrenheit : Type where
  | Fah : (x : Integer) --> Fahrenheit

/// `toFahrenheit` maps each Celsius value to a Fahrenheit value.
def toFahrenheit(c : Celsius) -> Fahrenheit =
  match c { | Cel(x) => Fah x }

/// The relabelling back.
def toCelsius(f : Fahrenheit) -> Celsius =
  match f { | Fah(x) => Cel x }

/// Back after forward is the identity, constructor by constructor.
def celsiusRoundTrip(c : Celsius) -> Path(toCelsius (toFahrenheit c), c) =
  match c { | Cel(x) => Path.here (Cel x) }

/// Forward after back is the identity.
def fahrenheitRoundTrip(f : Fahrenheit) -> Path(toFahrenheit (toCelsius f), f) =
  match f { | Fah(x) => Path.here (Fah x) }

/// The relabelling is an equivalence, its inverse on either side.
def relabel : Celsius ≃ Fahrenheit = *{
  toFahrenheit,
  *{*{toCelsius, celsiusRoundTrip}, *{toCelsius, fahrenheitRoundTrip}}
};

/// A Celsius value carried along the path the relabelling makes is the
/// Fahrenheit value of its integer, by a run: the book's Lemma 2.10.5.
@[ runs("Fah 20") ]
def relabelled() -> Fahrenheit { Path.walk (fun (X) { X }) (ua relabel) (Cel 20) }

/// The transport written as a tuple's component runs first, and the
/// other component keeps its place.
@[ runs("*{Fah 20, 1}") ]
def carriedInTuple() -> Fahrenheit * Integer {
  *{Path.walk (fun (X) { X }) (ua relabel) (Cel 20), 1}
}

/// `Thermometer` stores one Fahrenheit temperature.
data Thermometer : Type where
  | Reads : (f : Fahrenheit) --> Thermometer

/// The constructor evaluates its transport before it builds `Reads`.
@[ runs("Reads (Fah 20)") ]
def carriedInField() -> Thermometer { Reads (Path.walk (fun (X) { X }) (ua relabel) (Cel 20)) }

/// A case on the transport runs it, then the arm its answer selects.
@[ runs("20") ]
def carriedScrutinised() -> Integer =
  match Path.walk (fun (X) { X }) (ua relabel) (Cel 20) { | Fah(x) => x }

/// Another Celsius value carried along the same path. No signature states its
/// type: the transport's own type is `Fahrenheit`.
@[ runs("Fah 36") ]
def carried = Path.walk (fun (X) { X }) (ua relabel) (Cel 36);
