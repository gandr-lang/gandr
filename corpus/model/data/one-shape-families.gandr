// Two data families of one shape are distinct types, equal only along the
// path a stated equivalence makes between them. `Celsius` and `Fahrenheit`
// each wrap an integer; the relabelling maps each constructor to the other's,
// and transport along `ua` of that equivalence carries `Cel(20)` to `Fah(20)`
// by a run: the HoTT book's § 2.10, Lemma 2.10.5, transport along `ua(e)` is
// `e`. The twin, `pathological/data/nominal-distinctness.gandr`, refuses the
// same value read as `Fahrenheit` with no path written.

/// A temperature in Celsius.
data Celsius : Type {
  Cel : (x : Integer) --> Celsius;
}

/// A temperature in Fahrenheit, of the same shape.
data Fahrenheit : Type {
  Fah : (x : Integer) --> Fahrenheit;
}

/// The relabelling forward: a Celsius value to the Fahrenheit value of its
/// integer.
def toFahrenheit(c : Celsius) -> Fahrenheit {
  case c { Cel(x) => Fah(x) }
}

/// The relabelling back.
def toCelsius(f : Fahrenheit) -> Celsius {
  case f { Fah(x) => Cel(x) }
}

/// Back after forward is the identity, constructor by constructor.
def celsiusRoundTrip(c : Celsius) -> Path(Celsius, toCelsius(toFahrenheit(c)), c) {
  case c { Cel(x) => here(Cel(x)) }
}

/// Forward after back is the identity.
def fahrenheitRoundTrip(f : Fahrenheit) -> Path(Fahrenheit, toFahrenheit(toCelsius(f)), f) {
  case f { Fah(x) => here(Fah(x)) }
}

/// The relabelling is an equivalence, its inverse on either side.
def relabel : Celsius ≃ Fahrenheit = (
  toFahrenheit,
  ((toCelsius, celsiusRoundTrip), (toCelsius, fahrenheitRoundTrip))
);

/// A Celsius value carried along the path the relabelling makes is the
/// Fahrenheit value of its integer, by a run: the book's Lemma 2.10.5.
@[ runs("Fah(20)") ]
def relabelled() -> Fahrenheit { transport(\X. X, ua(relabel), Cel(20)) }

/// #2140: the transport written as a tuple's component runs first, and the
/// other component keeps its place.
@[ runs("(Fah(20), 1)") ]
def carriedInTuple() -> Fahrenheit * Integer { (transport(\X. X, ua(relabel), Cel(20)), 1) }

/// A thermometer reading one Fahrenheit temperature.
data Thermometer : Type {
  Reads : (f : Fahrenheit) --> Thermometer;
}

/// #2140: the transport written as a constructor's field runs before the
/// constructor is built.
@[ runs("Reads(Fah(20))") ]
def carriedInField() -> Thermometer { Reads(transport(\X. X, ua(relabel), Cel(20))) }

/// #2140: a case on the transport runs it, then the arm its answer selects.
@[ runs("20") ]
def carriedScrutinised() -> Integer {
  case transport(\X. X, ua(relabel), Cel(20)) { Fah(x) => x }
}

/// Another Celsius value carried along the same path. No signature states its
/// type: the transport's own type is `Fahrenheit`.
@[ runs("Fah(36)") ]
def carried = transport(\X. X, ua(relabel), Cel(36));
