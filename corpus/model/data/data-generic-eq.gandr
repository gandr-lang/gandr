// Equality derived from a data type's constructors (#2302): a definition
// written `Eq.generic(T)` is structural equality over `T`, the checker
// judging it as any declaration. Integers and strings compare by their
// primitives, a sum by its side, a field of `T` itself recursively and a field
// of another such type by that type's equality, written in place.
//
// `Eq.generic.refl(T)` and `Eq.generic.sym(T)` prove that equality's laws by
// congruence over `T`'s constructors, resting on the laws the host admits of
// integer and string equality, so a model of `Eq` whose members are derived
// puts `T` under `==`. A field of a sum, as `Mark`'s flag, or of `T` itself,
// as `Peano`'s, takes a proof the derivation does not write; the refusals are
// beside `../../pathological/data/generic-eq-refused.gandr`.

/// A point in the plane.
data Point : Type {
  Point : (x : Integer, y : Integer) --> Point;
}

/// Unary naturals.
data Peano : Type {
  Nought : Peano;
  Next : (n : Peano) --> Peano;
}

/// A labelled position: a count, a point, a flag and a name.
data Mark : Type {
  Mark : (count : Peano, place : Point, shown : Bool, label : String) --> Mark;
}

/// Points compared field by field.
def eqPoint = Eq.generic(Point);

/// Every point is equal to itself under `eqPoint`.
def reflPoint = Eq.generic.refl(Point);

/// Naturals compared structurally, at the type the derivation states.
def eqPeano : (Peano, Peano) => Bool = Eq.generic(Peano);

/// Marks compared field by field, the count and the point by their own
/// equality.
def eqMark = Eq.generic(Mark);

/// Points under `==`, every member derived.
module EqPoint : Model(Eq) with sort Carrier = Point {
  /// Field by field.
  @[ checks ]
  def eq = Eq.generic(Point);
  /// Each coordinate by the host's reflexivity.
  @[ checks ]
  def refl = Eq.generic.refl(Point);
  /// Each coordinate by the host's symmetry.
  @[ checks ]
  def sym = Eq.generic.sym(Point);
}

/// One point is itself.
@[ runs("+{.0 = unit}") ]
def samePoint() -> Bool { eqPoint(Point(1, 2), Point(1, 2)) }

/// Two points with their coordinates swapped differ.
@[ runs("+{.1 = unit}") ]
def swappedPoint() -> Bool { eqPoint(Point(1, 2), Point(2, 1)) }

/// Two is two.
@[ runs("+{.0 = unit}") ]
def samePeano() -> Bool { eqPeano(Next(Next(Nought)), Next(Next(Nought))) }

/// One is not two: the recursion reaches the nought on one side only.
@[ runs("+{.1 = unit}") ]
def shorterPeano() -> Bool { eqPeano(Next(Nought), Next(Next(Nought))) }

/// Two marks alike in every field.
@[ runs("+{.0 = unit}") ]
def sameMark() -> Bool {
  eqMark(
    Mark(Next(Nought), Point(3, 4), true, "here"),
    Mark(Next(Nought), Point(3, 4), true, "here")
  )
}

/// Two marks apart in their point alone.
@[ runs("+{.1 = unit}") ]
def movedMark() -> Bool {
  eqMark(
    Mark(Next(Nought), Point(3, 4), true, "here"),
    Mark(Next(Nought), Point(3, 5), true, "here")
  )
}

/// Two marks apart in their flag alone.
@[ runs("+{.1 = unit}") ]
def hiddenMark() -> Bool {
  eqMark(
    Mark(Next(Nought), Point(3, 4), true, "here"),
    Mark(Next(Nought), Point(3, 4), false, "here")
  )
}

/// Two marks apart in their label alone.
@[ runs("+{.1 = unit}") ]
def relabelledMark() -> Bool {
  eqMark(
    Mark(Next(Nought), Point(3, 4), true, "here"),
    Mark(Next(Nought), Point(3, 4), true, "there")
  )
}

/// One point is itself under `==`.
@[ runs("+{.0 = unit}") ]
def samePointUnderEq() -> Bool { Point(1, 2) == Point(1, 2) }

/// Two points apart in one coordinate under `==`.
@[ runs("+{.1 = unit}") ]
def movedPointUnderEq() -> Bool { Point(1, 2) == Point(1, 3) }
