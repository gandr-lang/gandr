// A case whose scrutinee no name types, a comparison bound by `run`, cased
// on by indexed sum patterns: arms covering `.0` to `.n-1` between them
// settle the sum they inject into, so a case on a boolean as the printer
// writes it reads back (#1169).

/// One for a value below 128 and two otherwise, cased on as the boolean.
def written(c : Integer) -> Integer {
  run small <- c < 128;
  case small {
    true => 1,
    false => 2
  }
}

/// The same case as the printer writes it, each arm an index of the sum the
/// boolean stands for.
def printed(c : Integer) -> Integer {
  run small <- c < 128;
  case small {
    +{.0 = u} => 1,
    +{.1 = u} => 2
  }
}

/// An arm that matches anything leaves the sum's width open, so the arms
/// settle no sum and the scrutinee still needs its type (#1169).
@[ refuses("OutOfFragment.Unannotated") ]
def open(c : Integer) -> -F Integer {
  run small <- c < 128;
  case small {
    +{.0 = u} => return 1,
    _ => return 2
  }
}
