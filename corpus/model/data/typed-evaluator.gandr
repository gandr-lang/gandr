// A typed evaluator indexes each expression by the object type of its value.
//
// The evaluator then returns the meaning of that type. No check at run time
// reads a tag. The type of each arm states its result.
//
// A case on an expression solves each arm's index equation. An arm's goal then
// reads the arm's own index. A branch of the recursion's stage moves along that
// equation by its own transport. The object types form a set. So the transport
// keeps the branch's stage.
//
// - see: #3483 — refinement by solution, by which `eval` checks
// - see: #3631 — a staged branch keeps its stage across its index equation, by
//   which `evalInt` checks
// - see: #3481 — the spike that wrote these programs

/// The object language's types.
data Ty : Type {
  /// Integers.
  TInt : Ty;
  /// Booleans.
  TBool : Ty;
}

/// The meaning of an object type, by a case on its code.
def meaning(t : Ty) -> Type {
  case t {
    TInt => return Integer,
    TBool => return Bool
  }
}

/// Expressions, indexed by the type they evaluate to.
data Expr : Ty -> Type {
  /// An integer literal.
  Lit : (i : Integer) --> Expr(TInt);
  /// A boolean literal.
  BoolLit : (b : Bool) --> Expr(TBool);
  /// The sum of two integer expressions.
  Add : (l : Expr(TInt), r : Expr(TInt)) --> Expr(TInt);
  /// A choice between two expressions of one type.
  If : (t : Ty, c : Expr(TBool), y : Expr(t), n : Expr(t)) --> Expr(t);
}

/// The evaluator, each arm's result the meaning of its index. The `Lit` arm
/// solves its path from `TInt` to `t`, so its integer meets `meaning(TInt)`.
def rec eval(t : Ty, e : Expr(t)) -> meaning(t) {
  case e {
    Lit(i) => i,
    BoolLit(b) => b,
    Add(l, r) => eval[<](TInt, l) + eval[<](TInt, r),
    If(u, c, y, n) => if eval[<](TBool, c) { eval[<](u, y) } else { eval[<](u, n) }
  }
}

/// The evaluator at integers alone. Its `If` branch `y` keeps its stage below
/// `e` across the path from `u` to `TInt`.
def rec evalInt(e : Expr(TInt)) -> Integer {
  case e {
    Lit(i) => i,
    Add(l, r) => evalInt[<](l) + evalInt[<](r),
    If(u, _, y, _) => evalInt[<](y)
  }
}

/// The integer evaluator at a choice between a sum and a literal. It runs the
/// sum.
@[ runs("3") ]
def evalSample() -> Integer { evalInt(If(TInt, BoolLit(true), Add(Lit(1), Lit(2)), Lit(0))) }
