// Descent on the parameter a definition's matches take apart (#518). A
// recursive definition descends on the parameter the innermost match above
// each of its claims scrutinises: the first one, with the accumulator after it
// varying from call to call, or a value rebuilt from the match's fields, so
// long as it stands below the parameter the match took apart. The parameters
// before the staged one are passed unchanged; descent on two parameters at
// once is the sized rung's (#392). What refuses is in
// `../../pathological/data/descent.gandr`.

// The naturals and the numerals two and three.
import "./data-base.gandr" ;

/// Addition by recursion on the first argument, the second an accumulator
/// each call grows: `plus(Succ(p), n) = plus(p, Succ(n))`.
@[ checks ]
def rec plusFirst(m : Nat, n : Nat) -> -F Nat {
  case m {
    Zero => n,
    Succ(p) => plusFirst[<](p, Succ(n))
  }
}

/// Half a number, rounded down: the inner match takes apart the outer one's
/// field, so the call on its field still descends on `n`.
@[ checks ]
def rec half(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(m) => case m {
      Zero => Zero,
      Succ(q) => Succ(half[<](q))
    }
  }
}

/// Fibonacci numbers: the first call rebuilds `Succ(q)` from the inner
/// match's field, a value below `n` though not one of its fields.
@[ checks ]
def rec fib(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(m) => case m {
      Zero => Succ(Zero),
      Succ(q) => plusFirst(fib[<](Succ(q)), fib[<](q))
    }
  }
}

/// A list reversed onto an accumulator, the element type passed unchanged:
/// the accumulator each call grows is a constructor written bare, its type
/// read off the parameter it fills, the element type standing for itself
/// (#2127).
@[ checks ]
def rec reverseOnto(a : Type, xs : List(a), acc : List(a)) -> -F List(a) {
  case xs {
    Nil => acc,
    Cons(x, rest) => reverseOnto[<](a, rest, Cons(x, acc))
  }
}

/// Two lists summed pairwise, a zero in the first skipped: the walk descends
/// on `xs` and consumes `ys` alongside it, so the call under the match on
/// `ys` still descends on `xs`, the parameter a match above it takes apart
/// (#2135).
@[ checks ]
def rec pairwise(xs : List(Integer), ys : List(Integer)) -> -F List(Integer) {
  case xs {
    Nil => Nil,
    Cons(x, rest) => case x == 0 {
      true => pairwise[<](rest, ys),
      false => case ys {
        Nil => Nil,
        Cons(y, more) => Cons(x + y, pairwise[<](rest, more))
      }
    }
  }
}

/// Four.
@[ runs("Succ(Succ(Succ(Succ(Zero))))") ]
def four : Nat = Succ(three) ;

/// Two and three by the accumulator: five.
@[ runs("Succ(Succ(Succ(Succ(Succ(Zero)))))") ]
def five_accumulated : () => Nat = plusFirst(two, three) ;

/// Half of four.
@[ runs("Succ(Succ(Zero))") ]
def halved : () => Nat = half(four) ;

/// The fourth Fibonacci number, three.
@[ runs("Succ(Succ(Succ(Zero)))") ]
def fibbed : () => Nat = fib(four) ;

/// Two and three reversed: three, then two.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Succ(Zero)), Nil))") ]
def reversed : () => List(Nat) = reverseOnto(Nat, Cons(two, Cons(three, Nil)), Nil) ;

/// One, zero and two summed with ten and twenty: the zero is skipped.
@[ runs("Cons(11, Cons(22, Nil))") ]
def sumsSkippingZero : () => List(Integer) = pairwise(
  Cons(1, Cons(0, Cons(2, Nil))),
  Cons(10, Cons(20, Nil))
) ;
