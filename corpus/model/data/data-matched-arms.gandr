// The arms a match may write besides one constructor each: a wildcard that
// takes every constructor the arms before it left, an or-pattern that shares
// one body between constructors, and a pattern nested inside a constructor's
// field (Augustsson, _Compiling pattern matching_,
// doi:10.1007/3-540-15975-4_48).

// The three colours.
import "./data-base.gandr";

/// Red apart from the rest: one arm, then a wildcard for the others.
def notRed(c : Color) -> Integer {
  case c {
    Red => 0,
    _ => 1
  }
}

/// The warm colours, two constructors sharing one arm.
def warm(c : Color) -> Integer {
  case c {
    Red | Green => 1,
    Blue => 0
  }
}

/// An optional integer.
data Inner : Type {
  No : Inner;
  Yes : (n : Integer) --> Inner;
}

/// An optional `Inner`, so a match can reach two constructors deep.
data Outer : Type {
  None : Outer;
  Some : (i : Inner) --> Outer;
}

/// The integer two constructors down, or zero: the first arm's pattern nests
/// `Yes` inside `Some`.
def depth(m : Outer) -> Integer {
  case m {
    Some(Yes(n)) => n,
    Some(No) => 0,
    None => 0
  }
}

/// An inner value, annotated with its type.
def inner = (Yes(41) : Inner);

/// The inner value wrapped once more.
def answer = (Some(inner) : Outer);
