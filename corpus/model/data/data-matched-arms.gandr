//! Matches support wildcard, or and nested patterns.
//!
//! A wildcard covers constructors that prior arms omit.
//! Or patterns share one arm.
//!
//! Nested patterns inspect a constructor field.
//!
//! - cites: [Augustsson-1985-compiling_pattern_matching]
//!
//! [Augustsson-1985-compiling_pattern_matching]: https://doi.org/10.1007/3-540-15975-4_48 "Augustsson, Compiling pattern matching"

// The three colours.
import "./data-base.gandr";

/// Red apart from the rest: one arm, then a wildcard for the others.
def notRed(c : Color) -> Integer =
  match c where
    | Red => 0
    | _ => 1

/// The `Red` and `Green` constructors share one arm.
def warm(c : Color) -> Integer =
  match c where
    | Red | Green => 1
    | Blue => 0

/// An optional integer.
data Inner : Type where
  | No : Inner
  | Yes : (n : Integer) --> Inner

/// An optional `Inner`, so a match can reach two constructors deep.
data Outer : Type where
  | None : Outer
  | Some : (i : Inner) --> Outer

/// The integer two constructors down, or zero: the first arm's pattern nests
/// `Yes` inside `Some`.
def depth(m : Outer) -> Integer =
  match m where
    | Some(Yes(n)) => n
    | Some(No) => 0
    | None => 0

/// An inner value, annotated with its type.
def inner = (Yes 41 : Inner);

/// This source wraps the inner value once more.
def answer = (Some inner : Outer);
