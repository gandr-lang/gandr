//! The data subject's shared declarations, written once and imported by every
//! source that reads them (`import "./data-base.gandr";`): the free naturals,
//! their addition and the numerals two and three, the integers presented by two
//! cancelling constructors, a three-colour enumeration, the two branches of a
//! binary node and the polymorphic lists. A data block is an inductive type
//! given by its constructors [MartinLof-1984-intuitionistic_type_theory], and a
//! rule between constructor terms quotients it
//! [Altenkirch-2018-quotient_inductive_inductive_types]. The universe subject
//! reads the naturals and the branches from here too.
//!
//! - cites: [Altenkirch-2018-quotient_inductive_inductive_types]
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [Altenkirch-2018-quotient_inductive_inductive_types]: https://doi.org/10.1007/978-3-319-89366-2_16 "Altenkirch et al., Quotient inductive-inductive types"
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

/// Natural numbers, free: every constructor term is its own value.
pub data Nat : Type where
  | Zero : Nat
  | Succ : (n : Nat) --> Nat

/// Addition by recursion on the second argument, the recursive call nested
/// in the successor it returns.
pub def rec plus(n : Nat, m : Nat) -> Nat =
  match m where
    | Zero => n
    | Succ(p) => Succ (plus[<] n p)

/// Two.
@[ runs("Succ (Succ Zero)") ]
pub def two : Nat = Succ (Succ Zero);

/// Three.
@[ runs("Succ (Succ (Succ Zero))") ]
pub def three : Nat = Succ two;

/// The integers as a presented type: a successor and a predecessor that
/// cancel, each rule invertible.
@[ normalizes("S(P(S(Z))) ~> S(Z)") ]
pub data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) <=> x;
  rule : P (S x) <=> x;
}

/// Three colours: an enumeration, a data type whose constructors take no
/// field.
pub data Color : Type where
  | Red : Color
  | Green : Color
  | Blue : Color

/// The two branches of a binary node.
pub data Two : Type where
  | L : Two
  | R : Two

/// Lists of elements of a type `a`. The element stands only where a list
/// holds it, strictly positive, so a family nests through it.
pub data List(a : Type) : Type where
  | Nil : List(a)
  | Cons : (head : a, tail : List(a)) --> List(a)
