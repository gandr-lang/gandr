// A parameter that varies by generator stands as an index of its family.
//
// Head uniformity binds each parameter once, for the whole family. Each
// generator's result applies the family to the parameter variables, in
// order, then to one term per index. So a generator cannot fix a parameter.
//
// The family declares the varying parameter in its index telescope. Each
// generator then states it at its result. A family whose index is a type
// stores that type in a field, so it lives one universe above that type.
//
// - see: #3404

// The naturals the lengths count in.
import "./data-base.gandr";

/// Lists of a type at a length, whose empty list holds integers only.
data Fixed : (a : Type, n : Nat) --> Type[+, 1] where
  /// The empty list of integers.
  | FNil : Fixed Integer Zero
  /// The list `t` with the value `x` before it.
  | FCons : (a : Type, n : Nat, x : a, t : Fixed a n) --> Fixed a (Succ n)

/// The list that holds `7` only.
def seven() -> Fixed Integer (Succ Zero) =
  FCons Integer Zero 7 FNil

/// A pair of two types, indexed by them in the reverse order.
data Swap : (a : Type, b : Type) --> Type[+, 1] where
  /// The values `x` and `y`, indexed by the type of `y` first.
  | MkSwap : (a : Type, b : Type, x : a, y : b) --> Swap b a

/// An integer before a boolean, indexed by the boolean's type first.
def swapped() -> Swap Bool Integer =
  MkSwap Integer Bool 1 true
