// An arm that hands its recursive call to another definition, unfolded at an
// open argument: the call is stuck at the argument's variable, and the arm
// goes on into the other definition's call over it. Each step states one
// unfolding of the recursion as a path, as an arm that returns constructors
// over its call converts (`nested-call-sugar.gandr`). Structural recursion
// unfolds only at a constructor (Abel, _Termination checking with types_,
// doi:10.1051/ita:2004015).

// The naturals the recursion takes apart.
import "./data-base.gandr" ;

/// Two successors over a natural.
@[ checks ]
def plusTwo(n : Nat) -> Nat {
  Succ(Succ(n))
}

/// Doubling, its arm handing the recursive call to `plusTwo`.
@[ checks ]
def rec double(n : Nat) -> Nat {
  case n {
    Zero => Zero,
    Succ(m) => plusTwo(double[<](m))
  }
}

/// Two doubled.
@[ runs("Succ(Succ(Succ(Succ(Zero))))") ]
def doubledTwo : () => Nat = double(two) ;

/// One step of `double` is `plusTwo` of the call, as the arm writes it
/// (#761).
@[ checks ]
def doubleStep(n : Nat) -> Path(Nat, double(Succ(n)), plusTwo(double(n))) {
  here(plusTwo(double(n)))
}

/// The same step with `plusTwo` unfolded: two successors over the call.
@[ checks ]
def doubleStepUnfolded(n : Nat) -> Path(Nat, double(Succ(n)), Succ(Succ(double(n)))) {
  here(Succ(Succ(double(n))))
}

/// Two steps, each arm handing its call on to `plusTwo`.
@[ checks ]
def doubleTwoSteps(n : Nat) -> Path(Nat, double(Succ(Succ(n))), plusTwo(plusTwo(double(n)))) {
  here(plusTwo(plusTwo(double(n))))
}
