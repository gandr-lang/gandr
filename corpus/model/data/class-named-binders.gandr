// Lexical-class words can bind names.
//
// The parser reads fields, parameters and pattern binders as names.
// The referenced variable uses the same name.
//
// The parser does not read such a binder as a malformed literal.
//
// - see: #1863 — a lexical-class binder that the parser reads as a name

/// `Wrap` has an integer field named `number`.
data Wrap : Type where
  | Wrapped : (number : Integer) --> Wrap

/// The wrapped integer, bound by a binder named `number`.
@[runs("7")]
def unwrapped() -> Integer =
  match (Wrapped 7 : Wrap) where
    | Wrapped(number) => number

/// The wrapped integer, bound by a binder named `constructor`.
@[runs("8")]
def constructed() -> Integer =
  match (Wrapped 8 : Wrap) where
    | Wrapped(constructor) => constructor

/// The wrapped integer, bound by a binder named `character`.
@[runs("9")]
def charactered() -> Integer =
  match (Wrapped 9 : Wrap) where
    | Wrapped(character) => character

/// A literal pattern beside a catch-all binder named `number`: the literal
/// still reads as a number, the binder as a name.
@[runs("1")]
def literal() -> Integer =
  match 3 where
    | 3 => 1
    | number => number
