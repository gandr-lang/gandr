// A match of no arm over a path whose endpoints hold variables. The naturals
// are free: no rule rewrites a term, so two terms whose first difference,
// read side by side, is two distinct constructors are apart whatever their
// variables hold. That is the unifier's conflict rule, disjointness under
// injectivity (Cockx and Devriese, _Proof-relevant unification: dependent
// pattern matching with only the axioms of your type theory_, JFP 2018). A
// presented type's open endpoints are refused, in `absurd-not-apart`.

// The free naturals.
import "./data-base.gandr";

/// Zero is no successor, whatever `n` is: the endpoints differ at their heads.
@[ checks ]
def zeroNotSucc(n : Nat, e : Path(Nat, Zero, Succ(n))) -> Nat {
  case e {}
}

/// One is no successor of a successor: below the successor both endpoints
/// share, `Zero` meets `Succ(n)`.
@[ checks ]
def oneNotPastTwo(n : Nat, e : Path(Nat, Succ(Zero), Succ(Succ(n)))) -> Nat {
  case e {}
}
