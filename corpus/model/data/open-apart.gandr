//! A match of no arm over a path whose endpoints hold variables. The naturals
//! are free: no rule rewrites a term, so two terms whose first difference, read
//! side by side, is two distinct constructors are apart whatever their
//! variables hold. That is the unifier's conflict rule, disjointness under
//! injectivity
//! [Cockx-2018-proofrelevant_unification_dependent_pattern_matching_only_axioms_your_type_theory].
//! A presented type's open endpoints are refused, in `absurd-not-apart`.
//!
//! - cites: [Cockx-2018-proofrelevant_unification_dependent_pattern_matching_only_axioms_your_type_theory]
//!
//! [Cockx-2018-proofrelevant_unification_dependent_pattern_matching_only_axioms_your_type_theory]: https://doi.org/10.1017/S095679681800014X "Cockx and Devriese, Proof-relevant unification: dependent pattern matching with only the axioms of your type theory"

// The free naturals.
import "./data-base.gandr";

/// Zero is no successor, whatever `n` is: the endpoints differ at their heads.
def zeroNotSucc(n : Nat, e : Path(Zero, Succ(n))) -> Nat {
  match e {}
}

/// One is no successor of a successor: below the successor both endpoints
/// share, `Zero` meets `Succ(n)`.
def oneNotPastTwo(n : Nat, e : Path(Succ(Zero), Succ(Succ(n)))) -> Nat {
  match e {}
}
