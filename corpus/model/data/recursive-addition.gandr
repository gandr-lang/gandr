//! Natural-number addition tests recursive sugar.
//!
//! An arm can return a call result or elide `return`.
//! It can also nest a call under a constructor.
//! A field can hold an explicit `run`.
//!
//! Each spelling evaluates to the same value.
//! A structural call uses a smaller term.
//! The list sources use related folds.
//!
//! - cites: [Abel-2004-termination_checking_with_types]
//!
//! [Abel-2004-termination_checking_with_types]: https://doi.org/10.1051/ita:2004015 "Abel, Termination checking with types"

// The naturals, their addition with the recursive call nested, and the
// numerals two and three.
import "./data-base.gandr";

/// This addition returns the recursive result from its `run`.
def rec plus_returned(n : Nat, m : Nat) -> Nat =
  match m where
    | Zero => n
    | Succ(p) => Succ (plus_returned[<] n p)

/// This addition elides `return` at its `run`.
def rec plus_elided(n : Nat, m : Nat) -> Nat =
  match m where
    | Zero => n
    | Succ(p) => Succ (plus_elided[<] n p)

/// Addition with the recursive call written `run` inside the successor.
def rec plus_run(n : Nat, m : Nat) -> Nat =
  match m where
    | Zero => n
    | Succ(p) => Succ (run plus_run[<] n p)

/// This example adds two and three.
@[runs("Succ (Succ (Succ (Succ (Succ Zero))))")]
def five() -> Nat { plus_returned two three }

/// Two and three, added with the `return`s elided.
@[runs("Succ (Succ (Succ (Succ (Succ Zero))))")]
def five_elided : () -> Nat = plus_elided two three;

/// Two and three, added with the call nested.
@[runs("Succ (Succ (Succ (Succ (Succ Zero))))")]
def five_nested : () -> Nat = plus two three;

/// Two and three, added with the call run in the field.
@[runs("Succ (Succ (Succ (Succ (Succ Zero))))")]
def five_run : () -> Nat = plus_run two three;

/// One more than two and three, the nested addition inside a successor.
@[runs("Succ (Succ (Succ (Succ (Succ (Succ Zero)))))")]
def six() -> Nat { Succ (plus two three) }
