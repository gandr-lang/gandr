//! η for products and records: a pair is the pair of its own projections and a
//! record the record of its own fields, as a function is the abstraction of its
//! own application [MartinLof-1984-intuitionistic_type_theory]. A neutral at a
//! product, a record or a dependent pair converts to the tuple of its
//! projections on either side, so reflexivity at the neutral proves the path.
//!
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

/// A pair is the pair of its projections.
def etaPair(e : Integer * Integer) -> Path(Integer * Integer, (e.0, e.1), e) {
  Path.here(e)
}

/// The pair of projections stands on either side.
def etaPairRight(e : Integer * Integer) -> Path(Integer * Integer, e, (e.0, e.1)) {
  Path.here(e)
}

/// A record is the record of its fields.
def etaRecord(e : #{r : Integer}) -> Path(#{r : Integer}, #{.r = e.r}, e) {
  Path.here(e)
}

/// A record of two fields, each read by its label.
def etaRecordTwo(e : #{l : Integer, r : Integer}) -> Path(
  #{l : Integer, r : Integer},
  #{.l = e.l, .r = e.r},
  e
) {
  Path.here(e)
}

/// A dependent pair, the second component's type reading the first, is the
/// pair of its components.
def etaFiber(e : #{n : Integer, v : Path(Integer, n, n)}) -> Path(
  #{n : Integer, v : Path(Integer, n, n)},
  (e.n, e.v),
  e
) {
  Path.here(e)
}
