// A parameterised data type nests inside another type's argument: a list of
// optional integers. `Maybe` is the one `data-maybe.gandr` declares.

import "./data-maybe.gandr";

/// Binds a list of optional integers, then returns. The list is annotated
/// where it is run as a value, and each element takes the element type,
/// `Maybe(Integer)`, from that annotation (#1544).
@[ checks ]
def sum_first() -> Integer {
  run items <- pure ([Some(1), None, Some(3)] : List(Maybe(Integer)));
  7
}

/// The run target calls `sum_first`.
@[ runs("7") ]
sum_first()
