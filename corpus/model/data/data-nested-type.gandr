// A parameterised data type can nest in a type argument.
//
// `sum_first` uses a list of optional integers.
//
// `Maybe` comes from `data-maybe.gandr`.
//
// - see: #1544 — `sum_first`

import "./data-maybe.gandr";
// The native finite lists.
import std.list (List);

/// `sum_first` binds a list of optional integers and returns seven.
/// Its list annotation gives each element type `Maybe(Integer)`.
def sum_first() -> Integer =
  let items = (#[Some 1, None, Some 3] : List (Maybe Integer))
  7

/// A call of `sum_first`.
@[runs("7")]
def first_summed() -> Integer { sum_first () }
