/// This source converts a call through another call result.
///
/// It specifies checker and kernel steps at calls stuck on `h`.
///
/// `tailOf(h)` is the argument of another call.
/// The checker expands both calls.
/// The kernel replays that expansion.
///
/// - see: #3042
/// - see: #2832
import "./data-base.gandr";
import "./stuck-arm-call.gandr";

/// This function gives the heap past the first cell, or the empty heap.
def tailOf(h : Heap) -> Heap =
  match h where
    | Emp => Emp
    | Cell(_l, rest) => rest

/// At zero, the heap after its first cell is empty.
/// At a successor, the type has no inhabitant.
def viaTail(w : Nat, h : Heap) -> Type =
  match w where
    | Zero => emp (tailOf h)
    | Succ(_n) => return Void

/// `tailEmpty` says the heap after its first cell is empty.
def tailEmpty(h : Heap) -> Type =
  emp (tailOf h)

/// `nested` reads `viaTail(Zero, h)` as its selected arm calls.
def nested(h : Heap) -> (viaTail(Zero, h)) -> emp(tailOf(h)) =
  return fun (e) { e }

/// `bodyNested` reads `tailEmpty(h)` as its body calls.
def bodyNested(h : Heap) -> (tailEmpty(h)) -> emp(tailOf(h)) =
  return fun (e) { e }
