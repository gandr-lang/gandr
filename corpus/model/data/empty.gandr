// The empty type and the apartness rule. `Empty` is a data type with no
// constructor, so a match on it has no arm and answers whatever type it is
// asked for: `A -> Empty` is how "not A" is spelled. A path between two terms
// of a data type is eliminated the same way when the terms are apart: their
// type's rules converge, and their normal forms first differ at two distinct
// constructors, so no path joins them and a match on one has no arm either
// (Coquand, _Pattern matching with dependent types_, 1992).

// The presented integers.
import "./data-base.gandr";

/// The type with no element.
data Empty : Type {}

/// Anything follows from an element of the empty type.
def absurd(v : Empty) -> Integer {
  case v {}
}

/// The answer written on the match itself.
def stated(v : Empty) -> Integer {
  case v -> -F Integer {}
}

/// A lambda's binder matched with no arm (#534): the function form lowers to
/// the lambda its arrow types, the binder `Empty`, as a parameter's written
/// type does.
def viaLambda(x : Empty) -> Integer { case x {} }

/// The answer written on a lambda binder's match (#534).
def viaStated(x : Empty) -> Integer { case x -> -F Integer {} }

/// The same lambda written bare, the checker inserting its thunk: the
/// signature's arrow types its binder as it types the thunk's (#1944).
def viaBare(x : Empty) -> Integer { case x {} }

/// The answer written on a bare lambda binder's match (#1944).
def viaBareStated(x : Empty) -> Integer { case x -> -F Integer {} }

/// A function of a function on the empty type, applied to its element.
def applied(f : Empty => Integer, v : Empty) -> Integer { f(v) }

/// A lambda passed as an argument: the callee's parameter types its binder
/// as a signature types a definition's (#1948).
def viaArgument(v : Empty) -> Integer { applied(fn (x) { case x {} }, v) }

/// The answer written on a passed lambda binder's match (#1948).
def viaArgumentStated(v : Empty) -> Integer {
  applied(fn (x) { case x -> -F Integer {} }, v)
}

/// One is not zero: `S(Z)` and `Z` are normal forms with distinct heads.
def not_zero(e : Path(Int, S(Z), Z)) -> Empty {
  case e {}
}

/// One is not two: the normal forms first differ below their shared
/// successor.
def one_not_two(e : Path(Int, S(Z), S(S(Z)))) -> Empty {
  case e {}
}

/// Minus one is not one, read through the rules: `P(S(P(Z)))` is `P(Z)`.
def signs(e : Path(Int, P(S(P(Z))), S(Z))) -> Empty {
  case e {}
}

/// A free type: two constructors and no rule.
data Truth : Type {
  False : Truth;
  True : Truth;
}

/// True is not false: distinct constructors of a free type are apart.
def true_not_false(e : Path(Truth, True, False)) -> Empty {
  case e {}
}
