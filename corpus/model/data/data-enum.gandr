//! An enumeration selects an arm by constructor.
//!
//! The annotation gives the scrutinee type.
//!
//! The case selects the arm named by its constructor.
//!
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

// The three colours.
import "./data-base.gandr";

/// The `Green` arm gives green rank one.
def rank() -> Integer =
  match (Green : Color) where
    | Red => 0
    | Green => 1
    | Blue => 2
