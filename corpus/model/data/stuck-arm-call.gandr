//! A selected arm can call another definition at a variable.
//!
//! `viaZero(Zero, h)` selects `emp(h)`.
//! That call scrutinises `h` and stops there.
//!
//! Call conversion follows selected arm calls.
//! The kernel replays each step.
//! A family recursion unfolds through index constructors.
//!
//! - see: #2832
//! - cites: [Dybjer-1994-inductive_families]
//!
//! [Dybjer-1994-inductive_families]: https://doi.org/10.1007/BF01211308 "Dybjer, Inductive families"

// The naturals that select the arm.
import "./data-base.gandr";

/// A heap: empty, or a cell at a location over the rest.
pub data Heap : Type where
  | Emp : Heap
  | Cell : (l : Nat, rest : Heap) --> Heap

/// The heap is empty: inhabited at `Emp` alone.
pub def emp(h : Heap) -> Type =
  match h where
    | Emp => return Unit
    | Cell(_l, _r) => return Void

/// At zero, the heap is empty.
/// At a successor, the type has no inhabitant.
pub def viaZero(w : Nat, h : Heap) -> Type =
  match w where
    | Zero => emp h
    | Succ(_n) => return Void

/// One arm more: at zero, `viaZero` at the same natural.
pub def viaZeroAgain(w : Nat, h : Heap) -> Type =
  match w where
    | Zero => viaZero w h
    | Succ(_n) => return Void

/// `atZero` returns `emp(h)` from `viaZero(Zero, h)`.
def atZero(h : Heap) -> (viaZero(Zero, h)) -> emp(h) =
  return fun (e) { e }

/// `twiceAtZero` returns `emp(h)` after two selected arms.
def twiceAtZero(h : Heap) -> (viaZeroAgain(Zero, h)) -> emp(h) =
  return fun (e) { e }

/// One arm down, the call that arm reached, itself an arm away from `emp(h)`.
def onceAtZero(h : Heap) -> (viaZeroAgain(Zero, h)) -> viaZero(Zero, h) =
  return fun (e) { e }
