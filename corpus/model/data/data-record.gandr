//! A record has one constructor and several fields.
//!
//! A pattern match binds each field by position.
//! A field selection reads its name.
//!
//! `Color3` shows a three-field record.
//!
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

/// A colour as its three channels.
data Color3 : Type where
  | RGB : (r : Integer, g : Integer, b : Integer) --> Color3

/// `green_channel` binds the green field by constructor position.
def green_channel() -> Integer =
  match (RGB 10 20 30 : Color3) where
    | RGB(r, g, b) => g

/// `blue_channel` reads the blue field by name.
def blue_channel(color : Color3) -> Integer =
  color.b

/// `reddish` compares red and green fields by name.
def reddish(color : Color3) -> Bool =
  color.r > color.g

/// `grey` compares red and green fields by name.
/// The first field supplies the `Eq` model.
def grey(color : Color3) -> Bool =
  color.r == color.g

/// A colour whose red and green channels are one.
@[runs("+{.0 = *{}}")]
def greyRun() -> Bool { grey (RGB 5 5 9) }

/// A colour whose red channel exceeds its green.
@[runs("+{.0 = *{}}")]
def reddishRun() -> Bool { reddish (RGB 9 5 1) }
