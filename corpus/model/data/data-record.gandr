// A data type with one constructor of several fields: a record, read by a
// match that binds each field by position, or by a field's name (Martin-Löf,
// _Intuitionistic Type Theory_, Bibliopolis, 1984).

/// A colour as its three channels.
data Color3 : Type {
  RGB : (r : Integer, g : Integer, b : Integer) --> Color3;
}

/// The green channel of a colour, bound by its position in the constructor.
def green_channel() -> Integer {
  case (RGB(10, 20, 30) : Color3) {
    RGB(r, g, b) => g
  }
}

/// The blue channel of a colour, read by the field's name: the match above,
/// its one arm returning the field.
def blue_channel(color : Color3) -> Integer {
  color.b
}

/// Whether a colour's red channel exceeds its green, each read by name where
/// no answer is stated, so typed by the field's declaration.
def reddish(color : Color3) -> Bool {
  color.r > color.g
}

/// Whether a colour's red and green channels are one, both read by name: the
/// first channel's type binds the model of `Eq` the comparison resolves.
def grey(color : Color3) -> Bool {
  color.r == color.g
}

/// A colour whose red and green channels are one.
@[ runs("+{.0 = unit}") ]
def greyRun() -> Bool { grey(RGB(5, 5, 9)) }

/// A colour whose red channel exceeds its green.
@[ runs("+{.0 = unit}") ]
def reddishRun() -> Bool { reddish(RGB(9, 5, 1)) }
