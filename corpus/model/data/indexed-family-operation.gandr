/// An indexed family `Skip` carries an operation `skip` and a rule over it.
///
/// Each node of the operation and the rule answers at its own span. The editor reads an indexed family's members as it reads an unindexed family's.
///
/// The checker admits `Skip`, and the operation routes no function, since a route's port is a family at no index. The described reading gives each port the family at the index the port writes. The family states no expectation, since the sugared form drops an own-line attribute.
///
/// - see: `corpus/model/data/map-laws.gandr`
/// - see: #2940
/// - see: #2898

/// The naturals the family is indexed by.
data N : Type {
  /// The naturals' zero.
  Z : N;
  /// The successor of `n`.
  S : (n : N) --> N;
}

/// A family indexed by `N`, with an operation and a rule over it.
data Skip : N -> Type {
  /// The one constructor, at the index `Z`.
  Halt : Skip(Z);
  /// An operation from the family at `Z` to itself.
  oper skip(k : Skip(Z)) -> Skip(Z);
  /// The rule that reads `skip` as the identity.
  rule skip(k) ==> k;
}
