// A parameter classifies a constructor argument.
//
// The called declaration states the parameter's type.
// Earlier arguments instantiate that type.
//
// A bare list then needs no annotation.
//
// The lists.
import "./data-base.gandr";

/// The length of a list of integers.
def rec listLength(xs : List Integer) -> Integer =
  match xs where
    | Nil => 0
    | Cons(_, rest) => {
      let counted = listLength[<] rest;
      counted + 1
    }

/// The parameter classifies the bare list as `List(Integer)`.
/// Its field classifies the inner integer.
@[ runs("2") ]
def pairLength() -> Integer { listLength (Cons 1 (Cons 2 Nil)) }

/// The bare empty list has type `List(Integer)`.
@[ runs("0") ]
def emptyLength() -> Integer { listLength Nil }

/// This pair carries an explicit annotation.
@[ runs("2") ]
def annotatedLength() -> Integer { listLength (Cons 1 (Cons 2 Nil) : List Integer) }

/// The function classifies each argument from its own parameter.
def rec tally(c : Color, cs : List Color) -> Integer =
  match cs where
    | Nil => 0
    | Cons(_, rest) => {
      let counted = tally[<] c rest;
      counted + 1
    }

/// The second argument classified by the second parameter.
@[ runs("3") ]
def colours() -> Integer { tally Red (Cons Red (Cons Green (Cons Blue Nil))) }

/// The length of a list of any type, the type given first.
def rec anyLength(a : Type, xs : List a) -> Integer =
  match xs where
    | Nil => 0
    | Cons(_, rest) => {
      let counted = anyLength[<] a rest;
      counted + 1
    }

/// The parameter `xs` receives the list at `a = Integer`.
/// The preceding argument determines `a`.
@[ runs("1") ]
def one() -> Integer { anyLength Integer (Cons 1 Nil) }

/// At `a = Color`, the parameter receives an empty list.
@[ runs("0") ]
def noColours() -> Integer { anyLength Color Nil }
