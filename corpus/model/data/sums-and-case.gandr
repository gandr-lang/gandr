// A binary sum has two injections.
//
// A case selects an arm by injection.
//
// This source checks names that this surface does not define.
//
// - see: ./data-either.gandr
/// `pick` uses a left injection and the left arm.
/// `Inl` and `Inr` are not names that this surface defines.
@[refuses("UnresolvedName")]
def pick() -> -F Integer =
  match (Inl 42 : Integer + String) where
    | Inl(x) => return (x + 1)
    | Inr(s) => return 0

/// `picked` calls the refused `pick` declaration.
/// Its result type is unknown.
@[refuses("UnknownConstant")]
def picked() -> Integer { pick () }
