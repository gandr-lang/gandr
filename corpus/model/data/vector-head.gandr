//! A case can omit an unreachable indexed-family arm.
//!
//! `vhead` has index `Succ(n)`.
//! `VNil` has index zero.
//!
//! Each branch of a case on an indexed family binds a path past its fields.
//! The path runs from the index of its constructor to the index of the
//! scrutinee.
//! An omitted arm eliminates the path between those indices.
//! Apart endpoints need no arm.
//!
//! - cites: [Cockx-2016-unifiers_as_equivalences]
//! - see: `../../pathological/data/vector-head.gandr` — the checker refuses the
//!   omission of an arm whose ends are not apart
//!
//! [Cockx-2016-unifiers_as_equivalences]: https://doi.org/10.1145/2951913.2951917 "Cockx, Devriese and Piessens, Unifiers as equivalences"

// The naturals the lengths count in.
import "./data-base.gandr";

// The vectors and the vector two long.
import "./vectors.gandr";

/// `vhead` reads a vector at least one element long.
/// It omits `VNil` because zero is apart from `Succ(n)`.
def vhead(n : Nat, v : Vec Integer (Succ n)) -> Integer =
  match v where
    | VCons(m, h, t) => h

/// The first element of the vector two long.
@[runs("1")]
def pairHead() -> Integer { vhead (Succ Zero) (pair ()) }
