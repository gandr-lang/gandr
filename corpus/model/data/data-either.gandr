//! A data type with two parameters: the sum of two types, each constructor
//! injecting one side. A match on a constructor written with its type takes the
//! arm that constructor names [MartinLof-1984-intuitionistic_type_theory].
//!
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

/// The sum of `a` and `b`: a value of either side, tagged by its constructor.
data Either(a : Type, b : Type) : Type where
  | Left : (x : a) --> Either(a, b)
  | Right : (y : b) --> Either(a, b)

/// The left side of a left injection, or zero for a right one.
def from_left() -> Integer =
  match (Left 5 : Either(Integer, String))
    | Left(x) => x
    | Right(y) => 0
