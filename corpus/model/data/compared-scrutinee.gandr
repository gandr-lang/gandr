// A case can scrutinise a computation directly.
//
// No thunk stands between the case and its answer.
// `run` gives the case the same binding.
//
// Comparisons, calls and pair splits each provide a value.
//
// - see: #1141

/// The naturals, their addition and the numeral two.
import "./data-base.gandr";

/// This case scrutinises the comparison where it occurs.
@[runs("1")]
def compared() -> Integer =
  match 3 >= 5 where
    | true => 2
    | false => 1

/// This case scrutinises a comparison over a parameter.
def sized(n : Integer) -> Integer =
  match n < 128 where
    | true => 1
    | false => 2

/// This case scrutinises the call to `plus`.
@[runs("1")]
def summed() -> Integer =
  match plus two (Succ Zero) where
    | Zero => 0
    | Succ(p) => 1
