// A computation written as a case's scrutinee: no thunk stands there, so it
// runs and the case reads its answer, as `run` binding it first does
// (`indexed-arms.gandr`). A comparison, a call and a pair split each read
// the value their computation returns (#1141).

/// The naturals, their addition and the numeral two.
import "./data-base.gandr" ;

/// The comparison cased on where it is written: three is not five or more.
@[ runs("1") ]
def compared() -> -F Integer {
  case 3 >= 5 {
    true => 2,
    false => 1
  }
}

/// A comparison over a parameter, cased on where it is written.
@[ checks ]
def sized(n : Integer) -> -F Integer {
  case n < 128 {
    true => 1,
    false => 2
  }
}

/// A call cased on where it is written: `plus` answers three.
@[ runs("1") ]
def summed() -> -F Integer {
  case plus(two, Succ(Zero)) {
    Zero => 0,
    Succ(p) => 1
  }
}
