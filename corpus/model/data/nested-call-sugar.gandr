// A recursive call nested in the constructor an arm returns: `S(S(dbl[<](x)))`
// is sugar for running the call, then returning the constructors over its
// value. Each fold respects the integers' rules, so it is defined on the
// quotient (Altenkirch et al., _Quotient inductive-inductive types_,
// doi:10.1007/978-3-319-89366-2_16).

// The presented integers.
import "./data-base.gandr" ;

/// Doubling: each successor and each predecessor written twice.
@[ checks ]
def rec dbl(n : Int) -> -F Int {
  case n {
    Z => Z,
    S(x) => S(S(dbl[<](x))),
    P(x) => P(P(dbl[<](x)))
  }
}

/// Negation: successors and predecessors swapped.
@[ checks ]
def rec neg(n : Int) -> -F Int {
  case n {
    Z => Z,
    S(x) => P(neg[<](x)),
    P(x) => S(neg[<](x))
  }
}

/// Two doubled.
@[ runs("S(S(S(S(Z))))") ]
def doubled : () => Int = dbl(S(S(Z))) ;

/// Two negated.
@[ runs("P(P(Z))") ]
def negated : () => Int = neg(S(S(Z))) ;
