//! A pair written in a field of another pair whose type a definition's call
//! computes.
//!
//! The lowering reads the type of a constructor written in a field off the
//! arguments of the type of the constructor around it. A call that computes
//! that type gives the lowering no arguments to read. So the inner pair takes
//! its own family over one wildcard for each parameter. The checker solves
//! each wildcard from the call that it reduces.
//!
//! A nested pair at a computed type checks, in one form or as a signature and
//! a definition. A pair at a type that a recursion computes checks two and
//! three steps deep. An inner pair with its type written beside it checks too.
//!
//! - see: #5373
//! - see: #6113

/// The counts.
data Count : Type where
  /// Zero.
  | Z : Count
  /// The successor of `n`.
  | S : (n : Count) --> Count

/// A value of the first type with a value of the type it picks.
data Twin(a : Type, b : a -> Type) : Type where
  /// The two values.
  | MkTwin : (x : a, y : b(x)) --> Twin a b

/// The unit type at each count.
def unitOfCount(m : Count) -> Type = return Unit

/// A pair of a count and the unit value, at each count.
def innerTwin(n : Count) -> Type = return (Twin Count unitOfCount)

/// A pair of counts that holds a pair of counts.
def twinType(u : Count) -> Type = return (Twin Count innerTwin)

/// A pair of a count and the unit value.
def oneType(u : Count) -> Type = return (Twin Count unitOfCount)

/// The inner pair takes its type from the outer pair's field, which the call
/// computes: the checker solves the inner pair's parameters.
def nestedTwin(k : Count) -> twinType(Z) =
  MkTwin Z (MkTwin Z *{})

/// The same pair, written as a signature and a definition.
def signedTwin : twinType(Z) = MkTwin Z (MkTwin Z *{});

/// The inner pair at its written type.
def ascribedTwin(k : Count) -> twinType(Z) =
  MkTwin Z (MkTwin Z *{} : Twin Count unitOfCount)

/// One pair at a computed type.
def oneTwin(k : Count) -> oneType(Z) =
  MkTwin Z *{}

/// A value of each type.
data Layer(a : Type, b : Type) : Type where
  /// The two values.
  | MkLayer : (x : a, y : b) --> Layer a b

/// A spine of steps.
data Spine : Type where
  /// No more steps.
  | Done : Spine
  /// One more step.
  | More : (rest : Spine) --> Spine

/// One string for each step of a spine.
def rec spineType(spine : Spine) -> Type =
  match spine where
    | More(rest) => return (Layer String (spineType[<] rest))
    | Done => return Unit

/// A value two steps deep.
def spineTwo : spineType(More (More Done)) = MkLayer "x" (MkLayer "y" *{});

/// A value three steps deep.
def spineThree : spineType(More (More (More Done))) = MkLayer "x" (MkLayer "y" (MkLayer "z" *{}));
