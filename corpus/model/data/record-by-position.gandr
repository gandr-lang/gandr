// A record whose fields depend on nothing, taken apart by position: each
// binder is the field the record type writes in its place, as at a dependent
// record (`sigma-pair.gandr`). Before #1874 the pattern was read as the split
// of an eager product and refused.

/// The width of a band, its bounds bound by position.
@[ checks ]
def width(band : #{low : Integer, high : Integer}) -> Integer {
  case band {
    #{low, high} => high - low
  }
}

/// The band from two to seven is five wide.
@[ runs("5") ]
def band_width : () => Integer = width(#{low = 2, high = 7}) ;

/// The binders take the fields in the type's order whatever they are named:
/// the first binder is `low`, though it is spelled `top`, and the second
/// `high`.
@[ checks ]
def read_as_digits(band : #{low : Integer, high : Integer}) -> Integer {
  case band {
    #{top, bottom} => top * 10 + bottom
  }
}

/// The band from two to seven reads as twenty-seven.
@[ runs("27") ]
def band_digits : () => Integer = read_as_digits(#{low = 2, high = 7}) ;
