// Positional patterns use a plain-record split.
//
// Each binder receives the field type at its position.
// This follows dependent-record splitting.
//
// The parser does not read this pattern as an eager-product split.
//
// - see: #1874 — a plain record taken apart by position

/// The width of a band, its bounds bound by position.
def width(band : *{low : Integer, high : Integer}) -> Integer =
  match band where
    | *{low, high} => high - low

/// The band from two to seven is five wide.
@[ runs("5") ]
def band_width : () -> Integer = width (*{low = 2, high = 7});

/// `read_as_digits` binds fields in their type order.
/// It names `low` with `top` and `high` with `bottom`.
def read_as_digits(band : *{low : Integer, high : Integer}) -> Integer =
  match band where
    | *{top, bottom} => top * 10 + bottom

/// The band from two to seven reads as twenty-seven.
@[ runs("27") ]
def band_digits : () -> Integer = read_as_digits (*{low = 2, high = 7});
