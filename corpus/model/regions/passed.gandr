//! `passed` returns a thunk at its input region.
//!
//! The caller reads the returned thunk before that region
//! ends. The pathological
//! twin refuses a result held in no region as `TypeMismatch`.
//!
//! `pass` returns its argument unchanged. The `passed` run returns `4`. Rust
//! writes the same lifetime in `fn pass<'a>(k: &'a T) -> &'a T`.
//!
//! - see: corpus/pathological/regions/outlived.gandr — a result past its region
import std.process;

/// `pass` returns its thunk at the same region.
pub def pass[r : Region](k : (() -> Integer) at r) -> -F ((() -> Integer) at r) { pure k }

/// `passed` forces the thunk that `pass` returns.
@[ runs("4") ]
def passed() -> Integer =
  var s = 4
  handle c : std.process.Exit.Eff {
    let k : (() -> Integer) at c = access shared s as w { pure pure w };
    let back : (() -> Integer) at c = run pass k;
    force back
  } with {
    | pure(x) => pure x
    | oper exit(code, rest) => pure 0
  }
