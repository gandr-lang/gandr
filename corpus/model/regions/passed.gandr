// A function handing back what it was lent, as Rust writes `fn pass<'a>(k: &'a
// T) -> &'a T`: the answer is kept where the argument was, so the caller
// reads it inside the same scope.

/// Hands back the thunk it is lent, kept in the same region.
pub def pass @[r : Region] (k : (() => Integer) at r) -> -F ((() => Integer) at r) { pure k }

/// Reads what `pass` hands back inside the handler whose region keeps it.
@[ runs("4") ]
def passed() -> Integer {
  hold s = 4;
  handle c : Proc {
    run k : (() => Integer) at c <- access shared s as w { pure pure w };
    run back : (() => Integer) at c <- pass(k);
    force back
  } with {
    pure(x) => pure x,
    oper exit(code, rest) => pure 0
  }
}
