// The region free theorem as naturality, as Rust lets a `&'long T` stand where
// a `&'short T` is asked and a function generic in its lifetime cannot tell
// which it was given. A view kept at an outer region stands at an inner one,
// and a function polymorphic in its region commutes with that widening:
// running it at the outer region and widening its answer is one function with
// widening its argument and running it at the inner region. The path between
// the two is checked by conversion. Stating it for every region-polymorphic
// function, held abstractly, needs a value type quantifying a region, #2139.

// `pass`, which hands back the thunk it is lent.
import "./passed.gandr";

/// Forces the thunk it is lent, then hands it back in the same region.
pub def touch @[r : Region] (k : (() => Integer) at r) -> -F ((() => Integer) at r) {
  run _ <- force k;
  pure k
}

/// `pass` at the outer region with its answer widened to the inner one is
/// `pass` at the inner region after its argument is widened.
@[ runs("5") ]
def passNatural() -> Integer {
  hold s = 5;
  handle outer : Proc {
    run k : (() => Integer) at outer <- access shared s as w { pure pure w };
    handle inner : Proc {
      run _ : Path(
        (() => Integer) at outer => (() => Integer) at inner,
        thunk { fn (x) { run y : (() => Integer) at outer <- pass(x); pure y } },
        thunk { fn (x) { run z : (() => Integer) at inner <- pure x; pass(z) } }
      ) <- pure here(thunk { fn (x) { run y : (() => Integer) at outer <- pass(x); pure y } });
      force k
    } with {
      pure(y) => pure y,
      oper exit(code, rest) => pure 0
    }
  } with {
    pure(x) => pure x,
    oper exit(code, rest) => pure 0
  }
}

/// The same square for `touch`, whose two sides nest its binds apart: the
/// conversion reassociates them.
@[ runs("5") ]
def touchNatural() -> Integer {
  hold s = 5;
  handle outer : Proc {
    run k : (() => Integer) at outer <- access shared s as w { pure pure w };
    handle inner : Proc {
      run _ : Path(
        (() => Integer) at outer => (() => Integer) at inner,
        thunk { fn (x) { run y : (() => Integer) at outer <- touch(x); pure y } },
        thunk { fn (x) { run z : (() => Integer) at inner <- pure x; touch(z) } }
      ) <- pure here(thunk { fn (x) { run y : (() => Integer) at outer <- touch(x); pure y } });
      force k
    } with {
      pure(y) => pure y,
      oper exit(code, rest) => pure 0
    }
  } with {
    pure(x) => pure x,
    oper exit(code, rest) => pure 0
  }
}
