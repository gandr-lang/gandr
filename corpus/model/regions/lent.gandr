//! `lent` reads a thunk at its caller's region.
//!
//! A call places `read` at its argument's region. The pathological twin
//! refuses a returned thunk that escapes the caller as `KeptEscaped`.
//!
//! `read` forces its thunk. The `lent` run returns `3`. Rust writes the same
//! lifetime parameter as `fn read<'a>(k: &'a T)`.
//!
//! - see: corpus/pathological/regions/stashed.gandr — a returned thunk outside its region
import std.process;

/// `read` forces its thunk in the region that keeps it.
def read[r : Region](k : (() -> Integer) at r) -> Integer { force k }

/// `lent` passes a handler-held view to `read`.
@[ runs("3") ]
def lent() -> Integer =
  var s = 3
  handle c : std.process.Exit.Eff {
    let k : (() -> Integer) at c = access shared s as w { pure pure w };
    read k
  } with {
    | pure(x) => pure x
    | oper exit(code, rest) => pure 0
  }
