// A program encloses the square root of two through `std.reals.Eff`, the host
// interface of exact reals.
//
// The program gives the host the canonical bytes of a plan in lowercase
// hexadecimal. The plan holds one cut, the square root of two, whose laws are
// the registered cut of stage A. The host validates the bytes and replies a
// plan. The program then asks for an enclosure no wider than `2^-64`. The
// checker replays the certificate of the enclosure before the host replies.
//
// `gandr run sqrt-two.gandr` prints the lower end and then the upper end. Each
// end has the form `<mantissa>p<exponent>` for `mantissa · 2^exponent`. The
// same `enclosed` runs under a handler of this source, a second model of the
// interface.
//
// - see: `crates/surface-dispatcher/src/evaluate/reals.rs` — the host that
//   serves the interface
// - see: `crates/theory-exact-reals/README.md` — the plans, the machine and
//   the checker

// The console's host interface.
import std.io;
// The exact reals' host interface.
import std.reals;
// The subject's shared declarations: `enclosed`.
import "./reals-base.gandr";

/// The canonical bytes of the plan that `square_root_of_two` of
/// `theory-exact-reals` builds, in lowercase hexadecimal: 11 nodes in 153
/// bytes, the magic `GXRP` first.
pub def rootTwo : String = "";

/// `enclosed` under a handler of this source, a second model of
/// `std.reals.Eff` that holds one plan and answers each enclosure with `1`
/// and `3/2`.
@[ runs("\"1p0 3p-1\"") ]
def enclosedModelled() -> String =
  handle r : std.reals.Eff {
    enclosed rootTwo 1
  } with {
    | pure(x) => pure x
    | oper admit(plan, k) => k 0
    | oper enclose(asked, k) => k "1p0" "3p-1"
    | oper decide(asked, k) => k "holds" 0
    | oper step(machine, k) => k "holds" machine
    | oper checkpoint(machine, k) => k ""
    | oper restore(text, k) => k 0
    | oper report(machine, k) => k #[0, 0, 0, 0, 0, 0, 0, 0, 0]
  }

/// The entry: enclose the square root of two no wider than `2^-64`, print
/// the two ends, and exit with 0.
def main() -> [std.reals.Eff, std.io.Console.Eff] Integer =
  let ends = enclosed rootTwo 64
  std.io.Console.print ends
  0
