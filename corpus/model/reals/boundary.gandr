// Two comparisons that no budget decides, through `std.reals.Eff`. A stop of
// the machine never reads as false.
//
// `sqrt 2 < sqrt 2` fails, but no finite enclosure shows it. Each enclosure of
// the left side overlaps each enclosure of the right side, so each pole stays
// live. Each budget ends `exhausted`, and the machine never replies `fails`.
// `sqrt 2 · sqrt 2 < 2` fails too, and no finite enclosure shows it either.
// The compound chain encloses each cut by its witnesses, so each attempt
// refines the product at twice the precision of the one before.
//
// The budgets of 1 and 16 quanta end `exhausted`. At 256 quanta the precision
// reaches the checker's quota, so the run ends `suspended`. `gandr run
// boundary.gandr` prints the verdicts of each comparison at 1, 16 and 256
// quanta, one comparison a line.
//
// - see: `corpus/model/reals/comparison.gandr` — a comparison that holds
// - see: `crates/surface-dispatcher/src/evaluate/reals/machine.rs` — the
//   verdicts of a machine

// The console's host interface.
import std.io;
// The exact reals' host interface.
import std.reals;
// The join of two strings.
import std.string (concat);
// The native list type.
import std.list (List);

/// The canonical bytes of the plan of `sqrt 2 < sqrt 2` in lowercase
/// hexadecimal: 12 nodes in 162 bytes.
pub def againstItself : String = "";

/// The canonical bytes of the plan of `sqrt 2 · sqrt 2 < 2` in lowercase
/// hexadecimal: 13 nodes in 171 bytes.
pub def squareAgainstTwo : String = "";

/// The verdicts on the open root of `plan` at 1, 16 and 256 quanta, a space
/// between each two. Each budget mints a machine of its own.
pub def verdicts(plan : String) -> [std.reals.Eff] String =
  let held = std.reals.admit plan
  let *{one, first} = std.reals.decide held 1
  let *{sixteen, second} = std.reals.decide held 16
  let *{many, third} = std.reals.decide held 256
  concat one (concat " " (concat sixteen (concat " " many)))

/// `verdicts` under a handler of this source, a second model of
/// `std.reals.Eff` whose each budget ends `exhausted`.
@[ runs("\"exhausted exhausted exhausted\"") ]
def verdictsModelled() -> String =
  handle r : std.reals.Eff {
    verdicts againstItself
  } with {
    | pure(x) => pure x
    | oper admit(plan, k) => k 0
    | oper enclose(asked, k) => k "1p0" "3p-1"
    | oper decide(asked, k) => k "exhausted" 0
    | oper step(machine, k) => k "exhausted" machine
    | oper checkpoint(machine, k) => k ""
    | oper restore(text, k) => k 0
    | oper report(machine, k) => k #[256, 2, 0, 2, 0, 0, 0, 0, 0]
  }

/// The entry: print the verdicts of both comparisons, and exit with 0.
def main() -> [std.reals.Eff, std.io.Console.Eff] Integer =
  let itself = verdicts againstItself
  std.io.Console.print itself
  let square = verdicts squareAgainstTwo
  std.io.Console.print square
  0
