// A program decides `sqrt 2 < 3/2` through `std.reals.Eff`, the host
// interface of exact reals.
//
// The program gives the host the canonical bytes of a plan whose root is the
// comparison, and the host replies a plan. `decide` mints a machine on the two
// poles of the root: that it holds and that it fails. A quantum is one
// certificate step, and the poles take their quanta in turn.
//
// Within 16 quanta the pole that holds certifies. The checker replays its
// certificate before the host replies `holds`. The other pole suspends, so
// the machine spends 7 quanta. `gandr run comparison.gandr` prints `holds`.
// The same `decided` runs under a handler of this source, a second model of
// the interface.
//
// - see: `crates/surface-dispatcher/src/evaluate/reals/machine.rs` — the
//   machines that the host holds
// - see: `corpus/model/reals/boundary.gandr` — comparisons that no budget
//   decides

// The console's host interface.
import std.io;
// The exact reals' host interface.
import std.reals;
// The native list type.
import std.list (List);
// The subject's shared declarations: `belowThreeHalves` and `decided`.
import "./reals-base.gandr";

/// `decided` under a handler of this source, a second model of
/// `std.reals.Eff` that decides each root true.
@[ runs("\"holds\"") ]
def decidedModelled() -> String =
  handle r : std.reals.Eff {
    decided belowThreeHalves 16
  } with {
    | pure(x) => pure x
    | oper admit(plan, k) => k 0
    | oper enclose(asked, k) => k "1p0" "3p-1"
    | oper decide(asked, k) => k "holds" 0
    | oper step(machine, k) => k "holds" machine
    | oper checkpoint(machine, k) => k ""
    | oper restore(text, k) => k 0
    | oper report(machine, k) => k #[7, 2, 4, 0, 0, 0, 4, 0, 0]
  }

/// The entry: decide `sqrt 2 < 3/2` within 16 quanta, print the verdict, and
/// exit with 0.
def main() -> [std.reals.Eff, std.io.Console.Eff] Integer =
  let verdict = decided belowThreeHalves 16
  std.io.Console.print verdict
  0
