//! This fixture migrates twice to one seat.
//!
//! The second migration reads a value at the seat.
//!
//! Each crossing commits and dereferences its value.
//!
//! - cites: [Vii-2007-typesafe_distributed_programming_ml5]
//!
//! [Vii-2007-typesafe_distributed_programming_ml5]: https://doi.org/10.1007/978-3-540-78663-4_9 "Murphy, Crary and Harper, Type-Safe Distributed Programming with ML5"

// The operator and seat worlds define each entry.
import "./seat-and-operator.gandr";

@[ entry(*{operator, seat, seat}), runs("42") ]
def twice() -> Integer =
  let held : Integer at seat = migrate [seat] { (hold 21) };
  let n at seat = held
  migrate [seat] { pure (n * 2) }

@[ entry(*{operator, seat, seat}), runs("*{.done = 3, .left = 4}") ]
def reread() -> *{done : Integer, left : Integer} =
  let held : *{done : Integer, left : Integer} at seat = migrate [seat] {
    (hold *{done = 3, left = 4})
  };
  let counts at seat = held
  migrate [seat] { pure counts }
