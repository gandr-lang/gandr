// The site that hosts the migration model's far world.
//
// A site is one place a world runs at, the key it proves and the sockets it
// is reached at. Written as a file, the place stays out of the program and
// out of the flags.
//
// `gandr host --site` binds these sockets in place of `--net-bind`, and proves
// the key with the secret `GANDR_NET_SECRET` holds. The secret never stands in
// the file. This key is the one the two-process test's host secret proves.
//
// - see: `two-processes.manifold.gandr` — the manifold placing `far` here
// - see: `two-processes.gandr` — the program it hosts
// - see: `crates/surface-driver/tests/net.rs` — the two processes

// The deployment theories, from `std.manifold` by its path.
import "../../../library/std/src/manifold.gandr";

/// The far site, on a loopback socket.
pub module Site : Model(Site) {
  /// The key the hosting process proves.
  def key = "ed4928c628d1c2c6eae90338905995612959273a5c63f93636c14614ac8737d1";
  /// The socket it binds, where a dialer reaches it.
  def sockets = "127.0.0.1:7433";
}
