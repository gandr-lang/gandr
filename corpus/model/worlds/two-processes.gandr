//! This fixture runs a migration model on two processes.
//!
//! Each process binds one declared world.
//!
//! The two migrations hold and read one value at `far`.
//!
//! - see: `crates/surface-driver/tests/net.rs`

pub world near;

pub world far;

@[ entry(*{near, far, far}), runs("42") ]
def main() -> Integer =
  let held : Integer at far = migrate [far] { (hold (6 * 7)) };
  let answer at far = held
  migrate [far] { pure answer }
