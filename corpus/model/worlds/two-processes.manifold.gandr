//! This manifold deploys a migration model on two processes.
//!
//! It binds `far` to the imported site.
//!
//! The entry process runs `main` at `near`.
//!
//! - see: `two-processes.gandr`
import std.manifold (Site, Manifold, Placement, At);
import "./two-processes.site.gandr" as far;
import std.list (List);

pub module Manifold : Model(Manifold) where
  def artifact = "two-processes.gandr";

pub def placements : List(Placement) = #[
  At "far" far.site,
];
