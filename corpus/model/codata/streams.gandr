// Streams as codata (#644): a family known by its observations, built by a
// copattern block that answers each one, and taken apart by observing a
// thunk of it. A recursive call claiming `>` is productive when it is the
// whole arm of a copattern block: each observation yields before the
// function runs again, so the fixpoint needs no termination claim. What
// refuses is in `../../pathological/codata/streams.gandr`.

/// A stream of values of `a`: its head, and the stream after it.
@[ checks ]
codata Stream(a : Type) : Type[-] {
  head : a;
  tail : Stream(a);
}

/// The integers from `n` upward, one observation at a time.
@[ checks ]
def rec upward(n : Integer) -> Stream(Integer) {
  &{.head => n, .tail => upward[>](n + 1)}
}

/// `n` forever, its clauses written tail first: a copattern block answers
/// the observations in the order the declaration states them.
@[ checks ]
def rec always(n : Integer) -> Stream(Integer) {
  &{.tail => always[>](n), .head => n}
}

/// One forever: a corecursive constant, which binds its own name over its
/// copattern block though it takes no parameter (#1499).
@[ checks ]
def rec ones() -> Stream(Integer) {
  &{.head => 1, .tail => ones[>]()}
}

/// The head of a stream: observing a thunk of it.
@[ checks ]
def first(s : +U Stream(Integer)) -> Integer {
  s.head
}

/// The head of a stream's tail.
@[ checks ]
def second(s : +U Stream(Integer)) -> Integer {
  first(s.tail)
}

/// Two streams combined pointwise by `f`: every parameter varies from call
/// to call, and the call stays productive.
@[ checks ]
def rec zipWith(
  f : (Integer, Integer) => Integer,
  s : +U Stream(Integer),
  t : +U Stream(Integer)
) -> Stream(Integer) {
  &{
    .head => {
      f(first(s), first(t))
    },
    .tail => zipWith[>](f, s.tail, t.tail)
  }
}

/// Addition, as the function `zipWith` combines with.
@[ checks ]
def add(x : Integer, y : Integer) -> Integer {
  x + y
}

/// The integers from three, observed at the head.
@[ runs("3") ]
def three : () => Integer = first(upward(3));

/// The integers from three, observed one further.
@[ runs("4") ]
def four() -> Integer { second(upward(3)) }

/// The integers from one added to the sevens, one further: `2 + 7`.
@[ runs("9") ]
def nine() -> Integer {
  second(zipWith(add, upward(1), always(7)))
}

/// The ones, observed one further: the constant unfolds once.
@[ runs("1") ]
def unfolded() -> Integer { second(ones()) }

/// An observation by its position, counted from zero in declaration order:
/// `s.1` is `s.tail`, so this is `second`.
@[ checks ]
def onward(s : +U Stream(Integer)) -> Integer {
  first(s.1)
}

/// The integers from three, observed one further by position.
@[ runs("4") ]
def fourth : () => Integer = onward(upward(3));

/// The integers from three, observed at the head off the call itself: the
/// call runs to the stream, and the stream is observed.
@[ runs("3") ]
def headOfCall() -> Integer { upward(3).head }

/// The integers from three, one further: the call's tail observed by
/// position, then its head.
@[ runs("4") ]
def tailOfCall() -> Integer { first(upward(3).1) }

/// Whether the head off a call is positive, read in an operand.
@[ runs("+{.0 = unit}") ]
def headAbove() -> Bool { upward(3).head >= 1 }

/// The head of a stream's tail, read as one chain: the tail is a stream, so
/// it is observed in turn.
@[ checks ]
def secondInline(s : +U Stream(Integer)) -> Integer {
  s.tail.head
}

/// The integers from three, two further: a chain of observations off a
/// call, each link observed off what the one before it returns.
@[ runs("5") ]
def chained() -> Integer { upward(3).tail.tail.head }

/// The same chain, its links by position.
@[ runs("5") ]
def chainedByPosition() -> Integer { upward(3).1.tail.0 }

/// The ones added to the sevens, observed one further through the chain.
@[ runs("8") ]
def eight() -> Integer {
  secondInline(zipWith(add, ones(), always(7)))
}
