// A codata value is defined by what each observation answers, and observed
// by projecting it. This source is written in an earlier surface: its kind is
// `Type` and its copatterns stand without `&{ … }`. `streams.gandr` writes
// both as the language now spells them.

/// A point observed by its coordinates. A codata declaration's kind is a
/// computation universe, and `Type` is none.
@[ refuses("CodataKindNotUniverse") ]
codata Point : Type {
  x : Integer;
  y : Integer;
}

/// The point at three and four, its observations written bare as the earlier
/// surface wrote them: a copattern clause stands inside `&{ … }`, so a bare
/// one is out of place.
@[ refuses("MalformedForm") ]
def rec origin() -> Point {
  .x => 3,
  .y => 4
}

/// The coordinates summed; `origin` is refused above, so it names a
/// declaration whose type is not known.
@[ refuses("UnknownConstant") ]
def coordinates() -> Integer { origin.x + origin.y }
