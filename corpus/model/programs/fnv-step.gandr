//! `fnv-step` computes one step of the FNV-1a hash of 64 bits.
//!
//! A step mixes one word into the hash: an exclusive or, then a product.
//! The product is the wrapping product with the FNV prime, modulo two to 64.
//!
//! The grammar of the tool chain keys its walk with the same step.
//! Each expected word is the answer of that Rust step.
//!
//! - cites: [Fowler-2026-fnv_noncryptographic_hash_algorithm]
//!
//! [Fowler-2026-fnv_noncryptographic_hash_algorithm]: https://doi.org/10.17487/RFC9923 "Fowler, Noll, Vo, Eastlake and Hansen, The FNV Non-Cryptographic Hash Algorithm"

/// `fnv_step` mixes one byte into a hash: an exclusive or, then
/// a wrapping product.
def fnv_step(hash : u64, byte : u64) -> u64 = u64.wrapping_mul (u64.xor hash byte) 1099511628211u64

/// The offset basis with the byte 97 gives the published hash of `a`.
@[runs("12638187200555641996u64")]
def offset_with_a() -> u64 = fnv_step 14695981039346656037u64 97u64

/// The offset basis with the byte 0 gives the product of the basis.
@[runs("12638153115695167455u64")]
def offset_with_zero() -> u64 = fnv_step 14695981039346656037u64 0u64

/// The greatest hash with the byte 0 wraps to the negation of the prime.
@[runs("18446742974197923405u64")]
def greatest_with_zero() -> u64 = fnv_step 18446744073709551615u64 0u64;
