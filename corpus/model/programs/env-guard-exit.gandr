//! `env-guard-exit` reads an environment variable for a program exit code.
//!
//! The lowering refuses member selection on a host module.
//!
//! An unset variable reads as the empty string.
//! The guard selects exit code `3` for that string.
//!
//! - see: #1106 — `exit_by_environment`

/// The rejected form reads an unset variable and selects exit code `3`.
@[refuses("OutOfFragment.projection_expression")]
def exit_by_environment() -> -F Integer =
  let missing = env.get "GANDR_CORPUS_UNSET_VARIABLE_ZZQ"
  if missing == "" { 3 } else { 7 }
