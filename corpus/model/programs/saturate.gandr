//! `saturate` adds two `u8` and keeps the greatest `u8` when the sum
//! does not fit.
//!
//! A checked row of a width has an answer of two forms. This source holds the
//! lowering of that answer to the answer of the executor.
//!
//! The checked addition gives the sum, or the unit when the sum is past the
//! width. A case on that answer clamps it. The compiled program of `saturated`
//! exits 255.
//!
//! - see: exit-code.gandr — a wrapping row of a width

/// The checked sum of two words.
def checked_sum(a : u8, b : u8) -> u8 + Unit = u8.checked_add a b

/// The sum, or 255 when it does not fit.
def clamp(sum : u8 + Unit) -> u8 = match sum {
  | +{.0 = s} => s
  | +{.1 = u} => 255u8
};

/// 254 and 1 fit.
@[runs("+{.0 = 255u8}")]
def fitting() -> u8 + Unit = checked_sum 254u8 1u8

/// 255 and 1 do not fit.
@[runs("+{.1 = *{}}")]
def overflowing() -> u8 + Unit = checked_sum 255u8 1u8

/// A small sum keeps its value.
@[runs("7u8")]
def small() -> u8 =
  let sum = checked_sum 3u8 4u8
  clamp sum

/// The clamp gives 255 for a large sum.
@[runs("255u8")]
def large() -> u8 =
  let sum = checked_sum 200u8 100u8
  clamp sum

/// The case reads the checked row with no call between.
@[runs("255u8")]
def direct() -> u8 = match u8.checked_add 200u8 100u8 {
  | +{.0 = s} => s
  | +{.1 = u} => 255u8
};

/// `saturated` gives the clamped sum: the exit code of its compiled program.
@[runs("255u8")]
def saturated() -> u8 =
  let value = large
  value
