//! `saturate` adds two `u8` and keeps the greatest `u8` when the sum
//! does not fit.
//!
//! The checked addition gives the sum, or the unit when the sum is past the
//! width. A case on that answer clamps it.
//! A program whose entry is `code` exits 255.

/// The checked sum of two words.
def add(a : u8, b : u8) -> u8 + Unit = u8.checked_add a b;

/// The sum, or 255 when it does not fit.
def clamp(sum : u8 + Unit) -> u8 = match sum {
  | +{.0 = s} => s
  | +{.1 = u} => 255u8
};

/// 254 and 1 fit.
@[runs("+{.0 = 255u8}")]
def fitting() -> u8 + Unit = add 254u8 1u8;

/// 255 and 1 do not fit.
@[runs("+{.1 = *{}}")]
def overflowing() -> u8 + Unit = add 255u8 1u8;

/// A small sum keeps its value.
@[runs("7u8")]
def small() -> u8 = { let sum = add 3u8 4u8; clamp sum };

/// A large sum is clamped.
@[runs("255u8")]
def large() -> u8 = { let sum = add 200u8 100u8; clamp sum };

/// The case reads the checked row with no call between.
@[runs("255u8")]
def direct() -> u8 = match u8.checked_add 200u8 100u8 {
  | +{.0 = s} => s
  | +{.1 = u} => 255u8
};

/// `code` gives the clamped sum: the exit code of its compiled program.
@[runs("255u8")]
def code() -> u8 = { let value = large; value };
