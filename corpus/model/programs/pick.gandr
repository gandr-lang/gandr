//! `pick` chooses one of two words by a truth value.
//!
//! The lowering to MLIR has no form of its own for `if`. This source holds the
//! lowering of a truth value to the answer of the executor.
//!
//! `Bool` is `Unit + Unit`, and `if` is a case of that sum. The compiled
//! program of `picked` exits 3.
//!
//! - see: left.gandr — a sum of a word and the unit

/// `pick` gives 3 for a true flag and 5 for a false one.
def pick(flag : Bool) -> u8 = if flag { 3u8 } else { 5u8 };

/// `true` is the left injection of the unit.
@[runs("+{.0 = *{}}")]
def held() -> Bool = true

/// A true flag takes the first branch.
@[runs("3u8")]
def taken() -> u8 = pick true

/// A false flag takes the second branch.
@[runs("5u8")]
def skipped() -> u8 = pick false

/// `picked` gives the choice for the held flag: the exit code of
/// its compiled program.
@[runs("3u8")]
def picked() -> u8 =
  let flag = held
  pick flag
