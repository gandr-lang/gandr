// A program: a source declaring a top-level `main` that returns the exit
// code and reads the arguments `gandr run` passes after the path, as a C or a
// Rust program's `main` does (ISO/IEC 9899:2018 § 5.1.2.2; the Rust
// Reference, § Crates and source files, "Main functions"). `gandr run
// entry.gandr a b c` exits 3.

/// The number of strings in a list.
def rec count(xs : List(String)) -> Integer {
  case xs {
    [] => 0,
    [x, ..rest] => { run n <- count[<](rest); n + 1 }
  }
}

/// The entry: its exit code is the number of its arguments.
def main(args : List(String)) -> Integer { become count(args) }
