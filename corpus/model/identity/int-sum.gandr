// The integers' sum and its laws, after cubical Agda's `Cubical/Data/Int`:
// the sum by recursion on its second summand, zero a unit of it, a successor
// or a predecessor brought out of its left, and the sum commuting.
// `circle-group.gandr` reads these laws through the winding number.

// The integers, one successor more and one predecessor more.
import "./circle-base.gandr";

/// The sum of two integers (cubical's `_+_` on `ℤ`), by recursion on the
/// second. It respects `Int`'s rules: at `S(P(x))` it builds `S(P(plus(a,
/// x)))`, which the first rule reads as `plus(a, x)`.
@[ checks ]
def rec plus(a : Int, b : Int) -> Int {
  case b {
    Z => a,
    S(x) => S(plus[<](a, x)),
    P(x) => P(plus[<](a, x))
  }
}

/// A successor on the left of a sum comes out of it (cubical's `sucℤ+`), by
/// induction on the right summand: the kernel reads the endpoint `S(plus(a,
/// P(x)))` by `Int`'s rules down to `plus(a, x)`, and the `cong(up, …)` and
/// `cong(down, …)` arms as transports along the recursive path.
@[ checks ]
def rec plusS(a : Int, b : Int) -> Path(Int, plus(S(a), b), S(plus(a, b))) {
  case b {
    Z => here(S(a)),
    S(x) => cong(up, plusS[<](a, x)),
    P(x) => cong(down, plusS[<](a, x))
  }
}

/// A predecessor on the left of a sum comes out of it (cubical's `predℤ+`),
/// as `plusS`.
@[ checks ]
def rec plusP(a : Int, b : Int) -> Path(Int, plus(P(a), b), P(plus(a, b))) {
  case b {
    Z => here(P(a)),
    S(x) => cong(up, plusP[<](a, x)),
    P(x) => cong(down, plusP[<](a, x))
  }
}

/// Zero is a left unit of the sum, by induction on the right summand.
@[ checks ]
def rec plusZ(b : Int) -> Path(Int, plus(Z, b), b) {
  case b {
    Z => here(Z),
    S(x) => cong(up, plusZ[<](x)),
    P(x) => cong(down, plusZ[<](x))
  }
}

/// The sum commutes (cubical's `+Comm`), by induction on the second summand,
/// each step the recursive call carried along `up` or `down` and then the
/// summand brought out of the left. The arms compose to no conversion of the
/// answer at `x`, yet `Int` is a set, so its rules are respected by their
/// endpoints alone (#427).
@[ checks ]
def rec plusComm(a : Int, b : Int) -> Path(Int, plus(a, b), plus(b, a)) {
  case b {
    Z => back(plusZ(a)),
    S(x) => cong(up, plusComm[<](a, x)) then back(plusS(x, a)),
    P(x) => cong(down, plusComm[<](a, x)) then back(plusP(x, a))
  }
}
