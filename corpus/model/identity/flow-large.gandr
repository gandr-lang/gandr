// A flow at a universe above the smallest: the codes it relates are large
// types, which pack a type in a field, so they live one level up and so does
// the flow between them. The classifier `Flow(Type[+, 1], A, B)` is the
// directed hom of that universe (Gratzer, Weinberger and Buchholtz,
// _Directed univalence in simplicial homotopy type theory_,
// arXiv:2407.09146, Definition 1.2), stated at its level as `Path` is at
// every level; the kernel replays each declaration here at its flow over the
// level-one universe (#1628). A transport or a ride along a path or a flow at
// that universe reads its motive's binder there too, so the motive's body
// decodes a large code at level one (#1837).

/// A list of values of a type it carries: a large type, since a field holds a
/// type.
@[ checks ]
data Packed : Type[+, 1] {
  Pack : (a : Type, xs : List(a)) --> Packed;
}

/// A second large type of the same shape.
@[ checks ]
data Boxed : Type[+, 1] {
  Box : (a : Type, xs : List(a)) --> Boxed;
}

/// The stationary flow at a large code.
@[ checks ]
def packedKept : Flow(Type[+, 1], Packed, Packed) = stay(Packed) ;

/// The stationary flow, then itself: the unit composes at the level it is
/// stated at.
@[ checks ]
def packedTwice() -> Flow(Type[+, 1], Packed, Packed) {
  packedKept then packedKept
}

/// A given flow from one large code to the other, after the stationary one.
@[ checks ]
def after(f : Flow(Type[+, 1], Packed, Boxed)) -> Flow(Type[+, 1], Packed, Boxed) {
  packedKept then f
}

/// The stationary flow at the smallest universe itself, read one level up.
@[ checks ]
def types : Flow(Type[+, 1], Type, Type) = stay(Type) ;

/// A large code at a universe two levels up: a flow is stated at any level
/// its codes inhabit.
@[ checks ]
def lifted : Flow(Type[+, 2], Packed, Packed) = stay(Packed) ;

/// Reflexivity at a large code: a path at the universe its codes inhabit.
@[ checks ]
def packedSame : Path(Type[+, 1], Packed, Packed) = here(Packed) ;

/// A packed list carried along reflexivity at its large type: the motive's
/// binder ranges over `Type[+, 1]`, so its body decodes a code there.
@[ checks ]
def packedMoved(p : Packed) -> Packed {
  transport(\X. X, packedSame, p)
}

/// A packed list ridden along the stationary flow at its large type.
@[ checks ]
def packedRode(p : Packed) -> Packed {
  ride(\X. X, packedKept, p)
}

/// A list of packed lists carried along reflexivity: the decode under the
/// list reads at the carrier's level as well.
@[ checks ]
def packedLists(ps : List(Packed)) -> List(Packed) {
  transport(\X. List(X), packedSame, ps)
}

/// A packed list ridden into a box along a given flow between the two large
/// types: the endpoints differ, so the ride moves by the table's decode row,
/// read at the flow's level.
@[ checks ]
def packedCarried(f : Flow(Type[+, 1], Packed, Boxed), p : Packed) -> Boxed {
  ride(\X. X, f, p)
}

/// A list of packed lists ridden into a list of boxes along the same flow:
/// the list row carries the decode beneath it.
@[ checks ]
def boxedLists(f : Flow(Type[+, 1], Packed, Boxed), ps : List(Packed)) -> List(Boxed) {
  ride(\X. List(X), f, ps)
}
