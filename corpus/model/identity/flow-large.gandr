/// This source states flows between large codes.
///
/// A large code stores a type in one field.
/// The flow type has a level above the universe of the code.
///
/// The kernel checks each declaration over the level-one universe.
/// Each motive decodes its large code at that same level.
///
/// - see: #1628
/// - see: #1837
/// - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
///
/// [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

// The native finite lists.
import std.list (List);

/// A `Packed` value carries a list at its stored type.
data Packed : Type[+, 1] where
  | Pack : (a : Type, xs : List a) --> Packed

/// A `Boxed` value has the same large-code shape.
data Boxed : Type[+, 1] where
  | Box : (a : Type, xs : List a) --> Boxed

/// The `packedKept` flow remains at one large code.
def packedKept : Flow[.A = Type[+, 1]](Packed, Packed) = Flow.stay Packed;

/// The stationary flow composes with itself at its stated level.
def packedTwice() -> Flow[.A = Type[+, 1]](Packed, Packed) =
  Flow.then packedKept packedKept

/// The `after` function composes a given large-code flow after the stationary flow.
def after(f : Flow[.A = Type[+, 1]](Packed, Boxed)) -> Flow[.A = Type[+, 1]](Packed, Boxed) =
  Flow.then packedKept f

/// The `types` flow remains at the smallest universe one level above it.
def types : Flow[.A = Type[+, 1]](Type, Type) = Flow.stay Type;

/// A large code has a type at two universe levels above its stored type.
def lifted : Flow[.A = Type[+, 2]](Packed, Packed) = Flow.stay Packed;

/// The `packedSame` path is reflexivity at the large code.
def packedSame : Path[.A = Type[+, 1]](Packed, Packed) = Path.here Packed;

/// The motive for `packedMoved` decodes its code at level one.
def packedMoved(p : Packed) -> Packed =
  Path.walk (fun (X) { X }) packedSame p

/// `Flow.ride` maps a packed value at its large type.
def packedRode(p : Packed) -> Packed =
  Flow.ride (fun (X) { X }) packedKept p

/// The list motive decodes the packed-list carrier at its own level.
def packedLists(ps : List Packed) -> List Packed =
  Path.walk (fun (X) { List X }) packedSame ps

/// The flow ride moves a packed value to `Boxed` through its decode row.
def packedCarried(f : Flow[.A = Type[+, 1]](Packed, Boxed), p : Packed) -> Boxed =
  Flow.ride (fun (X) { X }) f p

/// The list flow ride carries its decode beneath the list row.
def boxedLists(f : Flow[.A = Type[+, 1]](Packed, Boxed), ps : List Packed) -> List Boxed =
  Flow.ride (fun (X) { List X }) f ps
