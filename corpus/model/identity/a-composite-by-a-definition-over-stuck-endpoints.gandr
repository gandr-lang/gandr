/// A definition's composite meets `then` over the same paths, at endpoints that
/// stuck calls return.
///
/// `concat`'s body is `p then q`, so a type written with `concat` reads as one
/// written with `then`. At variable endpoints the two read alike. At a stuck
/// call, `concat`'s type reads the endpoint through the environment its call
/// bound, which holds it. The type written with `then` writes the call in place.
///
/// The machine runs the written call where its type reads it. It compares the
/// result with the held endpoint, and the kernel replays the comparison by its
/// own reading.
///
/// - see: #4038 — the checker refused the composite at stuck endpoints
/// - see: #4005 — two endpoints a call returned apart, which the code walk hands on
/// - see: #4011 — a bind over a transport stuck on a path

/// The composite of two paths, by definition.
def concat(A : Type, x : A, y : A, z : A, p : Path(A, x, y), q : Path(A, y, z)) -> Path(A, x, z) {
  p then q
}

/// Reflexivity at `concat`'s composite, its type written with `concat`.
def concatHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  p : Path(A, x, y),
  q : Path(A, y, z)
) -> Path(Path(A, x, z), concat(A, x, y, z, p, q), concat(A, x, y, z, p, q)) {
  here(concat(A, x, y, z, p, q))
}

/// `concatHere` at variable endpoints, against `then`.
def atVariables(
  A : Type,
  x : A,
  y : A,
  z : A,
  p : Path(A, x, y),
  q : Path(A, y, z)
) -> Path(Path(A, x, z), p then q, p then q) {
  concatHere(A, x, y, z, p, q)
}

/// `concatHere` at endpoints that are the stuck composite `f then g`.
def atComposite(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path(A, x, y),
  g : Path(A, y, z),
  p : Path(Path(A, x, z), f then g, f then g),
  q : Path(Path(A, x, z), f then g, f then g)
) -> Path(Path(Path(A, x, z), f then g, f then g), p then q, p then q) {
  concatHere(Path(A, x, z), f then g, f then g, f then g, p, q)
}

/// `concatHere` at endpoints that apply a variable function.
def atApplication(
  A : Type,
  F : A => A,
  x : A,
  y : A,
  z : A,
  p : Path(A, F(x), F(y)),
  q : Path(A, F(y), z)
) -> Path(Path(A, F(x), z), p then q, p then q) {
  concatHere(A, F(x), F(y), z, p, q)
}
