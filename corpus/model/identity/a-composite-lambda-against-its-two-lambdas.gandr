/// A lambda over a composite path, against the composite of two lambdas.
///
/// `q ↦ Path.step(Path.step(q, g), h)` and the composite of
/// `q ↦ Path.step(q, g)` and `r ↦ Path.step(r, h)` are one function. Each body
/// agrees with the other once the machine takes the bind at the endpoint of
/// `Path.step(q, g)`.
///
/// The composite's body binds `Path.step(q, g)`, a transport stuck on `g`, into
/// `t ↦ Path.step(t, h)`. That transport returns the value it moves, whatever
/// its path. So the bind is its continuation at that endpoint, the transport
/// along `h` that the lambda writes. Inside an action's motive, the kernel
/// reads the two codes by its own rules, which run the composite's calls.
///
/// - see: #3824 — a call of a returning variable held by the same law
/// - see: #4011 — the checker refused the composite against its two lambdas
/// - see: #4005 — the action over the composite, which the code walk hands on

/// The composite of `F` and then `G`.
def composeAfter(A : Type, B : Type, C : Type, F : A => B, G : B => C) -> A => C {
  (fun (a : A) { G(F(a)) } : A => C)
}

/// The lambda over the composite path, against the composite of its two
/// lambdas.
def oneLambdaAgainstCompose(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(A, x, y) => Path(A, x, w),
  (fun (q : Path(A, x, y)) { Path.step(Path.step(q, g), h) } : Path(A, x, y) => Path(A, x, w)),
  composeAfter(
    Path(A, x, y),
    Path(A, x, z),
    Path(A, x, w),
    (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
    (fun (r : Path(A, x, z)) { Path.step(r, h) } : Path(A, x, z) => Path(A, x, w))
  )
) {
  Path.here((fun (q : Path(A, x, y)) {
    Path.step(Path.step(q, g), h)
  } : Path(A, x, y) => Path(A, x, w)))
}

/// The same pair, the composite of the two lambdas its point.
def composeAgainstOneLambda(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(A, x, y) => Path(A, x, w),
  composeAfter(
    Path(A, x, y),
    Path(A, x, z),
    Path(A, x, w),
    (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
    (fun (r : Path(A, x, z)) { Path.step(r, h) } : Path(A, x, z) => Path(A, x, w))
  ),
  (fun (q : Path(A, x, y)) { Path.step(Path.step(q, g), h) } : Path(A, x, y) => Path(A, x, w))
) {
  Path.here(
    composeAfter(
      Path(A, x, y),
      Path(A, x, z),
      Path(A, x, w),
      (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
      (fun (r : Path(A, x, z)) { Path.step(r, h) } : Path(A, x, z) => Path(A, x, w))
    )
  )
}

/// The action of `F` on `p`.
def actThrough(A : Type, B : Type, F : A => B, x : A, y : A, p : Path(A, x, y)) -> Path(
  B,
  F(x),
  F(y)
) {
  Path.ap(F, p)
}

/// The action of the composite of `F` and then `G` on `p`.
def actOfCompose(
  A : Type,
  B : Type,
  C : Type,
  F : A => B,
  G : B => C,
  x : A,
  y : A,
  p : Path(A, x, y)
) -> Path(C, G(F(x)), G(F(y))) {
  actThrough(A, C, (fun (a : A) { G(F(a)) } : A => C), x, y, p)
}

/// The action of the lambda over the composite path, against the action of
/// the composite of its two lambdas.
def composedAgainstActOfCompose(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(Path.step(fp, g), h)),
  actThrough(
    Path(A, x, y),
    Path(A, x, w),
    (fun (q : Path(A, x, y)) { Path.step(Path.step(q, g), h) } : Path(A, x, y) => Path(A, x, w)),
    fm,
    fp,
    fa
  ),
  actOfCompose(
    Path(A, x, y),
    Path(A, x, z),
    Path(A, x, w),
    (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
    (fun (r : Path(A, x, z)) { Path.step(r, h) } : Path(A, x, z) => Path(A, x, w)),
    fm,
    fp,
    fa
  )
) {
  Path.here(
    actOfCompose(
      Path(A, x, y),
      Path(A, x, z),
      Path(A, x, w),
      (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
      (fun (r : Path(A, x, z)) { Path.step(r, h) } : Path(A, x, z) => Path(A, x, w)),
      fm,
      fp,
      fa
    )
  )
}
