// A dependent case over the circle owes the transport of its answer at the
// point along the loop, through each endpoint's maps (#425): a map of any
// arity whose one argument the point runs through, a loop arm answering the
// loop by its name, and the definitions those maps call, unfolded within the
// obligation's budget, as the HoTT book's Lemma 6.2.5 states the circle's
// dependent elimination: an answer at the point and a path over the loop. A
// row the tree refuses states the refusal it meets and the issue that holds
// it.

// The circle, every point's loop and the multiplication.
import "./circle-base.gandr";

/// The identity on the circle, its loop arm the loop's name.
def circleId(a : Circle) -> Circle {
  case a {
    Base => Base,
    loop => loop
  }
}

/// The identity on its first argument, the second along for the ride.
def first(a : Circle, b : Circle) -> Circle {
  case a {
    Base => Base,
    loop => loop
  }
}

/// The identity on its second argument, the first along for the ride.
def second(b : Circle, a : Circle) -> Circle {
  case a {
    Base => Base,
    loop => loop
  }
}

/// A map whose loop arm answers the loop's name: carried along the loop,
/// reflexivity at `Base` is the loop's inverse, then the loop.
def throughName(b : Circle) -> Path(Circle, circleId(b), b) {
  case b {
    Base => here(Base)
  }
}

/// A map of two arguments, the point through the first.
def throughFirst(b : Circle) -> Path(Circle, first(b, Base), b) {
  case b {
    Base => here(Base)
  }
}

/// A map of two arguments, the point through the second.
def throughSecond(b : Circle) -> Path(Circle, second(Base, b), b) {
  case b {
    Base => here(Base)
  }
}

/// Two maps of two arguments, one inside the other.
def throughBoth(b : Circle) -> Path(Circle, second(Base, first(b, Base)), b) {
  case b {
    Base => here(Base)
  }
}

/// Reflexivity carried along the loop through a map is the loop's inverse,
/// not reflexivity, against a fixed right endpoint.
@[ refuses("LoopNotRespected") ]
def twisted(b : Circle) -> Path(Circle, first(b, Base), Base) {
  case b {
    Base => here(Base)
  }
}

/// The point is a right unit of the multiplication, whose loop arm calls
/// `selfloop`. The obligation unfolds `mul`'s loop arm through its call of
/// `selfloop`, and the transport computes (#425).
def unitRight(b : Circle) -> Path(Circle, mul(b, Base), b) {
  case b {
    Base => here(Base)
  }
}
