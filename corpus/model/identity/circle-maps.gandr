/// This source states dependent maps from the circle.
///
/// Each case at the point owes transport around the loop.
/// A loop arm supplies the path that transport requires.
///
/// The checker unfolds each map within its obligation budget.
/// The source gives each transport its refusal name.
///
/// - see: #425 — `unitRight`

// The circle, every point's loop and the multiplication.
import "./circle-base.gandr";

/// The identity case maps the circle loop to its own name.
def circleId(a : Circle) -> Circle =
  match a where
    | Base => Base
    | loop => loop

/// The `first` case maps its first argument and keeps its second argument.
def first(a : Circle, b : Circle) -> Circle =
  match a where
    | Base => Base
    | loop => loop

/// The `second` case maps its second argument and keeps its first argument.
def second(b : Circle, a : Circle) -> Circle =
  match a where
    | Base => Base
    | loop => loop

/// The loop arm carries reflexivity at `Base` to the loop inverse and then the loop.
def throughName(b : Circle) -> Path[.A = Circle](circleId b, b) =
  match b where
    | Base => Path.here Base

/// The `throughFirst` case maps the point through its first argument.
def throughFirst(b : Circle) -> Path[.A = Circle](first b Base, b) =
  match b where
    | Base => Path.here Base

/// The `throughSecond` case maps the point through its second argument.
def throughSecond(b : Circle) -> Path[.A = Circle](second Base b, b) =
  match b where
    | Base => Path.here Base

/// The `throughBoth` case nests two circle maps.
def throughBoth(b : Circle) -> Path[.A = Circle](second Base (first b Base), b) =
  match b where
    | Base => Path.here Base

/// The checker refuses `twisted` because transport maps reflexivity to the loop inverse.
@[ refuses("LoopNotRespected") ]
def twisted(b : Circle) -> Path[.A = Circle](first b Base, Base) =
  match b where
    | Base => Path.here Base

/// The `unitRight` case unfolds `mul` and `selfloop` while its transport computes.
def unitRight(b : Circle) -> Path[.A = Circle](mul b Base, b) =
  match b where
    | Base => Path.here Base
