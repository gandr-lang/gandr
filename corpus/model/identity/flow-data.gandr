/// This source states a data-type flow from a translator.
///
/// A translator moves fields between constructors of the source and target types.
/// The flow moves each source value to its target value.
///
/// The flow classifier stores the translator between the two data types.
/// The checker applies it to each value and list family.
///
/// - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
///
/// [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

// The native finite lists.
import std.list (List);

/// The `Old` type has one integer field.
data Old : Type where
  | Mk : (n : Integer) --> Old

/// The `Other` type has the same field under another constructor.
data Other : Type where
  | Make : (n : Integer) --> Other

/// A `Shape` has circle and rectangle constructors.
pub data Shape : Type where
  | Circle : (r : Integer) --> Shape
  | Rect : (w : Integer, h : Integer) --> Shape

/// A `Figure` renames circles and swaps rectangle sides.
pub data Figure : Type where
  | Round : (r : Integer) --> Figure
  | Box : (h : Integer, w : Integer) --> Figure

/// The `Rename` module moves one field to another constructor.
module Rename where {
  /// The translator moves the field to the target constructor.
  @[ checks ]
  def toOther(old : Old) -> Other =
    match old
      | Mk(n) => Make n
  /// The translator defines the flow from `Old` to `Other`.
  @[ checks ]
  def renamed : Flow[.A = Type](Old, Other) = Flow.into toOther;
  /// The flow rides one source value to the target type.
  @[ checks ]
  def moved(old : Old) -> Other =
    Flow.ride (fun (X) { X }) renamed old
  /// The run migrates one value.
  @[ runs("Make 3") ]
  def one : () -> Other = moved (Mk 3);
}

/// The `Shapes` module moves each shape to its figure.
pub module Shapes where {
  /// The translator swaps rectangle sides.
  @[ checks ]
  def toFigure(shape : Shape) -> Figure =
    match shape
      | Circle(r) => Round r
      | Rect(w, h) => Box h w
  /// The translator defines the flow from shapes to figures.
  @[ checks ]
  def redrawn : Flow[.A = Type](Shape, Figure) = Flow.into toFigure;
  /// The flow rides a shape list through the list family.
  @[ checks ]
  def all(shapes : List(Shape)) -> List(Figure) =
    Flow.ride (fun (X) { List X }) redrawn shapes
  /// The run migrates two shapes.
  @[ runs("cons (Round 1) (cons (Box 3 2) nil)") ]
  def two : () -> List(Figure) = all (cons (Circle 1) (cons (Rect 2 3) nil));
}
