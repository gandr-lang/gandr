/// This source splits equivalence records returned by calls.
///
/// A returned quasi-inverse has four fields.
/// A returned equivalence has two nested inverse records.
///
/// The match reads its layout from the called function result.
/// The `run` binder requires no written type.
///
/// - see: #656 — `keptToEquiv`, `madeAgain`
import "./equivalence.gandr";

/// The `kept` function returns its quasi-inverse unchanged.
def kept(a : Type, b : Type, i : a ≅ b) -> a ≅ b =
  i

/// The `keptToEquiv` match splits the returned quasi-inverse into an equivalence.
def keptToEquiv(a : Type, b : Type, i : a ≅ b) -> a ≃ b =
  let j = kept a b i
  match j where
    | *{t, k, s, r} => *{t, *{*{k, s}, *{k, r}}}

/// The `madeAgain` match reconstructs the returned equivalence.
def madeAgain(a : Type, b : Type, i : a ≅ b) -> a ≃ b =
  let e = isoToEquiv a b i
  match e where
    | *{t, *{g, s}, *{h, r}} => *{t, *{*{g, s}, *{h, r}}}
