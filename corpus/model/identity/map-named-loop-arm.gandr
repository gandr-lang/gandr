//! A map whose loop arm is the named loop, and its action on the loop.
//!
//! The action of a map on the loop is the image of the loop under the map's
//! loop arm. The kernel must compute that image as the checker does, whatever
//! the form of the arm. Otherwise the kernel refuses a declaration that the
//! checker accepts.
//!
//! `keepNamed` sends the loop to the named `loop`, and `keepWord` sends it to
//! the word `loop ∷ Path.here Base`. Each declaration relates an image of the
//! loop to the loop by reflexivity. Some start the transport at the call
//! `keepNamed Base`, and some start it at the point.
//!
//! - see: #5489
//! - see: `circle-elim.gandr` — the transports along the loop that both sides admit

// The circle, its loop and the flip.
import "./circle-base.gandr";

/// The map that keeps the circle: the point to itself, the loop to the named
/// loop.
def keepNamed(c : Circle) -> Circle {
  match c {
    | Base => Base
    | loop => loop
  }
}

/// The map that keeps the circle, its loop arm the one-letter word.
def keepWord(c : Circle) -> Circle {
  match c {
    | Base => Base
    | loop => loop ∷ Path.here Base
  }
}

/// The image of the loop under `keepNamed` is the loop.
def keptLoop : Path[.A = Path[.A = Circle](Base, Base)](
  Path.ap keepNamed loop,
  loop
) = Path.here loop;

/// The loop is the image of the loop under `keepNamed`.
def keptBack : Path[.A = Path[.A = Circle](Base, Base)](
  loop,
  Path.ap keepNamed loop
) = Path.here loop;

/// The image of the loop under `keepNamed` is the loop's one-letter word.
def keptWord : Path[.A = Path[.A = Circle](Base, Base)](
  Path.ap keepNamed loop,
  loop ∷ Path.here Base
) = Path.here loop;

/// The transport that `Path.ap keepNamed loop` abbreviates, from the call
/// `keepNamed Base`.
def keptFromCall : Path[.A = Path[.A = Circle](Base, Base)](
  Path.walk
    (fun (y) { type(Path[.A = Circle](keepNamed Base, keepNamed y)) })
    loop
    (Path.here (keepNamed Base)),
  loop
) = Path.here loop;

/// The transport through `keepNamed` from the point, its start the call
/// `keepNamed Base`.
def keptFromStart : Path[.A = Path[.A = Circle](Base, Base)](
  Path.walk
    (fun (y) { type(Path[.A = Circle](Base, keepNamed y)) })
    loop
    (Path.here (keepNamed Base)),
  loop
) = Path.here loop;

/// The transport through `keepNamed` from the point, its start the point.
def keptFromPoint : Path[.A = Path[.A = Circle](Base, Base)](
  Path.walk (fun (y) { type(Path[.A = Circle](Base, keepNamed y)) }) loop (Path.here Base),
  loop
) = Path.here loop;

/// The image of the loop under `keepWord` is the loop.
def keptAsWord : Path[.A = Path[.A = Circle](Base, Base)](
  Path.ap keepWord loop,
  loop
) = Path.here loop;

/// The image of the loop under the flip is the loop's inverse.
def flippedLoop : Path[.A = Path[.A = Circle](Base, Base)](
  Path.ap invLooper loop,
  Path.back loop
) = Path.here (Path.back loop);
