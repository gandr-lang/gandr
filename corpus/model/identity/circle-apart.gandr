/// This source proves that the circle loop differs from reflexivity.
///
/// Loop words normalize under their two cancellation rules.
/// The loop and the empty word differ at their first letter.
///
/// The empty match eliminates an equality between those distinct normal forms.
/// The proof supplies the apartness fact used by the circle sources.
/// The HoTT book reaches this fact through a universe and univalence.
/// This source uses the apartness rule at the words instead.
///
/// - cites: [Program-2013-homotopy_type_theory_univalent_foundations_mathematics]
///
/// [Program-2013-homotopy_type_theory_univalent_foundations_mathematics]: https://arxiv.org/abs/1308.0729 "Univalent Foundations Program, Homotopy Type Theory: Univalent Foundations of Mathematics"

// The empty type and the circle.
import "./circle-base.gandr";

/// The loop is not the empty word.
pub def loop_apart(e : Path[.A = Path[.A = Circle](Base, Base)](loop, Path.here Base)) -> Empty =
  match e {}

/// Two loops differ from one loop.
def twice_apart(e : Path[.A = Path[.A = Circle](Base, Base)](loop ∷ loop, loop)) -> Empty =
  match e {}

/// The loop is not its inverse.
def inverse_apart(e : Path[.A = Path[.A = Circle](Base, Base)](
  loop,
  back loop ∷ Path.here Base
)) -> Empty =
  match e {}
