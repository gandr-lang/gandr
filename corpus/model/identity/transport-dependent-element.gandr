//! This source transports a path element in a dependent family.
//!
//! Based path induction carries reflexivity at reflexivity to
//! reflexivity at `q`.
//! The result is a path from `q` to itself.
//!
//! The checker forms the motive from the path binder.
//! The kernel replays the transport.
//!
//! - see: HoTT Book §1.12.1

// The free naturals.
import "./circle-base.gandr";

/// Reflexivity at `q`, by transport along `q` in the family of each path's
/// reflexivity.
def looped(a : Nat, b : Nat, q : Path(a, b)) -> Path[.A = Path[.A = Nat](a, b)](q, q) =
  Path.walk
    ((y : Nat, z : Path[.A = Nat](a, y)) -> Path[.A = Path[.A = Nat](a, y)](z, z))
    q
    (Path.here a)
    (Path.here q)
    (Path.here (Path.here a))
