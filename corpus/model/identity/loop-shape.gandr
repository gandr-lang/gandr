// The circle's shape as a signature (the book's § 8.1, the point and its
// loop with the two cancellations as laws), and two models of it: the
// presented integers, whose laws are conversion (`Winding`), and the native
// integers, whose laws hold by arithmetic and are owed (`NativeWinding`).
// `loop-winding.gandr` folds the loop's words into each.

// The presented integers.
import "./circle-base.gandr";

/// The circle's shape: the same presentation as a signature models interpret.
/// `Model` reads a `theory` block, so the shape is spelled apart from `Words`.
theory CircleShape {
  sort Pt : Type;

  oper base : Pt;
  oper turn : (x : Pt) --> Pt;
  oper unturn : (x : Pt) --> Pt;

  rule turnUnturn : turn(unturn(x)) <=> x;
  rule unturnTurn : unturn(turn(x)) <=> x;
}

/// The number of laws in a presentation's rule chain.
def rec laws(chain : Theory) -> Integer {
  case chain {
    Rule(name, left, right, rest) => { run r <- laws[<](rest); r + 1 },
    _ => 0
  }
}

/// The number of laws a presentation states.
def law_count(presented : Theory) -> Integer {
  case presented {
    Presents(sorts, opers, rules) => laws(rules),
    _ => 0
  }
}

/// The shape's laws join, so its `Theory` value carries both as `Rule` entries.
@[ runs("2") ]
def shape_laws() -> Integer { law_count(CircleShape) }

/// The presented integers as a model of the shape: `base` zero, a value, as
/// the theory's `base : Pt` is a constant; `turn` the successor and `unturn`
/// the predecessor. Each law is proved by `here`: conversion reads the inner
/// call under the constructor the outer one builds, and the integers' rules
/// cancel the pair.
module Winding : Model(CircleShape) {
  type Pt = Int;

  def base = Z;

  def turn(n : Int) -> Int { S(n) }

  def unturn(n : Int) -> Int { P(n) }

  def turnUnturn(n : Int) -> Path(Int, turn(unturn(n)), n) {
    here(n)
  }

  def unturnTurn(n : Int) -> Path(Int, unturn(turn(n)), n) {
    here(n)
  }

  @[ runs("S(S(Z))") ]
  def wound() -> Int {
    turn(turn(base))
  }
}

/// The same shape modelled over the native integers. The laws hold by
/// arithmetic, which conversion leaves to the runtime, so each is owed, and
/// a fold into this model rests on them.
module NativeWinding : Model(CircleShape) {
  type Pt = Integer;

  def base = 0;

  def turn(n : Integer) -> Integer { n + 1 }

  def unturn(n : Integer) -> Integer { n - 1 }

  @[ owes(1) ]
  def turnUnturn : (n : Integer) => Path(Integer, turn(unturn(n)), n);

  @[ owes(1) ]
  def unturnTurn : (n : Integer) => Path(Integer, unturn(turn(n)), n);

  @[ runs("2") ]
  def wound() -> Integer {
    run n <- turn(base);
    turn(n)
  }
}
