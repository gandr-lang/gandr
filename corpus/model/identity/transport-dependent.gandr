// Transport in a family over a point and a path to it from a fixed one, the
// motive of based path induction (the HoTT book's § 1.12.1): at reflexivity
// it computes to the element given, along the unit type's evidence it
// computes into the unit fibre, it reverses a path when the family is the
// paths back, and it refuses a family not over the path's own endpoints or
// one that reads no path.

// The free naturals.
import "./circle-base.gandr";

/// Transport along reflexivity at zero returns the element given.
def reduced : Path(
  Nat,
  Path.walk(
    (y : Nat, Path(Nat, Zero, y)) => Nat,
    Path.here(Zero),
    Path.here(Zero),
    Path.here(Path.here(Zero)),
    Succ(Zero)
  ),
  Succ(Zero)
) = Path.here(Succ(Zero));

/// The unit type's evidence between its point and itself, a closed path
/// that is no reflexivity.
def unitPath : Path(Unit, unit, unit) = unit;

/// Transport along that evidence, in a family that reads neither the point
/// nor the path, returns the element given (#1854).
def carriedUnit : Path(
  Nat,
  Path.walk(
    (y : Unit, Path(Unit, unit, y)) => Nat,
    unitPath,
    Path.here(unit),
    Path.here(unitPath),
    Succ(Zero)
  ),
  Succ(Zero)
) = Path.here(Succ(Zero));

/// Transport along that evidence in the family of paths back to the point
/// returns the unit, the one inhabitant of the unit fibre (#1886).
def backUnit : Path(
  Path(Unit, unit, unit),
  Path.walk(
    (y : Unit, Path(Unit, unit, y)) => Path(Unit, y, unit),
    unitPath,
    Path.here(unit),
    Path.here(unitPath),
    Path.here(unit)
  ),
  unit
) = Path.here(unit);

/// A path reversed by transport in the family of paths back to its start,
/// reflexivity at the start carried to the end.
def reversed(a : Nat, b : Nat, q : Path(Nat, a, b)) -> Path(Nat, b, a) {
  Path.walk(
    (y : Nat, Path(Nat, a, y)) => Path(Nat, y, a),
    q,
    Path.here(a),
    Path.here(q),
    Path.here(a)
  )
}

/// A lift whose path is not over `q` is refused.
@[ refuses("NotOver") ]
def astray(a : Nat, b : Nat, q : Path(Nat, a, b), v : Nat) -> Nat {
  Path.walk((y : Nat, Path(Nat, a, y)) => Nat, q, Path.here(a), Path.here(Path.here(a)), v)
}

/// A family that reads no path is the wrong shape for a dependent transport.
@[ refuses("ShapeMismatch") ]
def flat(a : Nat, b : Nat, q : Path(Nat, a, b), v : Nat) -> Nat {
  Path.walk(Nat => Nat, q, v, v, v)
}
