/// A run that reaches a definition behind a held path.
///
/// Whiskering a reflexivity twice gives a reflexivity, so it is a unit of the
/// composite beside any path.
///
/// The inner whiskering is a held call inside the outer one's action on paths.
/// The composite runs the outer call, and the run goes on through the inner one.
///
/// - see: #3774 — the run stopped at the held call and left the endpoint unrun

/// The composite of two paths, whose type states its endpoints.
def composedPaths(A : Type, x : A, y : A, z : A, p : Path(A, x, y), q : Path(A, y, z)) -> Path(
  A,
  x,
  z
) {
  Path.step(p, q)
}

/// A function's action on a path, whose type states its endpoints.
def actedOn(B : Type, C : Type, F : B => C, b1 : B, b2 : B, p : Path(B, b1, b2)) -> Path(
  C,
  F(b1),
  F(b2)
) {
  Path.ap(F, p)
}

/// The associator by based path induction on `h`.
def associatedPaths(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(Path(A, x, w), Path.step(Path.step(f, g), h), Path.step(f, Path.step(g, h))) {
  Path.walk(
    (
      v : A,
      k : Path(A, z, v)
    ) => Path(Path(A, x, v), Path.step(Path.step(f, g), k), Path.step(f, Path.step(g, k))),
    h,
    Path.here(z),
    Path.here(h),
    Path.here(Path.step(f, g))
  )
}

/// The whiskering of a path of paths on the right.
def whiskeredRight(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(Path(A, x, z), Path.step(f1, g), Path.step(f2, g)) {
  actedOn(
    Path(A, x, y),
    Path(A, x, z),
    (fun (q : Path(A, x, y)) { Path.step(q, g) } : Path(A, x, y) => Path(A, x, z)),
    f1,
    f2,
    a
  )
}

/// A reflexivity whiskered twice, then `k`, is `k`.
def twiceWhiskeredThen(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w),
  r : Path(A, x, w),
  k : Path(Path(A, x, w), Path.step(Path.step(fm, g), h), r)
) -> Path(
  Path(Path(A, x, w), Path.step(Path.step(fm, g), h), r),
  composedPaths(
    Path(A, x, w),
    Path.step(Path.step(fm, g), h),
    Path.step(Path.step(fm, g), h),
    r,
    whiskeredRight(
      A,
      x,
      z,
      w,
      Path.step(fm, g),
      Path.step(fm, g),
      whiskeredRight(A, x, y, z, fm, fm, Path.here(fm), g),
      h
    ),
    k
  ),
  k
) {
  Path.here(k)
}

/// A reflexivity whiskered twice, then the associator, is the associator.
def twiceWhiskeredThenAssoc(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(Path(A, x, w), Path.step(Path.step(fm, g), h), Path.step(fm, Path.step(g, h))),
  composedPaths(
    Path(A, x, w),
    Path.step(Path.step(fm, g), h),
    Path.step(Path.step(fm, g), h),
    Path.step(fm, Path.step(g, h)),
    whiskeredRight(
      A,
      x,
      z,
      w,
      Path.step(fm, g),
      Path.step(fm, g),
      whiskeredRight(A, x, y, z, fm, fm, Path.here(fm), g),
      h
    ),
    associatedPaths(A, x, y, z, w, fm, g, h)
  ),
  associatedPaths(A, x, y, z, w, fm, g, h)
) {
  Path.here(associatedPaths(A, x, y, z, w, fm, g, h))
}
