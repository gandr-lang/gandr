//! This source compares transports whose motive endpoints reduce alike.
//!
//! The written endpoints can differ before their reductions agree.
//! The pathological twin refuses endpoints with distinct reductions.
//!
//! The checker compares each motive against the other reduced endpoint.
//! The kernel reduces the endpoints before it checks them.
//!
//! - see: #4179 — the checker refused transports with reducible endpoints

/// The identity on a type, a definition a motive may call.
def itself(A : Type, a : A) -> A =
  a

/// A 2-path stated from a composite's right unit.
def fromUnit(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z),
  h : Path[.A = A](x, z),
  s : Path[.A = Path[.A = A](x, z)](Path.step f g, h)
) -> Path[.A = Path[.A = A](x, z)](Path.step (Path.step f g) (Path.here z), h) =
  s

/// Two composites whose first 2-paths' starts differ by the right unit.
def thenStart(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z),
  h : Path[.A = A](x, z),
  k : Path[.A = A](x, z),
  s : Path[.A = Path[.A = A](x, z)](Path.step f g, h),
  r : Path[.A = Path[.A = A](x, z)](h, k)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f g, k)](
  Path.step (fromUnit A x y z f g h s) r,
  Path.step s r
) =
  Path.here (Path.step s r)

/// Motives differ at fixed endpoints after the checker unfolds `itself(A, x)`.
def unfoldEnd(
  A : Type,
  x : A,
  y : A,
  k : A,
  s : Path[.A = A](y, x),
  r : Path[.A = A](y, k)
) -> Path[.A = Path[.A = A](k, x)](
  Path.walk (fun (c) { type(Path[.A = A](c, itself A x)) }) r s,
  Path.walk (fun (c) { type(Path[.A = A](c, x)) }) r s
) =
  Path.here (Path.walk (fun (c) { type(Path[.A = A](c, x)) }) r s)

/// Motives whose fixed endpoints differ by a transport along a reflexivity.
def hereEnd(
  A : Type,
  x : A,
  y : A,
  k : A,
  s : Path[.A = A](y, x),
  r : Path[.A = A](y, k)
) -> Path[.A = Path[.A = A](k, x)](
  Path.walk (fun (c) { type(Path[.A = A](c, Path.walk (fun (d) { A }) (Path.here x) x)) }) r s,
  Path.walk (fun (c) { type(Path[.A = A](c, x)) }) r s
) =
  Path.here (Path.walk (fun (c) { type(Path[.A = A](c, x)) }) r s)

/// Motives whose fixed endpoints differ by the right unit of a composite.
def unitEnd(
  A : Type,
  x : A,
  y : A,
  z : A,
  k : Path[.A = A](x, z),
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z),
  s : Path[.A = Path[.A = A](x, z)](k, Path.step f g),
  m : Path[.A = A](x, z),
  r : Path[.A = Path[.A = A](x, z)](k, m)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](m, Path.step f g)](
  Path.walk
    (fun (c) { type(Path[.A = Path[.A = A](x, z)](c, Path.step (Path.step f g) (Path.here z))) })
    r
    s,
  Path.walk (fun (c) { type(Path[.A = Path[.A = A](x, z)](c, Path.step f g)) }) r s
) =
  Path.here (Path.walk (fun (c) { type(Path[.A = Path[.A = A](x, z)](c, Path.step f g)) }) r s)

/// Motives whose fixed endpoints differ by the right unit of a variable path.
def unitVariableEnd(
  A : Type,
  x : A,
  z : A,
  f : Path[.A = A](x, z),
  k : Path[.A = A](x, z),
  s : Path[.A = Path[.A = A](x, z)](k, f),
  m : Path[.A = A](x, z),
  r : Path[.A = Path[.A = A](x, z)](k, m)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](m, f)](
  Path.walk (fun (c) { type(Path[.A = Path[.A = A](x, z)](c, Path.step f (Path.here z))) }) r s,
  Path.walk (fun (c) { type(Path[.A = Path[.A = A](x, z)](c, f)) }) r s
) =
  Path.here (Path.walk (fun (c) { type(Path[.A = Path[.A = A](x, z)](c, f)) }) r s)
