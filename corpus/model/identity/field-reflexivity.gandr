/// This source states reflexivity in a field with a computed path type.
///
/// The `Held` family computes a path endpoint through `twofold`.
/// Both checkers must read that endpoint at the same value.
///
/// The checker records no dialogue for the computed endpoint.
/// The kernel evaluates the field type and its endpoints independently.
///
/// - see: #5364

/// A `Count` has zero and successor values.
data Count : Type where
  /// Zero.
  | Z : Count
  /// The successor of `n`.
  | S : (n : Count) --> Count

/// A `Held` value has a first value and a value from its selected type.
data Held(a : Type, b : a -> Type) : Type where
  /// The two values.
  | MkHeld : (x : a, y : b(x)) --> Held(a, b)

/// The `twofold` function doubles a count by recursion.
def rec twofold(n : Count) -> Count =
  match n where
    | Z => Z
    | S(m) => S (S (twofold[<] m))

/// The field holds reflexivity at the path type that `twofold Z` computes.
def reflField : Held(
  Unit,
  fun (u) { return (type(Path[.A = Count](twofold Z, Z))) }
) = MkHeld *{} (Path.here Z);

/// The written path type holds the same reflexivity.
def reflWritten : Path[.A = Count](twofold Z, Z) = Path.here Z;
