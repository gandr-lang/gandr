// Two nestings of one chain of paths are one composite.
//
// A proof then writes `Path.here` where it would cite an associator, and the theory
// adjoins no cell for one.
//
// A transport along a stuck composite moves its operand along each of the
// composite's paths in turn, in evaluation and in the kernel. Every nesting of
// a chain so reaches the left-nested `Path.step` fold the unbiased composite carries.
//
// - see: `compose-chain.gandr` — the unbiased composite and its fold
// - see: `then.gandr` — the composite of two paths

// The circle, its point and its loop.
import "./circle-base.gandr";

/// The right nesting of three paths is their unbiased composite.
def rightNested(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(Path(A, x, w), Path.step(f, Path.step(g, h)), compose[5, 7](chain(3), (f, g, h))) {
  Path.here(Path.step(f, Path.step(g, h)))
}

/// A composite standing as the later path: the first path moves along it.
def laterNested(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  u : A,
  k : Path(A, x, y),
  f : Path(A, y, z),
  g : Path(A, z, w),
  h : Path(A, w, u)
) -> Path(
  Path(A, x, u),
  Path.step(k, Path.step(Path.step(f, g), h)),
  Path.step(Path.step(Path.step(k, f), g), h)
) {
  Path.here(Path.step(k, Path.step(Path.step(f, g), h)))
}

/// The composite of two composites: the first moves along the second.
def pairs(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  u : A,
  k : Path(A, x, y),
  f : Path(A, y, z),
  g : Path(A, z, w),
  h : Path(A, w, u)
) -> Path(
  Path(A, x, u),
  Path.step(Path.step(k, f), Path.step(g, h)),
  Path.step(k, Path.step(f, Path.step(g, h)))
) {
  Path.here(Path.step(Path.step(k, f), Path.step(g, h)))
}

/// Two paths composed by a definition.
def tailComposite(A : Type, y : A, z : A, w : A, g : Path(A, y, z), h : Path(A, z, w)) -> Path(
  A,
  y,
  w
) {
  Path.step(g, h)
}

/// A nesting written through a definition: the composite it returns stands as the later path.
def throughCall(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(
  Path(A, x, w),
  Path.step(f, tailComposite(A, y, z, w, g, h)),
  Path.step(Path.step(f, g), h)
) {
  Path.here(Path.step(Path.step(f, g), h))
}

/// A transport along a nesting moves along each path in turn, in any family.
def transported(
  A : Type,
  M : A => Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w),
  v : M(x)
) -> Path(
  M(w),
  Path.walk(fun (a) { M(a) }, Path.step(f, Path.step(g, h)), v),
  Path.walk(fun (a) { M(a) }, h, Path.walk(fun (a) { M(a) }, g, Path.walk(fun (a) { M(a) }, f, v)))
) {
  Path.here(Path.walk(fun (a) { M(a) }, Path.step(f, Path.step(g, h)), v))
}

/// A loop between two paths at the circle's point nests as any path does.
def aroundTheLoop(
  p : Path(Circle, Base, Base),
  q : Path(Circle, Base, Base)
) -> Path(
  Path(Circle, Base, Base),
  Path.step(p, Path.step(loop, q)),
  Path.step(Path.step(p, loop), q)
) {
  Path.here(Path.step(p, Path.step(loop, q)))
}

/// Paths in another order are another composite.
@[ refuses("EndpointMismatch") ]
def reordered(
  A : Type,
  x : A,
  f : Path(A, x, x),
  g : Path(A, x, x),
  h : Path(A, x, x)
) -> Path(Path(A, x, x), Path.step(f, Path.step(g, h)), Path.step(Path.step(g, f), h)) {
  Path.here(Path.step(f, Path.step(g, h)))
}
