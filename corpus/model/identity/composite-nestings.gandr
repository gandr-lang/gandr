/// This source states that each nesting of one path chain has one composite.
///
/// The unbiased composite does not select a bracketing.
/// A proof therefore uses `Path.here` instead of an associator.
///
/// Evaluation and the kernel move each transport through the chain paths.
/// They reach the left-nested `Path.step` fold.
///
/// - see: corpus/model/identity/compose-chain.gandr
/// - see: corpus/model/identity/then.gandr
import "./circle-base.gandr";

/// The right nesting of three paths equals their unbiased composite.
def rightNested(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w)
) -> Path[.A = Path[.A = A](x, w)](
  Path.step f (Path.step g h),
  compose[5, 7] (chain 3) (f, g, h)
) =
  Path.here (Path.step f (Path.step g h))

/// The first path moves along the later composite.
def laterNested(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  u : A,
  k : Path[.A = A](x, y),
  f : Path[.A = A](y, z),
  g : Path[.A = A](z, w),
  h : Path[.A = A](w, u)
) -> Path[.A = Path[.A = A](x, u)](
  Path.step k (Path.step (Path.step f g) h),
  Path.step (Path.step (Path.step k f) g) h
) =
  Path.here (Path.step k (Path.step (Path.step f g) h))

/// The first composite moves along the second composite.
def pairs(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  u : A,
  k : Path[.A = A](x, y),
  f : Path[.A = A](y, z),
  g : Path[.A = A](z, w),
  h : Path[.A = A](w, u)
) -> Path[.A = Path[.A = A](x, u)](
  Path.step (Path.step k f) (Path.step g h),
  Path.step k (Path.step f (Path.step g h))
) =
  Path.here (Path.step (Path.step k f) (Path.step g h))

/// The `tailComposite` definition composes two paths.
def tailComposite(
  A : Type,
  y : A,
  z : A,
  w : A,
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w)
) -> Path[.A = A](
  y,
  w
) =
  Path.step g h

/// A call that returns a composite stands as the later path.
def throughCall(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w)
) -> Path[.A = Path[.A = A](x, w)](
  Path.step f (tailComposite A y z w g h),
  Path.step (Path.step f g) h
) =
  Path.here (Path.step (Path.step f g) h)

/// Transport through a nesting moves through each path in every family.
def transported(
  A : Type,
  M : A -> Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w),
  v : M x
) -> Path[.A = M w](
  Path.walk (fun (a) { M a }) (Path.step f (Path.step g h)) v,
  Path.walk (fun (a) { M a }) h (Path.walk (fun (a) { M a }) g (Path.walk (fun (a) { M a }) f v))
) =
  Path.here (Path.walk (fun (a) { M a }) (Path.step f (Path.step g h)) v)

/// A circle loop between two paths nests as every path does.
def aroundTheLoop(
  p : Path[.A = Circle](Base, Base),
  q : Path[.A = Circle](Base, Base)
) -> Path[.A = Path[.A = Circle](Base, Base)](
  Path.step p (Path.step loop q),
  Path.step (Path.step p loop) q
) =
  Path.here (Path.step p (Path.step loop q))

/// The checker refuses a composite whose paths use another order.
@[ refuses("EndpointMismatch") ]
def reordered(
  A : Type,
  x : A,
  f : Path[.A = A](x, x),
  g : Path[.A = A](x, x),
  h : Path[.A = A](x, x)
) -> Path[.A = Path[.A = A](x, x)](Path.step f (Path.step g h), Path.step (Path.step g f) h) =
  Path.here (Path.step f (Path.step g h))
