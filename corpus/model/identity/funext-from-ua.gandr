// Function extensionality from univalence, Voevodsky's argument: the
// diagonal of the path space of `b` is an equivalence, so `ua` makes it a
// path between types, and carrying a function out of the path space back
// along that path is injective. The two ends of the path space read back
// alike along it, both the identity, so they are one function, and any map
// into the path space gives a path between its two ends. A homotopy is such
// a map, and its ends read back as the two functions. The HoTT book's § 4.9
// credits the argument to Voevodsky and reworks it through weak function
// extensionality.

/// The diagonal of the path space: a point, to itself, along reflexivity.
def diag(b : Type, v : b) -> #{x : b, y : b, p : Path(b, x, y)} {
  (v, (v, Path.here(v)))
}

/// The first end of a path.
def source(b : Type, w : #{x : b, y : b, p : Path(b, x, y)}) -> b {
  match w {
    #{.x = u, .y = v, .p = q} => u
  }
}

/// The second end of a path.
def target(b : Type, w : #{x : b, y : b, p : Path(b, x, y)}) -> b {
  match w {
    #{.x = u, .y = v, .p = q} => v
  }
}

/// The diagonal at a path's first end is the path, by `J` on it.
def diagSource(b : Type, w : #{x : b, y : b, p : Path(b, x, y)}) -> Path(
  #{x : b, y : b, p : Path(b, x, y)},
  diag(b, source(b, w)),
  w
) {
  match w {
    #{.x = u, .y = v, .p = q} => Path.walk(
      (y : b, z : Path(b, u, y)) => Path(
        #{x : b, y : b, p : Path(b, x, y)},
        diag(b, u),
        (u, (y, z))
      ),
      q,
      Path.here(u),
      Path.here(q),
      Path.here(diag(b, u))
    )
  }
}

/// The diagonal is bi-invertible, the first end both its inverses.
def diagEquiv(b : Type) -> b ≃ #{x : b, y : b, p : Path(b, x, y)} {
  (
    fun (v) { diag(b, v) },
    (
      (fun (w) { source(b, w) }, fun (v) { Path.here(v) }),
      (fun (w) { source(b, w) }, fun (w) { diagSource(b, w) })
    )
  )
}

/// A function into `b` carried back along a path between types and forward
/// again is itself, at every function, by `J` on the path.
def roundTrip(b : Type, x : Type, y : Type, p : Path(Type, x, y)) -> (u : y => b) => Path(
  y => b,
  Path.walk(fun (Z) { Z => b }, p, Path.walk(fun (Z) { Z => b }, Path.back(p), u)),
  u
) {
  Path.walk(
    (w : Type, z : Path(Type, x, w)) => (v : w => b) => Path(
      w => b,
      Path.walk(fun (Z) { Z => b }, z, Path.walk(fun (Z) { Z => b }, Path.back(z), v)),
      v
    ),
    p,
    Path.here(x),
    Path.here(p),
    fun (v) { Path.here(v) }
  )
}

/// Two functions into `b` that are one stay one carried forward along a path
/// between types, by `J` on the path between them.
def carryPath(
  b : Type,
  x : Type,
  y : Type,
  p : Path(Type, x, y),
  u : x => b,
  v : x => b,
  e : Path(x => b, u, v)
) -> Path(y => b, Path.walk(fun (Z) { Z => b }, p, u), Path.walk(fun (Z) { Z => b }, p, v)) {
  Path.walk(
    (w : x => b, Path(x => b, u, w)) => Path(
      y => b,
      Path.walk(fun (Z) { Z => b }, p, u),
      Path.walk(fun (Z) { Z => b }, p, w)
    ),
    e,
    Path.here(u),
    Path.here(e),
    Path.here(Path.walk(fun (Z) { Z => b }, p, u))
  )
}

/// Three paths between functions into `b`, the first reversed, in a row.
def chain(
  b : Type,
  y : Type,
  u : y => b,
  s : y => b,
  r : y => b,
  v : y => b,
  l : Path(y => b, s, u),
  c : Path(y => b, s, r),
  m : Path(y => b, r, v)
) -> Path(y => b, u, v) {
  Path.step(Path.step(Path.back(l), c), m)
}

/// Carrying back along a path between types is injective: two functions
/// into `b` whose carried copies are one are one.
def carryInjective(
  b : Type,
  x : Type,
  y : Type,
  p : Path(Type, x, y),
  u : y => b,
  v : y => b,
  e : Path(
    x => b,
    Path.walk(fun (Z) { Z => b }, Path.back(p), u),
    Path.walk(fun (Z) { Z => b }, Path.back(p), v)
  )
) -> Path(y => b, u, v) {
  let all = roundTrip(b, x, y, p);
  let l = all(u);
  let m = all(v);
  let c = carryPath(
    b,
    x,
    y,
    p,
    Path.walk(fun (Z) { Z => b }, Path.back(p), u),
    Path.walk(fun (Z) { Z => b }, Path.back(p), v),
    e
  );
  chain(
    b,
    y,
    u,
    Path.walk(fun (Z) { Z => b }, p, Path.walk(fun (Z) { Z => b }, Path.back(p), u)),
    Path.walk(fun (Z) { Z => b }, p, Path.walk(fun (Z) { Z => b }, Path.back(p), v)),
    v,
    l,
    c,
    m
  )
}

/// The two ends of the path space are one function: carried back along
/// `ua` of the diagonal, each runs the diagonal and then reads an end, and
/// both are the identity by conversion.
def endsAgree(b : Type) -> Path(
  #{x : b, y : b, p : Path(b, x, y)} => b,
  thunk { fun (w) { source(b, w) } },
  thunk { fun (w) { target(b, w) } }
) {
  carryInjective(
    b,
    b,
    type(#{x : b, y : b, p : Path(b, x, y)}),
    ua((
      thunk { fun (v) { diag(b, v) } },
      (
        (thunk { fun (w) { source(b, w) } }, thunk { fun (v) { Path.here(v) } }),
        (thunk { fun (w) { source(b, w) } }, thunk { fun (w) { diagSource(b, w) } })
      )
    )),
    thunk { fun (w) { source(b, w) } },
    thunk { fun (w) { target(b, w) } },
    Path.here(thunk { fun (v) { v } })
  )
}

/// Two functions out of the path space that are one stay one after any map
/// into it, by `J` on the path between them.
def whisker(
  a : Type,
  b : Type,
  k : a => #{x : b, y : b, p : Path(b, x, y)},
  s : #{x : b, y : b, p : Path(b, x, y)} => b,
  t : #{x : b, y : b, p : Path(b, x, y)} => b,
  e : Path(#{x : b, y : b, p : Path(b, x, y)} => b, s, t)
) -> Path(a => b, fun (x) { s(k(x)) }, fun (x) { t(k(x)) }) {
  Path.walk(
    (w : #{x : b, y : b, p : Path(b, x, y)} => b, Path(
      #{x : b, y : b, p : Path(b, x, y)} => b,
      s,
      w
    )) => Path(a => b, fun (x) { s(k(x)) }, fun (x) { w(k(x)) }),
    e,
    Path.here(s),
    Path.here(e),
    Path.here(fun (x) { s(k(x)) })
  )
}

/// Function extensionality at the path space: a map into it gives a path
/// between its two ends, whatever the functions are.
def funextOfSpace(a : Type, b : Type, k : a => #{x : b, y : b, p : Path(b, x, y)}) -> Path(
  a => b,
  fun (x) { source(b, k(x)) },
  fun (x) { target(b, k(x)) }
) {
  whisker(
    a,
    b,
    k,
    fun (w) { source(b, w) },
    fun (w) { target(b, w) },
    endsAgree(b)
  )
}

/// Function extensionality from a homotopy, through the path space: the map
/// takes a point to both functions' results there and the homotopy's path
/// between them. Its first end reads the first result, a returned call, and
/// a returned call is the call it holds, so the end is `f`; the second is
/// `g`.
def funextFromUa(
  a : Type,
  b : Type,
  f : a => b,
  g : a => b,
  h : (x : a) => Path(b, f(x), g(x))
) -> Path(a => b, f, g) {
  funextOfSpace(a, b, fun (x) { (f(x), (g(x), h(x))) })
}
