/// This source derives function extensionality from univalence.
///
/// The diagonal makes each point into a reflexive path.
/// A homotopy gives a map into that path space.
///
/// The checker turns the diagonal equivalence into a path with `ua`.
/// Transport then proves that the path-space endpoints are equal.
///
/// - see: corpus/model/identity/univalence.gandr

/// The diagonal maps a point to its reflexive path.
def diag(b : Type, v : b) -> *{x : b, y : b, p : Path[.A = b](x, y)} =
  *{v, *{v, Path.here v}}

/// The `source` function reads the first endpoint of a path.
def source(b : Type, w : *{x : b, y : b, p : Path[.A = b](x, y)}) -> b =
  match w where
    | *{.x = u, .y = v, .p = q} => u

/// The `target` function reads the second endpoint of a path.
def target(b : Type, w : *{x : b, y : b, p : Path[.A = b](x, y)}) -> b =
  match w where
    | *{.x = u, .y = v, .p = q} => v

/// The `diagSource` proof uses `J` to identify a diagonal with its path.
def diagSource(
  b : Type,
  w : *{x : b, y : b, p : Path[.A = b](x, y)}
) -> Path[.A = *{x : b, y : b, p : Path[.A = b](x, y)}](
  diag b (source b w),
  w
) =
  match w where
    | *{.x = u, .y = v, .p = q} => Path.walk
      ((y : b, z : Path[.A = b](u, y)) -> Path[.A = *{x : b, y : b, p : Path[.A = b](x, y)}](
        diag b u,
        *{u, *{y, z}}
      ))
      q
      (Path.here u)
      (Path.here q)
      (Path.here (diag b u))

/// The diagonal is bi-invertible with `source` as both inverses.
def diagEquiv(b : Type) -> b ≃ *{x : b, y : b, p : Path[.A = b](x, y)} =
  *{
    fun (v) { diag b v },
    *{
      *{fun (w) { source b w }, fun (v) { Path.here v }},
      *{fun (w) { source b w }, fun (w) { diagSource b w }}
    }
  }

/// The round trip carries a function back then forward by `J`.
def roundTrip(
  b : Type,
  x : Type,
  y : Type,
  p : Path[.A = Type](x, y)
) -> (u : y -> b) -> Path[.A = y -> b](
  Path.walk (fun (Z) { Z -> b }) p (Path.walk (fun (Z) { Z -> b }) (Path.back p) u),
  u
) =
  Path.walk
    ((w : Type, z : Path[.A = Type](x, w)) -> ((v : w -> b) -> Path[.A = w -> b](
      Path.walk (fun (Z) { Z -> b }) z (Path.walk (fun (Z) { Z -> b }) (Path.back z) v),
      v
    )))
    p
    (Path.here x)
    (Path.here p)
    (fun (v) { Path.here v })

/// The `carryPath` proof carries an equality between functions forward by `J`.
def carryPath(
  b : Type,
  x : Type,
  y : Type,
  p : Path[.A = Type](x, y),
  u : x -> b,
  v : x -> b,
  e : Path[.A = x -> b](u, v)
) -> Path[.A = y -> b](Path.walk (fun (Z) { Z -> b }) p u, Path.walk (fun (Z) { Z -> b }) p v) =
  Path.walk
    ((w : x -> b, Path[.A = x -> b](u, w)) -> Path[.A = y -> b](
      Path.walk (fun (Z) { Z -> b }) p u,
      Path.walk (fun (Z) { Z -> b }) p w
    ))
    e
    (Path.here u)
    (Path.here e)
    (Path.here (Path.walk (fun (Z) { Z -> b }) p u))

/// The `chain` function composes three function paths with the first reversed.
def chain(
  b : Type,
  y : Type,
  u : y -> b,
  s : y -> b,
  r : y -> b,
  v : y -> b,
  l : Path[.A = y -> b](s, u),
  c : Path[.A = y -> b](s, r),
  m : Path[.A = y -> b](r, v)
) -> Path[.A = y -> b](u, v) =
  Path.step (Path.step (Path.back l) c) m

/// Back transport is injective for functions into `b`.
def carryInjective(
  b : Type,
  x : Type,
  y : Type,
  p : Path[.A = Type](x, y),
  u : y -> b,
  v : y -> b,
  e : Path[.A = x -> b](
    Path.walk (fun (Z) { Z -> b }) (Path.back p) u,
    Path.walk (fun (Z) { Z -> b }) (Path.back p) v
  )
) -> Path[.A = y -> b](u, v) =
  let all = roundTrip b x y p
  let l = all u
  let m = all v
  let c = carryPath
    b
    x
    y
    p
    (Path.walk (fun (Z) { Z -> b }) (Path.back p) u)
    (Path.walk (fun (Z) { Z -> b }) (Path.back p) v)
    e
  chain
    b
    y
    u
    (Path.walk (fun (Z) { Z -> b }) p (Path.walk (fun (Z) { Z -> b }) (Path.back p) u))
    (Path.walk (fun (Z) { Z -> b }) p (Path.walk (fun (Z) { Z -> b }) (Path.back p) v))
    v
    l
    c
    m

/// Back transport maps both path-space endpoints to the identity function.
def endsAgree(b : Type) -> Path[.A = *{x : b, y : b, p : Path[.A = b](x, y)} -> b](
  thunk { fun (w) { source b w } },
  thunk { fun (w) { target b w } }
) =
  carryInjective
    b
    b
    (type(*{x : b, y : b, p : Path[.A = b](x, y)}))
    (ua (*{
      thunk { fun (v) { diag b v } },
      *{
        *{thunk { fun (w) { source b w } }, thunk { fun (v) { Path.here v } }},
        *{thunk { fun (w) { source b w } }, thunk { fun (w) { diagSource b w } }}
      }
    }))
    (thunk { fun (w) { source b w } })
    (thunk { fun (w) { target b w } })
    (Path.here (thunk { fun (v) { v } }))

/// An equality between path-space functions persists after any map
/// into that space.
def whisker(
  a : Type,
  b : Type,
  k : a -> *{x : b, y : b, p : Path[.A = b](x, y)},
  s : *{x : b, y : b, p : Path[.A = b](x, y)} -> b,
  t : *{x : b, y : b, p : Path[.A = b](x, y)} -> b,
  e : Path[.A = *{x : b, y : b, p : Path[.A = b](x, y)} -> b](s, t)
) -> Path[.A = a -> b](fun (x) { s (k x) }, fun (x) { t (k x) }) =
  Path.walk
    ((
      w : *{x : b, y : b, p : Path[.A = b](x, y)} -> b,
      Path[.A = *{x : b, y : b, p : Path[.A = b](x, y)} -> b](
        s,
        w
      )
    ) -> Path[.A = a -> b](fun (x) { s (k x) }, fun (x) { w (k x) }))
    e
    (Path.here s)
    (Path.here e)
    (Path.here (fun (x) { s (k x) }))

/// A map into path space gives a path between its endpoint functions.
def funextOfSpace(
  a : Type,
  b : Type,
  k : a -> *{x : b, y : b, p : Path[.A = b](x, y)}
) -> Path[.A = a -> b](
  fun (x) { source b (k x) },
  fun (x) { target b (k x) }
) =
  whisker
    a
    b
    k
    (fun (w) { source b w })
    (fun (w) { target b w })
    (endsAgree b)

/// A homotopy maps each point to a path-space element with endpoints
/// `f` and `g`.
def funextFromUa(
  a : Type,
  b : Type,
  f : a -> b,
  g : a -> b,
  h : (x : a) -> Path[.A = b](f x, g x)
) -> Path[.A = a -> b](f, g) =
  funextOfSpace a b (fun (x) { *{f x, *{g x, h x}} })
