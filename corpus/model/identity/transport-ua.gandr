//! This source transports values along `ua` by family shape.
//!
//! A constant family keeps its value.
//! Products, sums and lists transport each component.
//!
//! The checker reduces `ua(winding)` at each family constructor.
//! The runtime evaluates the same transport in a run.
//!
//! - see: HoTT Book §2.10
//! - see: HoTT Book Theorem 2.6.4
//! - see: HoTT Book §2.12

// The circle, the presented integers, the winding number and spinning.
import "./circle-base.gandr";
// The equivalence of the loops at the point with the integers, `winding`.
import "./circle.gandr";
// The native finite lists.
import std.list (List);

/// A family that never reads its argument keeps the value, by conversion.
def constantBeta : Path[.A = Int](Path.walk (fun (X) { Int }) (ua winding) Z, Z) = Path.here Z;

/// A family that never reads its argument keeps the value, by a run.
@[ runs("Z") ]
def constantRun() -> Int { Path.walk (fun (X) { Int }) (ua winding) Z }

/// A pair carried along the loops' path carries each component, by
/// conversion: the book's Theorem 2.6.4.
def pairBeta : Path[.A = Int * Int](
  Path.walk (fun (X) { type(X * X) }) (ua winding) (*{loop, loop}),
  *{S Z, S Z}
) = Path.here (*{S Z, S Z});

/// A pair carried along the loops' path carries each component, by a run.
@[ runs("*{S Z, S Z}") ]
def pairRun() -> Int * Int { Path.walk (fun (X) { type(X * X) }) (ua winding) (*{loop, loop}) }

/// An injection carried along the loops' path carries its payload in its own
/// summand, by conversion: the book's § 2.12.
def sumBeta : Path[.A = Unit + Int](
  Path.walk (fun (X) { type(Unit + X) }) (ua winding) (+{.1 = loop}),
  +{.1 = S Z}
) = Path.here (+{.1 = S Z});

/// An injection carried along the loops' path carries its payload, by a run.
@[ runs("+{.1 = S Z}") ]
def sumRun() -> Unit + Int { Path.walk (fun (X) { type(Unit + X) }) (ua winding) (+{.1 = loop}) }

/// A list carried along the loops' path carries every cell, by conversion.
def listBeta : Path[.A = List(Int)](
  Path.walk (fun (X) { List X }) (ua winding) (cons loop nil),
  cons (S Z) nil
) = Path.here (cons (S Z) nil);

/// A list carried along the loops' path carries every cell, by a run.
@[ runs("cons (S Z) nil") ]
def listRun() -> List(Int) { Path.walk (fun (X) { List X }) (ua winding) (cons loop nil) }
