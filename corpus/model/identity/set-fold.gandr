//! This source checks folds into path types of sets.
//!
//! Integer and loop-word presentations have equal paths with equal endpoints.
//! The source compares folds whose arms use these set paths.
//!
//! The checker compares the endpoints of each rule arm.
//! The kernel re-derives each resulting law.
//!
//! - see: #427 — `plusCommAlong`
//! - see: HoTT Book Definition 3.1.1

// This import supplies the circle and integers with their steps.
import "./circle-base.gandr";
// This import supplies integer sum and its left unit.
// It also supplies successor and predecessor rules on the left.
import "./int-sum.gandr";
// The loop's words and one loop more.
import "./loop-words.gandr";

/// The `flipS` path reverses `plusS`.
def flipS(x : Int, a : Int) -> Path[.A = Int](S (plus x a), plus (S x) a) =
  Path.back (plusS x a)

/// The `flipP` path reverses `plusP`.
def flipP(x : Int, a : Int) -> Path[.A = Int](P (plus x a), plus (P x) a) =
  Path.back (plusP x a)

/// The successor preserves a commuting pair of sums.
def upOf(a : Int, x : Int, e : Path[.A = Int](plus a x, plus x a)) -> Path[.A = Int](
  S (plus a x),
  S (plus x a)
) =
  Path.ap up e

/// The predecessor preserves a commuting pair of sums.
def downOf(a : Int, x : Int, e : Path[.A = Int](plus a x, plus x a)) -> Path[.A = Int](
  P (plus a x),
  P (plus x a)
) =
  Path.ap down e

/// The `upAlong` path applies the call image and `plusS`.
def upAlong(a : Int, x : Int, e : Path[.A = Int](plus a x, plus x a)) -> Path[.A = Int](
  S (plus a x),
  plus (S x) a
) =
  Path.step (upOf a x e) (flipS x a)

/// The `downAlong` path applies the call image and `plusP`.
def downAlong(a : Int, x : Int, e : Path[.A = Int](plus a x, plus x a)) -> Path[.A = Int](
  P (plus a x),
  plus (P x) a
) =
  Path.step (downOf a x e) (flipP x a)

/// The `plusCommAlong` recursion proves that addition commutes.
/// At `S(P(x))`, the set rule identifies its equal integer paths.
def rec plusCommAlong(a : Int, b : Int) -> Path[.A = Int](plus a b, plus b a) =
  match b where
    | Z => Path.back (plusZ a)
    | S(x) => upAlong a x (plusCommAlong[<] a x)
    | P(x) => downAlong a x (plusCommAlong[<] a x)

/// The `turned` recursion maps integers to circle loops.
/// At `S(P(x))`, the checker refuses unequal loops.
@[ refuses("RuleNotRespected") ]
def rec turned(b : Int) -> Path[.A = Circle](Base, Base) =
  match b where
    | Z => Path.here Base
    | S(x) => Path.step (turned[<] x) loop
    | P(x) => turned[<] x

/// The `rewound` recursion gives each word a path to itself.
/// The set rule equates the inverse arm with its endpoint path.
def rec rewound(w : Words) -> Path[.A = Words](w, w) =
  match w where
    | Nil => Path.here Nil
    | Loop(x) => Path.ap around (rewound[<] x)
    | Unloop(x) => Path.here (Unloop x)
