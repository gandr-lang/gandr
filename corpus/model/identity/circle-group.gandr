// The circle's loop space as a group, after the group-law half of cubical
// Agda's `Cubical/HITs/S1/Base.agda`: spinning as a map of sums, winding as
// one, and the loops commuting. `circle.gandr` holds the equivalence
// `winding` these laws read through, `int-sum.gandr` the integers' sum and
// its laws, and `circle-rotation.gandr` the circle's multiplication. Where
// cubical fills a cube by `hcomp`, a law here is conversion on words or
// `cong`.
//
// Out of reach by design: `ΩS¹≡ℤ`, the loops equal to the integers as types,
// needs univalence; `isSetΩS¹` and `toPropElim` need the h-level ladder;
// `basedΩS¹ x ≡ ℤ` at every point needs equivalences as structure.

// The circle, the integers, winding, spinning and the round trip `sect`.
import "./circle-base.gandr" ;
// The integers' sum and its laws.
import "./int-sum.gandr" ;

/// Spinning a successor is one loop more (cubical's `intLoop-sucℤ`), by
/// computation.
@[ checks ]
def spinUp(n : Int) -> -F Path(Path(Circle, Base, Base), spin(S(n)), loop ∷ spin(n)) {
  here(loop ∷ spin(n))
}

/// Spinning a predecessor is one inverse loop more (cubical's
/// `intLoop-predℤ`), by computation.
@[ checks ]
def spinDown(n : Int) -> -F Path(Path(Circle, Base, Base), spin(P(n)), back(loop) ∷ spin(n)) {
  here(back(loop) ∷ spin(n))
}

/// Spinning a sum is composing the spins (cubical's `intLoop-hom`), by
/// induction on the second summand. `spin` puts its new loop first where
/// cubical's `intLoop` puts it last, so the law composes the spins the other
/// way round, as the words compute: `(loop ∷ p) then q` is
/// `loop ∷ (p then q)` (#422). At zero `spin(Z)` is a call that returns the
/// empty word, and the composite over it runs that call first (#473); the
/// composites the arms carry convert through their definitions (#440).
@[ checks ]
def rec spinHom(
  a : Int,
  b : Int
) -> -F Path(Path(Circle, Base, Base), spin(plus(a, b)), spin(b) then spin(a)) {
  case b {
    Z => here(spin(a)),
    S(x) => cong(loopOn, spinHom[<](a, x)),
    P(x) => cong(unloopOn, spinHom[<](a, x))
  }
}

/// Winding a composite is summing the windings (cubical's `winding-hom`), by
/// induction on the first loop, written last so its match stands directly
/// under the recursion, where the checkers read it as a fold, and summed with
/// `wind(q)` first because the sum descends its second summand:
/// `here(wind(q))` on the empty word, and the recursive call carried along
/// `up` or `down`. The composite in its type is read off the parameters'
/// written types (#423), and the kernel reads its endpoint
/// `plus(wind(q), wind(p))` as the call it returns (#424).
@[ checks ]
def rec windHom(
  q : Path(Circle, Base, Base),
  p : Path(Circle, Base, Base)
) -> -F Path(Int, wind(p then q), plus(wind(q), wind(p))) {
  case p {
    here => here(wind(q)),
    loop ∷ r => cong(up, windHom[<](q, r)),
    back(loop) ∷ r => cong(down, windHom[<](q, r))
  }
}

/// The loops commute (cubical's `comm-ΩS¹`): each composite is the spin of
/// its winding by `sect`, the windings sum by `windHom`, and the sums commute
/// by `plusComm`. Each lemma is read at its written result (#423), and the
/// calls in the types stand as what they return (#426).
@[ checks ]
def comm(
  p : Path(Circle, Base, Base),
  q : Path(Circle, Base, Base)
) -> -F Path(Path(Circle, Base, Base), p then q, q then p) {
  back(sect(p then q)) then cong(spin, windHom(q, p)) then cong(
    spin,
    plusComm(wind(q), wind(p))
  ) then back(cong(spin, windHom(p, q))) then sect(q then p)
}

/// Three loops spun and wound count three (cubical's `test-winding-pos`).
@[ runs("S(S(S(Z)))") ]
def windThree : () => Int = wind(spin(S(S(S(Z))))) ;

/// Two inverse loops spun and wound count minus two (cubical's
/// `test-winding-neg`).
@[ runs("P(P(Z))") ]
def windMinusTwo : () => Int = wind(spin(P(P(Z)))) ;
