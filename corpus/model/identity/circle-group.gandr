// The circle's loop space as a group, after the group-law half of cubical
// Agda's `Cubical/HITs/S1/Base.agda`: spinning as a map of sums, winding as
// one, and the loops commuting. `circle.gandr` holds the equivalence
// `winding` these laws read through, `int-sum.gandr` the integers' sum and
// its laws, and `circle-rotation.gandr` the circle's multiplication. Where
// cubical fills a cube by `hcomp`, a law here is conversion on words or
// `Path.ap`.
//
// Out of reach by design: `ΩS¹≡ℤ`, the loops equal to the integers as types,
// needs univalence; `isSetΩS¹` and `toPropElim` need the h-level ladder;
// `basedΩS¹ x ≡ ℤ` at every point needs equivalences as structure.
//
// - see: #422 — `spinHom`
// - see: #473 — `spinHom`
// - see: #440 — `spinHom`
// - see: #423 — `windHom`, `comm`
// - see: #424 — `windHom`
// - see: #4618 — `spunComm`
// - see: #426 — `comm`

// The circle, the integers, winding, spinning and the round trip `sect`.
import "./circle-base.gandr";
// The integers' sum and its laws.
import "./int-sum.gandr";

/// Spinning a successor is one loop more (cubical's `intLoop-sucℤ`), by
/// computation.
def spinUp(n : Int) -> Path[.A = Path[.A = Circle](Base, Base)](spin (S n), loop ∷ spin n) =
  Path.here (loop ∷ spin n)

/// Spinning a predecessor is one inverse loop more (cubical's
/// `intLoop-predℤ`), by computation.
def spinDown(n : Int) -> Path[.A = Path[.A = Circle](Base, Base)](
  spin (P n),
  back (loop) ∷ spin n
) =
  Path.here (back (loop) ∷ spin n)

/// Spinning a sum is composing the spins (cubical's `intLoop-hom`), by
/// induction on the second summand. `spin` puts its new loop first where
/// cubical's `intLoop` puts it last, so the law composes the spins the other
/// way round, as the words compute: `Path.step(loop ∷ p, q)` is
/// `loop ∷ Path.step(p, q)`. At zero `spin(Z)` is a call that returns the
/// empty word, and the composite over it runs that call first; the
/// composites the arms carry convert through their definitions.
def rec spinHom(
  a : Int,
  b : Int
) -> Path[.A = Path[.A = Circle](Base, Base)](spin (plus a b), (Path.step (spin b)) (spin a)) =
  match b
    | Z => Path.here (spin a)
    | S(x) => Path.ap loopOn (spinHom[<] a x)
    | P(x) => Path.ap unloopOn (spinHom[<] a x)

/// Winding a composite is summing the windings (cubical's `winding-hom`), by
/// induction on the first loop, written last so its match stands directly
/// under the recursion, where the checkers read it as a fold, and summed with
/// `wind(q)` first because the sum descends its second summand:
/// `Path.here(wind(q))` on the empty word, and the recursive call carried along
/// `up` or `down`. The composite in its type is read off the parameters'
/// written types, and the kernel reads its endpoint
/// `plus(wind(q), wind(p))` as the call it returns.
def rec windHom(
  q : Path[.A = Circle](Base, Base),
  p : Path[.A = Circle](Base, Base)
) -> Path[.A = Int](wind (Path.step p q), (plus (wind q)) (wind p)) =
  match p
    | here => Path.here (wind q)
    | loop ∷ r => Path.ap up (windHom[<] q r)
    | back(loop) ∷ r => Path.ap down (windHom[<] q r)

/// The spin of `plusComm`, written as the transport `Path.ap(spin, …)`
/// derives: a static motive whose endpoints call the group's operations, each
/// call the value it returns, as the kernel replays it.
def spunComm(
  p : Path[.A = Circle](Base, Base),
  q : Path[.A = Circle](Base, Base)
) -> Path[.A = Path[.A = Circle](Base, Base)](
  spin ((plus (wind q)) (wind p)),
  spin ((plus (wind p)) (wind q))
) =
  ((Path.walk (fun (a) {
      type(Path[.A = Path[.A = Circle](Base, Base)](spin ((plus (wind q)) (wind p)), spin a))
    })) ((plusComm (wind q)) (wind p))) (Path.here (spin ((plus (wind q)) (wind p))))

/// The loops commute (cubical's `comm-ΩS¹`): each composite is the spin of
/// its winding by `sect`, the windings sum by `windHom`, and the sums commute
/// by `plusComm`. Each lemma is read at its written result, and the
/// calls in the types stand as what they return.
def comm(
  p : Path[.A = Circle](Base, Base),
  q : Path[.A = Circle](Base, Base)
) -> Path[.A = Path[.A = Circle](Base, Base)](Path.step p q, Path.step q p) =
  (compose[9, 11] (chain 5)) (*{
    Path.back (sect (Path.step p q)),
    Path.ap spin (windHom q p),
    Path.ap spin ((plusComm (wind q)) (wind p)),
    Path.back (Path.ap spin (windHom p q)),
    sect (Path.step q p)
  })

/// Three loops spun and wound count three (cubical's `test-winding-pos`).
@[ runs("S (S (S Z))") ]
def windThree : () -> Int = wind (spin (S (S (S Z))));

/// Two inverse loops spun and wound count minus two (cubical's
/// `test-winding-neg`).
@[ runs("P (P Z)") ]
def windMinusTwo : () -> Int = wind (spin (P (P Z)));
