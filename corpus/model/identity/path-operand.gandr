/// This source states how derived path operations find an operand path type.
///
/// A parameter uses its binder type.
/// A call uses the result type of its declaration.
///
/// A recursive call uses its own function result.
/// `Path.ap` uses the written result of its parameter function.
///
/// - see: #423 — `stated`, `thrice`
/// - see: #546 — `mappedOver`, `mappedInto`

// The circle and the free naturals.
import "./circle-base.gandr";

/// The `next` function adds one successor.
def next(n : Nat) -> Nat =
  Succ n

/// The `backThen` function reverses a parameter path and then composes it.
def backThen(p : Path[.A = Circle](Base, Base)) -> Path[.A = Circle](Base, Base) =
  Path.step (Path.back p) p

/// The `stated` proof has a written composite path type.
def stated(p : Path[.A = Circle](Base, Base)) -> Path[.A = Path[.A = Circle](Base, Base)](
  Path.step p loop,
  Path.step p loop
) =
  Path.here (Path.step p loop)

/// The `walkTwice` function composes a path with itself.
def walkTwice(p : Path[.A = Circle](Base, Base)) -> Path[.A = Circle](Base, Base) =
  Path.step p p

/// The `untwice` function reads the call result before it reverses it.
def untwice(p : Path[.A = Circle](Base, Base)) -> Path[.A = Circle](Base, Base) =
  Path.step (Path.back (walkTwice p)) loop

/// The `thrice` proof uses a called composite in its path type.
def thrice(p : Path[.A = Circle](Base, Base)) -> Path[.A = Path[.A = Circle](Base, Base)](
  Path.step (walkTwice p) p,
  Path.step (walkTwice p) p
) =
  Path.here (Path.step (walkTwice p) p)

/// The `unthrice` proof reads the declared result before it reverses the path.
def unthrice(p : Path[.A = Circle](Base, Base)) -> Path[.A = Path[.A = Circle](Base, Base)](
  Path.step (walkTwice p) p,
  Path.step (walkTwice p) p
) =
  Path.back (thrice p)

/// The `stay` declaration gives a path at a natural number.
@[ owes(1) ]
def stay : (a : Nat) -> Path[.A = Nat](a, a);

/// The `stayUp` proof reads the result of the `stay` declaration.
def stayUp(a : Nat) -> Path[.A = Nat](Succ a, Succ a) =
  Path.step (Path.ap next (stay a)) (Path.here (Succ a))

/// The `still` recursion reads its own result type.
def rec still(b : Nat) -> Path[.A = Nat](b, b) =
  match b where
    | Zero => Path.here Zero
    | Succ(x) => Path.step (Path.ap next (still[<] x)) (Path.here (Succ x))

/// The `mapped` proof reads the parameter function result.
def mapped(f : Circle -> Nat) -> Path[.A = Nat](f Base, f Base) =
  Path.back (Path.ap f loop)

/// The `mappedOver` proof reads a parameter map that depends on an earlier type.
def mappedOver(b : Type, g : b -> Nat, u : b, v : b, q : Path[.A = b](u, v)) -> Path[.A = Nat](
  g v,
  g u
) =
  Path.back (Path.ap g q)

/// The `mappedInto` proof uses the same map in a type and a body.
def mappedInto(
  a : Type,
  b : Type,
  g : b -> a,
  u : b,
  v : b,
  q : Path[.A = b](u, v)
) -> Path[.A = Path[.A = a](g u, g v)](
  Path.ap g q,
  Path.ap g q
) =
  Path.here (Path.ap g q)

/// A non-path parameter gives no path type to read.
@[ refuses("OutOfFragment.Unannotated") ]
def pointed(c : Circle) -> -F Path[.A = Circle](Base, Base) =
  Path.step (Path.back c) loop
