//! This source defines the `⇝` notation for a flow between types.
//! The notation also accepts `A ~~> B`.
//!
//! A flow represents a translator without an inverse round trip.
//! Directed univalence classifies it as a function.
//!
//! `Flow.into` constructs a flow from a translator.
//! The checker expands the notation to `Flow[.A = Type](A, B)`.
//!
//! - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
//!
//! [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

// The old and the new schema and the translator between them.
import "./flow-migration.gandr";

/// The `shift` flow maps the old schema to the new schema.
/// Its translator is `Schema.toNew`.
def shift : Schema.Old ⇝ Schema.New = Flow.into Schema.toNew;

/// The `shifted` declaration names the full `Flow` type of `shift`.
def shifted : Flow[.A = Type](Schema.Old, Schema.New) = shift;

/// `Flow.ride` translates a record of the old schema.
@[runs("*{30, \"ada\", +{.0 = *{}}}")]
def ridden() -> Schema.New { Flow.ride (fun (X) { X }) shift *{"ada", 30} }
