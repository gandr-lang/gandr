// A flow between types written as the relation `A ⇝ B`, also `A ~~> B`: the
// type-level spelling of `Flow(Type, A, B)`, introduced by `forward` over a
// translator. Under directed univalence a flow between types is a function
// (Gratzer, Weinberger and Buchholtz, _Directed univalence in simplicial
// homotopy type theory_, arXiv:2407.09146, Definition 1.2), so `⇝`
// abbreviates the flow itself and no record of round trips stands beside it.

// The old and the new schema and the translator between them.
import "./flow-migration.gandr";

/// The old schema shifted to the new by its translator, the flow written as
/// the relation between the two types.
def shift : Schema.Old ⇝ Schema.New = forward(Schema.toNew);

/// The relation is the flow it abbreviates: `shift` stands where the flow is
/// written out.
def shifted : Flow(Type, Schema.Old, Schema.New) = shift;

/// Riding the relation translates a record of the old schema.
@[ runs("(30, \"ada\", +{.0 = unit})") ]
def ridden() -> Schema.New { ride(\X. X, shift, ("ada", 30)) }
