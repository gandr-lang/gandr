/// A held run reaches two definitions.
///
/// The kernel reads the composite as its second path, as the checker does.
///
/// The run evaluates a held call before it reads its word.
/// It evaluates `zero2` and then `zero`.
///
/// - see: #3789 — the kernel took one step of the run and left it at `zero`

/// The composite of two paths, whose type states its endpoints.
def joinedPaths(A : Type, x : A, y : A, z : A, p : Path(x, y), q : Path(y, z)) -> Path(
  x,
  z
) =
  Path.step p q

/// Reflexivity, by name.
def zero(A : Type, x : A) -> Path(x, x) =
  Path.here x

/// Reflexivity, through `zero`.
def zero2(A : Type, x : A) -> Path(x, x) =
  zero A x

/// A call that runs to reflexivity in two steps, then `p`, is `p`.
def twoStepsThen(A : Type, x : A, y : A, p : Path(x, y)) -> Path[.A = Path[.A = A](x, y)](
  joinedPaths A x x y (zero2 A x) p,
  p
) =
  Path.here p
