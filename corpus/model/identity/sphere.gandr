/// This source states the 2-sphere and the 3-sphere as presentations with one
/// cell each.
///
/// The 2-sphere has a point and a cell at the reflexivity of the point.
/// The 3-sphere has its cell one reflexivity higher.
/// The checker reads the path type at that wrapped point as the words over the
/// cell, and the kernel replays them.
///
/// The lowering mints the cancellation rules of a higher cell as it mints them
/// for a loop.
/// No rule identifies a cell with the empty word.
///
/// Limits: a case over a sphere needs a branch for its cell, and `Path.ap` on
/// the cell needs that case.
///
/// - see: #6395 — the case at a higher cell and `Path.ap` on it
/// - see: corpus/model/identity/circle.gandr

/// The 2-sphere has a point and a 2-cell at the point's reflexivity.
pub data S2 : Type where
  /// The point.
  | Base2 : S2
  /// The 2-cell at the reflexivity of the point.
  | surf : Path.here Base2 <-> Path.here Base2

/// The 3-sphere has a point and a 3-cell at the reflexivity of the point's
/// reflexivity.
pub data S3 : Type where
  /// The point.
  | Base3 : S3
  /// The 3-cell at the reflexivity of the point's reflexivity.
  | surf3 : Path.here (Path.here Base3) <-> Path.here (Path.here Base3)

/// The 2-cell is a path between reflexivities of the point.
def surface : Path[.A = Path[.A = S2](Base2, Base2)](Path.here Base2, Path.here Base2) = surf;

/// The 3-cell is a path between reflexivities of the point's reflexivity.
def volume : Path[.A = Path[.A = Path[.A = S3](Base3, Base3)](Path.here Base3, Path.here Base3)](
  Path.here (Path.here Base3),
  Path.here (Path.here Base3)
) = surf3;

/// The cancellation rule reduces the 2-cell and its inverse to the empty word.
def unsurfaced : Path[.A = Path[.A = Path[.A = S2](Base2, Base2)](
  Path.here Base2,
  Path.here Base2
)](
  surf ∷ back surf ∷ Path.here (Path.here Base2),
  Path.here (Path.here Base2)
) = Path.here (Path.here (Path.here Base2));

/// The inverse and then the 3-cell reduce to the empty word too.
def cancelled3 : Path[.A = Path[.A = Path[.A = Path[.A = S3](Base3, Base3)](
  Path.here Base3,
  Path.here Base3
)](
  Path.here (Path.here Base3),
  Path.here (Path.here Base3)
)](
  back surf3 ∷ surf3 ∷ Path.here (Path.here (Path.here Base3)),
  Path.here (Path.here (Path.here Base3))
) = Path.here (Path.here (Path.here (Path.here Base3)));

/// No rule identifies the 2-cell with the empty word.
@[refuses("EndpointMismatch")]
def surfaceFlat : Path[.A = Path[.A = Path[.A = S2](Base2, Base2)](
  Path.here Base2,
  Path.here Base2
)](
  surf,
  Path.here (Path.here Base2)
) = Path.here (Path.here (Path.here Base2));

/// A case over the 2-sphere waits for a branch at its cell.
@[refuses("OutOfFragment.higher_cell_case")]
def squash(x : S2) -> S2 =
  match x where
    | Base2 => Base2
