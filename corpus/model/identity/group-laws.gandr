//! This source states group laws as rewrite rules.
//! The circle loop obeys the group laws.
//!
//! The written rules can form critical pairs.
//! Completion derives rules that join each pair.
//!
//! The coincidence checker certifies each derived rule.
//! It checks the inverse-of-product row.
//!
//! - see: #338
//! - cites: [Knuth-1970-simple_word_problems_universal_algebras]
//!
//! [Knuth-1970-simple_word_problems_universal_algebras]: https://doi.org/10.1016/B978-0-08-012975-4.50028-X "Knuth and Bendix, Simple Word Problems in Universal Algebras"

/// The `Group` theory states laws for units, association and inverses.
@[ normalizes("inv(mul(a, b)) ~> mul(inv(b), inv(a))") ]
pub theory Group where
  sort G : Type;

  oper e : G;
  oper a : G;
  oper b : G;
  oper inv : (x : G) --> G;
  oper mul : (x : G, y : G) --> G;

  rule unitL : mul (e ()) x <=> x;
  rule unitR : mul x (e ()) <=> x;
  rule assoc : mul (mul x y) z <=> mul x (mul y z);
  rule invInv : inv (inv x) <=> x;
  rule invE : inv (e ()) <=> e ();
  rule invL : mul (inv x) x <=> e ();
