// A group's laws stated as rules, the coincidence check certifying each with
// the others: the structure the circle's loops carry under composition, whose
// laws `circle-group.gandr` proves as paths. The written laws do not join
// among themselves: the cancellation `mul(inv(x), x) ==> e()` meets
// associativity at `mul(mul(inv(x), x), z)`, which the two leave at `z` and
// at `mul(inv(x), mul(x, z))`. Completion orients each such pair into a rule
// that follows from the written ones, certified by the pair's two paths, until
// every pair joins (Knuth and Bendix, _Simple Word Problems in Universal
// Algebras_, 1970, § 7). The row reads a law no written rule states, the
// inverse of a product (#338).

/// A group's unit, associativity and inverse laws, each a rule: `e()` is the
/// unit and `a()`, `b()` two elements the row reads; the row's normal form is
/// one only a derived rule reaches.
@[ normalizes("inv(mul(a, b)) ~> mul(inv(b), inv(a))") ]
pub theory Group {
  sort G : Type;

  oper e : G;
  oper a : G;
  oper b : G;
  oper inv : (x : G) --> G;
  oper mul : (x : G, y : G) --> G;

  rule unitL : mul(e(), x) <=> x;
  rule unitR : mul(x, e()) <=> x;
  rule assoc : mul(mul(x, y), z) <=> mul(x, mul(y, z));
  rule invInv : inv(inv(x)) <=> x;
  rule invE : inv(e()) <=> e();
  rule invL : mul(inv(x), x) <=> e();
}
