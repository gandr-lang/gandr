// `G` after `F` acts on a path as their composite does.
//
// The kernel re-derives what the checker accepts at a reflexivity whose
// endpoint reads through a bind.
//
// Based path induction proves it. At reflexivity both actions reduce to the
// reflexivity at `G(F(x))`. The composite's action reads through its bind to
// the call `G(⟨F(x)⟩)`, which the other side holds. The functions stated as
// lambdas read the same way: composing with `g`, then with `h`, acts on a
// square as composing with both.
//
// - see: #3969 — the kernel's reading of an endpoint through its bind
// - see: `then-units-in-the-kernel.gandr` — reflexivity's units under `then`
// - see: `transport-dependent.gandr` — based path induction

/// A function's action on a path, whose type states its endpoints.
def actOn(A : Type, B : Type, F : A => B, x : A, y : A, p : Path(A, x, y)) -> Path(B, F(x), F(y)) {
  cong(F, p)
}

/// `G` after `F` acts on a path as their composite does.
def apComp(
  A : Type,
  B : Type,
  C : Type,
  F : A => B,
  G : B => C,
  x : A,
  y : A,
  p : Path(A, x, y)
) -> Path(
  Path(C, G(F(x)), G(F(y))),
  actOn(B, C, G, F(x), F(y), actOn(A, B, F, x, y, p)),
  actOn(A, C, (fn (a : A) { G(F(a)) } : A => C), x, y, p)
) {
  transport(
    (v : A, k : Path(A, x, v)) => Path(
      Path(C, G(F(x)), G(F(v))),
      actOn(B, C, G, F(x), F(v), actOn(A, B, F, x, v, k)),
      actOn(A, C, (fn (a : A) { G(F(a)) } : A => C), x, v, k)
    ),
    p,
    here(x),
    here(p),
    here(here(G(F(x))))
  )
}

/// Composing with `g`, then with `h`, acts on `fa` as composing with both.
def apThenThen(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  g : Path(A, y, z),
  h : Path(A, z, w),
  fm : Path(A, x, y),
  fp : Path(A, x, y),
  fa : Path(Path(A, x, y), fm, fp)
) -> Path(
  Path(Path(A, x, w), (fm then g) then h, (fp then g) then h),
  actOn(
    Path(A, x, z),
    Path(A, x, w),
    (fn (r : Path(A, x, z)) { r then h } : Path(A, x, z) => Path(A, x, w)),
    fm then g,
    fp then g,
    actOn(
      Path(A, x, y),
      Path(A, x, z),
      (fn (q : Path(A, x, y)) { q then g } : Path(A, x, y) => Path(A, x, z)),
      fm,
      fp,
      fa
    )
  ),
  actOn(
    Path(A, x, y),
    Path(A, x, w),
    (fn (q : Path(A, x, y)) { (q then g) then h } : Path(A, x, y) => Path(A, x, w)),
    fm,
    fp,
    fa
  )
) {
  transport(
    (kp : Path(A, x, y), e : Path(Path(A, x, y), fm, kp)) => Path(
      Path(Path(A, x, w), (fm then g) then h, (kp then g) then h),
      actOn(
        Path(A, x, z),
        Path(A, x, w),
        (fn (r : Path(A, x, z)) { r then h } : Path(A, x, z) => Path(A, x, w)),
        fm then g,
        kp then g,
        actOn(
          Path(A, x, y),
          Path(A, x, z),
          (fn (q : Path(A, x, y)) { q then g } : Path(A, x, y) => Path(A, x, z)),
          fm,
          kp,
          e
        )
      ),
      actOn(
        Path(A, x, y),
        Path(A, x, w),
        (fn (q : Path(A, x, y)) { (q then g) then h } : Path(A, x, y) => Path(A, x, w)),
        fm,
        kp,
        e
      )
    ),
    fa,
    here(fm),
    here(fa),
    here(here((fm then g) then h))
  )
}
