// Representation independence of two structures with operations: the toggles
// of Sterling, Gratzer and Birkedal's counters (_Towards univalent reference
// types_, § 5, `posCounter ≡ negCounter`), related along negation. Each
// operation is carried along the carrier's path, its argument moved back by
// the equivalence's backward map and its result forward by its forward map,
// and the carried operation is related to the other structure's by `funext`.
// A reading carried between two different carriers, booleans tagged with
// unit and the booleans, is related the same way.

// Negation, `not`, and the identity, `same`, on the booleans.
import "./funext.gandr";
// The booleans' path to themselves by negation, `negation`.
import "./transport-list.gandr";

/// A toggle that starts false and reads its state as it is.
pub def plainToggle : #{t : Type, start : t, step : t => t, read : t => Bool} = (
  Bool,
  (+{.0 = unit}, (not, same))
);

/// A toggle that starts true and reads its state negated.
pub def flippedToggle : #{t : Type, start : t, step : t => t, read : t => Bool} = (
  Bool,
  (+{.1 = unit}, (not, not))
);

/// The step carried along negation is the step: negating back, stepping and
/// negating again steps.
pub def stepped : Path(Bool => Bool, transport(\t. t => t, negation, not), not) = funext(
  transport(\t. t => t, negation, not),
  not
);

/// The reading carried along negation reads negated.
pub def reread : Path(Bool => Bool, transport(\t. t => Bool, negation, same), not) = funext(
  transport(\t. t => Bool, negation, same),
  not
);

/// The two toggles are one: the carriers by negation, the start carried to
/// `true`, and each operation carried to the other's.
def oneToggle : Path(
  #{t : Type, start : t, step : t => t, read : t => Bool},
  plainToggle,
  flippedToggle
) = (negation, (here(+{.1 = unit}), (stepped, reread)));

/// The reading carried along negation is not the reading left as it is.
@[ refuses("PointwiseDistinct") ]
def unread : Path(Bool => Bool, transport(\t. t => Bool, negation, same), same) = funext(
  transport(\t. t => Bool, negation, same),
  same
);

/// The boolean a tagged boolean carries.
def untag(p : Bool * Unit) -> Bool {
  case p { (x, u) => x }
}

/// A boolean tagged with unit.
def tag(b : Bool) -> Bool * Unit {
  (b, unit)
}

/// The tagged booleans to the booleans: the tag dropped, and added back.
def tagging : Path(Type, Bool * Unit, Bool) = equiv(untag, tag);

/// The reading of a tagged boolean, its first component.
def readTagged(p : Bool * Unit) -> Bool {
  case p { (x, u) => x }
}

/// #1747: the reading carried along `tagging` reads the boolean itself. Its
/// argument moves back by `tag`, and the reading takes both components of the
/// pair that returns; the kernel ran `tag` once per component where the
/// checker ran it once, and refused the pointwise evidence.
def untagged : Path(Bool => Bool, transport(\t. t => Bool, tagging, readTagged), same) = funext(
  transport(\t. t => Bool, tagging, readTagged),
  same
);
