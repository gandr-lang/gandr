//! A flow between list types by a translator that recurses into the tail, after
//! directed univalence
//! [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory],
//! Definition 1.2: at one cell the image binds the translator's own image of
//! the rigid tail, and the cell it returns over that image and the head's
//! leaves is natural, so the translator is natural at every list.
//!
//! - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
//!
//! [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

// The native finite lists.
import std.list (List);

/// A list of records migrated by riding each cell along the records' flow.
module Cells where {
  type Old = String * Integer;
  type New = Integer * String;
  /// The records' translator: the fields swapped.
  @[ checks ]
  def swap(old : Old) -> New =
    match old
      | *{name, age} => *{age, name}
  /// The flow between the records, by their translator.
  @[ checks ]
  def renamed : Flow[.A = Type](Old, New) = Flow.into swap;
  /// The lists' translator: the list ridden along the records' flow.
  @[ checks ]
  def each(olds : List(Old)) -> List(New) =
    Flow.ride (fun (X) { List X }) renamed olds
  /// At one cell the image is the swapped head before the translator's own
  /// image of the tail, so the lists' flow forwards by it.
  @[ checks ]
  def everyone : Flow[.A = Type](List(Old), List(New)) = Flow.into each;
  /// A list ridden along the lists' flow.
  @[ checks ]
  def moved(olds : List(Old)) -> List(New) =
    Flow.ride (fun (X) { X }) everyone olds
  /// Two records migrated by a run.
  @[ runs("cons *{36, \"ada\"} (cons *{41, \"alan\"} nil)") ]
  def two : () -> List(New) = moved (cons (*{"ada", 36}) (cons (*{"alan", 41}) nil));
}
