/// This source states manifest sorts in counter and pairing models.
///
/// A manifest sort fixes a carrier while a model remains usable as its theory.
/// Two models can share a manifest carrier.
///
/// The checker inserts each forgetting map when a caller requests a general model.
/// A model binder exposes each operation for its resolved carrier.
///
/// - see: #2120
/// - see: #2132
/// - see: #2131
/// - see: #2158
/// - see: #2246 — `stepOwn`, `stepZero`, `stepManifest`
/// - see: #2130

// This import supplies the counter, its three counts, negation and `observe`.
import "./model-counter.gandr";

/// The `upManifest` record fixes the counter carrier and holds its operations.
pub def upManifest : Model(Counter) with sort C = Unit + (Unit + Unit) = *{
  .zero = Up.zero,
  .incr = Up.incr,
  .read = Up.read
};

/// The checker forgets the manifest carrier when `observe` requests a counter.
@[ runs("1") ]
def observedManifest() -> Integer { observe upManifest }

/// An ascription makes the checker forget the manifest carrier.
@[ runs("1") ]
def observedAscribed() -> Integer { observe (upManifest : Model(Counter)) }

/// The manifest counter follows negation.
pub def negatedManifest : Model(Counter) with sort C = Unit + (Unit + Unit) = Path.walk (fun (x) {
  type(Model(Counter) with sort C = x)
}) countsNegated upManifest;

/// After negation, the forgetting map reads the same count.
@[ runs("1") ]
def observedCarried() -> Integer { observe negatedManifest }

/// The `ReadCounter` theory gives counter readings their own sort.
pub theory ReadCounter where
  sort C : Type;
  sort R : Type;
  oper zero : C;
  oper incr : (c : C) --> C;
  oper read : (c : C) --> R;
  oper shown : (r : R) --> Integer;

/// The `observeShown` consumer reads and shows one stepped counter value.
pub def observeShown(m : Model(ReadCounter)) -> Integer =
  match m where
    | *{.zero = z, .incr = i, .read = r, .shown = s} => s (r (i z))

/// The `asIs` reader returns its integer unchanged.
def asIs(r : Integer) -> Integer { r }

/// The `upReadings` record fixes the reading sort and leaves the count sort as a field.
pub def upReadings : Model(ReadCounter) with sort R = Integer = *{
  type(Unit + (Unit + Unit)),
  *{Up.zero, *{Up.incr, *{Up.read, asIs}}}
};

/// The checker forgets manifest readings when `observeShown` requests a `ReadCounter`.
@[ runs("1") ]
def observedReadings() -> Integer { observeShown upReadings }

/// The `upBoth` record fixes both sorts.
pub def upBoth : Model(ReadCounter) with sort C = Unit + (Unit + Unit) with sort R = Integer = *{
  .zero = Up.zero,
  .incr = Up.incr,
  .read = Up.read,
  .shown = asIs
};

/// The checker uses a different map when it forgets both fixed sorts.
@[ runs("1") ]
def observedBoth() -> Integer { observeShown upBoth }

/// The counter uses its fixed reading sort through count negation.
def negatedBoth : Model(ReadCounter) with sort C = Unit + (Unit + Unit) with sort R = Integer = Path.walk
  (fun (x) {
    type(Model(ReadCounter) with sort C = x with sort R = Integer)
  })
  countsNegated
  upBoth;

/// The forgetting map reads the carried counter as an up counter.
@[ runs("1") ]
def observedNegatedBoth() -> Integer { observeShown negatedBoth }

/// The `stepShared` function steps and reads a value through a counter that shares its carrier.
def stepShared(a : Model(Counter), b : Model(Counter) with sort C = a.C, c : a.C) -> Integer =
  match b where
    | *{.zero = z, .incr = i, .read = r} => r (i c)

/// The manifest counter shares the up counter's carrier.
@[ runs("1") ]
def sharedUp() -> Integer { stepShared upModel upManifest Up.zero }

/// The checker resolves the shared carrier from `a` when `observeShared` requests a counter.
pub def observeShared(a : Model(Counter), b : Model(Counter) with sort C = a.C) -> Integer =
  observe b

/// The checker resolves `upManifest`'s carrier from the up counter.
@[ runs("1") ]
def observedSharedUp() -> Integer { observeShared upModel upManifest }

/// The `stepOwn` function reads a stepped value through operations of `a`.
def stepOwn(a : Model(Counter), c : a.C) -> Integer =
  let i = a.incr
  let r = a.read
  r (i c)

/// The up counter runs `stepOwn` from its zero.
@[ runs("1") ]
def ownUp() -> Integer { stepOwn upModel Up.zero }

/// The `stepZero` function reads a counter after one step from zero.
def stepZero(a : Model(Counter)) -> Integer =
  let z = a.zero
  let i = a.incr
  let r = a.read
  r (i z)

/// The selection path carries `stepZero` between the two counter models.
def selectedAlike() -> Path(stepZero upModel, stepZero downModel) =
  Path.ap stepZero oneCounter

/// The `stepManifest` function reads a manifest counter after one step from zero.
def stepManifest(a : Model(Counter) with sort C = Unit + (Unit + Unit)) -> Integer =
  let z = a.zero
  let i = a.incr
  let r = a.read
  r (i z)

/// The manifest up counter runs one step from zero.
@[ runs("1") ]
def manifestUp() -> Integer { stepManifest upManifest }

/// A count at the integer carrier has the type `Integer`.
def countOfIntegers(a : Model(Counter) with sort C = Integer, c : a.C) -> Integer { c }

/// A count at a bound carrier has the type of that carrier.
def countOfAny(x : Type, a : Model(Counter) with sort C = x, n : Integer, c : a.C) -> x =
  c

/// The `Pairing` theory has two carriers and a value at each carrier.
pub theory Pairing where
  sort A : Type;
  sort B : Type;
  oper left : A;
  oper right : B;

/// The `firstManifest` record fixes the first carrier and leaves the second as a field.
def firstManifest : Model(Pairing) with sort A = Integer = *{type(Unit), *{1, *{}}};

/// The `bothManifest` record fixes both carriers.
def bothManifest : Model(Pairing) with sort A = Integer with sort B = Unit = *{
  .left = 1,
  .right = *{}
};

/// The `leftBeside` function reads a first value beside a second-carrier value.
pub def leftBeside(m : Model(Pairing) with sort A = Integer, b : m.B) -> Integer =
  match m where
    | *{.left = l, .right = r} => l

/// The `leftOfOne` run pairs one with the unit value.
@[ runs("1") ]
def leftOfOne() -> Integer { leftBeside firstManifest (*{}) }

/// The `rightBeside` function reads a shared second-carrier value.
def rightBeside(
  m : Model(Pairing) with sort A = Integer,
  n : Model(Pairing) with sort A = Integer with sort B = m.B
) -> Integer =
  match n where
    | *{.left = l, .right = r} => leftBeside m r

/// The two manifest pairings share the unit second carrier.
@[ runs("1") ]
def rightOfOne() -> Integer { rightBeside firstManifest bothManifest }
