// A model whose sorts are manifest where a model of its theory is asked
// (#2120): a model type fixing sorts of a theory takes one forgetting map
// from `Model(T) with sort C = x` to `Model(T)`, at every carrier `x`, which
// puts each fixed sort back as the field it is in the theory's record. The
// checker applies it where the one model stands at the other, solving `x`
// from the model's type, and the run reads the application. The map is a
// family in the carrier, so a manifest model carried along an equivalence of
// carriers is read alike once forgotten. A model fixing some of its theory's
// sorts takes the map putting back those alone, every other sort staying the
// field it is (#2132). A model type may fix a sort to another model's carrier,
// `with sort C = a.C`, the two then sharing it (#2131), and so may one fixing
// another of its sorts, reading a sort the other leaves a field (#2158). An
// operation is read off a model's binder as a sort is, `a.incr` the step
// `a`'s record holds at `a`'s carrier, whether the carrier is a field or
// manifest (#2246). An ascription `(m : Model(Counter))` states the crossing,
// and the explicit twin writes the map out (#2130).

// The counter, counting up and down modulo three, the negation between the
// counts, and `observe`, which reads any counter.
import "./model-counter.gandr" ;

/// Counting up modulo three, its carrier manifest: the carrier is no field,
/// so the record is the zero, the step and the reading.
@[ checks ]
def upManifest : Model(Counter) with sort C = Unit + (Unit + Unit) = #{
  .zero = Up.zero,
  .incr = Up.incr,
  .read = Up.read
} ;

/// The manifest counter where a counter is asked: the checker applies the
/// forgetting map at the counts.
@[ runs("1") ]
def observedManifest() -> Integer { observe(upManifest) }

/// The manifest counter stated at the counter's models: the ascription is
/// the crossing, and the checker applies the map at it.
@[ runs("1") ]
def observedAscribed() -> Integer { observe((upManifest : Model(Counter))) }

/// The manifest counter carried along negation.
@[ checks ]
def negatedManifest : Model(Counter) with sort C = Unit + (Unit + Unit) = transport(
  \x. Model(Counter) with sort C = x,
  countsNegated,
  upManifest
) ;

/// The carried counter where a counter is asked: forgetting at the far end
/// reads it as counting up reads.
@[ runs("1") ]
def observedCarried() -> Integer { observe(negatedManifest) }

/// A counter whose reading has a sort of its own: the counts and the
/// readings, a zero, a step, a reading and the reading shown as an integer.
@[ checks ]
theory ReadCounter {
  sort C : Type;
  sort R : Type;
  oper zero : C;
  oper incr : (c : C) --> C;
  oper read : (c : C) --> R;
  oper shown : (r : R) --> Integer;
}

/// A consumer of any such counter: the reading after one step from zero,
/// shown.
@[ checks ]
def observeShown(m : Model(ReadCounter)) -> Integer {
  case m {
    #{.zero = z, .incr = i, .read = r, .shown = s} => s(r(i(z)))
  }
}

/// An integer reading shown as it is.
@[ checks ]
def asIs(r : Integer) -> Integer { r }

/// Counting up modulo three, its readings manifest at the integers and its
/// counts a field: the record is the counts' type, the zero, the step, the
/// reading and the showing.
@[ checks ]
def upReadings : Model(ReadCounter) with sort R = Integer = (
  type(Unit + (Unit + Unit)),
  (Up.zero, (Up.incr, (Up.read, asIs)))
) ;

/// The counter with its readings manifest where any such counter is asked:
/// the checker applies the map putting back the readings alone.
@[ runs("1") ]
def observedReadings() -> Integer { observeShown(upReadings) }

/// Counting up modulo three, both its sorts manifest: neither is a field.
@[ checks ]
def upBoth : Model(ReadCounter) with sort C = Unit + (Unit + Unit) with sort R = Integer = #{
  .zero = Up.zero,
  .incr = Up.incr,
  .read = Up.read,
  .shown = asIs
} ;

/// The counter with both sorts manifest where any such counter is asked: the
/// map putting back both is another than the one putting back the readings.
@[ runs("1") ]
def observedBoth() -> Integer { observeShown(upBoth) }

/// The counter with both sorts manifest carried along negation of its
/// counts, its readings fixed as they are.
@[ checks ]
def negatedBoth : Model(ReadCounter) with sort C = Unit + (Unit + Unit) with sort R = Integer = transport(
  \x. Model(ReadCounter) with sort C = x with sort R = Integer,
  countsNegated,
  upBoth
) ;

/// The carried counter where any such counter is asked: the map is a family
/// in the counts, so forgetting at the far end reads it as counting up reads.
@[ runs("1") ]
def observedNegatedBoth() -> Integer { observeShown(negatedBoth) }

/// A count of one counter stepped and read by a second sharing its counts:
/// `b`'s carrier is `a`'s, so a count of `a` is one `b` takes.
@[ checks ]
def stepShared(a : Model(Counter), b : Model(Counter) with sort C = a.C, c : a.C) -> Integer {
  case b {
    #{.zero = z, .incr = i, .read = r} => r(i(c))
  }
}

/// Counting up and its manifest twin share their counts: counting up's
/// zero, stepped and read by the twin.
@[ runs("1") ]
def sharedUp() -> Integer { stepShared(upModel, upManifest, Up.zero) }

/// The counter sharing `a`'s counts where any counter is asked: the checker
/// solves the carrier as `a`'s.
@[ checks ]
def observeShared(a : Model(Counter), b : Model(Counter) with sort C = a.C) -> Integer {
  observe(b)
}

/// The twin read as any counter, its carrier solved as counting up's.
@[ runs("1") ]
def observedSharedUp() -> Integer { observeShared(upModel, upManifest) }

/// A count of a counter stepped and read by the counter's own operations,
/// read off its binder: `a.incr` steps a count of `a` (#2246).
@[ checks ]
def stepOwn(a : Model(Counter), c : a.C) -> Integer {
  run i <- a.incr ;
  run r <- a.read ;
  r(i(c))
}

/// Counting up's zero, stepped and read by counting up's own operations.
@[ runs("1") ]
def ownUp() -> Integer { stepOwn(upModel, Up.zero) }

/// A counter stepped once from its zero and read, by the operations read off
/// its binder (#2246).
@[ checks ]
def stepZero(a : Model(Counter)) -> Integer {
  run z <- a.zero ;
  run i <- a.incr ;
  run r <- a.read ;
  r(i(z))
}

/// Counting up and counting down read alike through the operations each
/// selects, along the path between the models: a selection is a function of
/// the model, so `cong` carries the path to the readings.
@[ checks ]
def selectedAlike() -> Path(Integer, stepZero(upModel), stepZero(downModel)) {
  cong(stepZero, oneCounter)
}

/// A manifest counter's zero, stepped and read by its own operations: its
/// carrier is no field, so the record is keyed by the operations, and
/// `a.zero` is the zero it holds (#2246).
@[ checks ]
def stepManifest(a : Model(Counter) with sort C = Unit + (Unit + Unit)) -> Integer {
  run z <- a.zero ;
  run i <- a.incr ;
  run r <- a.read ;
  r(i(z))
}

/// Counting up, its carrier manifest, stepped once from its zero by its own
/// operations.
@[ runs("1") ]
def manifestUp() -> Integer { stepManifest(upManifest) }

/// A count of a counter whose counts are manifest at the integers is an
/// integer: the carrier its type fixes is the type it names.
@[ checks ]
def countOfIntegers(a : Model(Counter) with sort C = Integer, c : a.C) -> Integer { c }

/// A count of a counter whose counts are manifest at a type bound before it,
/// past a binder between, is a value of that type.
@[ checks ]
def countOfAny(x : Type, a : Model(Counter) with sort C = x, n : Integer, c : a.C) -> x {
  c
}

/// A pairing: two carriers, a value of each.
@[ checks ]
theory Pairing {
  sort A : Type;
  sort B : Type;
  oper left : A;
  oper right : B;
}

/// One and the unit, paired, the first carrier manifest at the integers:
/// the second is a field, so the record is its type, the left and the
/// right.
@[ checks ]
def firstManifest : Model(Pairing) with sort A = Integer = (type(Unit), (1, unit)) ;

/// One and the unit, paired, both carriers manifest: neither is a field.
@[ checks ]
def bothManifest : Model(Pairing) with sort A = Integer with sort B = Unit = #{
  .left = 1,
  .right = unit
} ;

/// A pairing's left beside a value of its second carrier, read off it where
/// its type fixes the first.
@[ checks ]
def leftBeside(m : Model(Pairing) with sort A = Integer, b : m.B) -> Integer {
  case m {
    #{.left = l, .right = r} => l
  }
}

/// The pairing of one and the unit beside the unit, its second carrier.
@[ runs("1") ]
def leftOfOne() -> Integer { leftBeside(firstManifest, unit) }

/// A pairing sharing another's second carrier: its right is a value of it.
@[ checks ]
def rightBeside(
  m : Model(Pairing) with sort A = Integer,
  n : Model(Pairing) with sort A = Integer with sort B = m.B
) -> Integer {
  case n {
    #{.left = l, .right = r} => leftBeside(m, r)
  }
}

/// The pairing with both carriers manifest shares the first manifest one's
/// second carrier, the unit.
@[ runs("1") ]
def rightOfOne() -> Integer { rightBeside(firstManifest, bothManifest) }
