/// A composite over a path typed at a stated lambda meets the composite at the
/// lambda's reduct.
///
/// `along`'s type writes `F(x)`, so `along` at a stated lambda has the lambda
/// applied at its endpoints. A composite over that path starts at the
/// application. Passed to `composeHere`, whose type writes `Path.step(p, q)`, its
/// start meets the reduct `F(x)` or the application written again. A lambda
/// whose body composes, `fun (q) { Path.step(q, g) }`, meets a composite written apart.
///
/// The conversion's code walk reads a call of a stated lambda as the lambda's
/// body, its binder bound to the call's argument. Two composites written apart
/// meet part by part. The kernel replays each declaration by its own reading.
///
/// - see: #4073 — the checker refused a stated lambda applied against its reduct
/// - see: #4065 — a call passed to a parameter, read as the value it returns
/// - see: #3920 — one stated lambda written twice

/// The action of `F` on `p`.
def along(A : Type, F : A -> A, x : A, y : A, p : Path(x, y)) -> Path[.A = A](F(x), F(y)) =
  Path.ap(F, p)

/// Reflexivity at the composite of its two parameters.
def composeHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  p : Path[.A = A](x, y),
  q : Path(y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step(p, q), Path.step(p, q)) =
  Path.here(Path.step(p, q))

/// The composite over `along` at a stated lambda, written in the body.
def composedAtLambda(
  A : Type,
  F : A -> A,
  x : A,
  y : A,
  z : A,
  r : Path(x, y),
  s : Path(F(y), z)
) -> Path[.A = Path[.A = A](F(x), z)](
  Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s),
  Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s)
) =
  Path.here(Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s))

/// The same composite through `composeHere`, its start the reduct.
def passedAtLambda(
  A : Type,
  F : A -> A,
  x : A,
  y : A,
  z : A,
  r : Path(x, y),
  s : Path(F(y), z)
) -> Path[.A = Path[.A = A](F(x), z)](
  Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s),
  Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s)
) =
  composeHere(A, F(x), F(y), z, along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s)

/// The same, its start the application written again.
def passedRedex(
  A : Type,
  F : A -> A,
  x : A,
  y : A,
  z : A,
  r : Path(x, y),
  s : Path(F(y), z)
) -> Path[.A = Path[.A = A](F(x), z)](
  Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s),
  Path.step(along(A, (fun (q : A) { F(q) } : A -> A), x, y, r), s)
) =
  composeHere(
    A,
    (fun (q : A) { F(q) } : A -> A)(x),
    F(y),
    z,
    along(A, (fun (q : A) { F(q) } : A -> A), x, y, r),
    s
  )

/// The action of `F` on `p`, across two carriers.
def acrossCarriers(A : Type, B : Type, F : A -> B, x : A, y : A, p : Path(x, y)) -> Path[.A = B](
  F(x),
  F(y)
) =
  Path.ap(F, p)

/// The composite over a lambda that composes, written in the body.
def composedAcross(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path(y, z),
  k : Path(x, z),
  s : Path[.A = Path[.A = A](x, z)](Path.step(fp, g), k)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step(fm, g), k)](
  Path.step(acrossCarriers(
    Path(x, y),
    Path(x, z),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path(x, y) -> Path(x, z)),
    fm,
    fp,
    fa
  ), s),
  Path.step(acrossCarriers(
    Path(x, y),
    Path(x, z),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path(x, y) -> Path(x, z)),
    fm,
    fp,
    fa
  ), s)
) =
  Path.here(Path.step(acrossCarriers(
    Path(x, y),
    type(Path[.A = A](x, z)),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path(x, y) -> Path(x, z)),
    fm,
    fp,
    fa
  ), s))

/// The same through `composeHere`, its start the composite written apart.
def passedComposite(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path(y, z),
  k : Path(x, z),
  s : Path[.A = Path[.A = A](x, z)](Path.step(fp, g), k)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step(fm, g), k)](
  Path.step(acrossCarriers(
    Path(x, y),
    Path(x, z),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path(x, y) -> Path(x, z)),
    fm,
    fp,
    fa
  ), s),
  Path.step(acrossCarriers(
    Path(x, y),
    Path(x, z),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path(x, y) -> Path(x, z)),
    fm,
    fp,
    fa
  ), s)
) =
  composeHere(
    type(Path[.A = A](x, z)),
    Path.step(fm, g),
    Path.step(fp, g),
    k,
    acrossCarriers(
      Path(x, y),
      type(Path[.A = A](x, z)),
      (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path(x, y) -> Path(x, z)),
      fm,
      fp,
      fa
    ),
    s
  )
