//! Transport of a function along `ua`: the cubical case table of Cohen,
//! Coquand, Huber and Mörtberg, _Cubical Type Theory: a constructive
//! interpretation of the univalence axiom_
//! [Cohen-2015-cubical_type_theory_a_constructive_interpretation_of_the_univalence_axiom],
//! § 4.5, read at a function type. The argument moves back along the path by
//! the record's left inverse, the function applies, and the result moves
//! forward by the record's map.
//!
//! - cites: [Cohen-2015-cubical_type_theory_a_constructive_interpretation_of_the_univalence_axiom]
//!
//! [Cohen-2015-cubical_type_theory_a_constructive_interpretation_of_the_univalence_axiom]: https://arxiv.org/abs/1611.02108 "Cohen, Coquand, Huber and Mörtberg, Cubical Type Theory: a constructive interpretation of the univalence axiom"

// The circle, the presented integers, the winding number and spinning.
import "./circle-base.gandr";
// The loops at the point as the integers, `loopsAreIntegers`.
import "./univalence.gandr";

/// A function on the loops at the point, carried along `ua(winding)`, is the
/// function on the integers that spins its argument back to a loop, applies
/// `f` and winds the result, by conversion.
def funBeta(f : Path[.A = Circle](Base, Base) -> Path[.A = Circle](
  Base,
  Base
)) -> Path[.A = Int -> Int](
  Path.walk (fun (X) { X -> X }) loopsAreIntegers f,
  fun (n) { wind (f (spin n)) }
) =
  Path.here (fun (n) { wind (f (spin n)) })

/// Adding a loop, carried along `loopsAreIntegers`, adds one: the integer
/// spins back to its word, gains a loop and winds to its successor, by a run.
@[ runs("S(S(S(Z)))") ]
def funRun() -> Int =
  let g = Path.walk (fun (X) { X -> X }) loopsAreIntegers (fun (l) { loopOn l })
  g (S (S Z))
