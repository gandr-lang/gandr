/// This source folds state-only programs with an explicit state parameter.
///
/// The `put-put` rule removes a store overwritten by the next store.
/// `final` passes the latest state through the program.
///
/// The fold handles state effects at each constructor.
/// Both sides of the rule end at the same final state.
///
/// - see: #2510
/// - cites: [Plotkin-2002-notions_computation_determine_monads]
///
/// [Plotkin-2002-notions_computation_determine_monads]: https://doi.org/10.1007/3-540-45931-6_24 "Plotkin and Power, Notions of computation determine monads"

/// The `Stores` type keeps only the final store in a sequence.
pub data Stores : Type where {
  | End : (x : Integer) --> Stores
  | Store : (s : Integer, k : Stores) --> Stores
  rule : Store s (Store u k) <=> Store u k;
}

/// The `final` function returns the state from the final store.
def rec final(p : Stores, s : Integer) -> Integer =
  match p where
    | End(_x) => s
    | Store(t, k) => final[<] k t

/// Three stores leave the last stored value.
@[ runs("3") ]
def finalOfThree : () -> Integer = final (Store 1 (Store 2 (Store 3 (End 0)))) 0;
