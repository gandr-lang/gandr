// The forgetting map the checker applies, written out (#2130). In the
// explicit form, a model whose sorts are manifest standing where its theory's
// model is asked is written as the map's call, `forget[sort C = A](m) at
// Model(Counter)`, naming each sort the map puts back with its carrier as the
// manifest type names it; the sugared form leaves the call to the checker, or
// states the crossing by an ascription, `(m : Model(Counter))`. The run reads
// the same application in every form.

// The counter, counting up and down modulo three, and `observe`, which reads
// any counter.
import "./model-counter.gandr" ;
// The manifest counters, the counter whose readings have a sort of their own,
// and its reader.
import "./model-counter-manifest.gandr" ;

/// The manifest counter where a counter is asked, the map written out.
@[ runs("1"), form(explicit) ]
def observedManifestWritten() -> -F Integer {
  become observe(forget[sort C = +{Unit, +{Unit, Unit}}](upManifest) at Model(Counter))
}

/// The counter carried along negation, the map written at the far end.
@[ runs("1"), form(explicit) ]
def observedCarriedWritten() -> -F Integer {
  become observe(forget[sort C = +{Unit, +{Unit, Unit}}](negatedManifest) at Model(Counter))
}

/// The counter with its readings manifest, the map putting back the readings
/// alone written out.
@[ runs("1"), form(explicit) ]
def observedReadingsWritten() -> -F Integer {
  become observeShown(forget[sort R = Integer](upReadings) at Model(ReadCounter))
}

/// Both sorts manifest, written in another order than the theory states
/// them: the map is the one putting back both.
@[ runs("1"), form(explicit) ]
def observedBothWritten() -> -F Integer {
  become observeShown(forget[
    sort R = Integer,
    sort C = +{Unit, +{Unit, Unit}}
  ](upBoth) at Model(ReadCounter))
}

/// The counter sharing `a`'s counts where any counter is asked, the map
/// written at `a`'s carrier.
@[ checks, form(explicit) ]
def observeSharedWritten(a : Model(Counter), b : Model(Counter) with sort C = a.C) -> -F Integer {
  become observe(forget[sort C = a.C](b) at Model(Counter))
}

/// The twin read through the written map at counting up's carrier.
@[ runs("1"), form(explicit) ]
def observedSharedUpWritten() -> -F Integer { become observeSharedWritten(upModel, upManifest) }
