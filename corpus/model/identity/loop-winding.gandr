/// This source maps loop words to presented and native integers.
///
/// The presented fold respects word rules by conversion.
/// The native fold uses the native model obligations.
///
/// The folds map closed loop words.
/// The checker reads each fold through its selected model.
///
/// - see: corpus/model/identity/loop-shape.gandr

// The presented integers.
import "./circle-base.gandr";
// The loop's words.
import "./loop-words.gandr";
// The circle's shape and its two models.
import "./loop-shape.gandr";

/// The `windWords` function maps a loop word to a presented integer.
pub def rec windWords(c : Words) -> Int =
  match c
    | Nil => Z
    | Loop(x) => S (windWords[<] x)
    | Unloop(x) => P (windWords[<] x)

/// Two loops map to two successors.
@[ runs("S (S Z)") ]
def twice_wound() -> Int { windWords (Loop (Loop Nil)) }

/// The run keeps the cancelled word before conversion normalises it.
@[ runs("S (P Z)") ]
def wound_letterwise() -> Int { windWords (Loop (Unloop Nil)) }

/// Conversion maps two loops to two successors.
def wound_twice : Path[.A = Int](windWords (Loop (Loop Nil)), S (S Z)) = Path.here (S (S Z));

/// Conversion maps a cancelled word to zero.
def wound_never : Path[.A = Int](windWords (Loop (Unloop Nil)), Z) = Path.here Z;

/// The `native_wind` function maps words through the native model.
@[ respects(*{NativeWinding.turnUnturn, NativeWinding.unturnTurn}), owes(2) ]
def rec native_wind(c : Words) -> Integer =
  match c
    | Nil => 0
    | Loop(x) => NativeWinding.turn (native_wind[<] x)
    | Unloop(x) => NativeWinding.unturn (native_wind[<] x)

/// Two loops map to two native integer units.
@[ runs("2") ]
def native_twice() -> Integer { native_wind (Loop (Loop Nil)) }

/// A cancelled word maps to native zero.
@[ runs("0") ]
def native_unwound() -> Integer { native_wind (Loop (Unloop Nil)) }
