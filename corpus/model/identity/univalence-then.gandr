//! This source transports a value along a composite ending in `ua`.
//!
//! The first path transports the value before the record map applies.
//! An open first path remains as the value that it represents.
//!
//! The checker expands each component of the composite transport.
//! The runtime evaluates the named round trip.
//!
//! - cites: [Cohen-2015-cubical_type_theory_a_constructive_interpretation_of_the_univalence_axiom]
//!
//! [Cohen-2015-cubical_type_theory_a_constructive_interpretation_of_the_univalence_axiom]: https://arxiv.org/abs/1611.02108 "Cohen, Coquand, Huber and Mörtberg, Cubical Type Theory: a constructive interpretation of the univalence axiom"

// This import supplies the circle, integers, winding and spin.
import "./circle-base.gandr";
// Transport forward along a path between types.
import "./univalence.gandr";

/// The composite transport applies the first path and the record map.
def thenBeta(
  a : Type,
  b : Type,
  c : Type,
  p : Path[.A = Type](a, b),
  e : b ≃ c,
  x : a
) -> Path[.A = c](
  fwdAlong a c (Path.step p (ua e)) x,
  fwdAlong b c (ua e) (fwdAlong a b p x)
) =
  Path.here (fwdAlong b c (ua e) (fwdAlong a b p x))

/// The `loopsRound` function is a round trip between loop paths and integers.
def loopsRound(
  p : Path[.A = Type](Path[.A = Circle](Base, Base), Int),
  x : Path[.A = Circle](Base, Base)
) -> Path[.A = Circle](Base, Base) =
  Path.walk (fun (X) { X }) (Path.step p (Path.back p)) x

/// A run returns the original loop after the round trip.
@[ runs("loop ∷ Path.here Base") ]
def roundRun : () -> Path[.A = Circle](Base, Base) = loopsRound loopsAreIntegers loop;

/// The `loopsAndBack` path names the loop round trip.
def loopsAndBack : Path[.A = Type](
  Path[.A = Circle](Base, Base),
  Path[.A = Circle](Base, Base)
) = Path.step loopsAreIntegers (Path.back loopsAreIntegers);

/// A run returns the loop through the named round trip.
@[ runs("loop ∷ Path.here Base") ]
def namedRoundRun() -> Path[.A = Circle](Base, Base) =
  Path.walk (fun (X) { X }) loopsAndBack loop
