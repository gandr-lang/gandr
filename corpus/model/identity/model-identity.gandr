//! This source states representation independence for theory models.
//! It gives two models of `Toggle`.
//!
//! A path between the structures gives a path between the models.
//! The pathological twin refuses a model whose start remains in place.
//!
//! The checker transports each carrier and operation along negation.
//! It checks the model path after transport.
//!
//! - see: corpus/model/identity/structure-operations.gandr
//! - see: corpus/model/identity/transport-list.gandr
//! - see: corpus/model/identity/funext.gandr

/// The `Toggle` theory has a carrier, a start, a step and a reading.
theory Toggle where
  sort T : Type;
  oper start : T;
  oper step : (t : T) --> T;
  oper read : (t : T) --> Bool;

/// The plain model starts false and reads its state.
def plainModel : Model(Toggle) = plainToggle;

/// The flipped model starts true and reads the negation of its state.
def flippedModel : Model(Toggle) = flippedToggle;

/// The model path carries each carrier and operation along negation.
def oneModel : Path(plainModel, flippedModel) = *{
  negation,
  *{Path.here (+{.1 = *{}}), *{stepped, reread}}
};

/// The `startUnmoved` path keeps the start at false.
/// Negation maps that start to true.
@[ refuses("EndpointMismatch") ]
def startUnmoved : Path(plainModel, flippedModel) = *{
  negation,
  *{Path.here (+{.0 = *{}}), *{stepped, reread}}
};
