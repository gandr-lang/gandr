/// This source states a record-schema flow from a translator.
///
/// The translator swaps two fields and adds a flag.
/// A list family applies that migration to every record.
///
/// The flow rides one record or a list of records to the new schema.
/// The checker evaluates both sample migrations.
///
/// - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
///
/// [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

// The native finite lists.
import std.list (List);

/// The `Schema` module gives two record layouts and their translator.
pub module Schema where {
  type Old = String * Integer;
  type New = Integer * String * (Unit + Unit);
  /// The translator swaps fields and adds a flag.
  @[ checks ]
  def toNew(old : Old) -> New =
    match old
      | *{name, age} => *{age, name, +{.0 = *{}}}
  /// The translator defines the schema flow.
  @[ checks ]
  def upgrade : Flow[.A = Type](Old, New) = Flow.into toNew;
  /// The `moved` function rides one record through the schema flow.
  @[ checks ]
  def moved(old : Old) -> New =
    Flow.ride (fun (X) { X }) upgrade old
  /// The `everyone` function rides a record list through the list family.
  @[ checks ]
  def everyone(olds : List(Old)) -> List(New) =
    Flow.ride (fun (X) { List X }) upgrade olds
  /// The run migrates one old record.
  @[ runs("*{30, \"ada\", +{.0 = *{}}}") ]
  def one : () -> New = moved (*{"ada", 30});
  /// The run migrates two old records.
  @[ runs("cons *{30, \"ada\", +{.0 = *{}}} (cons *{41, \"grace\", +{.0 = *{}}} nil)") ]
  def many : () -> List(New) = everyone (cons (*{"ada", 30}) (cons (*{"grace", 41}) nil));
}
