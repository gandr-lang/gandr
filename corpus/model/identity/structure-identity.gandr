/// This source states representation independence for simple structures.
///
/// A structure is a record over a carrier.
/// Equivalent carriers carry each field to an equivalent structure.
///
/// Product identity compares each component.
/// Dependent-pair identity compares the first field and then the second field.
///
/// - cites: [Sterling-2026-reflexive_graph_lenses_univalent_foundations]
/// - cites: [Sterling-2023-univalent_reference_types]
///
/// [Sterling-2026-reflexive_graph_lenses_univalent_foundations]: https://arxiv.org/abs/2404.07854 "Sterling, Reflexive Graph Lenses in Univalent Foundations"
/// [Sterling-2023-univalent_reference_types]: https://doi.org/10.4230/LIPIcs.CSL.2024.19 "Sterling, Gratzer and Birkedal, Towards univalent reference types"

// The booleans' path to themselves by negation, `negation`.
import "./transport-list.gandr";

/// A pair path has one path for each component.
def corners : Path[.A = Integer * Integer](*{2, 3}, *{2, 3}) = *{Path.here 2, Path.here 3};

/// Negation carries each pair component to its exchanged value.
def swappedPair : Path(
  Path.walk (fun (t) { type(t * t) }) negation (*{+{.0 = *{}}, +{.1 = *{}}}),
  *{+{.1 = *{}}, +{.0 = *{}}}
) = *{Path.here (+{.1 = *{}}), Path.here (+{.0 = *{}})};

/// The `rising` structure starts false.
def rising : *{t : Type, start : t, stop : t} = *{Bool, *{+{.0 = *{}}, +{.1 = *{}}}};

/// The `falling` structure starts true.
def falling : *{t : Type, start : t, stop : t} = *{Bool, *{+{.1 = *{}}, +{.0 = *{}}}};

/// Negation carries the `rising` structure to `falling`.
def oneStructure : Path(rising, falling) = *{
  negation,
  *{Path.here (+{.1 = *{}}), Path.here (+{.0 = *{}})}
};

/// Reflexivity cannot carry the `rising` points to `falling`.
@[ refuses("EndpointMismatch") ]
def stayed : Path(rising, falling) = *{
  Path.here Bool,
  *{Path.here (+{.1 = *{}}), Path.here (+{.0 = *{}})}
};
