// A recursive call at a variable converts through the arm that waits on it.
// `windWords(Loop(x))` runs to the `Loop` arm, whose `run` waits on
// `windWords(x)`, stuck at the variable; an endpoint's computation is pure, so
// the bind reads as the arm's constructor over the held call,
// `S(windWords(x))`, and the kernel replays the reading by forcing it. An arm
// that cases on the call before it returns keeps the call stuck, and a path
// stating a value for it is refused. Conversion is definitional equality by
// computation (Martin-Löf, _Intuitionistic Type Theory_, Bibliopolis, 1984).

// The presented integers and the free naturals.
import "./circle-base.gandr" ;
// The loop's words.
import "./loop-words.gandr" ;
// The winding number into the integers.
import "./loop-winding.gandr" ;
// Spinning back.
import "./loop-space.gandr" ;

/// The step case at a variable: the `Loop` arm's bind over `windWords(x)`
/// reads as `S` over the held call.
@[ checks ]
def wind_unfolded(x : Words) -> Path(Int, windWords(Loop(x)), S(windWords(x))) {
  here(S(windWords(x)))
}

/// Two loops read through two binds, the inner call's first.
@[ checks ]
def twice_unfolded(x : Words) -> Path(Int, windWords(Loop(Loop(x))), S(S(windWords(x)))) {
  here(S(S(windWords(x))))
}

/// The round trip's step case: `spinWords` waits on the read
/// `S(windWords(x))`, runs its `S` arm, and that arm's bind over
/// `spinWords(windWords(x))` reads as `Loop`.
@[ checks ]
def round_unfolded(x : Words) -> Path(
  Words,
  spinWords(windWords(Loop(x))),
  Loop(spinWords(windWords(x)))
) {
  here(Loop(spinWords(windWords(x))))
}

/// The round trip's base case, closed: every call runs to its value.
@[ checks ]
def base_case() -> Path(Words, spinWords(windWords(Nil)), Nil) {
  here(Nil)
}

/// Parity by structural recursion over the free naturals: the successor arm
/// cases on the parity of the predecessor before it returns. A case on the
/// presented `Int` is refused before conversion as one its rules do not
/// admit, so the twin that cases on its call counts here.
@[ checks ]
def rec parity(n : Nat) -> Nat {
  case n {
    Zero => Zero,
    Succ(p) => {
      run q <- parity[<](p);
      case q {
        Zero => Succ(Zero),
        Succ(r) => Zero
      }
    }
  }
}

/// The twin: the successor arm needs `parity(n)`'s value, which is stuck at
/// the variable, so the endpoint stays the bind over the call and is not
/// read as a constructor over it.
@[ refuses("EndpointMismatch") ]
def parity_stuck(n : Nat) -> Path(Nat, parity(Succ(n)), Succ(parity(n))) {
  here(Succ(parity(n)))
}
