// A flow between function types, after directed univalence (Gratzer,
// Weinberger and Buchholtz, _Directed univalence in simplicial homotopy type
// theory_, arXiv:2407.09146): a flow from the old schema to the new, given by
// its translator, turns a reader of the new schema into a reader of the old
// one, contravariant in the argument and constant in the result.

/// A record schema with its fields swapped, the reader of its ages carried
/// back to the old schema along the upgrade.
module ReaderSchema {
  type Old = String * Integer;
  type New = Integer * String;
  /// The translator: the old record's fields swapped.
  @[ checks ]
  def toNew(old : Old) -> -F New {
    case old {
      #{name, age} => (age, name)
    }
  }
  /// The flow from the old schema to the new, by its translator.
  @[ checks ]
  def upgrade : Flow(Type, Old, New) ;
  def upgrade = forward(toNew) ;
  /// The flow on readers: a reader of the new schema becomes one of the old.
  @[ checks ]
  def reader : Flow(Type, New => Integer, Old => Integer) ;
  def reader = arrow(upgrade, stay(Integer)) ;
  /// The new schema's reader of ages.
  @[ checks ]
  def age(record : New) -> -F Integer {
    case record {
      #{years, name} => years
    }
  }
  /// The reader of ages ridden back to the old schema.
  @[ checks ]
  def legacy(record : Old) -> -F Integer {
    run read <- ride(\X. X, reader, age) ;
    read(record)
  }
  /// An old record's age, read through the ridden reader.
  @[ runs("30") ]
  def aged : () => Integer ;
  def aged = legacy(("ada", 30)) ;
}
