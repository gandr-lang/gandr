/// This source binds old operation names as ordinary source names.
///
/// The operation formers still contain `Path.here` and `Path.ap`.
/// The bare names exist only after a source binds them.
/// A library then keeps the short words for its own functions.
///
/// A call resolves to its local binder.
/// The operation remains available below its former.
///
/// - see: `../../pathological/identity/bare-operations.gandr`

/// The source binds `here` as an ordinary function.
def here(n : Integer) -> Integer { n + 1 }

/// The source binds `cong` as an ordinary function.
def cong(n : Integer) -> Integer { n * 2 }

/// The bound `here` function answers instead of reflexivity.
@[runs("5")]
def bumped() -> Integer { here 4 }

/// The bound `cong` function answers instead of the path action.
@[runs("8")]
def doubled() -> Integer { cong 4 }

/// `Path.here` remains available beside the bound name.
def stillReflexive : Path(5, 5) = Path.here 5;
