// One part of a quasi-inverse or an equivalence, taken by a pattern that
// names every field and uses one, or by a label pattern that names one. The
// fields the arm leaves alone are named all the same: the round trips mention
// the maps before them, so a type read inside the arm names the forward map
// the arm never uses — by the variable written for it (#665), or by its label
// where the pattern writes none, primed apart from a variable of that name
// (#670).

// The quasi-inverse and the equivalence.
import "./equivalence.gandr";

/// The map back of a quasi-inverse.
def backOf(a : Type, b : Type, i : a ≅ b) -> b => a {
  match i {
    #{t, k, s, r} => k
  }
}

/// The left inverse of an equivalence, split along its nesting.
def leftOf(a : Type, b : Type, e : a ≃ b) -> b => a {
  match e {
    #{t, #{g, s}, #{h, r}} => g
  }
}

/// A quasi-inverse's map back, which the pattern reads by its label `from`
/// (#670).
def fromByLabel(a : Type, b : Type, i : a ≅ b) -> b => a {
  match i {
    #{.from = k} => k
  }
}

/// The map back, which the pattern binds to `into`, the forward map's own
/// label (#670).
def fromAsInto(a : Type, b : Type, i : a ≅ b) -> b => a {
  match i {
    #{.from = into} => into
  }
}
