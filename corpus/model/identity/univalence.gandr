/// This source states univalence for the user universe.
/// It follows the HoTT book's § 2.10 and
/// cubical Agda's `Cubical/Foundations/Univalence.agda`.
///
/// A bi-invertible map makes a path between its two types.
/// Transport along that path applies the map.
///
/// The checker admits `ua` from the record laws.
/// The kernel replays the two owed inverse laws.
/// `ua` admits any two codes, also two variables, or a path type and a
/// presented type, which no finite round-trip coverage reaches.
///
/// - see: #650 — `oneBack`, `idtoequiv`
/// - see: #695 — `idtoequiv`
/// - see: #698 — `idtoequiv`
/// - see: #1979 — `loopsAreTheirWinding`
/// - see: #520 — `uaEta`
/// - see: #656 — `univalence`
// The circle, the presented integers, the winding number and spinning.
import "./circle-base.gandr";
// The equivalence of the loops at the point with the integers, `winding`.
import "./circle.gandr";

/// The `fwdAlong` transport applies a path to a value.
pub def fwdAlong(a : Type, b : Type, p : Path[.A = Type](a, b), x : a) -> b =
  Path.walk (fun (X) { X }) p x

/// The `bwdAlong` transport applies the reverse path to a value.
pub def bwdAlong(a : Type, b : Type, p : Path[.A = Type](a, b), y : b) -> a =
  Path.walk (fun (X) { X }) (Path.back p) y

/// The record field and its law share the same backward transport.
def oneBack(a : Type, b : Type, p : Path[.A = Type](a, b)) -> *{
  g : b -> a,
  law : (z : b) -> Path[.A = a](g z, Path.walk (fun (X) { X }) (Path.back p) z)
} =
  *{
    fun (z) { Path.walk (fun (X) { X }) (Path.back p) z },
    fun (z) { Path.here (Path.walk (fun (X) { X }) (Path.back p) z) }
  }

/// The `sectAlong` proof establishes the back-then-forward identity with `J`.
def sectAlong(a : Type, b : Type, p : Path[.A = Type](a, b), x : a) -> Path[.A = a](
  bwdAlong a b p (fwdAlong a b p x),
  x
) =
  Path.walk
    ((y : Type, z : Path[.A = Type](a, y)) -> Path[.A = a](
      bwdAlong a y z (fwdAlong a y z x),
      x
    ))
    p
    (Path.here a)
    (Path.here p)
    (Path.here x)

/// The `retrAll` proof establishes the forward-then-back identity with `J`.
def retrAll(a : Type, b : Type, p : Path[.A = Type](a, b)) -> (w : b) -> Path[.A = b](
  fwdAlong a b p (bwdAlong a b p w),
  w
) =
  Path.walk
    ((y : Type, z : Path[.A = Type](a, y)) -> ((w : y) -> Path[.A = y](
      fwdAlong a y z (bwdAlong a y z w),
      w
    )))
    p
    (Path.here a)
    (Path.here p)
    (fun (w) { Path.here w })

/// The `retrAlong` proof applies `retrAll` at one value.
def retrAlong(a : Type, b : Type, p : Path[.A = Type](a, b), y : b) -> Path[.A = b](
  fwdAlong a b p (bwdAlong a b p y),
  y
) =
  let r = retrAll a b p
  r y

/// The `idtoequiv` record packages transport as a bi-invertible map.
/// It is the book's `idtoeqv` and cubical's `pathToEquiv`.
pub def idtoequiv(a : Type, b : Type, p : Path[.A = Type](a, b)) -> a ≃ b =
  *{
    fun (x) { fwdAlong a b p x },
    *{
      *{
        fun (y) { Path.walk (fun (X) { X }) (Path.back p) y },
        fun (x) { sectAlong a b p x }
      },
      *{
        fun (y) { Path.walk (fun (X) { X }) (Path.back p) y },
        fun (y) { retrAlong a b p y }
      }
    }
  }

/// The literal record makes a type path when it checks against `a ≃ b`.
def uaLiteral(
  a : Type,
  b : Type,
  t : a -> b,
  g : b -> a,
  s : (x : a) -> Path[.A = a](g (t x), x),
  h : b -> a,
  r : (y : b) -> Path[.A = b](t (h y), y)
) -> Path[.A = Type](a, b) =
  ua (*{t, *{*{g, s}, *{h, r}}})

/// The `winding` record makes the stated path from circle loops to integers.
pub def loopsAreIntegers : Path[.A = Type](Path[.A = Circle](Base, Base), Int) = ua winding;

/// The wildcard end of `ua(winding)` resolves to integers.
def loopsAreTheirWinding : Path[.A = Type](
  Path[.A = Circle](Base, Base),
  Int
) = (ua winding : Path[.A = Type](
  Path[.A = Circle](Base, Base),
  _
));

/// Transport along `ua` applies its record map by conversion.
def uaBeta(
  a : Type,
  b : Type,
  t : a -> b,
  g : b -> a,
  s : (x : a) -> Path[.A = a](g (t x), x),
  h : b -> a,
  r : (y : b) -> Path[.A = b](t (h y), y),
  x : a
) -> Path[.A = b](fwdAlong a b (ua (*{t, *{*{g, s}, *{h, r}}})) x, t x) =
  Path.here (t x)

/// The `uaBetaRun` run applies the `winding` map to the loop.
@[ runs("S Z") ]
def uaBetaRun() -> Int { Path.walk (fun (X) { X }) (ua winding) (loop) }

/// Transport to the integers converts each loop to its winding number.
def windingBeta(x : Path[.A = Circle](Base, Base)) -> Path[.A = Int](
  Path.walk (fun (X) { X }) loopsAreIntegers x,
  wind x
) =
  Path.here (wind x)

/// The loop run returns its winding number.
@[ runs("S Z") ]
def windingRun() -> Int { Path.walk (fun (X) { X }) loopsAreIntegers (loop) }

/// No conversion proves `ua` after `idtoequiv`, so `uaEta` owes a law.
@[ owes(1) ]
def uaEta : (a : Type, b : Type, p : Path[.A = Type](a, b)) -> Path[.A = Path[.A = Type](a, b)](
  ua (idtoequiv a b p),
  p
);

/// The model owes `idtoequivUa` because this corpus does not prove
/// bi-invertibility is a proposition.
@[ owes(1) ]
def idtoequivUa : (a : Type, b : Type, e : a ≃ b) -> Path[.A = a ≃ b](idtoequiv a b (ua e), e);

/// The `idtoequiv` and `ua` maps form a quasi-inverse with two
/// owed round trips.
def univalenceIso(a : Type, b : Type) -> Path[.A = Type](a, b) ≅ (a ≃ b) =
  *{
    fun (p) { idtoequiv a b p },
    *{
      fun (e) { ua e },
      *{fun (p) { uaEta a b p }, fun (e) { idtoequivUa a b e }}
    }
  }

/// The explicit `univalence` record makes `idtoequiv` an equivalence with `ua`
/// as both inverses because a split loses its type.
pub def univalence(a : Type, b : Type) -> Path[.A = Type](a, b) ≃ (a ≃ b) =
  *{
    fun (p) { idtoequiv a b p },
    *{
      *{fun (e) { ua e }, fun (p) { uaEta a b p }},
      *{fun (e) { ua e }, fun (e) { idtoequivUa a b e }}
    }
  }
