// Function extensionality at data types, the HoTT book's § 2.9 with the
// types read as in § 2.12: a data type is the sum of its constructors, each
// the product of its fields, so two functions on shapes that agree at each
// constructor over fresh fields are one path, and two that return data agree
// when their results do, constructor by constructor.

// The shapes, the figures and `Shapes.toFigure`, the map from the one to the
// other.
import "./flow-data.gandr" ;

/// A shape's width: a circle's radius, a rectangle's first side.
@[ checks ]
def width(shape : Shape) -> -F Integer {
  case shape {
    Circle(r) => r,
    Rect(w, h) => w
  }
}

/// A figure's width: a round's radius, a box's second side.
@[ checks ]
def figureWidth(figure : Figure) -> -F Integer {
  case figure {
    Round(r) => r,
    Box(h, w) => w
  }
}

/// A shape's width read off its figure, where the sides are swapped.
@[ checks ]
def throughFigure(shape : Shape) -> -F Integer {
  figureWidth(Shapes.toFigure(shape))
}

/// The two readings are one function: they agree at a circle and at a
/// rectangle, whatever their sides.
@[ checks ]
def widths : Path(Shape => Integer, width, throughFigure) = funext(width, throughFigure) ;

/// A shape drawn as its figure, the sides swapped in the other order of
/// binding.
@[ checks ]
def drawn(shape : Shape) -> -F Figure {
  case shape {
    Circle(r) => Round(r),
    Rect(a, b) => Box(b, a)
  }
}

/// The two drawings are one function: at each shape they return the same
/// figure, constructor and fields.
@[ checks ]
def drawings : Path(Shape => Figure, Shapes.toFigure, drawn) = funext(Shapes.toFigure, drawn) ;

/// A light's two states, neither holding a field.
@[ checks ]
data Light : Type {
  Stop : Light;
  Go : Light;
}

/// A light switched.
@[ checks ]
def switch(light : Light) -> -F Light {
  case light {
    Stop => Go,
    Go => Stop
  }
}

/// A light switched twice.
@[ checks ]
def switchTwice(light : Light) -> -F Light {
  switch(switch(light))
}

/// A light left as it is.
@[ checks ]
def unswitched(light : Light) -> -F Light {
  light
}

/// Switching twice is leaving the light as it is: the two agree at both
/// states.
@[ checks ]
def switchedTwice : Path(Light => Light, switchTwice, unswitched) = funext(
  switchTwice,
  unswitched
) ;
