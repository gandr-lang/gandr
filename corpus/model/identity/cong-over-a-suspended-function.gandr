// `Path.ap` acts on a path through a suspended function that states its type.
//
// The editor answers at every node the checker judges. A function given to
// `Path.ap` holds such nodes, as a function given to a call does.
//
// The declaration whiskers a path of paths through `Path.ap`.
//
// - see: #3787 — no editor entry inside the function, before
// - see: #3801 — the census reprints the thunk's path types one binder off, before
// - see: #3872 — the formatter and the printer spell the map's thunk apart, before

/// Whiskering a path of paths on the right, through a suspended function.
def whiskeredBySuspension(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(Path(A, x, z), Path.step(f1, g), Path.step(f2, g)) {
  Path.ap(
    (thunk { fun (q : Path(A, x, y)) { Path.step(q, g) } } : Path(A, x, y) => Path(A, x, z)),
    a
  )
}
