/// This source states an equivalence between two data types.
///
/// The maps move constructor fields between shapes and figures.
/// Their round trips return every constructor pattern.
///
/// The `equiv` record makes the maps a path between the data types.
/// Transport along that path applies the forward map.
///
/// - see: corpus/model/identity/flow-data.gandr
import "./flow-data.gandr";

/// The `toShape` function swaps figure sides into shape order.
def toShape(figure : Figure) -> Shape =
  match figure
    | Round(r) => Circle r
    | Box(h, w) => Rect w h

/// The two round trips make shapes and figures one type.
def redrawing : Path[.A = Type](Shape, Figure) = equiv Shapes.toFigure toShape;

/// Transport maps the rectangle to the figure with swapped sides.
@[ runs("Box 3 2") ]
def boxed() -> Figure { Path.walk (fun (X) { X }) redrawing (Rect 2 3) }
