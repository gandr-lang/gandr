//! This source defines the composite of two paths.
//!
//! The composite joins a path to one that starts at its endpoint.
//! A run joins two reflexivity paths.
//!
//! The checker reads `Path.step` as the unbiased 2-chain composite.
//! The kernel replays the composite.
//!
//! - see: HoTT Book Lemma 2.1.2

// Reflexivity at seven.
import "./back.gandr";

/// Two paths between integers, the second leaving where the first arrives,
/// composed.
def join(
  a : Integer,
  b : Integer,
  c : Integer,
  q : Path(a, b),
  r : Path(b, c)
) -> Path(a, c) =
  Path.step q r

/// Reflexivity at seven composed with itself by a run.
def joined_here() -> Path(7, 7) { join 7 7 7 p p }

/// `Path.step` is the composite of the 2-chain its two paths fill.
def joined_unbiased(
  a : Integer,
  b : Integer,
  c : Integer,
  q : Path[.A = Integer](a, b),
  r : Path(b, c)
) -> Path[.A = Path[.A = Integer](a, c)](Path.step q r, compose[3, 5] (chain 2) (q, r)) =
  Path.here (Path.step q r)
