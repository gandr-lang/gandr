/// This source states a rule that completion derives for each group model.
///
/// Completion reduces both rule sides to one normal form.
/// The two reduction certificates prove the derived rule.
///
/// The checker reads the rule as `Group.invMul` at a model.
/// `Path.walk` reduces its filler to `Path.here`.
///
/// - cites: [Knuth-1970-simple_word_problems_universal_algebras]
///
/// [Knuth-1970-simple_word_problems_universal_algebras]: https://doi.org/10.1016/B978-0-08-012975-4.50028-X "Knuth and Bendix, Simple Word Problems in Universal Algebras"

// The group's unit, associativity and inverse laws.
import "./group-laws.gandr";

/// The inverse-product rule holds in every group.
rule Group.invMul : inv (mul x y) <=> mul (inv y) (inv x);

/// A bit has two values.
data Bit : Type where
  | Zero : Bit
  | One : Bit

/// The `xor` function computes exclusive or.
def xor(a : Bit, b : Bit) -> Bit =
  match a where
    | Zero => b
    | One => match b where
      | Zero => One
      | One => Zero

/// The `Parity` model uses zero as its unit and exclusive or as its product.
module Parity : Model(Group) where {
  type G = Bit;
  def e = Zero;
  def a = One;
  def b = Zero;
  def inv(x : Bit) -> Bit { x }
  def mul(x : Bit, y : Bit) -> Bit { xor x y }
  @[checks]
  def unitL(x : Bit) -> Path(mul e x, x) { Path.here x }
  @[checks]
  def unitR(x : Bit) -> Path(mul x e, x) =
    match x where
      | Zero => Path.here Zero
      | One => Path.here One
  @[checks]
  def assoc(x : Bit, y : Bit, z : Bit) -> Path(mul (mul x y) z, mul x (mul y z)) =
    match x where
      | Zero => Path.here (xor y z)
      | One => match y where
        | Zero => Path.here (xor One z)
        | One => match z where
          | Zero => Path.here Zero
          | One => Path.here One
  @[checks]
  def invInv(x : Bit) -> Path(inv (inv x), x) { Path.here x }
  @[checks]
  def invE() -> Path(inv e, e) { Path.here Zero }
  @[checks]
  def invL(x : Bit) -> Path(mul (inv x) x, e) =
    match x where
      | Zero => Path.here Zero
      | One => Path.here Zero
}

/// The `parityGroup` value is the group model.
def parityGroup : Model Group = pack Parity at Model Group;

/// The derived rule gives a path from one to one.
def invMulParity() -> Path(One, One) =
  let law = Group.invMul parityGroup
  law One Zero

/// `Path.walk` over the derived filler reduces to `Path.here`.
def overDerived(
  M : Bit -> Type,
  v : M One
) -> Path(Path.walk (fun (b) { M b }) (invMulParity ()) v, v) =
  Path.here v
