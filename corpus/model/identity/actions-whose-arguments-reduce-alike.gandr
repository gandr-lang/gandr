/// Actions whose arguments reduce alike.
///
/// An action on a path that is itself an action is one path, wherever the
/// source writes the inner action. `whiskerAlong` unfolds to the action of
/// composing with `g`. So a call of it and the action written out are one
/// argument, beneath another action or another whisker. The nested action
/// written in one definition is the same path as the outer action on the
/// inner one.
///
/// Each outer action unfolds to a transport whose motive reads the inner
/// path. That path is the endpoint a transport along `fa` returns, held once
/// per writing. The engine sets the two endpoints aside and reads each
/// through to its transport. It emits the motives as one shared comparison,
/// which the kernel replays on its own terms.
///
/// - see: #3976 — the code walk pairs a lambda's captures laid out apart
/// - see: #4005 — the checker refused two such endpoints inside a code

/// The action of `F` on `p`.
def actAlong(A : Type, B : Type, F : A => B, x : A, y : A, p : Path[.A = A](x, y)) -> Path[.A = B](
  F(x),
  F(y)
) {
  Path.ap(F, p)
}

/// The action on `a` of composing with `g`.
def whiskerAlong(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path[.A = A](x, y),
  f2 : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f1, f2),
  g : Path[.A = A](y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step(f1, g), Path.step(f2, g)) {
  actAlong(
    type(Path[.A = A](x, y)),
    type(Path[.A = A](x, z)),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path[.A = A](x, y) => Path[.A = A](x, z)),
    f1,
    f2,
    a
  )
}

/// The action of `G` on the action of `F` on `p`.
def actAct(
  A : Type,
  B : Type,
  C : Type,
  F : A => B,
  G : B => C,
  x : A,
  y : A,
  p : Path[.A = A](x, y)
) -> Path[.A = C](G(F(x)), G(F(y))) {
  actAlong(B, C, G, F(x), F(y), actAlong(A, B, F, x, y, p))
}

/// An outer action on the inner action written out, against the same outer
/// action on a call of `whiskerAlong`.
def underAnAction(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w)
) -> Path[.A = Path[.A = Path[.A = A](x, w)](
  Path.step(Path.step(fm, g), h),
  Path.step(Path.step(fp, g), h)
)](
  actAlong(
    type(Path[.A = A](x, z)),
    type(Path[.A = A](x, w)),
    (fun (r : Path[.A = A](x, z)) { Path.step(r, h) } : Path[.A = A](x, z) => Path[.A = A](x, w)),
    Path.step(fm, g),
    Path.step(fp, g),
    actAlong(
      type(Path[.A = A](x, y)),
      type(Path[.A = A](x, z)),
      (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path[.A = A](x, y) => Path[.A = A](x, z)),
      fm,
      fp,
      fa
    )
  ),
  actAlong(
    type(Path[.A = A](x, z)),
    type(Path[.A = A](x, w)),
    (fun (r : Path[.A = A](x, z)) { Path.step(r, h) } : Path[.A = A](x, z) => Path[.A = A](x, w)),
    Path.step(fm, g),
    Path.step(fp, g),
    whiskerAlong(A, x, y, z, fm, fp, fa, g)
  )
) {
  Path.here(actAlong(
    type(Path[.A = A](x, z)),
    type(Path[.A = A](x, w)),
    (fun (r : Path[.A = A](x, z)) { Path.step(r, h) } : Path[.A = A](x, z) => Path[.A = A](x, w)),
    Path.step(fm, g),
    Path.step(fp, g),
    whiskerAlong(A, x, y, z, fm, fp, fa, g)
  ))
}

/// An outer whisker on the inner action written out, against the same outer
/// whisker on a call of `whiskerAlong`.
def underAWhisker(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w)
) -> Path[.A = Path[.A = Path[.A = A](x, w)](
  Path.step(Path.step(fm, g), h),
  Path.step(Path.step(fp, g), h)
)](
  whiskerAlong(
    A,
    x,
    z,
    w,
    Path.step(fm, g),
    Path.step(fp, g),
    actAlong(
      type(Path[.A = A](x, y)),
      type(Path[.A = A](x, z)),
      (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path[.A = A](x, y) => Path[.A = A](x, z)),
      fm,
      fp,
      fa
    ),
    h
  ),
  whiskerAlong(
    A,
    x,
    z,
    w,
    Path.step(fm, g),
    Path.step(fp, g),
    whiskerAlong(A, x, y, z, fm, fp, fa, g),
    h
  )
) {
  Path.here(whiskerAlong(
    A,
    x,
    z,
    w,
    Path.step(fm, g),
    Path.step(fp, g),
    whiskerAlong(A, x, y, z, fm, fp, fa, g),
    h
  ))
}

/// The nested action written out, against `actAct` at the two lambdas.
def nestedAtLambdas(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path[.A = A](y, z),
  h : Path[.A = A](z, w)
) -> Path[.A = Path[.A = Path[.A = A](x, w)](
  Path.step(Path.step(fm, g), h),
  Path.step(Path.step(fp, g), h)
)](
  actAlong(
    type(Path[.A = A](x, z)),
    type(Path[.A = A](x, w)),
    (fun (r : Path[.A = A](x, z)) { Path.step(r, h) } : Path[.A = A](x, z) => Path[.A = A](x, w)),
    Path.step(fm, g),
    Path.step(fp, g),
    actAlong(
      type(Path[.A = A](x, y)),
      type(Path[.A = A](x, z)),
      (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path[.A = A](x, y) => Path[.A = A](x, z)),
      fm,
      fp,
      fa
    )
  ),
  actAct(
    type(Path[.A = A](x, y)),
    type(Path[.A = A](x, z)),
    type(Path[.A = A](x, w)),
    (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path[.A = A](x, y) => Path[.A = A](x, z)),
    (fun (r : Path[.A = A](x, z)) { Path.step(r, h) } : Path[.A = A](x, z) => Path[.A = A](x, w)),
    fm,
    fp,
    fa
  )
) {
  Path.here(actAlong(
    type(Path[.A = A](x, z)),
    type(Path[.A = A](x, w)),
    (fun (r : Path[.A = A](x, z)) { Path.step(r, h) } : Path[.A = A](x, z) => Path[.A = A](x, w)),
    Path.step(fm, g),
    Path.step(fp, g),
    actAlong(
      type(Path[.A = A](x, y)),
      type(Path[.A = A](x, z)),
      (fun (q : Path[.A = A](x, y)) { Path.step(q, g) } : Path[.A = A](x, y) => Path[.A = A](x, z)),
      fm,
      fp,
      fa
    )
  ))
}
