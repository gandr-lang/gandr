// Reflexivity is a congruence for conversion (the HoTT book's § 1.12, `refl`,
// under judgmental equality): two reflexivities are one path when their
// points convert, by unfolding or by a presented type's rule, at every level,
// and a parameter is no reflexivity.

// The integers, presented by their two cancellations.
import "./circle-base.gandr" ;

/// A declared reflexivity.
@[ checks ]
def refl_two : Path(Integer, 2, 2) = here(2) ;

/// Two reflexivities convert when their points do.
@[ checks ]
def two_is_here : Path(Path(Integer, 2, 2), refl_two, here(2)) = here(here(2)) ;

/// `here(refl_two)` at that path.
@[ checks ]
def here_two : Path(Path(Integer, 2, 2), refl_two, here(2)) = here(refl_two) ;

/// Points one unfolding apart, one level up.
@[ checks ]
def here_two_up : Path(
  Path(Path(Integer, 2, 2), refl_two, here(2)),
  here(refl_two),
  here(here(2))
) = here(here(refl_two)) ;

/// The reflexivity at the cancelled side of a peak: `S(P(S(x)))` and `S(x)`
/// are one integer by the rule `S(P(x)) <=> x`.
@[ checks ]
def refl_peak(x : Int) -> Path(Int, S(P(S(x))), S(x)) {
  here(S(x))
}

/// The reflexivity at the peak itself, at the same path type.
@[ checks ]
def refl_peak_at(x : Int) -> Path(Int, S(P(S(x))), S(x)) {
  here(S(P(S(x))))
}

/// Points a rule relates, one level up: the two reflexivities are one path
/// (#1723).
@[ checks ]
def peak_is_here(x : Int) -> Path(Path(Int, S(P(S(x))), S(x)), refl_peak(x), refl_peak_at(x)) {
  here(refl_peak(x))
}

/// A parameter does not unfold to `here(2)`.
@[ refuses("EndpointMismatch") ]
def apart(q: Path(Integer, 2, 2)) -> Path(Path(Integer, 2, 2), q, here(2)) {
  here(q)
}

/// An integer, returned as it came.
@[ checks ]
def as_given(n : Integer) -> Integer { n }

/// Points one unfolding apart over a native sum of parameters: the sum is
/// held as its call, never run, and meets itself (#2378).
@[ checks ]
def held_sum(x : Integer, y : Integer) -> Path(Integer, as_given(x + y), x + y) {
  here(x + y)
}

/// The sum with its operands exchanged is another call: conversion knows no
/// arithmetic law.
@[ refuses("EndpointMismatch") ]
def exchanged_sum(x : Integer, y : Integer) -> Path(Integer, as_given(x + y), y + x) {
  here(x + y)
}

/// A comparison's model is resolved from its operands once the body is
/// judged: the point compares alike, and meets both endpoints when each
/// comparison reads the integers' equality (#2391).
@[ checks ]
def compared_alike(x : Integer, y : Integer) -> Path(Bool, x == y, x == y) {
  here(x == y)
}

/// The comparison with its operands exchanged is another call once resolved.
@[ refuses("EndpointMismatch") ]
def compared_turned(x : Integer, y : Integer) -> Path(Bool, x == y, y == x) {
  here(x == y)
}

/// A path over a comparison, returned at a path type over comparisons of its
/// own, converts once each comparison's model is resolved (#2391).
@[ checks ]
def passed_on(x : Integer, y : Integer, p : Path(Bool, x == y, x == y)) -> Path(
  Bool,
  x == y,
  x == y
) {
  p
}

/// At a path type over the exchanged comparison it is another type.
@[ refuses("TypeMismatch") ]
def passed_turned(x : Integer, y : Integer, p : Path(Bool, x == y, x == y)) -> Path(
  Bool,
  y == x,
  y == x
) {
  p
}
