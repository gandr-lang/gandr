// A call written where a value is read runs, and a pure one whose value a type
// after it reads stands there as what it returns: a dependent record's first
// component under the second's type, and a dependent function's argument
// under the parameters after it (#426). A parameter function under `cong`
// answers at its own span (#443). The records are the HoTT book's dependent
// pairs (§ 1.6), and the maps out of the circle follow cubical Agda's
// `IsoFunSpaceS¹` (`Cubical/HITs/S1/Properties.agda`).

// The circle and the integers.
import "./circle-base.gandr";
// The map a point and a loop there determine, `fromLoopAt`.
import "./circle-rotation.gandr";

/// A map's image of the loop, at the map's image of the point: `cong` of the
/// parameter `f` along the loop.
def loopImage(f : Circle => Int) -> Path(Int, f(Base), f(Base)) {
  cong(f, loop)
}

/// A map out of the circle as a point and a loop there, the loop through
/// `loopImage`: the second component's type reads the first, the call
/// `f(Base)` (#426). `circle-rotation.gandr`'s `toLoop` writes the loop as
/// `cong(f, loop)` itself.
def toLoopThroughImage(f : Circle => Int) -> #{
  point : Int,
  around : Path(Int, point, point)
} {
  (f(Base), loopImage(f))
}

/// Another map's loop is not one at this map's point.
@[ refuses("TypeMismatch") ]
def toOtherLoop(f : Circle => Int, g : Circle => Int) -> #{
  point : Int,
  around : Path(Int, point, point)
} {
  (f(Base), loopImage(g))
}

/// A record's projections as the arguments of that map: the second
/// parameter's type reads the first argument, the projection `r.point`
/// (#426).
def fromRecord(r : #{point : Int, around : Path(Int, point, point)}, c : Circle) -> Int {
  fromLoopAt(r.point, r.around, c)
}
