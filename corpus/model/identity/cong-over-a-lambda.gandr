// A function written as `fun (q) { e }` acts on a path through `Path.ap`.
//
// Whiskering composes each path of a path of paths with a fixed path. The
// function that does it is short, and a stated type for it only repeats
// the path's type.
//
// The binder takes the type of the path's points. Where no path type is
// stated, `Path.ap` reads its own off the path type the body has.
//
// - see: #3773 — a lambda as `Path.ap`'s function, refused before
// - see: #3829 — a lambda where no path type is stated, refused before
// - see: #3919 — a lambda stating its binder's type, refused before

/// Whiskering a path of paths on the right.
def whiskerRight(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(Path(A, x, z), Path.step(f1, g), Path.step(f2, g)) {
  Path.ap(fun (q) { Path.step(q, g) }, a)
}

/// The whisker composed with a reflexivity: `Path.ap` stands under
/// `Path.step`, where no path type is stated.
def whiskerThenHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(Path(A, x, z), Path.step(f1, g), Path.step(f2, g)) {
  Path.step(Path.ap(fun (q) { Path.step(q, g) }, a), Path.here(Path.step(f2, g)))
}

/// The whisker as an endpoint of a stated path type: its reflexivity.
def whiskerHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(
  Path(Path(A, x, z), Path.step(f1, g), Path.step(f2, g)),
  Path.ap(fun (q) { Path.step(q, g) }, a),
  Path.ap(fun (q) { Path.step(q, g) }, a)
) {
  Path.here(Path.ap(fun (q) { Path.step(q, g) }, a))
}

/// The whisker's reflexivity again, its binder stating the type of the path's
/// points.
def whiskerStatedHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(
  Path(Path(A, x, z), Path.step(f1, g), Path.step(f2, g)),
  Path.ap(fun (q : Path(A, x, y)) { Path.step(q, g) }, a),
  Path.ap(fun (q : Path(A, x, y)) { Path.step(q, g) }, a)
) {
  Path.here(Path.ap(fun (q : Path(A, x, y)) { Path.step(q, g) }, a))
}
