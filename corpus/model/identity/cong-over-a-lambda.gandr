/// This source states action on a path through a lambda.
///
/// Whiskering composes each path of a path equality with one fixed path.
/// A stated lambda type repeats the path type.
///
/// The binder reads the type of the path points.
/// The elaborator checks `Path.ap` against its own path type when no type occurs.
///
/// - see: #3773 — lambda action
/// - see: #3829 — inferred path types
/// - see: #3919 — stated binder types

/// The right whisker maps a path equality through composition with `g`.
def whiskerRight(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path[.A = A](x, y),
  f2 : Path(x, y),
  a : Path[.A = Path[.A = A](x, y)](f1, f2),
  g : Path(y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step f1 g, Path.step f2 g) =
  Path.ap (fun (q) { Path.step q g }) a

/// The whisker and its reflexivity form a `Path.step` without a stated path type.
def whiskerThenHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path[.A = A](x, y),
  f2 : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f1, f2),
  g : Path(y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step f1 g, Path.step f2 g) =
  Path.step (Path.ap (fun (q) { Path.step q g }) a) (Path.here (Path.step f2 g))

/// The stated whisker endpoint equals itself by reflexivity.
def whiskerHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path[.A = A](x, y),
  f2 : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f1, f2),
  g : Path(y, z)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f1 g, Path.step f2 g)](
  Path.ap (fun (q) { Path.step q g }) a,
  Path.ap (fun (q) { Path.step q g }) a
) =
  Path.here (Path.ap (fun (q) { Path.step q g }) a)

/// The stated binder gives the whisker path its point type.
def whiskerStatedHere(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path[.A = A](x, y),
  f2 : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f1, f2),
  g : Path(y, z)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f1 g, Path.step f2 g)](
  Path.ap (fun (q : Path[.A = A](x, y)) { Path.step q g }) a,
  Path.ap (fun (q : Path[.A = A](x, y)) { Path.step q g }) a
) =
  Path.here (Path.ap (fun (q : Path[.A = A](x, y)) { Path.step q g }) a)
