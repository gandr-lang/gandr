// Unbiased composition of a chain of paths at a certified stratum.
//
// A chain of paths has one composite up to its bracketings, so the former
// names that composite and chooses no bracketing.
//
// `compose[n, k](chain(m), (c₁, …, cₘ))` composes `m` cells that meet end to
// end. The chain sub-site certifies the stratum at degree `n` over bound `k`,
// and the chain is a shape of it. The node carries the left-nested `Path.step` fold
// of its cells. Evaluation runs the fold, and the kernel replays it as it
// replays the chain written with `Path.step`.
//
// - see: `then.gandr` — the composite of two paths
// - see: `ledger/diagnostics/ComposeDoesNotFill.gandr` — cells that do not meet

// The circle, its point and its loop.
import "./circle-base.gandr";

/// Three paths, each leaving where the one before arrives, composed unbiased.
def composed(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  p : Path(A, x, y),
  q : Path(A, y, z),
  r : Path(A, z, w)
) -> Path(A, x, w) {
  compose[5, 7](chain(3), (p, q, r))
}

/// The same three paths composed by `Path.step`, the fold the composite carries.
def folded(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  p : Path(A, x, y),
  q : Path(A, y, z),
  r : Path(A, z, w)
) -> Path(A, x, w) {
  Path.step(Path.step(p, q), r)
}

/// The composite is the fold it carries, by reflexivity.
def agrees(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  p : Path(A, x, y),
  q : Path(A, y, z),
  r : Path(A, z, w)
) -> Path(Path(A, x, w), composed(A, x, y, z, w, p, q, r), folded(A, x, y, z, w, p, q, r)) {
  Path.here(folded(A, x, y, z, w, p, q, r))
}

/// One cell is its own composite, and reads no stratum.
def single(A : Type, x : A, y : A, p : Path(A, x, y)) -> Path(A, x, y) {
  compose[0, 0](chain(1), p)
}

/// Three reflexivities compose unbiased to a loop at their point.
def reflexivities(A : Type, x : A) -> Path(A, x, x) {
  compose[5, 7](chain(3), (Path.here(x), Path.here(x), Path.here(x)))
}

/// A composite of reflexivities reduces to reflexivity.
def decided(A : Type, x : A) -> Path(Path(A, x, x), reflexivities(A, x), Path.here(x)) {
  Path.here(Path.here(x))
}

/// A cell written as a call runs, and the composite reads the path it returns.
def called(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  p : Path(A, x, y),
  q : Path(A, y, z),
  r : Path(A, z, w)
) -> Path(A, x, w) {
  compose[3, 5](chain(2), (folded(A, x, y, z, w, p, q, r), Path.here(w)))
}

/// A word written as a cell is the path at the circle's point it is.
def wound : Path(
  Path(Circle, Base, Base),
  compose[3, 5](chain(2), (loop, Path.here(Base))),
  loop
) = Path.here(loop);
