// The loop space's equivalence, one stratum down from the book's circle
// (Theorem 8.1.9): spinning, the fold out of the presented integers into the
// loop's words, undoes the winding number and the winding number undoes it,
// at closed words by conversion and at a variable by induction over each
// presented type (`sectWords`, `retrWords`), so `Words ≃ Int`.

// The presented integers.
import "./circle-base.gandr";
// The loop's words, one inverse loop more and one loop more.
import "./loop-words.gandr";
// The circle's shape and its model over the presented integers.
import "./loop-shape.gandr";
// The winding number.
import "./loop-winding.gandr";

/// Spinning, the fold out of the presented integers into the words: a
/// successor is a loop and a predecessor an inverse. It recurses structurally
/// and respects both rules as the winding number does.
def rec spinWords(n : Int) -> Words {
  case n {
    Z => Nil,
    S(x) => Loop(spinWords[<](x)),
    P(x) => Unloop(spinWords[<](x))
  }
}

/// Two successors spin twice around.
@[ runs("Loop(Loop(Nil))") ]
def spun() -> Words { become spinWords(S(S(Z))) }

/// Conversion runs spinning at a closed word: two successors are two loops.
def spun_twice : Path(Words, spinWords(S(S(Z))), Loop(Loop(Nil))) = here(Loop(Loop(Nil)));

/// A cancelled count spins to the empty word.
def spun_back : Path(Words, spinWords(S(P(Z))), Nil) = here(Nil);

/// A predecessor spins to the inverse loop.
def spun_under : Path(Words, spinWords(P(Z)), Unloop(Nil)) = here(Unloop(Nil));

/// The round trip at a closed word: winding a loop and spinning the count
/// gives the loop back. The inner call stands as the outer one's argument,
/// and conversion runs both.
def spun_wound : Path(Words, spinWords(windWords(Loop(Nil))), Loop(Nil)) = here(Loop(Nil));

/// The other round trip at a closed count: spinning two successors and
/// winding the word counts two.
def wound_spun : Path(Int, windWords(spinWords(S(S(Z)))), S(S(Z))) = here(S(S(Z)));

/// A round trip returns the normal form, not the word it started from: a
/// cancelled loop comes back as the loop.
def spun_wound_cancelled : Path(
  Words,
  spinWords(windWords(Loop(Unloop(Loop(Nil))))),
  Loop(Nil)
) = here(Loop(Nil));

/// A respelled count comes back as its normal form, one predecessor.
def wound_spun_respelled : Path(Int, windWords(spinWords(S(P(P(Z))))), P(Z)) = here(P(Z));

/// The round trip does not lose the loop: it is not the empty word.
@[ refuses("EndpointMismatch") ]
def spun_wound_lost : Path(Words, spinWords(windWords(Loop(Nil))), Nil) = here(Nil);

/// One inverse loop more: the function the inverse letter applies, as
/// `around` applies the loop.
def unaround(c : Words) -> Words {
  Unloop(c)
}

/// Spinning undoes winding at every word: the round trip at a variable, by
/// induction over the presented words. The result type reads the word the
/// fold descends on, so each arm answers it at its constructor and the
/// recursive call at the field: `sectWords[<](x)` relates
/// `spinWords(windWords(x))` to `x`, and carried along `around` it relates
/// `Loop(spinWords(windWords(x)))`, which `spinWords(windWords(Loop(x)))`
/// runs to, to `Loop(x)`. The case respects both rules: at `Loop(Unloop(x))`
/// the arms compose to `cong(around, cong(unaround, p))`, whose functions
/// compose to the identity under the rules, so the chain is `p` itself, the
/// answer at `x`.
def rec sectWords(c : Words) -> Path(Words, spinWords(windWords(c)), c) {
  case c {
    Nil => here(Nil),
    Loop(x) => { run p <- sectWords[<](x); cong(around, p) },
    Unloop(x) => { run p <- sectWords[<](x); cong(unaround, p) }
  }
}

/// Winding undoes spinning at every count: the other round trip, by
/// induction over the presented integers, a successor carried along the
/// model's `turn` and a predecessor along its `unturn`.
def rec retrWords(n : Int) -> Path(Int, windWords(spinWords(n)), n) {
  case n {
    Z => here(Z),
    S(x) => { run p <- retrWords[<](x); cong(Winding.turn, p) },
    P(x) => { run p <- retrWords[<](x); cong(Winding.unturn, p) }
  }
}

/// The loop's words and the presented integers are equivalent, by
/// `windWords` and `spinWords` with the two round trips at a variable (the
/// book's Theorem 8.1.9, one stratum down). The later entries read `to` and
/// `back`, so the record is their dependent pairs nested to the right, and
/// its value nests the same way: `sectWords` and `retrWords` are checked at
/// the types the record states once `to` is `windWords` and `back` is
/// `spinWords`.
def wordsWinding : #{
  to : Words => Int,
  back : Int => Words,
  sect : (c : Words) => Path(Words, back(to(c)), c),
  retr : (n : Int) => Path(Int, to(back(n)), n)
} = (windWords, (spinWords, (sectWords, retrWords)));
