/// This source gives an equivalence between loop words and presented integers.
///
/// `spinWords` maps counts to loops and inverse loops.
/// `windWords` maps loop words to counts.
///
/// Induction proves both round trips.
/// It is the HoTT book's circle theorem at the presented stratum.
/// The equivalence record stores the maps and their proofs.
///
/// - see: corpus/model/identity/loop-winding.gandr

// The presented integers.
import "./circle-base.gandr";
// The loop's words, one inverse loop more and one loop more.
import "./loop-words.gandr";
// The circle's shape and its model over the presented integers.
import "./loop-shape.gandr";
// The winding number.
import "./loop-winding.gandr";

/// The `spinWords` function maps an integer count to loop words.
pub def rec spinWords(n : Int) -> Words =
  match n where
    | Z => Nil
    | S(x) => Loop (spinWords[<] x)
    | P(x) => Unloop (spinWords[<] x)

/// The sample spins two successors to two loops.
@[runs("Loop (Loop Nil)")]
def spun() -> Words { spinWords (S (S Z)) }

/// Conversion spins two successors to two loops.
def spun_twice : Path[.A = Words](
  spinWords (S (S Z)),
  Loop (Loop Nil)
) = Path.here (Loop (Loop Nil));

/// A cancelled count spins to the empty word.
def spun_back : Path[.A = Words](spinWords (S (P Z)), Nil) = Path.here Nil;

/// A predecessor spins to one inverse loop.
def spun_under : Path[.A = Words](spinWords (P Z), Unloop Nil) = Path.here (Unloop Nil);

/// The first closed round trip returns a loop word.
def spun_wound : Path[.A = Words](
  spinWords (windWords (Loop Nil)),
  Loop Nil
) = Path.here (Loop Nil);

/// The second closed round trip returns an integer count.
def wound_spun : Path[.A = Int](windWords (spinWords (S (S Z))), S (S Z)) = Path.here (S (S Z));

/// A closed round trip returns the word normal form.
def spun_wound_cancelled : Path[.A = Words](
  spinWords (windWords (Loop (Unloop (Loop Nil)))),
  Loop Nil
) = Path.here (Loop Nil);

/// A respelled count returns its integer normal form.
def wound_spun_respelled : Path[.A = Int](
  windWords (spinWords (S (P (P Z)))),
  P Z
) = Path.here (P Z);

/// The loop round trip does not return the empty word.
@[refuses("EndpointMismatch")]
def spun_wound_lost : Path[.A = Words](spinWords (windWords (Loop Nil)), Nil) = Path.here Nil;

/// The `unaround` function adds an inverse loop.
def unaround(c : Words) -> Words =
  Unloop c

/// At every word, `sectWords` proves that spinning follows winding.
def rec sectWords(c : Words) -> Path[.A = Words](spinWords (windWords c), c) =
  match c where
    | Nil => Path.here Nil
    | Loop(x) => { let p = sectWords[<] x; Path.ap around p }
    | Unloop(x) => { let p = sectWords[<] x; Path.ap unaround p }

/// At every integer, `retrWords` proves that winding follows spinning.
def rec retrWords(n : Int) -> Path[.A = Int](windWords (spinWords n), n) =
  match n where
    | Z => Path.here Z
    | S(x) => { let p = retrWords[<] x; Path.ap Winding.turn p }
    | P(x) => { let p = retrWords[<] x; Path.ap Winding.unturn p }

/// The `wordsWinding` record gives the two maps and their round trips.
def wordsWinding : *{
  into : Words -> Int,
  from : Int -> Words,
  sect : (c : Words) -> Path[.A = Words](from (into c), c),
  retr : (n : Int) -> Path[.A = Int](into (from n), n)
} = *{windWords, *{spinWords, *{sectWords, retrWords}}};
