// Calls nested inside a path type's endpoints convert to their values. An
// endpoint that applies a function to another call waits on the inner call
// once the outer one unfolds, and conversion unfolds that call next; over a
// presented type the inner call stands under a constructor the outer call
// built, and the normal form reads it before the rules run. Conversion is
// definitional equality by computation (Martin-Löf, _Intuitionistic Type
// Theory_, Bibliopolis, 1984).

// The free naturals, the presented integers and their steps `up` and `down`.
import "./circle-base.gandr" ;

/// Doubling the free naturals by structural recursion.
@[ checks ]
def rec doubleNat(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => Succ(Succ(doubleNat[<](p)))
  }
}

/// Doubling twice: the outer call's case waits on the inner call, which
/// conversion unfolds in turn.
@[ checks ]
def quadrupled : Path(
  Nat,
  doubleNat(doubleNat(Succ(Zero))),
  Succ(Succ(Succ(Succ(Zero))))
) = here(Succ(Succ(Succ(Succ(Zero))))) ;

/// The nested call's value is four, not three.
@[ refuses("EndpointMismatch") ]
def miscounted : Path(
  Nat,
  doubleNat(doubleNat(Succ(Zero))),
  Succ(Succ(Succ(Zero)))
) = here(Succ(Succ(Succ(Zero)))) ;

/// `up(down(Z))` is `S` over the held call `down(Z)`; read, that call is
/// `P(Z)`, and `S(P(Z))` rewrites to `Z`.
@[ checks ]
def turned_back : Path(Int, up(down(Z)), Z) = here(Z) ;

/// The same law at every integer: the inner call's argument is a variable,
/// and the rule cancels around it.
@[ checks ]
def turn_unturn(n : Int) -> -F Path(Int, up(down(n)), n) {
  here(n)
}

/// Reading the inner call cancels a step; it does not add one.
@[ refuses("EndpointMismatch") ]
def overturned : Path(Int, up(down(Z)), S(Z)) = here(S(Z)) ;
