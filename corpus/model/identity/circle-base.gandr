/// This source supplies the identity subject's shared circle declarations.
///
/// The declarations provide the circle, its loop words, and their integer model.
///
/// Each subject source imports these declarations to state its own law.
/// The checker evaluates their rules and path operations.
///
/// - see: corpus/model/identity/circle.gandr

/// The type with no element.
pub data Empty : Type where {}

/// The circle has a point and a loop at that point.
pub data Circle : Type where
  | Base : Circle
  | loop : Base <-> Base

/// The integer rules cancel each successor with a predecessor.
@[ normalizes("S(S(P(P(S(Z))))) ~> S(Z)") ]
pub data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) <=> x;
  rule : P (S x) <=> x;
}

/// The `up` function adds one successor.
pub def up(n : Int) -> Int =
  S n

/// The `down` function adds one predecessor.
pub def down(n : Int) -> Int =
  P n

/// Every natural constructor term is its own value.
pub data Nat : Type where
  | Zero : Nat
  | Succ : (n : Nat) --> Nat

/// The `wind` function counts loop and inverse letters.
pub def rec wind(p : Path[.A = Circle](Base, Base)) -> Int =
  match p
    | here => Z
    | loop ∷ q => S (wind[<] q)
    | back(loop) ∷ q => P (wind[<] q)

/// The `spin` function maps each integer step to its loop letter.
pub def rec spin(n : Int) -> Path[.A = Circle](Base, Base) =
  match n
    | Z => Path.here Base
    | S(x) => loop ∷ spin[<] x
    | P(x) => back loop ∷ spin[<] x

/// The `loopOn` function prepends a loop to a path word.
pub def loopOn(p : Path[.A = Circle](Base, Base)) -> Path[.A = Circle](Base, Base) =
  loop ∷ p

/// The `unloopOn` function prepends an inverse loop to a path word.
pub def unloopOn(p : Path[.A = Circle](Base, Base)) -> Path[.A = Circle](Base, Base) =
  back loop ∷ p

/// The `sect` induction makes `spin(wind p)` equal `p` under word cancellation.
pub def rec sect(p : Path[.A = Circle](Base, Base)) -> Path[.A = Path[.A = Circle](Base, Base)](
  spin (wind p),
  p
) =
  match p
    | here => Path.here (Path.here Base)
    | loop ∷ q => Path.ap loopOn (sect[<] q)
    | back(loop) ∷ q => Path.ap unloopOn (sect[<] q)

/// The `retr` induction makes `wind(spin n)` equal `n`.
pub def rec retr(n : Int) -> Path[.A = Int](wind (spin n), n) =
  match n
    | Z => Path.here Z
    | S(x) => Path.ap up (retr[<] x)
    | P(x) => Path.ap down (retr[<] x)

/// Conjugation carries the self loop at every circle point.
pub def selfloop(x : Circle) -> Path[.A = Circle](x, x) =
  match x
    | Base => loop

/// Conjugation fixes reflexivity at every circle point.
pub def selfrefl(x : Circle) -> Path[.A = Circle](x, x) =
  match x
    | Base => Path.here Base

/// The flip fixes the point and inverts the loop.
pub def invLooper(x : Circle) -> Circle =
  match x
    | Base => Base
    | loop => Path.back loop

/// Multiplication uses the first circle argument to rotate the second.
pub def mul(a : Circle, b : Circle) -> Circle =
  match a
    | Base => b
    | loop => selfloop b
