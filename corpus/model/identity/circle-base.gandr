//! The identity subject's shared declarations, written once and imported by
//! every source that reads them (`import "./circle-base.gandr";`): the empty
//! type, the circle, the presented integers and the free naturals, the
//! winding number and spinning with their round trips (the book's § 8.1), and
//! the maps out of the circle the circle sources state their laws over, after
//! cubical Agda's `Cubical/HITs/S1/Base.agda`. `circle.gandr` states the
//! equivalence `winding` the round trips make and what it computes; this
//! source states only what the others read.

/// The type with no element.
data Empty : Type {}

/// The circle: one point and a loop at it, bound as `loop : Path(Circle,
/// Base, Base)`.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// The integers as a presented type: a successor and a predecessor that
/// cancel. Their critical pairs join, so a word normalizes to the successors
/// or predecessors it counts.
@[ normalizes("S(S(P(P(S(Z))))) ~> S(Z)") ]
data Int : Type {
  Z : Int;
  S : (x : Int) --> Int;
  P : (x : Int) --> Int;
  rule S(P(x)) <=> x;
  rule P(S(x)) <=> x;
}

/// One successor more.
def up(n : Int) -> Int {
  S(n)
}

/// One predecessor more.
def down(n : Int) -> Int {
  P(n)
}

/// The natural numbers, free: every constructor term is its own value.
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

/// The winding number (cubical's `winding`): a loop counts one up, its
/// inverse one down. It respects the cancellations by `Int`'s rules.
def rec wind(p : Path(Circle, Base, Base)) -> Int {
  case p {
    here => Z,
    loop ∷ q => S(wind[<](q)),
    back(loop) ∷ q => P(wind[<](q))
  }
}

/// Spinning a count (cubical's `intLoop`): a successor is one more loop, a
/// predecessor one more inverse. It respects `Int`'s rules by the
/// cancellations.
def rec spin(n : Int) -> Path(Circle, Base, Base) {
  case n {
    Z => here(Base),
    S(x) => loop ∷ spin[<](x),
    P(x) => back(loop) ∷ spin[<](x)
  }
}

/// One loop more: the cons a path between words is carried along.
def loopOn(p : Path(Circle, Base, Base)) -> Path(Circle, Base, Base) {
  loop ∷ p
}

/// One inverse loop more.
def unloopOn(p : Path(Circle, Base, Base)) -> Path(Circle, Base, Base) {
  back(loop) ∷ p
}

/// Spinning undoes winding at every loop (cubical's `decodeEncode` at the
/// point): the round trip at a variable, by induction over the words. The
/// result type reads the word the fold descends on, so each arm answers it at
/// its letter and the recursive call at the rest: `sect[<](q)` relates
/// `spin(wind(q))` to `q`, and carried along `loopOn` it relates `loop ∷
/// spin(wind(q))`, which `spin(wind(loop ∷ q))` runs to, to `loop ∷ q`. The
/// case respects the cancellations: at `loop ∷ back(loop) ∷ q` the arms
/// compose to `cong(loopOn, cong(unloopOn, p))`, whose functions compose to
/// the identity under the words' rules, so the chain is `p` itself, the
/// answer at `q`.
def rec sect(p : Path(Circle, Base, Base)) -> Path(Path(Circle, Base, Base), spin(wind(p)), p) {
  case p {
    here => here(here(Base)),
    loop ∷ q => cong(loopOn, sect[<](q)),
    back(loop) ∷ q => cong(unloopOn, sect[<](q))
  }
}

/// Winding undoes spinning at every count (cubical's `windingIntLoop`), by
/// induction over the presented integers, a successor carried along `up` and
/// a predecessor along `down`.
def rec retr(n : Int) -> Path(Int, wind(spin(n)), n) {
  case n {
    Z => here(Z),
    S(x) => cong(up, retr[<](x)),
    P(x) => cong(down, retr[<](x))
  }
}

/// Every point's loop (cubical's `rotLoop`; the book's Lemma 6.4.2 element):
/// the loop at the point, carried along the loop by conjugation to itself.
def selfloop(x : Circle) -> Path(Circle, x, x) {
  case x {
    Base => loop
  }
}

/// Every point's reflexivity, which conjugation fixes as well.
def selfrefl(x : Circle) -> Path(Circle, x, x) {
  case x {
    Base => here(Base)
  }
}

/// The circle's flip (cubical's `invLooper`): the point to itself and the
/// loop to its inverse, the loop arm choosing the image.
def invLooper(x : Circle) -> Circle {
  case x {
    Base => Base,
    loop => back(loop)
  }
}

/// The circle's multiplication (cubical's `_·_`, the book's § 8.5.2 μ): the
/// point is the unit, and the loop rotates the other argument by its own
/// loop.
def mul(a : Circle, b : Circle) -> Circle {
  case a {
    Base => b,
    loop => selfloop(b)
  }
}
