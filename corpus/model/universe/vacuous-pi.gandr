//! A dependent arrow whose codomain ignores its binder is the plain arrow . A
//! family applied at its binder is a dependent codomain until the family is
//! read; a family that reads to one type at every argument makes the function
//! type over it the arrow to that type, in both directions
//! [MartinLof-1984-intuitionistic_type_theory].
//!
//! - see: #577 — `viaArrow`
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

// The naturals.
import "../data/data-base.gandr";

/// The constant family: the naturals at every natural.
@[ checks, form(explicit) ]
def always(n : Nat) -> -F Type { return Nat }

/// The identity over the constant family, at a dependent arrow whose codomain
/// is the family applied at its binder.
@[ checks ]
def idAlways(x : Nat) -> -F always(x) { return x }

/// The same function at the plain arrow: `always(x)` reads to `Nat`, which
/// ignores `x`, so the dependent arrow is the arrow to `Nat`.
@[ checks ]
def viaArrow : +U (Nat -> -F Nat);
def viaArrow = idAlways;

/// And back: the plain arrow stands where the dependent arrow is expected.
@[ checks ]
def viaFamily : +U ((x : Nat) -> -F always(x));
def viaFamily = viaArrow;

/// The function read at the plain arrow applies there.
@[ runs("Succ Zero") ]
def appliedArrow() -> -F Nat { viaArrow (Succ Zero) }
