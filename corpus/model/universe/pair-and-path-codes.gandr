// A Tarski universe closed under pairs and dependent pairs.
//
// Martin-Löf's universe is closed under dependent functions, dependent pairs
// and identity types. Each such code decodes to a family at the decodes of
// its fields. A decode thus stands as a family's argument, a call in place.
// The call is the type it returns.
//
// Each code is its own block. The pair code decodes to the pairs of its two
// decodes. The dependent pair code decodes to the pairs over its first
// decode. Its second field is a family of codes over that decode. The
// decoder's binder takes the same decode, so the two convert.
//
// - see: `pathological/universe/pair-and-path-codes.gandr` — a run for the
//   first decode, and the path code, refused
// - see: `model/universe/inductive-recursive.gandr` — the dependent
//   functions, admitted
// - see: Martin-Löf, _Intuitionistic Type Theory_, Bibliopolis, 1984

// The naturals.
import "../data/data-base.gandr";

// The dependent pairs.
import "ir-codes.gandr";

// The pairs of two types.
import "fresh-lists.gandr";

/// The codes: the naturals and the pairs of two coded types.
@[ checks, form(explicit) ]
data UProd : Type {
  /// The naturals.
  NatX : UProd;
  /// The pairs of two coded types.
  ProdX : (a : UProd, b : UProd) --> UProd;
}

/// The decoder, with a pair code's two decodes as calls.
@[ checks ]
def rec elProd(u : UProd) -> -F Type {
  case u {
    NatX => return Nat,
    ProdX(a, b) => return (Both(elProd[<](a), elProd[<](b)))
  }
}

/// The dependent pair code and its decoder, in one block.
rec {
  /// The codes: the naturals, and the dependent pairs over a coded type.
  @[ checks ]
  data USig : Type {
    /// The naturals.
    NatS : USig;
    /// The dependent pairs from a coded type to a family of codes over its
    /// decode.
    SigS : (a : USig, b : +U (elSig(a) -> -F USig)) --> USig;
  }

  /// The decoder: a pair code decodes to the pairs over its first decode.
  /// The quoted first decode converts with the decode the second field's
  /// binder takes.
  @[ checks ]
  def rec elSig(u : USig) -> -F Type {
    case u {
      NatS => return Nat,
      SigS(a, b) => return (Sig(elSig[<](a), thunk { fn (x) { elSig[<](b(x)) } }))
    }
  }
}
