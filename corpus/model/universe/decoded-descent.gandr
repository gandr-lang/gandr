//! This fixture defines an inductive-recursive universe.
//!
//! Each code has a decoded value type.
//!
//! Recursive functions descend through codes and values.
//!
//! - see: `pathological/universe/decoded-descent.gandr`

import "../data/data-base.gandr";

rec {
  @[ checks, form(explicit) ]
  pub data UL : Type where {
    | NatL : UL
    | ListL : (a : UL) --> UL
    | PiL : (a : UL, b : +U (elL(a) -> -F UL)) --> UL
  }

  @[ checks ]
  pub def rec elL(u : UL) -> -F Type =
    match u where
      | NatL => return Nat
      | ListL(a) => {
        let e = elL[<] a;
        return (List e)
      }
      | PiL(a, b) => return (+U ((x : elL[<](a)) -> -F elL[<](b(x))))
}

def rec sumAt(a : UL, f : +U (elL(a) -> -F Nat), v : List(elL(a))) -> Nat =
  match v where
    | Nil => Zero
    | Cons(h, t) => plus (f h) (sumAt[<] a f t)

def rec total(c : UL) -> +U (elL(c) -> -F Nat) =
  match c where
    | NatL => thunk { fun (v) { v } }
    | ListL(a) => thunk { fun (v) { sumAt a (total[<] a) v } }
    | PiL(a, b) => thunk { fun (f) { Zero } }

@[ checks ]
def rec countBeside(c : UL, v : elL(c)) -> Nat =
  match c where
    | NatL => v
    | ListL(a) => Zero
    | PiL(a, b) => Zero

def lists : List(List(Nat));
def lists = Cons (Cons (Succ Zero) Nil) (Cons (Cons two Nil) Nil);

@[ runs("Succ (Succ (Succ Zero))") ]
def summed() -> Nat =
  let sum = total (ListL (ListL NatL))
  sum lists
