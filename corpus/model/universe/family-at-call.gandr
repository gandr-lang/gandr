//! A family applied at a call's result converts with itself. A type that reads
//! a call's value runs the call first and binds it, so `tm(extend(g))` is `c ←
//! extend(g); tm(c)`; a dependent arrow instantiated at the call `extend(g)`
//! binds it ahead of each code that reads the binder, so the type it yields is
//! written the same way. The shape is a category with families: operations over
//! context extension, laws that apply one operation to another's result
//! [Dybjer-1996-internal_type_theory]. The same law stated as a record's field
//! reads the record's family field by its label in every type it prints. A
//! record holding the family and an operation into it checks the operation at
//! the family it holds , and its operation's type prints as the arrow the
//! family's argument drops.
//!
//! - see: #720 — `useAtExtension`
//! - see: #728 — `fieldAt`
//! - see: #721 — `familyRecord`
//! - see: #736 — `familyRecord`
//! - see: #2751 — `appliedWrittenOut`
//! - cites: [Dybjer-1996-internal_type_theory]
//!
//! [Dybjer-1996-internal_type_theory]: https://doi.org/10.1007/3-540-61780-9_66 "Dybjer, Internal Type Theory"

/// A family applied to an operation's result, met at one argument: `q(g)` is
/// at `tm(extend(g))`, which is `use`'s second domain at `extend(g)`.
@[ checks, form(explicit) ]
def useAtExtension(
  con : Type,
  tm : +U (con -> -F Type),
  extend : +U ((g : con) -> -F con),
  q : +U ((g : con) -> -F tm(extend(g))),
  use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
  g : con
) -> -F Unit =
  use (extend g) (q g)

/// The same with the family applied to a variable, which needs no call bound
/// ahead of it.
@[ checks ]
def useAtVariable(
  con : Type,
  tm : +U (con -> -F Type),
  q : +U ((g : con) -> -F tm(g)),
  use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
  g : con
) -> -F Unit =
  use g (q g)

/// The law of the first stated as a record's field: each later field's type
/// reads the family field, and the types printed at `use` and `q` in the law
/// name it by its label.
@[ checks ]
def fieldAt(
  m : *{
    con : Type,
    tm : +U (con -> -F Type),
    extend : +U ((g : con) -> -F con),
    q : +U ((g : con) -> -F tm(extend(g))),
    use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
    law : +U ((g : con) -> -F Path[.A = Unit](use (extend g) (q g), *{}))
  }
) -> -F Unit =
  return *{}

/// A record holding a family and an operation into it: the operation's field
/// is at the family applied to its argument, which the check reads through
/// the family the record holds before it reads `unit` against it; the
/// family drops its argument, so the field prints as `Unit => Unit`.
@[ checks ]
def familyRecord : *{con : Type, tm : +U (con -> -F Type), f : +U ((g : con) -> -F tm(g))};
def familyRecord = *{Unit, *{thunk { fun (g) { return Unit } }, thunk { fun (g) { return *{} } }}};

/// A family applied through a definition: `appliedVia(post, x)` unfolds to
/// `post(x)`.
def appliedVia(post : +U (Unit -> -F Type), x : Unit) -> Type { post x }

/// The application written out stands where the definition's is asked, and
/// the definition's where the written one is: a definition that unfolds to a
/// variable's call converts with the call.
@[ checks ]
def appliedWrittenOut(post : +U (Unit -> -F Type), x : Unit, h : post(x)) -> appliedVia(post, x) =
  h

/// The other way round.
@[ checks ]
def appliedFolded(post : +U (Unit -> -F Type), x : Unit, h : appliedVia(post, x)) -> post(x) { h }
