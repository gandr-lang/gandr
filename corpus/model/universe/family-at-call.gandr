//! This fixture applies a family to an operation result.
//!
//! The shape is a category with families. A dependent arrow instantiates after
//! the operation runs.
//!
//! The arrow yields a type with the same written form. So the family at the
//! result of a call converts with itself. A record field reads its preceding
//! family field.
//!
//! - cites: [Dybjer-1996-internal_type_theory]
//!
//! [Dybjer-1996-internal_type_theory]: https://doi.org/10.1007/3-540-61780-9_66 "Dybjer, Internal Type Theory"

/// The `useAtExtension` function applies a family to the result of an
/// operation. The term `q(g)` stands at `tm(extend(g))`, the second domain of
/// `use` at `extend(g)`.
@[checks, form(explicit)]
def useAtExtension(
  con : Type,
  tm : +U (con -> -F Type),
  extend : +U ((g : con) -> -F con),
  q : +U ((g : con) -> -F tm(extend(g))),
  use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
  g : con
) -> -F Unit =
  use (extend g) (q g)

/// The `useAtVariable` function applies the family to a variable. It needs no
/// call before it.
@[checks]
def useAtVariable(
  con : Type,
  tm : +U (con -> -F Type),
  q : +U ((g : con) -> -F tm(g)),
  use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
  g : con
) -> -F Unit =
  use g (q g)

/// The `fieldAt` function states the law of `useAtExtension` as a record field.
/// Each later field type reads the family field by its label.
@[checks]
def fieldAt(
  m : *{
    con : Type,
    tm : +U (con -> -F Type),
    extend : +U ((g : con) -> -F con),
    q : +U ((g : con) -> -F tm(extend(g))),
    use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
    law : +U ((g : con) -> -F Path[.A = Unit](use (extend g) (q g), *{}))
  }
) -> -F Unit =
  return *{}

/// The `familyRecord` value holds a family and an operation into it. The
/// constant family gives the operation field the type `Unit => Unit`.
@[checks]
def familyRecord : *{con : Type, tm : +U (con -> -F Type), f : +U ((g : con) -> -F tm(g))};
def familyRecord = *{Unit, *{thunk { fun (g) { return Unit } }, thunk { fun (g) { return *{} } }}};

/// The `appliedVia` function applies a family through a definition. The call
/// `appliedVia(post, x)` unfolds to `post(x)`.
def appliedVia(post : +U (Unit -> -F Type), x : Unit) -> Type { post x }

/// The `appliedWrittenOut` function returns `post(x)` at the type
/// `appliedVia(post, x)`. The unfolded definition converts with the call of the
/// variable.
@[checks]
def appliedWrittenOut(post : +U (Unit -> -F Type), x : Unit, h : post(x)) -> appliedVia(post, x) =
  h

/// The `appliedFolded` function converts in the other direction. It returns
/// `appliedVia(post, x)` at the type `post(x)`.
@[checks]
def appliedFolded(post : +U (Unit -> -F Type), x : Unit, h : appliedVia(post, x)) -> post(x) { h }
