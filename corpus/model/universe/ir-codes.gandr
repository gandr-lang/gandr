//! This fixture defines inductive-recursive codes.
//!
//! Each code describes a family and its decoder.
//!
//! The `args` function reads the arguments that a code requests.
//!
//! - cites: [Dybjer-1999-finite_axiomatization_inductiverecursive_definitions]
//!
//! [Dybjer-1999-finite_axiomatization_inductiverecursive_definitions]: https://doi.org/10.1007/3-540-48959-2_11 "Dybjer and Setzer, A finite axiomatization of inductive-recursive definitions"

/// The dependent pairs over a family of types, as data.
@[ checks, form(explicit) ]
pub data Sig(a : Type, b : +U (a -> -F Type)) : Type where
  /// A value of the first type with a value of the type it picks.
  | MkSig : (x : a, y : b(x)) --> Sig(a, b)

/// The codes over a type of decodes `d`, a large type.
@[ checks ]
pub data IR(d : Type) : Type[+, 1] where
  /// No argument, the decode `e`.
  | Iota : (e : d) --> IR(d)
  /// A value of the type `a`, and the code the rest reads it by.
  | SigmaC : (a : Type, f : +U (a -> -F IR(d))) --> IR(d)
  /// A function from `a` into the family. The rest reads it through its
  /// decodes.
  | DeltaC : (a : Type, f : +U (+U (a -> -F d) -> -F IR(d))) --> IR(d)

/// The arguments a code asks for over a family `x`. The function `t` decodes
/// the family.
@[ checks ]
pub def rec args(d : Type, c : IR(d), x : Type, t : +U (x -> -F d)) -> -F Type =
  match c where
    | Iota(e) => return Unit
    | SigmaC(a, f) => return (Sig a (thunk { fun (y) { args[<] d (f y) x t } }))
    | DeltaC(a, f) => return (Sig (+U (a -> -F x)) (thunk {
      fun (h) { args[<] d (f (thunk { fun (z) { t (h z) } })) x t }
    }))

/// The arguments a code asks for, over core's dependent pairs. The delta arm
/// decodes its function in the type of the rest, inside the descent.
///
/// - see: #5291 — a run in a lambda that a descent in a type takes
@[ checks ]
pub def rec sigmaArgs(d : Type, c : IR(d), x : Type, t : +U (x -> -F d)) -> -F Type =
  match c where
    | Iota(e) => return Unit
    | SigmaC(a, f) => return type(*{y : a, r : sigmaArgs[<](d, f(y), x, t)})
    | DeltaC(a, f) => return type(*{
      h : +U (a -> -F x),
      r : sigmaArgs[<](d, f(fun (z) { t (h z) }), x, t)
    })

/// Accepts the arguments of any code.
@[ checks ]
pub def keep(d : Type, c : IR(d), x : Type, t : +U (x -> -F d), w : args(d, c, x, t)) -> Unit =
  return *{}

/// Opens the arguments of a sigma code. The rest has the arguments of the
/// code that the first field picks.
@[ checks ]
pub def rest(
  d : Type,
  a : Type,
  f : +U (a -> -F IR(d)),
  x : Type,
  t : +U (x -> -F d),
  v : args(d, (SigmaC(a, f) : IR(d)), x, t)
) -> Unit =
  match v where
    | MkSig(y, r) => keep d (f y) x t r

/// Opens the arguments of a delta code. The rest has the arguments of the
/// code that the first field's decodes pick.
@[ checks ]
pub def restDelta(
  d : Type,
  a : Type,
  f : +U (+U (a -> -F d) -> -F IR(d)),
  x : Type,
  t : +U (x -> -F d),
  v : args(d, (DeltaC(a, f) : IR(d)), x, t)
) -> Unit =
  match v where
    | MkSig(h, r) => keep d (f (thunk { fun (z) { t (h z) } })) x t r
