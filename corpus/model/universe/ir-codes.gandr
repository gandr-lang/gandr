// Dybjer and Setzer's codes for inductive-recursive definitions, as data. A
// function gives the arguments each code asks for.
//
// A code describes a family and its decoder at once. A code asks for a
// value of a type, for values of the family, or for a stop. The values of
// the family come through their decodes. A stop names one decode. A
// function computes the type of these arguments from the code. A family and
// its decoder thus follow from the code alone.
//
// The codes are a large type. A field of a code holds a type. The pairs are
// data. The function `args` returns them as terms. It recurses on the code.
// The delta arm asks for a function into the family. The rest of the code
// reads that function through the decoder `t`.
//
// - see: #3575 — not implemented: the family a code defines, with its decoder
// - see: `pathological/universe/ir-codes.gandr` — the family a code defines,
//   its decoder, and the decode of its arguments, refused
// - see: Dybjer and Setzer, _A finite axiomatization of inductive-recursive
//   definitions_, TLCA 1999, doi:10.1007/3-540-48959-2_11

/// The dependent pairs over a family of types, as data.
@[ checks, form(explicit) ]
pub data Sig(a : Type, b : +U (a -> -F Type)) : Type {
  /// A value of the first type with a value of the type it picks.
  MkSig : (x : a, y : b(x)) --> Sig(a, b);
}

/// The codes over a type of decodes `d`, a large type.
@[ checks ]
pub data IR(d : Type) : Type[+, 1] {
  /// No argument, the decode `e`.
  Iota : (e : d) --> IR(d);
  /// A value of the type `a`, and the code the rest reads it by.
  SigmaC : (a : Type, f : +U (a -> -F IR(d))) --> IR(d);
  /// A function from `a` into the family. The rest reads it through its
  /// decodes.
  DeltaC : (a : Type, f : +U (+U (a -> -F d) -> -F IR(d))) --> IR(d);
}

/// The arguments a code asks for over a family `x`. The function `t` decodes
/// the family.
@[ checks ]
pub def rec args(d : Type, c : IR(d), x : Type, t : +U (x -> -F d)) -> -F Type {
  case c {
    Iota(e) => return Unit,
    SigmaC(a, f) => return (Sig(a, thunk { fn (y) { args[<](d, f(y), x, t) } })),
    DeltaC(a, f) => return (Sig(
      +U (a -> -F x),
      thunk { fn (h) { args[<](d, f(thunk { fn (z) { t(h(z)) } }), x, t) } }
    ))
  }
}

/// Accepts the arguments of any code.
@[ checks ]
pub def keep(d : Type, c : IR(d), x : Type, t : +U (x -> -F d), w : args(d, c, x, t)) -> Unit {
  return unit
}

/// Opens the arguments of a sigma code. The rest has the arguments of the
/// code that the first field picks.
@[ checks ]
pub def rest(
  d : Type,
  a : Type,
  f : +U (a -> -F IR(d)),
  x : Type,
  t : +U (x -> -F d),
  v : args(d, (SigmaC(a, f) : IR(d)), x, t)
) -> Unit {
  case v {
    MkSig(y, r) => keep(d, f(y), x, t, r)
  }
}
