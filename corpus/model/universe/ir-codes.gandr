//! Dybjer and Setzer's signatures for inductive-recursive definitions, with
//! the family a signature defines and its decoder, read through `std.ir`.
//!
//! A signature describes a family and its decoder at once. It asks for a
//! value of a type, for values of the family, or for a stop. The values of
//! the family come through their decodes. A stop names one decode. A
//! function computes the type of these arguments from the signature. A
//! family and its decoder thus follow from the signature alone.
//!
//! The signatures are a large type. A field of a signature holds a type. The
//! pairs are data, and `args` returns them as terms by recursion on the
//! signature. The family a signature defines is `IR(d, c)`, and its decoder
//! is `el(d, c, m)`. Its one constructor `Intro` holds the arguments the
//! signature asks for over the family itself. The pathological twin's `Mu`
//! and `decodeMu` write the same pair as ordinary source, and stay refused.
//!
//! - owes: #5160 — the eliminator of the family, with its computation rule
//! - see: `pathological/universe/ir-codes.gandr` — the family a code defines
//!   and its decoder, refused, over the decode of its arguments
//! - cites: [Dybjer-1999-finite_axiomatization_inductiverecursive_definitions]
//!
//! [Dybjer-1999-finite_axiomatization_inductiverecursive_definitions]: https://doi.org/10.1007/3-540-48959-2_11 "Dybjer and Setzer, A finite axiomatization of inductive-recursive definitions"

// The signatures, their arguments, the family a signature defines and its
// decoder.
import std.ir (DPair, MkDPair, Sig, Iota, SigmaC, DeltaC, args, decodeArgs, IR, Intro, el);

/// Accepts the arguments of any signature.
@[ checks ]
pub def keep(d : Type, c : Sig(d), x : Type, t : +U (x -> -F d), w : args(d, c, x, t)) -> Unit =
  return *{}

/// Opens the arguments of a sigma signature. The rest has the arguments of
/// the signature that the first field picks.
@[ checks ]
pub def rest(
  d : Type,
  a : Type,
  f : +U (a -> -F Sig(d)),
  x : Type,
  t : +U (x -> -F d),
  v : args(d, (SigmaC(a, f) : Sig(d)), x, t)
) -> Unit =
  match v
    | MkDPair(y, r) => keep d (f y) x t r

/// Opens the arguments of a delta signature. The rest has the arguments of
/// the signature that the first field's decodes pick.
@[ checks ]
pub def restDelta(
  d : Type,
  a : Type,
  f : +U (+U (a -> -F d) -> -F Sig(d)),
  x : Type,
  t : +U (x -> -F d),
  v : args(d, (DeltaC(a, f) : Sig(d)), x, t)
) -> Unit =
  match v
    | MkDPair(h, r) => keep d (f (thunk { fun (z) { t (h z) } })) x t r

/// The decode of a value of the family: the pathological twin's `decodeMu`
/// as `el(m)`.
@[ checks ]
pub def decoded(d : Type, c : Sig(d), m : IR(d, c)) -> -F d =
  el d c m

/// The decode of a value built from the arguments its signature asks for
/// over the family: the pathological twin's `In` as `Intro`.
@[ checks ]
pub def decodedIntro(
  d : Type,
  c : Sig(d),
  x : args(d, c, IR(d, c), thunk { fun (m) { el d c m } })
) -> -F d =
  el d c (Intro x)

/// The decode of those arguments by `decodeArgs`, which `el` runs at an
/// `Intro`.
@[ checks ]
pub def decodedArgs(
  d : Type,
  c : Sig(d),
  x : args(d, c, IR(d, c), thunk { fun (m) { el d c m } })
) -> -F d =
  decodeArgs d c (IR d c) (thunk { fun (n) { el d c n } }) x
