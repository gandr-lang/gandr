/// The default build stage: a package's `gandr.toml` body, rendered by a gandr function from its model's fields and modules.
///
/// A package's own build stage is to write its manifest, the checker's fixed rule its default. Before the checker can run a stage, this source shows the default spelled in gandr: each run is the body of a manifest the tree commits.
///
/// `body` reads the name, the version and the module list, and writes the `[package]` table as the checker does. The checker keeps the header and its BLAKE3 digest, which only it computes. A name holding a quote is not escaped here: that needs the characters of a string.
///
/// - see: #2764
/// - see: #2997
/// - see: #2998
/// - see: `corpus/model/projects/hello/gandr.toml`
/// - see: `corpus/model/projects/tools/gandr.toml`
/// - see: `library/std/gandr.toml`

// The lists.
import "../data/data-base.gandr";

/// Each module of a list, quoted on a line of its own, each line indented and ended by a comma.
def rec lines(modules : List(String)) -> String {
  case modules {
    Nil => "",
    Cons(path, rest) => {
      run more <- lines[<](rest);
      "  \"${ path }\",\n${ more }"
    }
  }
}

/// The `modules` array: `[]` when the list is empty, else one line per module between the brackets.
def listed(modules : List(String)) -> String {
  case modules {
    Nil => "[]",
    Cons(_, _) => {
      run each <- lines(modules);
      "[\n${ each }]"
    }
  }
}

/// A manifest's body: the `[package]` table with the name, the version and the modules.
def body(name : String, version : String, modules : List(String)) -> String {
  run array <- listed(modules);
  "\n[package]\nname = \"${ name }\"\nversion = \"${ version }\"\nmodules = ${ array }\n"
}

/// The body `corpus/model/projects/hello/gandr.toml` commits, with its one module.
@[ runs("\"\\n[package]\\nname = \\\"hello\\\"\\nversion = \\\"0.1.0\\\"\\nmodules = [\\n  \\\"text.greet\\\",\\n]\\n\"") ]
def hello() -> String { body("hello", "0.1.0", (Cons("text.greet", Nil) : List(String))) }

/// The body `corpus/model/projects/tools/gandr.toml` commits, with no modules.
@[ runs("\"\\n[package]\\nname = \\\"tools\\\"\\nversion = \\\"0.1.0\\\"\\nmodules = []\\n\"") ]
def tools() -> String { body("tools", "0.1.0", (Nil : List(String))) }

/// The body `library/std/gandr.toml` commits, the tree's own package.
@[ runs("\"\\n[package]\\nname = \\\"std\\\"\\nversion = \\\"0.1.0\\\"\\nmodules = [\\n  \\\"package\\\",\\n]\\n\"") ]
def std() -> String { body("std", "0.1.0", (Cons("package", Nil) : List(String))) }
