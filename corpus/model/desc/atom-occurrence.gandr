// An atom named inside the abstraction that binds it, read by its depth below
// its binder.
//
// Admission re-mints an atom with its binder, so a rule naming the channel
// its restriction abstracts is one rule whatever the atom is called. A rule
// stating a freshness condition fires only where its instance names no atom
// it may not.
//
// Matching, the critical pairs and the kernel's replay count the abstractions
// between an occurrence and its binder. A rule's variable is a hole over the
// atoms it may name, so the check decides an overlap under the condition it
// composes. Each theory below normalizes one process its rules meet.
//
// - see: #1934 — not implemented: a rule matching a variable both under an
//   abstraction and beside it
// - see: `pathological/desc/atom-occurrence.gandr` — that rule, refused
// - see: Fernández and Gabbay, _Nominal rewriting_, I&C 2007, § 2
// - see: Pitts, _Nominal Sets_, CUP 2013, § 4
// - see: Milner, _Communicating and Mobile Systems: the π-Calculus_, CUP 1999
// - see: Mayr and Nipkow, _Higher-order rewrite systems and their
//   confluence_, TCS 1998
// - see: Miller, _A logic programming language with lambda-abstraction,
//   function variables, and simple unification_, JLC 1991

/// A send on a restricted channel, which no process outside the restriction
/// can receive: the process never moves, so it is the inert one. The checker
/// orients the law and the kernel replays the verdict; a restriction naming
/// its channel `b` normalizes by the law written over `a`.
@[ normalizes("nu(bind b . out(b, nil)) ~> nil") ]
theory Unheard {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule unheard : nu(bind a. out(a, p)) ==> nil();
}

/// The law below a second restriction, sending on the outer channel. The
/// occurrence's depth differs from the law's, so the law does not apply.
@[ normalizes("nu(bind a . nu(bind b . out(a, nil))) ~> nu(bind a0 . nu(bind a1 . out(a0, nil)))") ]
theory Overheard {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule unheard : nu(bind a. out(a, p)) ==> nil();
}

/// An inner restriction of the outer one's name shadows it. The channel sent
/// on is the inner one, and the law applies below the outer restriction.
@[ normalizes("nu(bind a . nu(bind a . out(a, nil))) ~> nu(bind a0 . nil)") ]
theory Shadowed {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule unheard : nu(bind a. out(a, p)) ==> nil();
}

/// Scope extrusion where `out` takes a channel, `q` moved under the
/// restriction stated fresh for it. Each channel `q` names counts one
/// abstraction further.
@[ normalizes("nu(bind c . par(nu(bind b . out(b, nil)), out(c, nil))) ~> nu(bind a0 . nu(bind a1 . par(out(a1, nil), out(a0, nil))))") ]
theory Extruding {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule scope : par(nu(bind a. p), q) <=> nu(bind a. par(p, q)) where a # q;
}

/// Garbage collection where `out` takes a channel: a restriction whose process
/// names none of its channel is the process. It fires on the inner
/// restriction only.
@[ normalizes("nu(bind c . nu(bind b . out(c, nil))) ~> nu(bind a0 . out(a0, nil))") ]
theory Collected {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule gc : nu(bind a. p) <=> p where a # p;
}

/// Scope extrusion beside garbage collection, whose overlap the check decides
/// as a higher-order critical pair. Each variable is a pattern over the
/// channels it may name, and both rewrites of the peak meet.
@[ normalizes("nu(bind c . par(nu(bind b . nil), out(c, nil))) ~> nu(bind a0 . par(nil, out(a0, nil)))") ]
theory Collecting {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule scope : par(nu(bind a. p), q) <=> nu(bind a. par(p, q)) where a # q;
  rule gc : nu(bind a. p) <=> p where a # p;
}

/// Garbage collection beside the law that an inert restriction is `nil`.
/// Their left sides unify, but collection's `p` may not name the sent
/// channel, so no instance overlaps.
@[ normalizes("nu(bind c . nu(bind b . out(b, nil))) ~> nil") ]
theory Quiet {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule gc : nu(bind a. p) <=> p where a # p;
  rule quiet : nu(bind a. out(a, nil())) <=> nil();
}
