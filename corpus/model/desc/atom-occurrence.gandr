//! An occurrence names an atom inside its binding abstraction.
//!
//! The occurrence has a depth below its binder. Admission re-mints each atom
//! with its binder.
//!
//! A rule that names its restricted channel is independent of atom spelling.
//! A freshness condition limits a rule to permitted instances. The kernel
//! counts each binder above an occurrence. The checker uses that count during
//! matching and critical-pair analysis. Each theory normalizes a process where
//! its rules meet.
//!
//! - owes: #1934 — a rule matching a variable both under an
//!   abstraction and beside it
//! - see: `pathological/desc/atom-occurrence.gandr` — that rule, refused
//! - cites: [Fernandez-2007-nominal_rewriting], § 2
//! - cites: [Pitts-2013-nominal_sets_names_symmetry_computer_science], § 4
//! - cites: [Milner-1999-communicating_and_mobile_systems]
//! - cites: [Mayr-1998-higher_order_rewrite_systems_and_their_confluence]
//! - cites: [Miller-1991-a_logic_programming_language_with_lambda_abstraction]
//!
//! [Fernandez-2007-nominal_rewriting]: https://doi.org/10.1016/j.ic.2006.12.002 "Fernández and Gabbay, Nominal rewriting"
//! [Pitts-2013-nominal_sets_names_symmetry_computer_science]: https://doi.org/10.1017/CBO9781139084673 "Pitts, Nominal Sets: Names and Symmetry in Computer Science"
//! [Milner-1999-communicating_and_mobile_systems]: https://openlibrary.org/works/OL7950513W "Milner, Communicating and Mobile Systems: the π-Calculus"
//! [Mayr-1998-higher_order_rewrite_systems_and_their_confluence]: https://doi.org/10.1016/S0304-3975(97)00143-6 "Mayr and Nipkow, Higher-order rewrite systems and their confluence"
//! [Miller-1991-a_logic_programming_language_with_lambda_abstraction]: https://doi.org/10.1093/logcom/1.4.497 "Miller, A Logic Programming Language with Lambda-Abstraction, Function Variables, and Simple Unification"

/// A restricted send has no receiver, and it is inert. The checker orients the
/// law, and the kernel replays the verdict for restrictions named `a` or `b`.
@[ normalizes("nu(bind b . out(b, nil)) ~> nil") ]
theory Unheard where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule unheard : nu (bind a. (out a p)) ==> nil ();

/// This send uses the outer channel. Its depth differs from the law depth, so
/// the law does not apply.
@[ normalizes("nu(bind a . nu(bind b . out(a, nil))) ~> nu(bind a0 . nu(bind a1 . out(a0, nil)))") ]
theory Overheard where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule unheard : nu (bind a. (out a p)) ==> nil ();

/// The inner restriction shadows the outer name. The law applies below the
/// outer restriction.
@[ normalizes("nu(bind a . nu(bind a . out(a, nil))) ~> nu(bind a0 . nil)") ]
theory Shadowed where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule unheard : nu (bind a. (out a p)) ==> nil ();

/// Scope extrusion moves `q` under a fresh restriction. Each occurrence of
/// `q` is one abstraction deeper.
@[ normalizes("nu(bind c . par(nu(bind b . out(b, nil)), out(c, nil))) ~> nu(bind a0 . nu(bind a1 . par(out(a1, nil), out(a0, nil))))") ]
theory Extruding where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule scope : par (nu (bind a. p)) q <=> nu (bind a. (par p q)) where { | a # q };

/// Garbage collection removes a restriction when its process omits the channel.
/// This rule applies only to the inner restriction.
@[ normalizes("nu(bind c . nu(bind b . out(c, nil))) ~> nu(bind a0 . out(a0, nil))") ]
theory Collected where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule gc : nu (bind a. p) <=> p where { | a # p };

/// Scope extrusion and garbage collection form a higher-order critical pair.
/// The checker joins both rewrites of the peak.
@[ normalizes("nu(bind c . par(nu(bind b . nil), out(c, nil))) ~> nu(bind a0 . par(nil, out(a0, nil)))") ]
theory Collecting where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule scope : par (nu (bind a. p)) q <=> nu (bind a. (par p q)) where { | a # q };
  rule gc : nu (bind a. p) <=> p where { | a # p };

/// Garbage collection and the inert-restriction law have unifiable left sides.
/// The freshness condition prevents an overlap.
@[ normalizes("nu(bind c . nu(bind b . out(b, nil))) ~> nil") ]
theory Quiet where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule gc : nu (bind a. p) <=> p where { | a # p };
  rule quiet : nu (bind a. (out a (nil ()))) <=> nil ();
