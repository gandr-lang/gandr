//! A constructor can hold a continuation.
//!
//! An `A => T` field is the function former of the description code.
//!
//! The code decodes the field to the thunked arrow of the native reading.
//! State programs form the free model of state. Put-put is a law for a state
//! store.
//!
//! - see: #2511
//! - cites: [Chapman-2010-gentle_art_levitation]
//! - cites: [Plotkin-2002-notions_computation_determine_monads]
//!
//! [Chapman-2010-gentle_art_levitation]: https://doi.org/10.1145/1863543.1863547 "Chapman, Dagand, McBride and Morris, The Gentle Art of Levitation"
//! [Plotkin-2002-notions_computation_determine_monads]: https://doi.org/10.1007/3-540-45931-6_24 "Plotkin and Power, Notions of computation determine monads"

/// A read gives the state to its continuation. A later store replaces an
/// earlier store.
pub data Program : Type where {
  | Done : (x : Integer) --> Program
  | Get : (k : Integer -> Program) --> Program
  | Put : (s : Integer, k : Program) --> Program
  rule : Put s (Put u k) <=> Put u k;
}

/// This handler runs a read continuation at the current state. A store runs
/// the remaining program at its stored state.
def rec final(p : Program, s : Integer) -> Integer =
  match p where
    | Done(x) => x
    | Get(k) => final[<] (k s) s
    | Put(t, k) => final[<] k t

/// Answers the state it reads.
def answered(x : Integer) -> Program { Done x }

/// Two stores, then a read.
def overwritten : Program = Put 1 (Put 2 (Get answered));

/// The read sees the second store. The second store replaces the first store.
@[ runs("2") ]
def readBack : () -> Integer = final overwritten 0;
