// A presented type whose constructor holds a continuation (#2511). A field
// written `A => T` is the description code's function former, the
// higher-order descriptions' `Π` over a type of arguments (Chapman, Dagand,
// McBride and Morris, _The Gentle Art of Levitation_, ICFP 2010,
// doi:10.1145/1863543.1863547). It decodes to the thunked arrow the native
// reading gives the same field, so the type keeps its rule. Programs that read
// and store a state are state's free model, and put-put is the law of state
// a store obeys (Plotkin and Power, _Notions of computation determine
// monads_, 2002, doi:10.1007/3-540-45931-6_24).

/// Programs over an integer state: a read hands the state to its
/// continuation, and a store the next store overwrites is no store.
pub data Program : Type {
  Done : (x : Integer) --> Program;
  Get : (k : Integer => Program) --> Program;
  Put : (s : Integer, k : Program) --> Program;
  rule Put(s, Put(u, k)) <=> Put(u, k);
}

/// The state-passing handler: a read continues at the state it reads, and
/// a store runs the rest from the state it stores. The fold reaches a
/// read's rest by applying its continuation, one stage below the read.
def rec final(p : Program, s : Integer) -> Integer {
  case p {
    Done(x) => x,
    Get(k) => final[<](k(s), s),
    Put(t, k) => final[<](k, t)
  }
}

/// Answers the state it reads.
def answered(x : Integer) -> Program { Done(x) }

/// Two stores, then a read.
def overwritten : Program = Put(1, Put(2, Get(answered)));

/// The read sees the second store: the first is overwritten.
@[ runs("2") ]
def readBack : () => Integer = final(overwritten, 0);
