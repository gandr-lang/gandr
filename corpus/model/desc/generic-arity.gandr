//! A generic program reads a description.
//!
//! A `theory` block is a `Theory` value. An ordinary function reads the value
//! by `case`.
//!
//! A function can return a type quote. The type reader unquotes the result.
//! [Chapman-2010-gentle_art_levitation] describes this method.
//!
//! - see: #729 — `sign`
//! - cites: [Chapman-2010-gentle_art_levitation]
//!
//! [Chapman-2010-gentle_art_levitation]: https://doi.org/10.1145/1863543.1863547 "Chapman, Dagand, McBride and Morris, The Gentle Art of Levitation"

/// The `Monoid` block stores its sort and two operations in a `Theory` value.
pub theory Monoid where
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);

/// This recursion counts `Oper` links in a presentation.
def rec operations(chain : Theory) -> Integer =
  match chain where
    | Oper(name, inputs, outputs, rest) => { let r = operations[<] rest; r + 1 }
    | _ => 0

/// This function gets an operation count from a `Presents` value.
pub def arity(presented : Theory) -> Integer =
  match presented where
    | Presents(sorts, opers, rules) => operations opers
    | _ => 0

/// This generic program counts `mul` and `one` in `Monoid`.
@[ runs("2") ]
def counted() -> Integer { arity Monoid }

/// `sign` is an ordinary source name that runs the generic program.
@[ runs("2") ]
def sign() -> Integer { arity Monoid }

/// This match returns `Integer` or `Unit` as a type quote.
def counted_at(presented : Theory) -> Type =
  match presented where
    | Presents(sorts, opers, rules) => return Integer
    | _ => return Unit

/// `counted_at(Monoid)` reduces to `Integer`, which holds the operation count.
@[ runs("2") ]
def typed() -> counted_at(Monoid) { arity Monoid }

/// A binder keeps `counted_at(presented)` rigid, so its occurrences are one type.
def kept(presented : Theory, n : counted_at(presented)) -> counted_at(presented) =
  n

/// Text does not inhabit `counted_at(Monoid)`.
@[ refuses("TypeMismatch") ]
def text : counted_at(Monoid) = "two";
