//! A rule cell counts each hole in its right side.
//!
//! The count is the hole's Lipschitz constant under one step
//! [Gavazzo-2022-quantitative_metric_rewriting_abstract_nonexpansive_graded_systems].
//!
//! `gandr cells` reports every count. The report does not refuse a count.
//! `mirror` is linear. `left` has count zero. `twice` and `thrice` duplicate
//! their input.
//!
//! - see: #2788
//! - cites: [Gavazzo-2022-quantitative_metric_rewriting_abstract_nonexpansive_graded_systems]
//!
//! [Gavazzo-2022-quantitative_metric_rewriting_abstract_nonexpansive_graded_systems]: https://arxiv.org/abs/2206.13610 "Gavazzo and Di Florio, Quantitative and Metric Rewriting: Abstract, Non-Expansive, and Graded Systems"

/// Binary shrubs have operations with counts from zero to three.
@[ normalizes("thrice(Leaf) ~> Node(Leaf, Node(Leaf, Leaf))") ]
data Shrub : Type where {
  | Leaf : Shrub
  | Node : (l : Shrub, r : Shrub) --> Shrub
  oper mirror : (t : Shrub) --> Shrub;
  oper left : (t : Shrub) --> Shrub;
  oper twice : (t : Shrub) --> Shrub;
  oper thrice : (t : Shrub) --> Shrub;
  rule : mirror Leaf ==> Leaf;
  rule : mirror (Node l r) ==> Node r l;
  rule : left Leaf ==> Leaf;
  rule : left (Node l r) ==> l;
  rule : twice t ==> Node t t;
  rule : thrice t ==> Node t (Node t t);
}

/// A leaf written twice.
@[ runs("Node Leaf Leaf") ]
def twice_leaf() -> Shrub { twice Leaf }
