// Two nominal rules can overlap below an abstraction.
//
// A rule abstraction has one head at each depth.
//
// The checker finds the pair at that depth.
// The kernel finds the same pair.
//
// - see: #1709

/// `inner` and `outer` produce different reducts, and completion derives a
/// rule that joins them.
theory Nested where
  sort Name : Atom;
  sort P : Type;
  oper z : () --> P;
  oper w : () --> P;
  oper nu : (p : bind (a : Name). P) --> P;
  rule inner : nu (bind a. (z ())) ==> w ();
  rule outer : nu (bind a. (nu (bind b. p))) ==> p where { | a # p | b # p };
