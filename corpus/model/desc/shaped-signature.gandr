// A signature stated over a finite shape. The member `boundary Square { … }`
// names the carrier the signature's cells are stated over, one name per point,
// and each `face` member a face a cell may be fixed on, the subshape of the
// names it holds (Schönlank, Nuyts and Devriese, _Towards FaceTT_, TYPES 2026:
// the shape parameter `ft` and its subshapes). The points run in name order.
// The block's value codes the shape at the head of its sort chain, so a
// program reads it back by `case`.

/// Cells over a square of four corners, top left to bottom right: its left
/// and right sides, its top and bottom, one corner and the empty face.
theory Cells {
  boundary Square { tl, tr, bl, br };
  face left = {tl, bl};
  face right = {tr, br};
  face top = {tl, tr};
  face bottom = {bl, br};
  face corner = {tl};
  face none = {};
  sort Cell : Type;
  oper fill : () --> Cell;
}

/// Structural recursion over a face chain: one per `Face`.
def rec faces(chain : Theory) -> Integer {
  case chain {
    Face(name, points, rest) => { run r <- faces[<](rest); r + 1 },
    _ => 0
  }
}

/// The square heads the sort chain of `Cells`, with its six faces.
@[ runs("6") ]
def squareFaces() -> Integer { case Cells {
  Presents(sorts, opers, rules) => case sorts {
    Shape(name, size, chain, rest) => faces(chain),
    _ => 0
  },
  _ => 0
} }
