//! A signature stated over a finite shape. The member `boundary Square { … }`
//! names the carrier the signature's cells are stated over, one name per point,
//! and each `face` member a face a cell may be fixed on, the subshape of the
//! names it holds
//! [Nuyts-2026-facett_generalization_intensional_type_systems_glue]: the shape
//! parameter `ft` and its subshapes. The points run in name order. The block's
//! value codes the shape at the head of its sort chain, so a program reads it
//! back by `case`.
//!
//! - cites: [Nuyts-2026-facett_generalization_intensional_type_systems_glue]
//!
//! [Nuyts-2026-facett_generalization_intensional_type_systems_glue]: https://types2026.cse.chalmers.se/files/book-of-abstracts.pdf "Schönlank, Nuyts and Devriese, Towards FaceTT: A Generalization of Intensional Type Systems with Glue"

/// Cells over a square of four corners, top left to bottom right: its left
/// and right sides, its top and bottom, one corner and the empty face.
theory Cells where
  boundary Square { tl, tr, bl, br };
  face left = {tl, bl};
  face right = {tr, br};
  face top = {tl, tr};
  face bottom = {bl, br};
  face corner = {tl};
  face none = {};
  sort Cell : Type;
  oper fill : () --> Cell;

/// Structural recursion over a face chain: one per `Face`.
def rec faces(chain : Theory) -> Integer =
  match chain where
    | Face(name, points, rest) => { let r = faces[<] rest; r + 1 }
    | _ => 0

/// The square heads the sort chain of `Cells`, with its six faces.
@[ runs("6") ]
def squareFaces() -> Integer { match Cells {
  | Presents(sorts, opers, rules) => match sorts where
    | Shape(name, size, chain, rest) => faces chain
    | _ => 0
  | _ => 0
} }
