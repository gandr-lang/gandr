//! A fold over each index of a family: it respects each rule at its index.
//!
//! A family is one type at each index. A fold over the whole family takes the
//! index as its first argument, and a rule of the family stands at one index.
//! The fold must give one answer on the two sides of each rule.
//!
//! The checker stands the fold at the index that the root of each rule
//! states. Each node of a side takes the index of its own constructor. A fold
//! at one index owes nothing to a rule whose root stands at another index. The
//! kernel decides each fold again by its own code.
//!
//! - see: #8365
//! - see: `pathological/desc/fold-over-family.gandr` — a fold that tells two
//!   sides of a rule apart
//! - see: `model/desc/family-with-rules.gandr` — the widths
//! - see: `model/desc/fold-drops-variable.gandr` — a fold over a rule that
//!   drops a variable

// `Width`.
import "./family-with-rules.gandr"

/// The gates of a small circuit at each width.
pub data Gate : Width -> Type where {
  /// The dark bit.
  | Dark : Gate Bit
  /// The lit bit.
  | Lit : Gate Bit
  /// The empty word.
  | Nil : Gate Word
  /// The word with its halves in the other order.
  | Swap : (x : Gate Word) --> Gate Word
  /// The word behind a bit.
  | Hold : (c : Gate Bit, x : Gate Word) --> Gate Word
  /// Two swaps of a word are that word.
  rule : Swap (Swap x) <=> x;
  /// A word behind the lit bit is that word.
  rule : Hold Lit x <=> x;
}

/// The fold of the gates into themselves, at each width.
///
/// - see: #8365
def rec same(w : Width, t : Gate w) -> Gate w =
  match t where
    | Dark => Dark
    | Lit => Lit
    | Nil => Nil
    | Swap(x) => Swap (same[<] Word x)
    | Hold(c, x) => Hold (same[<] Bit c) (same[<] Word x)

/// The fold of the bits into themselves. No rule has its root at a bit.
///
/// - see: #8365
def rec bits(t : Gate Bit) -> Gate Bit =
  match t where
    | Dark => Dark
    | Lit => Lit

/// The fold of the words into themselves, at the one width.
def rec words(t : Gate Word) -> Gate Word =
  match t where
    | Nil => Nil
    | Swap(x) => Swap (words[<] x)
    | Hold(c, x) => Hold c (words[<] x)

/// A word behind the lit bit.
def held() -> Gate Word = Hold Lit (Swap (Swap Nil))

/// The empty word.
def nil() -> Gate Word = Nil

/// The fold of a word behind the lit bit is the empty word.
def sameHeld : Path[.A = Gate Word] (same Word held) nil = Path.here nil;
