// The generic program of `generic-arity.gandr` laid behind another source's
// presentation. `magma-base.gandr`'s block stands first in this closure and
// `generic-arity.gandr` imports nothing of it, so its block takes the code
// `Magma`'s minted and names it as its own: a unit holds one `Theory`, whatever
// it lays before a source (#1078).

// A presentation `generic-arity.gandr` does not import, laid first.
import "../higher-cells/magma-base.gandr" ;
// The generic program over presentations, laid after it.
import "./generic-arity.gandr" ;

/// #1078: `Monoid`'s two operations, counted by `arity` behind `Magma`'s
/// block. That block's code was every block's, and `generic-arity.gandr`
/// could not name it, so `arity` was refused at `Theory` and this count with
/// it.
@[ runs("2") ]
def counted_behind() -> Integer { arity(Monoid) }

/// #1078: `Magma`'s two operations, counted by the program the other source
/// declares: both blocks' presentations inhabit the one `Theory`.
@[ runs("2") ]
def counted_across() -> Integer { arity(Magma) }
