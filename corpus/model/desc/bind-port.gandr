//! The nominal binding port
//! [Pitts-2013-nominal_sets_names_symmetry_computer_science], ch. 4, and
//! [Gabbay-2009-nominal_universal_algebra]. `bind (a : N) . T` abstracts an
//! atom of the atom sort `N` over a port of sort `T`: swapping renames the atom
//! and it may escape, where `pi+ (x : S) . T` binds a variable that
//! substitution instantiates. Each block is a value of `Theory` that keeps an
//! abstracting port as an `Abstracted` link of its operation's port chain, so a
//! program reads it back by `case`.
//!
//! - cites: [Pitts-2013-nominal_sets_names_symmetry_computer_science]
//! - cites: [Gabbay-2009-nominal_universal_algebra]
//!
//! [Pitts-2013-nominal_sets_names_symmetry_computer_science]: https://doi.org/10.1017/CBO9781139084673 "Pitts, Nominal Sets: Names and Symmetry in Computer Science"
//! [Gabbay-2009-nominal_universal_algebra]: https://doi.org/10.1093/logcom/exp033 "Gabbay and Mathijssen, Nominal (Universal) Algebra: Equational Logic with Names and Binding"

/// The π-calculus's processes: `nu` restricts a channel name over a process,
/// abstracting it.
pub theory Restriction where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;

/// Both binders over one port, the abstraction outside: a fresh channel
/// abstracted over a body that binds the value received on it.
theory Receive where
  sort Name : Atom;
  sort Val : Type+;
  sort Proc : Type;
  oper new : (body : bind (c : Name). pi+ (x : Val). Proc) --> Proc;

/// Structural recursion over a port chain: one per `Abstracted` link, none
/// for a `Port` or a `Bound` one.
def rec abstracted(chain : Theory) -> Integer =
  match chain where
    | Abstracted(name, sort, indices, atoms, binders, rest) => {
      let r = abstracted[<] rest;
      r + 1
    }
    | Port(name, sort, indices, rest) => abstracted[<] rest
    | Bound(name, sort, indices, binders, rest) => abstracted[<] rest
    | _ => 0

/// Structural recursion over an operation chain: the abstracting input ports
/// of every operation.
def rec abstracting(chain : Theory) -> Integer =
  match chain where
    | Oper(name, inputs, outputs, rest) => {
      let here = abstracted inputs;
      let r = abstracting[<] rest;
      here + r
    }
    | _ => 0

/// Of the restriction signature's three operations, `nu` alone abstracts.
@[ runs("1") ]
def abstractions() -> Integer { match Restriction {
  | Presents(sorts, opers, rules) => abstracting opers
  | _ => 0
} }
