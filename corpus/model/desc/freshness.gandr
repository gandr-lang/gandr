//! Freshness conditions on rules [Fernandez-2007-nominal_rewriting] and
//! [Pitts-2013-nominal_sets_names_symmetry_computer_science]. A rule between
//! terms closes on a `where` clause, `where a # q`: the atom `a` stands outside
//! the support of the term `q` stands for. A rule whose variable moves into or
//! out of an abstraction states that atom fresh for it, or the description
//! check refuses the rule for capture (`pathological/desc/freshness.gandr`).
//! The value of `Theory` keeps each condition as a `Fresh` link after its rule.
//! No port of these theories takes an atom, so no term names one: the support
//! of every instance is empty and every condition holds. Where a port takes an
//! atom, a condition decides where its rule fires:
//! `model/desc/atom-occurrence.gandr`.
//!
//! - cites: [Fernandez-2007-nominal_rewriting]
//! - cites: [Pitts-2013-nominal_sets_names_symmetry_computer_science]
//!
//! [Fernandez-2007-nominal_rewriting]: https://doi.org/10.1016/j.ic.2006.12.002 "Fernández and Gabbay, Nominal rewriting"
//! [Pitts-2013-nominal_sets_names_symmetry_computer_science]: https://doi.org/10.1017/CBO9781139084673 "Pitts, Nominal Sets: Names and Symmetry in Computer Science"

/// The π-calculus's structural congruence: the inert process, parallel
/// composition and restriction, scope extrusion moving `q` under the
/// restriction fresh for its atom. The checker orients the law and the kernel
/// replays the verdict.
theory Pi where {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule scope : par(nu(bind a. p), q) <=> nu(bind a. par(p, q)) where { | a # q };
}

/// Structural recursion over a rule chain: one per `Fresh` link, the
/// conditions its written rules state.
def rec conditions(chain : Theory) -> Integer {
  match chain {
    Rule(name, lhs, rhs, rest) => conditions[<](rest),
    Turned(name, lhs, rhs, rest) => conditions[<](rest),
    Fresh(atom, term, rest) => {
      let r = conditions[<](rest);
      r + 1
    },
    _ => 0
  }
}

/// `Pi` states one condition.
@[ runs("1") ]
def stated() -> Integer { match Pi {
  Presents(sorts, opers, rules) => conditions(rules),
  _ => 0
} }
