//! Rules that overlap are admitted when their critical pairs join (the
//! completion of [Knuth-1970-simple_word_problems_universal_algebras], and
//! [Baader-1998-term_rewriting_and_all_that], § 6.2): zero a unit of addition
//! on both sides overlaps the recursion on the first argument at `add(Zero,
//! Zero)` and at `add(Succ(m), Zero)`, and both pairs rewrite to one term;
//! associativity overlaps itself, and its one pair joins too.
//!
//! - see: #654 — `Semigroup`
//! - cites: [Knuth-1970-simple_word_problems_universal_algebras]
//! - cites: [Baader-1998-term_rewriting_and_all_that]
//!
//! [Knuth-1970-simple_word_problems_universal_algebras]: https://doi.org/10.1016/B978-0-08-012975-4.50028-X "Knuth and Bendix, Simple Word Problems in Universal Algebras"
//! [Baader-1998-term_rewriting_and_all_that]: https://doi.org/10.1017/CBO9781139172752 "Baader and Nipkow, Term Rewriting and All That"

/// The naturals with addition, zero stated a unit on both sides.
@[ normalizes("add(Zero, Zero) ~> Zero") ]
data NatUnits : Type where {
  | Zero : NatUnits
  | Succ : (n : NatUnits) --> NatUnits
  oper add : (m : NatUnits, n : NatUnits) --> NatUnits;
  rule : add(Zero, n) <=> n;
  rule : add(m, Zero) <=> m;
  rule : add(Succ(m), n) <=> Succ(add(m, n));
}

/// Zero plus zero, where the two unit rules overlap.
@[ runs("Zero") ]
def zero_plus_zero() -> NatUnits { add(Zero, Zero) }

/// One plus zero, where the right unit overlaps the recursion.
@[ runs("Succ(Zero)") ]
def one_plus_zero() -> NatUnits { add(Succ(Zero), Zero) }

/// Two plus one, by the recursion alone.
@[ runs("Succ(Succ(Succ(Zero)))") ]
def two_plus_one_overlapping() -> NatUnits { add(Succ(Succ(Zero)), Succ(Zero)) }

/// A semigroup's one law: associativity overlaps itself at
/// `mul(mul(mul(a, b), c), d)`, and both ways round reach `mul(a, mul(b,
/// mul(c, d)))`. The rewrite at the peak matches the rule's `z` against a
/// subterm holding the peak's own `z`, which stays the peak's.
theory Semigroup where {
  sort S : Type;

  oper mul : (x : S, y : S) --> S;

  rule assoc : mul(mul(x, y), z) <=> mul(x, mul(y, z));
}
