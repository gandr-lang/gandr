//! A rule term can abstract an atom over a term.
//!
//! A `bind (a : N) . T` port accepts `bind a . t` in a rule.
//!
//! Admission re-mints each atom at its binder depth. The kernel matches
//! alpha-equivalent terms and analyses their critical pairs.
//! A `Theory` value keeps each written atom and variable. The restriction
//! signature is in `bind-port.gandr`.
//!
//! - cites: [Gabbay-2009-nominal_universal_algebra]
//! - cites: [Fernandez-2007-nominal_rewriting]
//!
//! [Gabbay-2009-nominal_universal_algebra]: https://doi.org/10.1093/logcom/exp033 "Gabbay and Mathijssen, Nominal (Universal) Algebra: Equational Logic with Names and Binding"
//! [Fernandez-2007-nominal_rewriting]: https://doi.org/10.1016/j.ic.2006.12.002 "Fernández and Gabbay, Nominal rewriting"

/// Scope extrusion encloses both sides of a parallel composition. The law
/// moves `q` under a restriction and states `a` fresh for `q`.
theory Scope where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule scope : par (nu (bind a. p)) q <=> nu (bind a. (par p q)) where {| a # q};

/// The two laws differ only in the abstracted atom. Admission re-mints the
/// atoms, so the laws overlap at the root.
theory Alpha where
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper stop : () --> Proc;
  oper nu : (p : bind (a : Name). Proc) --> Proc;
  rule gc : nu (bind a. (nil ())) ==> nil ();
  rule halt : nu (bind b. (nil ())) ==> stop ();

/// This recursion counts `Derived` links in a rule chain. Completion adds each
/// derived rule to join a critical pair.
def rec derived(chain : Theory) -> Integer =
  match chain where
    | Rule(name, lhs, rhs, rest) => derived[<] rest
    | Turned(name, lhs, rhs, rest) => derived[<] rest
    | Derived(outer, position, inner, lhs, rhs, rest) => {
      let r = derived[<] rest;
      r + 1
    }
    | _ => 0

/// Completion derives two rules for the alpha-equivalent overlap in `Alpha`.
@[runs("2")]
def derivations() -> Integer { match Alpha {
  | Presents(sorts, opers, rules) => derived rules
  | _ => 0
} }
