//! An identity substitution leaves each term unchanged.
//!
//! Each index maps to its own variable.
//!
//! The lifted step weakens the hypothesis. The weakened variable is its
//! successor.
//!
//! - see: #640

// This source imports naturals, syntax, congruences and lookup lemmas.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./congruence.gandr";
import "./shift-lookup.gandr";
import "./lookup-weaken.gandr";

/// An identity at every index holds of the lift.
def substIdLift(
  s : Env,
  h : (n : N) -> Path[.A = Term](look n s Z, Ix n),
  n : N
) -> Path[.A = Term](
  look n (Lift s) Z,
  Ix n
) =
  match n where
    | Z => Path.here (Ix Z)
    | S(m) => compose[5, 7] (chain 3) (
      lookWeakens m s Z,
      wkCong (look m s Z) (Ix m) (h m),
      ixShiftAdds m (S Z)
    )

/// A substitution that is the identity at every index is the identity.
pub def rec substId(
  t : Term,
  s : Env,
  h : (n : N) -> Path[.A = Term](look n s Z, Ix n)
) -> Path[.A = Term](
  subst t s,
  t
) =
  match t where
    | Ix(n) => h n
    | Lam(b) => Path.ap lamOf (substId[<] b (Lift s) (fun (n) { substIdLift s h n }))
    | Ap(f, x) => Path.walk
      (fun (z) { type(Path[.A = Term](Ap (subst f s) (subst x s), Ap z x)) })
      (substId[<] f s h)
      (Path.walk (fun (z) {
        type(Path[.A = Term](Ap (subst f s) (subst x s), Ap (subst f s) z))
      }) (substId[<] x s h) (Path.here (Ap (subst f s) (subst x s))))

/// The shift by zero is the identity at every index.
pub def shiftZeroIsId(n : N) -> Path[.A = Term](look n (Shift Z) Z, Ix n) =
  match n where
    | Z => Path.here (Ix Z)
    | S(j) => Path.here (Ix (S j))
