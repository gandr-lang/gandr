//! Law 6 distributes substitution over application.
//!
//! `sub(app(t, u), s)` equals `app(sub(t, s), sub(u, s))`.
//!
//! The application arm of `subst` proves the law. The proof holds by
//! computation.
//!
//! - see: #640

// The syntax and its substitution.
import "./syntax.gandr";

/// A substitution applied to an application applies to both sides.
pub def subApp(t : Term, u : Term, s : Env) -> Path(
  subst (Ap t u) s,
  Ap (subst t s) (subst u s)
) =
  Path.here (Ap (subst t s) (subst u s))
