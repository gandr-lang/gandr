//! Syntax constructors and operations respect paths.
//!
//! The successor, variable and abstraction each map argument paths to result
//! paths.
//!
//! Weakening and substitution map equal terms to equal terms.
//! `Path.walk` carries a path through a substitution.
//!
//! - see: #640

// This source imports naturals and syntax.
import "../model-in-source.gandr";
import "./syntax.gandr";

/// The successor, as a function `Path.ap` can take.
pub def succOf(n : N) -> N =
  S n

/// A variable, as a function `Path.ap` can take.
pub def ixOf(n : N) -> Term =
  Ix n

/// An abstraction, as a function `Path.ap` can take.
pub def lamOf(t : Term) -> Term =
  Lam t

/// Equal indices are equal variables.
pub def ixCong(x : N, y : N, p : Path(x, y)) -> Path(Ix x, Ix y) =
  Path.ap ixOf p

/// Equal terms weaken to equal terms.
pub def wkCong(x : Term, y : Term, p : Path(x, y)) -> Path(wk x, wk y) =
  Path.ap wk p

/// Equal terms under one substitution are equal.
pub def substCong(s : Env, x : Term, y : Term, p : Path(x, y)) -> Path(
  subst x s,
  subst y s
) =
  Path.walk (fun (z) { type(Path[.A = Term](subst x s, subst z s)) }) p (Path.here (subst x s))
