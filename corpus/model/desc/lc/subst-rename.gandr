//! Renaming and substitution commute under index agreement.
//!
//! A weakening instance moves a lifted substitution past a weakened term.
//!
//! The induction lifts the index hypothesis. `renameSquare` moves a weak term
//! past a lifted renaming.
//!
//! - see: #640

// This source imports syntax, congruences and lookup lemmas.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./congruence.gandr";
import "./shift-lookup.gandr";
import "./rename-rename.gandr";
import "./lookup-weaken.gandr";

/// A lifted rename preserves a weakened lookup.
def renameLookWeakens(u : Env, q : Ren, m : N) -> Path(
  rename (wk (look m u Z)) (RLift q),
  rename (look m u (S Z)) (RLift q)
) =
  Path.walk
    (fun (z) { type(Path[.A = Term](rename z (RLift q), rename (look m u (S Z)) (RLift q))) })
    (lookWeakens m u Z)
    (Path.here (rename (look m u (S Z)) (RLift q)))

/// The lift of `q` commutes with a shift at every index.
def shiftPastLift(
  q : Ren,
  n : N
) -> Path(rlook (rlook n q) (RShift (S Z)), rlook (rlook n (RShift (S Z))) (RLift q)) =
  match n where
    | Z => shiftAdds (rlook Z q) (S Z)
    | S(j) => shiftAdds (rlook (S j) q) (S Z)

/// This function applies `wk` to the hypothesis at `m`.
def weakenedSquare(
  r : Ren,
  s : Env,
  u : Env,
  q : Ren,
  h : (n : N) -> Path[.A = Term](look (rlook n r) s Z, rename (look n u Z) q),
  m : N
) -> Path[.A = Term](wk (look (rlook m r) s Z), wk (rename (look m u Z) q)) =
  Path.ap wk (h m)

/// The lifts preserve pointwise agreement between renaming and substitution.
def substRenameSquareLift(
  r : Ren,
  s : Env,
  u : Env,
  q : Ren,
  h : (n : N) -> Path[.A = Term](look (rlook n r) s Z, rename (look n u Z) q),
  n : N
) -> Path[.A = Term](look (rlook n (RLift r)) (Lift s) Z, rename (look n (Lift u) Z) (RLift q)) =
  match n where
    | Z => Path.here (Ix Z)
    | S(m) => compose[7, 9] (chain 4) (
      lookWeakens (rlook m r) s Z,
      weakenedSquare r s u q h m,
      renameSquare
        (look m u Z)
        q
        (RShift (S Z))
        (RShift (S Z))
        (RLift q)
        (fun (i) { shiftPastLift q i }),
      renameLookWeakens u q m
    )

/// `substRenameSquare` relates two operations that agree at every index.
def rec substRenameSquare(
  t : Term,
  r : Ren,
  s : Env,
  u : Env,
  q : Ren,
  h : (n : N) -> Path[.A = Term](look (rlook n r) s Z, rename (look n u Z) q)
) -> Path[.A = Term](subst (rename t r) s, rename (subst t u) q) =
  match t where
    | Ix(n) => h n
    | Lam(b) => Path.ap
      lamOf
      (substRenameSquare[<] b (RLift r) (Lift s) (Lift u) (RLift q) (fun (n) {
        substRenameSquareLift r s u q h n
      }))
    | Ap(f, x) => Path.walk
      (fun (z) { type(Path[.A = Term](
        Ap (subst (rename f r) s) (subst (rename x r) s),
        Ap z (rename (subst x u) q)
      )) })
      (substRenameSquare[<] f r s u q h)
      (Path.walk
        (fun (z) {
          type(Path[.A = Term](
            Ap (subst (rename f r) s) (subst (rename x r) s),
            Ap (subst (rename f r) s) z
          ))
        })
        (substRenameSquare[<] x r s u q h)
        (Path.here (Ap (subst (rename f r) s) (subst (rename x r) s))))

/// A lifted substitution after `wk` agrees with `wk` after the substitution.
def weakenLiftLooks(
  s : Env,
  n : N
) -> Path(look (rlook n (RShift (S Z))) (Lift s) Z, rename (look n s Z) (RShift (S Z))) =
  match n where
    | Z => lookWeakens Z s Z
    | S(j) => lookWeakens (S j) s Z

/// A lifted substitution of `wk` is `wk` of that substitution.
pub def substWeaken(x : Term, s : Env) -> Path(subst (wk x) (Lift s), wk (subst x s)) =
  substRenameSquare
    x
    (RShift (S Z))
    (Lift s)
    s
    (RShift (S Z))
    (fun (n) { weakenLiftLooks s n })
