//! A variable substitution is a renaming.
//!
//! Each index maps to the variable at the renamed index.
//!
//! A substitution by shift one weakens a term. The proof compares every index.
//!
//! - see: #640

// This source imports naturals, syntax, congruences and lookup lemmas.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./congruence.gandr";
import "./shift-lookup.gandr";
import "./lookup-weaken.gandr";

/// This function applies `wk` to the hypothesis at `m`.
def weakenedVariable(
  s : Env,
  r : Ren,
  h : (n : N) -> Path[.A = Term](look n s Z, Ix (rlook n r)),
  m : N
) -> Path[.A = Term](wk (look m s Z), wk (Ix (rlook m r))) =
  Path.ap wk (h m)

/// If a substitution and a renaming agree at every index, their lifts agree.
def substRenamesLift(
  s : Env,
  r : Ren,
  h : (n : N) -> Path[.A = Term](look n s Z, Ix (rlook n r)),
  n : N
) -> Path[.A = Term](look n (Lift s) Z, Ix (rlook n (RLift r))) =
  match n where
    | Z => Path.here (Ix Z)
    | S(m) => compose[5, 7] (chain 3) (
      lookWeakens m s Z,
      weakenedVariable s r h m,
      ixShiftAdds (rlook m r) (S Z)
    )

/// If a substitution equals a renaming at every index, they agree on terms.
pub def rec substRenames(
  t : Term,
  s : Env,
  r : Ren,
  h : (n : N) -> Path[.A = Term](look n s Z, Ix (rlook n r))
) -> Path[.A = Term](subst t s, rename t r) =
  match t where
    | Ix(n) => h n
    | Lam(b) => Path.ap
      lamOf
      (substRenames[<] b (Lift s) (RLift r) (fun (n) { substRenamesLift s r h n }))
    | Ap(f, x) => Path.walk
      (fun (z) { type(Path[.A = Term](Ap (subst f s) (subst x s), Ap z (rename x r))) })
      (substRenames[<] f s r h)
      (Path.walk (fun (z) {
        type(Path[.A = Term](Ap (subst f s) (subst x s), Ap (subst f s) z))
      }) (substRenames[<] x s r h) (Path.here (Ap (subst f s) (subst x s))))

/// The shift by one renames each index by that shift.
pub def shiftOneRenames(i : N) -> Path[.A = Term](look i (Shift (S Z)) Z, Ix (rlook i (RShift (S Z)))) =
  match i where
    | Z => Path.here (Ix (S Z))
    | S(j) => Path.here (Ix (S (S j)))
