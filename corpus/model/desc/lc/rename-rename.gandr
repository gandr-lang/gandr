//! Renaming twice is renaming once, the renaming case of the fusion lemmas of
//! Allais et al.
//! [Allais-2021-a_type_and_scope_safe_universe_of_syntaxes_with_binding_their_semantics_and_proofs]:
//! a term renamed by `a1` then `a2` is the term renamed by `a3` when the
//! lookups agree at every index, and likewise for two composites. Each is an
//! induction on the term whose hypothesis is the pointwise one, lifted once
//! under each abstraction; an application's two paths are joined by
//! `Path.walk`.
//!
//! - cites: [Allais-2021-a_type_and_scope_safe_universe_of_syntaxes_with_binding_their_semantics_and_proofs]
//!
//! [Allais-2021-a_type_and_scope_safe_universe_of_syntaxes_with_binding_their_semantics_and_proofs]: https://doi.org/10.1017/S0956796820000076 "Allais et al., A type- and scope-safe universe of syntaxes with binding: their semantics and proofs"

// The naturals; the syntax; the congruences.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./congruence.gandr";

/// A pointwise agreement of `a1` then `a2` with `a3` holds of their lifts.
def renameRenameLift(
  a1 : Ren,
  a2 : Ren,
  a3 : Ren,
  h : (n : N) -> Path[.A = N](rlook (rlook n a1) a2, rlook n a3),
  n : N
) -> Path[.A = N](rlook (rlook n (RLift a1)) (RLift a2), rlook n (RLift a3)) =
  match n
    | Z => Path.here Z
    | S(m) => Path.ap succOf (h m)

/// Renaming by `a1` then `a2` is renaming by `a3`, given they agree at every
/// index.
pub def rec renameRename(
  t : Term,
  a1 : Ren,
  a2 : Ren,
  a3 : Ren,
  h : (n : N) -> Path[.A = N](rlook (rlook n a1) a2, rlook n a3)
) -> Path[.A = Term](rename (rename t a1) a2, rename t a3) =
  match t
    | Ix(n) => Path.ap ixOf (h n)
    | Lam(b) => Path.ap
      lamOf
      (renameRename[<] b (RLift a1) (RLift a2) (RLift a3) (fun (n) {
        renameRenameLift a1 a2 a3 h n
      }))
    | Ap(f, x) => Path.walk
      (fun (z) { type(Path[.A = Term](
        Ap (rename (rename f a1) a2) (rename (rename x a1) a2),
        Ap z (rename x a3)
      )) })
      (renameRename[<] f a1 a2 a3 h)
      (Path.walk
        (fun (z) {
          type(Path[.A = Term](
            Ap (rename (rename f a1) a2) (rename (rename x a1) a2),
            Ap (rename (rename f a1) a2) z
          ))
        })
        (renameRename[<] x a1 a2 a3 h)
        (Path.here (Ap (rename (rename f a1) a2) (rename (rename x a1) a2))))

/// A pointwise agreement of two composites holds of their lifts.
def renameSquareLift(
  a1 : Ren,
  a2 : Ren,
  a3 : Ren,
  a4 : Ren,
  h : (n : N) -> Path[.A = N](rlook (rlook n a1) a2, rlook (rlook n a3) a4),
  n : N
) -> Path[.A = N](rlook (rlook n (RLift a1)) (RLift a2), rlook (rlook n (RLift a3)) (RLift a4)) =
  match n
    | Z => Path.here Z
    | S(m) => Path.ap succOf (h m)

/// Renaming by `a1` then `a2` is renaming by `a3` then `a4`, given the two
/// composites agree at every index.
pub def rec renameSquare(
  t : Term,
  a1 : Ren,
  a2 : Ren,
  a3 : Ren,
  a4 : Ren,
  h : (n : N) -> Path[.A = N](rlook (rlook n a1) a2, rlook (rlook n a3) a4)
) -> Path[.A = Term](rename (rename t a1) a2, rename (rename t a3) a4) =
  match t
    | Ix(n) => Path.ap ixOf (h n)
    | Lam(b) => Path.ap
      lamOf
      (renameSquare[<] b (RLift a1) (RLift a2) (RLift a3) (RLift a4) (fun (n) {
        renameSquareLift a1 a2 a3 a4 h n
      }))
    | Ap(f, x) => Path.walk
      (fun (z) { type(Path[.A = Term](
        Ap (rename (rename f a1) a2) (rename (rename x a1) a2),
        Ap z (rename (rename x a3) a4)
      )) })
      (renameSquare[<] f a1 a2 a3 a4 h)
      (Path.walk
        (fun (z) {
          type(Path[.A = Term](
            Ap (rename (rename f a1) a2) (rename (rename x a1) a2),
            Ap (rename (rename f a1) a2) z
          ))
        })
        (renameSquare[<] x a1 a2 a3 a4 h)
        (Path.here (Ap (rename (rename f a1) a2) (rename (rename x a1) a2))))
