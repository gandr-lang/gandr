// A shift renaming adds its amount to an index, and two shifts compose.
// `rlook` takes its index apart, so at an index that does not compute — a
// sum, another lookup — a shift's lookup is stuck; these paths say what it
// is, by cases on the index.

// The naturals; the syntax; the congruences.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./congruence.gandr";

/// A shift by `k` sends `n` to `n + k`.
@[ checks ]
def shiftAdds(n : N, k : N) -> Path(N, rlook(n, RShift(k)), plus(n, k)) {
  case n {
    Z => here(plus(Z, k)),
    S(m) => here(plus(S(m), k))
  }
}

/// The same under a variable.
@[ checks ]
def ixShiftAdds(x : N, k : N) -> Path(Term, Ix(rlook(x, RShift(k))), Ix(plus(x, k))) {
  ixCong(rlook(x, RShift(k)), plus(x, k), shiftAdds(x, k))
}

/// `ixShiftAdds(plus(Z, k), S(Z))` with its endpoints written out as
/// `ixCong`'s arguments, two calls deep: each argument answers its path type
/// as written (#762).
@[ checks ]
def ixShiftAddsAtSum(k : N) -> Path(
  Term,
  Ix(rlook(plus(Z, k), RShift(S(Z)))),
  Ix(plus(plus(Z, k), S(Z)))
) {
  ixCong(rlook(plus(Z, k), RShift(S(Z))), plus(plus(Z, k), S(Z)), shiftAdds(plus(Z, k), S(Z)))
}

/// A shift by `i + 1` then by one is a shift by `i + 2`, at each index.
@[ checks ]
def shiftsCompose(
  i : N,
  n : N
) -> Path(N, rlook(rlook(n, RShift(S(i))), RShift(S(Z))), rlook(n, RShift(S(S(i))))) {
  case n {
    Z => here(S(S(plus(Z, i)))),
    S(m) => here(S(S(plus(S(m), i))))
  }
}
