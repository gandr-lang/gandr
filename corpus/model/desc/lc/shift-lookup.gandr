// A shift renaming adds its amount to an index.
//
// Two shifts compose.
//
// `rlook` splits an index by cases.
// A noncomputing index leaves a shift lookup stuck. The paths state each case.
//
// - see: #762 — `ixShiftAddsAtSum`

// This source imports naturals, syntax and congruences.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./congruence.gandr";

/// A shift by `k` sends `n` to `n + k`.
pub def shiftAdds(n : N, k : N) -> Path(rlook n (RShift k), plus n k) =
  match n where
    | Z => Path.here (plus Z k)
    | S(m) => Path.here (plus (S m) k)

/// The same under a variable.
pub def ixShiftAdds(x : N, k : N) -> Path(Ix (rlook x (RShift k)), Ix (plus x k)) =
  ixCong (rlook x (RShift k)) (plus x k) (shiftAdds x k)

/// This path applies `ixShiftAdds` to `plus(Z, k)`.
def ixShiftAddsAtSum(k : N) -> Path(
  Ix (rlook (plus Z k) (RShift (S Z))),
  Ix (plus (plus Z k) (S Z))
) =
  ixCong (rlook (plus Z k) (RShift (S Z))) (plus (plus Z k) (S Z)) (shiftAdds (plus Z k) (S Z))

/// A shift by `i + 1` then by one is a shift by `i + 2`, at each index.
pub def shiftsCompose(
  i : N,
  n : N
) -> Path(rlook (rlook n (RShift (S i))) (RShift (S Z)), rlook n (RShift (S (S i)))) =
  match n where
    | Z => Path.here (S (S (plus Z i)))
    | S(m) => Path.here (S (S (plus (S m) i)))
