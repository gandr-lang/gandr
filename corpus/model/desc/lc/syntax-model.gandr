// The syntax model of `theory LC`, written as a `Model(LC)` module: a
// context is its length, a substitution between two contexts is an `Env`
// and a term in one a `Term`; each operation builds the syntax, ignoring the
// context indices the derivation adds, and each law is the path its own file
// proves of the syntax.

// The naturals; the syntax; the six laws, in the theory's order.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./sub-q-single.gandr";
import "./sub-q-lift.gandr";
import "./sub-weaken-lift.gandr";
import "./sub-weaken-single.gandr";
import "./sub-lam.gandr";
import "./sub-app.gandr";

/// The λ-calculus's syntax as a model of its single-substitution calculus.
pub module LCSyntax : Model(LC) {
  type Con = N;
  type Sub(d : N, g : N) = Env;
  type Tm(g : N) = Term;

  /// The empty context has no variables.
  def empty() -> N { Z }

  /// A substitution applied to a term.
  def subTm(g : N, d : N, t : Term, s : Env) -> Term { subst(t, s) }

  /// Context extension adds one variable.
  def extendTm(g : N) -> N { S(g) }

  /// Weakening shifts every index by one.
  def pTm(g : N) -> Env { Shift(S(Z)) }

  /// The newest variable is index zero.
  def qTm(g : N) -> Term { Ix(Z) }

  /// Single substitution conses its term onto the identity.
  def singleTm(g : N, a : Term) -> Env { Cons(a, Shift(Z)) }

  /// Lifting is the substitution's constructor; its indices stand in the
  /// order their first occurrence gives, the target `d` before `g`.
  def liftTm(d : N, g : N, s : Env) -> Env { Lift(s) }

  /// Abstraction binds index zero.
  def lam(g : N, t : Term) -> Term { Lam(t) }

  /// Application.
  def app(g : N, t : Term, u : Term) -> Term { Ap(t, u) }

  /// Law 1, `subQSingle`.
  def law1(g : N, b : Term) -> Path(Term, subTm(S(g), g, qTm(g), singleTm(g, b)), b) {
    subQSingle(b)
  }

  /// Law 2, `subQLift`; its indices stand as `liftTm`'s do.
  def law2(d : N, g : N, s : Env) -> Path(
    Term,
    subTm(S(g), S(d), qTm(g), liftTm(d, g, s)),
    qTm(d)
  ) {
    subQLift(s)
  }

  /// Law 3, `subWeakenLift`, by induction on `b`.
  def law3(g : N, d : N, b : Term, s : Env) -> Path(
    Term,
    subTm(S(g), S(d), subTm(g, S(g), b, pTm(g)), liftTm(d, g, s)),
    subTm(d, S(d), subTm(g, d, b, s), pTm(d))
  ) {
    subWeakenLift(b, s)
  }

  /// Law 4, `subWeakenSingle`, by induction on `b`.
  def law4(g : N, b : Term, a : Term) -> Path(
    Term,
    subTm(S(g), g, subTm(g, S(g), b, pTm(g)), singleTm(g, a)),
    b
  ) {
    subWeakenSingle(b, a)
  }

  /// Law 5, `subLam`.
  def law5(g : N, d : N, t : Term, s : Env) -> Path(
    Term,
    subTm(g, d, lam(g, t), s),
    lam(d, subTm(S(g), S(d), t, liftTm(d, g, s)))
  ) {
    subLam(t, s)
  }

  /// Law 6, `subApp`.
  def law6(g : N, d : N, t : Term, u : Term, s : Env) -> Path(
    Term,
    subTm(g, d, app(g, t, u), s),
    app(d, subTm(g, d, t, s), subTm(g, d, u, s))
  ) {
    subApp(t, u, s)
  }
}
