//! A lookup under one more binder is a weakened lookup.
//!
//! `look` counts crossed binders.
//!
//! A crossed binder adds one weakening. A consed term uses `renameRename`.
//! A shift uses `shiftAdds`.
//!
//! - see: #640

// This source imports naturals, syntax, shift lookup and fusion lemmas.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./shift-lookup.gandr";
import "./rename-rename.gandr";

/// A term under `k + 1` binders is the term under `k` weakened.
def shiftByWeakens(a : Term, k : N) -> Path(shiftBy a (S k), wk (shiftBy a k)) =
  match k where
    | Z => Path.here (wk a)
    | S(i) => Path.back (renameRename a (RShift (S i)) (RShift (S Z)) (RShift (S (S i))) (fun (n) {
      shiftsCompose i n
    }))

/// A lookup under one binder more is the lookup weakened, by recursion on
/// the index.
pub def rec lookWeakens(n : N, s : Env, k : N) -> Path(look n s (S k), wk (look n s k)) =
  match s where
    | Shift(j) => match n where
      | Z => Path.back (ixShiftAdds (plusTwo Z j k) (S Z))
      | S(m) => Path.back (ixShiftAdds (plusTwo (S m) j k) (S Z))
    | Cons(a, r) => match n where
      | Z => shiftByWeakens a k
      | S(m) => lookWeakens[<] m r k
    | Lift(r) => match n where
      | Z => Path.back (ixShiftAdds (plus Z k) (S Z))
      | S(m) => lookWeakens[<] m r (S k)
