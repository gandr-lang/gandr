//! Law 1 substitutes for the newest variable.
//!
//! `sub(q, single(b))` equals `b`.
//!
//! A cons lookup at index zero gives its head. The law holds by computation
//! under no binder.
//!
//! - see: #640

// This source imports naturals and substitution syntax.
import "../model-in-source.gandr";
import "./syntax.gandr";

/// At the newest variable, the substitution of `b` is `b`.
pub def subQSingle(b : Term) -> Path(subst (Ix Z) (Cons b (Shift Z)), b) =
  Path.here b
