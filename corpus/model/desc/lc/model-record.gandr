//! This record type holds the components of `Model(LC)`.
//!
//! The derivation fixes the order of fields. The fields include contexts,
//! substitutions, terms, operations and laws.
//!
//! Component indices use the order of their source sorts. So `liftTm` and law
//! 2 take `d` before `g`, because their first binder is `s : Sub(d, g)`. The
//! syntax model packs into this record as `SyntaxNat` packs into the record
//! of `Nat`'s models in `model-in-source.gandr`. Beta reduction uses one
//! substitution.
//!
//! - see: #640

// This source imports naturals, syntax and the syntax model.
import "../model-in-source.gandr";
import "./syntax.gandr";
import "./syntax-model.gandr";

/// `lcSyntax` packs the syntax model into `Model(LC)` order.
def lcSyntax : *{
  con : Type,
  sub : (con, con) -> Type,
  tm : con -> Type,
  empty : () -> con,
  subTm : (g : con, d : con, tm(g), sub(d, g)) -> tm(d),
  extendTm : con -> con,
  pTm : (g : con) -> sub(extendTm(g), g),
  qTm : (g : con) -> tm(extendTm(g)),
  singleTm : (g : con, tm(g)) -> sub(g, extendTm(g)),
  liftTm : (d : con, g : con, sub(d, g)) -> sub(extendTm(d), extendTm(g)),
  lam : (g : con, tm(extendTm(g))) -> tm(g),
  app : (g : con, tm(g), tm(g)) -> tm(g),
  law1 : (g : con, b : tm(g)) -> Path[.A = tm(g)](subTm (extendTm g) g (qTm g) (singleTm g b), b),
  law2 : (d : con, g : con, s : sub(d, g)) -> Path[.A = tm(extendTm(d))](
    subTm (extendTm g) (extendTm d) (qTm g) (liftTm d g s),
    qTm d
  ),
  law3 : (g : con, d : con, b : tm(g), s : sub(d, g)) -> Path[.A = tm(extendTm(d))](
    subTm (extendTm g) (extendTm d) (subTm g (extendTm g) b (pTm g)) (liftTm d g s),
    subTm d (extendTm d) (subTm g d b s) (pTm d)
  ),
  law4 : (g : con, b : tm(g), a : tm(g)) -> Path[.A = tm(g)](
    subTm (extendTm g) g (subTm g (extendTm g) b (pTm g)) (singleTm g a),
    b
  ),
  law5 : (g : con, d : con, t : tm(extendTm(g)), s : sub(d, g)) -> Path[.A = tm(d)](
    subTm g d (lam g t) s,
    lam d (subTm (extendTm g) (extendTm d) t (liftTm d g s))
  ),
  law6 : (g : con, d : con, t : tm(g), u : tm(g), s : sub(d, g)) -> Path[.A = tm(d)](
    subTm g d (app g t u) s,
    app d (subTm g d t s) (subTm g d u s)
  )
} = *{
  N,
  *{
    fun (d) { fun (g) { return Env } },
    *{
      fun (g) { return Term },
      *{
        LCSyntax.empty,
        *{
          LCSyntax.subTm,
          *{
            LCSyntax.extendTm,
            *{
              LCSyntax.pTm,
              *{
                LCSyntax.qTm,
                *{
                  LCSyntax.singleTm,
                  *{
                    LCSyntax.liftTm,
                    *{
                      LCSyntax.lam,
                      *{
                        LCSyntax.app,
                        *{
                          LCSyntax.law1,
                          *{
                            LCSyntax.law2,
                            *{LCSyntax.law3, *{LCSyntax.law4, *{LCSyntax.law5, LCSyntax.law6}}}
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
};

/// `lcModel` contains the packed syntax model at the type `Model(LC)` that the
/// derivation states. It applies each family over contexts and reads a term in
/// an extended context after its extension runs.
def lcModel : Model LC = lcSyntax;

/// The identity application reduces to the identity.
@[runs("Lam (Ix Z)")]
def betaIdentity() -> Term =
  let q = LCSyntax.qTm Z
  let identity = LCSyntax.lam Z q
  LCSyntax.subTm (S Z) Z q (LCSyntax.singleTm Z identity)
