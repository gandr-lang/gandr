// Substitution whose lifting is a definition rather than the constructor
// `Lift`, beside `subst-subst`'s `substTwiceUnderLam`. Two such
// substitutions at an abstraction unfold the outer one at the inner one's
// stuck call, beside the lifting call that unfolds to `Lift`; the two
// recursive calls compare part by part, so the step converts as it does with
// lifting a constructor (#879).

// The naturals; the terms and the lookup.
import "../model-in-source.gandr";
import "./syntax.gandr";

/// Lifting as a definition, building the constructor.
@[ checks ]
def liftOf(s : Env) -> Env {
  Lift(s)
}

/// Substitution lifting through `liftOf`.
@[ checks ]
def rec substLifting(t : Term, s : Env) -> Term {
  case t {
    Ix(n) => look(n, s, Z),
    Lam(b) => Lam(substLifting[<](b, liftOf(s))),
    Ap(f, a) => Ap(substLifting[<](f, s), substLifting[<](a, s))
  }
}

/// Two substitutions at an abstraction, both unfolded once.
@[ checks ]
def substLiftingTwiceUnderLam(b : Term, s1 : Env, s2 : Env) -> Path(
  Term,
  substLifting(substLifting(Lam(b), s1), s2),
  Lam(substLifting(substLifting(b, liftOf(s1)), liftOf(s2)))
) {
  here(Lam(substLifting(substLifting(b, liftOf(s1)), liftOf(s2))))
}
