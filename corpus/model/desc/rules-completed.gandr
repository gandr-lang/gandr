//! Rules whose overlap parts at a call rather than a value are completed: the
//! two rules of `swap` overlap at `swap(Zero, n)`, which one leaves at `n` and
//! the other at `add(n, Zero)`, a call the written rules cannot rewrite with
//! `n` unknown. Completion derives the rule joining the pair, `add(n, Zero)`
//! rewriting to `n`, which follows from the written rules (both sides are
//! reducts of one peak), and decides the pairs again
//! [Knuth-1970-simple_word_problems_universal_algebras], § 7. The kernel reads
//! the derived rule beside the written ones as one of `add`'s.
//!
//! - see: #338
//! - cites: [Knuth-1970-simple_word_problems_universal_algebras]
//!
//! [Knuth-1970-simple_word_problems_universal_algebras]: https://doi.org/10.1016/B978-0-08-012975-4.50028-X "Knuth and Bendix, Simple Word Problems in Universal Algebras"

/// The naturals with addition and an operation whose two rules part at a
/// call.
@[ normalizes("swap(Zero, Succ(Zero)) ~> Succ(Zero)") ]
data NatSwap : Type where {
  | Zero : NatSwap
  | Succ : (n : NatSwap) --> NatSwap
  oper add : (m : NatSwap, n : NatSwap) --> NatSwap;
  oper swap : (m : NatSwap, n : NatSwap) --> NatSwap;
  rule : add Zero n ==> n;
  rule : add (Succ m) n ==> Succ (add m n);
  rule : swap m n ==> add m n;
  rule : swap Zero n ==> add n Zero;
}

/// Zero swapped with one, where the two rules overlap.
@[ runs("Succ Zero") ]
def zero_swap_one() -> NatSwap { swap Zero (Succ Zero) }
