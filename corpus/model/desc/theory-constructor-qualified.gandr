// A qualified constructor has the form `Family.Constructor`.
//
// A pattern can use a qualified constructor.
//
// A value can use a qualified constructor.
// Qualification selects `Theory` when a source constructor has the same name.
//
// - see: #354
// - see: #2428

/// Trees have an application constructor named `App`.
data Tree : Type where
  | Var : (n : Integer) --> Tree
  | App : (t : Tree, u : Tree) --> Tree

/// This presentation reads `Theory`.
theory Pointed where
  sort P : Type;
  oper point : () --> (p : P);

/// This match selects the `Theory.App` link.
def isApplication(link : Theory) -> Integer =
  match link where
    | Theory.App(head, arguments) => 1
    | _ => 0

/// This value tests a qualified theory application.
@[ runs("1") ]
def theoryApplied() -> Integer { isApplication (Theory.App "f" Theory.End) }

/// The bare `App` is this source's.
@[ runs("App (Var 0) (Var 1)") ]
def bare() -> Tree { App (Var 0) (Var 1) }

/// Qualification keeps a source constructor's meaning.
@[ runs("App (Var 0) (Var 1)") ]
def qualified() -> Tree { Tree.App (Var 0) (Var 1) }
