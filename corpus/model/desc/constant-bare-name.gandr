//! A theory constant written by its bare name in a rule and in a sort index.
//!
//! A constant is an operation of no input, `oper bot : Grade`. A rule side
//! and an index term name it as they name a variable, by its bare name. The
//! theory declares the name as a constant, so the reader reads that constant
//! and not a variable. A name that the theory does not declare stays a
//! variable, as `e` and `y` do here.

/// Choice with cut over a grade-indexed sort: `cutLeft` commits to the left
/// branch whatever grade the right one stands at.
@[normalizes("orBot(cut, fail) ~> cut")]
theory GradedCut where
  sort Grade : Type;
  sort M(g : Grade) : Type;

  oper bot : Grade;
  oper top : Grade;
  oper cut : M bot;
  oper fail : M top;
  oper orBot : (x : M bot, y : M e) --> M bot;

  rule cutLeft : orBot cut y ==> cut;
