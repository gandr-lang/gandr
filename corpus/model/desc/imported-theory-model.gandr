// A model of a `theory` block another source declares: `Model(S)` reads an
// imported block as it reads a local one (#726).

// The naturals' signature, `theory Nat`.
import "./second-order-signatures.gandr" ;

/// A counting model of the imported naturals: the carrier is the integers,
/// zero is `0` and the successor adds one.
module Counting : Model(Nat) {
  type Nat = Integer;

  def zero() -> Integer { 0 }

  def succ(n : Integer) -> Integer { n + 1 }

  /// Two successors of zero: the derived operations run.
  @[ runs("2") ]
  def two() -> Integer {
    run z <- zero() ;
    succ(succ(z))
  }
}
