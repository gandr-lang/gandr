//! `tactics-over-goals` models tactic splices in value positions.
//!
//! `assumption` returns the innermost binder whose type is the goal.
//! `intro` builds a function from a tactic answer under an introduced binder.
//! The pathological twin refuses a missing answer, a wrong goal, an untyped
//! splice, an unknown tactic, and a computation splice.
//!
//! The checker runs each tactic, checks its answer against the goal, and
//! fills the splice.
//! The kernel replays the filled declaration.
//!
//! - see: #2762
/// `pick` uses `assumption` to select the innermost integer binder.
def pick(a : Integer, u : Unit, b : Integer) -> Integer { ~assumption }

/// `picked` applies `pick` and receives its `b` argument.
@[ runs("3") ]
def picked() -> Integer { pick 1 *{} 3 }

/// `id` is the integer identity that `intro assumption` writes.
def id : Integer -> Integer = ~intro assumption;

/// `identity` applies `id` to five.
@[ runs("5") ]
def identity() -> Integer { id 5 }

/// `poly` is the polymorphic identity that two introductions produce.
def poly : (a : Type, a) -> a = ~intro (intro assumption);

/// `polyApplied` applies `poly` to an integer.
@[ runs("7") ]
def polyApplied() -> Integer { poly Integer 7 }
