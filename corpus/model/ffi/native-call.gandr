// A foreign call: an extern block binds a C library's functions under an
// alias, and a run calls them as effects at the host seam (#327). The
// lowering does not reach the extern block yet (#327).

/// The test library's adder and string length (#327).
@[ refuses("OutOfFragment.extern_block") ]
extern "c" from "./testlib" as testlib {
  def gandr_test_add(a: i64, b: i64) -> i64;
  def gandr_test_strlen(s: CStr) -> u64;
}

/// The run target adds twenty-one to itself and measures a string; the
/// lowering reads no projection yet (#1106), and `testlib` is the extern
/// block's (#327).
@[ refuses("OutOfFragment.projection_expression") ]
{
  run doubled <- testlib.gandr_test_add(21i64, 21i64);
  run length <- testlib.gandr_test_strlen("hello");
  pure (doubled, length)
}
