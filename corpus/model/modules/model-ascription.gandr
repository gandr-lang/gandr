//! This source shows model ascription.
//!
//! A transparent ascription exposes a model carrier.
//! A sealed ascription hides that carrier.
//!
//! The checker derives a model signature from the theory.
//! It checks model laws as proof members.
//!
//! - see: #746
//! - cites: [Kaposi-2024-secondorder_generalised_algebraic_theories_signatures_firstorder_semantics]
//! - cites: [Rossberg-2014-fing_modules]
//!
//! [Kaposi-2024-secondorder_generalised_algebraic_theories_signatures_firstorder_semantics]: https://doi.org/10.4230/LIPIcs.FSCD.2024.10 "Kaposi and Xie, Second-Order Generalised Algebraic Theories: Signatures and First-Order Semantics"
//! [Rossberg-2014-fing_modules]: https://doi.org/10.1017/S0956796814000264 "Rossberg, Russo and Dreyer, F-ing Modules"

/// `Counter` states a carrier, a start and a step. It has no laws, so it is an
/// ML signature.
pub theory Counter where
  sort C : Type;
  oper start : () --> C;
  oper step : (c : C) --> C;

/// `Open` exposes `Integer` as its carrier.
module Open : Model(Counter) where
  type C = Integer;

  def start() -> Integer { 0 }

  def step(n : Integer) -> Integer { n + 1 }

/// `Sealed` hides its integer carrier.
module Sealed :> Model(Counter) where
  type C = Integer;

  def start() -> Integer { 0 }

  def step(n : Integer) -> Integer { n + 1 }

/// `openTwice` reads two transparent steps.
@[runs("2")]
def openTwice() -> Integer { let s = Open.start (); Open.step (Open.step s) }

/// `sealedTwice` returns two sealed steps.
def sealedTwice() -> Sealed.C { let s = Sealed.start (); Sealed.step (Sealed.step s) }

/// `Toggle` states an involutive step law.
theory Toggle where
  sort T : Type;
  oper flip : (t : T) --> T;
  rule twice : flip (flip t) <=> t;

/// `Bit` has two states.
data Bit : Type where
  | Low : Bit
  | High : Bit

/// `Bits` proves the toggle law by conversion.
module Bits : Model(Toggle) where {
  type T = Bit;

  def flip(b : Bit) -> Bit =
    match b where
      | Low => High
      | High => Low

  /// `twice` proves the law by cases.
  @[checks]
  def twice(b : Bit) -> Path(flip (flip b), b) =
    match b where
      | Low => Path.here Low
      | High => Path.here High
}

/// `flippedTwice` runs the toggle twice.
@[runs("Low")]
def flippedTwice() -> Bit { Bits.flip (Bits.flip Low) }
