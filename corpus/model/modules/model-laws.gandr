// This source shows laws in a theory model.
//
// Each model proves every stated law at its carrier.
// A host primitive can admit a law that the host provides.
//
// The checker fills an omitted law when its sides convert.
// An included theory carries its laws into each model.
//
// - see: #2356
// - see: #4112
// - see: pathological/modules/model-laws.gandr

/// `Lawful` states an equivalence decision.
theory Lawful where
  sort Carrier : Type;
  oper alike : (a : Carrier, b : Carrier) --> Bool;
  law refl : (a : Carrier) -> Path[.A = Bool](alike a a, true);
  law sym : (a : Carrier, b : Carrier) -> Path[.A = Bool](alike a b, alike b a);
  law trans : (
    a : Carrier,
    b : Carrier,
    c : Carrier,
    p : Path[.A = Bool](alike a b, true),
    q : Path[.A = Bool](alike b c, true)
  ) -> Path[.A = Bool](alike a c, true);

/// `Single` has one value.
data Single : Type where
  | Only : Single

/// `LawfulSingle` proves every law by conversion.
module LawfulSingle : Model(Lawful) with sort Carrier = Single where
  def alike(a : Single, b : Single) -> Bool { true }
  def refl(a : Single) -> Path(alike a a, true) { Path.here true }
  def sym(a : Single, b : Single) -> Path(alike a b, alike b a) { Path.here true }
  def trans(
    a : Single,
    b : Single,
    c : Single,
    p : Path(alike a b, true),
    q : Path(alike b c, true)
  ) -> Path(alike a c, true) =
    Path.here true

/// `LawfulOmitted` lets the checker fill each law.
module LawfulOmitted : Model(Lawful) with sort Carrier = Single where
  /// `alike` returns true for every pair.
  def alike(a : Single, b : Single) -> Bool { true }

/// `LawfulInteger` admits the laws that the host provides for integers.
module LawfulInteger : Model(Lawful) with sort Carrier = Integer where
  def alike(a : Integer, b : Integer) -> Bool { a == b }
  law refl = ~admitted;
  law sym = ~admitted;
  law trans = ~admitted;

/// `threeIsThree` uses the admitted integer model.
@[ runs("+{.0 = *{}}") ]
def threeIsThree() -> Bool { LawfulInteger.alike 3 3 }

/// `LawfulOrder` adds order to `Lawful`.
theory LawfulOrder where
  include Lawful;
  oper below : (a : Carrier, b : Carrier) --> Bool;

/// `LawfulOrderInteger` includes `LawfulInteger`.
module LawfulOrderInteger : Model(LawfulOrder) with sort Carrier = Integer where
  include LawfulInteger;
  def below(a : Integer, b : Integer) -> Bool { a < b }

/// `decide` uses any lawful model.
def decide[l : Model Lawful](a : l.Carrier, b : l.Carrier) -> Bool { l.alike a b }

/// `twoIsNotThree` passes the order model as a lawful model.
@[ runs("+{.1 = *{}}") ]
def twoIsNotThree() -> Bool { decide[.l = LawfulOrderInteger] 2 3 }
