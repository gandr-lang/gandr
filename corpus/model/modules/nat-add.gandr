//! This source shows a transparent module signature.
//!
//! `NatAdd` exposes its carrier as `Integer`.
//!
//! The checker reads each module member at that exposed carrier.
//!
//! - cites: [Harper-1994-a_type_theoretic_approach_to_higher_order_modules_with_sharing]
//!
//! [Harper-1994-a_type_theoretic_approach_to_higher_order_modules_with_sharing]: https://doi.org/10.1145/174675.176927 "Harper and Lillibridge, A Type-Theoretic Approach to Higher-Order Modules with Sharing"

/// `NatAdd` exposes integer addition through its signature.
module NatAdd : *{type M = Integer, zero : M, add : (M, M) -> M} where {
  /// `zero` gives the additive unit.
  @[runs("0")]
  def zero = 0;
  /// `add` adds two integers.
  @[checks]
  def add(x : Integer, y : Integer) -> Integer { x + y }
}
