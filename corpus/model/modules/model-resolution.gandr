// An omitted model implicit resolved (#739): a call that leaves out the model
// a function quantifies over passes the one module in scope that is a model of
// its theory at the types its explicit arguments force. No module is marked
// as an instance: every module whose ascription is `Model(Count)`, or a model
// of a theory including `Count`, is a candidate. `model-resolution-swapped`
// imports the same two modules the other way round, and resolves alike.
import "./model-resolution-tally.gandr" ;
import "./model-resolution-up.gandr" ;
import "./model-resolution-flips.gandr" ;

/// The integers force `Up`.
@[ runs("5") ]
def counted() -> Integer { advanced(4) }

/// A flag forces `Flips`, a tally through its include.
@[ runs("1") ]
def flipped() -> Integer { advanced((false : Bool)) }
