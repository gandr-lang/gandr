// A type member at a source's top level: `type T = τ;` names `τ` for the
// declarations written after it, as a module's member names it for the
// module's.

/// #1834: a rubric's band, in millionths.
pub type Band = #{low : Integer, high : Integer};

/// The band every rubric of the set grades against.
def setBand : Band = #{low = 200000, high = 800000};

/// The width of a band, its fields read through the synonym.
pub def width(band : Band) -> Integer {
  case band {
    #{.low = low, .high = high} => high - low
  }
}

/// The set's band is six tenths wide.
@[ runs("600000") ]
def setWidth() -> Integer { width(setBand) }

/// A pair of one type, a synonym with a parameter.
pub type Twice(a : Type) = a * a;

/// The set's bounds as a pair.
def bounds : Twice(Integer) = (200000, 800000);
