// A resetting tally of flags, in a source of its own (#739).
import "./model-resolution-tally.gandr";

/// Flipping a flag, and resetting it.
module Flips : Model(ResetCount) {
  type C = Bool;
  /// Down.
  @[ checks ]
  def zero = false;
  /// The other way.
  @[ checks ]
  def incr(c : Bool) -> Bool { case c { true => false, false => true } }
  /// One when up.
  @[ checks ]
  def read(c : Bool) -> Integer { case c { true => 1, false => 0 } }
  /// Down again.
  @[ checks ]
  def reset(c : Bool) -> Bool { false }
}
