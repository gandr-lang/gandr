/// This source shows recursive module members.
///
/// `Counting` and `Iterating` each contain a recursive definition. A module
/// groups a recursive definition with the definitions beside it. A fold over
/// the terms of a model is a functor member that calls itself.
///
/// The checker resolves a recursive member one stage below its definition.
/// A client resolves every member through its module path.
///
/// - see: #4145

/// `Nat` defines natural numbers.
data Nat : Type where
  /// `Zero` gives no count.
  | Zero : Nat
  /// `Succ` adds one.
  | Succ : (n : Nat) --> Nat

/// `Counting` holds two recursive functions.
module Counting where {
  /// `double` doubles a natural number.
  def rec double(n : Nat) -> Nat =
    match n where
      | Zero => Zero
      | Succ(k) => Succ (Succ (double[<] k))

  /// `half` rounds a natural number down.
  @[checks]
  def rec half(n : Nat) -> Nat =
    match n where
      | Zero => Zero
      | Succ(m) => match m where
        | Zero => Zero
        | Succ(k) => Succ (half[<] k)
}

/// `twoDoubled` calls `Counting.double`.
@[runs("Succ (Succ (Succ (Succ Zero)))")]
def twoDoubled : () -> Nat = Counting.double (Succ (Succ Zero));

/// `halved` calls `Counting.half`.
@[runs("Succ (Succ Zero)")]
def halved : () -> Nat = Counting.half (Succ (Succ (Succ (Succ Zero))));

/// `Stepping` states a carrier and a step.
theory Stepping where
  /// `M` names the carrier.
  sort M : Type;
  /// `step` advances the carrier.
  oper step : (x : M) --> M;

/// `Iterating` steps a model value once per successor.
module Iterating(S : Model(Stepping)) where
  /// `times` iterates the model step.
  def rec times(n : Nat, x : S.M) -> S.M =
    match n where
      | Zero => x
      | Succ(k) => S.step (times[<] k x)

/// `Up` steps integers by one.
module Up : Model(Stepping) where
  /// `M` names `Integer`.
  type M = Integer;

  /// `step` adds one.
  def step(x : Integer) -> Integer { x + 1 }

/// `UpIterated` applies `Iterating` to `Up`.
module UpIterated = Iterating(Up);

/// `threeStepsUp` iterates the step three times.
@[runs("7")]
def threeStepsUp() -> Integer { UpIterated.times (Succ (Succ (Succ Zero))) 4 }
