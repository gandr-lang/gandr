// This source shows an importer through a flow.
//
// A package moves on while its importers stay. A flow presents a newer package
// at an older signature. This source also defines a flow that adds scaling. A
// renaming presents the newer package at the older signature too.
//
// The checker reads a flow as a functor between theory models. It resolves
// each imported member through the selected flow. It reads a renamed member as
// the source member that the renaming names. A flow member that is the name of
// a domain member alone binds the declaration of the source. Any other flow
// member is the code of this importer.
//
// - see: #3378
// - see: #3461
// - see: model/modules/translated-newer.gandr
// - see: pathological/modules/translated.gandr
/// `Legacy` states the older answer.
theory Legacy where
  /// The answer.
  oper answer : Integer;

/// `Scaling` adds a scaled answer.
theory Scaling where
  /// `answer` names the older reply.
  oper answer : Integer;
  /// `scaled` multiplies by the count.
  oper scaled : (n : Integer) --> Integer;

/// `Current` states a reply and a count.
theory Current where
  /// `reply` names the current answer.
  oper reply : Integer;
  /// `count` names the current count.
  oper count : Integer;

/// `scaling` presents `Current` as `Scaling`.
flow scaling : Current ~~> Scaling where
  def answer = reply;

  def scaled(n : Integer) -> Integer { n * count }

// The import reads the published flow at `Legacy`.
import "./translated-newer.gandr" as published : Legacy via downgrade;

// The import reads the local flow at `Scaling`.
import "./translated-newer.gandr" as counted : Scaling via scaling;

// The import reads the newer package at `Legacy`, its `reply` named `answer`.
import "./translated-newer.gandr" as renamed : Legacy renaming { reply as answer };

/// `relayed` reads the published answer.
@[runs("42")]
def relayed() -> Integer { published.answer }

/// `recounted` reads the local-flow answer.
@[runs("42")]
def recounted() -> Integer { counted.answer }

/// `doubled` scales two by the count.
@[runs("6")]
def doubled() -> Integer { counted.scaled 2 }

/// `renamedAnswer` reads the answer through the renaming.
@[runs("42")]
def renamedAnswer() -> Integer { renamed.answer }
