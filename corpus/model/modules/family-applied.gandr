// A module's family applied through its name, as `Shapes.Opt(Integer)`.
//
// A client reaches a module's family only through the module's name. A model
// of a theory with an indexed sort supplies the sort as such a family.
//
// A type family member expands over its arguments, as the family does applied
// inside the module. A data family member stands at its arguments, and its
// constructor builds and opens a value through the module's name.
//
// - see: #3051 — the qualified head's argument list
// - see: `pathological/modules/family-applied.gandr` — an application of
//   another count, refused

/// Options.
data Maybe(a : Type) : Type where
  /// None.
  | Nothing : Maybe(a)
  /// One.
  | Just : (x : a) --> Maybe(a)

/// A module of families.
module Shapes where
  /// A family of option types.
  type Opt(a : Type) = Maybe(a);
  /// A family of pairs over two types.
  type Pair(a : Type, b : Type) = a * b;
  /// A box of one value.
  data Box(a : Type) : Type where
    /// The box.
    | Hold : (x : a) --> Box(a)

/// The family's expansion is the option type at `Integer`.
@[ runs("Just 1") ]
def opts() -> Shapes.Opt(Integer) { Just 1 }

/// The pair family takes both of its types.
@[ runs("(1, +{.0 = *{}})") ]
def paired() -> Shapes.Pair(Integer, Bool) { *{1, true} }

/// The data family at `Integer`, built by its constructor.
@[ runs("Shapes.Hold 2") ]
def boxed() -> Shapes.Box(Integer) { Shapes.Hold 2 }

/// A match opens the box through the module's constructor.
@[ runs("2") ]
def opened() -> Integer =
  match force boxed { | Shapes.Hold(x) => x }
