//! This source shows a sealed counter.
//!
//! `Seed` exposes an abstract counter type and its operations.
//!
//! The checker keeps `Seed.T` separate from `Integer`. Only the members that
//! the signature exposes reach a value of `Seed.T`. A run prints such a value
//! as opaque at the seal, because the source does not mark `Seed.T` as
//! `mobile`.
//!
//! - cites: [Harper-1994-a_type_theoretic_approach_to_higher_order_modules_with_sharing]
//!
//! [Harper-1994-a_type_theoretic_approach_to_higher_order_modules_with_sharing]: https://doi.org/10.1145/174675.176927 "Harper and Lillibridge, A Type-Theoretic Approach to Higher-Order Modules with Sharing"

// This import provides `Seed`.
import "./functor-pair.gandr";

/// `one` steps `Seed` at its abstract type.
@[runs("⟨opaque at Seed⟩ : () -> Seed.T")]
def one() -> Seed.T { Seed.next Seed.zero }

/// `shown` reads the abstract value through `Seed.read`.
@[runs("1")]
def shown() -> Integer { let n = force one; Seed.read n }
