// A module sealed by a signature, after ML's opaque ascription (Harper and
// Lillibridge, _A Type-Theoretic Approach to Higher-Order Modules with
// Sharing_, POPL 1994, doi:10.1145/174675.176927): outside the seal its type
// is abstract, so a value of it is reached only through the members the
// signature exposes.

// The sealed counter `Seed`.
import "./functor-pair.gandr" ;

/// One step from the counter's zero, a value of its abstract type.
@[ runs("1") ]
def one() -> Seed.T { Seed.next(Seed.zero) }

/// That value read back through the exposed reader.
@[ runs("1") ]
def shown() -> Integer { run n <- force one ; Seed.read(n) }
