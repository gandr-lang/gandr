//! This source shows functors over theory models.
//!
//! A functor parameter has the signature that its theory derives.
//! A model signature can also satisfy that parameter.
//!
//! The checker matches each functor argument by member name.
//! The lowering preserves each model sort in the functor body.
//!
//! - see: #1226
//! - see: #1764
//! - cites: [Kaposi-2024-secondorder_generalised_algebraic_theories_signatures_firstorder_semantics]
//!
//! [Kaposi-2024-secondorder_generalised_algebraic_theories_signatures_firstorder_semantics]: https://doi.org/10.4230/LIPIcs.FSCD.2024.10 "Kaposi and Xie, Second-Order Generalised Algebraic Theories: Signatures and First-Order Semantics"

/// `Mag` states a carrier and a binary operation.
theory Mag where
  sort M : Type;
  oper mul : (x : M, y : M) --> M;

/// `Times` models multiplication on integers.
pub module Times : Model(Mag) where
  type M = Integer;

  def mul(a : Integer, b : Integer) -> Integer { a * b }

/// `Squaring` multiplies an element by itself.
module Squaring(S : Model(Mag)) where
  def square(x : S.M) -> S.M { S.mul x x }

/// `TimesSquared` applies `Squaring` to `Times`.
module TimesSquared = Squaring(Times);

/// `nine` squares three.
@[ runs("9") ]
def nine() -> Integer { TimesSquared.square 3 }

/// `Plus` provides the magma signature over integer addition.
module Plus : *{ type M, mul : (M, M) -> M } where
  type M = Integer;

  def mul(a : Integer, b : Integer) -> Integer { a + b }

/// `PlusSquared` applies `Squaring` to `Plus`.
module PlusSquared = Squaring(Plus);

/// `six` doubles three.
@[ runs("6") ]
def six() -> Integer { PlusSquared.square 3 }

/// `Semi` adds associativity to `Mag`.
theory Semi where
  sort M : Type;
  oper mul : (x : M, y : M) --> M;
  rule assoc : mul (mul x y) z ==> mul x (mul y z);

/// `Reassociating` reverses a semigroup associativity path.
module Reassociating(S : Model(Semi)) where
  /// `reassoc` reads associativity from right to left.
  def reassoc(x : S.M, y : S.M, z : S.M) -> Path(
    S.mul x (S.mul y z),
    S.mul (S.mul x y) z
  ) =
    Path.back (S.assoc x y z)

/// `OnePoint` models a semigroup with one value.
module OnePoint : Model(Semi) where
  type M = Unit;

  def mul(a : Unit, b : Unit) -> Unit { *{} }

  /// `assoc` proves associativity by conversion.
  def assoc(x : Unit, y : Unit, z : Unit) -> Path(
    mul (mul x y) z,
    mul x (mul y z)
  ) =
    Path.here (*{})

/// `OnePointReassociated` applies `Reassociating`.
module OnePointReassociated = Reassociating(OnePoint);

/// `reassociated` gives the reversed law at three units.
def reassociated() -> Path(*{}, *{}) =
  OnePointReassociated.reassoc (*{}) (*{}) (*{})
