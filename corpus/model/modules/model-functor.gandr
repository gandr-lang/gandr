// A functor over a theory's models (#1226): a parameter written `(S :
// Model(T))` takes the signature the theory `T` derives, its sorts abstract
// in the body and its operations values at the types the theory states, and
// an application matches its argument against that signature by name, so a
// module ascribed the record signature the theory presents is an argument
// as a model is. After Kaposi and Xie (_Second-Order Generalised Algebraic
// Theories: Signatures and First-Order Semantics_, FSCD 2024,
// doi:10.4230/LIPIcs.FSCD.2024.10), under which a module signature is a
// theory and a parameterised module the static half of a functor.

/// A magma: a carrier and a binary operation on it.
@[ checks ]
theory Mag {
  sort M : Type;
  oper mul : (x : M, y : M) --> M;
}

/// The integers under multiplication, a model of the magma.
module Times : Model(Mag) {
  type M = Integer;

  def mul(a : Integer, b : Integer) -> Integer { a * b }
}

/// Squaring in any magma: an element multiplied by itself.
module Squaring(S : Model(Mag)) {
  def square(x : S.M) -> S.M { S.mul(x, x) }
}

/// Squaring the integers under multiplication.
module TimesSquared = Squaring(Times);

/// Three squared.
@[ runs("9") ]
def nine() -> Integer { TimesSquared.square(3) }

/// The integers under addition, ascribed the record signature the magma
/// presents rather than its model signature.
module Plus : #{ type M, mul : (M, M) => M } {
  type M = Integer;

  def mul(a : Integer, b : Integer) -> Integer { a + b }
}

/// Doubling, as squaring the integers under addition.
module PlusSquared = Squaring(Plus);

/// Three doubled.
@[ runs("6") ]
def six() -> Integer { PlusSquared.square(3) }

/// A semigroup: a magma whose multiplication is associative.
@[ checks ]
theory Semi {
  sort M : Type;
  oper mul : (x : M, y : M) --> M;
  rule assoc : mul(mul(x, y), z) ==> mul(x, mul(y, z));
}

/// A semigroup's law read at any of its models: the parameter states the law
/// at its own multiplication, so the body can turn it round (#1764).
module Reassociating(S : Model(Semi)) {
  /// Associativity, read right to left.
  @[ checks ]
  def reassoc(x : S.M, y : S.M, z : S.M) -> Path(
    S.M,
    S.mul(x, S.mul(y, z)),
    S.mul(S.mul(x, y), z)
  ) {
    back(S.assoc(x, y, z))
  }
}

/// The one-point semigroup: every product is the unit.
module OnePoint : Model(Semi) {
  type M = Unit;

  def mul(a : Unit, b : Unit) -> Unit { unit }

  /// Associativity, by computation: both sides are the unit.
  @[ checks ]
  def assoc(x : Unit, y : Unit, z : Unit) -> Path(
    Unit,
    mul(mul(x, y), z),
    mul(x, mul(y, z))
  ) {
    here(unit)
  }
}

/// The law turned round at the one-point semigroup.
module OnePointReassociated = Reassociating(OnePoint);

/// The turned law at three units, whose products are all the unit.
@[ checks ]
def reassociated() -> Path(Unit, unit, unit) {
  OnePointReassociated.reassoc(unit, unit, unit)
}
