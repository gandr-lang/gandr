// This source supplies an integer model of `Count`.
//
// `Up` increments and reads an integer carrier.
//
// The checker can select this model from an integer argument.
//
// - see: #739
import "./model-resolution-tally.gandr";

/// `Up` counts integers by one.
module Up : Model(Count) where
  type C = Integer;
  /// `zero` gives zero.
  def zero = 0;
  /// `incr` adds one.
  def incr(c : Integer) -> Integer { c + 1 }
  /// `read` returns the count.
  def read(c : Integer) -> Integer { c }
