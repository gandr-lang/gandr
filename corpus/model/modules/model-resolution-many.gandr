// Many models in scope (#2395): sixteen models of `Count`, each at a carrier
// of its own, and one body calling `advanced` once at each carrier. Every call
// leaves its model implicit out, so the checker tries each of the sixteen
// candidates at each of the sixteen slots, against one solver store holding
// all of their holes: the hotpath series' `many candidates` workload.
import "./model-resolution-tally.gandr" ;

/// The carrier of the tally numbered 0.
@[ checks ]
data Tag0 : Type {
  Mark0 : Tag0;
}

/// A tally over `Tag0`, reading 0.
module Tally0 : Model(Count) {
  type C = Tag0;
  /// The one mark.
  @[ checks ]
  def zero = Mark0;
  /// A step leaves the mark as it is.
  @[ checks ]
  def incr(c : Tag0) -> Tag0 { c }
  /// The tally's number.
  @[ checks ]
  def read(c : Tag0) -> Integer { 0 }
}

/// The carrier of the tally numbered 1.
@[ checks ]
data Tag1 : Type {
