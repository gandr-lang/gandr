/// Each mark forces its own tally: the readings add up to 0 + 1 + … + 15.
@[ runs("120") ]
def summed() -> Integer {
  advanced(Mark0)
    + advanced(Mark1)
    + advanced(Mark2)
    + advanced(Mark3)
    + advanced(Mark4)
    + advanced(Mark5)
    + advanced(Mark6)
    + advanced(Mark7)
    + advanced(Mark8)
    + advanced(Mark9)
    + advanced(Mark10)
    + advanced(Mark11)
    + advanced(Mark12)
    + advanced(Mark13)
    + advanced(Mark14)
    + advanced(Mark15)
}
