// This source measures model resolution with many candidates.
//
// Sixteen `Count` models each provide one distinct carrier.
//
// The checker resolves `advanced` once for each carrier. It tries each of the
// sixteen candidates at each of the sixteen slots, against one solver store
// that holds all of their holes.
//
// - see: #2395
import "./model-resolution-tally.gandr";

/// `Tag0` is carrier zero.
data Tag0 : Type where
  | Mark0 : Tag0

/// `Tally0` reads zero.
module Tally0 : Model(Count) where
  type C = Tag0;
  /// The one mark.
  def zero = Mark0;
  /// A step leaves the mark as it is.
  def incr(c : Tag0) -> Tag0 { c }
  /// The tally's number.
  def read(c : Tag0) -> Integer { 0 }

/// `Tag1` is carrier one.
data Tag1 : Type where
  | Mark1 : Tag1

/// `Tally1` reads one.
module Tally1 : Model(Count) where
  type C = Tag1;
  /// The one mark.
  def zero = Mark1;
  /// A step leaves the mark as it is.
  def incr(c : Tag1) -> Tag1 { c }
  /// The tally's number.
  def read(c : Tag1) -> Integer { 1 }

