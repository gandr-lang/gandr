// A type member another source writes at its top level names its type in a
// source importing it unqualified, as each of its declarations does.

// The band, its width and the parameterised pair.
import "./top-level-type.gandr" ;

/// A narrower band, written at the imported synonym.
@[ checks ]
def innerBand : Band = #{low = 400000, high = 600000} ;

/// The imported width reads the band built here: two tenths.
@[ runs("200000") ]
def innerWidth() -> Integer { width(innerBand) }

/// The imported synonym with a parameter, applied here.
@[ checks ]
def innerBounds : Twice(Integer) = (400000, 600000) ;
