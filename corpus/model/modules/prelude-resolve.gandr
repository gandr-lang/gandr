// This source shows prelude model resolution.
//
// The prelude provides `Eq` and `Ord` models for integers and strings.
// `EqPoint` derives equality for a point.
//
// The checker resolves each comparison from its operand carrier.
//
// - see: #2395

/// A point in the plane.
data Point : Type where
  | Point : (x : Integer, y : Integer) --> Point

/// Points under `==`, compared field by field.
module EqPoint : Model(Eq) with sort Carrier = Point where {
  /// Both coordinates, in order.
  @[checks]
  def eq = Eq.generic Point;

  /// Every point is equal to itself.
  @[checks]
  def refl = Eq.generic.refl Point;

  /// Equality reads the same from either side.
  @[checks]
  def sym = Eq.generic.sym Point;
}

/// Two integers alike.
@[runs("+{.0 = *{}}")]
def sameCount() -> Bool { 3 == 3 }

/// One integer below another.
@[runs("+{.0 = *{}}")]
def fewer() -> Bool { 2 < 3 }

/// Two names alike.
@[runs("+{.0 = *{}}")]
def sameLabel() -> Bool { "here" == "here" }

/// One name below another.
@[runs("+{.1 = *{}}")]
def laterLabel() -> Bool { "there" < "here" }

/// Two points alike, through the derived member.
@[runs("+{.0 = *{}}")]
def samePlace() -> Bool { Point 1 2 == Point 1 2 }

/// Two points apart in one coordinate.
@[runs("+{.1 = *{}}")]
def movedPlace() -> Bool { Point 1 2 == Point 1 3 }
