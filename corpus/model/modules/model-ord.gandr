// This source shows the prelude `Ord` model.
//
// The integer and string models order values of their carrier. `OrdInteger`
// answers with the integer primitives, so its verdicts are theirs. `OrdString`
// orders strings byte by byte, as a Rust `BTreeMap<String, _>` does.
//
// The checker resolves each comparison from the operand type. The operators
// `<`, `<=`, `>` and `>=` call the prelude functions `lt`, `le`, `gt` and `ge`.
// Each `Ord` model includes its `Eq` model. So `==` still resolves at both.
//
// - see: #2333

/// `alphabetical` compares the first distinct byte.
@[runs("+{.0 = *{}}")]
def alphabetical() -> Bool { "alpha" < "beta" }

/// `reversed` rejects reverse alphabetical order.
@[runs("+{.1 = *{}}")]
def reversed() -> Bool { "beta" < "alpha" }

/// `prefix` orders a prefix before its longer name.
@[runs("+{.0 = *{}}")]
def prefix() -> Bool { "alp" < "alpha" }

/// `capital` compares byte values.
@[runs("+{.0 = *{}}")]
def capital() -> Bool { "Zeta" < "alpha" }

/// `nameAtMost` compares equal names.
@[runs("+{.0 = *{}}")]
def nameAtMost() -> Bool { "alpha" <= "alpha" }

/// `above` reverses a comparison.
@[runs("+{.0 = *{}}")]
def above() -> Bool { "beta" > "alpha" }

/// `atLeast` rejects a lower name.
@[runs("+{.1 = *{}}")]
def atLeast() -> Bool { "alpha" >= "beta" }

/// `integerOrder` uses the integer `Ord` model.
@[runs("+{.0 = *{}}")]
def integerOrder() -> Bool { - 4 < 9 }

/// `sameName` resolves one string equality model. `EqString` and the `Eq`
/// reduct of `OrdString` are one elaboration.
@[runs("+{.0 = *{}}")]
def sameName() -> Bool { "alpha" == "alpha" }

/// `least` selects the lower value through `Ord`.
def least[o : Model Ord](a : o.Carrier, b : o.Carrier) -> o.Carrier =
  if o.lt b a { b } else { a }

/// `leastName` selects the lower string.
@[runs("\"alpha\"")]
def leastName() -> String { least "beta" "alpha" }

/// `leastNumber` selects the lower integer.
@[runs("3")]
def leastNumber() -> Integer { least 3 4 }

/// `across` rejects operands with different carriers.
@[refuses("TypeMismatch")]
def across() -> Bool { "three" < 3 }

/// `flagOrder` rejects a carrier with no `Ord` model.
@[refuses("ModelUnanswered")]
def flagOrder() -> Bool { (true : Bool) < false }
