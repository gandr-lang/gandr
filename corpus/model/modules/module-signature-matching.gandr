// This source shows module signature matching.
//
// `Metrics` exposes the members that its signature states.
//
// The checker matches type and value members by name. A definition gives a type
// member. A member that the signature omits stays inside the module.
//
// - see: #2917

/// `Metrics` exposes a type and three values.
module Metrics : *{type Ratio = Integer, base : Integer, double : Integer, scale : Ratio} where {
  /// `scratch` stays outside the signature.
  def scratch = 2;
  /// `double` tests an unsynthesised operator result. The call of the operator
  /// is pure, so the value stands as what the call returns.
  @[checks]
  def double = scratch * 3;
  /// `base` gives seven.
  def base = 7;
  /// `scale` gives one.
  def scale = 1;
}

/// `visible` tests an unsynthesised exported sum.
@[refuses("NotSynthesisable")]
def visible = Metrics.base + Metrics.double + Metrics.scale;

/// `wrapped` tests a record that names refused `visible`.
@[refuses("UnknownConstant")]
def wrapped = *{visible = visible};
