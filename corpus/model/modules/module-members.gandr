// A module's members see the names around it and each other, a nested
// module's members are reached through its name, and the signature exports
// only the members it states.

/// A seed every member builds on.
@[ checks ]
def seed = 40;

/// The facts, with one nested module; the signature hides `hidden_reply`,
/// `base` and `inner.hidden`.
module Facts : #{ inner: #{ answer: Integer }, total: Integer } {
  /// A shell command's reply; the lowering admits no shell block yet (#1057).
  @[ refuses("OutOfFragment.shell_block") ]
  def hidden_reply = #!{ printf 'hidden module member ran\n'; };
  /// The seed and the reply's exit code. An operator is a computation, and a
  /// definition with no stated type reads its value where nothing infers
  /// that computation's type.
  @[ refuses("NotSynthesisable") ]
  def base = seed + hidden_reply.exit_code + 1;
  /// A nested module whose `hidden` the signature leaves out.
  module inner : #{ answer: Integer } {
    /// The enclosing module's base, whose type is unknown while `base` is
    /// refused.
    @[ refuses("UnknownConstant") ]
    def hidden = base;
    /// One more than the base, refused with it.
    @[ refuses("UnknownConstant") ]
    def answer = base + 1;
  }
  /// The nested answer, one more: the nested module's member is named
  /// through its name. An operator in a value runs before the computation
  /// around it, and a definition's value has none.
  @[ refuses("UnenclosedRun") ]
  def total = inner.answer + 1;
}

/// The exported total, one more. An operator is a computation, and a
/// definition with no stated type reads its value where nothing infers that
/// computation's type.
@[ refuses("NotSynthesisable") ]
def after = Facts.total + 1;

/// The run target gathers both in a record; `after` is refused above, so it
/// names a declaration whose type is not known.
@[ refuses("UnknownConstant") ]
#{after = after, total = Facts.total}
