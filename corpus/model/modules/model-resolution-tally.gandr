// This source defines candidates for model resolution.
//
// `Count` has one carrier, a zero, a step and a reading.
//
// The checker can resolve any `Model(Count)` implicit.
//
// - see: #739

/// A tally: a carrier, a zero, a step and a reading.
pub theory Count where
  sort C : Type;
  oper zero : C;
  oper incr : (c : C) --> C;
  oper read : (c : C) --> Integer;

/// A tally that also resets.
pub theory ResetCount where
  include Count;
  oper reset : (c : C) --> C;

/// The reading after one step, over any tally the slot names.
pub def advanced[s : Model Count](c : s.C) -> Integer { s.read (s.incr c) }
