// This source shows a nested model.
//
// An outer model holds an inner model as one operation.
//
// The checker resolves inner members through the outer model path.
// A seal also hides the inner model carrier.
//
// - see: #1311

/// The theory of `module-members.gandr`'s nested `#{ answer: Integer }`.
theory Answering where
  oper answer : Integer;

/// The theory of its outer `#{ inner: #{ answer: Integer }, total: Integer }`.
pub theory Faceted where
  oper inner : Model Answering;
  oper total : Integer;

/// The facts: the nested answer and the total beside it.
module Facts : Model(Faceted) where {
  /// The nested model.
  module inner : Model(Answering) where {
    /// The answer.
    @[ checks ]
    def answer = 41;
  }
  /// The total.
  @[ checks ]
  def total = 42;
}

/// The nested answer, read through the outer model.
@[ runs("41") ]
def nested_answer() -> Integer { Facts.inner.answer }

/// A theory with an abstract sort, the carrier a sealed model hides.
theory Carrier where
  sort T : Type;
  oper zero : T;

/// The theory of a model that holds a `Carrier` model under `inner`.
theory Outer where
  oper inner : Model Carrier;

/// A model sealed at `Outer`: the nested model's sort is an atom outside.
pub module Sealed :> Model(Outer) where
  /// The nested model, its carrier the integers inside the seal.
  module inner : Model(Carrier) where
    /// The carrier.
    type T = Integer;
    /// The point.
    def zero = 0;

/// The nested point, at the nested sort written as a path through `inner`.
def kept : Sealed.inner.T = Sealed.inner.zero;
