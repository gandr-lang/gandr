//! This source shows manifest model types.
//!
//! A manifest model type fixes one sort in a theory model. The type is a
//! family in the fixed sort. So equivalent sort types give equivalent manifest
//! model types. This is the structure identity principle at a fixed sort, after
//! § 2.14 of the HoTT book and the manifest types of Leroy.
//!
//! The checker applies each fixed sort to the other model components.
//! Transport moves the model fields along an equivalent sort.
//!
//! - see: #1480
//! - see: #2129
//! - cites: [Leroy-1994-manifest_types_modules_and_separate_compilation]
//!
//! [Leroy-1994-manifest_types_modules_and_separate_compilation]: https://doi.org/10.1145/174675.176926 "Leroy, Manifest Types, Modules, and Separate Compilation"
import "./model-ascription.gandr";

/// `toLeft` reassociates three sum states to the left.
def toLeft(c : Unit + (Unit + Unit)) -> (Unit + Unit) + Unit =
  match c where
    | +{.0 = u} => +{.0 = +{.0 = u}}
    | +{.1 = +{.0 = u}} => +{.0 = +{.1 = u}}
    | +{.1 = +{.1 = u}} => +{.1 = u}

/// `toRight` reassociates three sum states to the right.
def toRight(c : (Unit + Unit) + Unit) -> Unit + (Unit + Unit) =
  match c where
    | +{.0 = +{.0 = u}} => +{.0 = u}
    | +{.0 = +{.1 = u}} => +{.1 = +{.0 = u}}
    | +{.1 = u} => +{.1 = +{.1 = u}}

/// `nestings` proves that the two sum types are equivalent. The two maps are
/// inverse by computation.
def nestings : Path[.A = Type](Unit + (Unit + Unit), (Unit + Unit) + Unit) = equiv toLeft toRight;

/// `countersOn` fixes a counter carrier.
def countersOn(x : Type) -> Type =
  return type(Model Counter with sort C = x)

/// `oneSharing` transports a manifest model type.
def oneSharing() -> Path[.A = Type](
  Model Counter with sort C = Unit + (Unit + Unit),
  Model Counter with sort C = (Unit + Unit) + Unit
) { Path.ap countersOn nestings }

/// `onward` advances a three-state counter.
def onward(c : Unit + (Unit + Unit)) -> Unit + (Unit + Unit) =
  match c where
    | +{.0 = u} => +{.1 = +{.0 = u}}
    | +{.1 = +{.0 = u}} => +{.1 = +{.1 = u}}
    | +{.1 = +{.1 = u}} => +{.0 = u}

/// `first` gives the first right-nested state.
def first() -> Unit + (Unit + Unit) =
  +{.0 = *{}}

/// `rightward` packages a counter with the right nesting. The carrier is no
/// field, so the record holds the start and the step.
def rightward : Model Counter with sort C = Unit + (Unit + Unit) = *{
  .start = first,
  .step = onward
};

/// `leftward` transports the counter to the left nesting.
def leftward : Model Counter with sort C = (Unit + Unit) + Unit = Path.walk (fun (x) {
  type(Model Counter with sort C = x)
}) nestings rightward;

/// `stepOnce` steps a right-nested counter.
def stepOnce(m : Model Counter with sort C = Unit + (Unit + Unit)) -> Unit + (Unit + Unit) =
  match m where
    | *{.start = s, .step = t} => t (s ())

/// `second` gives the second right-nested state.
@[runs("+{.1 = +{.0 = *{}}}")]
def second() -> Unit + (Unit + Unit) { stepOnce rightward }

/// `stepOnceLeft` steps a left-nested counter.
def stepOnceLeft(m : Model Counter with sort C = (Unit + Unit) + Unit) -> (Unit + Unit) + Unit =
  match m where
    | *{.start = s, .step = t} => t (s ())

/// `secondLeft` transports the second state to the left nesting.
@[runs("+{.0 = +{.1 = *{}}}")]
def secondLeft() -> (Unit + Unit) + Unit { stepOnceLeft leftward }

/// `inlineLeft` transports the counter inside the call.
@[runs("+{.0 = +{.1 = *{}}}")]
def inlineLeft() -> (Unit + Unit) + Unit =
  stepOnceLeft (Path.walk (fun (x) { type(Model Counter with sort C = x) }) nestings rightward)

/// `Thirds` models a right-nested three-state counter.
module Thirds : Model(Counter) where
  /// `C` names the right-nested carrier.
  type C = Unit + (Unit + Unit);

  /// `start` gives the first state.
  def start() -> Unit + (Unit + Unit) { first () }

  /// `step` advances the state.
  def step(c : Unit + (Unit + Unit)) -> Unit + (Unit + Unit) { onward c }

/// `secondThirds` passes `Thirds` at its manifest carrier. `Thirds` omits the
/// carrier that the parameter fixes.
@[runs("+{.1 = +{.0 = *{}}}")]
def secondThirds() -> Unit + (Unit + Unit) { stepOnce Thirds }

/// `thirds` packages `Thirds` at its manifest type.
def thirds : Model Counter with sort C = Unit + (Unit + Unit) = Thirds;

/// `secondPacked` steps the packed counter.
@[runs("+{.1 = +{.0 = *{}}}")]
def secondPacked() -> Unit + (Unit + Unit) { stepOnce thirds }
