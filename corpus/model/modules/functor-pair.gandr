// Generative functors, after ML's generative module semantics (Rossberg,
// Russo and Dreyer, _F-ing Modules_, doi:10.1017/S0956796814000264): a
// functor applied twice to one argument mints a fresh abstract type at each
// application, and each application's members run through the argument
// they were built from.

/// A counter sealed by its signature: an abstract type, its zero, a step and
/// a reader.
module Seed :> #{ type T, zero : T, next : T => T, read : T => Integer } {
  type T = Integer;
  /// The counter's zero.
  @[ runs("0") ]
  def zero = 0;
  /// One step on.
  @[ runs("fn (a) { a + 1 }") ]
  def next(n : T) -> -F T { n + 1 }
  /// The count read as an integer.
  @[ runs("fn (a) { a }") ]
  def read(n : T) -> -F Integer { n }
}

/// A functor from any counter to a sealed counter of its own: its seed,
/// step and reader are the argument's.
module MkCounter(S : #{
  type T,
  zero : T,
  next : T => T,
  read : T => Integer
}) :> #{ type T, seed : T, step : T => T, read : T => Integer } {
  type T = S.T;
  def seed = S.zero;
  def step = S.next;
  def read = S.read;
}

/// The functor's first application.
module A = MkCounter(Seed) ;
/// Its second, whose type is not the first's.
module B = MkCounter(Seed) ;

/// One step of the first application, at its own abstract type.
@[ runs("1") ]
def a_once() -> -F (A.T) { A.step(A.seed) }

/// Two steps of the second application, read back as an integer.
@[ runs("2") ]
def b_twice() -> -F Integer { run one <- B.step(B.seed) ; B.read(B.step(one)) }
