// A signature whose fields come in another order than the module's members:
// matching is by name, so the order is no refusal, and a member the
// signature leaves out stays inside.

/// A module whose signature lists its members last first.
module Ordered : *{ third : Integer, first : Integer, second : Integer } where {
  /// The first value.
  def first = 1;
  /// A member the signature leaves out.
  def hidden = 99;
  /// One more than the first. The operator's call is pure, so the value
  /// stands as what the call returns.
  @[ checks ]
  def second = first + 1;
  /// One more than the second, for the same reason.
  @[ checks ]
  def third = second + 1;
}

/// The three gathered in a record, each member typed by the signature.
def together = *{a = Ordered.first, b = Ordered.second, c = Ordered.third};
