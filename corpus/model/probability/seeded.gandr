// One program draws a word of four bits, and three models of `std.rand.Eff`
// answer its draws: the host's entropy, the seeded generator `std.rand.lcg`
// and the exact model.
//
// A generator written in the language answers the same draws as the host.
// With a constant seed, each run gives the same draws. So a test sees one
// outcome. Over a uniform seed, the output of the generator is uniform too.
//
// `gandr run seeded.gandr` exits with a word from the host's entropy. Under
// `lcg 8 0`, the state goes from 0 to 79 and then to 50, so the word is 4.
// The exact model runs `word` once for each of its 16 paths, each at the
// weight `1/16`. At the width 8, a step of the generator is a bijection on
// the 256 states. So over a uniform seed of 8 bits, the top two bits of the
// first output take each value at `1/4`.
//
// - see: `library/std/src/rand.gandr` — `lcg` and its constants
// - see: `draws.gandr` — the same three models, with a fixed list for the
//   second
// - see: #5713

// The seeded generator, a model of the host interface of randomness.
import std.rand (lcg);

/// A word of four bits: two draws of two bits, the first draw high.
@[ distributes((
  "1/16 0",
  "1/16 1",
  "1/16 2",
  "1/16 3",
  "1/16 4",
  "1/16 5",
  "1/16 6",
  "1/16 7",
  "1/16 8",
  "1/16 9",
  "1/16 10",
  "1/16 11",
  "1/16 12",
  "1/16 13",
  "1/16 14",
  "1/16 15"
)) ]
pub def word() -> [std.rand.Eff] Integer =
  let high = std.rand.draw 2
  let low = std.rand.draw 2
  high * 4 + low

/// `word` under the generator of width 8 from the seed 0.
@[ runs("4") ]
def replayed() -> [std.rand.Eff] Integer =
  lcg 8 0 (thunk { word () })

/// The first output of the generator over a uniform seed of 8 bits: its top
/// two bits take each value at `1/4`.
@[ distributes(("1/4 0", "1/4 1", "1/4 2", "1/4 3")) ]
def firstOutput() -> [std.rand.Eff] Integer =
  let seed = std.rand.draw 8
  lcg 8 seed (thunk { std.rand.draw 2 })

/// The entry: exit with a word from the host's entropy.
def main() -> [std.rand.Eff] Integer =
  word ()
