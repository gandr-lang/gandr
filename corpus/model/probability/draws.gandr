// A program sums two draws of two fair bits through `std.rand.Eff`, the host
// interface of randomness.
//
// Each `draw` names a width in bits, and the host replies an integer uniform
// over `[0, 2^width)` from the entropy source of the operating system. The
// sum of two draws of two bits lies from 0 to 6, and the program exits with
// it.
//
// `gandr run draws.gandr` exits with the sum and prints nothing. The same
// `summed` runs under a handler of this source, a second model of the
// interface that answers each draw from a fixed list. The corpus runs
// `summed` under a third model, the exact one. It runs once for each of the
// 16 sequences of answers, and each path weighs `2^-4`. Its `distributes`
// states the weight of each sum: the count of pairs that give the sum, over
// 16.
//
// - see: `crates/surface-dispatcher/src/evaluate/rand.rs` — the host that
//   serves the interface, and the exact model's answers
// - see: `crates/surface-corpus/src/distribution.rs` — the runs summed into
//   one distribution
// - see: `crates/surface-driver/tests/rand.rs` — the run and its range

// The native finite lists.
import std.list (List);
// The host interface of randomness.
import std.rand;

/// The sum of two integers, each a draw of two bits: 0 and 6 come from one
/// pair each, 3 from four pairs.
@[ distributes(("1/16 0", "1/8 1", "3/16 2", "1/4 3", "3/16 4", "1/8 5", "1/16 6")) ]
pub def summed() -> [std.rand.Eff] Integer =
  let first = std.rand.draw 2
  let second = std.rand.draw 2
  first + second

/// The head of `rest`, or 0 when `rest` is empty.
def headOr(rest : List Integer) -> Integer =
  match rest where
    | #[] => 0
    | #[head, .._] => head

/// The tail of `rest`, or the empty list when `rest` is empty.
def tailOf(rest : List Integer) -> List Integer =
  match rest where
    | #[] => #[]
    | #[_, ..tail] => tail

/// `summed` under a handler of this source, a second model of `std.rand.Eff`:
/// a function of a list, which answers each draw with the next integer of the
/// list, and with 0 past its end.
def summedFrom() -> (List Integer -> Integer) =
  handle r : std.rand.Eff {
    let total = summed ();
    pure fun (rest : List Integer) { pure total }
  } with {
    | pure(x) => pure x
    | oper draw(width, k) => pure fun (rest : List Integer) {
      let next = headOr rest;
      let after = tailOf rest;
      let g = k next;
      g after
    }
  }

/// `summedFrom` over `#[3, 2]`: the sum is 5.
@[ runs("5") ]
def summedModelled() -> Integer =
  let answer = summedFrom ()
  answer #[3, 2]

/// The entry: exit with the sum of two draws of two bits.
def main() -> [std.rand.Eff] Integer =
  summed ()
