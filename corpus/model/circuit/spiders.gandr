//! `spiders` models a sort that carries a special commutative Frobenius
//! algebra, and a circuit rule whose wires merge on it.
//!
//! The spiders of an orthonormal basis copy and merge its states. Without the
//! mark, the lowering refuses each such merge at its shared port.
//!
//! `@[ frobenius ]` marks the sort `Q`. The rule `merge` writes no node for
//! the merge: its wire map repeats the name `z`. The lowering reads the merge
//! as a spider and decides the rule as a diagram, modulo the Frobenius laws.
//!
//! - see: corpus/pathological/circuit/spiders-unmarked.gandr — the same rule over an unmarked sort
//! - cites: [Coecke-Kissinger-2017-picturing_quantum_processes]
//!
//! [Coecke-Kissinger-2017-picturing_quantum_processes]: https://doi.org/10.1017/9781316219317 "Coecke and Kissinger, Picturing Quantum Processes"

/// `Qubit` marks its sort, so a circuit rule may merge and split its wires.
theory Qubit where
  /// A wire that merges and splits.
  @[frobenius]
  sort Q : Type;
  /// A node with one input and one output.
  oper f : (a : Q) --> (b : Q);
  /// A second node of the same shape.
  oper g : (a : Q) --> (b : Q);

  /// `f` and `g` both write `z`: one spider merges their outputs.
  rule merge : (data x : Q, data y : Q) <=> (z : Q) {
    node : f(x) --> (z);
    node : g(y) --> (z);
  };
