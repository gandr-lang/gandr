//! `scripts-compute` reads host output as a string.
//!
//! The lowering refuses shell blocks.
//!
//! A later block computes on the output of an earlier block.
//!
//! - see: #1057 — `searched`

/// `searched` prints a host banner and searches its output for `gandr`.
@[refuses("OutOfFragment.shell_block")]
def searched() -> Bool =
  let banner = #!{ printf 'hello from gandr\n'; };
  string.contains banner.stdout "gandr"
