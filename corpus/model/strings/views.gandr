//! This source models string views.
//!
//! A view lends a held string for one access. It does not own the string. A
//! view cannot outlive its access.
//!
//! `resume` writes a string back. `abort` preserves the held string and runs
//! `unwind`. A region keeps a view until its scope ends. The runtime erases
//! this static extent.
//!
//! - cites: [Koronkevich-2025-type_universes_kripke_worlds]
//! - cites: [Racordon-2023-borrow_checking_hylo]
//! - cites: [boats-2024-references_are_jumps]
//!
//! [Koronkevich-2025-type_universes_kripke_worlds]: https://doi.org/10.1145/3747532 "Koronkevich and Bowman, Type Universes as Kripke Worlds"
//! [Racordon-2023-borrow_checking_hylo]: https://2023.splashcon.org/details/iwaco-2023-papers/5/Borrow-checking-Hylo "Racordon and Abrahams, Borrow checking Hylo"
//! [boats-2024-references_are_jumps]: https://without.boats/blog/references-are-like-jumps/ "boats, References are like jumps"

// This source imports declarations for lists, bytes, ownership, locations and
// writes.
import "../data/data-base.gandr";
import "./string-base.gandr";
import "./nul-terminated.gandr";
import "./small-string.gandr";
import "./copy-on-write.gandr";
// This import provides the host interface for early exit.
import std.process;

/// This test reads `hi` through a view.

// The access restores the unchanged string.
@[ runs("3") ]
def readThrough() -> Integer =
  var s = Inline (Cons 104 (Cons 105 (Cons 0 Nil)) : List(Integer))
  access s as v { resume v v };
  count (bytes s)

/// `writeThrough` appends `!` through a view.
/// The access writes the changed string back.
@[ runs("Cons 104 (Cons 105 (Cons 33 (Cons 0 Nil)))") ]
def writeThrough() -> List(Integer) =
  var s = Inline (Cons 104 (Cons 105 (Cons 0 Nil)) : List(Integer))
  access s as v { let w = push v 33; let t = written w; resume v t };
  bytes s

/// This test aborts an access.

// The held string remains unchanged.
@[ runs("Cons 104 (Cons 105 (Cons 0 Nil))") ]
def abandoned() -> List(Integer) =
  var s = Inline (Cons 104 (Cons 105 (Cons 0 Nil)) : List(Integer))
  access s as v { abort v } unwind { pure *{} };
  bytes s

/// `twiceThrough` performs two accesses in sequence.
/// The second access reads the first write.
@[ runs("Cons 104 (Cons 105 (Cons 33 (Cons 33 (Cons 0 Nil))))") ]
def twiceThrough() -> List(Integer) =
  var s = Inline (Cons 104 (Cons 105 (Cons 0 Nil)) : List(Integer))
  access s as v { let w = push v 33; let t = written w; resume v t };
  access s as v { let w = push v 33; let t = written w; resume v t };
  bytes s

/// `keptInRegion` retains a view in the enclosing region.
/// The view reads an unchanged string after its access ends.
@[ runs("3") ]
def keptInRegion() -> Integer =
  var s = Inline (Cons 104 (Cons 105 (Cons 0 Nil)) : List(Integer))
  handle c : std.process.Exit.Eff {
    let k : (() -> Integer) at c = access shared s as w {
      pure count (bytes w)
    };
    force k
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => pure 0
  }
