// A view: a string held for a block is lent to a view for one access, and the
// view does not own it. The view reads the string it lends, and the access
// ends it exactly once: `resume` writes a string back, `abort` leaves the held
// string as it was and runs the access's `unwind` clause. The view lives only
// for its access, so no annotation names how long it lives (the yield-once
// accessor of Hylo's subscripts, Racordon and Abrahams, "Borrow checking
// Hylo", IWACO 2023; boats, "References are like jumps"). A view the program
// keeps longer is kept in the region of a scope around it, `at c`, and lives as
// long as that scope: a static extent erased before anything runs (Koronkevich
// and Bowman, _Type Universes as Kripke Worlds_, ICFP 2025,
// doi:10.1145/3747532).

// The lists; the byte lists; the owned bytes; where they live; the writes.
import "../data/data-base.gandr";
import "./string-base.gandr";
import "./nul-terminated.gandr";
import "./small-string.gandr";
import "./copy-on-write.gandr";

/// The length of `hi` read through a view, which writes it back unchanged:
/// its two bytes and the zero.
@[ runs("3") ]
def readThrough() -> Integer {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  access s as v { resume(v, v) };
  count(bytes(s))
}

/// `!` appended through a view and written back: after the access the held
/// string's bytes are the written one's.
@[ runs("Cons(104, Cons(105, Cons(33, Cons(0, Nil))))") ]
def writeThrough() -> List(Integer) {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  access s as v { run w <- push(v, 33); run t <- written(w); resume(v, t) };
  bytes(s)
}

/// An access that aborts writes nothing back: the held string's bytes are as
/// they were.
@[ runs("Cons(104, Cons(105, Cons(0, Nil)))") ]
def abandoned() -> List(Integer) {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  access s as v { abort(v) } unwind { pure unit };
  bytes(s)
}

/// Two accesses in turn, each seeing the write the one before left.
@[ runs("Cons(104, Cons(105, Cons(33, Cons(33, Cons(0, Nil)))))") ]
def twiceThrough() -> List(Integer) {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  access s as v { run w <- push(v, 33); run t <- written(w); resume(v, t) };
  access s as v { run w <- push(v, 33); run t <- written(w); resume(v, t) };
  bytes(s)
}

/// A view kept past its access in the region of the scope around it: it lives
/// as long as that scope rather than the access, and reads the string after
/// the access has ended, its two bytes and the zero. The held string stays as
/// it was until the scope ends.
@[ runs("3") ]
def keptInRegion() -> Integer {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  handle c : Proc {
    run k : (() => Integer) at c <- access shared s as w {
      pure count(bytes(w))
    };
    force k
  } with {
    pure(x) => pure x,
    oper exit(code, k) => pure 0
  }
}
