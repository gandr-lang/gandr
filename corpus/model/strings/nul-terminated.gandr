// This source models C strings from owned strings.
//
// An owned string ends with one zero byte. The C standard reads this layout.
// Rust's `CStr` borrows the same layout. An interior zero prevents a C
// reading.
//
// `terminated` adds the final zero. `cView` borrows valid bytes without a copy
// or re-encoding.
//
// - cites: [Rust-CStr]
//
// [Rust-CStr]: https://doc.rust-lang.org/std/ffi/struct.CStr.html "Rust, CStr in std::ffi"

// This source imports declarations for lists, bytes and UTF-8 encoding.
import "../data/data-base.gandr";
import "./string-base.gandr";
import "./utf8.gandr";

/// `CView` records how C reads a byte list.
/// It borrows a list with one final zero and reports `Interior` for earlier
/// zeroes.
data CView : Type where
  | Borrowed : (bytes : List Integer) --> CView
  | Interior : CView

/// This function adds a final zero to encoded code points.
pub def terminated(cs : List Integer) -> List Integer =
  concat (encodeAll cs) (Cons 0 Nil : List Integer)

/// `cView` borrows a byte list when its only zero ends the list.
/// It reports `Interior` for an interior zero.
def rec cView(bs : List Integer) -> CView =
  match bs where
    | Nil => Interior
    | Cons(b, rest) => {
      let zero = b == 0;
      let left = count rest;
      let last = left == 0;
      match last where
        | true =>
          match zero where
            | true => Borrowed bs
            | false => Interior
        | false => {
          match zero where
            | true => Interior
            | false => {
              let tail = cView[<] rest;
              match tail where
                | Borrowed(t) => Borrowed bs
                | Interior => Interior
            }
        }
    }

/// `hi` builds an owned `hi` string with a zero.
@[ runs("Cons 104 (Cons 105 (Cons 0 Nil))") ]
def hi() -> List Integer { terminated (Cons 104 (Cons 105 Nil) : List Integer) }

/// `hiForC` lets C borrow the stored `hi` bytes.
@[ runs("Cons 104 (Cons 105 (Cons 0 Nil))") ]
def hiForC() -> List Integer { let bs = force hi; let v = cView bs; match v {
  | Borrowed(t) => t
  | Interior => Nil
} }

/// This test refuses a string with an interior zero.
@[ runs("Interior") ]
def cut() -> CView =
  cView (terminated (Cons 104 (Cons 0 (Cons 105 Nil)) : List Integer))

/// This test refuses bytes without a final zero.
@[ runs("Interior") ]
def unterminated() -> CView { cView (Cons 104 (Cons 105 Nil) : List Integer) }
