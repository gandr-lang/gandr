// An owned string ends in one zero byte, so a C function reads its bytes as
// they are held: the owned string is already the C string, with no copy and
// no re-encoding at the boundary (the C standard's string, ISO/IEC 9899:2018,
// § 7.1.1; Rust's `CStr` is the borrowed form of the same layout). A string
// with a zero inside it has no C reading, and the boundary says so instead of
// cutting it short.

// The lists; the byte lists; the UTF-8 encoder.
import "../data/data-base.gandr";
import "./string-base.gandr";
import "./utf8.gandr";

/// What C reads of a byte list: the list itself, borrowed, when its one zero
/// is its last byte; nothing when a zero comes earlier.
data CView : Type where {
  | Borrowed : (bytes : List(Integer)) --> CView
  | Interior : CView
}

/// An owned string's bytes: the code points encoded, then the terminating
/// zero.
pub def terminated(cs : List(Integer)) -> List(Integer) {
  concat(encodeAll(cs), (Cons(0, Nil) : List(Integer)))
}

/// The C reading of a byte list: borrowed whole when the only zero is the
/// last byte, refused at an interior zero.
def rec cView(bs : List(Integer)) -> CView {
  match bs {
    Nil => Interior,
    Cons(b, rest) => {
      let zero = b == 0;
      let left = count(rest);
      let last = left == 0;
      match last {
        true => {
          match zero {
            true => Borrowed(bs),
            false => Interior
          }
        },
        false => {
          match zero {
            true => Interior,
            false => {
              let tail = cView[<](rest);
              match tail {
                Borrowed(t) => Borrowed(bs),
                Interior => Interior
              }
            }
          }
        }
      }
    }
  }
}

/// `hi`, owned: its two bytes and the zero.
@[ runs("Cons(104, Cons(105, Cons(0, Nil)))") ]
def hi() -> List(Integer) { terminated((Cons(104, Cons(105, Nil)) : List(Integer))) }

/// C reads `hi` as the bytes it is held in: it borrows them whole.
@[ runs("Cons(104, Cons(105, Cons(0, Nil)))") ]
def hiForC() -> List(Integer) { let bs = force hi; let v = cView(bs); match v {
  Borrowed(t) => t,
  Interior => Nil
} }

/// A zero inside the string: C would stop at it, so it has no C reading.
@[ runs("Interior") ]
def cut() -> CView {
  cView(terminated((Cons(104, Cons(0, Cons(105, Nil))) : List(Integer))))
}

/// Bytes with no terminating zero have no C reading either.
@[ runs("Interior") ]
def unterminated() -> CView { cView((Cons(104, Cons(105, Nil)) : List(Integer))) }
