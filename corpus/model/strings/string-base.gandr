//! This source defines shared string declarations.
//!
//! Every string source reads byte storage through these declarations. A copy
//! does not expose another string's write. Short strings use inline bytes.
//! Long strings share a buffer until a write.
//! Both follow the small-string representations of C++ and Rust.
//!
//! `Repr` selects byte storage. The source provides byte functions and inline
//! capacity.
//!
//! - cites: [Racordon-2022-implementation_strategies_mutable_value_semantics]
//!
//! [Racordon-2022-implementation_strategies_mutable_value_semantics]: https://doi.org/10.5381/jot.2022.21.2.a2 "Racordon et al., Implementation strategies for mutable value semantics"

// This source imports declarations for lists.
import "../data/data-base.gandr";

/// `Repr` records where a string stores its bytes.
/// It stores inline bytes or a shared heap buffer with a holder count.
pub data Repr : Type where
  | Inline : (bytes : List Integer) --> Repr
  | Shared : (holders : Integer, bytes : List Integer) --> Repr

/// This function returns a string's bytes.
pub def bytes(s : Repr) -> List Integer =
  match s where
    | Inline(bs) => bs
    | Shared(n, bs) => bs

/// This function counts bytes in a list.
pub def rec count(bs : List Integer) -> Integer =
  match bs where
    | Nil => 0
    | Cons(b, rest) => { let n = count[<] rest; n + 1 }

/// This function joins two byte lists.
pub def rec concat(xs : List Integer, ys : List Integer) -> List Integer =
  match xs where
    | Nil => ys
    | Cons(x, rest) => (Cons x (concat[<] rest ys) : List Integer)

/// `inlineCapacity` gives the inline byte count.
/// The count includes the terminating zero.
@[ runs("24") ]
pub def inlineCapacity : Integer = 24;
