// Copy-on-write pays for a holder count it reads at every write, even when
// the string is held once. A write that reads no count is sound exactly where
// the string has one holder: there it writes what copy-on-write writes, and on
// a shared string it would write the buffer another string reads. So where the
// program states that a string is not copied for a scope, the count and its
// branch can go (Racordon et al., "Implementation strategies for mutable value
// semantics", _Journal of Object Technology_ 21(2), 2022,
// doi:10.5381/jot.2022.21.2.a2, § 4: uniqueness-elided copies). The statement
// is a grade on the string: `hold[1] s = e;` holds a string made where the hold
// stands, which nothing else holds while it is held, and the checker refuses a
// grade-one hold of a string that may have been copied. The items below show
// the write the grade licenses, and on what.

// The lists; the byte lists; the owned bytes; where they live; the writes.
import "../data/data-base.gandr";
import "./string-base.gandr";
import "./nul-terminated.gandr";
import "./small-string.gandr";
import "./copy-on-write.gandr";

/// `b` appended with no holder count read: inline bytes as `push` writes
/// them, a heap buffer written where it is, whoever holds it.
def pushInPlace(s : Repr, b : Integer) -> Written {
  case s {
    Inline(bs) => push(s, b),
    Shared(n, bs) => Written(Shared(n, beforeZero(bs, b)), 0)
  }
}

/// The number of strings holding a string's bytes: one for inline bytes.
def holders(s : Repr) -> Integer {
  case s {
    Inline(bs) => 1,
    Shared(n, bs) => n
  }
}

/// On a long string held once, the write that reads no count copies nothing,
/// as copy-on-write does.
@[ runs("0") ]
def aloneCopies() -> [Div] Integer { run s <- force long; copies(pushInPlace(s, 33)) }

/// And its written buffer has the one holder copy-on-write's has.
@[ runs("1") ]
def aloneHolders() -> [Div] Integer {
  run s <- force long;
  run w <- pushInPlace(s, 33);
  holders(written(w))
}

/// On a copy it writes the buffer the original reads too: the written buffer
/// still has two holders, so the original would see the write. This is the
/// write a grade must keep from a shared string.
@[ runs("2") ]
def sharedHolders() -> [Div] Integer {
  run s <- force long;
  run c <- copy(s);
  run w <- pushInPlace(c, 33);
  holders(written(w))
}

/// Under a grade-one hold the string is made in place, so the write that reads
/// no count, through the hold's exclusive view, copies nothing.
@[ runs("0") ]
def heldOnce() -> [Div] Integer {
  run bs <- repeatOnto(97, 24, (Nil : List(Integer)));
  hold[1] s = Shared(1, bs);
  access s as v { run w <- pushInPlace(v, 33); run t <- written(w); resume(v, t); copies(w) }
}

/// And the buffer it wrote back still has its one holder.
@[ runs("1") ]
def heldOnceHolders() -> [Div] Integer {
  run bs <- repeatOnto(97, 24, (Nil : List(Integer)));
  hold[1] s = Shared(1, bs);
  access s as v { run w <- pushInPlace(v, 33); run t <- written(w); resume(v, t); holders(t) }
}
