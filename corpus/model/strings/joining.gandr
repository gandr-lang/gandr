// Strings joined with `std.string`'s `concat`, its unit `empty` and the test
// `isEmpty`.
//
// The functions read the native `string` namespace, so a program joins the
// builtin `String` the checker and both executors already hold. The module
// states the monoid laws of joining beside them.
//
// Each item runs one function on literals and states its answer. The laws
// themselves are certified in the module, over joining presented as an
// operation.
//
// - see: `library/std/src/string.gandr` — the functions and the laws
// - see: `pathological/strings/joining.gandr` — a law over the definition,
//   refused
// - see: #525 — admits a law over a definition

// `empty`, `concat`, `isEmpty`.
import "../../../library/std/src/string.gandr";

/// `greeted` joins a greeting and a name.
@[ runs("\"hello, ada\"") ]
def greeted() -> String { concat("hello, ", "ada") }

/// `paddedLeft` joins the empty string before a word, which leaves the word.
@[ runs("\"ada\"") ]
def paddedLeft() -> String { concat(empty, "ada") }

/// `blank` asks whether the empty string joined to itself is empty.
@[ runs("+{.0 = unit}") ]
def blank() -> Bool { isEmpty(concat(empty, empty)) }

/// `worded` asks whether a word is empty.
@[ runs("+{.1 = unit}") ]
def worded() -> Bool { isEmpty("ada") }
