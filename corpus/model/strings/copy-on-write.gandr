//! This source shows how strings share buffers.
//!
//! A long string copy shares a buffer. A short string copy copies only inline
//! bytes. A write leaves every other string unchanged.
//!
//! The holder count controls each write. `push` copies a shared buffer before
//! it writes. It writes a buffer with one holder in place.
//!
//! - see: #1481 — `long`
//! - cites: [Racordon-2022-implementation_strategies_mutable_value_semantics]
//!
//! [Racordon-2022-implementation_strategies_mutable_value_semantics]: https://doi.org/10.5381/jot.2022.21.2.a2 "Racordon et al., Implementation strategies for mutable value semantics"

// This source imports declarations for lists, bytes, ownership and locations.
import "../data/data-base.gandr";
import "./string-base.gandr";
import "./nul-terminated.gandr";
import "./small-string.gandr";

/// `Written` records a string after a write.
/// It records 0 for an in-place write and 1 for a copied buffer.
pub data Written : Type where
  | Written : (string : Repr, copies : Integer) --> Written

/// `copy` preserves inline bytes or shares a buffer with one new holder.
pub def copy(s : Repr) -> Repr =
  match s where
    | Inline(bs) => Inline bs
    | Shared(n, bs) => Shared (n + 1) bs

/// This function places `b` before the final zero byte.
pub def rec beforeZero(bs : List Integer, b : Integer) -> List Integer =
  match bs where
    | Nil => Nil
    | Cons(x, rest) => {
      match rest where
        | Nil => (Cons b (Cons x Nil) : List Integer)
        | Cons(y, more) => (Cons x (beforeZero[<] rest b) : List Integer)
    }

/// `push` appends `b` before the terminating zero.
/// It moves a full inline string to the heap, writes an unshared buffer in
/// place and copies a shared buffer.
pub def push(s : Repr, b : Integer) -> Written =
  match s where
    | Inline(bs) => {
      let grown = beforeZero bs b;
      let stored = store grown;
      match stored where
        | Inline(kept) => Written stored 0
        | Shared(n, moved) => Written stored 1
    }
    | Shared(n, bs) => {
      let grown = beforeZero bs b;
      let alone = n == 1;
      match alone where
        | true => Written (Shared 1 grown) 0
        | false => Written (Shared 1 grown) 1
    }

/// This function counts the buffers that the write fills anew.
pub def copies(w : Written) -> Integer =
  match w where
    | Written(s, n) => n

/// This function returns the string after the write.
pub def written(w : Written) -> Repr =
  match w where
    | Written(s, n) => s

/// `long` builds a string with twenty-four bytes and a terminating zero.
/// Its loop and forced calls state `Partial`.
pub def long() -> [Partial] Repr { own (repeatOnto 97 24 (Nil : List Integer)) }

/// `alone` appends `!` to an unshared long string and copies no buffer.
@[ runs("0") ]
def alone() -> [Partial] Integer { let s = force long; copies (push s 33) }

/// `shared` appends `!` to a copied long string.
/// The write copies one buffer.
@[ runs("1") ]
def shared() -> [Partial] Integer =
  let s = force long
  let c = copy s
  copies (push c 33)

/// `untouched` preserves the original bytes after a copy receives `!`.
@[ runs("25") ]
def untouched() -> [Partial] Integer =
  let s = force long
  let c = copy s
  let w = push c 33
  count (bytes s)

/// `grown` counts the copied string after it receives `!`.
@[ runs("26") ]
def grown() -> [Partial] Integer =
  let s = force long
  let c = copy s
  let w = push c 33
  let t = written w
  count (bytes t)

/// `shout` writes `hi!` to inline bytes.
@[ runs("Inside") ]
def shout() -> Place =
  let s = own (Cons 104 (Cons 105 Nil) : List Integer)
  let w = push s 33
  place (written w)

/// `spill` moves a full inline string to the heap.
@[ runs("1") ]
def spill() -> [Partial] Integer =
  let cs = repeatOnto 97 23 (Nil : List Integer)
  let s = own cs
  copies (push s 33)
