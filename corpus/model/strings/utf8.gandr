// A string's bytes are UTF-8: each code point is written as one to four
// bytes, the leading byte saying how many follow and each following byte
// carrying six bits (The Unicode Standard, Version 15.0, § 3.9, Table 3-6).
// A string is built from code points, so its bytes are UTF-8 by construction.

// The lists; the byte lists.
import "../data/data-base.gandr" ;
import "./string-base.gandr" ;

/// A code point's UTF-8 bytes: one byte below 128, two below 2048, three below
/// 65536 and four up to the last code point.
@[ checks ]
def encode(c : Integer) -> -F List(Integer) {
  run one <- c < 128;
  case one {
    true => Cons(c, Nil),
    false => {
      run two <- c < 2048;
      case two {
        true => {
          run lead <- int.div(c, 64);
          run low <- int.mod(c, 64);
          Cons(192 + lead, Cons(128 + low, Nil))
        },
        false => {
          run three <- c < 65536;
          case three {
            true => {
              run lead <- int.div(c, 4096);
              run rest <- int.mod(c, 4096);
              run mid <- int.div(rest, 64);
              run low <- int.mod(c, 64);
              Cons(224 + lead, Cons(128 + mid, Cons(128 + low, Nil)))
            },
            false => {
              run lead <- int.div(c, 262144);
              run rest <- int.mod(c, 262144);
              run high <- int.div(rest, 4096);
              run tail <- int.mod(c, 4096);
              run mid <- int.div(tail, 64);
              run low <- int.mod(c, 64);
              Cons(240 + lead, Cons(128 + high, Cons(128 + mid, Cons(128 + low, Nil))))
            }
          }
        }
      }
    }
  }
}

/// A run of code points, each encoded in turn.
@[ checks ]
def rec encodeAll(cs : List(Integer)) -> -F List(Integer) {
  case cs {
    Nil => Nil,
    Cons(c, rest) => become concat(encode(c), encodeAll[<](rest))
  }
}

/// `$`, below 128: one byte, itself.
@[ runs("Cons(36, Nil)") ]
def dollar() -> -F List(Integer) { become encode(36) }

/// `é`, below 2048: two bytes.
@[ runs("Cons(195, Cons(169, Nil))") ]
def eAcute() -> -F List(Integer) { become encode(233) }

/// `€`, below 65536: three bytes.
@[ runs("Cons(226, Cons(130, Cons(172, Nil)))") ]
def euro() -> -F List(Integer) { become encode(8364) }

/// `😀`, past 65536: four bytes.
@[ runs("Cons(240, Cons(159, Cons(152, Cons(128, Nil))))") ]
def grin() -> -F List(Integer) { become encode(128512) }

/// `hé`: one byte, then two.
@[ runs("Cons(104, Cons(195, Cons(169, Nil)))") ]
def he() -> -F List(Integer) { become encodeAll((Cons(104, Cons(233, Nil)) : List(Integer))) }
