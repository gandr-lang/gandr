@[ refuses("SortMismatch") ]
def a_negative_type_in_an_eager_product_is_a_sort_mismatch : (Type -> Type[-]) -> Type -> Type = fun (T) {
  fun (A) { type(T(A) * A) }
};

def a_thunked_negative_type_in_an_eager_product_forms : (Type -> Type[-]) -> Type -> Type = fun (T) {
  fun (A) { type(+U (T(A)) * A) }
};

def a_negative_family_of_a_product_forms : Type -> Type[-] = fun (X) { type(-F (X * X)) };

@[ refuses("SortMismatch") ]
def a_negative_type_under_a_returner_is_a_sort_mismatch : (Type -> Type[-]) -> Type -> Type[-] = fun (T) {
  fun (A) { -F (T(A)) }
};
