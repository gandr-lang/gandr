// Static β at one classifier, the type operators `Type -> Type`: an operator
// applied in a signature reduces before the kernel reads the declaration, and
// the run never sees it. `sum` takes a pair whose type is `apply(twice,
// Integer)`, two static applications deep; `doubled` returns one. Implicit
// parameters `@[…]`, which a use supplies by name, are
// `implicit-telescope.gandr`'s.

/// Apply a type operator to a type.
def apply : (Type -> Type) -> Type -> Type = \F. \X. F(X);

/// The type of pairs of one type.
def twice : Type -> Type = \Y. Y * Y;

/// The sum of a pair whose type is an operator applied twice over. Both
/// binders are used: an unused one has no type entry under a static
/// application (#1080).
def sum(p : apply(twice, Integer)) -> Integer {
  case p {
    #{a, b} => a + b
  }
}

/// `sum` at a pair of integers runs as at `Integer * Integer`.
@[ runs("3") ]
def sumRun() -> Integer { sum((1, 2)) }

/// A pair returned at an operator's type.
def doubled(n : Integer) -> twice(Integer) {
  (n, n)
}

/// `doubled` runs to the pair the operator's reduct types.
@[ runs("(4, 4)") ]
def doubledRun() -> twice(Integer) { doubled(4) }
