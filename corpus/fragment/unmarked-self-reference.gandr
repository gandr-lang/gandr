// A recursive definition marks each call to itself: `f[<]` descends, `f[>]`
// produces, and an unmarked call is refused.
//
// A mark states why the recursion ends or stays productive, so the checker
// trusts no call it cannot classify. An unmarked call is refused
// `UnmarkedSelfReference`.
//
// The checker reads each call's mark against the definition's staged
// parameter. A descent with no parameter, or a production outside a copattern
// block, is refused.
//
// - see: #626 — `varied`
// - see: #644 — `ahead`
// - see: #1499 — `constant`, `spin`

data Nat : Type where {
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
}

@[ refuses("UnmarkedSelfReference") ]
def rec bare(n : Nat) -> -F Nat {
  match n {
    Zero => return n,
    Succ(p) => bare(p)
  }
}

def rec marked(n : Nat) -> Nat {
  match n {
    Zero => n,
    Succ(p) => marked[<](p)
  }
}

def rec idle(n : Nat) -> Nat { n }

/// A parameter written before the staged one may vary across the call: it is
/// passed to the fixpoint as a leading argument.
def rec varied(n : Nat, m : Nat) -> Nat {
  match m {
    Zero => n,
    Succ(p) => varied[<](p, p)
  }
}

/// A productive claim outside a copattern block: nothing is observed before
/// the function runs again.
@[ refuses("UnguardedCorecursion") ]
def rec ahead(n : Nat) -> -F Nat {
  match n {
    Zero => return n,
    Succ(p) => ahead[>](p)
  }
}

/// A recursive definition of no parameter binds its own name over its body,
/// which this one never calls.
def rec constant() -> Nat { Zero }

/// A descent claimed by a recursive definition of no parameter: its fixpoint
/// stands at no arrow, so the call has nothing to descend on.
@[ refuses("ShapeMismatch") ]
def rec spin() -> Nat { spin[<]() }
