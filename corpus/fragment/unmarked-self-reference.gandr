@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ refuses("UnmarkedSelfReference") ]
def rec bare(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => bare(p)
  }
}

@[ checks ]
def rec marked(n : Nat) -> Nat {
  case n {
    Zero => n,
    Succ(p) => marked[<](p)
  }
}

@[ checks ]
def rec idle(n : Nat) -> Nat { n }

/// A parameter written before the staged one may vary across the call: it is
/// passed to the fixpoint as a leading argument (#626).
@[ checks ]
def rec varied(n : Nat, m : Nat) -> Nat {
  case m {
    Zero => n,
    Succ(p) => varied[<](p, p)
  }
}

/// A productive claim outside a copattern block: nothing is observed before
/// the function runs again (#644).
@[ refuses("UnguardedCorecursion") ]
def rec ahead(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => ahead[>](p)
  }
}

/// A recursive definition of no parameter binds its own name over its body,
/// which this one never calls (#1499).
@[ checks ]
def rec constant() -> Nat { Zero }

/// A descent claimed by a recursive definition of no parameter: its fixpoint
/// stands at no arrow, so the call has nothing to descend on (#1499).
@[ refuses("ShapeMismatch") ]
def rec spin() -> Nat { spin[<]() }
