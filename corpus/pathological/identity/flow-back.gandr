module Schema {
  type Old = String * Integer;
  type New = Integer * String;
  @[ checks ]
  def toNew(old : Old) -> New {
    case old {
      #{name, age} => (age, name)
    }
  }
  @[ checks ]
  def upgrade : Flow(Type, Old, New) = forward(toNew) ;
  @[ refuses("NonCovariantMotive") ]
  def downgrade() -> Flow(Type, New, Old) {
    back(upgrade)
  }
}
