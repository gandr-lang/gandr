// What function extensionality at data types refuses: two functions that
// differ at a constructor are refused at that pattern, and a type holding
// itself, whose coverage would recur, is outside the vocabulary.

// The shapes, the figures and `Shapes.toFigure`.
import "../../model/identity/flow-data.gandr";
// `width`, a shape's first side.
import "../../model/identity/funext-data.gandr";
// The naturals and `Renumber.step`, each constructor to itself.
import "./flow-data.gandr";

/// A shape's height: a circle's radius, a rectangle's second side.
def height(shape : Shape) -> Integer {
  case shape {
    Circle(r) => r,
    Rect(w, h) => h
  }
}

/// A width and a height agree at a circle but not at a rectangle, refused at
/// that pattern.
@[ refuses("PointwiseDistinct") ]
def sides : Path(Shape => Integer, width, height) = funext(width, height);

/// #1315: a type holding itself would be covered as a list is, its own field
/// read as a tail; the coverage does not read one yet, so no function
/// extensionality decides it.
@[ refuses("FunextUnsupported") ]
def restepped : Path(Nat => Nat, Renumber.step, Renumber.step) = funext(
  Renumber.step,
  Renumber.step
);
