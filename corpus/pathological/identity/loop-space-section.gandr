// A proof by induction over the presented circle that proves nothing: it
// forgets to carry the loop, and its loop arm answers with the field's path,
// whose endpoints are not the loop's.

/// The circle, presented by its two cancellations.
data Circle : Type where {
  | Base : Circle
  | Loop : (x : Circle) --> Circle
  | Unloop : (x : Circle) --> Circle
  rule : Loop (Unloop x) ==> x;
  rule : Unloop (Loop x) ==> x;
}

/// The integers, presented the same way.
data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) ==> x;
  rule : P (S x) ==> x;
}

/// The winding number: a loop counts one up, an inverse one down.
def rec wind(c : Circle) -> Int =
  match c where
    | Base => Z
    | Loop(x) => S (wind[<] x)
    | Unloop(x) => P (wind[<] x)

/// Spinning: a successor is a loop, a predecessor an inverse.
def rec spin(n : Int) -> Circle =
  match n where
    | Z => Base
    | S(x) => Loop (spin[<] x)
    | P(x) => Unloop (spin[<] x)

/// One inverse loop more.
def unaround(c : Circle) -> Circle =
  Unloop c

/// A forged section: the loop arm answers with the field's path unchanged,
/// typed at the motive at `x`, where the arm owes the motive at `Loop(x)`:
/// a path from `Loop(spin(wind(x)))` to `Loop(x)`. The machine does not
/// decide the two path types, and the arm is refused as undecided.
@[refuses("Undecided")]
def rec forged(c : Circle) -> Path(spin (wind c), c) =
  match c where
    | Base => Path.here Base
    | Loop(x) => forged[<] x
    | Unloop(x) => { let p = forged[<] x; Path.ap unaround p }
