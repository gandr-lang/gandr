// Two proofs by induction over the loops at the book circle's point that
// prove nothing. The first forgets to carry the loop: its loop arm answers
// with the rest's path, whose endpoints are not the loop's. The second
// carries the loop but answers the inverse apart, so the two sides of a
// cancellation are two different paths.

/// The circle: one point and a loop at it.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// The integers, presented by their two cancellations.
data Int : Type {
  Z : Int;
  S : (x : Int) --> Int;
  P : (x : Int) --> Int;
  rule S(P(x)) ==> x;
  rule P(S(x)) ==> x;
}

/// The winding number: a loop counts one up, its inverse one down.
def rec wind(p : Path(Circle, Base, Base)) -> -F Int {
  case p {
    here => Z,
    loop ∷ q => S(wind[<](q)),
    back(loop) ∷ q => P(wind[<](q))
  }
}

/// Spinning: a successor is a loop, a predecessor its inverse.
def rec spin(n : Int) -> -F Path(Circle, Base, Base) {
  case n {
    Z => here(Base),
    S(x) => loop ∷ spin[<](x),
    P(x) => back(loop) ∷ spin[<](x)
  }
}

/// One loop more.
def loopOn(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  loop ∷ p
}

/// One inverse loop more.
def unloopOn(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  back(loop) ∷ p
}

/// A forged section: the loop arm answers with the rest's path unchanged,
/// typed at the motive at `q`, where the arm owes the motive at `loop ∷ q`:
/// a path from `loop ∷ spin(wind(q))` to `loop ∷ q`. The two path types do
/// not convert, and the arm is refused.
@[ refuses("TypeMismatch") ]
def rec forged(p : Path(Circle, Base, Base)) -> -F Path(
  Path(Circle, Base, Base),
  spin(wind(p)),
  p
) {
  case p {
    here => here(here(Base)),
    loop ∷ q => become forged[<](q),
    back(loop) ∷ q => { run ih <- forged[<](q); become cong(unloopOn, ih) }
  }
}

/// A path at every loop whose inverse arm drops its rest's path: each arm
/// checks at its letter, but at `loop ∷ back(loop) ∷ q` the loop arm carries
/// the inverse arm's reflexivity to `here(loop ∷ back(loop) ∷ q)`, which is
/// not the path at `q` the cancellation's right side reads. Read as a set,
/// the loops would identify the two; the words are not read as one.
@[ refuses("RuleNotRespected") ]
def rec rewound(p : Path(Circle, Base, Base)) -> -F Path(Path(Circle, Base, Base), p, p) {
  case p {
    here => here(here(Base)),
    loop ∷ q => { run ih <- rewound[<](q); become cong(loopOn, ih) },
    back(loop) ∷ q => here(back(loop) ∷ q)
  }
}
