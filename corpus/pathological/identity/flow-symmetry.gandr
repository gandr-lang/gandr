module Schema where {
  type Old = String * Integer;
  type New = Integer * String;
  type Count = Integer;
  @[checks]
  def toNew(old : Old) -> New =
    match old where
      | *{name, age} => *{age, name}
  @[checks]
  def upgrade : Flow[.A = Type](Old, New) = Flow.into toNew;
  @[refuses("NonCovariantMotive")]
  def reversed() -> Flow[.A = Type](New, Old) =
    Flow.ride (fun (X) { type(Flow[.A = Type](X, Old)) }) upgrade (Flow.stay Old)
  @[checks]
  def age(record : Old) -> Count =
    match record where
      | *{name, years} => years
  @[refuses("NonCovariantMotive")]
  def reader() -> New -> Count =
    Flow.ride (fun (X) { X -> Count }) upgrade age
}
