module Schema {
  type Old = String * Integer;
  type New = Integer * String;
  type Count = Integer;
  @[ checks ]
  def toNew(old : Old) -> New {
    case old {
      #{name, age} => (age, name)
    }
  }
  @[ checks ]
  def upgrade : Flow(Type, Old, New) = forward(toNew) ;
  @[ refuses("NonCovariantMotive") ]
  def reversed() -> Flow(Type, New, Old) {
    ride(\X. Flow(Type, X, Old), upgrade, stay(Old))
  }
  @[ checks ]
  def age(record : Old) -> Count {
    case record {
      #{name, years} => years
    }
  }
  @[ refuses("NonCovariantMotive") ]
  def reader() -> New => Count {
    ride(\X. X => Count, upgrade, age)
  }
}
