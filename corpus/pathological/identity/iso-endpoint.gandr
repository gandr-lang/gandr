// A quasi-inverse whose section is stated at the wrong endpoint. `A ≅ B`'s
// section reads `Path(A, back(to(a)), a)`, the round trip through `B`; the
// round trip through `A`, `Path(B, to(back(b)), b)`, written in its place is
// refused at that field.

// The circle, the presented integers, the winding number, spinning and their
// round trips.
import "../../model/identity/circle-base.gandr" ;

/// The loops at the point and the integers with `retr` written where `sect`
/// belongs, refused at the section: `retr` reads `Path(Int, wind(spin(n)),
/// n)` over the integers, where the section reads `Path(Path(Circle, Base,
/// Base), spin(wind(p)), p)` over the loops (#514).
@[ refuses("TypeMismatch") ]
def wrongEndpoint : Path(Circle, Base, Base) ≅ Int = (wind, (spin, (retr, retr))) ;
