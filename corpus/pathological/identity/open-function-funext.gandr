/// Past the first-order boundary: `f` is a variable, so its inputs are free
/// variables no coverage reaches, and the rule decides closed functions only.
@[ refuses("FunextUnsupported") ]
def open(f : Unit + Unit => Unit + Unit) -> -F Path(
  Unit + Unit => Unit + Unit,
  f,
  f
) {
  funext(f, f)
}
