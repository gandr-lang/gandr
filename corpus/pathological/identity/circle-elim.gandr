// Cases over the circle its loop refuses, and one it admits that looks as
// though it should not. A case over the circle owes its loop: carried along
// the loop, its answer at the point must be that answer, by conversion or by
// a loop arm at the path between the two. Last, two operations on paths,
// written with no path type stated, that their operands refuse.

/// The circle: one point and a loop at it.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// Every point joined to the point: reflexivity at `Base`, which the loop
/// carries to the loop, not to reflexivity, and no loop arm supplies the path
/// between them. The circle is not contractible.
@[ refuses("LoopNotRespected") ]
def contractible(x : Circle) -> Path(Circle, Base, x) {
  case x {
    Base => here(Base)
  }
}

/// The same nesting as `circle-rotation.gandr`'s `rotInv1`, at a fibre that
/// is no set: a point with a loop at it, a 1-type. Holding `b` at its point
/// drops the square between the two loops, which only a fibre presented as a
/// set leaves unowed, so the case is refused naming the fibre (#464).
@[ refuses("LoopNotRespected") ]
def rotTwin(a : Circle, b : Circle) -> #{centre : Circle, around : Path(Circle, a, a)} {
  case a {
    Base => case b {
      Base => #{centre = Base, around = loop}
    }
  }
}

/// The degree-two map: the loop goes round twice. A loop arm of a
/// non-dependent case chooses any loop at the image of the point, so the map
/// is admitted.
@[ checks ]
def doubled(x : Circle) -> Circle {
  case x {
    Base => Base,
    loop => loop ∷ loop ∷ here(Base)
  }
}

/// A dependent loop arm at the wrong endpoints: it owes a path from the
/// answer carried along the loop, the loop, to the answer, reflexivity, and
/// answers reflexivity at reflexivity.
@[ refuses("EndpointMismatch") ]
def misjoined(x : Circle) -> Path(Circle, Base, x) {
  case x {
    Base => here(Base),
    loop => here(here(Base))
  }
}

/// A point with a loop at it, and a second point the loop never reaches.
data Marked : Type {
  Mark : Marked;
  Elsewhere : Marked;
  turn : Mark <-> Mark;
}

/// A composite whose second path starts where the first does not end: the
/// turn ends at `Mark`, and `here(Elsewhere)` starts at `Elsewhere`. Read off
/// the turn, the composite's transport checks the turn at the path into
/// `Elsewhere`, which it is not.
@[ refuses("TypeMismatch") ]
def misjoined_then : Path(Marked, Mark, Elsewhere) = turn then here(Elsewhere) ;

/// Every point to itself, by cases: no loop arm, and the motive reads no
/// point, so the turn is owed nothing.
@[ checks ]
def kept(x : Marked) -> Marked {
  case x {
    Mark => Mark,
    Elsewhere => Elsewhere
  }
}

/// Reflexivity at the looped point, wanted at a path whose endpoints compute
/// the other point: `kept(Elsewhere)` computes `Elsewhere`, which the turn
/// never reaches, so the path is no words and `here(Mark)` does not inhabit
/// it (#485).
@[ refuses("TypeMismatch") ]
def elsewhereComputed : Path(Marked, kept(Elsewhere), kept(Elsewhere)) = here(Mark) ;

/// `cong` maps a path by a function, and the point's constructor is not one:
/// `Base` names the point, not a map out of the circle.
@[ refuses("OutOfFragment.NotAFunction") ]
def cong_at_point : Path(Circle, Base, Base) ;
def cong_at_point = cong(Base, loop) ;
