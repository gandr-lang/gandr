// The identity and flow operations stand under their formers, `Path.here`
// and `Flow.stay` among them. A bare spelling names no operation: it is an
// ordinary name, refused where no binder declares it.

/// The bare reflexivity, `here`, which no binder declares.
@[ refuses("UnresolvedName") ]
def bareHere : Path(Integer, 4, 4) = here(4);

/// A transport written bare, which no binder declares.
@[ refuses("UnresolvedName") ]
def bareTransport : Integer = transport(fun (X) { X }, Path.here(Integer), 2);

/// A directed reflexivity written bare, which no binder declares.
@[ refuses("UnresolvedName") ]
def bareStay : Flow(Integer, 4, 4) = stay(4);
