//! What a forward flow cannot decide, after directed univalence
//! [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory],
//! Definition 1.2: a translator's image may only move the source's leaves, so
//! one that writes a literal where a leaf stood is refused.
//!
//! - cites: [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]
//!
//! [Gratzer-2026-directed_univalence_simplicial_homotopy_type_theory]: https://arxiv.org/abs/2407.09146 "Gratzer, Weinberger and Buchholtz, Directed univalence in simplicial homotopy type theory"

/// A record migrated by a translator that drops a field's value.
module Schema where {
  type Old = String * Integer;
  type New = Integer * String;
  /// The translator: the age moved, the name replaced by a literal.
  def anonymise(old : Old) -> New {
    match old {
      #{name, age} => (age, "anonymous")
    }
  }
  /// A literal is no image of a source leaf, so no flow forwards by it.
  @[ refuses("ForwardUnsupported") ]
  def scrub : Flow(Type, Old, New) = Flow.into(anonymise);
}
