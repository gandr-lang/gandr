// The twin of the model's `originOther`: an atom whose type member states a
// relation and its reflexivity but no transport law. Without the law the
// relation is no identity system (Univalent Foundations Program, _Homotopy
// Type Theory_, 2013, §5.8, Theorem 5.8.2), so the atom's identity stays its
// own and the relation's evidence is no path between its points.

// The relation, its reflexivity and its transport law over the unit type.
import "../../model/identity/atom-identity.gandr" ;

/// The unit type sealed, stating the relation and its reflexivity alone.
module Lawless :> #{ type T, origin : T, other : T } {
  /// The sealed points, whose interface names no transport law.
  @[ identity((related, reflexivity)) ]
  @[ checks ]
  type T = Unit;

  /// One point.
  @[ checks ]
  def origin = unit;

  /// Another point.
  @[ checks ]
  def other = unit;
}

/// The relation's evidence between two sealed points, refused: the interface
/// names no transport law (#1784).
@[ refuses("AtomTransport") ]
def lawlessOriginOther : Path(Lawless.T, Lawless.origin, Lawless.other) = unit ;

/// The transport law at the paths of the unit type written as no pair,
/// refused: an identity in the singleton's total space is a path in the
/// unit type and one over it (#1959).
@[ refuses("TypeMismatch") ]
def unpairedContraction(a : Unit, b : Unit, r : pathRelated(a, b)) -> -F Path(
  #{ y : Unit, s : pathRelated(a, y) },
  (b, r),
  (a, pathReflexivity(a))
) { unit }

/// The unit type sealed, naming the refused law. The atom and its members
/// check against their types; the kernel withholds them with the law, as it
/// withholds every reader of a declaration that did not cross, rather than
/// faulting the source (#1959).
module UnpairedPoint :> #{ type T, origin : T, other : T } {
  /// The sealed points, whose transport law is refused.
  @[ identity((pathRelated, pathReflexivity, unpairedContraction)) ]
  @[ checks ]
  type T = Unit;

  /// One point.
  @[ checks ]
  def origin = unit;

  /// Another point.
  @[ checks ]
  def other = unit;
}
