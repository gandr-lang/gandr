module Schema {
  type Old = String * Integer;
  type New = Integer * String;
  @[ checks ]
  def toNew(old : Old) -> New {
    case old {
      #{name, age} => (age, name)
    }
  }
  @[ checks ]
  def upgrade : Flow(Type, Old, New) = forward(toNew);
  @[ refuses("Boundary") ]
  def reader : Flow(Type, Old => Integer, New => Integer) = arrow(upgrade, stay(Integer));
}
