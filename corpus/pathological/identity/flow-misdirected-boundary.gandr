module Schema where {
  type Old = String * Integer;
  type New = Integer * String;
  @[ checks ]
  def toNew(old : Old) -> New {
    match old {
      #{name, age} => (age, name)
    }
  }
  @[ checks ]
  def upgrade : Flow(Type, Old, New) = Flow.into(toNew);
  @[ refuses("Boundary") ]
  def reader : Flow(Type, Old => Integer, New => Integer) = Flow.arrow(upgrade, Flow.stay(Integer));
}
