// Pushing in a fold copies the accumulated list at each step, so the fold's
// cost is the square of the list's length.

/// Four integers, annotated as a list of them (#1544).
def steps = ([1, 2, 3, 4] : List(Integer));

/// Each element pushed in a fold, through the `list` namespace's projection
/// (#1106).
@[ refuses("OutOfFragment.projection_expression") ]
def pushed = list.reduce(thunk { fn (acc, n) { return list.push(acc, n) } }, [], steps);
