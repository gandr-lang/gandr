// A list literal refused at the element type it is stated at: the twin of
// `model/builtins/lists.gandr`.
//
// - see: #1544 — `mixed`

// The native finite lists.
import std.list (List);

/// A text among integers: the second element does not convert to the element
/// type the annotation states.
@[refuses("TypeMismatch")]
def mixed = (#[1, "two"] : List Integer);
