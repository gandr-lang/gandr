// What an annotation states is checked, not trusted: wherever it stands, the
// value it ascribes is checked against it. An annotated value is still a
// value, and stands only where a value does.

/// A text its annotation calls an integer.
@[ refuses("TypeMismatch") ]
def misstated = ("three" : Integer);

/// A returned value its annotation misstates.
@[ refuses("TypeMismatch") ]
def misreturned() -> Integer {
  ("three" : Integer)
}

/// A lambda whose parameter states a type the arrow it answers does not take.
@[ refuses("TypeMismatch") ]
def mistyped : Integer => Integer = thunk { fn (x : String) { 1 } };

/// An annotation inside a pair that misstates its component (#1543).
@[ refuses("TypeMismatch") ]
def inner = (("three" : Integer), 1);

/// An annotation its definition's signature disagrees with (#1543).
@[ refuses("TypeMismatch") ]
def disagreeing : String = (3 : Integer);

/// A pair a bind runs, its pattern annotated with a product the pair does not
/// have (#1543).
@[ refuses("TypeMismatch") ]
def splitWrong() -> Integer {
  run (y, z) : Integer * String <- pure (1, 2);
  y
}

/// An annotated value written as a statement, where no value stands (#1543).
@[ refuses("OutOfFragment.WrongSort") ]
def stated() -> -F Integer { (3 : Integer); return 1 }
