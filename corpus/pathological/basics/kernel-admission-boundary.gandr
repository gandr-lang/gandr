// What the kernel admits stops at its value forms: a string, a pair, a
// function check and a number at an integer width; a number past its width
// does not lower.

/// A string.
def greeting = "the value zone";

/// The string paired with itself.
def pair = (greeting, greeting);

/// The identity on integers.
def identity(x : Integer) -> Integer {
  x
}

/// A number at a stated width.
def wide = 1u32;

/// A number one past the greatest `u32` does not fit the width it states.
@[ refuses("MalformedLiteral") ]
def wider = 4294967296u32;

/// The string, named again.
@[ runs("\"the value zone\"") ]
def shown = greeting;
