// A number with a fraction states no type of its own: it reads at the type
// it is checked at, the float it rounds to at `f64` (#4807). Where nothing
// states a type it is refused, and no default type is chosen for it. A width
// other than `f64` is not admitted yet (#1109).

/// A bare fraction.
@[ refuses("NotSynthesisable") ]
def low = 0.2;

/// A fraction in an exponent's form, bare as well.
@[ refuses("NotSynthesisable") ]
def small = 1e-3;

/// A number at a width the lowering does not admit yet.
@[ refuses("OutOfFragment.typed_number") ]
def single = 0.5f32;

/// The annotated fraction checks.
def stated = (0.2 : f64);

/// The annotated fraction, named again.
@[ runs("0.2f64") ]
def shown = stated;
