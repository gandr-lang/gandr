// A foreign function called with fewer arguments than its signature takes,
// to be refused at the call (#327). The lowering does not reach the extern
// block yet (#327).

/// The maths library's power function (#327).
@[ refuses("OutOfFragment.extern_block") ]
extern "c" from "m" {
  def pow(base : f64, exp : f64) -> f64;
}

/// The run target calls it with its base alone; the lowering reads no
/// projection yet (#1106), and `m` is the extern block's (#327).
@[ refuses("OutOfFragment.projection_expression") ]
m.pow(2.0f64)
