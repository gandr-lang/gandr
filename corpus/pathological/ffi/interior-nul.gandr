// A C string with an interior NUL handed to a foreign function: the string
// would end early at the seam, so the call is to be refused (#327). The
// lowering does not reach the extern block yet (#327).

/// The test library's string length (#327).
@[ refuses("OutOfFragment.extern_block") ]
extern "c" from "testlib" {
  def gandr_test_strlen(s : CStr) -> u64;
}

/// The run target measures a string holding a NUL; the lowering reads no
/// projection yet (#1106), and `testlib` is the extern block's (#327).
@[ refuses("OutOfFragment.projection_expression") ]
testlib.gandr_test_strlen("a\0b")
