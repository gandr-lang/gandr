// A `format` payload is a record of the texts `latex`, `typst` and `md`: no
// payload, a bare text, a field of no markup and a field that is no text are
// each refused.

// No payload: the record is the payload, and it is missing.
@[refuses("MissingPayload")]
@[format]
def bare = 1;

// A bare text, not a record.
@[refuses("IllTypedPayload")]
@[format("\\oplus")]
def bare_text = 2;

// A record naming a field of no markup.
@[refuses("IllTypedPayload")]
@[format(*{.html = "&oplus;"})]
def foreign_field = 3;

// A record whose `latex` is a number, not a text.
@[refuses("IllTypedPayload")]
@[format(*{.latex = 2})]
def untexted_field = 4;
