// A shell block runs one command per statement, with no pipeline between
// commands. The lowering admits no shell block yet, so that refusal
// stands in front of this one.
//
// - see: #1057 — `piped`

/// A pipe between two commands.
@[ refuses("OutOfFragment.shell_block") ]
def piped() -> -F Unit { #!{ printf 'x' | cat; } }
