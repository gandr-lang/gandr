//! `host-escape-non-string` puts an integer in a host escape.
//!
//! A host escape passes a string to a command.
//! The lowering refuses shell blocks before it reaches this form.
//!
//! The source gives `printf` the integer `1` in a host escape.
//!
//! - see: #1057 — `escaped`

/// `escaped` gives a host escape an integer.
@[refuses("OutOfFragment.shell_block")]
def escaped() -> -F Unit { #!{ printf '%s' $(1); } }
