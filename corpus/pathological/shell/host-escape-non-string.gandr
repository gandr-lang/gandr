// A host escape `$( … )` hands a command a string; an integer there is no
// argument. The lowering admits no shell block yet, so that refusal
// stands in front of this one.
//
// - see: #1057 — `escaped`

/// An integer in a host escape.
@[ refuses("OutOfFragment.shell_block") ]
def escaped() -> -F Unit { #!{ printf '%s' $(1); } }
