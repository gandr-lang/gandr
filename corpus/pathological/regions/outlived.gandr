//! `outlived` reads a thunk after its holding region ends.
//!
//! `pass` returns at its input region. A binding with no region
//! cannot hold that
//! result. The checker reports `TypeMismatch`.
//!
//! The source defines a same-region `pass`. Rust rejects a borrow that outlives
//! its source. The source imports the early exit host interface.
//!
//! - see: corpus/model/regions/passed.gandr — a result inside its region
import std.process;

/// `pass` returns a thunk at the same region.
def pass[r : Region](k : (() -> Integer) at r) -> -F ((() -> Integer) at r) { pure k }

/// `outlived` binds `pass` output at no region.
@[ refuses("TypeMismatch") ]
def outlived() -> Integer =
  var s = 4
  handle c : std.process.Exit.Eff {
    let k : (() -> Integer) at c = access shared s as w { pure thunk { pure w } };
    let back : () -> Integer = pass k;
    force back
  } with {
    | pure(x) => pure x
    | oper exit(code, rest) => pure 0
  }
