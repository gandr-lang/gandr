// A typed evaluator as it should read, and what refuses it.
//
// Each expression's index is the object type it evaluates to, and its value is
// the meaning of that index. A case on an expression solves each arm's index
// equation, so an arm's goal reads the arm's own index. A binder of the
// recursion's stage is not generalised, so a branch of that stage keeps the
// scrutinee's index.
//
// The checker refuses each declaration below that states a refusal, by the
// name its attribute states. Each turns to `checks` as its rung lands, and the
// source then moves to the model root.
//
// - see: #3631 — not implemented: a transport's motive that names a
//   recursion's stage, for `evalInt`
// - see: #3483 — refinement by solution, by which `eval` checks
// - see: #3481 — the spike that wrote these programs

/// The object language's types.
data Ty : Type {
  /// Integers.
  TInt : Ty;
  /// Booleans.
  TBool : Ty;
}

/// The meaning of an object type, by a case on its code.
def meaning(t : Ty) -> Type {
  case t {
    TInt => return Integer,
    TBool => return Bool
  }
}

/// Expressions, indexed by the type they evaluate to.
data Expr : Ty -> Type {
  /// An integer literal.
  Lit : (i : Integer) --> Expr(TInt);
  /// A boolean literal.
  BoolLit : (b : Bool) --> Expr(TBool);
  /// The sum of two integer expressions.
  Add : (l : Expr(TInt), r : Expr(TInt)) --> Expr(TInt);
  /// A choice between two expressions of one type.
  If : (t : Ty, c : Expr(TBool), y : Expr(t), n : Expr(t)) --> Expr(t);
}

/// The evaluator, each arm's result the meaning of its index. The `Lit` arm
/// solves its path from `TInt` to `t`, so its integer meets `meaning(TInt)`.
def rec eval(t : Ty, e : Expr(t)) -> meaning(t) {
  case e {
    Lit(i) => i,
    BoolLit(b) => b,
    Add(l, r) => eval[<](TInt, l) + eval[<](TInt, r),
    If(u, c, y, n) => if eval[<](TBool, c) { eval[<](u, y) } else { eval[<](u, n) }
  }
}

/// The evaluator at integers alone. Its `If` branch `y` stands in the stage
/// below `e`, so it stays at `u` where the recursive call reads `TInt`.
@[ refuses("TypeMismatch") ]
def rec evalInt(e : Expr(TInt)) -> Integer {
  case e {
    Lit(i) => i,
    Add(l, r) => evalInt[<](l) + evalInt[<](r),
    If(u, _, y, _) => evalInt[<](y)
  }
}
