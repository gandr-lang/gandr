// A constructor field's grade: `1` and `ω` are read, any other numeral is not.

/// A pair whose first field is held twice: a field takes the grade `1` or
/// `ω`, and the declaration is refused at the grade `2` (#2033).
@[ refuses("OutOfFragment.grade.declaration") ]
data Twice(a : Type) : Type where {
  | Both : (first[2] : a, second : a) --> Twice(a)
}
