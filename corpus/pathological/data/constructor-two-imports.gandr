//! This source refuses a bare constructor name that two imports bind.
//!
//! `Light` and `Signal` come from two imports, and each declares `Red`. A bare
//! use selects no import.
//!
//! The bare use is refused `ImportShadows`, and the refusal names both
//! imports. A use through its family names that family's constructor.
//!
//! - see: #2713 — `halt`

// The paints and the lamps, which share `Red`.
import "../../model/data/constructor-shared-name.gandr";
// The signals, whose `Red` the lamps share too.
import "../../model/data/signal.gandr";

/// The red signal, written through its family.
def stop : Signal = Signal.Red;

/// The red signal, written bare.
@[ refuses("ImportShadows") ]
def halt : Signal = Red;
