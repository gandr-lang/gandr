/// This source declares an indexed family whose data block writes a rule
/// over its constructors, and one constructor states its index at a field.
///
/// It pins the refusal of a constructor rule on such a family. A rule relates
/// two terms at one index, and the checkers read the index of a term where it
/// is closed.
///
/// The lowering reads the rules of a family after the description route. A rule
/// whose left side a constructor heads is refused as `OutOfFragment.Indexed`
/// over its two sides, where a constructor of the family states an index that
/// names a field.
///
/// - see: #2865
/// - see: #1314
/// - see: #8338
data N : Type where
  /// The zero index.
  | Z : N
  /// The successor of an index.
  | S : (n : N) --> N

/// An indexed family with a rule over its constructors is refused, because
/// `Ask` states its index at its field `n`.
@[refuses("OutOfFragment.Indexed")]
data Prog : N -> Type where {
  /// The program that stops, at index zero.
  | Stop : Prog Z
  /// A program that asks once, standing one index above its continuation.
  | Ask : (n : N, k : Prog n) --> Prog (S n)
  /// A program that tells an integer and continues at the same index.
  | Tell : (s : Integer, k : Prog Z) --> Prog Z
  /// Two tells in a row keep only the second, a rule over the constructors.
  rule : Tell s (Tell u k) <=> Tell u k;
}
