// A constructor's field is checked at the type its family's argument gives
// it: `Some("hello")` is no `Maybe(Integer)`.

/// An optional value of any type.
data Maybe(a : Type) : Type {
  None : Maybe(a);
  Some : (x : a) --> Maybe(a);
}

/// A string where an integer is expected.
@[ refuses("TypeMismatch") ]
def held = (Some("hello") : Maybe(Integer));
