// What a case cannot prune: an arm left out whose constructor may stand at
// the scrutinee's index, because the path its branch eliminates has ends that
// are not apart.

// The naturals the lengths count in.
import "../../model/data/data-base.gandr" ;

// The vectors.
import "../../model/data/vectors.gandr" ;

/// The first element of a vector of any length, with no `VNil` arm: `VNil`
/// stands at zero and the vector at `n`, which may be zero, so the arm cannot
/// be left out.
@[ refuses("NotApart") ]
def vheadAny(n : Nat, v : Vec(Integer, n)) -> Integer {
  case v {
    VCons(m, h, t) => h
  }
}
