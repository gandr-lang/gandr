// `Eq.generic` where it derives nothing (#2302): a field with no equality, a
// type the derivation does not yet cover (#2345), the derivation read
// anywhere but as a definition's whole body, and a stated type the derived
// equality does not meet. Its laws refuse a field of a sum, whose proof cases
// on the field under a motive (#2374), and a recursion, whose proof is an
// induction.

/// A shape holding a function, which has no equality the program decides.
data Shape : Type {
  Shape : (f : Integer => Integer) --> Shape;
}

/// A box over any type: its equality needs its argument's.
data Box(a : Type) : Type {
  Box : (x : a) --> Box(a);
}

/// A point in the plane.
data Point : Type {
  Point : (x : Integer, y : Integer) --> Point;
}

/// A point with a flag.
data Flagged : Type {
  Flagged : (x : Integer, shown : Bool) --> Flagged;
}

/// Unary naturals.
data Peano : Type {
  Nought : Peano;
  Next : (n : Peano) --> Peano;
}

/// No equality for a function field.
@[ refuses("GenericUncovered") ]
def eqShape = Eq.generic(Shape);

/// No equality for a type with parameters, yet.
@[ refuses("GenericUncovered") ]
def eqBox = Eq.generic(Box);

/// The derivation applied inside a larger body.
@[ refuses("GenericMisplaced") ]
def inside() -> Bool { Eq.generic(Point)(Point(1, 2), Point(1, 2)) }

/// The derivation over a type that is no data declaration.
@[ refuses("GenericMisplaced") ]
def eqInteger = Eq.generic(Integer);

/// The derivation read as a value.
@[ refuses("GenericMisplaced") ]
def bare = Eq.generic;

/// A stated type the derived equality does not meet.
@[ refuses("TypeMismatch") ]
def eqWrong : (Point, Point) => Integer = Eq.generic(Point);

/// No reflexivity over a flag: its proof cases on the flag.
@[ refuses("GenericUncovered.Dependent") ]
def reflFlagged = Eq.generic.refl(Flagged);

/// No symmetry over a flag, alike.
@[ refuses("GenericUncovered.Dependent") ]
def symFlagged = Eq.generic.sym(Flagged);

/// No reflexivity over a recursion: its proof is an induction.
@[ refuses("GenericUncovered") ]
def reflPeano = Eq.generic.refl(Peano);
