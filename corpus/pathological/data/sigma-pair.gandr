@[ checks ]
data Ix(n : Integer) : Type {
  MkIx : Ix(n);
}

/// The second component lies over another first.
@[ refuses("TypeMismatch") ]
def skewed : #{n : Integer, w : Ix(n)} = (2, (MkIx : Ix(3))) ;

/// A pair with no type to check against synthesises the product of its
/// components, never a dependent pair.
@[ checks ]
def loose = (2, (MkIx : Ix(2))) ;

@[ checks ]
def tag_of(p : #{n : Integer, w : Ix(n)}) -> Integer {
  return p.n
}

@[ refuses("TypeMismatch") ]
def unpaired() -> Integer { tag_of(loose) }
