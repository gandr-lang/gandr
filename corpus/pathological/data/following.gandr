// What a following result refuses. A recursive definition whose
// result can stand above the argument it recurses on returns at no stage, and
// a recursion through it is refused at the top. The twin of
// `../../model/data/following.gandr`.
//
// - see: #392 — `halvedThroughPlus`

// The naturals and `plus`, which recurses on its second argument.
import "../../model/data/data-base.gandr";

/// Half a number through `plus`: `plus(Zero, p)` recurses on `p` but returns
/// a sum, which can stand above `p`, so its result stands at no stage, which
/// `halvedThroughPlus[<]` does not take.
@[refuses("StageNotBelow")]
def rec halvedThroughPlus(n : Nat) -> Nat =
  match n where
    | Zero => Zero
    | Succ(p) => { let q = plus Zero p; Succ (halvedThroughPlus[<] q) }
