// The twin of `model/data/unfolded-arm.gandr`: the endpoint an arm hands to
// another definition reads as that definition's call over the stuck call,
// never as the stuck call alone, so a step that drops the call, or one that
// takes a successor too many, is still told apart (#761).

// The naturals.
import "../../model/data/data-base.gandr";
// `plusTwo` and `double`, whose arm hands its call to `plusTwo`.
import "../../model/data/unfolded-arm.gandr";

/// The step with the recursive call dropped: `plusTwo(n)` is not
/// `plusTwo(double(n))`.
@[ refuses("EndpointMismatch") ]
def callDropped(n : Nat) -> Path(Nat, double(Succ(n)), plusTwo(n)) {
  here(plusTwo(n))
}

/// The step with one successor too many over the call.
@[ refuses("EndpointMismatch") ]
def overshot(n : Nat) -> Path(Nat, double(Succ(n)), Succ(plusTwo(double(n)))) {
  here(Succ(plusTwo(double(n))))
}
