// What a function-typed field refuses. A W-type's node may hold a function
// into its own family, and one from it whose domain stands strictly below the
// node (`./curry.gandr`, #517); a family to the left of the arrow where no
// stage reaches is a negative occurrence: applied to other arguments than its
// parameters, or named through a definition of its block, which stands for
// its body and so hides nothing. Shared with `../../model/data/w-tree.gandr`.

/// The two branches of a binary node.
@[ checks ]
data Two : Type {
  L : Two;
  R : Two;
}

/// A node consuming its family at another argument than its parameter:
/// `Lop(Two)` stands left of the arrow where no stage reaches (#517).
@[ refuses("NegativeOccurrence") ]
data Lop(a : Type) : Type {
  MkLop : (f : Lop(Two) => Two) --> Lop(a);
}

/// The same node with its domain written through a definition of its block
/// (#602): the walk reads `hidden` through to `Hidden`, which stands left of
/// the arrow, and the block is refused whole.
rec {
  /// A node consuming its own family through `hidden`.
  @[ refuses("NegativeOccurrence") ]
  data Hidden : Type {
    MkH : (f : hidden => Two) --> Hidden;
  }

  /// The family, named by a definition of its block, refused with it.
  @[ refuses("NegativeOccurrence") ]
  def hidden : Type = Hidden ;
}
