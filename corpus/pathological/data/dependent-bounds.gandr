// Bounded naturals as they should read, and what refuses each program.
//
// `Fin(n)` holds the naturals below `n`. A case on one binds each arm's index
// equation. It solves an equation with a variable side, takes apart an
// equation between two successors, and prunes an arm whose ends are apart. It
// prunes no match of no arms.
//
// The checker refuses each declaration below by the name its attribute
// states. Each turns to `checks` as its rung lands, and the source then moves
// to the model root.
//
// - owes: #3484 — the empty match at an indexed family, for
//   `absurdFin`
// - see: #3481 — the spike that wrote these programs

// The naturals the bounds count in.
import "../../model/data/data-base.gandr";

// The vectors a bound looks into.
import "../../model/data/vectors.gandr";

/// The naturals below `n`.
data Fin : Nat -> Type where {
  /// Zero, below every successor.
  | FZero : (n : Nat) --> Fin(Succ(n))
  /// One past a bound, below the successor of that bound.
  | FSucc : (n : Nat, i : Fin(n)) --> Fin(Succ(n))
}

/// No natural lies below zero. Each constructor stands at a successor, apart
/// from zero, so the match needs no arm.
@[ refuses("NonExhaustiveMatch") ]
def absurdFin(i : Fin(Zero)) -> Integer {
  match i {}
}

/// A bound read back as the natural it is.
def rec toNat(n : Nat, i : Fin(n)) -> Nat {
  match i {
    FZero(_) => Zero,
    FSucc(m, j) => Succ(toNat[<](m, j))
  }
}

/// The bound one below two.
def one() -> Fin(Succ(Succ(Zero))) { FSucc(Succ(Zero), FZero(Zero)) }
