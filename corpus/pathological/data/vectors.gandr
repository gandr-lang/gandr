// What the vectors refuse: a vector at a length its constructor does not
// state, and a family stating an element where its length goes. What a case
// on a vector cannot leave out is `vector-head.gandr`.

// The naturals the lengths count in.
import "../../model/data/data-base.gandr" ;

// The vectors.
import "../../model/data/vectors.gandr" ;

/// One integer said to be two long: `VCons` stands one past its tail, which
/// is empty.
@[ refuses("TypeMismatch") ]
def overstated() -> -F Vec(Integer, Succ(Succ(Zero))) {
  VCons(Zero, 3, (VNil : Vec(Integer, Zero)))
}

/// A family whose constructor states its element where its length goes.
@[ refuses("TypeMismatch") ]
data Misindexed(a : Type) : Nat -> Type {
  Wrong : (x : a) --> Misindexed(a, x);
}
