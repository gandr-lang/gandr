// Matches of no arm over a free type whose endpoints are not shown apart:
// the first difference, read side by side, is a variable, which may be the
// term on the other side.

// The free naturals.
import "../../model/data/data-base.gandr";

/// `Succ(n)` is `Succ(Zero)` once `n` is `Zero`.
@[ refuses("NotApart") ]
def belowTheHead(n : Nat, e : Path(Nat, Succ(n), Succ(Zero))) -> Nat {
  case e {}
}

/// A variable at the root may be any natural, `Succ(Zero)` among them.
@[ refuses("NotApart") ]
def atTheRoot(n : Nat, e : Path(Nat, n, Succ(Zero))) -> Nat {
  case e {}
}
