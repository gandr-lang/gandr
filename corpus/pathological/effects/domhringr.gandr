// The twin of `model/effects/domhringr.gandr`: a law over continuations that
// names the value an operation answers where its sort does not stand. The
// name `bind x . …` binds is a value of the sort the operation answers, and
// it stands only at a port of that sort.

/// A put answers a digest, not a value: putting the digest a put answered
/// names a `Digest` at the port of a `Value`.
@[ refuses("IllFormedDescription") ]
theory StoreDigestPut {
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  rule again : put(v, bind d . put(d, k)) <=> put(v, k);
}
