// The twin of `model/effects/domhringr.gandr`: the laws of its effects that
// sequence one operation after another, which a theory cannot state yet.
// Each is written over continuations, an operation taking what runs after
// it, and each binds the value an operation answers with `bind x . …`, an
// abstraction at the continuation's port that no rule writes yet (#2115).
// Each law flips to `checks` once that lands. The commutations are the
// table's positive rows; a pair the table says does not commute has no law.

/// A put is idempotent: putting a value twice is putting it once.
@[ refuses("IllFormedDescription") ]
theory StoreIdempotent {
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  rule idem : put(v, bind d . put(v, k)) <=> put(v, k);
}

/// A lookup is read-only: looking a name up twice is looking it up once.
@[ refuses("IllFormedDescription") ]
theory WitnessIdempotent {
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper lookup : (n : Name, k : pi+ (c : Claim) . C) --> C;
  rule idem : lookup(n, bind c . lookup(n, k)) <=> lookup(n, k);
}

/// The store commutes with every effect, a lookup among them: a put before
/// a lookup is the lookup before the put.
@[ refuses("IllFormedDescription") ]
theory StoreWitness {
  sort Value : Type+;
  sort Digest : Type+;
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  oper lookup : (n : Name, k : pi+ (c : Claim) . C) --> C;
  rule commute : put(v, bind d . lookup(n, bind c . k(d, c))) <=> lookup(
    n,
    bind c . put(v, bind d . k(d, c))
  );
}

/// An emit commutes with every read, a lookup among them.
@[ refuses("IllFormedDescription") ]
theory TraceWitness {
  sort Event : Type+;
  sort Name : Type+;
  sort Claim : Type+;
  sort C : Type;
  oper emit : (e : Event, k : C) --> C;
  oper lookup : (n : Name, k : pi+ (c : Claim) . C) --> C;
  rule commute : emit(e, lookup(n, k)) <=> lookup(n, bind c . emit(e, k(c)));
}

/// An emit commutes with a journal's read, though appends do not commute.
@[ refuses("IllFormedDescription") ]
theory TraceJournal {
  sort Event : Type+;
  sort Index : Type+;
  sort Entry : Type+;
  sort C : Type;
  oper emit : (e : Event, k : C) --> C;
  oper read : (i : Index, k : pi+ (x : Entry) . C) --> C;
  rule commute : emit(e, read(i, k)) <=> read(i, bind x . emit(e, k(x)));
}

/// A judge commutes with the store: asking before a put is asking after it.
@[ refuses("IllFormedDescription") ]
theory JudgeStore {
  sort Question : Type+;
  sort Readout : Type+;
  sort Value : Type+;
  sort Digest : Type+;
  sort C : Type;
  oper ask : (q : Question, k : pi+ (r : Readout) . C) --> C;
  oper put : (v : Value, k : pi+ (d : Digest) . C) --> C;
  rule commute : ask(q, bind r . put(v, bind d . k(r, d))) <=> put(
    v,
    bind d . ask(q, bind r . k(r, d))
  );
}

/// A judge commutes with a trace: an emit before the question is an emit
/// after it.
@[ refuses("IllFormedDescription") ]
theory JudgeTrace {
  sort Question : Type+;
  sort Readout : Type+;
  sort Event : Type+;
  sort C : Type;
  oper ask : (q : Question, k : pi+ (r : Readout) . C) --> C;
  oper emit : (e : Event, k : C) --> C;
  rule commute : emit(e, ask(q, k)) <=> ask(q, bind r . emit(e, k(r)));
}

/// A draw commutes with every effect, an emit among them.
@[ refuses("IllFormedDescription") ]
theory RandomTrace {
  sort Distribution : Type+;
  sort Draw : Type+;
  sort Event : Type+;
  sort C : Type;
  oper sample : (s : Distribution, k : pi+ (x : Draw) . C) --> C;
  oper emit : (e : Event, k : C) --> C;
  rule commute : emit(e, sample(s, k)) <=> sample(s, bind x . emit(e, k(x)));
}
