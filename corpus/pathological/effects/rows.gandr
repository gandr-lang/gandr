// The twin of `model/effects/rows.gandr`: rules under rows whose overlap
// parts in the rows both describe, and rows naming a theory no block
// presents or one theory twice.
//
// - see: #2448 — `Unerased`, `Overreaching`, `Unseen`, `Twice`

// The theory `State.Eff`.
import "../../model/effects/state.gandr";
// The theories `Sink` and `Marks`.
import "../../model/effects/rows.gandr";

/// `Marks` without the rules a row holding `State.Eff` and `Sink` erases marks
/// by: there `flush(mark(k))` reaches `k` one way and `mark(k)` the other,
/// two normal forms, so the rules are refused.
@[ refuses("RulesOverlapCondition") ]
theory Unerased where
  sort C : Type;
  oper mark : (k : C) --> C;
  oper flush : (k : C) --> C;
  rule dropped : flush (mark k) <=> k where { | under [Sink | r] };
  rule kept : flush (mark k) <=> mark k where { | under [State.Eff | r] };

/// `Marks` with erasing rules that need a third theory: they fire in no row
/// that holds only `State.Eff` and `Sink`, and in those rows the overlap still
/// parts, so the rules are refused.
@[ refuses("RulesOverlapCondition") ]
theory Overreaching where
  sort C : Type;
  oper mark : (k : C) --> C;
  oper flush : (k : C) --> C;
  rule dropped : flush (mark k) <=> k where { | under [Sink | r] };
  rule kept : flush (mark k) <=> mark k where { | under [State.Eff | r] };
  rule erased : mark k <=> k where { | under [State.Eff, Sink, Marks | r] };
  rule flushed : flush k <=> k where { | under [Sink, State.Eff, Marks | r] };

/// A row naming a theory no block this source sees presents.
@[ refuses("UnresolvedTypeHead") ]
theory Unseen where
  sort C : Type;
  oper mark : (k : C) --> C;
  rule dropped : mark k <=> k where { | under [Missing | r] };

/// A row naming one theory twice: a row holds each theory once.
@[ refuses("DuplicateDefinition") ]
theory Twice where
  sort C : Type;
  oper mark : (k : C) --> C;
  rule dropped : mark k <=> k where { | under [Sink, State.Eff, Sink] };
