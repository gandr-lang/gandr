// The twin of `model/effects/tree-rows.gandr`: a program performing an
// operation its row does not hold.

// `Either`, `StateOp` and `Prog`.
import "../../model/effects/tree.gandr";
// `ExnOp`.
import "../../model/effects/tree-rows.gandr";

/// A program over state alone that raises: `Raise(4)` is an `ExnOp`, and the
/// row's front is `StateOp`, so the operation has no injection into the row.
@[ refuses("TypeMismatch") ]
def leaking : Prog(Either(StateOp, Void), Integer) = Op(
  Left(Raise(4)),
  fn (_r) { (Done(0) : Prog(Either(StateOp, Void), Integer)) }
);
