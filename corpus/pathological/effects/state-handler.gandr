// The twin of `model/effects/state-handler.gandr`: where a scope cannot take
// a theory as its interface, where a model cannot answer it, and where the
// models in scope do not answer it as one.

// The theory `State`.
import "../../model/effects/state.gandr" ;
// `Passing`, the state-passing model of `State`.
import "../../model/effects/state-model.gandr" ;

/// The stored sort left unfixed: `get` would reply a value of no type the
/// scope knows, so `S` is the member the scope cannot read.
@[ refuses("UninterfacedMember") ]
def unfixed() -> Integer {
  handle st : State {
    st.get()
  } with {
    pure(x) => pure x,
    oper get(k) => k(4),
    oper put(s, k) => k(unit)
  }
}

/// The carrier fixed: the carrier is what the scope answers, chosen by its
/// clauses, so a manifest fixing it is refused at `C`.
@[ refuses("UninterfacedMember") ]
def carrierFixed() -> Integer {
  handle st : State with sort S = Integer with sort C = Integer {
    st.get()
  } with {
    pure(x) => pure x,
    oper get(k) => k(4),
    oper put(s, k) => k(unit)
  }
}

/// A sort `State` does not declare, refused by its name.
@[ refuses("UnresolvedName") ]
def undeclared() -> Integer {
  handle st : State with sort T = Integer {
    pure 1
  } with {
    pure(x) => pure x,
    oper get(k) => k(4),
    oper put(s, k) => k(unit)
  }
}

/// A model named that no module declares, refused by its name.
@[ refuses("UnresolvedName") ]
def answeredByNothing() -> Integer => Integer {
  handle st : State with sort S = Integer {
    pure fn (s) { pure s }
  } with Stateless
}

/// The subject computing an integer where the scope answers the model's
/// carrier, a function of the state.
@[ refuses("TypeMismatch") ]
def answeredAtInteger() -> Integer {
  handle st : State with sort S = Integer {
    pure 1
  } with Passing
}

/// A host interface answered by a module: a host's operations are answered
/// by clauses alone.
@[ refuses("OutOfFragment.WrongSort") ]
def answeredForConsole() -> Integer {
  handle c : Console {
    pure 1
  } with Passing
}

/// The stored sort two-valued: `Passing`, the one model of `State` in scope,
/// stores an integer, so no model answers the scope.
@[ refuses("ModelUnanswered") ]
def unansweredAtTwo() -> Integer => Integer {
  handle st : State with sort S = Unit + Unit {
    pure fn (s) { pure 1 }
  }
}

/// A second state-passing model at an integer state: reading answers zero,
/// and storing is forgotten.
module Forgetting : Model(State) with sort S = Integer {
  /// A computation awaiting the current state.
  type C = Integer => Integer;
  /// Reading hands zero to what runs after.
  @[ checks ]
  def get(k : Integer => Integer => Integer) -> Integer => Integer {
    k(0)
  }
  /// Storing runs what comes after, the stored value forgotten.
  @[ checks ]
  def put(s : Integer, k : Integer => Integer) -> Integer => Integer {
    pure k
  }
}

/// `Passing` and `Forgetting` both answer the scope, so the scope names
/// neither.
@[ refuses("ModelAmbiguous") ]
def ambiguousInScope() -> Integer => Integer {
  handle st : State with sort S = Integer {
    pure fn (s) { pure s }
  }
}

/// A host interface writing no `with`: no model answers a host's
/// operations, so it writes its clauses.
@[ refuses("OutOfFragment.WrongSort") ]
def unansweredForConsole() -> Integer {
  handle c : Console {
    pure 1
  }
}
