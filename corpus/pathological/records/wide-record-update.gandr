// An update of one field of a wide record copies every other field, and its
// cost is the record's width.

/// A record of eight fields.
def wide = #{a = 1, b = 2, c = 3, d = 4, e = 5, f = 6, g = 7, h = 8};

/// One field updated, the seven others kept.
@[ runs("#{.a = 1, .b = 2, .c = 3, .d = 4, .e = 99, .f = 6, .g = 7, .h = 8}") ]
def updated() -> #{
  a : Integer,
  b : Integer,
  c : Integer,
  d : Integer,
  e : Integer,
  f : Integer,
  g : Integer,
  h : Integer
} {
  #{wide | e = 99}
}
