// A record update of a value that is no record is refused. The update is
// written as the run target, and the lowering admits no record update yet
// (#1110), so that refusal stands in front of it.

/// An integer.
@[ checks ]
def n = 5;

/// The integer updated as if a record (#1110).
@[ refuses("OutOfFragment.record_update_expression") ]
#{ n | x = 1 }
