// A record update of a value that is no record is refused: the base's type is
// read before the fields the update writes, and an integer is no record.

/// An integer.
@[ checks ]
def n = 5;

/// The integer updated as if a record: a shape mismatch at `n`, wanting a
/// record.
@[ refuses("ShapeMismatch") ]
#{ n | x = 1 }
