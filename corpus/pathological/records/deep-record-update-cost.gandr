// An update three records deep rebuilds each record on the path, and its cost
// grows with the depth, not with the records' width.

/// Three records, nested.
def d = #{a = #{b = #{c = 1}}};

/// `d.a.b.c` updated, each level rebuilt; each inner base is the field of
/// the record above it.
@[ runs("#{.a = #{.b = #{.c = 9}}}") ]
def deep() -> #{a : #{b : #{c : Integer}}} {
  #{d | a = #{d.a | b = #{d.a.b | c = 9}}}
}
