// An update three records deep rebuilds each record on the path, and its cost
// grows with the depth, not with the records' width. The update is written as
// the run target.

/// Three records, nested.
@[ checks ]
def d = #{ a = #{ b = #{ c = 1 } } };

/// `d.a.b.c` updated, each level rebuilt; the inner bases are projections,
/// which the lowering admits no expression of yet (#1106).
@[ refuses("OutOfFragment.projection_expression") ]
#{ d | a = #{ d.a | b = #{ d.a.b | c = 9 } } }
