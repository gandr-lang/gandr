// A record update that gives a field a value of another type makes a record
// of the new type, not of the old one.

/// A cell with an integer count.
@[ checks ]
def cell = #{ count = 3, label = "start" };

/// `cell` with a string count, stated at the old type: its count is no
/// integer.
@[ refuses("TypeMismatch") ]
def stale : #{count : Integer, label : String} = #{ cell | count = "three" } ;
