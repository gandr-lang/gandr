// A peer that has sent everything before its scope abandons the rest leaves
// the run its clause's answer.
//
// The run's scheduler starts a fork's child when the root first waits. Here
// the child sends both payloads and ends before the clause abandons the
// root's rest.
//
// The root takes the first payload, then the exit abandons its continuation
// with the second payload still on the channel. No cancellation reaches the
// ended peer, so the run answers `7`.
//
// - see: #3305 — the cancellation hop, which a peer still waiting at the
//   abandonment needs
// - see: Fowler, Lindley, Morris and Decova, _Exceptional Asynchronous
//   Session Types_, POPL 2019, doi:10.1145/3290341 — cancellation reaching
//   the peer

/// The peer sends both payloads and ends before the clause abandons the rest.
@[ runs("7") ]
def cancelled() -> Integer {
  handle c : Proc {
    fork (peer : !Integer. !Integer. end) {
      send(peer, 1);
      send(peer, 2);
      close(peer)
    } as found;
    recv(found) as first;
    c.exit(1);
    recv(found) as second;
    close(found);
    pure second
  } with {
    pure(y) => pure y,
    oper exit(code, k) => { abandon(k); pure 7 }
  }
}
