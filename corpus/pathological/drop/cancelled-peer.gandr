//! `cancelled-peer` models a completed peer when a handler abandons the root
//! continuation.
//!
//! Cancellation does not reach an ended peer.
//! The handler returns `7`.
//!
//! The scheduler starts the child of a fork when the root first waits.
//! The peer sends two payloads, then it ends before the root exits.
//! The root receives the first payload before it abandons its continuation.
//!
//! - see: #3305 — the cancellation hop, which a peer still waiting at the
//!   abandonment needs
//! - cites: [Fowler-2019-exceptional_asynchronous_session_types] — cancellation
//!   reaching the peer
//!
//! [Fowler-2019-exceptional_asynchronous_session_types]: https://doi.org/10.1145/3290341 "Fowler, Lindley, Morris and Decova, Exceptional Asynchronous Session Types"

// The import provides the early-exit host interface.
import std.process;

/// The peer ends before the handler abandons the root continuation.
@[runs("7")]
def cancelled() -> Integer =
  handle c : std.process.Exit.Eff {
    let found = fork (peer : !Integer. !Integer. end) {
      send peer 1;
      send peer 2;
      close peer
    };
    let first = recv found;
    c.exit 1;
    let second = recv found;
    close found;
    pure second
  } with {
    | pure(y) => pure y
    | oper exit(code, k) => { abandon k; pure 7 }
  }
