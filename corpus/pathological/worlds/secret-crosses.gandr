// What a secret may not do, refused where it would.
//
// A secret proves a host's identity, so it must stay in the process that
// read it. A value that crossed to another world, printed, or compared would
// leak it there.
//
// A `Secret.T` is sealed with no mark, so the crossing judgement refuses a
// migration's result holding one, and a thunk capturing one. No model of
// equality answers at `Secret.T`, so comparing two is refused, naming it.
//
// - see: `library/std/src/secret.gandr` — `Secret` and `Secrets`
// - see: `immobile-crossing.gandr` — the same refusals at a seat's dispatch

// The operator's and the seat's worlds.
import "../../model/worlds/seat-and-operator.gandr";

// The secret, from `std.secret` by its path.
import "../../../library/std/src/secret.gandr";

/// A secret the seat seals and the operator takes back is refused: it stays
/// where the seat sealed it.
@[ refuses("Immobile") ]
@[ entry((operator, seat)) ]
def returned() -> Secret.T {
  migrate [seat] { Secret.seal("far") }
}

/// A thunk over a secret taken back from the seat, refused at the capture:
/// the secret stays, so the thunk does.
@[ refuses("Immobile.Capture") ]
@[ entry((operator, seat)) ]
def captured() -> () => Secret.T {
  migrate [seat] {
    run secret <- Secret.seal("far");
    pure thunk { pure secret }
  }
}

/// Comparing two secrets is refused: no model of equality answers at
/// `Secret.T`.
@[ refuses("ModelUnanswered") ]
def compared() -> Bool {
  run near <- Secret.seal("near");
  run far <- Secret.seal("far");
  near == far
}
