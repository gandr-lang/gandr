// What does not cross, refused where it would. A migration's result comes
// back to the world it left, and only what is mobile and open comes back: an
// unmarked abstract type stays with its seal, a handle stays when what it
// holds is not open, and a thunk stays when what it captures does.

// The operator's and the seat's worlds, and the seat's sealed side of the
// exchange, its report alone marked mobile.
import "../../model/worlds/seat-and-operator.gandr";

/// The dispatch taken back from the seat, refused: `Dispatch` is not marked,
/// so its representation stays with the seal.
@[ refuses("Immobile") ]
@[ entry((operator, seat)) ]
def unmarkedBack() -> Seat.Dispatch {
  migrate [seat] { pure Seat.task }
}

/// A handle to the dispatch taken back from the seat, refused: a handle
/// crosses only when what it holds is open, and an unmarked abstract type is
/// not.
@[ refuses("NotOpen") ]
@[ entry((operator, seat)) ]
def unmarkedHandle() -> -F (Seat.Dispatch at seat) {
  migrate [seat] { (hold Seat.task) }
}

/// A thunk over the dispatch taken back from the seat, refused at the
/// capture: the dispatch stays with its seal, so the thunk does.
@[ refuses("Immobile.Capture") ]
@[ entry((operator, seat)) ]
def suspendedBack() -> () => Seat.Dispatch {
  migrate [seat] {
    run task <- pure Seat.task;
    pure thunk { pure task }
  }
}
