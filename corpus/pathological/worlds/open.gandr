//! What is not open stays at the world it was made at.
//!
//! A handle crosses as the content of the value it holds. A thunk crosses by
//! what it captures. A thunk over a value that is not mobile is not open
//! under a handle, and not mobile without one.
//!
//! Each declaration migrates to the seat and returns a thunk over the seat's
//! unmarked dispatch. The refusal names the judgement that fails at the
//! capture: `NotOpen.Capture` under a handle, `Immobile.Capture` met directly.
//!
//! - cites:
//!   [Rainey-2026-localmem_typedirected_adaptive_serialization_location_contentaddressable_memory],
//!   § 5.1, openness
//! - see: `model/worlds/open.gandr` — what is open crosses
//!
//! [Rainey-2026-localmem_typedirected_adaptive_serialization_location_contentaddressable_memory]: https://doi.org/10.1145/3828688 "Rainey et al., LoCalMem: Type-Directed Adaptive Serialization for Location- and Content-Addressable Memory"

// The operator's and the seat's worlds, each declaration's entry, and the
// seat's sealed side of the exchange, its dispatch unmarked.
import "../../model/worlds/seat-and-operator.gandr";

/// A handle to a thunk over the dispatch is refused: what it holds is not
/// open.
@[ refuses("NotOpen.Capture") ]
@[ entry(*{operator, seat}) ]
def heldThunk() -> -F ((() -> Seat.Dispatch) at seat) =
  migrate [seat] {
    let task = Seat.task;
    (hold thunk { pure task })
  }

/// A handle to a record holding that thunk is refused: one field is not
/// open, so the record is not.
@[ refuses("NotOpen.Capture") ]
@[ entry(*{operator, seat}) ]
def heldRecord() -> -F (*{done : Integer, later : () -> Seat.Dispatch} at seat) =
  migrate [seat] {
    let task = Seat.task;
    (hold *{done = 3, later = thunk { pure task }})
  }

/// The same record without a handle is refused as immobile: a former met
/// directly fails authority first.
@[ refuses("Immobile.Capture") ]
@[ entry(*{operator, seat}) ]
def bareRecord() -> *{done : Integer, later : () -> Seat.Dispatch} =
  migrate [seat] {
    let task = Seat.task;
    pure *{done = 3, later = thunk { pure task }}
  }
