// Deployments the check refuses before any process starts.
//
// A deployment pairs a role's requirement with a site's offer, and a mismatch
// must stop the deployment rather than the role at arrival.
//
// This file is a site and a manifold at once. `far` requires the console and
// a store of strings under `store`. The site lists no console, and binds
// `store` to a store of integers. Placing `far` at it is refused at each
// entry: the console by its name, and `store` naming both types. `nowhere`
// is no world the program declares, so its placement is refused by name. The
// file itself settles, and `gandr check` of it as a deployment refuses all
// three.
//
// - see: `corpus/model/deployments/offers.gandr` — the program, whose `far`
//   requires the row
// - see: `corpus/model/deployments/offers.site.gandr` — a site answering it
// - see: `crates/surface-driver/tests/cli.rs` — the check refusing all three

// The deployment theories, from `std.manifold` by its path.
import "../../../library/std/src/manifold.gandr";

/// What the site keeps: values by key.
pub theory Kept {
  /// The site keeps values of this sort.
  sort V : Type+;
  /// What a computation over them answers.
  sort C : Type;
  /// Reads the value at `key`.
  oper get : (key : V, k : pi+ (v : V). C) --> C;
  /// Keeps `value` at `key`.
  oper put : (key : V, value : V, k : C) --> C;
}

/// Every key holds itself: a store of integers, where `far` asks for strings.
pub module Counted : Model(Kept) with sort V = Integer {
  /// A computation answers an integer.
  type C = Integer;
  /// Hands the key on.
  def get(key : Integer, k : Integer => Integer) -> Integer { k(key) }
  /// Drops the write and runs what comes after.
  def put(key : Integer, value : Integer, k : Integer) -> Integer { k }
}

/// A store at other sorts, and no console.
pub offers [store = Counted];

/// The site, on a loopback socket.
pub module Site : Model(Site) {
  /// The key the hosting process proves.
  def key = "ed4928c628d1c2c6eae90338905995612959273a5c63f93636c14614ac8737d1";
  /// The socket it binds, where a dialer reaches it.
  def sockets = "127.0.0.1:7433";
  /// The name of the key's secret.
  def secret = "far";
}

/// The site's model, which a placement holds.
pub def site : Model(Site) = pack Site at Model(Site);

/// The program this deployment runs.
pub module Manifold : Model(Manifold) {
  /// The program whose `far` requires the row.
  def artifact = "../../model/deployments/offers.gandr";
}

/// `far` at a site that answers neither entry, and a world the program
/// lacks.
pub def placements : List(Placement) = [
  At("far", site),
  At("nowhere", site),
];
