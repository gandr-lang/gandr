// The twin of `model/specification/tree-state-wp.gandr`: where a program's
// evidence against its specification is refused.

// `Either`, `StateOp` and `Prog`.
import "../../model/effects/tree.gandr";

// `incrTree`, `wp` and `isOne`.
import "../../model/specification/tree-state-wp.gandr";

/// A precondition the increment does not meet: ending at one needs the
/// successor of the initial state to be one, not the state itself.
@[ refuses("TypeMismatch") ]
def incrMissesOne : #{
  m : Prog(Either(StateOp, Void), Unit),
  meets : (s : Integer, isOne(unit, s)) => wp(m, isOne, s)
} = (incrTree, fn (s) { fn (h) { h } });

/// A specification asking two more than the increment stores.
def incrByTwoSpec(post : (Unit, Integer) => Type, s : Integer) -> Type { post(unit, s + 2) }

/// The increment against two more: both sides read as `post`'s call over a
/// held sum, and the sums differ (#2773).
@[ refuses("TypeMismatch") ]
def incrMissesTwo(
  post : (Unit, Integer) => Type,
  s : Integer,
  h : incrByTwoSpec(post, s)
) -> wp(incrTree, post, s) { h }
