// A package whose payload is a thunk of grade zero cannot be opened: its
// payload may not be run. The lowering admits no package type, `pack` or
// `unpack` yet (#1108), so that refusal stands in front of the grade's.

/// A package of a grade-zero thunk (#1108).
@[ refuses("OutOfFragment.package_type") ]
def closed : package [ T ] +U[0] (-F #{ seed: T });
def closed = pack [ Integer ] thunk[0] { return #{ seed = 7 } };

/// Opens a grade-zero package (#1108).
@[ refuses("OutOfFragment.unpack_statement") ]
def open_it(p: package [ T ] +U[0] (-F #{ seed: T })) -> -F Integer {
  unpack m : package [ T ] +U[0] (-F #{ seed: T }) = p;
  return 1
}

/// The run target opens it; `open_it` is refused above, so it names a
/// declaration whose type is not known.
@[ refuses("UnknownConstant") ]
open_it(closed)
