// The moved-from handle closed: C++ runs a destructor on the object a move
// leaves "in a valid but unspecified state" ([lib.types.movedfrom], ISO/IEC
// 14882:2020); here the move left nothing behind to close.

// The file's protocols.
import "../../model/moves/file-base.gandr";

/// The handle closed by its mover after it was moved into a closer: the send
/// spent the mover's end, so the close acts on a spent slot.
@[ refuses("UsedAfterClose") ]
def closedAfterMove() -> Unit {
  let file = fork (owner : File.Handle) { close(owner) };
  let task = fork (closer : File.Closer) {
    let held = recv(closer);
    close(held);
    close(closer)
  };
  send(task, file);
  close(file);
  close(task)
}
