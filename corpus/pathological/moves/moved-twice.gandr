//! `moved-twice` sends one handle to two closers.
//!
//! The first send consumes the mover's slot. The checker reports
//! `UsedAfterClose` at the second send.
//!
//! The checker marks the spent slot at the second send.
//! The source imports `File` from `file-base`.
//!
//! Two closers would close one descriptor.
//! - see: POSIX `close(2)` — a repeated descriptor close
//! - see: file-base.gandr — the file protocol
import "../../model/moves/file-base.gandr";

/// `movedTwice` sends a handle after its first send consumed it.
@[ refuses("UsedAfterClose") ]
def movedTwice() -> Unit =
  let file = fork (owner : File.Handle) { close owner };
  let one = fork (first : File.Closer) {
    let held = recv first;
    close held;
    close first
  };
  let two = fork (second : File.Closer) {
    let held = recv second;
    close held;
    close second
  };
  send one file
  send two file
  close one
  close two
