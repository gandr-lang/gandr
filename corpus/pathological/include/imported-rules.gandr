//! `imported-rules` refuses an incomplete join through an imported theory.
//!
//! The checker completes the imported `Monoid` rules and the local rules as
//! one block, as for rules of one source. `Swapping` leaves a critical pair
//! with incomparable normal forms. With the imported left unit rule,
//! `mul (one ()) (pair x y)` reads `pair x y` and `pair y x`. The path order
//! orients neither form. The checker refuses it.
//!
//! - see: #1224

// The source imports the semigroup and monoid theories.
import "../../model/include/monoid.gandr";

/// `Swapping` conflicts with the imported left unit rule.
@[refuses("RulesUncompleted")]
theory Swapping where
  include Monoid;
  oper pair : (x : M, y : M) --> M;
  rule swap : mul (one ()) (pair x y) ==> pair y x;

/// `Orphan` includes a theory that no source presents.
@[refuses("MalformedForm")]
theory Orphan where
  include Unwritten;
  oper one : () --> M;
