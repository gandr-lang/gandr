//! `imported-rules` refuses an incomplete join through an imported theory.
//!
//! The imported `Monoid` rules join the local block. `Swapping` leaves a
//! critical pair with incomparable normal forms. The checker refuses it.
//!
//! - see: #1224

// The source imports the semigroup and monoid theories.
import "../../model/include/monoid.gandr";

/// `Swapping` conflicts with the imported left unit rule.
@[ refuses("RulesUncompleted") ]
theory Swapping where
  include Monoid;
  oper pair : (x : M, y : M) --> M;
  rule swap : mul (one ()) (pair x y) ==> pair y x;

/// `Orphan` includes a theory that no source presents.
@[ refuses("MalformedForm") ]
theory Orphan where
  include Unwritten;
  oper one : () --> M;
