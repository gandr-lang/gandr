// What a reduct refuses: a model stands only where a theory its own includes
// is asked. `../../model/include/reduct.gandr` states the reducts.

// The semigroup, the monoid, the left zero and both extensions at once; the
// manifest endomorphism monoid.
import "../../model/include/monoid.gandr";
import "../../model/include/reduct.gandr";

/// Whether a left zero's zero is there to read: every left zero's is, so
/// this answers zero.
def absorbs(z : Model(LeftZero)) -> Integer {
  case z {
    #{.zero = o} => 0
  }
}

/// The manifest monoid where a left zero is asked: the monoid includes no
/// zero, so no map puts its carrier back and restricts to one (#2136).
@[ refuses("TypeMismatch") ]
def noZero() -> Integer { absorbs(endoManifest) }
