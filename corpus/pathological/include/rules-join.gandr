//! `rules-join` refuses an incomplete join of included rules.
//!
//! Each include adds rules to one completed block. `Swapped` leaves a critical
//! pair with incomparable normal forms. With the included rule `first`,
//! `pick (one ()) y` reads `plus (one ()) y` and `plus y (one ())`. The path
//! order orients neither call. The checker refuses the block by name.
//!
//! - see: #738

/// `Choice` defines two binary operations.
theory Choice where
  sort M : Type;
  oper plus : (x : M, y : M) --> M;
  oper pick : (x : M, y : M) --> M;
  rule first : pick x y ==> plus x y;

/// `Swapped` conflicts with an included rule after it adds a unit.
@[ refuses("RulesUncompleted") ]
theory Swapped where
  include Choice;
  oper one : () --> M;
  rule flip : pick (one ()) y ==> plus y (one ());

/// `Orphan` includes a theory that no source presents.
@[ refuses("MalformedForm") ]
theory Orphan where
  include Unwritten;
  oper one : () --> M;
