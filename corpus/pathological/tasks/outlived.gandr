// A task runs as its parent's peer, and no region bounds it: a task naming a
// capability its scope introduced could run past the scope's end, so the fork
// refuses it whether or not the task still holds its end.

// The task's protocol.
import "../../model/tasks/task-base.gandr" ;

/// A task exiting through its scope's capability after closing its end.
@[ refuses("CapabilityEscaped") ]
def outlived() -> -F Unit {
  handle c : Proc {
    fork (task : Task.Join) {
      send(task, Task.notes);
      close(task);
      c.exit(1)
    } as found;
    recv(found) as text;
    close(found)
  } with {
    pure(x) => pure x,
    oper exit(code, k) => k(unit)
  }
}
