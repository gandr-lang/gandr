//! No case tells the two orders of a commutative meet apart.
//!
//! The apartness of two terms gives a value of the type with no value. So a
//! wrong apartness makes each statement provable. The two orders of a meet
//! are one term, and a rule that tears under the symmetry decides nothing.
//!
//! The check of a block reads each rule in each order of the arguments of a
//! meet. It refuses a block where the two orders of one rule give two results.
//!
//! The checker compares two terms in each order of the arguments of a meet.
//! It refuses a case with no arm where one order joins the two terms. A block
//! whose rules do not join gives no type of terms, so a case over them is
//! refused by the refusal of the block.
//!
//! - see: #8323

// `Hollow` and `Pick`.
import "../../model/desc/rule-symmetry-apart.gandr"

/// The theory of a meet over pairs, with a rule that tears under the symmetry.
/// The meet of two pairs is the first part of each one, so the rules of the
/// block do not join.
@[refuses("RulesUncompleted")]
theory Torn where
  /// The terms.
  sort T : Type;
  /// The first constant.
  oper low : T;
  /// The second constant.
  oper high : T;
  /// A pair of two terms.
  oper pair : (x : T, y : T) --> T;
  /// The meet of two terms.
  oper meet : (x : T, y : T) --> T;
  /// The meet of a pair and a term is the first part of the pair.
  rule meetPair : meet (pair x y) z <=> x;
  /// The meet is commutative.
  rule meetComm : meet x y <=> meet y x;

/// The two orders of a meet are one term, so the case needs an arm.
///
/// - see: #8323
@[refuses("NotApart")]
def ordersNotApart(
  e : Path[.A = Terms Pick] (Pick.meet Pick.first Pick.second) (Pick.meet Pick.second Pick.first)
) -> Hollow =
  match e {}

/// The rules of `Torn` do not join, so the block is refused and its terms are
/// no type: the case is refused at them, by the refusal of the block.
///
/// - see: #8323
@[refuses("RulesUncompleted")]
def tornApart(e : Path[.A = Terms Torn] Torn.low Torn.high) -> Hollow =
  match e {}
