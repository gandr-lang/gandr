// A theory's terms where its rules present no type, or where the slice of
// theories with terms ends.
//
// `Terms(S)` is the data type of a theory's closed terms, its rules the
// type's conversion. A monoid's associativity orients to no decreasing rule,
// so its terms have no presentation. A theory of two sorts, or one stating a
// law, stands outside the slice.
//
// The refusal stands at the type that asks for the terms. A declaration
// refused at refused terms states the terms' own cause, never the consequence
// that no data formed.
//
// - see: `model/desc/theory-terms.gandr` — the unital magma's terms
// - see: #4150 — not implemented: terms over several sorts
// - see: #4105 — not implemented: a stated law as a cell of the terms

/// A monoid's signature: its associativity orients to no decreasing rule.
theory Mon {
  /// The carrier.
  sort M : Type;
  /// The unit.
  oper one : () --> M;
  /// The product.
  oper mul : (x : M, y : M) --> M;
  /// The unit on the left.
  rule unitL : mul(one(), x) <=> x;
  /// The unit on the right.
  rule unitR : mul(x, one()) <=> x;
  /// Associativity, which neither orientation makes decrease.
  rule assoc : mul(mul(x, y), z) <=> mul(x, mul(y, z));
}

/// The monoid's unit as a term: its terms are refused, and so is it.
@[ refuses("RuleNotPresentable") ]
def neutral : Terms(Mon) = Mon.one;

/// A second declaration asking for the terms states the same cause.
@[ refuses("RuleNotPresentable") ]
def product : Terms(Mon) = Mon.mul(Mon.one, Mon.one);

/// A signature of two sorts, a point and a pair of them.
theory Pair {
  /// The points.
  sort P : Type;
  /// The pairs.
  sort Q : Type;
  /// The one point.
  oper origin : () --> P;
  /// A pair of two points.
  oper pair : (x : P, y : P) --> Q;
}

/// Terms over two sorts stand outside the slice.
@[ refuses("OutOfFragment.terms_type.sorted") ]
def paired : Terms(Pair) = Pair.origin;

/// A signature that states a law: `twice` twice equals `twice` once.
theory Idem {
  /// The carrier.
  sort M : Type;
  /// The one operation.
  oper twice : (x : M) --> M;
  /// The stated law, a path the terms would carry as their cell.
  law settles : (x : M) => Path(M, twice(twice(x)), twice(x));
}

/// Terms of a theory stating a law stand outside the slice.
@[ refuses("OutOfFragment.terms_type.law") ]
def doubled : Terms(Idem) = Idem.twice;
