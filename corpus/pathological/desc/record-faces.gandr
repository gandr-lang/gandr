// A record type's faces refused: one face holds a label the record lacks, and
// one face is named twice. A static bracket refused: it names a field or a face
// the record type lacks.
//
// A face lists only labels its record holds, and each face has its own name.
// The refusal stands at the label or at the second name.
// A static bracket fixes only the fields its record type writes, and a face
// only when the type member names it. The refusal stands at the label or at
// the face, by its name.
//
// The types stand in a module, whose members carry the verdict each refusal
// states. Each refusal names the face and the record type.
//
// - see: `model/desc/record-faces.gandr` — the faces read, and the bracket read
// - see: `pathological/desc/shaped-signature.gandr` — a theory's faces refused
//   alike

/// Two record types, each with a faces block the check refuses.
module Faces where {
  /// `bad` holds `cert`, which the record does not label: the face is refused
  /// at the label (`FaceOutsideShape`).
  @[ refuses("IllFormedDescription") ]
  type Outside = *{host : String, port : Integer} where
    face bad = { port, cert };

  /// The block names `addr` twice: the second is refused at its name
  /// (`DuplicateFaceName`).
  @[ refuses("IllFormedDescription") ]
  type Twice = *{host : String, port : Integer} where
    face addr = { host };
    face addr = { port };
}

/// A server's configuration, with the face `secure`.
type Config = *{host : String, port : Integer, tls : Bool} where
  face secure = { port, tls };

/// `mode` is no field of `Config`: the bracket is refused at the label.
@[ refuses("UnresolvedName") ]
def moded(c : Config[.mode = 1]) -> Integer { 0 }

/// `remote` is no face of `Config`: the bracket is refused at the face.
@[ refuses("UnresolvedName") ]
def remote(c : Config[remote ↦ *{.host = "localhost"}]) -> Integer { 0 }
