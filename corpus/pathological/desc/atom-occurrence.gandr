// The twin of `model/desc/atom-occurrence.gandr`: an atom named where no port
// of its sort stands, a conditioned overlap whose rewrites part under the
// freshness it composes, and a variable split across an abstraction that no
// step decides yet.

// The law over the channel its restriction abstracts.
import "../../model/desc/atom-occurrence.gandr" ;

/// `par` takes processes, so the channel `bind a .` abstracts cannot stand as
/// one: the description check refuses the occurrence as misplaced, an
/// ill-formed description.
@[ refuses("IllFormedDescription") ]
theory Misplaced {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper nu : (p : bind (a : Name) . Proc) --> Proc;
  rule stray : nu(bind a . par(a, nil())) ==> nil();
}

/// Scope extrusion beside the law that a restriction of the inert process is
/// inert, where `out` takes a channel: the law rewrites the restriction
/// extrusion matches, and under `a # q` the peak `par(nu(bind a . nil), q)`
/// reaches `nu(bind a . par(nil, q))` one way and `par(nil, q)` the other, two
/// normal forms, so the rules are refused (#2448).
@[ refuses("RulesOverlapCondition") ]
theory Vacant {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name) . Proc) --> Proc;
  rule scope : par(nu(bind a . p), q) <=> nu(bind a . par(p, q)) where a # q;
  rule vacant : nu(bind a . nil()) <=> nil();
}

/// A variable matched under a restriction and beside it where `out` takes a
/// channel: its two instances agree only up to the channels they name, which
/// no matching step decides yet, so the description check refuses the rule
/// undecided (#1934).
@[ refuses("IllFormedDescription") ]
theory Split {
  sort Name : Atom;
  sort Proc : Type;
  oper par : (p : Proc, q : Proc) --> Proc;
  oper out : (c : Name, p : Proc) --> Proc;
  oper nu : (p : bind (a : Name) . Proc) --> Proc;
  rule split : par(nu(bind a . p), p) ==> p where a # p;
}
