// The twin of `model/desc/relative-monad.gandr`: associativity, whose left
// side overlaps itself while its right side substitutes under a binder, so
// it waits on critical pairs between second-order rules (#2116,
// `second-order-rules.gandr`'s `LetOverlap`).

/// Associativity: extending an extension is extending by the composite
/// continuation. The inner `ext(m, k)` is an instance of the rule's own left
/// side, and the rule instantiates `k` under `bind x .`, so the overlap is
/// refused until such a pair can join (#2116).
@[ refuses("RulesOverlapSecondOrder") ]
theory MonadAssoc {
  sort V : Type+;
  sort C : Type;
  oper ext : (m : C, k : pi+ (x : V) . C) --> C;
  rule assoc : ext(ext(m, k), l) <=> ext(m, bind x . ext(k(x), l));
}
