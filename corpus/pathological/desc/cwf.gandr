//! The checker refuses the composite law on terms of a category with families.
//! Huang and Angiuli state these laws
//! [Huang-2026-fat_cell_structures_generalized_algebraic_theories], § 1.1.
//!
//! Two substitutions in turn move a term as their composite does. The outer
//! substitution's type index applies `subTy`, which the composite law on types
//! rewrites. A step inside that index meets a peak that the decision does not
//! join yet.
//!
//! Each index carries the indices of the operation it applies, and the two
//! sorts agree modulo the composite law on types. The checker refuses the law
//! by name before it decides.
//!
//! - see: #5042
//! - see: #5117
//! - cites: [Huang-2026-fat_cell_structures_generalized_algebraic_theories]
//!
//! [Huang-2026-fat_cell_structures_generalized_algebraic_theories]: https://doi.org/10.4230/LIPIcs.LICS.2026.58 "Huang and Angiuli, Fat Cell Structures and Generalized Algebraic Theories"

/// The CwF signature that the model source declares.
import "../../model/desc/cwf.gandr";

/// A term substituted twice is the term substituted along the composite, but
/// a law on types rewrites the index of the outer substitution.
@[ refuses("UndescribedMember.RewrittenIndex") ]
theory CwFTermComposite where
  /// The sorts, operations and laws of a category with families.
  include CwF;
  /// Two substitutions in turn move a term as their composite does.
  rule tmComp : subTm (subTm t s) u ==> subTm t (comp s u);
