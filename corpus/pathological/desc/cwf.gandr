// The checker refuses the laws on terms of a category with families.
// Huang and Angiuli state these laws (_Fat cell structures and generalized
// algebraic theories_, doi:10.4230/LIPIcs.LICS.2026.58, § 1.1).
//
// A law on terms relates two sides whose sorts agree only modulo a law on
// types. The sort of `subTm(t, id(g))` is `Tm(g, subTy(a, id(g)))`, and the
// sort of `t` is `Tm(g, a)`.
//
// The reading carries an index only as a variable or an operation without
// indices of its own. The index `subTy(a, id(g))` applies `subTy`, which
// carries the context of `a`.
//
// - see: #5042

/// The CwF signature that the model source declares.
import "../../model/desc/cwf.gandr";

/// The sort of a term after the identity agrees with its own sort only
/// modulo the law on types.
@[ refuses("UndescribedMember.NestedOperation") ]
theory CwFTermIdentity where {
  /// The sorts, operations and laws of a category with families.
  include CwF;
  /// The identity leaves a term as it is.
  rule tmId : subTm(t, id(g)) ==> t;
}
