//! The crossed pairing joins no two terms that the symmetry does not join.
//!
//! The conversion pairs the two arguments of a commutative operation in the
//! written order or crossed. That choice must not join two terms that differ
//! in an argument. It must not join the two orders of an operation that
//! states no symmetry.
//!
//! The checker tries the two pairings and finds a difference in each one. For
//! the chain, the rules hold no symmetry, so the checker tries one pairing.
//!
//! - see: #8311

// `Tally` with its symmetry.
import "../../model/desc/rule-symmetry.gandr";

/// The theory of a chain of links, with no law of commutativity.
theory Chain where
  /// The chains.
  sort C : Type;
  /// The chain with no link.
  oper bare : C;
  /// Two chains, one after the other.
  oper link : (x : C, y : C) --> C;

/// No pairing joins two meets that differ in one argument.
///
/// - see: #8311
@[refuses("EndpointMismatch")]
def apartInOne(x : Terms Tally, y : Terms Tally, z : Terms Tally) -> Path (Tally.meet
  x
  y) (Tally.meet y z) = Path.here (Tally.meet x y);

/// The two orders of an operation with no symmetry are two terms.
///
/// - see: #8311
@[refuses("EndpointMismatch")]
def linkSwapped(x : Terms Chain, y : Terms Chain) -> Path (Chain.link x y) (Chain.link
  y
  x) = Path.here (Chain.link x y);
