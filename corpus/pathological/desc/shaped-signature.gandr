// The twin of `model/desc/shaped-signature.gandr`, one refusal per block. A
// face holds a name its boundary lacks, a face is named twice, and a boundary
// lists a name twice. A signature states two boundaries, and one spells the
// retired `shape`.

/// `far` holds `e`, which the boundary does not list: the description check
/// refuses the face by name (`FaceOutsideShape`).
@[ refuses("IllFormedDescription") ]
theory Past {
  boundary Square { a, b, c, d };
  face far = {b, e};
  sort Cell : Type;
}

/// `left` is named twice: the description check refuses the second by name
/// (`DuplicateFaceName`).
@[ refuses("IllFormedDescription") ]
theory Twice {
  boundary Square { a, b, c, d };
  face left = {a, c};
  face left = {b, d};
  sort Cell : Type;
}

/// The boundary lists `b` twice, and a boundary holds each point once: the
/// second listing is refused by the name.
@[ refuses("DuplicateDefinition") ]
theory Repeated {
  boundary Line { a, b, b };
  sort Cell : Type;
}

/// A signature states one boundary: the second member is malformed.
@[ refuses("MalformedForm") ]
theory TwoBoundaries {
  boundary Square { a, b, c, d };
  boundary Line { a, b };
  sort Cell : Type;
}

/// `shape` is the retired spelling of the shape parameter, refused naming
/// `boundary`, so the word is the site's alone.
@[ refuses("MalformedForm") ]
theory Retired {
  shape Square : 4 { left = {0, 2}; };
  sort Cell : Type;
}
