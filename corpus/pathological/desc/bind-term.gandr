// The twin of `model/desc/bind-term.gandr`: an abstraction where no port
// abstracts.

// The abstraction's laws.
import "../../model/desc/bind-term.gandr";

/// `par` abstracts nothing at its ports, so the atom `bind a . nil()`
/// abstracts would escape: the description check refuses the abstraction as
/// misplaced, an ill-formed description.
@[ refuses("IllFormedDescription") ]
theory Escape {
  sort Name : Atom;
  sort Proc : Type;
  oper nil : () --> Proc;
  oper par : (p : Proc, q : Proc) --> Proc;
  rule leak : par(bind a. nil(), nil()) ==> nil();
}
