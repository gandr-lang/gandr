// Normalisation by evaluation of the simply typed lambda calculus stops at
// five refusals. Each declaration here is the smallest step of the evaluator
// that meets one of them, and each names the unit that removes it.
//
// | Step | Refusal | Unit |
// | --- | --- | --- |
// | a renaming past one more entry | `OutOfFragment.Unannotated` | #5035 |
// | a renaming lifted under one more entry | `TypeMismatch` | #3403 |
// | the renaming of neutrals and normal forms | `OutOfFragment.instantiation_expression.computation` | #5036 |
// | an environment as a pair type | `ShapeMismatch` | #5034 |
// | a lookup in an environment | `NonExhaustiveMatch` | #3402 |
// | reflection beside reification | `ShapeMismatch` | #5036 |
//
// The evaluator, `nf` and the evaluation model need every step.
//
// - see: #5032

/// The syntax and the semantic types that the model source declares.
import "../../model/desc/stlc.gandr";

/// A renaming past one more entry. The constructor `There` is the body of a
/// lambda, where it reads no stated type.
@[ refuses("OutOfFragment.Unannotated") ]
def wk(d : Ctx, g : Ctx, b : ObjTy, r : Ren(d, g)) -> Ren(Extend(d, b), g) {
  return fun (a) { return fun (x) { There(d, a, b, r(a)(x)) } }
}

/// A renaming lifted under one more entry, at one variable. The arm `Here`
/// does not learn that `c` is `a` from `Extend(_h, c)` and `Extend(g, a)`.
@[ refuses("TypeMismatch") ]
def liftAt(d : Ctx, g : Ctx, a : ObjTy, r : Ren(d, g), b : ObjTy, x : Var(Extend(g, a), b)) -> Var(
  Extend(d, a),
  b
) {
  match x {
    Here(_h, c) => Here(d, c),
    There(_h, c, _e, y) => There(d, c, a, r(c)(y))
  }
}

/// A renaming lifted under one more entry. It calls `liftAt` and checks.
def lift(d : Ctx, g : Ctx, a : ObjTy, r : Ren(d, g)) -> Ren(Extend(d, a), Extend(g, a)) {
  return fun (b) { return fun (x) { liftAt(d, g, a, r, b, x) } }
}

/// The renaming of neutrals and normal forms. Each descends on its third
/// parameter, whose type reads the two before it.
rec {
  /// Renaming in a neutral.
  @[ refuses("OutOfFragment.instantiation_expression.computation") ]
  def rec renNe(g : Ctx, a : ObjTy, t : Ne(g, a), d : Ctx, r : Ren(d, g)) -> Ne(d, a) {
    match t {
      NVar(_h, b, x) => NVar(d, b, r(b)(x)),
      NApp(h, b, c, f, u) => {
        let f2 = renNe[<](h, Arr(b, c), f, d, r);
        let u2 = renNf[<](h, b, u, d, r);
        NApp(d, b, c, f2, u2)
      }
    }
  }
  /// Renaming in a normal form.
  @[ refuses("OutOfFragment.instantiation_expression.computation") ]
  def rec renNf(g : Ctx, a : ObjTy, t : Nf(g, a), d : Ctx, r : Ren(d, g)) -> Nf(d, a) {
    match t {
      NNe(h, n) => { let n2 = renNe[<](h, Base, n, d, r); NNe(d, n2) },
      NLam(h, b, c, body) => {
        let body2 = renNf[<](Extend(h, b), c, body, Extend(d, b), lift(d, h, b, r));
        NLam(d, b, c, body2)
      }
    }
  }
}

/// Environments as a pair type that a recursion over the context computes.
def rec envs(g : Ctx, d : Ctx) -> Type {
  match g {
    Empty => return Unit,
    Extend(h, a) => return type(#{x : envs[<](h, d), y : sem(a, d)})
  }
}

/// An environment and one more value. The tuple meets `envs(Extend(g, a),
/// d)`, which the shape check does not unfold.
@[ refuses("ShapeMismatch") ]
def extendEnv(g : Ctx, a : ObjTy, d : Ctx, rho : envs(g, d), v : sem(a, d)) -> envs(
  Extend(g, a),
  d
) { (rho, v) }

/// A variable looked up in an environment. The inner case does not prune
/// `ENil`, whose index `Empty` is apart from `Extend(h, b)`.
@[ refuses("NonExhaustiveMatch") ]
def rec look(g : Ctx, a : ObjTy, x : Var(g, a), d : Ctx, rho : Env(g, d)) -> sem(a, d) {
  match x {
    Here(_h, _b) => match rho {
      ECons(_h, _b, _d, _rest, v) => v
    },
    There(h, b, _c, y) => match rho {
      ECons(_h, _c, _d, rest, _v) => look[<](h, b, y, d, rest)
    }
  }
}

/// The shape of reflection beside reification: two members over a type,
/// whose later parameters differ.
rec {
  /// The depth of a semantic value's type.
  @[ refuses("ShapeMismatch") ]
  def rec reflectDepth(a : ObjTy, _v : sem(a, Empty)) -> Integer {
    match a {
      Base => 0,
      Arr(dom, _cod) => { let n = reifyDepth[<](dom, Empty); n + 1 }
    }
  }
  /// The depth of a type at a context.
  @[ refuses("ShapeMismatch") ]
  def rec reifyDepth(a : ObjTy, g : Ctx) -> Integer {
    match a {
      Base => 0,
      Arr(_dom, cod) => { let n = reifyDepth[<](cod, g); n + 1 }
    }
  }
}
