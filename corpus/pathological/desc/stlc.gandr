// The steps of normalisation by evaluation for the simply typed lambda
// calculus that the checker refuses today.
//
// The evaluator, `nf` and the evaluation model need every step. Each refusal
// names the unit that removes it, so the rung waits on those units only.
//
// Each declaration is the smallest step of the evaluator that meets one
// refusal. The model source declares the syntax and the semantic types.
//
// - see: #5032
// - see: #5035
// - see: #5065
// - see: #5034

/// The syntax and the semantic types that the model source declares.
import "../../model/desc/stlc.gandr";

/// The renamer past one more entry. The constructor `There` is the body of a
/// lambda, where it reads no stated type.
@[ refuses("OutOfFragment.Unannotated") ]
def wk(d : Ctx, g : Ctx, b : ObjTy, r : Ren(d, g)) -> Ren(Extend(d, b), g) =
  return fun (a) { return fun (x) { There d a b ((r a) x) } }


/// The renaming of neutrals and normal forms. Each descends on its third
/// parameter, whose type reads the two before it.
rec {
  /// The renamer of a neutral.
  @[ refuses("OutOfFragment.mutual_block.staged_after_first") ]
  def rec renNe(g : Ctx, a : ObjTy, t : Ne(g, a), d : Ctx, r : Ren(d, g)) -> Ne(d, a) {
    match t
      | NVar(_h, b, x) => NVar d b ((r b) x)
      | NApp(h, b, c, f, u) => {
        let f2 = renNe[<] h (Arr b c) f d r;
        let u2 = renNf[<] h b u d r;
        NApp d b c f2 u2
      }
  }
  /// The renamer of a normal form.
  @[ refuses("OutOfFragment.mutual_block.staged_after_first") ]
  def rec renNf(g : Ctx, a : ObjTy, t : Nf(g, a), d : Ctx, r : Ren(d, g)) -> Nf(d, a) =
    match t
      | NNe(h, n) => { let n2 = renNe[<] h Base n d r; NNe d n2 }
      | NLam(h, b, c, body) => {
        let body2 = renNf[<] (Extend h b) c (body (Extend d b)) (lift d h b r);
        NLam d b c body2
      }
}

/// Environments as a pair type that a recursion over the context computes.
def rec envs(g : Ctx, d : Ctx) -> Type =
  match g
    | Empty => return Unit
    | Extend(h, a) => return type(*{x : envs[<](h, d), y : sem(a, d)})

/// An environment and one more value. The tuple meets `envs(Extend(g, a),
/// d)`, which the shape check does not unfold.
@[ refuses("ShapeMismatch") ]
def extendEnv(g : Ctx, a : ObjTy, d : Ctx, rho : envs(g, d), v : sem(a, d)) -> envs(
  Extend(g, a),
  d
) { *{rho, v} }
