// What divergence as a row entry refuses (#1481): a loop at a row without
// `Partial`, a call of a diverging function from one, a handler of `Partial`, and an
// unread call of a diverging function dropped. Each would let a computation
// that never returns stand where one that returns is expected. What checks is
// in `../../model/control/divergence.gandr`.

/// A diverging loop's function, typed as if it returned: the loop's fixpoint
/// is refused, its type named with `Partial` in the row (#1481).
@[ refuses("TypeMismatch") ]
def spinPure(x : Bool) -> Bool {
  let y = loop {
    let below = 1 < 0;
    match below {
      true => break(x),
      false => continue,
    }
  };
  y
}

/// The loop at the row it needs.
def spin(x : Bool) -> [Partial] Bool {
  let y = loop {
    let below = 1 < 0;
    match below {
      true => break(x),
      false => continue,
    }
  };
  y
}

/// A caller at the empty row of a function whose row holds `Partial`: the call
/// synthesises the row, which the caller's does not include (#1481).
@[ refuses("TypeMismatch") ]
def spinFirst(x : Bool) -> Bool {
  spin(x)
}

/// A handler of `Partial` has no operation to answer and runs its subject, which
/// may still run forever: it leaves `Partial` in its row, which the empty row
/// does not include (#1481).
@[ refuses("TypeMismatch") ]
def tamed(x : Bool) -> Bool {
  handle c : Partial {
    spin(x)
  } with {
    pure(v) => pure v
  }
}

/// An unread call whose row holds `Partial` may run forever, so it is not the
/// computation that follows it: the endpoints stay apart (#1481).
@[ refuses("EndpointMismatch") ]
def unreadDiv(a : Type, b : Type, f : a => b, g : +U (a -> -F [Partial] b)) -> Path(
  +U (a -> -F [Partial] b),
  thunk { fun (x) { let _ = g(x); f(x) } },
  thunk { fun (x) { f(x) } }
) {
  Path.here(thunk { fun (x) { f(x) } })
}
