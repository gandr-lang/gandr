// What divergence as a row entry refuses (#1481): a loop at a row without
// `Div`, a call of a diverging function from one, a handler of `Div`, and an
// unread call of a diverging function dropped. Each would let a computation
// that never returns stand where one that returns is expected. What checks is
// in `../../model/control/divergence.gandr`.

/// A diverging loop's function, typed as if it returned: the loop's fixpoint
/// is refused, its type named with `Div` in the row (#1481).
@[ refuses("TypeMismatch") ]
def spinPure(x : Bool) -> Bool {
  run y <- loop {
    run below <- 1 < 0;
    case below {
      true => break(x),
      false => continue,
    }
  };
  y
}

/// The loop at the row it needs.
def spin(x : Bool) -> [Div] Bool {
  run y <- loop {
    run below <- 1 < 0;
    case below {
      true => break(x),
      false => continue,
    }
  };
  y
}

/// A caller at the empty row of a function whose row holds `Div`: the call
/// synthesises the row, which the caller's does not include (#1481).
@[ refuses("TypeMismatch") ]
def spinFirst(x : Bool) -> Bool {
  spin(x)
}

/// A handler of `Div` has no operation to answer and runs its subject, which
/// may still run forever: it leaves `Div` in its row, which the empty row
/// does not include (#1481).
@[ refuses("TypeMismatch") ]
def tamed(x : Bool) -> Bool {
  handle c : Div {
    spin(x)
  } with {
    pure(v) => pure v
  }
}

/// An unread call whose row holds `Div` may run forever, so it is not the
/// computation that follows it: the endpoints stay apart (#1481).
@[ refuses("EndpointMismatch") ]
def unreadDiv(a : Type, b : Type, f : a => b, g : +U (a -> -F [Div] b)) -> Path(
  +U (a -> -F [Div] b),
  thunk { fn (x) { run v <- g(x); f(x) } },
  thunk { fn (x) { f(x) } }
) {
  here(thunk { fn (x) { f(x) } })
}
