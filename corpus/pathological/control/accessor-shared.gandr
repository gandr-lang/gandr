/// An exclusive access inside a shared one: the held value is frozen for the
/// shared access's body, so it is not lent exclusively there.
@[ refuses("HeldLent") ]
def frozen() -> -F Unit {
  hold c = 0;
  access shared c as w { access c as v { resume(v, w) } }
}

/// A resume through a shared view: a shared view is read-only.
@[ refuses("ViewReadOnly") ]
def written() -> -F Unit {
  hold c = 0;
  access shared c as w { resume(w, 1) }
}

/// An abort through a shared view: a shared view ends with its body.
@[ refuses("ViewReadOnly") ]
def aborted() -> -F Unit {
  hold c = 0;
  access shared c as w { abort(w) }
}

/// An unwind on a shared access: only an exclusive access is aborted, so only
/// it runs an unwind.
@[ refuses("MalformedForm") ]
def unwound() -> -F Unit {
  hold c = 0;
  access shared c as w { pure unit } unwind { pure unit }
}
