// A host interface lives at its home, `std.io.Console.Eff`, and a bare name
// reaches none (#4495): a row, a scope and a call written with the bare name
// are each refused where they name it.

/// A row naming the console bare.
@[ refuses("UnresolvedTypeHead") ]
def bareRow() -> -F [Console] Unit { pure unit }

/// A scope handling the early exit bare.
@[ refuses("UnresolvedTypeHead") ]
def bareScope() -> -F Unit {
  handle c : Proc {
    pure unit
  } with {
    pure(x) => pure x,
    oper exit(code, k) => k(unit)
  }
}
