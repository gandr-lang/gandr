// What `../../model/control/effect-rows.gandr` proves, refused: a row names
// each interface once, and a row without an interface its computation
// performs is not that computation's row (#2269).

// `peek` reads through `std.fs.Eff`; `once` states `Div`.
import "../../model/control/capability-attenuate.gandr";
import "../../model/control/divergence.gandr";

/// `std.fs.Eff` named twice: a row holds each interface once, so the second `std.fs.Eff` is
/// refused as a label defined twice, as a record's second field of one label
/// is.
@[ refuses("DuplicateDefinition") ]
def namedTwice() -> -F [std.fs.Eff, std.fs.Eff] Integer { pure 1 }

/// Sequencing joins the rows: the computation reads through `std.fs.Eff`, which the
/// row `[Div]` does not hold.
@[ refuses("TypeMismatch") ]
def narrowedRow(c : Cap { read }) -> [Div] Integer {
  let _ = peek(c);
  once(2)
}
