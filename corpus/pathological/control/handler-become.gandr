// A `become` inside a handled subject.
//
// A handled scope holds its handler until its subject returns, so a tail
// call never leaves it.
//
// `became` leaves the scope its handler holds by a tail call, which the
// lowering refuses.
//
// - see: corpus/ledger/diagnostics/AcrossHandler.gandr

// Early exit's host interface.
import std.process;

def one() -> Integer =
  1

@[ refuses("AcrossHandler") ]
def became() -> -F Integer =
  handle c : std.process.Exit.Eff {
    become one ()
  } with {
    | pure(x) => pure x
    | oper exit(code, k) => k *{}
  }
