// A capability returned out of the scope that minted it.
//
// A handled scope mints its capability in a region, and the capability lives
// no longer than the region.
//
// `leak` returns its scope's own capability, which would outlive the region,
// and the checker refuses it.
//
// - see: corpus/ledger/diagnostics/CapabilityEscaped.gandr

// Early exit's host interface.
import std.process;

@[ refuses("CapabilityEscaped") ]
def leak() -> Cap { exit } {
  handle c : std.process.Exit.Eff {
    return c
  } with {
    | pure(x) => x
    | oper exit(code, k) => k *{}
  }
}
