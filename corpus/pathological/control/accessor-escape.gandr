/// A view captured by a thunk: the thunk may be forced after the access that
/// lent the view has ended, so the view would outlive its access.
@[ refuses("ViewEscaped") ]
def leak() -> Integer {
  hold c = 0;
  access c as v { force thunk { resume(v, 1) } };
  pure c
}

/// A held value captured by a thunk would outlive its hold the same way. The
/// thunk here is forced inside the hold, so the refused body still runs to the
/// value it read: the refusal is the checker's caution, not a fault the run
/// meets (#1132).
@[ runs("0"), refuses("HeldCaptured") ]
def stash() -> Integer {
  hold c = 0;
  force thunk { pure c }
}
