// A string standing where a capability is expected.
//
// A capability is a hypothesis a handler or a parameter introduces, and no
// other term stands at its type.
//
// `forged` passes a string literal to `peek`, which takes a capability, and
// the checker refuses it.
//
// - see: corpus/ledger/diagnostics/CapabilityForged.gandr

// The filesystem's host interface.
import std.fs;

def peek(c : Cap { read }) -> [std.fs.Eff] String =
  c.read "notes"

@[ refuses("CapabilityForged") ]
def forged() -> [std.fs.Eff] String =
  peek "fs"
