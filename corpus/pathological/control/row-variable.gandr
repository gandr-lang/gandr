// What `../../model/control/row-variable.gandr` proves, refused: a row
// variable is solved where something reads the call's row, and a row
// without the interface `log` performs is not `log`'s row (#2270).

// `log` prints through `std.io.Console.Eff`, its row open through `r`.
import "../../model/control/row-variable.gandr";

/// A suspended computation taken and never run: its row variable occurs in
/// its argument alone.
def ignored[e : Row](x : +U (-F [e] Unit)) -> Unit { pure unit }

/// One of two suspended computations, run at the row both share.
def either[e : Row](x : +U (-F [e] Unit), y : +U (-F [e] Unit)) -> [e] Unit {
  force x
}

/// A computation at `Partial`, the rest of its row left open.
def stall[r : Row](s : String) -> [Partial | r] Unit { pure unit }

/// `log` suspended and ignored: nothing reads its row, so nothing determines
/// its `r`, and the call is refused naming the slot `log[.r = …]`.
@[ refuses("ImplicitUnsolved") ]
def unread() -> Unit { ignored(thunk { log("unread") }) }

/// `log` and `stall` made to share a row nothing reads: `[std.io.Console.Eff | r]`
/// against `[Partial | r′]`, each open row holding an interface the other lacks,
/// is never decided.
@[ refuses("ImplicitUnsolved") ]
def undecided() -> Unit {
  ignored(thunk { either(thunk { log("one") }, thunk { stall("other") }) })
}

/// A row without `std.io.Console.Eff` is not `log`'s row, whatever its `r`.
@[ refuses("TypeMismatch") ]
def narrowed() -> [Partial] Unit { log("narrowed") }
