// The refusals beside `../../model/modules/model-nested.gandr`: a nested model
// answered by a nested module with no ascription is refused at the outer
// module's header, the attribute before the module stating its expectation
// (#1274); a sealed nested model's point read at the carrier the seal hides is
// a type mismatch (#1311).

// The theories of the nested answer and of the facts around it, and the sealed
// model.
import "../../model/modules/model-nested.gandr";

/// The facts with their nested module unascribed: `Faceted` states a model
/// of `Answering` under `inner`, and a module ascribed no theory is not one.
@[ refuses("OutOfFragment.WrongSort") ]
module Unascribed : Model(Faceted) {
  /// The nested module, ascribed no theory.
  module inner {
    /// The answer.
    def answer = 41;
  }
  /// The total.
  def total = 42;
}

/// The sealed nested point read at the integers: `Sealed.inner.T` is an atom
/// outside the seal, so the point is not an integer there.
@[ refuses("TypeMismatch") ]
def leaked : Integer = Sealed.inner.zero;
