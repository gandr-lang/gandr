// The refusals beside `../../model/modules/model-manifest.gandr`: a model
// sealed at `Model(T)` alone keeps its sort abstract, and a manifest naming a
// sort its theory does not present is refused at the module's header, the
// attribute before the module stating its expectation (#1274).

/// A ratio sort and its scale, as the model fixture's `Metering` has them.
theory Scaled {
  sort Ratio : Type;
  oper scale : Ratio;
}

/// A model sealed with no manifest sort: its `Ratio` is a fresh atom.
module Opaque :> Model(Scaled) {
  type Ratio = Integer;
  /// The scale.
  def scale = 2;
}

/// The sealed scale read as an integer: the seal hides that the ratio is
/// one.
@[ refuses("TypeMismatch") ]
def leaked : Integer = Opaque.scale;

/// A model whose manifest names `Rate`, a sort `Scaled` does not present:
/// refused at its header, by the name it misspells.
@[ refuses("UnknownMember") ]
module Misnamed : Model(Scaled) with sort Rate = Integer {
  type Ratio = Integer;
  /// The scale.
  def scale = 2;
}
