// This source shows two stated types that compare through a model slot. Two
// modules answer the first slot, and no module answers the second.
//
// The signature decides no model for either slot. So each slot waits for the
// body, as it waits in any other position.
//
// The decode of the stated type meets the slot's hole before the body decides
// the slot. So the checker resolves the slot there, and the refusal names the
// modules that answer it, or no module.
//
// - see: #6158 — `twice`
// - see: #6195 — `twice`, `unanswered`
// - see: `../../model/modules/model-stated-type.gandr` — a slot that the signature decides

/// Two codes.
data Code : Type where
  /// The first.
  | Yes : Code
  /// The second.
  | No : Code

/// Two marks, which no module compares.
data Mark : Type where
  /// The first.
  | Up : Mark
  /// The second.
  | Down : Mark

/// The code of a flag.
def ofFlag(b : Bool) -> Code =
  match b where
    | true => Yes
    | false => No

/// The type that a code decodes to.
def decoded(c : Code) -> Type =
  match c where
    | Yes => return String
    | No => return Unit

/// Equality of codes: any two compare equal.
module Always : Model(Eq) with sort Carrier = Code where
  /// Any two codes compare equal.
  def eq(a : Code, b : Code) -> Bool { true }
  /// Each code equals itself.
  def refl(a : Code) -> Path[.A = Bool](eq a a, true) { Path.here true }
  /// The comparison is symmetric.
  def sym(a : Code, b : Code) -> Path[.A = Bool](eq a b, eq b a) { Path.here true }

/// Equality of codes by their constructors.
module ByCode : Model(Eq) with sort Carrier = Code where
  /// Two codes compare equal when they are the same constructor.
  def eq(a : Code, b : Code) -> Bool =
    match a where
      | Yes => match b where
        | Yes => true
        | No => false
      | No => match b where
        | Yes => false
        | No => true
  /// Each code equals itself.
  def refl(a : Code) -> Path[.A = Bool](eq a a, true) =
    match a where
      | Yes => Path.here true
      | No => Path.here true
  /// The comparison is symmetric.
  def sym(a : Code, b : Code) -> Path[.A = Bool](eq a b, eq b a) =
    match a where
      | Yes => match b where
        | Yes => Path.here true
        | No => Path.here false
      | No => match b where
        | Yes => Path.here false
        | No => Path.here true

/// Two modules answer the comparison's model.
@[refuses("ModelAmbiguous")]
def twice : decoded(ofFlag(Yes == No)) = "x";

/// No module answers the comparison's model.
@[refuses("ModelUnanswered")]
def unanswered : decoded(ofFlag(Up == Down)) = "x";
