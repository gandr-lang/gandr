// A definition named like a builtin namespace shadows it: `list.each` then
// reads the record's field, not the builtin.

/// A record named `list`, with a field `each`.
@[ checks ]
def list = #{each = 7};

/// The run target reads the field; the lowering admits no field projection
/// yet (#1106).
@[ refuses("OutOfFragment.projection_expression") ]
list.each
