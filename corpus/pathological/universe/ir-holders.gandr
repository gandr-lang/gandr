// The holders of the roles of inductive-recursive definitions, with a holder
// of `E` that departs from its canonical body.
//
// A holder takes its role only when it answers the canonical form of that
// role. So a holder that departs from it holds no role.
//
// The checker compares the holder of `E` with the canonical body at each code.
// The canonical `δ` case asks for a function from `a` into the family, which
// the rest reads through its decodes. This holder asks for a function from
// the family into `a`. The checker refuses it at `δ`, and it holds no role.
//
// - owes: #3575 — the family a code defines, with its decoder
// - see: `model/universe/ir-codes.gandr` — the codes and their arguments,
//   admitted

/// The dependent pairs over a family of types.
@[ builtin(irPair) ]
data Pair(a : Type, b : a -> Type) : Type where
  /// A value of the first type with a value of the type it picks.
  | MkPair : (x : a, y : b(x)) --> Pair(a, b)

/// The codes over a type of decodes `d`.
@[ builtin(irSignature) ]
data Codes(d : Type) : Type[+, 1] where
  /// No argument, the decode `e`.
  | Stop : (e : d) --> Codes(d)
  /// A value of the type `a`, and the code the rest reads it by.
  | Ask : (a : Type, f : a -> Codes(d)) --> Codes(d)
  /// A function from `a` into the family, read through its decodes.
  | Read : (a : Type, f : (a -> d) -> Codes(d)) --> Codes(d)

/// The arguments a code asks for, with a `δ` case that asks for a function
/// from the family into `a`.
@[ builtin(irArgs), refuses("BuiltinNotCanonical") ]
def rec fields(d : Type, c : Codes(d), x : Type, t : x -> d) -> Type =
  match c where
    | Stop(e) => return Unit
    | Ask(a, f) => return (Pair a (fun (y) { fields[<] d (f y) x t }))
    | Read(a, f) => return (Pair (x -> a) (fun (h) { return Unit }))
