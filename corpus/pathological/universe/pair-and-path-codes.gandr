//! A Tarski universe closed under dependent pairs, with the decoder arm that
//! stays refused.
//!
//! Martin-Löf's universe is closed under dependent functions, dependent pairs
//! and identity types. Each such code decodes to a family at the decodes of
//! its fields. A decode thus stands as a family's argument.
//!
//! A run binds a decode as a type of its own. A field at the code's decode
//! then stands apart from it.
//!
//! - see: `model/universe/pair-and-path-codes.gandr` — the pair and path
//!   codes with their decodes in place, admitted
//! - cites: [MartinLof-1984-intuitionistic_type_theory]
//!
//! [MartinLof-1984-intuitionistic_type_theory]: https://archive-pml.github.io/martin-lof/pdfs/Bibliopolis-Book-retypeset-1984.pdf "Martin-Löf, Intuitionistic Type Theory"

// The naturals.
import "../../model/data/data-base.gandr";

// The dependent pairs.
import "../../model/universe/ir-codes.gandr";

/// The dependent pair code with a run for its first decode, in one block.
rec {
  /// The codes. They share their decoder's refusal.
  @[ refuses("TypeMismatch") ]
  data USigRun : Type where {
    /// The naturals.
    | NatR : USigRun
    /// The dependent pairs from a coded type to a family of codes over its
    /// decode.
    | SigR : (a : USigRun, b : elSigRun(a) -> USigRun) --> USigRun
  }

  /// The decoder. Its second family's binder stands at the bound type, not
  /// at the field's decode.
  @[ refuses("TypeMismatch") ]
  def rec elSigRun(u : USigRun) -> Type =
    match u where
      | NatR => return Nat
      | SigR(a, b) => {
        let t = elSigRun[<] a;
        return (Sig t (thunk { fun (x) { elSigRun[<] (b x) } }))
      }
}
