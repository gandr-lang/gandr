// The fresh lists in their intended form, with each refusal.
//
// Freshness pairs two types. Two calls compute them. The front end refuses
// those calls in place as a family's arguments. The pair never reaches the
// checker.
//
// The freshness below is the model's, with its types in place. It is its own
// block. Its refusal leaves the model's lists standing.
//
// - see: #3572 — not implemented: a call as a family's argument
// - see: `model/universe/fresh-lists.gandr` — the lists, admitted with their
//   types bound by runs

// The naturals.
import "../../model/data/data-base.gandr";

// The fresh lists.
import "../../model/universe/fresh-lists.gandr";

/// The fresh lists with their freshness in place, in one block.
rec {
  /// The lists. They share their freshness's refusal.
  @[ refuses("UnenclosedRun"), form(explicit) ]
  data FreshIn : Type {
    /// The empty list.
    INil : FreshIn;
    /// A head, a tail, and the head's freshness for the tail.
    ICons : (x : Nat, xs : FreshIn, p : freshIn(x, xs)) --> FreshIn;
  }

  /// Freshness with the pair's two types as calls.
  @[ refuses("UnenclosedRun") ]
  def rec freshIn(x : Nat, xs : FreshIn) -> -F Type {
    case xs {
      INil => return Unit,
      ICons(y, ys, q) => return (Both(apart(x, y), freshIn[<](x, ys)))
    }
  }
}
