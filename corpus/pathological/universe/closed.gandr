// What a hand-written Tarski universe refuses. A decode that runs to a quote
// is the quoted type, so a value of another type is refused there; a decode
// over a binder is a type of its own, so a value at `el(c)` does not stand
// at the decode of the arrow from `c` to `c`; a field read through the code
// before it checks at that code's decode; and the decoder named with no code
// is no type.

/// Natural numbers, free: every constructor term is its own value.
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

/// The codes: the naturals, and the functions from one coded type to another.
@[ checks ]
data U : Type {
  NatC : U;
  Arrow : (a : U, b : U) --> U;
}

/// The decoder: each arm returns the type its code names.
@[ checks ]
def rec el(u : U) -> -F Type {
  case u {
    NatC => return Nat,
    Arrow(a, b) => { run x <- el[<](a); run y <- el[<](b); return (x => y) }
  }
}

/// One is a natural, and the decode of the arrow code runs to `Nat => Nat`.
@[ refuses("TypeMismatch") ]
def one : el(Arrow(NatC, NatC)) = Succ(Zero) ;

/// At every code `c`, a value at `el(c)` is no function from `el(c)` to
/// `el(c)`: the decode of the arrow code reads to that function type.
@[ refuses("TypeMismatch") ]
def idAt(c : U, v : el(c)) -> -F el(Arrow(c, c)) { v }

/// A value packed with its code: the second field's type is the decode of the
/// first.
@[ checks ]
data Coded : Type {
  Pack : (c : U, v : el(c)) --> Coded;
}

/// A code packed where the natural code says a natural stands: the second
/// field checks at `el(NatC)`, which runs to `Nat`.
@[ refuses("TypeMismatch") ]
def miscoded : Coded = Pack(NatC, NatC) ;

/// The decoder named bare where a type is read: `el` computes a code only once
/// applied, so the head is refused at the arity it was offered, not read as a
/// path endpoint (#690).
@[ refuses("OutOfFragment.Arity") ]
def unapplied(c : U) -> -F el { return c }
