// The holders of the roles of inductive-recursive definitions, with a family
// whose decoder holds no role.
//
// The canonical family's field names its decoder, the declaration right after
// it. That decoder holds the decoder role, or the family is no canonical
// family. A decoder that holds no role keeps the stage check.
//
// The checker reads the declaration after the family. This one holds no role,
// so the checker refuses the family. The decoder calls itself through the
// decode of the arguments, at no stage below its value, and the stage order
// refuses it.
//
// - see: `model/universe/ir-codes.gandr` — the family a signature defines and
//   its decoder, admitted

/// The dependent pairs over a family of types.
@[ builtin(irPair) ]
data DPair(a : Type, b : a -> Type) : Type where
  /// A value of the first type with a value of the type it picks.
  | MkDPair : (x : a, y : b(x)) --> DPair(a, b)

/// The signatures over a type of decodes `d`.
@[ builtin(irSignature) ]
data Sig(d : Type) : Type[+, 1] where
  /// No argument, the decode `e`.
  | Iota : (e : d) --> Sig(d)
  /// A value of the type `a`, and the signature the rest reads it by.
  | SigmaC : (a : Type, f : a -> Sig(d)) --> Sig(d)
  /// A function from `a` into the family, read through its decodes.
  | DeltaC : (a : Type, f : (a -> d) -> Sig(d)) --> Sig(d)

/// The arguments a signature asks for over a family `x`.
@[ builtin(irArgs) ]
def rec args(d : Type, c : Sig(d), x : Type, t : x -> d) -> Type =
  match c
    | Iota(e) => return Unit
    | SigmaC(a, f) => return (DPair a (fun (y) { args[<] d (f y) x t }))
    | DeltaC(a, f) => return (DPair (a -> x) (fun (h) { args[<] d (f (fun (z) { t (h z) })) x t }))

/// The decode of the arguments a signature asks for.
@[ builtin(irDecode), form(explicit) ]
def rec decodeArgs(d : Type, c : Sig(d), x : Type, t : x -> d, v : args(d, c, x, t)) -> d =
  match c
    | Iota(e) => e
    | SigmaC(a, f) => match v
      | MkDPair(y, r) => decodeArgs[<] d (f y) x t r
    | DeltaC(a, f) => match v
      | MkDPair(h, r) => decodeArgs[<] d (f (fun (z) { t (h z) })) x t r

/// The family and a decoder that holds no role.
rec {
  /// The family that the signature `c` defines. Its decoder holds no role.
  @[ builtin(irFamily), form(explicit), refuses("BuiltinNotCanonical") ]
  data IR(d : Type, c : Sig(d)) : Type where {
    /// The arguments over the family.
    | Intro : (x : args(d, c, IR(d, c), thunk { fun (m) { el d c m } })) --> IR(d, c)
  }

  /// The canonical decoder's body, with no role: the stage order refuses its
  /// call.
  @[ refuses("StageNotBelow") ]
  def rec el(d : Type, c : Sig(d), m : IR(d, c)) -> d =
    match m
      | Intro(x) => decodeArgs d c (IR d c) (thunk { fun (n) { el[<] d c n } }) x
}
