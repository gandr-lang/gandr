// A pending completion dropped: a read is submitted and its completion is
// never reaped, though the kernel posts "exactly one matching CQE for every
// SQE" (io_uring(7)). The pending end stays open when the program ends.

// The ring's protocol and its entries.
import "../../model/completion/ring-base.gandr";

/// A read submitted and its pending completion left unreaped.
@[ refuses("LinearResidue") ]
def pendingDropped() -> Unit {
  let ring = fork (kernel : Ring.Submission) {
    let sqe = recv(kernel);
    send(kernel, Ring.done);
    close(kernel)
  };
  send(ring, Ring.read);
  pure unit
}
