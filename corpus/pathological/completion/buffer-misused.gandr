//! A ring buffer held other than exactly once. The kernel owns a buffer while
//! an operation is in flight and hands it back with the completion
//! [boats-2020-notes_on_io_uring]: a buffer never handed back leaks its slot in
//! the registered area, one handed back twice is reclaimed while the kernel may
//! still own it, and one read while held would observe bytes the kernel may
//! still be writing.
//!
//! - see: #1792 — `freedInOneArm`
//! - cites: [boats-2020-notes_on_io_uring]
//!
//! [boats-2020-notes_on_io_uring]: https://without.boats/blog/io-uring/ "boats, Notes on io-uring"

// The native buffer a receive places live.
import std.buffer (Buf);

// The ring's host interface.
import std.io;

/// A buffer allocated and never freed.
@[refuses("BufferUnreturned")]
def neverFreed() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    pure *{}
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
  }

/// A buffer freed twice.
@[refuses("BufferReturnedTwice")]
def freedTwice() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    let first = r.free b;
    r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
  }

/// A buffer read as a value while it is held.
@[refuses("BufferRead")]
def readWhileHeld() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    let copied : Buf = b;
    r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
  }

/// An `alloc` clause that drops the buffer its scope minted rather than
/// resuming with it.
@[refuses("BufferUnreturned")]
def mintDropped() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => pure *{}
    | oper free(b, k) => k *{}
  }

/// A mock kernel that receives a buffer and never hands it back: the receive
/// placed it live, and the kernel's body ends holding it.
@[refuses("BufferUnreturned")]
def receivedKept() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => {
      let ring = fork (kernel : ?Buf. end) {
        let held = recv kernel;
        close kernel
      };
      send ring b;
      close ring
    }
    | oper free(b, k) => k *{}
  }

/// A mock kernel that hands the buffer it received back twice.
@[refuses("BufferReturnedTwice")]
def receivedReturnedTwice() -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    r.free b
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => {
      let ring = fork (kernel : ?Buf. !Buf. !Buf. end) {
        let held = recv kernel;
        send kernel held;
        send kernel held;
        close kernel
      };
      send ring b;
      let first = recv ring;
      let second = recv ring;
      close ring;
      k first
    }
    | oper free(b, k) => k *{}
  }

/// A buffer freed in one arm of a case and kept in the other, refused at the
/// arm that keeps it.
@[refuses("BufferUnreturned")]
def freedInOneArm(flag : Bool) -> Unit =
  handle r : std.io.Ring.Eff {
    let b = r.alloc 4096;
    match flag where
      | true => r.free b
      | false => pure *{}
  } with {
    | pure(x) => pure x
    | oper alloc(n, b, k) => k b
    | oper free(b, k) => k *{}
  }
