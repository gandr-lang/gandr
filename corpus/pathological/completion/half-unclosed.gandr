// A fork's half that ends in a statement without closing its endpoint: the
// statement runs and the half returns the unit with the endpoint still open,
// which the checker refuses as the residue it is (#1205).

// The ring's protocol and its entries.
import "../../model/completion/ring-base.gandr" ;

/// The target's half sends its completion and ends without closing.
@[ refuses("LinearResidue") ]
def halfUnclosed() -> Unit {
  fork (target : Ring.Submission) {
    recv(target) as sqe;
    send(target, Ring.done);
  } as pending;
  fork (canceller : Ring.Submission) {
    recv(canceller) as sqe;
    send(canceller, Ring.done);
    close(canceller)
  } as cancel;
  send(pending, Ring.read);
  send(cancel, Ring.read);
  recv(pending) as first;
  recv(cancel) as second;
  close(pending);
  close(cancel)
}
