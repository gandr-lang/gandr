//! A buffer's region ended under its pending completion: buffers passed to a
//! read "must remain valid until completion" (io_uring(7)), so the region the
//! buffer lives in may not end while the submission that holds it is pending.
//! The kernel is a forked peer, which no region bounds, so a submission that
//! carries a value kept in a region is refused where the kernel is forked. A
//! region is a static extent erased before anything runs
//! [Koronkevich-2025-type_universes_kripke_worlds].
//!
//! - cites: [Koronkevich-2025-type_universes_kripke_worlds]
//!
//! [Koronkevich-2025-type_universes_kripke_worlds]: https://doi.org/10.1145/3747532 "Koronkevich and Bowman, Type Universes as Kripke Worlds"

// The ring's protocol and its entries.
import "../../model/completion/ring-base.gandr";

/// A view of the held buffer kept in the hold's region and submitted to a
/// kernel the region does not bound: the hold could end with the completion
/// pending and the kernel still holding the view.
@[ refuses("KeptEscaped") ]
def regionEnded() -> Unit =
  var buf = Ring.read
  let buffer : (() -> Ring.Sqe) at buf = access shared buf as w { pure thunk { pure w } };
  let ring = fork (kernel : ?((() -> Ring.Sqe) at buf). !(Ring.Cqe). end) {
    let sqe = recv kernel;
    send kernel Ring.done;
    close kernel
  };
  send ring buffer
  let cqe = recv ring
  close ring
