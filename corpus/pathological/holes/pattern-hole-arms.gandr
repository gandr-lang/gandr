// A pattern hole leaves the arm that runs undecided: the match's tree has a
// leaf no arm owns, so the match is not shown to cover its scrutinee, and the
// checker refuses it by name. The twin in `model/holes/` writes every
// arm.
//
// - see: #391 — `classify`, `unwrap`

/// Three colours, one arm each.
data Color : Type where
  | Red : Color
  | Green : Color
  | Blue : Color

/// A colour, or none.
data Chosen : Type where
  | Unchosen : Chosen
  | Chose : (c : Color) --> Chosen

/// `Green` reaches the hole between `Red` and `Blue`: possibly covered, and
/// refused.
@[refuses("UndecidedCoverage")]
def classify(c : Color) -> Integer =
  match c where
    | Red => 0
    | ? => 1
    | Blue => 2

/// A hole in a constructor's field leaves the arm for `Chose` undecided too.
@[refuses("UndecidedCoverage")]
def unwrap(m : Chosen) -> Integer =
  match m where
    | Unchosen => 0
    | Chose(?) => 1
