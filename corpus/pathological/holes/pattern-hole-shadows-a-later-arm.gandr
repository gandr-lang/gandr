// A pattern hole before an arm may shadow it: whether `Blue` reaches its own
// arm or the hole is undecided, and the checker refuses the match (#391).

/// Three colours, one arm each.
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

/// The hole stands before `Blue`'s arm (#391).
@[ refuses("UndecidedCoverage") ]
def classify(c : Color) -> Integer {
  case c {
    Red => 0,
    ? => 1,
    Blue => 2
  }
}

/// The run target classifies `Blue`: it checks against `classify`'s
/// signature, whose body is refused above, so it is not run.
classify(Blue)
