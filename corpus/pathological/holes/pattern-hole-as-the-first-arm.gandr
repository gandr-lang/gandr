// A named pattern hole as a match's only arm leaves every colour to the hole,
// so which arm runs is undecided and the checker refuses the match (#391).
// `pattern-hole-arms.gandr` refuses the same leaf beside written arms.

/// Three colours, one arm each.
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

/// Every colour reaches the hole (#391).
@[ refuses("UndecidedCoverage") ]
def classify(c : Color) -> Integer {
  case c {
    ?branch => 1
  }
}

/// The function, named again: it checks against `classify`'s signature, whose
/// body is refused above, so it is not run.
def named = classify;
