// The refusals of the wildcard (#528): a wildcard nothing forces, one forced
// apart from the type its caller expects, one where a computation is read,
// and one in an ascription's type, which the store does not yet serve.

// `idAt`, the identity at a type passed explicitly.
import "../../model/holes/wildcard.gandr" ;

/// `idAt` at `Integer` with its value left open: nothing forces which
/// integer.
@[ refuses("ImplicitUnsolved") ]
def loose() -> -F Integer { become idAt(Integer, _) }

/// `idAt` at a type `3` forces to `Integer` where a unit is expected: the
/// returned type then disagrees with `Unit`.
@[ refuses("TypeMismatch") ]
def disagreeing() -> -F Unit { become idAt(_, 3) }

/// A wildcard bound by `run`, where a computation is read: the solver binds
/// values, so a wildcard is a form of the wrong sort there.
@[ refuses("OutOfFragment.WrongSort") ]
def ranWildcard() -> -F Integer {
  run x <- _;
  x
}

/// A path's right end left in an ascription's type for `here(3)` to force:
/// the ascription's type is not posed to the store, so nothing solves it
/// (#1979).
@[ refuses("ImplicitUnsolved") ]
def endForced() -> -F Path(Integer, 3, 3) { (here(3) : Path(Integer, 3, _)) }
