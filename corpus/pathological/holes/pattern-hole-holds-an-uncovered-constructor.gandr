// A pattern hole holds the one constructor no written arm covers, `Green`,
// so which arm runs for it is undecided and the checker refuses the match
// (#391).

/// Three colours, one arm each.
@[ checks ]
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

/// `Green` falls to the hole (#391).
@[ refuses("UndecidedCoverage") ]
def classify(c : Color) -> -F Integer {
  case c {
    Red => 0,
    ? => 1,
    Blue => 2
  }
}

/// The run target classifies `Green`: it checks against `classify`'s
/// signature, whose body is refused above, so it is not run.
@[ checks ]
classify(Green)
