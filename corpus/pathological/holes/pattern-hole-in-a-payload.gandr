// A pattern hole inside a constructor's payload leaves which values of the
// payload the arm covers undecided, and the checker refuses the match (#391).

/// An integer, or none.
data Maybe : Type {
  Nothing : Maybe;
  Just : (x : Integer) --> Maybe;
}

/// The hole stands for `Just`'s payload (#391).
@[ refuses("UndecidedCoverage") ]
def describe(m : Maybe) -> Integer {
  case m {
    Just(?) => 100,
    Nothing => 200
  }
}

/// `Just(3)` described: it checks against `describe`'s signature, whose body
/// is refused above, so it is not run.
def described() -> Integer { describe(Just(3)) }
