//! `streams` rejects named forms.
//!
//! Codata needs a computation universe.
//! A copattern block answers each observation once.
//! A productive call needs a whole copattern arm.
//!
//! The checker refuses another `>` placement until it carries sized-rung
//! evidence.
//! The accepted twin provides productive streams.
//!
//! - see: #644
//! - see: #392 — `fibs`
//! - see: #2188 — `Swap`, `Twisted`

/// A stream provides an integer head and its tail stream.
codata Stream : Type[-] where
  head : Integer;
  tail : Stream;

/// Point is refused because its kind is a value universe.
@[refuses("CodataKindNotUniverse")]
codata Point : Type where
  x : Integer;
  depth : Integer;

/// Swap is refused because its recursive occurrence reverses its parameters.
@[refuses("CodataOccurrence")]
codata Swap(a : Type, b : Type) : Type[-] where
  head : a;
  tail : Swap b a;

/// Twisted is refused because its recursive occurrence nests its own argument.
@[refuses("CodataOccurrence")]
codata Twisted(a : Type) : Type[-] where
  head : a;
  tail : Twisted (Twisted a);

/// Spot defines three observation positions.
codata Spot : Type[-] where
  x : Integer;
  y : Integer;
  depth : Integer;

/// shallow is refused because it leaves depth unanswered.
@[refuses("MalformedForm")]
def shallow(n : Integer) -> Spot =
  &{.x => return n, .y => return n}

/// stray is refused because it answers no declared z observation.
@[refuses("UnresolvedName")]
def stray(n : Integer) -> Spot =
  &{.x => return n, .y => return n, .z => return n}

/// peek observes a stream head.
def peek(s : +U Stream) -> Integer =
  become s.head

/// sums adds two streams pointwise.
def rec sums(s : +U Stream, t : +U Stream) -> Stream =
  &{
    .head => {
      let x = peek s;
      let y = peek t;
      x + y
    },
    .tail => sums[>] s.tail t.tail
  }

/// fibs is refused because sums hides its recursive call from the guard.
@[refuses("UnguardedCorecursion")]
def rec fibs(n : Integer) -> Stream =
  &{
    .head => return n,
    .tail => sums (thunk { fibs[>] n }) (thunk { fibs[>] n })
  }

/// deferred is refused because its productive call stands under become.
@[refuses("UnguardedCorecursion")]
def rec deferred(n : Integer) -> Stream =
  &{.head => return n, .tail => become deferred[>] n}

/// bare is refused because its productive call stands outside
/// a copattern block.
@[refuses("UnguardedCorecursion")]
def rec bare(n : Integer) -> Stream =
  bare[>] n
