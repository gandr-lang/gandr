@[ refuses("OutOfFragment.Endpoint") ]
def parameter_as_endpoint(rounds : Integer) -> -F Unit {
  close(rounds)
}

@[ refuses("OutOfFragment.NonContractive") ]
def recursion_before_any_action() -> -F Unit {
  fork (seat : mu turn. turn) { close(seat) } as desk;
  close(desk)
}

@[ refuses("OutOfFragment.WrongSort") ]
def value_type_as_continuation() -> -F Unit {
  fork (seat : !Integer. Integer) { close(seat) } as desk;
  close(desk)
}

@[ refuses("MalformedForm") ]
def branch_without_label() -> -F Unit {
  fork (seat : !Integer. +{ end, end }) { close(seat) } as desk;
  close(desk)
}
