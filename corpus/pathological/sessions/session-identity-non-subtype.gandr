module Evolution {
  type SeatEnd = ?String. mu turn. +{
    report : !String. &{next : turn, retire : end},
    handoff : !String. end
  };
  type SeatEnd′ = ?String. mu turn. +{
    report : !String. &{next : turn, retire : end},
    handoff : !String. end,
    pause : !String. turn
  };
  @[ refuses("SessionNotSubtype") ]
  def narrowed : Flow(Type, SeatEnd′, SeatEnd) = sim(SeatEnd′, SeatEnd);
}
