// The twin of `../../model/sessions/type-quote.gandr`: a type quote is the
// code of the type it quotes and of no other (#839).

/// The stationary flow at a protocol that opens with a receive is no flow to
/// one that opens with a send.
@[ refuses("EndpointMismatch") ]
def quoted_receive : Flow(Type, ?String. end, !String. end) = stay(type(?String. end)) ;

/// A quote beneath a motive's binder whose payload reads that binder: a
/// session's payload codes form in the empty term context, so the quote is
/// the code of no session at any point of the motive (#1728).
@[ refuses("OpenSessionPayload") ]
def open_payload : Path(Type, ?String. end, ?String. end) = transport(
  \X. Path(Type, type(?String. end), type(?X. end)),
  here(String),
  here(type(?String. end))
) ;
