@[ refuses("SessionMismatch") ]
def desk_receives_first() -> Unit {
  fork (seat : ?String. end) { recv(seat) as task; close(seat) } as desk;
  recv(desk) as task;
  close(desk)
}

@[ refuses("UnofferedLabel") ]
def desk_selects_no_offered_label() -> Unit {
  fork (seat : &{ next : end }) { offer(seat) { next => close(seat) } } as desk;
  select(desk, retire);
  close(desk)
}

@[ refuses("OfferArms") ]
def seat_arms_one_label_of_two() -> Unit {
  fork (seat : &{ next : end, retire : end }) { offer(seat) { next => close(seat) } } as desk;
  select(desk, next);
  close(desk)
}

/// A drop is the end action, so an endpoint whose protocol still selects is
/// not dropped: the desk drops where it offers.
@[ refuses("SessionMismatch") ]
def desk_drops_a_live_endpoint() -> Unit {
  fork (seat : +{ done : end }) { select(seat, done); drop(seat) } as desk;
  drop(desk)
}
