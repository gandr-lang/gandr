// An open play ridden along a flow whose target drops an offer: a play that
// has not reached the offer rides, one that took the dropped branch is no
// prefix of the target and is refused at that move, and a play held by a
// variable, which may yet take it, is refused as narrowing.

/// The seat's protocol and one that no longer offers `retire`, related by
/// simulation.
module Evolution {
  type SeatEnd = ?String. mu turn. +{
    report : !String. &{next : turn, retire : end},
    handoff : !String. end
  };
  type Kept = ?String. mu turn. +{report : !String. &{next : turn}, handoff : !String. end};
  @[ checks ]
  def keep : Flow(Type, SeatEnd, Kept) = sim(SeatEnd, Kept);
}

/// A seat that reported, its offer not yet taken.
def reported : Prefix(Evolution.SeatEnd) = recorded(
  received("task"),
  selected(report),
  sent("progress")
);

/// The seat after it took `retire`.
def retired : Prefix(Evolution.SeatEnd) = recorded(
  received("task"),
  selected(report),
  sent("progress"),
  offered(retire)
);

/// Short of the offer, the play is a prefix of the narrowed protocol too.
def kept() -> Prefix(Evolution.Kept) { ride(\X. Prefix(X), Evolution.keep, reported) }

/// `Kept` offers no `retire`: refused at that move (#1318).
@[ refuses("RunNotAdmitted") ]
def dropped() -> Prefix(Evolution.Kept) { ride(\X. Prefix(X), Evolution.keep, retired) }

/// A play the checker cannot read may yet take `retire`: refused (#1318).
@[ refuses("RunNotAdmitted") ]
def narrowed(play : Prefix(Evolution.SeatEnd)) -> Prefix(Evolution.Kept) {
  ride(\X. Prefix(X), Evolution.keep, play)
}
