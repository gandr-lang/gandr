// A run ridden along a flow whose target drops the move it took is refused.
//
// The run took `retire`, which the narrowed protocol no longer offers, so no
// run of the target holds its moves.
//
// The ride moves the run by the simulation, and the monitor of the target
// refuses it at the dropped offer.
//
// - see: `../../ledger/features/session-identity.gandr`

// The native session formers.
import std.session (Run);

module Evolution where {
  type SeatEnd = ?String. mu turn. +{
    report : !String. &{next : turn, retire : end},
    handoff : !String. end
  };
  type Kept = ?String. mu turn. +{report : !String. &{next : turn}, handoff : !String. end};
  @[ checks ]
  def keep : Flow(Type, SeatEnd, Kept) = Flow.sim(SeatEnd, Kept);
}

def served : Run(Evolution.SeatEnd) = recorded(
  received("task"),
  selected(report),
  sent("progress"),
  offered(retire),
  closed
);

@[ refuses("RunNotAdmitted") ]
def retired() -> Run(Evolution.Kept) { Flow.ride(fun (X) { Run(X) }, Evolution.keep, served) }
