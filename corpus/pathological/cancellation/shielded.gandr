@![features((
  "call-by-push-value",
  "effect-handlers",
  "imports",
  "let-statements",
  "modules",
  "session-types",
  "temporary-access"
))]

// An unwind is a shielded section: it runs to completion under the empty row,
// which carries no abandonment, so a cancellation written inside one is
// refused, and no cancellation reaches a cancellation already running.
//
// - see: #1334 — `shielded`

// The task's protocol.
import "../../model/cancellation/cancel-base.gandr"
// Early exit's host interface.
import std.process

/// A scope whose exit clause abandons the rest from inside an unwind.
@[refuses("UnwindEffect")]
def shielded() -> Unit =
  effect c : std.process.Exit.Eff {
    let found = fork (task : Cancel.Join) {
      send task Cancel.notes
      close task
    }
    c.exit 1
    let text = recv found
    close found
  } handle {
    | pure(x) => pure x
    | oper exit(code, k) =>
      var n = 0
      access n as v { abort v } unwind { abandon k }
  }
