// A clause owes the rest of its scope exactly one end once that rest holds a
// task's end. A clause that neither resumes nor abandons it would leave the
// end open with no one left to close it, so the clause is refused.

// The task's protocol.
import "../../model/cancellation/cancel-base.gandr";

/// A scope whose exit clause drops the rest while its task's end is open
/// (#1334).
@[ refuses("ContinuationUnspent") ]
def dropped() -> Unit {
  handle c : std.process.Exit.Eff {
    let found = fork (task : Cancel.Join) {
      send(task, Cancel.notes);
      close(task)
    };
    c.exit(1);
    let text = recv(found);
    close(found)
  } with {
    pure(x) => pure x,
    oper exit(code, k) => pure unit
  }
}
