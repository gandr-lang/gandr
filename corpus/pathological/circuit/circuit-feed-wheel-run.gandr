// The wheel of `model/circuit/circuit-feed-wheel.gandr`, run: a model of
// `Wheel` gives `Nat` and `emit`, and driving `spin` over a stream reads the
// outputs it feeds back. A model does not yet state a circuit rule, so the
// model is refused and nothing runs; the refusal names #1323, the unit that
// builds it.

// The wheel's theory.
import "../../model/circuit/circuit-feed-wheel.gandr";

/// The running sum's step, the `emit` its model gives: the output fed back
/// plus the stream's value.
def step(s : Integer, x : Integer) -> Integer { s + x }

/// The trace the wheel would run over `1, 2, 3` from zero, unrolled by hand:
/// each tick's output is the next tick's `s`, reading `1`, `3`, then `6`.
@[ runs("6") ]
def unrolled() -> Integer {
  step(step(step(0, 1), 2), 3)
}

/// The wheel as a running sum, `Nat` the integers and `emit` the step, so
/// `spin` over `1, 2, 3` answers what `unrolled` does. `Model(Wheel)` cannot
/// state `spin`, a circuit rule (#1323).
@[ refuses("UnstatedComponent.Circuit") ]
def summing : Model(Wheel);
