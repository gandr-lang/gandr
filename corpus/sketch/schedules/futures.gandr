/// An effectful future's type states when it starts, and an executor is a
/// handler.
///
/// A pure cut's start is a strategy's choice, since no answer can tell eager
/// from lazy. An effect's start is observable, so its type states it.
///
/// Readiness is `poll` codata, inert until observed, as Rust's futures are.
/// Completion is a cut whose writer starts at once. An executor handles the
/// await effect, and a program may define its own.
///
/// - see: #4718 — the schedules sketch, its rulings in the issue body
/// - see: futures-are-cuts.md — item 2, linear and shared futures by grade

// The await effect, readiness and completion.
import std.async (Await, Poll, Ready, Pending, await);

/// A socket read as readiness: nothing runs until an executor polls it.
def readiness(socket : Socket, buffer : Bytes) -> Poll(Nat) {
  &{ .poll => socket.tryRead(buffer) }
}

/// A file read as completion: the kernel starts it at once, and the reader
/// awaits its answer.
def completion(ring : Ring, file : File, buffer : Bytes) -> [Await] Nat {
  let pending = ring.submitRead(file, buffer);
  await(pending)
}

/// A single-threaded executor: it polls each future until it is ready.
def runToCompletion[A : Type](task : Poll(A)) -> [Div] A {
  loop {
    match task.poll {
      | Ready(x) => break x
      | Pending => continue
    }
  }
}

/// A program's executor, chosen by the handler around its body.
def main() -> [Io] Unit {
  handle serve() with Executor.threadPool(4)
}
