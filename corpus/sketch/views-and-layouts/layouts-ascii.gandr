/// Two list layouts and a tree layout, in the reader's ASCII spelling.
///
/// Ribbit's notation pastes in from its papers. An ASCII spelling stands
/// beside it for a keyboard without `⋉`.
///
/// `word64` is Ribbit's `_64`, and `ptr64 { … }` is its `&64 {{ … }}`.
/// `bits[o..e] = v` is its `⋉ [o : e - o] : (v)`. Both spellings stay open
/// to revision.
///
/// - see: #4561 — the views and layouts sketch, its rulings in the issue body
/// - see: corpus/sketch/views-and-layouts/layouts.gandr — the list layouts in Ribbit's notation

// The layout type and its `#ribbit` reader.
import std.mem (Layout);

/// A list of `i32` in the tagged layout.
@[layout(tagged)]
pub data Ints : Type where {
  /// The empty list.
  | Nil : Ints
  /// `head` before `tail`.
  | Cons : (head : i32, tail : Ints) --> Ints
}

/// The pointer-tagged layout, in ASCII.
pub def tagged : Layout(Ints) = #ribbit{
  Nil  => word64 bits[0..1] = 1
  Cons => ptr64 { head, tail } bits[0..1] = 0
}

/// The packed layout, in ASCII.
pub def packed : Layout(Ints) = #ribbit{
  Nil                    => word64 bits[0..2] = 0
  Cons(x, Nil)           => word64 bits[0..2] = 1, bits[2..34] = x
  Cons(x, Cons(y, rest)) => ptr64 { x, y, rest } bits[0..2] = 2
}

/// A binary tree of `i32`.
@[layout(compact)]
pub data Tree : Type where {
  /// The empty tree.
  | Leaf : Tree
  /// `value` between `left` and `right`.
  | Node : (left : Tree, value : i32, right : Tree) --> Tree
}

/// A tree whose leaves hold no cell: a node over two leaves sits inline in
/// its word, and every other node behind a pointer.
pub def compact : Layout(Tree) = #ribbit{
  Leaf                   => word64 bits[0..2] = 0
  Node(Leaf, v, Leaf)    => word64 bits[0..2] = 1, bits[2..34] = v
  Node(left, v, right)   => ptr64 { left, v, right } bits[0..2] = 2
}

/// The sum of a tree, written over the tree, whichever layout it has.
def rec total(t : Tree) -> i64 {
  match t {
    Leaf => 0i64,
    Node(left, v, right) => total[<](left) + widen(v) + total[<](right)
  }
}
