/// Oracles compared as sessions are: a reduction is a flow, an equivalence a
/// path.
///
/// A SAT query reduces to an SMT query. A certificate from one solver then
/// serves where a program asks the other, and the comparison says when.
///
/// `sim(Sat, Smt)` is an instance reduction, a flow from the weaker oracle to
/// the stronger. `bisim(SmtA, SmtB)` is a path between two oracles of one
/// power. A recorded certificate rides forward along either by transport.
///
/// - see: #4566 — the oracles sketch, its rulings in the issue body
/// - see: corpus/ledger/features/session-identity.gandr — `sim` and `bisim` over protocols

// The solver theory.
import "./solver.gandr";

/// The propositional oracle: a clause set and whether it is satisfiable.
pub theory Sat where {
  /// A set of clauses in conjunctive normal form.
  sort Clauses : Type;
  /// Asks whether a clause set is satisfiable.
  oper solve : (c : Clauses) --> Outcome(Satisfiable(c));
}

/// A SAT query asked as an SMT query: each clause set read as a formula.
pub def satToSmt : sim(Sat, Smt) = Flow.reduce(fun (c) { Query.sat(Formula.ofClauses(c)) });

/// Two encodings of bit-vector queries, the same oracle up to the sheaf
/// equations.
pub def encodings : bisim(SmtBitBlast, SmtLazy) = Path.oracle(bitBlastIsLazy);

/// A certificate recorded under SAT, carried to SMT along the reduction.
def replayed(c : Clauses, cert : Certificate(Sat, c)) -> Certificate(Smt, Query.sat(Formula.ofClauses(c))) {
  Flow.walk(satToSmt, cert)
}
