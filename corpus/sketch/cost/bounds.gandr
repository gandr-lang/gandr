/// A `measure` block bounds a run's cost. Conversion decides a closed run,
/// and a proof answers an open one.
///
/// A routine on a hot path promises a bound to its callers. A closed run's
/// bound is a computation, and an open one is a proof over the input.
///
/// `measure { cost c }` states decalf's directed inequation: the run costs no
/// more than `c`. Conversion decides a closed run, and the kernel replays it.
/// An open bound is an obligation, proved with `with` by the author or by a
/// solver's certificate. The checker checks an exact cost and never infers it.
///
/// - see: #4569 — the cost sketch, its rulings in the issue body
/// - see: #4566 — a solver's certificate attached with `with ~smt`
/// - see: #4722 — sketch 19, a grade on the effect row
/// - see: corpus/pathological/effects/cost-bound-too-small.gandr — a closed bound refused

// The cost theory.
import std.cost (Cost);
// The lemma on a list's charges that the open bound uses.
import std.cost.list (chargesLength);

/// Three steps, bounded at three. The run is closed, so conversion decides the
/// bound.
def threeSteps() -> [Cost] Integer #spec{
  measure { cost 3 }
} {
  charge(1);
  charge(2);
  7
}

/// Sums a list at one step for each element. The bound is open in the list,
/// so the author proves it with a lemma.
def rec total(xs : List(Nat)) -> [Cost] Nat #spec{
  measure { cost length(xs) with chargesLength(xs) }
} {
  match xs {
    Nil => 0,
    Cons(x, rest) => {
      charge(1);
      x + total(rest)
    }
  }
}

/// Merges two sorted lists at one step for each element taken. The solver in
/// scope proves the bound.
def rec merge(xs : List(Integer), ys : List(Integer)) -> [Cost] List(Integer) #spec{
  measure { cost length(xs) + length(ys) with ~smt }
} {
  match (xs, ys) {
    (Nil, _) => ys,
    (_, Nil) => xs,
    (Cons(x, xr), Cons(y, yr)) => {
      charge(1);
      if x <= y { Cons(x, merge(xr, ys)) } else { Cons(y, merge(xs, yr)) }
    }
  }
}

/// A grade on the effect row states the bound of `threeSteps` in the form
/// sketch 19 rules. This sketch states a bound as a `measure` clause.
def threeStepsGraded() -> [Cost <= 3] Integer {
  threeSteps()
}
