@[ refuses("UndescribedMember.ParallelRedexes") ]
theory Nat where {
  sort Nat : Type;
  oper add : (Nat, Nat) --> Nat;

  rule cong2 : (
    rule p : Nat ==> Nat,
    rule q : Nat ==> Nat,
    data x : Nat,
    data y : Nat
  ) ==> (z : Nat) {
    node : p(x) ==> (x′);
    node : q(y) ==> (y′);
    node : add(x′, y′) --> (z);
  };
}

@[ refuses("UndescribedMember.OperationFiller") ]
oper accumulate : (stream : Stream(Nat)) --> (out2 : Stream(Nat)) {
  node : zip(stream, state) --> (next, out2);
  feed : (next) --> (state);
}

theory NatDesugared where {
  sort Nat : Type;
  oper add : (l : Nat, r : Nat) --> (sum : Nat);
}

theory Labelled where {
  sort Nat : Type;
  oper zero : () --> (out : Nat);
  oper step : (i : Nat) --> (o : Nat);

  rule twice : (rule p : x ==> x′, data x : Nat) ==> (o : Nat) {
    node w1 : p(x) ==> (m);
    node w2 : step(m) --> (o);
  };
}

@[ refuses("UndescribedMember.HigherCell") ]
theory Invertible where {
  sort Bit : Type;
  oper flip : (b : Bit) --> (c : Bit);
  rule involutive : (b : Bit) <=> (c : Bit);
}

@[ refuses("UndescribedMember.Reversible") ]
theory Reserved where {
  sort Bit : Type;
  oper negate : (b : Bit) <-> (c : Bit);
}
