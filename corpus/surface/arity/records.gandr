@[ checks, form(explicit) ]
def point : #{n : Integer, s : String};
def point = #{.s = "x", .n = 3};

@[ checks ]
def shorthand : #{n : Integer, s : String};
def shorthand = #{n = 3, s = "x"};

@[ checks ]
def punned(r : #{n : Integer, s : String}) -> -F String {
  case r {
    #{.n, .s} => return s
  }
}

@[ checks ]
def renamed(r : #{n : Integer, s : String}) -> -F Integer {
  case r {
    #{.n = m} => return m
  }
}

@[ runs("#{.n = 3, .s = \"x\"}") ]
def whole : #{n : Integer, s : String};
def whole = #{.s = "x", .n = 3};

@[ runs("\"x\"") ]
def named() -> -F String { punned(#{.s = "x", .n = 3}) }

@[ runs("3") ]
def numbered() -> -F Integer { renamed(#{n = 3, s = "x"}) }

@[ runs("4") ]
def widened() -> -F Integer { renamed(#{.a = unit, .n = 4, .s = "y"}) }

/// A field selected by its label off a record no field depends on reads the
/// field the pattern `#{.n = m}` reads (#855).
@[ checks ]
def selected(r : #{n : Integer, s : String}) -> -F Integer {
  r.n
}

/// `selected` answers the field its label names.
@[ runs("3") ]
def picked() -> -F Integer { selected(#{.s = "x", .n = 3}) }
