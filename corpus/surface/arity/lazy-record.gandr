def lazy() -> &{get : -F Integer, put : -F String} {
  &{.put => "s", .get => 1}
}

def binary : +U (-F Integer & -F String) = &{.0 => 1, .1 => "s"};

def observe(m : +U &{get : -F Integer, put : -F String}) -> Integer {
  m.get
}

def offered(n : Integer) -> &{get : -F Integer, put : -F String} {
  &{.put => "s", .get => n}
}

/// The empty lazy record is the empty lazy product, answered by the empty
/// block.
def terminal : +U &{} = &{};

/// A lazy record of one entry is the lazy product of one, not its entry: its
/// block answers the one entry.
def single() -> &{get : -F Integer} {
  &{.get => 1}
}

/// A lazy record of three is one lazy product of three, its block answering
/// each entry.
def triple() -> &{a : -F Integer, b : -F String, c : -F Integer} {
  &{.a => 1, .b => "s", .c => 3}
}

/// The chain `C & D & E` is the lazy product the lazy record of three is.
def chained : +U (-F Integer & -F String & -F Integer) = triple;

/// Each entry of a lazy product of three is one projection of it.
def third(m : +U &{a : -F Integer, b : -F String, c : -F Integer}) -> Integer {
  m.c
}

/// The last entry of `triple`, observed.
@[ runs("3") ]
def tripled() -> Integer { third(triple) }

/// The one entry of a lazy product of one is its one projection.
def only(m : +U &{get : -F Integer}) -> Integer {
  m.get
}

/// The only entry of `single`, observed.
@[ runs("1") ]
def singled() -> Integer { only(single) }

/// A `co` bundle is the lazy record written over bare labels, its fields in
/// any order (#1053).
def bundled() -> &{get : -F Integer, put : -F String} {
  co { put = "s", get = 7 }
}

/// The bundle's entry is the one its label names.
@[ runs("7") ]
def bundle_got() -> Integer { observe(bundled) }

/// An entry observed by its position, counted from zero, is the entry its
/// label names: `m.1` is `m.put`.
def placed(m : +U &{get : -F Integer, put : -F String}) -> String {
  m.1
}

/// A lazy product chain names no entry, so each is observed by its position.
def last(m : +U (-F Integer & -F String & -F Integer)) -> Integer {
  m.2
}

/// The last component of `chained`, observed by its position.
@[ runs("3") ]
def lasted() -> Integer { last(chained) }

/// A positional lazy record names no entry either, so each is observed by its
/// position (#1104).
def spread(m : +U (-F Integer & -F String)) -> String {
  m.1
}

/// A position past a lazy product's last entry names nothing, and is refused
/// as the unresolved name it is (#1104).
@[ refuses("UnresolvedName") ]
def beyond(m : +U (-F Integer & -F String)) -> -F String {
  m.2
}

@[ refuses("OutOfFragment.WrongSort") ]
def unthunked : -F Integer & -F Integer;

@[ refuses("OutOfFragment.WrongSort") ]
def menu : +U &{get : !Integer. end, put : ?Integer. end};
