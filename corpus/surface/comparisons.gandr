// The comparisons `!=`, `<=` and `>=`, each deciding a `while` loop's
// condition: the loop runs its body while the comparison holds, and the body
// returns at once (the relational and equality operators of Kernighan and
// Ritchie, _The C Programming Language_, 2nd ed., § 2.6). A `while` may run
// forever, so each function states `Div` in its row (#1481).

/// Its argument when that is not zero, else zero.
def unlessZero(n : Integer) -> [Div] Integer {
  while n != 0 { return n };
  0
}

/// Three is not zero, so the loop returns it.
@[ runs("3") ]
def unlessZeroThree() -> [Div] Integer { unlessZero(3) }

/// Zero is zero, so the loop never runs.
@[ runs("0") ]
def unlessZeroZero() -> [Div] Integer { unlessZero(0) }

/// Its argument when that is at most zero, else zero.
def atMostZero(n : Integer) -> [Div] Integer {
  while n <= 0 { return n };
  0
}

/// Zero is at most zero, so the loop returns it.
@[ runs("0") ]
def atMostZeroZero() -> [Div] Integer { atMostZero(0) }

/// Its argument when that is at least one, else zero.
def atLeastOne(n : Integer) -> [Div] Integer {
  while n >= 1 { return n };
  0
}

/// One is at least one, so the loop returns it.
@[ runs("1") ]
def atLeastOneOne() -> [Div] Integer { atLeastOne(1) }

/// Zero is not at least one, so the loop never runs.
@[ runs("0") ]
def atLeastOneZero() -> [Div] Integer { atLeastOne(0) }
