/// A list whose cons cell holds its head once: the field's grade `1` is
/// refused, the default grade `ω` the only one a constructor field reads
/// (#1295).
@[ refuses("OutOfFragment.grade.declaration") ]
data Vec(a : Type) : Type {
  Nil : Vec(a);
  Cons : (1 x : a, xs : Vec(a)) --> Vec(a);
}

/// An expression whose `Add` constructor is decorated after its result: a
/// constructor carries no decoration list, and the declaration is refused at
/// the list.
@[ refuses("MalformedForm") ]
data Expr(a : Type) : Type {
  Lit : (x : Integer) --> Expr(a);
  Add : (l : Expr(a), r : Expr(a)) --> Expr(a) [ctor, assoc];
}
