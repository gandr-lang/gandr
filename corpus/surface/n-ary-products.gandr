def single = *{1,};

@[refuses("ShapeMismatch")]
def single_is_not_its_member : Integer = *{1,};

def triple : Integer * Unit * String = *{1, *{}, "a"};

@[refuses("ShapeMismatch")]
def nesting_is_written : (Integer * Unit) * String = *{1, *{}, "a"};

def nested : (Integer * Unit) * String = *{*{1, *{}}, "a"};

def absurd(x : Void) -> Integer =
  match x {}
