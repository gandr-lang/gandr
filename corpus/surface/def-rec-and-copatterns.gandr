@[refuses("StageNotBelow")]
def rec fact(n : Integer) -> Integer =
  fact[<] n

@[refuses("MalformedForm")]
def rec nats(n : Integer) -> Stream Integer {
  .head => n,
  .tail => nats[>] (plus n 1)
}

@[refuses("MalformedForm")]
def rec loopy(n : Integer) -> Stream Integer {
  .head => n,
  _ => nats n
}

@[refuses("OutOfFragment.instantiation_expression.computation")]
def rec measured(n : Integer) -> Integer { return measured[.n <] n }
@[refuses("OutOfFragment.instantiation_expression.computation")]
def rec explicit(n : Integer) -> Integer { return explicit[.n = 1] n }
@[refuses("OutOfFragment.instantiation_expression.computation")]
def rec sized(n : Integer) -> Integer { return sized[.size = 1] n }
@[refuses("OutOfFragment.instantiation_expression.computation")]
def rec bounded(n : Integer) -> Integer { return bounded[.cost = 1] n }
@[refuses("OutOfFragment.instantiation_expression.computation")]
def rec tailing(n : Integer) -> Integer { return tailing[tail] n }
