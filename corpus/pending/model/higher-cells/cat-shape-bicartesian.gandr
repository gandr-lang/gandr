data Empty : Type where {}

data EmptyHom(a : Empty, b : Empty) : Type where {}

def empty_id(a : Empty) -> EmptyHom(a, a) {
  match a {}
}

data UnitOb : Type where {
  | Star : UnitOb
}

data UnitHom(a : UnitOb, b : UnitOb) : Type where {
  | UnitId : UnitHom(a, b)
}

def unit_id(a : UnitOb) -> UnitHom(a, a) {
  UnitId
}

data PairOb(a : Type, b : Type) : Type where {
  | Pair : (x : a, y : b) --> PairOb(a, b)
}

data SumOb(a : Type, b : Type) : Type where {
  | Inl : (x : a) --> SumOb(a, b)
  | Inr : (y : b) --> SumOb(a, b)
}

data HomPlus(l : Type, r : Type, x : SumOb(l, r), y : SumOb(l, r)) : Type where {
  | HomInl : (a : l, b : l, f : Integer) --> HomPlus(l, r, Inl(a), Inl(b))
  | HomInr : (c : r, d : r, g : Integer) --> HomPlus(l, r, Inr(c), Inr(d))
}

data ProdHom(a : PairOb(Integer, String), b : PairOb(Integer, String)) : Type where {
  | PairHom : (f : Integer, g : Integer) --> ProdHom(a, b)
}

def prod_id(x : PairOb(Integer, String)) -> ProdHom(x, x) {
  match x {
    Pair(l, r) => PairHom(0, 0)
  }
}

def coprod_id(x : SumOb(Integer, String)) -> -F HomPlus(Integer, String, x, x) {
  match x {
    Inl(a) => return HomInl(a, a, 0),
    Inr(b) => return HomInr(b, b, 0)
  }
}

def mixed_elim(
  a : Integer,
  b : String,
  h : HomPlus(Integer, String, Inl(a), Inr(b))
) -> -F Integer {
  match h {}
}

def empty_probe() -> EmptyHom(Star, Star) {
  empty_id(Star)
}
