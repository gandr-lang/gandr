data NatOp : Type where {
  | Zero : NatOp
  | Succ : (n : NatOp) --> NatOp
  oper add : (m : NatOp, n : NatOp) --> NatOp;
}

data NatRule : Type where {
  | Zero : NatRule
  | Succ : (n : NatRule) --> NatRule
  rule : id(Zero) ==> Zero;
}

data NatRetired : Type where {
  | Zero : NatRetired
  op stale : (x : NatRetired) --> NatRetired;
}
