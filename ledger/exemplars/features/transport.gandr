/// `transport`: `transport(P, p, x)` moves `x` along the path `p` in the family `P`; along reflexivity it keeps the value.
@[ checks ]
def along_here : Path(Integer, transport(\X. X, here(Integer), 2), 2) ;
def along_here = here(2) ;

/// The same transport, run.
@[ runs("2") ]
def along_here_run : +U (-F Integer) ;
def along_here_run = thunk { transport(\X. X, here(Integer), 2) } ;
