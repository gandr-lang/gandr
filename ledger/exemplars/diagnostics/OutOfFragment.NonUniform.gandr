/// `OutOfFragment.NonUniform`: a form out of the fragment: the form is a recursive call passing, where one of the definition's unchanging parameters stands, something other than that parameter.
///
/// The naturals.
@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ refuses("OutOfFragment.NonUniform") ]
def rec shadowed(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => return n,
    Succ(n) => become shadowed[<](n, n)
  }
}
