/// `RulesDiverge`: two rules of a block rewriting one term to two constructor terms.
@[ refuses("RulesDiverge") ]
data Circle : Type {
  Base : Circle;
  Loop : (x : Circle) --> Circle;
  Unloop : (x : Circle) --> Circle;
  rule Loop(Unloop(x)) ==> x;
  rule Unloop(Loop(x)) ==> x;
  rule Loop(Loop(x)) ==> x;
}
