/// `BufferReturnedTwice`: a placed buffer handed back a second time.
@[ refuses("BufferReturnedTwice") ]
def freedTwice() -> -F Unit {
  handle r : Ring {
    run b <- r.alloc(4096);
    run first <- r.free(b);
    r.free(b)
  } with {
    pure(x) => pure x,
    oper alloc(n, b, k) => k(b),
    oper free(b, k) => k(unit)
  }
}
