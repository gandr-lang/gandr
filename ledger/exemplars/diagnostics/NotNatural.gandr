/// `NotNatural`: translator tables that do not commute with a corolla's automorphisms.
theory Rig {
  sort R : Type;
  oper plus : (x : R, y : R) --> (z : R);
  oper times : (x : R, y : R) --> (z : R);
}

@[ checks ]
def cross(e : Unit + Unit + Unit + Unit) -> -F (Unit + Unit + Unit + Unit) {
  case e {
    +{.0 = u} => +{.2 = u},
    +{.1 = u} => +{.1 = u},
    +{.2 = u} => +{.0 = u},
    +{.3 = u} => +{.3 = u}
  }
}

@[ refuses("NotNatural") ]
def crossed = ua[1, 4](Rig, Rig, #{.plus = cross}, #{.plus = cross}) ;
