/// `BareFeedback`: a circuit rule's fed-back port read under no observation.
@[ refuses("BareFeedback") ]
theory Wheel {
  sort Nat : Type;
  oper zip : (s : Nat, t : Nat) --> (u : Nat);

  rule spin : (data stream : Nat) ==> (out : Nat) {
    node : zip(stream, state) --> (out);
    feed : (out) --> (state);
  };
}
