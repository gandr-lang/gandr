/// `HoldElsewhere`: a hold checked against a handle at another world.
module Seat :> #{
  type Dispatch,
  mobile type Report,
  type Handoff,
  type SeatEnd = ?Dispatch. mu turn. +{
    report : !Report. &{ next : turn, retire : end },
    handoff : !Handoff. end
  },
  task : Dispatch,
  progress : Report,
  notes : Handoff
} {
  type Dispatch = String;
  type Report = String;
  type Handoff = String;
  /// The dispatch a seat receives.
  @[ checks ]
  def task = "task";
  /// A report it sends.
  @[ checks ]
  def progress = "progress";
  /// The notes it hands off.
  @[ checks ]
  def notes = "notes";
}

@[ checks ]
world operator ;

@[ checks ]
world seat ;

@[ refuses("HoldElsewhere") ]
@[ entry(operator) ]
def forged() -> -F (Seat.Report at seat) {
  (hold Seat.progress)
}
