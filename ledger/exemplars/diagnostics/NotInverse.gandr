/// `NotInverse`: translator tables that are not mutually inverse.
theory Magma {
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);
}

@[ checks ]
def exchange(b : Bool) -> -F Bool {
  case b {
    true => +{.1 = unit},
    false => +{.0 = unit}
  }
}

@[ checks ]
def boolId(b : Bool) -> -F Bool {
  b
}

@[ checks ]
def keep(e : +{Unit}) -> -F +{Unit} {
  e
}

@[ checks ]
def raised = ua[
  2,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = exchange, .one = keep}) ;

@[ refuses("NotInverse") ]
def lopsided = ua[
  1,
  4
](Magma, Magma, #{.mul = exchange, .one = keep}, #{.mul = boolId, .one = keep}) ;
