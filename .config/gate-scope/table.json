{
  "groups": {
    "rust": [
      "check:anodized",
      "check:anodized-enforcing",
      "check:clippy",
      "check:clippy-enforcing",
      "check:clippy-plain-only",
      "check:corpus-comments",
      "check:doc",
      "check:doctests",
      "check:dylint",
      "check:fmt",
      "check:landing",
      "check:obligations",
      "check:tests-enforcing",
      "check:tests-plain-only",
      "check:witnesses"
    ],
    "corpus": [
      "check:corpus",
      "check:corpus-comments",
      "check:corpus-format",
      "check:corpus-goldens",
      "check:exemplars",
      "check:gandr-doc",
      "check:syntax-exemplars"
    ],
    "extension": ["check:extension", "check:input-table", "check:vscode-smoke"]
  },
  "light": ["check:cases", "check:prose", "check:spec-cost-landed"],
  "landing": [
    "check:corpus",
    "check:corpus-comments",
    "check:corpus-format",
    "check:corpus-goldens",
    "check:doc",
    "check:landing",
    "check:syntax-exemplars",
    "check:witnesses"
  ],
  "paths": [
    { "path": ".config/nextest.toml", "groups": ["rust"] },
    { "path": ".config/obligations/", "groups": ["rust"] },
    { "path": ".config/rust-clippy/", "groups": ["rust"] },
    { "path": ".config/witnesses/", "groups": ["rust"] },
    { "path": ".config/", "groups": [] },
    { "path": ".github/", "groups": [] },
    { "path": "crates/", "groups": ["rust", "corpus", "extension"] },
    { "path": ".cargo/", "groups": ["rust", "corpus", "extension"] },
    { "path": "Cargo.toml", "groups": ["rust", "corpus", "extension"] },
    { "path": "Cargo.lock", "groups": ["rust", "corpus", "extension"] },
    { "path": "rust-toolchain.toml", "groups": ["rust", "corpus", "extension"] },
    { "path": "clippy.toml", "groups": ["rust"] },
    { "path": "rustfmt.toml", "groups": ["rust"] },
    { "path": "corpus/", "groups": ["corpus"] },
    { "path": "library/", "groups": ["corpus"] },
    { "path": "ledger/", "groups": ["corpus"] },
    { "path": "contrib/gandr-vscode/", "groups": ["extension"] },
    { "path": "package.json", "groups": ["extension"] },
    { "path": "aube-lock.yaml", "groups": ["extension"] },
    { "path": "aube-workspace.yaml", "groups": ["extension"] },
    { "path": ".oxfmtrc.json", "groups": ["extension"] },
    { "path": ".oxlintrc.json", "groups": ["extension"] },
    { "path": ".actrc", "groups": [] },
    { "path": ".coderabbit.yaml", "groups": [] },
    { "path": ".gitignore", "groups": [] },
    { "path": "README.md", "groups": [] },
    { "path": "cliff.toml", "groups": [] },
    { "path": "codecov.yml", "groups": [] },
    { "path": "commitlint.config.mjs", "groups": [] },
    { "path": "prek.toml", "groups": [] },
    { "path": "rumdl.toml", "groups": [] },
    { "path": "sizelint.toml", "groups": [] },
    { "path": "tombi.toml", "groups": [] },
    { "path": "treefmt.toml", "groups": [] },
    { "path": "typos.toml", "groups": [] }
  ]
}
