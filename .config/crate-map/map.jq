# The crate map (#2290): `cargo metadata --no-deps` read as the workspace's
# crates and the `[dependencies]` edges between them, in one of three forms.
# `$readme` is `crates/README.md`, whose § Layering block is the category
# order; `$concerns` is `ledger/concerns.sql`'s sites as `[{concern, crate}]`;
# `$form` picks the output:
#
# - `dot`: `ledger/crates.dot`, one node per crate in a cluster per category,
#   one edge per normal dependency between two workspace crates, dependent to
#   dependency, then each concern's overlay: an undirected dashed edge in the
#   concern's colour between each two of its crates in name order, a loop on
#   a concern's only crate; everything sorted so the file depends on the
#   graph alone;
# - `readme`: the page `$page`, `ledger/README.md`, with the category graph
#   between its `crate-map` markers rewritten, one arrow per pair of
#   categories, labelled with the edges it stands for (#3890);
# - `findings`: one line per crate outside `crates/<category>-<name>`, per
#   edge to a category listed after its own, the layering's two refusals, and
#   per concern site in a crate the workspace does not have.
#
# Dev and build dependencies are not edges: the layering binds what a crate
# links, and a test may reach above it.

def categories:
  $readme
  | capture("## Layering\n(?:[^`]*\n)?```text\n(?<block>(?:[^`].*\n)+)```").block
  | [splits("\n") | select(. != "") | capture("^(?<name>[a-z]+) ").name];

def members:
  .workspace_root as $root
  | [.packages[]
     | {
         name,
         dir: (.manifest_path | ltrimstr($root + "/") | rtrimstr("/Cargo.toml")),
         deps: [.dependencies[] | select(.kind == null) | .name]
       }
     | .crate = (.dir | ltrimstr("crates/"))
     | .category = (.crate | capture("^(?<c>[a-z]+)-").c? // null)];

def graph:
  members as $members
  | ($members | map({key: .name, value: .crate}) | from_entries) as $crate
  | {
      members: $members,
      edges: ([$members[] | .crate as $from | .deps[] | $crate[.] // empty | [$from, .]] | unique)
    };

def category_of($crate): $crate | capture("^(?<c>[a-z]+)-").c;

def quote: "\"" + . + "\"";

# A colour per concern, by its place in name order.
def palette: ["blue", "darkgreen", "purple", "darkorange", "brown", "deeppink"];

def overlays:
  ($concerns | map(.concern) | unique) as $names
  | $names[] as $concern
  | (palette[($names | index($concern)) % (palette | length)]) as $colour
  | ([$concerns[] | select(.concern == $concern) | .crate] | unique) as $crates
  | (if ($crates | length) == 1 then [[$crates[0], $crates[0]]]
     else [range(1; $crates | length) as $at | [$crates[$at - 1], $crates[$at]]]
     end)[]
  | "  \(.[0] | quote) -> \(.[1] | quote) [style = \"dashed\", dir = \"none\", constraint = false, color = \($colour | quote), label = \($concern | quote)];";

def dot:
  graph as $graph
  | categories as $order
  | [
      "// The crate map: one node per workspace crate, clustered by category in",
      "// the layering order of crates/README.md, one edge per `[dependencies]`",
      "// entry between two of them, dependent to dependency, then a dashed",
      "// overlay per concern of ledger/concerns.sql joining the crates of its",
      "// sites. Generated by `mise run ledger:crate-map` from `cargo metadata`",
      "// and ledger/concerns.sql; never edited by hand.",
      "digraph crates {",
      "  rankdir = \"BT\";",
      ($order[] as $category
       | ([$graph.members[] | select(.category == $category) | .crate] | sort) as $crates
       | select($crates | length > 0)
       | "  subgraph \("cluster_\($category)" | quote) {",
         "    label = \($category | quote);",
         ($crates[] | "    \(quote);"),
         "  }"),
      ($graph.edges[] | "  \(.[0] | quote) -> \(.[1] | quote);"),
      overlays,
      "}"
    ]
  | join("\n");

# The place of the category `.` in `$order`, null for one it does not list.
def rank($order): . as $category | $order | index($category);

def mermaid:
  graph as $graph
  | categories as $order
  | ($graph.edges
     | map([category_of(.[0]), category_of(.[1])])
     | map(select(.[0] != .[1]))
     | group_by(.)
     | map({from: .[0][0], to: .[0][1], count: length})
     | sort_by((.from | rank($order)), (.to | rank($order)))) as $arrows
  | [
      "```mermaid",
      "flowchart BT",
      ($order[] | "  \(.)"),
      ($arrows[] | "  \(.from) -->|\(.count)| \(.to)"),
      "```"
    ]
  | join("\n");

def readme:
  mermaid as $block
  | ($ARGS.named.page // error("the readme form takes the page holding the markers as `$page`")
     | capture("^(?<head>(?:.|\n)*<!-- crate-map:begin -->\n)(?:.|\n)*?(?<tail><!-- crate-map:end -->(?:.|\n)*)$")
     // error("the page holds no `<!-- crate-map:begin -->` … `<!-- crate-map:end -->` block"))
  | .head + $block + "\n" + .tail;

# The category of a crate's directory name, or null for one with none.
def category_or_null: capture("^(?<c>[a-z]+)-").c? // null;

# The category files of the member rows (#7215): `$listed` holds each
# `crates/README/<category>.md` as `{file, text}`. Each gives its category
# and the directories of its tree's rows, in their order.
def listed:
  ($ARGS.named.listed // error("the findings form takes the category files of crates/README/ as `$listed`"))
  | map({
      file,
      category: (.file | capture("^crates/README/(?<c>[a-z]+)\\.md$").c? // null),
      rows: [.text | splits("\n") | capture("^[├└]── (?<dir>[^/ ]+)/").dir]
    });

# The lines of `crates/README.md` § Members: each category, the file it
# links and the count of crates it states.
def counted:
  $readme
  | [splits("\n")
     | capture("^- \\[`(?<category>[a-z]+)`\\]\\(README/(?<file>[a-z]+)\\.md\\): (?<count>[0-9]+) crates?$")
     | .count |= tonumber];

# One line for each member row out of place: a crate with no row, a row with
# no crate, a row in another category's file, a second row, rows out of
# order, a file of no category, and a count of § Members that its file does
# not hold.
def rows($graph; $order):
  listed as $files
  | [$graph.members[] | select(.dir | startswith("crates/")) | .crate | select(category_or_null | rank($order) != null)] as $crates
  | [$files[] | .file as $file | .category as $category | .rows[] | {file: $file, category: $category, dir: .}] as $rows
  | ($files[]
     | select(.category == null or (.category | rank($order)) == null)
     | "\(.file): not crates/README/<category>.md with a category of crates/README.md § Layering"),
    ($crates[] as $crate
     | select(any($rows[]; .dir == $crate) | not)
     | "\($crate): no row in crates/README/\($crate | category_or_null).md"),
    ($rows[]
     | select(.dir as $dir | $crates | index($dir) | not)
     | "\(.file): \(.dir) is a row with no crate"),
    ($rows[]
     | select((.dir as $dir | $crates | index($dir)) != null and (.dir | category_or_null) != .category)
     | "\(.file): \(.dir) is a \(.dir | category_or_null) crate, whose row goes in crates/README/\(.dir | category_or_null).md"),
    ($rows | group_by([.file, .dir])[] | select(length > 1) | "\(.[0].file): \(.[0].dir) has \(length) rows"),
    ($files[] | select(.rows != (.rows | sort)) | "\(.file): the rows do not sort by directory"),
    (counted as $counts
     | $order[] as $category
     | ([$files[] | select(.category == $category) | .rows[]] | length) as $held
     | ([$counts[] | select(.category == $category)]) as $lines
     | if ($lines | length) == 0 then "crates/README.md § Members: no line for \($category)"
       elif $lines[0].file != $category then "crates/README.md § Members: \($category) links crates/README/\($lines[0].file).md"
       elif $lines[0].count != $held then "crates/README.md § Members: \($category) counts \($lines[0].count) crates, and crates/README/\($category).md holds \($held) rows"
       else empty end);

def findings:
  graph as $graph
  | categories as $order
  | ($graph.members[]
     | select(.category == null or (.dir | startswith("crates/") | not) or (.category | rank($order)) == null)
     | "\(.dir): not crates/<category>-<name> with a category of crates/README.md § Layering"),
    ($graph.edges[]
     | select((category_of(.[1]) | rank($order)) > (category_of(.[0]) | rank($order)))
     | "\(.[0]) -> \(.[1]): \(category_of(.[1])) is listed after \(category_of(.[0])) in crates/README.md § Layering"),
    (($graph.members | map(.crate)) as $crates
     | $concerns[]
     | select(.crate as $crate | $crates | index($crate) | not)
     | "\(.concern): a site in \(.crate), which is not a workspace crate"),
    rows($graph; $order);

if $form == "dot" then dot
elif $form == "readme" then readme
elif $form == "findings" then findings
else error("form is dot, readme or findings, not \($form)")
end
