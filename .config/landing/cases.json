          "steps": [
            {
              "run": "gh api jobs"
            }
          ]
        },
        "join": {
          "name": "join the enforcing shards (linux)",
          "if": "${{ !cancelled() && !failure() && github.event.merge_group.base_ref != 'refs/heads/landing' && (needs.prepare.outputs.unbuilt == 'true' || github.event_name == 'push' && github.ref == 'refs/heads/main' && !contains(join(fromJSON(needs.prepare.outputs.artifacts || '[]'), ' '), 'build-state-cargo-test-enforcing--')) }}",
          "env": {
            "CI_BUILD_STATE": "cargo-test-enforcing"
          },
          "steps": [
