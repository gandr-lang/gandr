[
  {
    "name": "a queue whose other jobs skip landing runs the blocking set alone",
    "input": {
      "jobs": {
        "template": {
          "if": false,
          "steps": [
            {
              "run": "mise run check:doc"
            }
          ]
        },
        "depth": {
          "name": "wait for stack depth 3",
          "if": "${{ github.event_name == 'pull_request' }}",
          "steps": [
            {
              "run": ".config/pr-stack/landing.bash depth"
            }
          ]
        },
        "prepare": {
          "name": "prepare the run",
          "needs": "depth",
          "if": "${{ !cancelled() }}",
          "steps": [
            {
              "run": "gh api repos"
            }
          ]
        },
        "image": {
          "name": "build the missing CI image",
          "needs": "prepare",
          "if": "${{ !cancelled() && needs.prepare.outputs.build == 'true' }}"
        },
        "clippy": {
          "name": "check Clippy wall",
          "needs": ["prepare", "image"],
          "if": "${{ !cancelled() && !failure() && github.base_ref != 'landing' && needs.prepare.outputs.rust == 'true' }}",
          "steps": [
            {
              "run": "mise run check:clippy-plain-only"
            },
            {
              "run": "mise run check:clippy-enforcing"
            },
            {
              "run": "mise run ci:prune-clippy"
            }
          ]
        },
        "dylint": {
          "name": "check quenchant compiler policy",
          "needs": ["prepare", "image"],
          "if": "${{ !cancelled() && !failure() && (github.event_name == 'merge_group' || github.event_name == 'workflow_dispatch') }}",
          "steps": [
            {
              "run": "mise run check:dylint"
            },
            {
              "run": "mise run check:anodized"
            },
            {
              "run": "mise run check:anodized-enforcing"
            },
            {
              "run": "mise run evidence:rustdoc"
            }
          ]
        },
        "tests": {
          "name": "test enforcing targets",
          "needs": ["prepare", "image"],
          "if": "${{ !cancelled() && !failure() && github.event.merge_group.base_ref != 'refs/heads/landing' && github.event_name == 'merge_group' }}",
          "steps": [
            {
              "run": "mise run check:tests-enforcing"
            }
          ]
        },
        "hotpath": {
          "name": "report the hotpath benchmarks",
          "if": "${{ !cancelled() && github.event_name == 'push' }}",
          "steps": [
            {
              "run": "mise run ci:hotpath"
            }
          ]
        },
        "timing": {
          "name": "summarize the lanes' step times",
          "needs": ["clippy"],
          "if": "${{ !cancelled() && github.event.merge_group.base_ref != 'refs/heads/landing' }}",
          "steps": [
            {
              "run": "gh api jobs"
            }
          ]
        }
      },
      "landing": [
        "check:clippy-plain-only",
        "check:clippy-enforcing",
        "check:dylint",
        "check:anodized",
        "check:anodized-enforcing"
      ]
    },
    "output": []
  },
