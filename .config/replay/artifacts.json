[
  {
    "name": "the frozen tables and the grammar fingerprint",
    "paths": ["crates/surface-grammar/src/surface/frozen.rs"],
    "inputs": ["corpus/", "crates/surface-grammar/", "crates/surface-syntax/"],
    "check": ".config/mise/scope cargo nextest run --locked --manifest-path crates/surface-grammar/Cargo.toml",
    "stale": [100],
    "record": "UPDATE_EXPECT=1 cargo nextest run --manifest-path crates/surface-grammar/Cargo.toml"
  },
  {
    "name": "the syntax ledger",
    "paths": ["ledger/syntax.md", "ledger/syntax.json"],
    "inputs": ["crates/surface-grammar/", "crates/surface-syntax/"],
    "check": "mise run check:syntax-ledger",
    "record": "mise run ledger:syntax"
  },
  {
    "name": "the comment ledger",
    "paths": ["corpus/uncommented.ledger"],
    "inputs": [
      "corpus/",
      "crates/surface-corpus/tests/comments/",
      "crates/surface-parser/",
      "crates/surface-grammar/",
      "crates/surface-syntax/"
    ],
    "check": "mise run check:corpus-comments",
    "record": "CORPUS_COMMENTS_WRITE_LEDGER=1 mise run check:corpus-comments"
  },
  {
    "each": "crate",
    "name": "the goldens of {crate}",
    "paths": ["crates/{crate}/tests/golden/"],
    "inputs": ["crates/{crate}/"],
    "check": ".config/mise/scope cargo nextest run --locked --manifest-path crates/{crate}/Cargo.toml",
    "stale": [100],
    "record": "UPDATE_EXPECT=1 cargo nextest run --manifest-path crates/{crate}/Cargo.toml"
  },
  {
    "name": "the references ledger",
    "paths": ["ledger/references.sql"],
    "inputs": ["crates/", "corpus/", ".config/references/"],
    "check": "mise run check:references",
    "record": "mise run ledger:references"
  }
]
