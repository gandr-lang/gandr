data Color : Type where { | Red : Color }
theory Shapes where {
  sort M : Type;
  oper mul : (x : M, y : M) --> M;
  rule spin : (data s : M) ==> (out : M) {
    node : mul(s, s) --> (out);
  };
}
module Plain where {
  def one = 1 ;
}
world seat ;
