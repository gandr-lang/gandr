data Nat : Type where {
  | Zero
  | Succ(
    /// The predecessor.
    n : Nat
  )
  | Two
  /// Three.
  | Three
}
def apply(
  f : (
    /// The argument.
    x : Nat
  ) -> -F Nat,
  /// The pair.
  p : (a : Nat, b : Nat),
  y : Nat
) -> -F Nat { y }
def use(
  h : (
    /// The index.
    i : Nat
  ) => Nat
) -> -F Nat { 0 }
