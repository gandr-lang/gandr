theory Same where {
  sort Carrier : Type;
  oper same : (a : Carrier, b : Carrier) --> Bool;
  law refl : (a : Carrier) -> Path[.A = Bool](same a a, true);
  law sym : (a : Carrier, b : Carrier) -> Path[.A = Bool](same a b, same b a);
  law trans : (
    a : Carrier,
    b : Carrier,
    c : Carrier,
    p : Path[.A = Bool](same a b, true),
    q : Path[.A = Bool](same b c, true)
  ) -> Path[.A = Bool](same a c, true);
  law loose : (a : Carrier) -> Path[.A = Bool](same a b, true);
  law odd : (a : Carrier) -> Path[.A = Carrier](a, true);
}
