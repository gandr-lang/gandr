theory IdentityReturn where {
  sort VTy : Type;
  sort CTy : Type;
  sort VTm(a : VTy) : Type+;
  sort CTm(b : CTy) : Type;
  oper f : (a : VTy) --> CTy;
  oper arrow : (a : VTy, b : CTy) --> CTy;
  oper ret : (a : VTy, t : VTm(a)) --> CTm(f(a));
  oper lam : (a : VTy, b : CTy, t : pi+ (x : VTm(a)). CTm(b)) --> CTm(arrow(a, b));
}
