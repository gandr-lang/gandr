theory Spec where {
  sort V : Type+
  sort C : Type
  sort Below(w : C, v : C) : Type
  oper ext : (m : C, k : (x : V) -> C) --> C
  oper mono : (
    m : C,
    n : C,
    k : (x : V) -> C,
    l : (x : V) -> C,
    p : Below m n,
    q : (x : V) -> Below (k x) (l x)
  ) --> Below (ext m k) (ext n l)
}
