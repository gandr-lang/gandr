def small : Type ;
def small = Integer ;

def effect : Type[-] ;
def effect = -F Integer ;

def suspended : Type ;
def suspended = +U (-F Integer) ;

def universe : Type[+, 1] ;
def universe = Type ;

def widened : Type[+, 1] ;
def widened = String ;

@[ runs("5") ]
def five : small ;
def five = 5 ;

@[ runs("<fun>") ]
def id(a : Type, x : a) -> -F a { return x }

def at_integer : +U (-F Integer) ;
def at_integer = thunk { become id(Integer, five) } ;

def at_string : +U (-F String) ;
def at_string = thunk { become id(String, "text") } ;

def at_small : +U (-F small) ;
def at_small = thunk { become id(small, five) } ;

@[ runs("<fun>") ]
def perform(c : Type[-], t : +U c) -> c { become force t }

def performed : +U (-F Integer) ;
def performed = thunk { become perform(effect, thunk { return 42 }) } ;

def quoted : +U (-F Integer) ;
def quoted = thunk { become perform(-F Integer, thunk { return 7 }) } ;
