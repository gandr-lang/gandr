def small : Type ;
def small = Integer ;

def effect : Type[-] ;
def effect = -F Integer ;

def suspended : Type ;
def suspended = +U (-F Integer) ;

def universe : Type[+, 1] ;
def universe = Type ;

def widened : Type[+, 1] ;
def widened = String ;

@[ runs("5") ]
def five : small ;
def five = 5 ;

@[ runs("fn (a) { fn (b) { b } }") ]
def id(a : Type, x : a) -> -F a { x }

def at_integer : () => Integer ;
def at_integer = thunk { become id(Integer, five) } ;

def at_string : () => String ;
def at_string = thunk { become id(String, "text") } ;

def at_small : () => small ;
def at_small = thunk { become id(small, five) } ;

@[ runs("fn (a) { fn (b) { force b } }") ]
def perform(c : Type[-], t : +U c) -> c { become force t }

def performed : () => Integer ;
def performed = thunk { become perform(effect, thunk { 42 }) } ;

def quoted : () => Integer ;
def quoted = thunk { become perform(-F Integer, thunk { 7 }) } ;
