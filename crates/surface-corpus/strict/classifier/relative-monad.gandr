def raw_rel_monad : (Type[+, 0] -> Type[-, 0]) -> Type[+, 0] -> Type[+, 0] -> Type[
  +,
  0
] = \T. \A. \B. +U (A -> T(A)) * +U (+U (T(A)) -> +U (A -> T(B)) -> T(B));

def raw_rel_monad_elided : (Type -> Type[-]) -> Type -> Type -> Type = \T. \A. \B. +U (A -> T(A)) * +U (+U (T(A)) -> +U (A -> T(B)) -> T(B));

def unit_and_bind : raw_rel_monad(\X. -F (X * X), Integer, Integer) = (
  fn (a) { (a, a) },
  fn (m) { fn (k) { run p <- force m; become (force k)(1) } }
);

def unit_and_bind_elided : raw_rel_monad_elided(\X. -F (X * X), Integer, Integer) = unit_and_bind;

def unit_and_bind_spelled : (Integer => Integer * Integer) * ((
  () => Integer * Integer,
  Integer => Integer * Integer
) => Integer * Integer) = unit_and_bind_elided;
