@[ runs("fn (a) { a }") ]
def identity : +U (Integer -> -F Integer) ;
def identity = thunk { fn (x) { return x } } ;

@[ runs("fn (a) { fn (b) { a } }") ]
def first : +U (Integer -> Integer -> -F Integer) ;
def first = thunk { fn (x) { fn (y) { return x } } } ;

@[ runs("42") ]
def answer : Integer ;
def answer = 42 ;

@[ runs("42") ]
def applied : +U (-F Integer) ;
def applied = thunk { become (force identity)(answer) } ;

@[ runs("42") ]
def chosen : +U (-F Integer) ;
def chosen = thunk { become (force first)(answer)(7) } ;

@[ runs("\"later\"") ]
def delayed : +U (-F String) ;
def delayed = thunk { return "later" } ;
