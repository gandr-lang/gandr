@[ runs("fn (a) { a }") ]
def identity : Integer => Integer ;
def identity = fn (x) { x } ;

@[ runs("fn (a) { fn (b) { a } }") ]
def first : (Integer, Integer) => Integer ;
def first = fn (x) { fn (y) { x } } ;

@[ runs("42") ]
def answer : Integer ;
def answer = 42 ;

@[ runs("42") ]
def applied() -> -F Integer { become (force identity)(answer) }

@[ runs("42") ]
def chosen() -> -F Integer { become (force first)(answer)(7) }

@[ runs("\"later\"") ]
def delayed() -> -F String { "later" }
