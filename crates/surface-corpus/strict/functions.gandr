@[ runs("fn (a) { a }") ]
def identity(x : Integer) -> -F Integer { x }

@[ runs("fn (a) { fn (b) { a } }") ]
def first(x : Integer, y : Integer) -> -F Integer { x }

@[ runs("42") ]
def answer : Integer = 42 ;

@[ runs("42") ]
def applied() -> -F Integer { become (force identity)(answer) }

@[ runs("42") ]
def chosen() -> -F Integer { become (force first)(answer)(7) }

@[ runs("\"later\"") ]
def delayed() -> -F String { "later" }
