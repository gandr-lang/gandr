@[ runs("fn (a) { a }") ]
def identity : Integer => Integer ;
def identity = thunk { fn (x) { return x } } ;

@[ runs("fn (a) { fn (b) { a } }") ]
def first : (Integer, Integer) => Integer ;
def first = thunk { fn (x) { fn (y) { return x } } } ;

@[ runs("42") ]
def answer : Integer ;
def answer = 42 ;

@[ runs("42") ]
def applied : () => Integer ;
def applied = thunk { become (force identity)(answer) } ;

@[ runs("42") ]
def chosen : () => Integer ;
def chosen = thunk { become (force first)(answer)(7) } ;

@[ runs("\"later\"") ]
def delayed : () => String ;
def delayed = thunk { return "later" } ;
