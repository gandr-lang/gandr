@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { run g <- d(f) ; e(g) } } } } } }") ]
def comp(
  a : Type,
  b : Type,
  c : Type,
  f : +U[ω] (a -> -F b),
  g : +U[ω] (b -> -F c),
  x : a
) -> -F c {
  run y <- f(x);
  become g(y)
}

@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { thunk { comp(a, c, d, e, f) } } } } } } }") ]
def collide(
  a : Type,
  b : Type,
  c : Type,
  d : Type,
  u : +U[ω] (a -> -F c),
  h : +U[ω] (c -> -F d)
) -> -F (+U[ω] (a -> -F d)) {
  return thunk { become comp(a, c, d, u, h) }
}

@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { thunk { comp(a, c, d, e, f) } } } } } } }") ]
def clean(
  p : Type,
  q : Type,
  r : Type,
  s : Type,
  u : +U[ω] (p -> -F r),
  h : +U[ω] (r -> -F s)
) -> -F (+U[ω] (p -> -F s)) {
  return thunk { become comp(p, r, s, u, h) }
}
