@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { e(d(f)) } } } } } }") ]
def comp(
  a : Type,
  b : Type,
  c : Type,
  f : a => b,
  g : b => c,
  x : a
) -> c {
  become g(f(x))
}

@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { thunk { comp(a, c, d, e, f) } } } } } } }") ]
def collide(
  a : Type,
  b : Type,
  c : Type,
  d : Type,
  u : a => c,
  h : c => d
) -> a => d {
  thunk { become comp(a, c, d, u, h) }
}

@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { thunk { comp(a, c, d, e, f) } } } } } } }") ]
def clean(
  p : Type,
  q : Type,
  r : Type,
  s : Type,
  u : p => r,
  h : r => s
) -> p => s {
  thunk { become comp(p, r, s, u, h) }
}
