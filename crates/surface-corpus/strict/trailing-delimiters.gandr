@[ checks, ]
data Either(a : Type, b : Type,) : Type {
  Left : (x : a,) --> Either(a, b,);
  Right : (y : b,) --> Either(a, b,);
}

@[ checks ]
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

@[ checks ]
def from_left() -> -F Integer {
  case (Left(5,) : Either(Integer, String,)) {
    | Left(x,) => x,
    | Right(y) => 0,
  }
}

@[ checks ]
def warm(c : Color) -> -F Integer {
  case c {
    | Red
    | Green => 1,
    Blue => 0
  }
}

@[ checks ]
def cool(c : Color) -> -F Integer {
  case c { Red | Green => 0, | Blue => 1, }
}

@[ runs("fn (a) { fn (b) { a } }") ]
def first : (Integer, Integer) => Integer ;
def first = fn (x) { fn (y) { x } } ;

@[ runs("42") ]
def chosen : () => Integer ;
def chosen = thunk { become (force first)(42,)(7,) } ;

@[ checks ]
def pick(x : Integer, y : Integer,) -> -F Integer {
  x
}
