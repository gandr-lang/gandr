// file

// the naturals
data Nat : Type where {
  // the base
  | Zero : Nat
  | Succ : (n : Nat) --> Nat

  // a comment cut off by a blank line

  rule : Succ(Zero) <=> Zero;
}

// a theory
theory T where {
  /// the carrier
  sort S : Type+;
  oper get : (k : S) --> S;
  rule g : get(k) <=> k;
}

// a stream
codata Stream(a : Type) : Type[-] where {
  head : a;
  /// what follows
  tail : Stream(a);
}
