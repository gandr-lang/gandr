@[ refuses("StageNotBelow") ]
def rec fact(n: Integer) -> -F Integer {
  become fact[<](n)
}

@[ refuses("MalformedForm") ]
def rec nats(n: Integer) -> Stream(Integer) {
  .head => n,
  .tail => nats[>](plus(n, 1))
}

@[ refuses("MalformedForm") ]
def rec loopy(n: Integer) -> Stream(Integer) {
  .head => n,
  _ => nats(n)
}

@[ refuses("OutOfFragment") ]
def rec measured(n: Integer) -> -F Integer { return measured[n <](n) }
@[ refuses("OutOfFragment") ]
def rec explicit(n: Integer) -> -F Integer { return explicit[n = 1](n) }
@[ refuses("OutOfFragment") ]
def rec sized(n: Integer) -> -F Integer { return sized[size = 1](n) }
@[ refuses("OutOfFragment") ]
def rec bounded(n: Integer) -> -F Integer { return bounded[cost = 1](n) }
@[ refuses("OutOfFragment") ]
def rec tailing(n: Integer) -> -F Integer { return tailing[tail](n) }
