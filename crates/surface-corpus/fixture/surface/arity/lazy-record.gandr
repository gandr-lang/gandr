@[ checks ]
def lazy() -> &{get : -F Integer, put : -F String} {
  &{.put => "s", .get => 1}
}

@[ checks ]
def binary : +U (-F Integer & -F String) ;
def binary = thunk { &{.0 => 1, .1 => "s"} } ;

@[ checks ]
def observe(m : +U &{get : -F Integer, put : -F String}) -> -F Integer {
  become m.get
}

@[ checks ]
def offered(n : Integer) -> &{get : -F Integer, put : -F String} {
  &{.put => "s", .get => n}
}

/// The empty lazy record is the empty lazy product, answered by the empty
/// block.
@[ checks ]
def terminal : +U &{} ;
def terminal = thunk { &{} } ;

/// A lazy record of one entry is the lazy product of one, not its entry: its
/// block answers the one entry.
@[ checks ]
def single() -> &{get : -F Integer} {
  &{.get => 1}
}

/// A lazy record of three is one lazy product of three, its block answering
/// each entry.
@[ checks ]
def triple() -> &{a : -F Integer, b : -F String, c : -F Integer} {
  &{.a => 1, .b => "s", .c => 3}
}

/// The chain `C & D & E` is the lazy product the lazy record of three is.
@[ checks ]
def chained : +U (-F Integer & -F String & -F Integer) ;
def chained = triple ;

/// Each entry of a lazy product of three is one projection of it.
@[ checks ]
def third(m : +U &{a : -F Integer, b : -F String, c : -F Integer}) -> -F Integer {
  become m.c
}

/// The last entry of `triple`, observed.
@[ runs("3") ]
def tripled : () => Integer ;
def tripled = thunk { become third(triple) } ;

/// The one entry of a lazy product of one is its one projection.
@[ checks ]
def only(m : +U &{get : -F Integer}) -> -F Integer {
  become m.get
}

/// The only entry of `single`, observed.
@[ runs("1") ]
def singled : () => Integer ;
def singled = thunk { become only(single) } ;

/// An entry observed by its position, counted from zero, is the entry its
/// label names: `m.1` is `m.put`.
@[ checks ]
def placed(m : +U &{get : -F Integer, put : -F String}) -> -F String {
  become m.1
}

/// A lazy product chain names no entry, so each is observed by its position.
@[ checks ]
def last(m : +U (-F Integer & -F String & -F Integer)) -> -F Integer {
  become m.2
}

/// The last component of `chained`, observed by its position.
@[ runs("3") ]
def lasted : () => Integer ;
def lasted = thunk { become last(chained) } ;

@[ refuses("OutOfFragment") ]
def unthunked : -F Integer & -F Integer ;

@[ refuses("OutOfFragment") ]
def menu : +U &{get : ! Integer . end, put : ? Integer . end} ;
