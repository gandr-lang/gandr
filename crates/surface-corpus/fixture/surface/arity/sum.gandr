@[ checks ]
def one : +{Integer} ;
def one = +{.0 = 1} ;

@[ runs("+{.2 = unit}") ]
def third : +{Integer, String, Unit} ;
def third = +{.2 = unit} ;

@[ checks ]
def failed : +{ok : Integer, err : String} ;
def failed = (+{.err = "no"} : +{ok : Integer, err : String}) ;

@[ checks ]
def only : +{only : Integer} ;
def only = (+{.only = 4} : +{only : Integer}) ;

@[ refuses("OutOfFragment") ]
def unstated = +{.err = "no"} ;

@[ checks ]
def absurd(x : +{}) -> -F Integer {
  case x {}
}

@[ checks ]
def pick(v : +{ok : Integer, err : String, gone : Unit}) -> -F Integer {
  case v {
    +{.ok = n} => return n,
    +{.err = e} => return 20,
    +{.gone = u} => return 30
  }
}

@[ runs("30") ]
def gone : +U (-F Integer) ;
def gone = thunk { become pick(+{.2 = unit}) } ;

@[ checks ]
def unwrap(v : +{only : Integer}) -> -F Integer {
  case v {
    +{.only = n} => return n
  }
}

@[ checks ]
def nested(t : #{+{Integer, Integer}, Integer}) -> -F Integer {
  case t {
    #{+{.1 = x}, y} => return x,
    #{_, y} => return y
  }
}

@[ runs("8") ]
def inner : +U (-F Integer) ;
def inner = thunk { become nested(#{+{.1 = 8}, 9}) } ;

/// A sum stated as the chain `A + B`, inside a product stated as `(A + B) * C`,
/// is the braced `#{+{A, B}, C}`: a match reads its summands off either
/// spelling (#791).
@[ checks ]
def chained(t : (Integer + Integer) * Integer) -> -F Integer {
  case t {
    #{+{.1 = x}, y} => return x,
    #{_, y} => return y
  }
}

/// `chained` matches the second summand of its product's first component.
@[ runs("8") ]
def outer : +U (-F Integer) ;
def outer = thunk { become chained(#{+{.1 = 8}, 9}) } ;

/// A pattern variable holds the type its position states: `s`, bound at the
/// first component of `#{+{Integer, Integer}, Integer}`, is matched as the sum
/// that component states, the shape the printer writes `nested` in (#815).
@[ checks ]
def split(t : #{+{Integer, Integer}, Integer}) -> -F Integer {
  case t {
    #{s, y} => case s {
      +{.0 = x} => return y,
      +{.1 = x} => return x
    }
  }
}

/// `split` matches the second summand of its product's first component.
@[ runs("8") ]
def split_inner : +U (-F Integer) ;
def split_inner = thunk { become split(#{+{.1 = 8}, 9}) } ;
