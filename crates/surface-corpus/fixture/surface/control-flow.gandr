@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ checks ]
def tick(n : Nat) -> -F Unit {
  return unit
}

@[ checks ]
def spin(n : Nat) -> -F Nat {
  loop { tick(n); }
}

@[ checks ]
def first(n : Nat) -> -F Nat {
  run m <- loop { break(Succ(n)) } ;
  return Succ(m)
}

@[ runs("Succ(Succ(Zero))") ]
def first_zero : +U (-F Nat) ;
def first_zero = thunk { become first(Zero) } ;

@[ checks ]
def pick(n : Nat) -> -F Nat {
  run m <- loop {
    case n {
      Zero => break(n),
      Succ(p) => break(p),
    }
  } ;
  return Succ(m)
}

@[ runs("Succ(Succ(Zero))") ]
def pick_two : +U (-F Nat) ;
def pick_two = thunk { become pick(Succ(Succ(Zero))) } ;

@[ checks ]
def leave(n : Nat) -> -F Nat {
  loop {
    case n {
      Zero => continue,
      Succ(p) => return p,
    }
  }
}

@[ runs("Zero") ]
def leave_one : +U (-F Nat) ;
def leave_one = thunk { become leave(Succ(Zero)) } ;

@[ checks ]
def hand(n : Nat) -> -F Nat {
  loop { become leave(Succ(n)) }
}

@[ runs("Succ(Zero)") ]
def hand_one : +U (-F Nat) ;
def hand_one = thunk { become hand(Succ(Zero)) } ;

@[ checks ]
def until_done(n : Integer) -> -F Integer {
  while n > 0 { return n } ;
  return 0
}

@[ runs("3") ]
def until_three : +U (-F Integer) ;
def until_three = thunk { become until_done(3) } ;

@[ runs("0") ]
def until_none : +U (-F Integer) ;
def until_none = thunk { become until_done(0) } ;

@[ checks ]
def sift(n : Nat) -> -F Nat {
  loop {
    case n {
      Zero => { break; },
      Succ(p) => { tick(p); continue; },
    }
  } ;
  return n
}

@[ runs("Zero") ]
def sift_zero : +U (-F Nat) ;
def sift_zero = thunk { become sift(Zero) } ;

@[ checks ]
def handled(n : Nat) -> -F Nat {
  handle c : Proc {
    run m <- loop { break(Succ(n)) } ;
    pure m
  } with {
    pure(x) => pure Succ(x),
    oper exit(code, k) => k(unit)
  }
}

@[ runs("Succ(Succ(Zero))") ]
def handled_zero : +U (-F Nat) ;
def handled_zero = thunk { become handled(Zero) } ;

@[ refuses("OutsideLoop") ]
def stray(n : Nat) -> -F Nat {
  break(n)
}

@[ refuses("OutsideLoop") ]
def skip(n : Nat) -> -F Nat {
  continue
}

@[ refuses("OutsideLoop") ]
def held(n : Nat) -> -F Nat {
  loop {
    run t <- pure thunk { break(n) } ;
    continue
  }
}

/// A `for` steps through a native list: `continue` runs the loop again on the
/// list's tail, `return` leaves the function from inside it, and what follows
/// the loop reads the binders around it (#283).
@[ checks ]
def find_succ(xs : List(Nat), otherwise : Nat) -> -F Nat {
  for x in xs {
    case x {
      Zero => continue,
      Succ(p) => return p,
    }
  } ;
  return otherwise
}

/// The search returns from the second cell (#283).
@[ runs("Succ(Zero)") ]
def find_one : +U (-F Nat) ;
def find_one = thunk { become find_succ(cons(Zero, cons(Succ(Succ(Zero)), nil)), Zero) } ;

/// The search reaches the empty list, which leaves the loop with unit, and
/// returns what it was given (#283).
@[ runs("Succ(Zero)") ]
def find_none : +U (-F Nat) ;
def find_none = thunk { become find_succ(cons(Zero, nil), Succ(Zero)) } ;

/// A `for` ending a body runs it on every cell and returns unit (#283).
@[ checks ]
def for_each(xs : List(Nat)) -> -F Unit {
  for x in xs { tick(x); }
}

/// A `for` leaves with unit on the empty list, so a `break` with a value of
/// another type does not check (#283).
@[ refuses("TypeMismatch") ]
def for_value(xs : List(Nat)) -> -F Nat {
  run m <- for x in xs { break(x) } ;
  return m
}
