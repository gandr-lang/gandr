// Loops and their exits. A `loop` or a `while` may run forever, so the
// function holding one states `Div` in its row, `-F [Div] T`: the host
// interface with no operation, which nothing handles (#1481). A caller holds
// it in its own row, and an entry runs at `+U (-F [Div] T)`. A `for` over a
// list descends on the list and needs no entry.

@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ checks ]
def tick(n : Nat) -> -F Unit {
  unit
}

/// A loop that only runs `tick` again: it never leaves.
@[ checks ]
def spin(n : Nat) -> -F [Div] Nat {
  loop { tick(n); }
}

/// A `break` with a value leaves the loop with it, and what follows reads it.
@[ checks ]
def first(n : Nat) -> -F [Div] Nat {
  run m <- loop { break(Succ(n)) } ;
  Succ(m)
}

/// The value the `break` left with, one further.
@[ runs("Succ(Succ(Zero))") ]
def first_zero() -> -F [Div] Nat { become first(Zero) }

/// Each arm of a case leaves the loop with its own value.
@[ checks ]
def pick(n : Nat) -> -F [Div] Nat {
  run m <- loop {
    case n {
      Zero => break(n),
      Succ(p) => break(p),
    }
  } ;
  Succ(m)
}

/// The successor arm leaves with the predecessor.
@[ runs("Succ(Succ(Zero))") ]
def pick_two() -> -F [Div] Nat { become pick(Succ(Succ(Zero))) }

/// A `return` inside the loop leaves the function; `continue` runs the loop again.
@[ checks ]
def leave(n : Nat) -> -F [Div] Nat {
  loop {
    case n {
      Zero => continue,
      Succ(p) => return p,
    }
  }
}

/// One is a successor, so its predecessor is returned.
@[ runs("Zero") ]
def leave_one() -> -F [Div] Nat { become leave(Succ(Zero)) }

/// A loop whose body hands the rest of the run to another function.
@[ checks ]
def hand(n : Nat) -> -F [Div] Nat {
  loop { become leave(Succ(n)) }
}

/// The handed-on call returns at once.
@[ runs("Succ(Zero)") ]
def hand_one() -> -F [Div] Nat { become hand(Succ(Zero)) }

/// A `while` that returns from its first pass when its condition holds.
@[ checks ]
def until_done(n : Integer) -> -F [Div] Integer {
  while n > 0 { return n } ;
  0
}

/// Three is above zero, so the loop returns it.
@[ runs("3") ]
def until_three() -> -F [Div] Integer { become until_done(3) }

/// Zero is not above zero, so the loop never runs.
@[ runs("0") ]
def until_none() -> -F [Div] Integer { become until_done(0) }

/// A bare `break` leaves the loop with unit, and what follows reads the binder.
@[ checks ]
def sift(n : Nat) -> -F [Div] Nat {
  loop {
    case n {
      Zero => { break; },
      Succ(p) => { tick(p); continue; },
    }
  } ;
  n
}

/// Zero breaks at once.
@[ runs("Zero") ]
def sift_zero() -> -F [Div] Nat { become sift(Zero) }

/// A loop inside a handler's body leaves with its value to the body.
@[ checks ]
def handled(n : Nat) -> -F [Div] Nat {
  handle c : Proc {
    run m <- loop { break(Succ(n)) } ;
    pure m
  } with {
    pure(x) => pure Succ(x),
    oper exit(code, k) => k(unit)
  }
}

/// The loop's value, through the `pure` clause.
@[ runs("Succ(Succ(Zero))") ]
def handled_zero() -> -F [Div] Nat { become handled(Zero) }

@[ refuses("OutsideLoop") ]
def stray(n : Nat) -> -F Nat {
  break(n)
}

@[ refuses("OutsideLoop") ]
def skip(n : Nat) -> -F Nat {
  continue
}

@[ refuses("OutsideLoop") ]
def held(n : Nat) -> -F Nat {
  loop {
    run t <- pure thunk { break(n) } ;
    continue
  }
}

/// A `for` steps through a native list: `continue` runs the loop again on the
/// list's tail, `return` leaves the function from inside it, and what follows
/// the loop reads the binders around it (#283).
@[ checks ]
def find_succ(xs : List(Nat), otherwise : Nat) -> -F Nat {
  for x in xs {
    case x {
      Zero => continue,
      Succ(p) => return p,
    }
  } ;
  otherwise
}

/// The search returns from the second cell (#283).
@[ runs("Succ(Zero)") ]
def find_one() -> -F Nat { become find_succ(cons(Zero, cons(Succ(Succ(Zero)), nil)), Zero) }

/// The search reaches the empty list, which leaves the loop with unit, and
/// returns what it was given (#283).
@[ runs("Succ(Zero)") ]
def find_none() -> -F Nat { become find_succ(cons(Zero, nil), Succ(Zero)) }

/// A `for` ending a body runs it on every cell and returns unit (#283).
@[ checks ]
def for_each(xs : List(Nat)) -> -F Unit {
  for x in xs { tick(x); }
}

/// A `for` leaves with unit on the empty list, so a `break` with a value of
/// another type does not check (#283).
@[ refuses("TypeMismatch") ]
def for_value(xs : List(Nat)) -> -F Nat {
  run m <- for x in xs { break(x) } ;
  m
}
