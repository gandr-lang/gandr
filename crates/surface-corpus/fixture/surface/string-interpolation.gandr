@[ refuses("OutOfFragment") ]
def greet(name: String) -> -F String {
  return "hello ${ name }!"
}

@[ refuses("OutOfFragment") ]
def describe(user: String, count: Integer) -> -F String {
  return "user=${ user }\trow=${ #{ n = count } }\n"
}

@[ refuses("OutOfFragment") ]
def price() -> -F String {
  return "total: $5.00 for ${ count } items"
}
