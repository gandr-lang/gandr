// What a manifest model type refuses: a model whose carrier is not the one
// the type fixes, a name that is no sort of the theory, a sort fixed twice, a
// sort fixed after a head other than `Model`, and a `with` whose right is no
// `sort x = A`. `../../model/modules/model-manifest-type.gandr` fixes the
// counter's carrier.

// The counter: a carrier, a start and a step.
import "./model-ascription.gandr" ;

/// The unit as the first state.
@[ checks ]
def unitStart() -> -F Unit {
  unit
}

/// The unit as the next state.
@[ checks ]
def unitStep(u : Unit) -> -F Unit {
  u
}

/// A counter over the unit where the carrier is fixed as the integers.
@[ refuses("TypeMismatch") ]
def unitCounter : Model(Counter) with sort C = Integer ;
def unitCounter = #{.start = unitStart, .step = unitStep} ;

/// A sort the counter does not have.
@[ refuses("UnknownMember") ]
def noSuchSort : Model(Counter) with sort D = Integer ;

/// The carrier fixed twice.
@[ refuses("DuplicateDefinition") ]
def fixedTwice : Model(Counter) with sort C = Integer with sort C = Unit ;

/// A sort fixed on a list, which has none.
@[ refuses("MalformedForm") ]
def listed : List(Integer) with sort C = Integer ;

/// A `with` whose right is a type, not a sort it fixes.
@[ refuses("MalformedForm") ]
def unbound : Model(Counter) with Integer ;
