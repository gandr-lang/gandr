// A type member at a source's top level, misused: it names its type only for
// the declarations written after it.

/// A declaration written before the member does not see it.
@[ refuses("UnresolvedTypeHead") ]
def early : Band ;
def early = #{low = 200000, high = 800000} ;

/// A rubric's band, in millionths.
type Band = #{low : Integer, high : Integer} ;

/// A record without the high bound is no band.
@[ refuses("MissingRecordField") ]
def partial : Band ;
def partial = #{low = 200000} ;
