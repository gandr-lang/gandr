// A root child that is no declaration is refused alone, where it stands:
// the declarations around it are collected, lowered and checked as if it
// were not there (#1058).

/// A declaration before every stray, which checks.
@[ checks ]
def before : Integer ;
def before = 1 ;

/// A statement keyword outside any block: a block's statement, not a
/// declaration (#1058).
@[ refuses("OutOfFragment") ]
leta x = 1 ;

/// An expression standing where a declaration belongs (#1058).
@[ refuses("OutOfFragment") ]
1 + 2

/// A declaration whose name is a keyword names nothing to file it under
/// (#1058).
@[ refuses("MalformedForm") ]
def mu = 1 ;

/// A declaration between the strays, which checks.
@[ checks ]
def between : Integer ;
def between = before ;

/// A byte no label molds (#1058).
@[ refuses("MalformedForm") ]
§

/// A declaration after every stray, which checks and reads the ones before.
@[ checks ]
def after : Integer ;
def after = between ;
