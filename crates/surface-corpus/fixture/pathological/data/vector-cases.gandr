// What a case on a vector refuses: an arm left out because its constructor
// cannot stand at the scrutinee's index, which waits for the case to prune it
// by its index (#1314).

// The naturals the lengths count in.
import "../../model/data/data-base.gandr" ;

// The vectors.
import "../../model/data/vectors.gandr" ;

/// The first element of a vector at least one long, with no `VNil` arm:
/// `VNil` stands at zero, apart from `Succ(n)`, but the arm is required until
/// a case prunes it (#1314).
@[ refuses("NonExhaustiveMatch") ]
def head(n : Nat, v : Vec(Integer, Succ(n))) -> -F Integer {
  case v {
    VCons(m, h, t) => h
  }
}
