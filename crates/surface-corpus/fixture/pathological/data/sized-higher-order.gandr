// What a recursion handed through a higher-order function refuses. The
// recursion's own parameter handed to `apply` or `applyAt` instantiates its
// parameter or stage at that parameter's stage, which the claim does not take
// (#393, #392). A helper whose signature names no type parameter and no stage
// hands its argument on at no stage, and a helper with no recursion and no
// stage opens none for its result to follow: the model's quantified
// signatures lift both, `applyAt` the first and `predAt` the second. Shared
// with `../../model/data/sized-higher-order.gandr`.

// The naturals the recursions take apart.
import "../../model/data/data-base.gandr" ;

// `apply`, the higher-order function the model's recursion goes through.
import "../../model/data/sized-higher-order.gandr" ;

/// The parameter itself handed on: `apply`'s type parameter is the number at
/// its own stage, not below it, and `applied_again[<]` takes only what stands
/// below (#393).
@[ refuses("StageNotBelow") ]
def rec applied_again(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => Succ(apply(Nat, Nat, applied_again[<], n))
  }
}

/// The parameter itself handed to `applyAt`: the call instantiates `i` at
/// the parameter's own stage, and `applied_at_again[<]` takes nothing there
/// (#392).
@[ refuses("StageNotBelow") ]
def rec applied_at_again(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => Succ(applyAt(applied_at_again[<], n))
  }
}

/// A stage on an integer: the signature's marks place only data types, so the
/// checkers refuse the stage where the kernel could not read it (#392).
@[ refuses("OutOfFragment") ]
def integerAt @[i : Size] (n : Integer[i]) -> -F Integer {
  return n
}

/// A stage in a path's carrier: a path places no stage, so the lowering
/// refuses it where it is written (#392).
@[ refuses("OutOfFragment") ]
def carriedAt @[i : Size] (a : Nat, q : Path(Nat[i], a, a)) -> -F Nat {
  return a
}

/// A function applied to a number, its signature naming no type parameter.
@[ checks ]
def applyNat(f : Nat => Nat, x : Nat) -> -F Nat {
  f(x)
}

/// The predecessor handed through `applyNat`: its signature takes any number,
/// so `plainly_helped[<]`, which takes only numbers below the stage, does not
/// stand for its function; the model's `helped` goes through `applyAt`.
@[ refuses("StageNotBelow") ]
def rec plainly_helped(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => Succ(applyNat(plainly_helped[<], p))
  }
}

/// The predecessor of a number, zero's its own.
@[ checks ]
def pred(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => p
  }
}

/// Half a number, recursing on its predecessor's predecessor read through
/// `pred`: `pred` opens no stage, so its result stands at none and
/// `halved_through_pred[<]` does not take it; a recursive definition's result
/// can follow its argument (`../../model/data/following.gandr`), and a
/// quantified signature states it (`predAt` and `halvedAt` in the model).
@[ refuses("StageNotBelow") ]
def rec halved_through_pred(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => { run q <- pred(p); Succ(halved_through_pred[<](q)) }
  }
}

/// The number itself handed to `boundedAt` as its `k` beside its predecessor
/// as its `j`: `k` would stand at the number's stage, not below `j`, and the
/// result would type the number below its own stage for
/// `looping_through_bound[<]` to take, recursing on the number forever. The
/// call is refused where `k` is read (#1241).
@[ refuses("StageNotBelow") ]
def rec looping_through_bound(n : Nat) -> -F Nat {
  case n {
    Zero => Zero,
    Succ(p) => { run q <- boundedAt(p, n); looping_through_bound[<](q) }
  }
}
