// A clause owes the rest of its scope exactly one end once that rest holds a
// task's end. A thunk may be forced twice or never, so a resumption inside one
// is refused, however the thunk is forced.

// The task's protocol.
import "../../model/cancellation/cancel-base.gandr" ;

/// A scope whose exit clause resumes the rest inside a thunk while its task's
/// end is open (#1334).
@[ refuses("ContinuationCaptured") ]
def leaked() -> -F Unit {
  handle c : Proc {
    fork (task : Cancel.Join) {
      send(task, Cancel.notes);
      close(task)
    } as found;
    c.exit(1);
    recv(found) as text;
    close(found)
  } with {
    pure(x) => pure x,
    oper exit(code, k) => force thunk { k(unit) }
  }
}
