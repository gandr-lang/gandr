@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { run g <- d(f) ; e(g) } } } } } }") ]
def comp(
  a : Type,
  b : Type,
  c : Type,
  f : +U[ω] (a -> -F b),
  g : +U[ω] (b -> -F c),
  x : a
) -> -F c {
  run y <- f(x);
  become g(y)
}

@[ refuses("TypeMismatch") ]
def captured(
  a : Type,
  b : Type,
  c : Type,
  d : Type,
  u : +U[ω] (a -> -F d),
  h : +U[ω] (d -> -F d)
) -> -F (+U[ω] (a -> -F d)) {
  return thunk { become comp(a, c, d, u, h) }
}
