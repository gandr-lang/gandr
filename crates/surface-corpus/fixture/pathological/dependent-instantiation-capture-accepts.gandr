@[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { run g <- d(f) ; e(g) } } } } } }") ]
def comp(
  a : Type,
  b : Type,
  c : Type,
  f : a => b,
  g : b => c,
  x : a
) -> -F c {
  run y <- f(x);
  become g(y)
}

@[ refuses("TypeMismatch") ]
def captured(
  a : Type,
  b : Type,
  c : Type,
  d : Type,
  u : a => d,
  h : d => d
) -> -F (a => d) {
  return thunk { become comp(a, c, d, u, h) }
}
