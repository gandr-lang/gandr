// A pattern hole inside a constructor's payload leaves which values of the
// payload the arm covers undecided, and the checker refuses the match (#391).

/// An integer, or none.
@[ checks ]
data Maybe : Type {
  Nothing : Maybe;
  Just : (x : Integer) --> Maybe;
}

/// The hole stands for `Just`'s payload (#391).
@[ refuses("UndecidedCoverage") ]
def describe(m : Maybe) -> -F Integer {
  case m {
    Just(?) => 100,
    Nothing => 200
  }
}

/// The run target describes `Just(3)`; the lowering reads no final
/// expression as a run target yet (#1105).
@[ refuses("OutOfFragment") ]
describe(Just(3))
