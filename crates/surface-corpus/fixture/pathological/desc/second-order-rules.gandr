// The twin of `model/desc/second-order-rules.gandr`: β, whose instantiated
// variable stands under a binder the order cannot see past; β's first-order
// shadow, which loses the binding; an instantiation at the wrong count; and ζ
// beside a rule it overlaps.

/// β substitutes `lam`'s body, which stands under `lam` rather than as an
/// argument of `app`: the order does not put `t(u)` below the redex, so the
/// rule is not known to end (#1326).
@[ refuses("RulesUnoriented") ]
theory Beta {
  sort Tm : Type+;
  oper lam : (t : pi+ (x : Tm) . Tm) --> Tm;
  oper app : (t : Tm, u : Tm) --> Tm;
  rule beta : app(lam(t), u) <=> t(u);
}

/// β's first-order shadow passes `lam`'s body to `app`, whose port binds
/// nothing: the binding is lost, and the description check refuses the rule
/// by the variable's name (#1324).
@[ refuses("MalformedForm") ]
theory BetaShadow {
  sort Tm : Type+;
  oper lam : (t : pi+ (x : Tm) . Tm) --> Tm;
  oper app : (t : Tm, u : Tm) --> Tm;
  rule betaShadow : app(lam(t), u) <=> app(t, u);
}

/// An instantiation takes one argument per variable its port binds, and `t`
/// binds one (#1324).
@[ refuses("MalformedForm") ]
theory LetTwice {
  sort Tm : Type+;
  oper let : (u : Tm, t : pi+ (x : Tm) . Tm) --> Tm;
  rule zeta : let(u, t) <=> t(u, u);
}

/// ζ beside a rule rewriting `let` at `zero()`: their left sides overlap, and
/// a second-order rule takes part in no critical pair, even one whose reducts
/// agree (#1326).
@[ refuses("RulesOverlapSecondOrder") ]
theory LetOverlap {
  sort Tm : Type+;
  oper zero : () --> Tm;
  oper let : (u : Tm, t : pi+ (x : Tm) . Tm) --> Tm;
  rule zeta : let(u, t) <=> t(u);
  rule zetaZero : let(zero(), t) <=> t(zero());
}
