// The twin of `model/desc/second-order-signatures.gandr`: a binder over an
// ordinary sort, a binder where a sort's index is written, and the universe of
// representable sorts outside the `theory` block that reads it.

/// A port binds a variable of `Tm`, which is not representable: the
/// description check refuses the binder, and its refusal names the sort `Tm`
/// and the port `t` (#1553).
@[ refuses("IllFormedDescription") ]
theory Unbindable {
  sort Tm : Type;
  oper lam : (t : pi+ (x : Tm) . Tm) --> Tm;
}

/// A sort's index is a plain variable: an operation's input port binds, an
/// index does not.
@[ refuses("MalformedForm") ]
theory BoundIndex {
  sort Tm : Type+;
  sort Scoped(i : pi+ (x : Tm) . Tm) : Type;
}

/// The universe of representable sorts classifies a sort member only.
@[ refuses("OutOfFragment") ]
def universeOutside : Type+ ;
