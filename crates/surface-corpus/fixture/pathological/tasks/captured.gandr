// A scope's clause receives the rest of the scope as a continuation it may
// drop or resume twice. An operation the scope answers while the parent holds
// its task's end hands that end to the clause, which could leave it open or
// read it twice, so the operation is refused.

// The task's protocol.
import "../../model/tasks/task-base.gandr" ;

/// A scope exiting while its task's end is still open.
@[ refuses("CapturedEndpoint") ]
def captured() -> -F Unit {
  handle c : Proc {
    fork (task : Task.Join) {
      send(task, Task.notes);
      close(task)
    } as found;
    c.exit(1);
    recv(found) as text;
    close(found)
  } with {
    pure(x) => pure x,
    oper exit(code, k) => k(unit)
  }
}
