// What the cumulative hierarchy refuses. A fold through a set's picking
// function answers at its motive, so a member returned where its rank is
// expected is refused; the recursion descends only to a member, so a call on
// the set itself is refused; and the sets range over a universe, so they
// cannot live in it. Shared with `../../model/universe/v-infinity.gandr`.

/// Sets: a type of members, and the member at each of its elements.
@[ checks ]
data Vinf : Type[+, 1] {
  Sup : (a : Type, f : +U (a -> -F Vinf)) --> Vinf;
}

/// Ordinals of the same shape: the limit of a family of smaller ordinals.
@[ checks ]
data Ord : Type[+, 1] {
  Lim : (a : Type, g : +U (a -> -F Ord)) --> Ord;
}

/// The member itself where its rank is expected: the limit's family wants
/// ordinals, and `f(x)` is a set.
@[ refuses("TypeMismatch") ]
def rec unranked(v : Vinf) -> -F Ord {
  case v {
    Sup(a, f) => Lim(a, thunk { fn (x) { f(x) } })
  }
}

/// The set itself where a member is expected: it is not below its own stage.
@[ refuses("StageNotBelow") ]
def rec circular(v : Vinf) -> -F Ord {
  case v {
    Sup(a, f) => Lim(a, thunk { fn (x) { circular[<](Sup(a, f)) } })
  }
}

/// Sets over the types of a universe, placed in that same universe.
@[ refuses("DataFieldLevel") ]
data Small : Type {
  Pick : (a : Type, f : +U (a -> -F Small)) --> Small;
}
