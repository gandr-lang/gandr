// A product written as a chain where an expression stands, unquoted: an
// expression reads `*` as multiplication of the two components, which are
// codes, not numbers (#1127).

/// The stationary flow at a product, its argument written bare.
@[ refuses("TypeMismatch") ]
def bare_product : Flow(Type, Unit * Integer, Unit * Integer) ;
def bare_product = stay(Unit * Integer) ;
