module Evolution {
  type SeatEnd = ?String. mu turn. +{ report : !String. &{ next : turn, retire : end }, handoff : !String. end };
  type Kept = ?String. mu turn. +{ report : !String. &{ next : turn }, handoff : !String. end };
  @[ checks ]
  def keep : Flow(Type, SeatEnd, Kept) ;
  def keep = sim(SeatEnd, Kept) ;
}

@[ checks ]
def served : Run(Evolution.SeatEnd) ;
def served = recorded(received("task"), selected(report), sent("progress"), offered(retire), closed) ;

@[ refuses("RunNotAdmitted") ]
def retired : +U (-F Run(Evolution.Kept)) ;
def retired = thunk { become ride(\X. Run(X), Evolution.keep, served) } ;
