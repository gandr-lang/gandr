// What function extensionality from univalence does not reach yet: a
// homotopy read as a map into the path space, its two ends read back as the
// two functions. The map holds the results of `f`, `g` and `h` at a point,
// and an end reads one of them, so the end is `f` only where conversion reads
// a call's result returned as the call itself, a step it does not take
// (#1481). `../../model/identity/funext-from-ua.gandr` derives the path
// between the ends; the drop of an unread call it needs is in
// `../../model/control/divergence.gandr`.

// The path space, its ends and `funextOfSpace`.
import "../../model/identity/funext-from-ua.gandr" ;

/// Function extensionality from a homotopy, through the path space: refused
/// where the ends are read back as `f` and `g` (#1481).
@[ refuses("TypeMismatch") ]
def funextFromUa(
  a : Type,
  b : Type,
  f : a => b,
  g : a => b,
  h : (x : a) => Path(b, f(x), g(x))
) -> -F Path(a => b, f, g) {
  become funextOfSpace(a, b, thunk { fn (x) { (f(x), (g(x), h(x))) } })
}
