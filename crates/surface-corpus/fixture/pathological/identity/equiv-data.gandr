// What a universe equivalence between data types refuses: a map that loses a
// field has a round trip that does not return, refused at that pattern, and a
// type holding itself, whose coverage would recur, is outside the vocabulary.

// The shapes, the figures and `Shapes.toFigure`.
import "../../model/identity/flow-data.gandr" ;
// The naturals and `Renumber.step`, each constructor to itself.
import "./flow-data.gandr" ;

/// Every figure drawn as a circle: a rectangle's height is lost.
@[ checks ]
def rounded(figure : Figure) -> -F Shape {
  case figure {
    Round(r) => Circle(r),
    Box(h, w) => Circle(w)
  }
}

/// To the figures and back as circles: the circle returns, the rectangle does
/// not, refused at that pattern.
@[ refuses("RoundTripDistinct") ]
def flattened = equiv(Shapes.toFigure, rounded) ;

/// #1316: a type holding itself would be covered as a list is, its own field
/// read as a tail; the coverage does not read one yet, so no equivalence
/// decides it.
@[ refuses("EquivUnsupported") ]
def renumbering = equiv(Renumber.step, Renumber.step) ;
