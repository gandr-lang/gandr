data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

def classify(c : Color) -> -F Integer {
  case c {
    Red => return 0,
    ? => return 1,
    Blue => return 2
  }
}

data Maybe : Type {
  Nothing : Maybe;
  Just : (x : Integer) --> Maybe;
}

def describe(m : Maybe) -> -F Integer {
  case m {
    Just(?) => return 100,
    Nothing => return 200
  }
}

describe(Nothing)
