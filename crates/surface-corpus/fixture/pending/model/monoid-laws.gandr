def unit = 0;

def mul(x: Integer, y: Integer) -> F Integer {
  ret x + y
}

def unitL(x: Integer) -> F Path(Integer, mul(unit, x), x) {
  ret here(x)
}

def unitR(x: Integer) -> F Path(Integer, mul(x, unit), x) {
  ret here(x)
}

def assoc(x: Integer, y: Integer, z: Integer) -> F Path(Integer, mul(mul(x, y), z), mul(x, mul(y, z))) {
  ret here(mul(mul(x, y), z))
}
