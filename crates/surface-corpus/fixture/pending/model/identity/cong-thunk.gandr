def double(x: Integer) -> -F Integer {
  return (x + x)
}

def cong_double = thunk {
  fn(p: Path(Integer, 4, 4)) {
    become walk(p,
      fn(x, y, q) { return Path(?, thunk { become double(x) }, thunk { become double(y) }) },
      fn(x) { return here(thunk { become double(x) }) })
  }
};

cong_double(here(4))
