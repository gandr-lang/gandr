def consume(p: package [ T ] +U[ω] (-F #{ read: +U[ω] (T -> -F Integer), seed: T }))
  -> -F Integer
{
  unpack m : package [ T ] +U[ω] (-F #{ read: +U[ω] (T -> -F Integer), seed: T }) = p;
  run r <- force m;
  run f <- r.read;
  run s <- r.seed;
  f(s)
}

def int_counter : package [ T ] +U[ω] (-F #{ read: +U[ω] (T -> -F Integer), seed: T });
def int_counter = pack [ Integer ] thunk {
  return #{ read = thunk { fn (n: Integer) { return n } }, seed = 7 }
};

def text_counter : package [ T ] +U[ω] (-F #{ read: +U[ω] (T -> -F Integer), seed: T });
def text_counter = pack [ String ] thunk {
  return #{ read = thunk { fn (s: String) { return 42 } }, seed = "seven" }
};

def total() -> -F Integer {
  run a <- consume(int_counter);
  run b <- consume(text_counter);
  return (a + b)
}

total()
