if true -> -F Integer { pure 1 } else { pure 2 }

case (Inl(41) : Integer + String) -> -F Integer {
  Inl(x) => pure (x + 1),
  Inr(s) => pure 0
}

if false -> -F Integer { pure 0 } else if true { pure 1 } else { pure 2 }

{
  run x : -F Integer <- pure 40;
  run y <- (pure 2 : -F Integer);
  pure (x + y)
}
