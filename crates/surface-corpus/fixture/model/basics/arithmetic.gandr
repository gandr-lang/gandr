// Arithmetic over integers, numbers at a stated width, and a run target
// returning a sum.

/// The operators' precedence groups `2 * 3` first. An operator is a
/// computation, and a definition with no stated type reads its value where
/// nothing infers that computation's type.
@[ refuses("NotSynthesisable") ]
def total = 1 + 2 * 3;

/// One number at each width a suffix states; the lowering admits no typed
/// number yet (#1109).
@[ refuses("OutOfFragment.typed_number") ]
def sized_atoms = (1u32, (2u64, (3i32, (4i64, (1.5f32, 2.5f64)))));

/// The run target returns the sum; the lowering reads no final expression as
/// a run target yet (#1105).
@[ refuses("OutOfFragment.WrongSort.declaration") ]
pure total
