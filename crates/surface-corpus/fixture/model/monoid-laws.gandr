@[ runs("0") ]
def neutral = 0;

@[ checks ]
def mul(x: Integer, y: Integer) -> -F Integer {
  become x + y
}

@[ refuses("EndpointMismatch") ]
def unitL(x: Integer) -> -F Path(Integer, mul(neutral, x), x) {
  return here(x)
}

@[ refuses("EndpointMismatch") ]
def unitR(x: Integer) -> -F Path(Integer, mul(x, neutral), x) {
  return here(x)
}

@[ refuses("EndpointMismatch") ]
def assoc(x: Integer, y: Integer, z: Integer) -> -F Path(Integer, mul(mul(x, y), z), mul(x, mul(y, z))) {
  return here(mul(mul(x, y), z))
}
