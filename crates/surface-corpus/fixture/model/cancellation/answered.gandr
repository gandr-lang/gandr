// An abandoned rest never runs: the clause that abandons it answers for the
// scope, and neither the rest of the subject nor the `pure` clause runs.

// The subject's shared declarations.
import "./cancel-base.gandr" ;

/// A scope cancelled at its exit answers nine, not one hundred and one
/// (#1334).
@[ runs("9") ]
def answered() -> -F Integer {
  handle c : Proc {
    c.exit(1);
    pure 1
  } with {
    pure(x) => pure x + 100,
    oper exit(code, k) => { abandon(k); pure 9 }
  }
}
