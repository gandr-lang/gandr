// A function's action on paths, the HoTT book's Lemma 2.2.1 (`ap`), at a
// constructor's wrapper: `cong` carries a path between integers to one
// between the boxes the constructor builds around them.

/// A box holding one integer.
@[ checks ]
data Box : Type {
  Wrap : (n : Integer) --> Box;
}

/// The constructor as a function.
@[ checks ]
def wrap(x: Integer) -> -F Box {
  return Wrap(x)
}

/// A path between integers carried along the wrapper, to the boxes around
/// its endpoints.
@[ checks ]
def cong_wrap(a: Integer, b: Integer, p: Path(Integer, a, b)) -> -F Path(Box, Wrap(a), Wrap(b)) {
  become cong(wrap, p)
}

/// Reflexivity at four carried along the wrapper by a run.
@[ checks ]
def wrapped : () => Path(Box, Wrap(4), Wrap(4));
def wrapped = thunk { become cong_wrap(4, 4, here(4)) };
