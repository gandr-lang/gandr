// The circle's loop space, presented at the term stratum: `Loop(x)` is "x,
// then the loop" and `Unloop(x)` "x, then its inverse", with the two
// cancellations as rules, so these terms are, one stratum down, the words
// that `Path(Circle, Base, Base)` is in `circle.gandr`, the book's circle
// (§ 8.1). Here the mechanism is stated on terms: the presented integers
// model the circle's shape with laws that are conversion (`Winding`), a model
// over the native integers owes its laws and a fold into it rests on them
// under `respects` (`NativeWinding`), and the winding number and spinning are
// an equivalence `Words ≃ Int` whose round trips, `sectWords` and
// `retrWords`, are proved by induction over each presented type.

// The presented integers.
import "./circle-base.gandr" ;

/// The loop's words as a presented type: its rules rewrite constructor
/// terms, so a word normalizes to the loops it winds.
@[ normalizes("Loop(Loop(Unloop(Unloop(Loop(Nil))))) ~> Loop(Nil)") ]
data Words : Type {
  Nil : Words;
  Loop : (x : Words) --> Words;
  Unloop : (x : Words) --> Words;
  rule Loop(Unloop(x)) <=> x;
  rule Unloop(Loop(x)) <=> x;
}

/// A function that builds a word: one more loop.
@[ checks ]
def around(c : Words) -> -F Words {
  return Loop(c)
}

/// A run returns the word it builds.
@[ runs("Loop(Loop(Nil))") ]
def built : +U (-F Words) ;
def built = thunk { become around(Loop(Nil)) } ;

/// Conversion reads a word by its normal form: a cancelled loop is a loop.
@[ checks ]
def cancelled_word : Path(Words, Loop(Unloop(Loop(Nil))), Loop(Nil)) ;
def cancelled_word = here(Loop(Nil)) ;

/// A path between words stands at the path between their normal forms.
@[ checks ]
def respelled : Path(Words, Loop(Nil), Loop(Nil)) ;
def respelled = cancelled_word ;

/// Two words that both cancel to the empty word are one word.
@[ checks ]
def both_cancel : Path(Words, Unloop(Loop(Nil)), Loop(Unloop(Nil))) ;
def both_cancel = here(Nil) ;

/// No rule identifies a loop with the empty word.
@[ refuses("EndpointMismatch") ]
def loop_not_nil : Path(Words, Loop(Nil), Nil) ;
def loop_not_nil = here(Nil) ;

/// A case that tells a loop from its inverse, refused: `Unloop(Loop(Nil))`
/// and `Loop(Unloop(Nil))` are one word, which it would read as 2 and 1.
@[ refuses("RuleNotRespected") ]
def tell_words(c : Words) -> -F Integer {
  case c {
    Nil => return 0,
    Loop(x) => return 1,
    Unloop(x) => return 2
  }
}

/// The path from 2 to 1 that `tell_words` would carry `both_cancel` to; with
/// `tell_words` refused its applications do not compute, and the endpoints
/// differ.
@[ refuses("EndpointMismatch") ]
def two_is_one() -> -F Path(Integer, 2, 1) {
  become cong(tell_words, both_cancel)
}

/// The mirror: a loop for an inverse and an inverse for a loop. At
/// `Loop(Unloop(x))` it builds `Unloop(Loop(mirror(x)))`, which the second
/// rule reads as `mirror(x)`, so it respects both rules and is admitted.
@[ checks ]
def rec mirror(c : Words) -> -F Words {
  case c {
    Nil => return Nil,
    Loop(x) => { run m <- mirror[<](x); return Unloop(m) },
    Unloop(x) => { run m <- mirror[<](x); return Loop(m) }
  }
}

/// The mirror of a loop is its inverse.
@[ runs("Unloop(Nil)") ]
def mirrored : +U (-F Words) ;
def mirrored = thunk { become mirror(Loop(Nil)) } ;

/// Conversion runs an admitted fold at a closed word. Read by its normal
/// form, `Loop(Unloop(Nil))` is `Nil`, whose mirror is `Nil`; unfolded
/// letter by letter, the mirror is `Unloop(Loop(Nil))`, which is `Nil`
/// again. The two readings agree because the mirror respects the rules.
@[ checks ]
def mirror_cancelled : Path(Words, mirror(Loop(Unloop(Nil))), Nil) ;
def mirror_cancelled = here(Nil) ;

/// The mirror of a respelled loop is the inverse of the loop.
@[ checks ]
def mirror_respelled : Path(Words, mirror(Loop(Unloop(Loop(Nil)))), Unloop(Nil)) ;
def mirror_respelled = here(Unloop(Nil)) ;

/// The circle's shape: the same presentation as a signature models interpret.
/// `Model` reads a `sign` block, so the shape is spelled apart from `Words`.
sign CircleShape {
  sort Pt : Type;

  oper base : Pt;
  oper turn : (x : Pt) --> Pt;
  oper unturn : (x : Pt) --> Pt;

  rule turnUnturn : turn(unturn(x)) <=> x;
  rule unturnTurn : unturn(turn(x)) <=> x;
}

/// The number of laws in a presentation's rule chain.
@[ checks ]
def rec laws(chain : Sig) -> -F Integer {
  case chain {
    Rule(name, left, right, rest) => { run r <- laws[<](rest); return r + 1 },
    _ => return 0
  }
}

/// The number of laws a presentation states.
@[ checks ]
def law_count(presented : Sig) -> -F Integer {
  case presented {
    Presents(sorts, opers, rules) => become laws(rules),
    _ => return 0
  }
}

/// The shape's laws join, so its `Sig` value carries both as `Rule` entries.
@[ runs("2") ]
def shape_laws : +U (-F Integer) ;
def shape_laws = thunk { become law_count(CircleShape) } ;

/// The presented integers as a model of the shape: `turn` the successor and
/// `unturn` the predecessor. Each law is proved by `here`: conversion reads
/// the inner call under the constructor the outer one builds, and the
/// integers' rules cancel the pair.
module Winding : Model(CircleShape) {
  type Pt = Int;

  def base() -> -F Int { return Z }

  def turn(n : Int) -> -F Int { return S(n) }

  def unturn(n : Int) -> -F Int { return P(n) }

  @[ checks ]
  def turnUnturn(n : Int) -> -F Path(Int, turn(unturn(n)), n) {
    return here(n)
  }

  @[ checks ]
  def unturnTurn(n : Int) -> -F Path(Int, unturn(turn(n)), n) {
    return here(n)
  }

  @[ runs("S(S(Z))") ]
  def wound() -> -F Int {
    run b <- base() ;
    run n <- turn(b) ;
    become turn(n)
  }
}

/// The same shape modelled over the native integers. The laws hold by
/// arithmetic, which conversion leaves to the runtime, so each is owed, and
/// a fold into this model rests on them.
module NativeWinding : Model(CircleShape) {
  type Pt = Integer;

  def base() -> -F Integer { return 0 }

  def turn(n : Integer) -> -F Integer { return n + 1 }

  def unturn(n : Integer) -> -F Integer { return n - 1 }

  @[ owes(1) ]
  def turnUnturn : (n : Integer) => Path(Integer, turn(unturn(n)), n) ;

  @[ owes(1) ]
  def unturnTurn : (n : Integer) => Path(Integer, unturn(turn(n)), n) ;

  @[ runs("2") ]
  def wound() -> -F Integer {
    run b <- base() ;
    run n <- turn(b) ;
    become turn(n)
  }
}

/// The winding number, the fold out of the words into the presented
/// integers. At `Loop(Unloop(x))` it builds `S(P(windWords(x)))`, whose
/// normal form is `windWords(x)`, so it respects both rules and is admitted.
@[ checks ]
def rec windWords(c : Words) -> -F Int {
  case c {
    Nil => return Z,
    Loop(x) => { run n <- windWords[<](x); return S(n) },
    Unloop(x) => { run n <- windWords[<](x); return P(n) }
  }
}

/// Two loops wind twice.
@[ runs("S(S(Z))") ]
def twice_wound : +U (-F Int) ;
def twice_wound = thunk { become windWords(Loop(Loop(Nil))) } ;

/// A run builds the count letter by letter: a cancelled word winds to
/// `S(P(Z))`, which conversion reads as `Z` (`wound_never`).
@[ runs("S(P(Z))") ]
def wound_letterwise : +U (-F Int) ;
def wound_letterwise = thunk { become windWords(Loop(Unloop(Nil))) } ;

/// Conversion runs the fold at a closed word: two loops are two successors.
@[ checks ]
def wound_twice : Path(Int, windWords(Loop(Loop(Nil))), S(S(Z))) ;
def wound_twice = here(S(S(Z))) ;

/// A cancelled word winds to zero in conversion.
@[ checks ]
def wound_never : Path(Int, windWords(Loop(Unloop(Nil))), Z) ;
def wound_never = here(Z) ;

/// The winding number into the native integers, a fold that rests on the
/// native model's laws. At `Loop(Unloop(x))` it computes
/// `turn(unturn(native_wind(x)))`, which conversion does not reduce to
/// `native_wind(x)` on a variable; the law `turnUnturn` states exactly that
/// path, so `respects` names it for the first rule and `unturnTurn` for the
/// second. The loop arms call the model's operations rather than spelling
/// `n + 1`, so each side the rule relates is the law's own endpoint. The fold
/// checks and owes what its two laws owe.
@[ respects((NativeWinding.turnUnturn, NativeWinding.unturnTurn)), owes(2) ]
def rec native_wind(c : Words) -> -F Integer {
  case c {
    Nil => return 0,
    Loop(x) => become NativeWinding.turn(native_wind[<](x)),
    Unloop(x) => become NativeWinding.unturn(native_wind[<](x))
  }
}

/// Two loops wind twice into the native integers.
@[ runs("2") ]
def native_twice : +U (-F Integer) ;
def native_twice = thunk { become native_wind(Loop(Loop(Nil))) } ;

/// A cancelled word winds as its normal form does: not at all.
@[ runs("0") ]
def native_unwound : +U (-F Integer) ;
def native_unwound = thunk { become native_wind(Loop(Unloop(Nil))) } ;

/// Spinning, the fold out of the presented integers into the words: a
/// successor is a loop and a predecessor an inverse. It recurses structurally
/// and respects both rules as the winding number does.
@[ checks ]
def rec spinWords(n : Int) -> -F Words {
  case n {
    Z => return Nil,
    S(x) => { run c <- spinWords[<](x); return Loop(c) },
    P(x) => { run c <- spinWords[<](x); return Unloop(c) }
  }
}

/// Two successors spin twice around.
@[ runs("Loop(Loop(Nil))") ]
def spun : +U (-F Words) ;
def spun = thunk { become spinWords(S(S(Z))) } ;

/// Conversion runs spinning at a closed word: two successors are two loops.
@[ checks ]
def spun_twice : Path(Words, spinWords(S(S(Z))), Loop(Loop(Nil))) ;
def spun_twice = here(Loop(Loop(Nil))) ;

/// A cancelled count spins to the empty word.
@[ checks ]
def spun_back : Path(Words, spinWords(S(P(Z))), Nil) ;
def spun_back = here(Nil) ;

/// A predecessor spins to the inverse loop.
@[ checks ]
def spun_under : Path(Words, spinWords(P(Z)), Unloop(Nil)) ;
def spun_under = here(Unloop(Nil)) ;

/// The round trip at a closed word: winding a loop and spinning the count
/// gives the loop back. The inner call stands as the outer one's argument,
/// and conversion runs both.
@[ checks ]
def spun_wound : Path(Words, spinWords(windWords(Loop(Nil))), Loop(Nil)) ;
def spun_wound = here(Loop(Nil)) ;

/// The other round trip at a closed count: spinning two successors and
/// winding the word counts two.
@[ checks ]
def wound_spun : Path(Int, windWords(spinWords(S(S(Z)))), S(S(Z))) ;
def wound_spun = here(S(S(Z))) ;

/// A round trip returns the normal form, not the word it started from: a
/// cancelled loop comes back as the loop.
@[ checks ]
def spun_wound_cancelled : Path(Words, spinWords(windWords(Loop(Unloop(Loop(Nil))))), Loop(Nil)) ;
def spun_wound_cancelled = here(Loop(Nil)) ;

/// A respelled count comes back as its normal form, one predecessor.
@[ checks ]
def wound_spun_respelled : Path(Int, windWords(spinWords(S(P(P(Z))))), P(Z)) ;
def wound_spun_respelled = here(P(Z)) ;

/// The round trip does not lose the loop: it is not the empty word.
@[ refuses("EndpointMismatch") ]
def spun_wound_lost : Path(Words, spinWords(windWords(Loop(Nil))), Nil) ;
def spun_wound_lost = here(Nil) ;

/// One inverse loop more: the function the inverse letter applies, as
/// `around` applies the loop.
@[ checks ]
def unaround(c : Words) -> -F Words {
  return Unloop(c)
}

/// Spinning undoes winding at every word: the round trip at a variable, by
/// induction over the presented words. The result type reads the word the
/// fold descends on, so each arm answers it at its constructor and the
/// recursive call at the field: `sectWords[<](x)` relates
/// `spinWords(windWords(x))` to `x`, and carried along `around` it relates
/// `Loop(spinWords(windWords(x)))`, which `spinWords(windWords(Loop(x)))`
/// runs to, to `Loop(x)`. The case respects both rules: at `Loop(Unloop(x))`
/// the arms compose to `cong(around, cong(unaround, p))`, whose functions
/// compose to the identity under the rules, so the chain is `p` itself, the
/// answer at `x`.
@[ checks ]
def rec sectWords(c : Words) -> -F Path(Words, spinWords(windWords(c)), c) {
  case c {
    Nil => return here(Nil),
    Loop(x) => { run p <- sectWords[<](x); become cong(around, p) },
    Unloop(x) => { run p <- sectWords[<](x); become cong(unaround, p) }
  }
}

/// Winding undoes spinning at every count: the other round trip, by
/// induction over the presented integers, a successor carried along the
/// model's `turn` and a predecessor along its `unturn`.
@[ checks ]
def rec retrWords(n : Int) -> -F Path(Int, windWords(spinWords(n)), n) {
  case n {
    Z => return here(Z),
    S(x) => { run p <- retrWords[<](x); become cong(Winding.turn, p) },
    P(x) => { run p <- retrWords[<](x); become cong(Winding.unturn, p) }
  }
}

/// The loop's words and the presented integers are equivalent, by
/// `windWords` and `spinWords` with the two round trips at a variable (the
/// book's Theorem 8.1.9, one stratum down). The later entries read `to` and
/// `back`, so the record is their dependent pairs nested to the right, and
/// its value nests the same way: `sectWords` and `retrWords` are checked at
/// the types the record states once `to` is `windWords` and `back` is
/// `spinWords`.
@[ checks ]
def wordsWinding : #{to : +U (Words -> -F Int), back : +U (Int -> -F Words), sect : (c : Words) => Path(Words, back(to(c)), c), retr : (n : Int) => Path(Int, to(back(n)), n)} ;
def wordsWinding = #{windWords, #{spinWords, #{sectWords, retrWords}}} ;
