// The circle as a group under rotation, after cubical Agda's
// `Cubical/HITs/S1/Base.agda` and `S1/Properties.agda`: the multiplication
// that rotates by the loop and its four inverse laws, every point's loop told
// apart from every point's reflexivity as functions, and the circle's
// universal property, maps out of it as a point with a loop.
// `circle-group.gandr` holds the loop space's group laws. A row the tree
// refuses today states the refusal it meets and the issue that holds it.
//
// Out of reach by design: `rotIsEquiv` needs equivalences as structure, and
// `invS¹Equiv` and `invS¹Path` univalence as well.

/// The type with no element.
data Empty : Type {}

/// The circle: one point and a loop at it, bound as `loop : Path(Circle,
/// Base, Base)`.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// The integers as a presented type: a successor and a predecessor that
/// cancel.
data Int : Type {
  Z : Int;
  S : (x : Int) --> Int;
  P : (x : Int) --> Int;
  rule S(P(x)) <=> x;
  rule P(S(x)) <=> x;
}

/// Every point's loop (cubical's `rotLoop`): the loop at the point, carried
/// along the loop by conjugation to itself.
@[ checks ]
def selfloop(x : Circle) -> -F Path(Circle, x, x) {
  case x {
    Base => loop
  }
}

/// Every point's reflexivity.
@[ checks ]
def selfrefl(x : Circle) -> -F Path(Circle, x, x) {
  case x {
    Base => here(Base)
  }
}

/// The circle's flip (cubical's `invLooper`): the point to itself and the
/// loop to its inverse.
@[ checks ]
def invLooper(x : Circle) -> -F Circle {
  case x {
    Base => Base,
    loop => back(loop)
  }
}

/// The circle's multiplication (cubical's `_·_`, the book's § 8.5.2 μ): the
/// point is the unit, and the loop rotates the other argument by its own
/// loop. A non-dependent case whose loop arm answers `Path(Circle, b, b)`.
@[ checks ]
def mul(a : Circle, b : Circle) -> -F Circle {
  case a {
    Base => b,
    loop => selfloop(b)
  }
}

/// The unit squared: `mul(Base, Base)` computes the point without spelling
/// it, so the path from it to itself is the circle's words, and reflexivity
/// at the point inhabits it (#485).
@[ checks ]
def unitSquared : Path(Circle, mul(Base, Base), mul(Base, Base)) ;
def unitSquared = here(Base) ;

/// Rotating by `b` and back is the identity (cubical's `rotInv-1`, `b · a ·
/// invLooper b ≡ a`, `_·_` associating to the left). The obligation over `a`
/// holds `b` at its point, where `mul(Base, a)` is `a` and the loop moves
/// through `mul`'s second argument as itself; the one over `b` moves it
/// through both of the outer `mul`'s arguments, the loop then its inverse.
/// The square of the two loops is not owed: the paths of the circle are its
/// words, a set (#464).
@[ checks ]
def rotInv1(a : Circle, b : Circle) -> -F Path(Circle, mul(mul(b, a), invLooper(b)), a) {
  case a {
    Base => case b {
      Base => here(Base)
    }
  }
}

/// Rotating back by `b` and forth is the identity (cubical's `rotInv-2`),
/// held as `rotInv1` is.
@[ checks ]
def rotInv2(a : Circle, b : Circle) -> -F Path(Circle, mul(mul(invLooper(b), a), b), a) {
  case a {
    Base => case b {
      Base => here(Base)
    }
  }
}

/// Dividing by `b` after it undoes it (cubical's `rotInv-3`), held as
/// `rotInv1` is.
@[ checks ]
def rotInv3(a : Circle, b : Circle) -> -F Path(Circle, mul(b, invLooper(mul(invLooper(a), b))), a) {
  case a {
    Base => case b {
      Base => here(Base)
    }
  }
}

/// Dividing by `b` before it undoes it (cubical's `rotInv-4`), held as
/// `rotInv1` is.
@[ checks ]
def rotInv4(a : Circle, b : Circle) -> -F Path(Circle, mul(invLooper(mul(b, invLooper(a))), b), a) {
  case a {
    Base => case b {
      Base => here(Base)
    }
  }
}

/// The loop is not the empty word (`circle-apart.gandr`, the book's Lemma
/// 6.4.1).
@[ checks ]
def loop_apart(e : Path(Path(Circle, Base, Base), loop, here(Base))) -> -F Empty {
  case e {}
}

/// A loop at every point, evaluated at the point.
@[ checks ]
def atBase(f : +U ((x : Circle) -> -F Path(Circle, x, x))) -> -F Path(Circle, Base, Base) {
  f(Base)
}

/// Every point's loop is not every point's reflexivity (the book's Lemma
/// 6.4.2, cubical's `rotLoop` against `refl`): a path between the two
/// functions, evaluated at the point, would make the loop the empty word.
@[ checks ]
def distinct(e : Path(+U ((x : Circle) -> -F Path(Circle, x, x)), selfloop, selfrefl)) -> -F Empty {
  loop_apart(cong(atBase, e))
}

/// A map out of the circle is its point and the loop's image (the forward
/// half of cubical's `IsoFunSpaceS¹`, `S1/Properties.agda`). The record binds
/// the point's call before the loop's image is checked, and the image's type
/// reads the point through what that call returns.
@[ checks ]
def toLoop(f : +U[ω] (Circle -> -F Int)) -> -F (#{point : Int, around : Path(Int, point, point)}) {
  #{f(Base), cong(f, loop)}
}

/// A point and a loop at it make a map out of the circle, at a point of it: a
/// non-dependent case whose loop arm is the given loop (#388).
@[ checks ]
def fromLoopAt(x : Int, p : Path(Int, x, x), c : Circle) -> -F Int {
  case c {
    Base => x,
    loop => p
  }
}

/// A point and a loop at it make a map out of the circle (the backward half
/// of `IsoFunSpaceS¹`), curried: from the record, the point's projection is
/// bound before the loop's type reads it, as in `toLoop`.
@[ checks ]
def fromLoop(x : Int, p : Path(Int, x, x)) -> -F (+U[ω] (Circle -> -F Int)) {
  thunk { fn (c) { fromLoopAt(x, p, c) } }
}
