// A function's action on paths, the HoTT book's Lemma 2.2.1 (`ap`), at a
// function whose result is a suspended computation: `cong` carries a path
// between integers to one between the thunks the function returns.

/// An integer added to itself.
@[ checks, form(explicit) ]
def double(x: Integer) -> -F Integer {
  become x + x
}

/// Doubling, suspended.
@[ checks ]
def delay(x: Integer) -> -F (+U (-F Integer)) {
  return thunk { become double(x) }
}

/// Reflexivity at a suspended doubling, written out.
@[ checks ]
def delayed(a: Integer) -> -F Path(
  +U (-F Integer),
  thunk { become double(a) },
  thunk { become double(a) }
) {
  return here(thunk { become double(a) })
}

/// A path between integers carried along the suspended doubling.
@[ checks ]
def cong_delay(a: Integer, b: Integer, p: Path(Integer, a, b)) -> -F Path(
  +U (-F Integer),
  delay(a),
  delay(b)
) {
  become transport(\c. Path(+U (-F Integer), delay(a), delay(c)), p, here(delay(a)))
}

/// Reflexivity at four carried along the suspended doubling by a run.
@[ checks ]
def delayed_four() -> -F Path(+U (-F Integer), delay(4), delay(4)) {
  become cong_delay(4, 4, here(4))
}
