// Function extensionality, the HoTT book's § 2.9 (`funext`), one order up:
// two functionals that agree at every function are one path, whether a body
// binds its call's result or returns it, and two functionals that read a
// function at different arguments are not.

/// A function at truth.
@[ checks ]
def at_truth(f : +U[ω] (+{Unit, Unit} -> -F +{Unit, Unit})) -> -F +{Unit, Unit} {
  become f(+{.0 = unit})
}

/// A function at truth, its result bound and returned.
@[ checks ]
def through(f : +U[ω] (+{Unit, Unit} -> -F +{Unit, Unit})) -> -F +{Unit, Unit} {
  run b <- at_truth(f);
  return b
}

/// A function at falsity.
@[ checks ]
def at_falsity(f : +U[ω] (+{Unit, Unit} -> -F +{Unit, Unit})) -> -F +{Unit, Unit} {
  become f(+{.1 = unit})
}

/// A function applied twice from truth, the second call in tail position.
@[ checks ]
def applied_twice(f : +U[ω] (+{Unit, Unit} -> -F +{Unit, Unit})) -> -F +{Unit, Unit} {
  run b <- f(+{.0 = unit});
  become f(b)
}

/// A function applied twice from truth, both results bound.
@[ checks ]
def twice_bound(f : +U[ω] (+{Unit, Unit} -> -F +{Unit, Unit})) -> -F +{Unit, Unit} {
  run b <- f(+{.0 = unit});
  run c <- f(b);
  return c
}

/// A functional is a path to itself.
@[ checks ]
def reflexive : Path(+U[ω] (+U[ω] (+{Unit, Unit} -> -F +{Unit, Unit}) -> -F +{Unit, Unit}), at_truth, at_truth) ;
def reflexive = funext(at_truth, at_truth) ;

/// Binding the result and returning it agree at every function.
@[ checks ]
def unfolded : Path(+U[ω] (+U[ω] (+{Unit, Unit} -> -F +{Unit, Unit}) -> -F +{Unit, Unit}), at_truth, through) ;
def unfolded = funext(at_truth, through) ;

/// The two spellings of applying twice agree at every function.
@[ checks ]
def nested : Path(+U[ω] (+U[ω] (+{Unit, Unit} -> -F +{Unit, Unit}) -> -F +{Unit, Unit}), applied_twice, twice_bound) ;
def nested = funext(applied_twice, twice_bound) ;

/// Reading a function at truth and at falsity differ at some function.
@[ refuses("PointwiseDistinct") ]
def elsewhere : Path(+U[ω] (+U[ω] (+{Unit, Unit} -> -F +{Unit, Unit}) -> -F +{Unit, Unit}), at_truth, at_falsity) ;
def elsewhere = funext(at_truth, at_falsity) ;
