module Schema {
  type V1 = #{String, Integer};
  type V2 = #{Integer, String};
  type V3 = #{+{Unit, Unit}, Integer, String};
  @[ checks ]
  def toV2(record : V1) -> -F V2 {
    case record {
      #{name, age} => return #{age, name}
    }
  }
  @[ checks ]
  def toV3(record : V2) -> -F V3 {
    case record {
      #{age, name} => return #{+{.1 = unit}, age, name}
    }
  }
  @[ checks ]
  def first : Flow(Type, V1, V2) ;
  def first = forward(toV2) ;
  @[ checks ]
  def second : Flow(Type, V2, V3) ;
  def second = forward(toV3) ;
  @[ checks ]
  def kept : Flow(Type, V1, V1) ;
  def kept = stay(V1) ;
  @[ checks ]
  def early() -> -F Flow(Type, V1, V2) {
    become kept then first
  }
  @[ checks ]
  def both() -> -F Flow(Type, V1, V3) {
    run start <- early() ;
    become start then second
  }
  @[ checks ]
  def moved(record : V1) -> -F V3 {
    run along <- both() ;
    become ride(\X. X, along, record)
  }
  @[ runs("(+{.1 = unit}, 30, \"ada\")") ]
  def latest : +U (-F V3) ;
  def latest = thunk { become moved(#{"ada", 30}) } ;
}
