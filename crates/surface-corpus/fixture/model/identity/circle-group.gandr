// The circle's loop space as a group, after the group-law half of cubical
// Agda's `Cubical/HITs/S1/Base.agda`: spinning as a map of sums, winding as
// one, and the loops commuting. `circle.gandr` holds the equivalence
// `winding` these laws read through; this source restates the declarations
// it uses, as every corpus source does. `int-sum.gandr` holds the integers'
// sum and its laws, and `circle-rotation.gandr` the circle's multiplication.
// Where cubical fills a cube by `hcomp`, a law here is conversion on words or
// `cong`. A row the tree refuses today states the refusal it meets and the
// issue that holds it.
//
// Out of reach by design: `ΩS¹≡ℤ`, the loops equal to the integers as types,
// needs univalence; `isSetΩS¹` and `toPropElim` need the h-level ladder;
// `basedΩS¹ x ≡ ℤ` at every point needs equivalences as structure.

/// The circle: one point and a loop at it, bound as `loop : Path(Circle,
/// Base, Base)`.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// The integers as a presented type: a successor and a predecessor that
/// cancel.
data Int : Type {
  Z : Int;
  S : (x : Int) --> Int;
  P : (x : Int) --> Int;
  rule S(P(x)) <=> x;
  rule P(S(x)) <=> x;
}

/// The winding number: a loop counts one up, its inverse one down.
def rec wind(p : Path(Circle, Base, Base)) -> -F Int {
  case p {
    here => Z,
    loop ∷ q => S(wind[<](q)),
    back(loop) ∷ q => P(wind[<](q))
  }
}

/// Spinning a count: a successor is one more loop, a predecessor one more
/// inverse.
def rec spin(n : Int) -> -F Path(Circle, Base, Base) {
  case n {
    Z => here(Base),
    S(x) => loop ∷ spin[<](x),
    P(x) => back(loop) ∷ spin[<](x)
  }
}

/// One loop more.
def loopOn(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  loop ∷ p
}

/// One inverse loop more.
def unloopOn(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  back(loop) ∷ p
}

/// Spinning undoes winding at every loop (cubical's `decodeEncode` at the
/// point), by induction over the words.
def rec sect(p : Path(Circle, Base, Base)) -> -F Path(Path(Circle, Base, Base), spin(wind(p)), p) {
  case p {
    here => here(here(Base)),
    loop ∷ q => cong(loopOn, sect[<](q)),
    back(loop) ∷ q => cong(unloopOn, sect[<](q))
  }
}

/// One successor more.
def up(n : Int) -> -F Int {
  S(n)
}

/// One predecessor more.
def down(n : Int) -> -F Int {
  P(n)
}

/// The sum of two integers (cubical's `_+_` on `ℤ`), by recursion on the
/// second. It respects `Int`'s rules: at `S(P(x))` it builds `S(P(plus(a,
/// x)))`, which the first rule reads as `plus(a, x)`.
@[ checks ]
def rec plus(a : Int, b : Int) -> -F Int {
  case b {
    Z => a,
    S(x) => S(plus[<](a, x)),
    P(x) => P(plus[<](a, x))
  }
}

/// Spinning a successor is one loop more (cubical's `intLoop-sucℤ`), by
/// computation.
@[ checks ]
def spinUp(n : Int) -> -F Path(Path(Circle, Base, Base), spin(S(n)), loop ∷ spin(n)) {
  here(loop ∷ spin(n))
}

/// Spinning a predecessor is one inverse loop more (cubical's
/// `intLoop-predℤ`), by computation.
@[ checks ]
def spinDown(n : Int) -> -F Path(Path(Circle, Base, Base), spin(P(n)), back(loop) ∷ spin(n)) {
  here(back(loop) ∷ spin(n))
}

/// Spinning a sum is composing the spins (cubical's `intLoop-hom`), by
/// induction on the second summand. The composite of two open words is not
/// written without a stated type (#423), nor does it compute (#422).
@[ refuses("OutOfFragment") ]
def rec spinHom(a : Int, b : Int) -> -F Path(Path(Circle, Base, Base), spin(plus(a, b)), spin(a) then spin(b)) {
  case b {
    Z => here(spin(a)),
    S(x) => cong(loopOn, spinHom[<](a, x)),
    P(x) => cong(unloopOn, spinHom[<](a, x))
  }
}

/// Winding a composite is summing the windings (cubical's `winding-hom`), by
/// induction on the first loop. Held as `spinHom` is (#423, #422).
@[ refuses("OutOfFragment") ]
def rec windHom(p : Path(Circle, Base, Base), q : Path(Circle, Base, Base)) -> -F Path(Int, wind(p then q), plus(wind(p), wind(q))) {
  case p {
    here => here(wind(q)),
    loop ∷ r => cong(up, windHom[<](r, q)),
    back(loop) ∷ r => cong(down, windHom[<](r, q))
  }
}

/// The sum commutes; restated from `int-sum.gandr`, where its proof waits on
/// #423 and #427.
@[ owes(1) ]
def plusComm : (a : Int, b : Int) => Path(Int, plus(a, b), plus(b, a)) ;

/// The loops commute (cubical's `comm-ΩS¹`): each composite is the spin of
/// its winding by `sect`, the windings sum by `windHom`, and the sums commute
/// by `plusComm`. Held by the rows it reads (#422, #423, #427).
@[ refuses("OutOfFragment") ]
def comm(p : Path(Circle, Base, Base), q : Path(Circle, Base, Base)) -> -F Path(Path(Circle, Base, Base), p then q, q then p) {
  back(sect(p then q)) then cong(spin, windHom(p, q)) then cong(spin, plusComm(wind(p), wind(q))) then back(cong(spin, windHom(q, p))) then sect(q then p)
}

/// Three loops spun and wound count three (cubical's `test-winding-pos`).
@[ runs("S(S(S(Z)))") ]
def windThree : +U (-F Int) ;
def windThree = thunk { wind(spin(S(S(S(Z))))) } ;

/// Two inverse loops spun and wound count minus two (cubical's
/// `test-winding-neg`).
@[ runs("P(P(Z))") ]
def windMinusTwo : +U (-F Int) ;
def windMinusTwo = thunk { wind(spin(P(P(Z)))) } ;
