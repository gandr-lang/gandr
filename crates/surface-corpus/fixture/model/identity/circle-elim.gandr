// Eliminating the circle: a case over it reads its point, and the loop at the
// point is owed. A dependent case carries its answer at the point along the
// loop back to itself, by conversion, or supplies that path as a loop arm; a
// non-dependent case maps the loop to reflexivity unless a loop arm chooses
// its image. Transport along a word computes as the book's § 2.11 states it:
// in a family of paths it composes on the side the endpoint varies, in a
// constant family it is the identity, and in a family running its point
// through a map it is the map's image of the word. `then`, `back` and `cong`
// stand bare where no path type is written: each reads its path's type off
// the words it acts on.

// The circle, the integers, every point's loop and reflexivity, and the flip.
import "./circle-base.gandr" ;

/// The flip twice is the identity, at every point: the answer at `Base` is
/// reflexivity, and carried along the loop it is conjugated by the flip's
/// image of its image, the loop again.
@[ checks ]
def involutive(x : Circle) -> -F Path(Circle, invLooper(invLooper(x)), x) {
  case x {
    Base => here(Base)
  }
}

/// The map that collapses the circle to its point: no loop arm, so the loop's
/// image is reflexivity.
@[ checks ]
def collapse(x : Circle) -> -F Circle {
  case x {
    Base => Base
  }
}

/// The collapse's image of the loop is reflexivity: `cong` reads its path's
/// type off the loop and the collapse's written result, so it stands bare in
/// the type.
@[ checks ]
def collapsed_loop : Path(Path(Circle, Base, Base), cong(collapse, loop), here(Base)) ;
def collapsed_loop = here(here(Base)) ;

/// The loop twice around, composed with no path type written at the
/// composite: it is a path from the point the first loop leaves to the point
/// the second reaches.
@[ checks ]
def two : Path(Circle, Base, Base) ;
def two = loop then loop ;

/// The inverse of the composite, read off the composite's own path type.
@[ checks ]
def undone : Path(Circle, Base, Base) ;
def undone = back(loop then loop) ;

/// A word written where the path stands is followed as the path it is: the
/// loop composed with the empty word at the point is the loop.
@[ checks ]
def joined : Path(Path(Circle, Base, Base), loop then here(Base), loop) ;
def joined = here(loop) ;

/// The inverse of the loop's one-letter word, written out, is the loop's
/// inverse.
@[ checks ]
def unwound_word : Path(Path(Circle, Base, Base), back(loop ∷ here(Base)), back(loop)) ;
def unwound_word = here(back(loop)) ;

/// Transport in a family of paths from the point moves the endpoint: it
/// post-composes with the loop.
@[ checks ]
def moved : Path(
  Path(Circle, Base, Base),
  here(Base) then loop,
  loop
) ;
def moved = here(loop) ;

/// Transport in the family of loops at each point conjugates by the loop,
/// which fixes the loop.
@[ checks ]
def conjugated : Path(
  Path(Circle, Base, Base),
  transport(\x. Path(Circle, x, x), loop, loop),
  loop
) ;
def conjugated = here(loop) ;

/// Transport in a constant family is the identity.
@[ checks ]
def constant : Path(Int, transport(\x. Int, loop, Z), Z) ;
def constant = here(Z) ;

/// Transport in a family running its point through the flip is the flip's
/// image of the loop, its inverse: the family's transport is its `cong`.
@[ checks ]
def flipped : Path(
  Path(Circle, Base, Base),
  transport(\x. Path(Circle, Base, invLooper(x)), loop, here(Base)),
  back(loop) ∷ here(Base)
) ;
def flipped = here(back(loop) ∷ here(Base)) ;
