// Reflexivity, the HoTT book's § 1.12 (`refl`), written `here`: a path
// formed at a point, read at its synthesised type or checked against a
// written one, and handed through a function as a value.

/// Reflexivity at four, its type synthesised.
@[ checks ]
def four_eq_four = here(4);

/// A path between four and itself, given back.
@[ checks ]
def cast(p: Path(Integer, 4, 4)) -> -F(Path(Integer, 4, 4)) {
  return p
}

/// Reflexivity at four, checked against its written type.
@[ checks ]
def checked : Path(Integer, 4, 4);
def checked = here(4);

/// Reflexivity at four handed through `cast` by a run.
@[ checks ]
def cast_four : +U (-F Path(Integer, 4, 4));
def cast_four = thunk { become cast(four_eq_four) };

/// The value a parameter of any type takes, given back.
@[ checks ]
def pick(t : Type, x : t) -> -F t {
  return x
}

/// A path type written as `pick`'s type argument is the code of the type it
/// spells, not a constructor (#539).
@[ checks ]
def picked : +U (-F Path(Integer, 4, 4));
def picked = thunk { become pick(Path(Integer, 4, 4), here(4)) };
