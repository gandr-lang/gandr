// Transport, the HoTT book's § 2.3 (`transport`), along reflexivity at a
// motive whose fibres are path types: the element it returns is a path, an
// element of another type is none, and transport along the path it returns
// runs it first. Along reflexivity, at a path-type motive and in the
// universe, transport keeps the value, by conversion and by a run.

/// A reflexive transport at a path-type motive returns a path.
@[ checks ]
def moved_end : Path(
  Path(Integer, 2, 2),
  transport(\x. Path(Integer, x, x), here(2), here(2)),
  here(2)
) ;
def moved_end = here(here(2)) ;

/// A reflexive transport at a path-type motive returns its path, by a run: the
/// path runs as its two maps, both the identity.
@[ runs("(thunk { fn (a) { a } }, thunk { fn (a) { a } })") ]
def moved_end_run : +U (-F Path(Integer, 2, 2)) ;
def moved_end_run = thunk { transport(\x. Path(Integer, x, x), here(2), here(2)) } ;

/// A transported unit is no path between integers.
@[ refuses("TypeMismatch") ]
def unit_end : Path(Path(Integer, 2, 2), transport(\x. Unit, here(2), unit), here(2)) ;
def unit_end = here(here(2)) ;

/// Transport along the path a reflexive transport returns, in the universe,
/// is the identity: the inner transport runs to `here(a)` first (#649).
@[ checks ]
def along_returned(
  a : Type,
  x : a
) -> -F Path(a, transport(\X. X, transport(\c. Path(Type, c, a), here(a), here(a)), x), x) {
  return here(x)
}

/// Transport along reflexivity in the universe keeps the value, by
/// conversion.
@[ checks ]
def along_here : Path(Integer, transport(\X. X, here(Integer), 2), 2) ;
def along_here = here(2) ;

/// Transport along reflexivity in the universe keeps the value, by a run.
@[ runs("2") ]
def along_here_run : +U (-F Integer) ;
def along_here_run = thunk { transport(\X. X, here(Integer), 2) } ;
