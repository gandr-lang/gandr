// Transport back along `ua`: the cubical case table of Cohen, Coquand, Huber
// and Mörtberg, _Cubical Type Theory: a constructive interpretation of the
// univalence axiom_ (TYPES 2015, arXiv:1611.02108), § 4.5, read at the
// universe. `back(ua(e))` is the transport of `here(a)` along `ua(e)` in `y.
// Path(Type, y, a)`, and transport along it applies the record's left
// inverse `g`.

// The circle, the presented integers, the winding number and spinning.
import "./circle-base.gandr" ;
// Transport forward and back along a path between types.
import "./univalence.gandr" ;

/// Transport back along `ua` applies the record's left inverse.
@[ checks ]
def backBeta(
  a : Type,
  b : Type,
  t : a => b,
  g : b => a,
  s : (x : a) => Path(a, g(t(x)), x),
  h : b => a,
  r : (y : b) => Path(b, t(h(y)), y),
  y : b
) -> -F Path(a, bwdAlong(a, b, ua((t, ((g, s), (h, r)))), y), g(y)) {
  here(g(y))
}

/// Transport back along a path from the loops at the point to the integers.
@[ checks ]
def loopsBack(
  p : Path(Type, Path(Circle, Base, Base), Int),
  y : Int
) -> -F Path(Circle, Base, Base) {
  transport(\X. X, back(p), y)
}

/// Two carried back along the loops' path is the word of two loops, by a run.
@[ runs("loop ∷ loop ∷ here(Base)") ]
def backRun : () => Path(Circle, Base, Base) ;
def backRun = loopsBack(loopsAreIntegers, S(S(Z))) ;
