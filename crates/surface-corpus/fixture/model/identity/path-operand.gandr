// A derived path operation reads its operand's path type off what the
// operand is when its form does not spell one: a parameter by the type its
// binder writes, a call by the result its declaration writes, a recursive
// call by its own function's result, and `cong` over a parameter function by
// that function's written result, which may read the parameters before it.
// In a body and in a type alike, none of these needs a stated type (#423).
// The operations are the HoTT book's inverse and composite (Lemmas 2.1.1 and
// 2.1.2) and `ap` (Lemma 2.2.1).

// The circle and the free naturals.
import "./circle-base.gandr" ;

/// One successor more, the naturals' step for the paths a recursion builds.
@[ checks ]
def next(n : Nat) -> -F Nat {
  Succ(n)
}

/// A parameter's inverse, read at the parameter's written type, then the
/// parameter again.
@[ checks ]
def backThen(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  back(p) then p
}

/// A parameter composed in a type, and reflexivity at it (#423).
@[ checks ]
def stated(p : Path(Circle, Base, Base)) -> -F Path(
  Path(Circle, Base, Base),
  p then loop,
  p then loop
) {
  here(p then loop)
}

/// A loop walked twice.
@[ checks ]
def walkTwice(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  p then p
}

/// A call's inverse, read at the result `walkTwice` writes, then the loop.
@[ checks ]
def untwice(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  back(walkTwice(p)) then loop
}

/// A call composed in a type (#423).
@[ checks ]
def thrice(p : Path(Circle, Base, Base)) -> -F Path(
  Path(Circle, Base, Base),
  walkTwice(p) then p,
  walkTwice(p) then p
) {
  here(walkTwice(p) then p)
}

/// A call of a declaration whose own type holds a derived operation: that
/// type is read before the operation over it.
@[ checks ]
def unthrice(p : Path(Circle, Base, Base)) -> -F Path(
  Path(Circle, Base, Base),
  walkTwice(p) then p,
  walkTwice(p) then p
) {
  back(thrice(p))
}

/// A path the signature alone states.
@[ owes(1) ]
def stay : (a : Nat) => Path(Nat, a, a) ;

/// A call of a signature, read at the result it states.
@[ checks ]
def stayUp(a : Nat) -> -F Path(Nat, Succ(a), Succ(a)) {
  cong(next, stay(a)) then here(Succ(a))
}

/// A recursive call, read at its function's own result.
@[ checks ]
def rec still(b : Nat) -> -F Path(Nat, b, b) {
  case b {
    Zero => here(Zero),
    Succ(x) => cong(next, still[<](x)) then here(Succ(x))
  }
}

/// `cong` over a parameter function, read at the result its type writes.
@[ checks ]
def mapped(f : +U[ω] (Circle -> -F Nat)) -> -F Path(Nat, f(Base), f(Base)) {
  back(cong(f, loop))
}

/// `cong` at a parameter map whose type reads an earlier parameter, the type
/// it maps from: its result read where the operation stands (#546).
@[ checks ]
def mappedOver(b : Type, g : b => Nat, u : b, v : b, q : Path(b, u, v)) -> -F Path(
  Nat,
  g(v),
  g(u)
) {
  back(cong(g, q))
}

/// The same map into a type it reads, in a type and in a body (#546).
@[ checks ]
def mappedInto(a : Type, b : Type, g : b => a, u : b, v : b, q : Path(b, u, v)) -> -F Path(
  Path(a, g(u), g(v)),
  cong(g, q),
  cong(g, q)
) {
  here(cong(g, q))
}

/// A parameter of no path type gives no path to read.
@[ refuses("OutOfFragment") ]
def pointed(c : Circle) -> -F Path(Circle, Base, Base) {
  back(c) then loop
}
