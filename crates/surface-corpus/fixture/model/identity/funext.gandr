// Function extensionality, the HoTT book's § 2.9 (`funext`) and cubical
// Agda's `funExt`: two functions that agree at every argument are one path.
// At the booleans, negation twice is the identity, and negation once is not.

/// Negation on the booleans, `+{Unit, Unit}`.
@[ checks ]
def not(b : Unit + Unit) -> -F (Unit + Unit) {
  case b {
    +{.0 = u} => return +{.1 = u},
    +{.1 = u} => return +{.0 = u}
  }
}

/// Negation twice.
@[ checks ]
def not_not(b : Unit + Unit) -> -F (Unit + Unit) {
  run c <- not(b);
  become not(c)
}

/// The identity on the booleans.
@[ checks ]
def same(b : Unit + Unit) -> -F (Unit + Unit) {
  return b
}

/// Negation twice is the identity: they agree at both booleans.
@[ checks ]
def involution : Path(+U[ω] (Unit + Unit -> -F (Unit + Unit)), not_not, same) ;
def involution = funext(not_not, same) ;

/// Negation once is not the identity: they differ at a boolean.
@[ refuses("PointwiseDistinct") ]
def not_identity : Path(+U[ω] (Unit + Unit -> -F (Unit + Unit)), not, same) ;
def not_identity = funext(not, same) ;
