// The circle as the book states it: one point, one loop at it, and the loops
// at the point equivalent to the integers, `Path(Circle, Base, Base) ≃ Int`.
// The loop is a free invertible cell at the point, so the paths from the
// point to itself are the words over the loop and its inverse, with the two
// cancellations as rules: the lowering mints them, and `Path(Circle, Base,
// Base)` is that presented type. The integers are presented the same way, so
// the winding number folds the words into them, spinning folds them back, and
// both round trips are proved by induction over each presented type, with no
// interval and nothing owed. `loop-space.gandr` states the same mechanism one
// stratum down, on terms.

/// The circle: one point and a loop at it, bound as `loop : Path(Circle,
/// Base, Base)`.
data Circle : Type {
  Base : Circle;
  loop : Base <-> Base;
}

/// The integers as a presented type: a successor and a predecessor that
/// cancel.
data Int : Type {
  Z : Int;
  S : (x : Int) --> Int;
  P : (x : Int) --> Int;
  rule S(P(x)) ==> x;
  rule P(S(x)) ==> x;
}

/// The loop's word: one letter before the empty word.
@[ runs("loop ∷ here(Base)") ]
def once : +U (-F Path(Circle, Base, Base)) ;
def once = thunk { return loop } ;

/// `p` then `q`, `q` held fixed while `p` is taken apart, so it is written
/// with the fixed argument first.
def rec onto(q : Path(Circle, Base, Base), p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  case p {
    here => return q,
    loop ∷ r => { run s <- onto[<](q, r); return loop ∷ s },
    back(loop) ∷ r => { run s <- onto[<](q, r); return back(loop) ∷ s }
  }
}

/// Composition: `p` then `q`, by recursion on `p`.
def then(p : Path(Circle, Base, Base), q : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  become onto(q, p)
}

/// Reversal with an accumulator: the reversal of `p` answers the function
/// that puts `p`'s inverse before an accumulated word, each letter inverted on
/// its way to the front.
def rec rev(p : Path(Circle, Base, Base)) -> -F (Path(Circle, Base, Base) => Path(Circle, Base, Base)) {
  case p {
    here => return thunk { fn (acc) { return acc } },
    loop ∷ r => { run k <- rev[<](r); return thunk { fn (acc) { become k(back(loop) ∷ acc) } } },
    back(loop) ∷ r => { run k <- rev[<](r); return thunk { fn (acc) { become k(loop ∷ acc) } } }
  }
}

/// The inverse of a path: its reversal before the empty word.
def back(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  run k <- rev(p);
  become k(here(Base))
}

/// The inverse of the loop is the letter `back(loop)`.
@[ runs("back(loop) ∷ here(Base)") ]
def unwound : +U (-F Path(Circle, Base, Base)) ;
def unwound = thunk { become back(loop) } ;

/// The loop then its inverse is the empty word: the minted cancellation, read
/// by conversion.
@[ checks ]
def cancelled : Path(Path(Circle, Base, Base), then(loop, back(loop)), here(Base)) ;
def cancelled = here(here(Base)) ;

/// No rule identifies the loop with the empty word.
@[ refuses("EndpointMismatch") ]
def around_once : Path(Path(Circle, Base, Base), loop, here(Base)) ;
def around_once = here(here(Base)) ;

/// A case that tells the loop from its inverse, refused: `loop ∷ back(loop) ∷
/// here(Base)` is the empty word, which it would read as 1.
@[ refuses("RuleNotRespected") ]
def tell(p : Path(Circle, Base, Base)) -> -F Integer {
  case p {
    here => return 0,
    loop ∷ q => return 1,
    back(loop) ∷ q => return 2
  }
}

/// The winding number: a loop counts one up, its inverse one down. It respects
/// the cancellations by `Int`'s rules.
def rec wind(p : Path(Circle, Base, Base)) -> -F Int {
  case p {
    here => return Z,
    loop ∷ q => { run n <- wind[<](q); return S(n) },
    back(loop) ∷ q => { run n <- wind[<](q); return P(n) }
  }
}

/// Spinning a count: a successor is one more loop, a predecessor one more
/// inverse. It respects `Int`'s rules by the cancellations.
def rec spin(n : Int) -> -F Path(Circle, Base, Base) {
  case n {
    Z => return here(Base),
    S(x) => { run c <- spin[<](x); return loop ∷ c },
    P(x) => { run c <- spin[<](x); return back(loop) ∷ c }
  }
}

/// Winding twice around and spinning the count back returns the word
/// `then(loop, loop)` runs to.
@[ runs("loop ∷ loop ∷ here(Base)") ]
def round : +U (-F Path(Circle, Base, Base)) ;
def round = thunk { become spin(wind(then(loop, loop))) } ;

/// The composite the round trip returns.
@[ runs("loop ∷ loop ∷ here(Base)") ]
def twice : +U (-F Path(Circle, Base, Base)) ;
def twice = thunk { become then(loop, loop) } ;

/// Spinning two successors and winding the word counts two.
@[ runs("S(S(Z))") ]
def counted : +U (-F Int) ;
def counted = thunk { become wind(spin(S(S(Z)))) } ;

/// One loop more: the cons a path between words is carried along.
def loopOn(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  return loop ∷ p
}

/// One inverse loop more.
def unloopOn(p : Path(Circle, Base, Base)) -> -F Path(Circle, Base, Base) {
  return back(loop) ∷ p
}

/// Spinning undoes winding at every loop: the round trip at a variable, by
/// induction over the words. The result type reads the word the fold descends
/// on, so each arm answers it at its letter and the recursive call at the
/// rest: `sect[<](q)` relates `spin(wind(q))` to `q`, and carried along
/// `loopOn` it relates `loop ∷ spin(wind(q))`, which `spin(wind(loop ∷ q))`
/// runs to, to `loop ∷ q`. The case respects the cancellations: at `loop ∷
/// back(loop) ∷ q` the arms compose to `cong(loopOn, cong(unloopOn, p))`,
/// whose functions compose to the identity under the words' rules, so the
/// chain is `p` itself, the answer at `q`.
@[ checks ]
def rec sect(p : Path(Circle, Base, Base)) -> -F Path(Path(Circle, Base, Base), spin(wind(p)), p) {
  case p {
    here => return here(here(Base)),
    loop ∷ q => { run ih <- sect[<](q); become cong(loopOn, ih) },
    back(loop) ∷ q => { run ih <- sect[<](q); become cong(unloopOn, ih) }
  }
}

/// One successor more.
def up(n : Int) -> -F Int {
  return S(n)
}

/// One predecessor more.
def down(n : Int) -> -F Int {
  return P(n)
}

/// Winding undoes spinning at every count: the other round trip, by
/// induction over the presented integers, a successor carried along `up` and
/// a predecessor along `down`.
@[ checks ]
def rec retr(n : Int) -> -F Path(Int, wind(spin(n)), n) {
  case n {
    Z => return here(Z),
    S(x) => { run ih <- retr[<](x); become cong(up, ih) },
    P(x) => { run ih <- retr[<](x); become cong(down, ih) }
  }
}

/// The loops at the point and the presented integers are equivalent, by
/// `wind` and `spin` with the two round trips at a variable: the book's
/// `Path(Circle, Base, Base) ≃ Int`, with nothing owed. The later entries read
/// `to` and `back`, so the record is their dependent pairs nested to the
/// right, and its value nests the same way.
@[ checks ]
def winding : #{to : +U (Path(Circle, Base, Base) -> -F Int), back : +U (Int -> -F Path(Circle, Base, Base)), sect : (p : Path(Circle, Base, Base)) => Path(Path(Circle, Base, Base), back(to(p)), p), retr : (n : Int) => Path(Int, to(back(n)), n)} ;
def winding = #{wind, #{spin, #{sect, retr}}} ;
