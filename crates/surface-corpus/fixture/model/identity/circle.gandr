// The circle as the book states it: one point, one loop at it, and the loops
// at the point equivalent to the integers, `Path(Circle, Base, Base) ≃ Int`.
// The loop is a free invertible cell at the point, so the paths from the
// point to itself are the words over the loop and its inverse, with the two
// cancellations as rules: the lowering mints them, and `Path(Circle, Base,
// Base)` is that presented type. The integers are presented the same way, so
// the winding number folds the words into them, spinning folds them back, and
// both round trips are proved by induction over each presented type, with no
// interval and nothing owed. `loop-space.gandr` states the same mechanism one
// stratum down, on terms.
//
// The operations on paths are the book's own: `p then q`, `back(p)` and
// `cong(f, p)` stand bare, in a body and in a type, each reading its path's
// type off the words it acts on — the loop, a word, or another operation over
// one — and `cong` its codomain off the function's written result. Nothing
// here defines them or annotates them. The alternative, each operation
// written where a path type is stated, repeats what the words already say.
// Reversal: a cell between two distinct points, whose words spell neither
// endpoint, would need its operations' path type written again.

// The circle, the presented integers, the winding number and spinning with
// their round trips.
import "./circle-base.gandr" ;
// The quasi-inverse made bi-invertible, which the equivalence is.
import "./equivalence.gandr" ;

/// The loop's word: one letter before the empty word.
@[ runs("loop ∷ here(Base)") ]
def once : +U (-F Path(Circle, Base, Base)) ;
def once = thunk { loop } ;

/// The inverse of the loop is the letter `back(loop)`, by conversion.
@[ checks ]
def unwound : Path(Path(Circle, Base, Base), back(loop), back(loop) ∷ here(Base)) ;
def unwound = here(back(loop) ∷ here(Base)) ;

/// The loop then its inverse is the empty word: the minted cancellation, read
/// by conversion.
@[ checks ]
def cancelled : Path(Path(Circle, Base, Base), loop then back(loop), here(Base)) ;
def cancelled = here(here(Base)) ;

/// No rule identifies the loop with the empty word.
@[ refuses("EndpointMismatch") ]
def around_once : Path(Path(Circle, Base, Base), loop, here(Base)) ;
def around_once = here(here(Base)) ;

/// A case that tells the loop from its inverse, refused: `loop ∷ back(loop) ∷
/// here(Base)` is the empty word, which it would read as 1.
@[ refuses("RuleNotRespected") ]
def tell(p : Path(Circle, Base, Base)) -> -F Integer {
  case p {
    here => 0,
    loop ∷ q => 1,
    back(loop) ∷ q => 2
  }
}

/// Winding twice around and spinning the count back gives the word the
/// composite is, by conversion.
@[ checks ]
def round : Path(Path(Circle, Base, Base), spin(wind(loop then loop)), loop ∷ loop ∷ here(Base)) ;
def round = here(loop ∷ loop ∷ here(Base)) ;

/// The composite the round trip gives: the loop twice, by conversion.
@[ checks ]
def twice : Path(Path(Circle, Base, Base), loop then loop, loop ∷ loop ∷ here(Base)) ;
def twice = here(loop ∷ loop ∷ here(Base)) ;

/// Spinning two successors and winding the word counts two.
@[ runs("S(S(Z))") ]
def counted : +U (-F Int) ;
def counted = thunk { wind(spin(S(S(Z)))) } ;

/// The loops at the point and the presented integers are a quasi-inverse, by
/// `wind` and `spin` with the two round trips at a variable, nothing owed.
@[ checks ]
def windingIso : Path(Circle, Base, Base) ≅ Int ;
def windingIso = #{wind, #{spin, #{sect, retr}}} ;

/// The loops at the point and the presented integers are equivalent: the
/// book's `Path(Circle, Base, Base) ≃ Int`, the quasi-inverse made
/// bi-invertible, `spin` serving as both inverses. A value is a record, never
/// a call, so the equivalence is written as the record `isoToEquiv` builds.
@[ checks ]
def winding : Path(Circle, Base, Base) ≃ Int ;
def winding = #{wind, #{#{spin, sect}, #{spin, retr}}} ;

/// The equivalence is `isoToEquiv` at the quasi-inverse, by conversion.
@[ checks ]
def windingByIso : Path(
  Path(Circle, Base, Base) ≃ Int,
  winding,
  isoToEquiv(Path(Circle, Base, Base), Int, windingIso)
) ;
def windingByIso = here(winding) ;
