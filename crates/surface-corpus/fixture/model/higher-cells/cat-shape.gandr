// The shape of a category, after the HoTT book's Definition 9.1.1 (a
// precategory): objects, a hom-type between two of them, identities and
// composition with the unit and associativity laws as rules. Its model in
// types and functions meets every law by conversion, and a law may be
// proved by another law of the same type.

/// The category shape: a sort of morphisms dependent on the objects. Its
/// rules over the dependent sort are outside the fragment (#522).
@[ refuses("OutOfFragment") ]
sign CatShape {
  sort Ob : Type;
  sort Hom(dom: Ob, cod: Ob) : Type;

  oper id : (a : Ob) --> Hom(a, a);
  oper comp : (f : Hom(a, b), g : Hom(b, c)) --> Hom(a, c);

  rule unitL : comp(id(a), f) <=> f;
  rule unitR : comp(f, id(b)) <=> f;
  rule assoc : comp(comp(f, g), h) <=> comp(f, comp(g, h));
}

/// Types and the functions between them as a model of the category shape.
module SetoidCat : Model(CatShape) {
  type Ob = Type;
  type Hom(a : Ob, b : Ob) = +U[ω] (a -> -F b);

  /// The identity function at a type.
  @[ runs("fn (a) { fn (b) { b } }") ]
  def ident(t : Type, x : t) -> -F t { return x }

  /// Composition of two functions, applied.
  @[ runs("fn (a) { fn (b) { fn (c) { fn (d) { fn (e) { fn (f) { run g <- d(f) ; e(g) } } } } } }") ]
  def compose(
    t : Type,
    u : Type,
    v : Type,
    f : +U[ω] (t -> -F u),
    g : +U[ω] (u -> -F v),
    x : t
  ) -> -F v {
    run y <- f(x);
    become g(y)
  }

  /// The interface's identity runs to a function that applies `ident`, which
  /// the signature hides, so the run is opaque at the model.
  @[ runs("⟨opaque at SetoidCat⟩ : +U ((a : Type) -> -F (a => a))") ]
  def id(t : Type) -> -F (+U[ω] (t -> -F t)) { return thunk { become ident(t) } }

  /// Composition likewise runs through the hidden `compose`.
  @[ runs("⟨opaque at SetoidCat⟩ : +U ((a : Type) -> (b : Type) -> (c : Type) -> (a => b) -> (b => c) -> -F (a => c))") ]
  def comp(
    t : Type,
    u : Type,
    v : Type,
    f : +U[ω] (t -> -F u),
    g : +U[ω] (u -> -F v)
  ) -> -F (+U[ω] (t -> -F v)) {
    return thunk { become compose(t, u, v, f, g) }
  }

  /// The left unit law, by conversion.
  @[ checks ]
  def unitL(p : Type, q : Type, f : +U[ω] (p -> -F q)) -> -F Path(
    (+U[ω] (p -> -F q)),
    comp(p, p, q, id(p), f),
    f
  ) {
    return here(f)
  }

  /// The right unit law, by conversion.
  @[ checks ]
  def unitR(p : Type, q : Type, f : +U[ω] (p -> -F q)) -> -F Path(
    (+U[ω] (p -> -F q)),
    comp(p, q, q, f, id(q)),
    f
  ) {
    return here(f)
  }

  /// Associativity, by conversion through `compose`.
  @[ checks ]
  def assoc(
    p : Type,
    q : Type,
    r : Type,
    s : Type,
    f : +U[ω] (p -> -F q),
    g : +U[ω] (q -> -F r),
    h : +U[ω] (r -> -F s)
  ) -> -F Path(
    (+U[ω] (p -> -F s)),
    comp(p, r, s, comp(p, q, r, f, g), h),
    comp(p, q, s, f, comp(q, r, s, g, h))
  ) {
    return here(thunk { become compose(p, q, s, f, thunk { become compose(q, r, s, g, h) }) })
  }

  /// The left unit law stated by the right one, whose type converts to it.
  @[ checks ]
  def unitLFromR : (p : Type, q : Type, f : +U[ω] (p -> -F q)) => Path(
    (+U[ω] (p -> -F q)),
    comp(p, p, q, id(p), f),
    f
  ) ;
  def unitLFromR = unitR ;

  /// The left unit law by either law, chosen by a boolean.
  @[ checks ]
  def unitLEither(p : Type, q : Type, f : +U[ω] (p -> -F q), b : Bool) -> -F Path(
    (+U[ω] (p -> -F q)),
    comp(p, p, q, id(p), f),
    f
  ) {
    case b {
      true => become unitL(p, q, f),
      false => become unitR(p, q, f)
    }
  }
}
