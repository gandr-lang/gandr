@[ refuses("IdentityAtOpenType") ]
def path_var(a : Type, x : a) -> -F Path(a, x, x) {
  return here(x)
}

@[ checks ]
def path_fun(f : Integer => Integer) -> -F Path(Integer => Integer, f, f) {
  return here(f)
}

@[ checks ]
def path_app(n : Integer) -> -F Path(Integer, n + 1, n + 1) {
  return here(n + 1)
}

@[ checks ]
data Ix(n : Integer) : Type {
  MkIx : Ix(n);
}

@[ checks ]
def ix_id(n : Integer, w : Ix(n)) -> -F Ix(n) {
  return w
}

@[ checks ]
def ix_ctor(w : Ix(1)) -> -F Ix(1) {
  return w
}
