// Second-order rules. A rule whose right side applies a variable that a
// binding port of its left side binds instantiates it: `t(u)` substitutes `u`
// for the variable `t`'s port binds, one argument per bound variable (Klop,
// van Oostrom and van Raamsdonk, _Combinatory reduction systems: introduction
// and survey_, TCS 121, 1993). The rules terminate by the higher-order
// recursive path order (Jouannaud and Rubio, _The higher-order recursive path
// ordering_, LICS 1999): the instantiation is below an application that holds
// the variable and every argument directly. A second-order rule overlapping no
// rule leaves confluence to the first-order rules' pairs (Mayr and Nipkow,
// _Higher-order rewrite systems and their confluence_, TCS 192, 1998).

/// ζ: `let` binds a term over its body, and its rule substitutes the bound
/// term into the body.
@[ checks ]
theory Let {
  sort Tm : Type+;
  oper let : (u : Tm, t : pi+ (x : Tm) . Tm) --> Tm;
  rule zeta : let(u, t) <=> t(u);
}

/// A body binding two terms is instantiated at two arguments, outermost
/// binder first.
@[ checks ]
theory LetPair {
  sort Tm : Type+;
  oper let2 : (u : Tm, v : Tm, t : pi+ (x : Tm) . pi+ (y : Tm) . Tm) --> Tm;
  rule zeta2 : let2(u, v, t) <=> t(u, v);
}

/// ζ beside first-order rules whose pair parts: completion joins `f`'s two
/// rules as it would without ζ, which overlaps neither.
@[ checks ]
theory LetBeside {
  sort Tm : Type+;
  oper zero : () --> Tm;
  oper one : () --> Tm;
  oper f : (a : Tm) --> Tm;
  oper let : (u : Tm, t : pi+ (x : Tm) . Tm) --> Tm;
  rule zeta : let(u, t) <=> t(u);
  rule fZero : f(a) <=> zero();
  rule fOne : f(a) <=> one();
}

/// ζ's right side is the instantiation of `t`, which the presentation keeps
/// as an `Inst` node.
@[ runs("1") ]
def instantiates : () => Integer ;
def instantiates = thunk {
  case Let {
    Presents(sorts, opers, rules) => case rules {
      Rule(name, left, right, rest) => case right {
        Inst(variable, arguments) => 1,
        _ => 0
      },
      _ => 0
    },
    _ => 0
  }
} ;
