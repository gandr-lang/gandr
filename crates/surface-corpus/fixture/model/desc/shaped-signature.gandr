// A signature stated over a finite shape. The member `shape Square : 4 { … }`
// names the shape the signature's cells are stated over and the faces of it a
// cell may be fixed on, each the subshape of the points it lists (Schönlank,
// Nuyts and Devriese, _Towards FaceTT_, TYPES 2026: the shape parameter `ft`
// and its subshapes). The member's spelling is provisional. The block's value
// codes the shape at the head of its sort chain, so a program reads it back by
// `case`.

/// Cells over a square of four corners, numbered row by row: its left and
/// right sides, its top and bottom, one corner and the empty face.
@[ checks ]
theory Cells {
  shape Square : 4 {
    left = {0, 2};
    right = {1, 3};
    top = {0, 1};
    bottom = {2, 3};
    corner = {0};
    none = {};
  };
  sort Cell : Type;
  oper fill : () --> Cell;
}

/// Structural recursion over a face chain: one per `Face`.
@[ checks ]
def rec faces(chain : Theory) -> -F Integer {
  case chain {
    Face(name, points, rest) => { run r <- faces[<](rest); return r + 1 },
    _ => return 0
  }
}

/// The square heads the sort chain of `Cells`, with its six faces.
@[ runs("6") ]
def squareFaces : +U (-F Integer) ;
def squareFaces = thunk {
  case Cells {
    Presents(sorts, opers, rules) => case sorts {
      Shape(name, size, chain, rest) => become faces(chain),
      _ => return 0
    },
    _ => return 0
  }
} ;
