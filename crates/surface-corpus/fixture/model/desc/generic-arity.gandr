@[ checks ]
sign Monoid {
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);
}

@[ checks ]
def rec operations(chain : Sig) -> -F Integer {
  case chain {
    Oper(name, inputs, outputs, rest) => { run r <- operations[<](rest); return r + 1 },
    _ => return 0
  }
}

@[ checks ]
def arity(presented : Sig) -> -F Integer {
  case presented {
    Presents(sorts, opers, rules) => become operations(opers),
    _ => return 0
  }
}

@[ runs("2") ]
def counted : +U (-F Integer) ;
def counted = thunk { become arity(Monoid) } ;

@[ checks ]
def counted_at(presented : Sig) -> -F Type {
  case presented {
    Presents(sorts, opers, rules) => return Integer,
    _ => return Unit
  }
}

@[ runs("2") ]
def typed : +U (-F counted_at(Monoid)) ;
def typed = thunk { become arity(Monoid) } ;

@[ checks ]
def kept(presented : Sig, n : counted_at(presented)) -> -F counted_at(presented) {
  return n
}

@[ refuses("TypeMismatch") ]
def text : counted_at(Monoid) ;
def text = "two" ;
