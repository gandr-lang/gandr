// Second-order signatures written as their descriptions render them. A sort
// classified `Type+` is representable, and a port `t : pi+ (x : S) . T` binds
// a variable of the representable sort `S` over `T` (Kaposi and Xie,
// _Second-Order Generalised Algebraic Theories_, FSCD 2024,
// doi:10.4230/LIPIcs.FSCD.2024.10, Definition 3 and the identity-return
// example). Each block is a value of `Theory` that keeps both, so a program
// reads them back by `case`.

/// The naturals, a first-order signature: one ordinary sort, a constant and
/// a successor.
@[ checks ]
theory Nat {
  sort Nat : Type;
  oper zero : () --> Nat;
  oper succ : (n : Nat) --> Nat;
}

/// Pure λ-calculus syntax: one representable sort of terms, an abstraction
/// whose body binds a term, and an application.
@[ checks ]
theory Lambda {
  sort Tm : Type+;
  oper lam : (t : pi+ (x : Tm) . Tm) --> Tm;
  oper app : (t : Tm, u : Tm) --> Tm;
}

/// The identity-return signature: value types and computation types, values
/// representable and indexed by their type, and an abstraction whose body
/// binds a value of its domain.
@[ checks ]
theory IdentityReturn {
  sort VTy : Type;
  sort CTy : Type;
  sort VTm(a : VTy) : Type+;
  sort CTm(b : CTy) : Type;
  oper f : (a : VTy) --> CTy;
  oper arrow : (a : VTy, b : CTy) --> CTy;
  oper ret : (a : VTy, t : VTm(a)) --> CTm(f(a));
  oper lam : (a : VTy, b : CTy, t : pi+ (x : VTm(a)) . CTm(b)) --> CTm(arrow(a, b));
}

/// Structural recursion over a sort chain: one per `Representable` link, none
/// for an ordinary `Sort`.
@[ checks ]
def rec representable(chain : Theory) -> -F Integer {
  case chain {
    Representable(name, indices, rest) => { run r <- representable[<](rest); return r + 1 },
    Sort(name, indices, rest) => become representable[<](rest),
    _ => return 0
  }
}

/// Structural recursion over a port chain: one per `Bound` port, none for a
/// plain `Port`.
@[ checks ]
def rec bound(chain : Theory) -> -F Integer {
  case chain {
    Bound(name, sort, indices, binders, rest) => { run r <- bound[<](rest); return r + 1 },
    Port(name, sort, indices, rest) => become bound[<](rest),
    _ => return 0
  }
}

/// The identity-return signature declares one representable sort, `VTm`.
@[ runs("1") ]
def representableSorts : +U (-F Integer) ;
def representableSorts = thunk {
  case IdentityReturn {
    Presents(sorts, opers, rules) => become representable(sorts),
    _ => return 0
  }
} ;

/// The λ-calculus's first operation, `lam`, binds over its one input.
@[ runs("1") ]
def boundInputs : +U (-F Integer) ;
def boundInputs = thunk {
  case Lambda {
    Presents(sorts, opers, rules) => case opers {
      Oper(name, inputs, outputs, rest) => become bound(inputs),
      _ => return 0
    },
    _ => return 0
  }
} ;
