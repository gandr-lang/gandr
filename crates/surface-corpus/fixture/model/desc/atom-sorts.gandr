// Atom sorts (Pitts, _Nominal Sets_, CUP 2013; Gabbay and Mathijssen,
// _Nominal (universal) algebra_, JLC 2009). A sort classified `Atom` is
// orbit-infinite, with equality and swapping its only structure: an operation
// takes an atom, and none returns one. Each block is a value of `Theory` that
// keeps the atom sort as an `Atom` link of its sort chain, so a program reads
// it back by `case`.

/// One atom sort and nothing else.
@[ checks ]
theory AtomOnly {
  sort Name : Atom;
}

/// Names and the terms that mention them: a variable names an atom, and a
/// renaming takes two atoms and a term.
@[ checks ]
theory Renaming {
  sort Name : Atom;
  sort Tm : Type;
  oper var : (a : Name) --> Tm;
  oper rename : (a : Name, b : Name, t : Tm) --> Tm;
}

/// Structural recursion over a sort chain: one per `Atom` link, none for an
/// ordinary `Sort`.
@[ checks ]
def rec atoms(chain : Theory) -> -F Integer {
  case chain {
    Atom(name, indices, rest) => { run r <- atoms[<](rest); return r + 1 },
    Sort(name, indices, rest) => become atoms[<](rest),
    _ => 0
  }
}

/// The renaming signature declares one atom sort, `Name`.
@[ runs("1") ]
def atomSorts : () => Integer ;
def atomSorts = thunk {
  case Renaming {
    Presents(sorts, opers, rules) => become atoms(sorts),
    _ => 0
  }
} ;
