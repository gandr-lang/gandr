// A view of a value held inside a scope, kept at its own hold, as Rust lets a
// reference to a block's local live as long as the block: `{ let x = 42; let
// r = &x; *r }`. A shared view kept in a region keeps its held value frozen
// until the region ends, so a slot held inside the scope is kept at the hold
// that holds it.

/// Keeps a view of a value held inside the handler at the hold, and forces it
/// before the hold ends.
@[ runs("42") ]
def keptAtHold() -> -F Integer {
  handle inner : Proc {
    hold l = 42;
    run q : (() => Integer) at l <- access shared l as w { pure pure w } ;
    force q
  } with {
    pure(y) => pure y,
    oper exit(code, k) => pure 0
  }
}

/// The same inside a handler a `run` binds within another: where a handler is
/// bound opens no region of its own.
@[ runs("42") ]
def keptAtNestedHold() -> -F Integer {
  handle outer : Proc {
    run x : Integer <- handle inner : Proc {
      hold l = 42;
      run q : (() => Integer) at l <- access shared l as w { pure pure w } ;
      force q
    } with {
      pure(y) => pure y,
      oper exit(code, k) => pure 0
    } ;
    pure x
  } with {
    pure(y) => pure y,
    oper exit(code, k) => pure 0
  }
}
