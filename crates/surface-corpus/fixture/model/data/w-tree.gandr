// Well-founded trees branching through a function, after Martin-Löf's
// W-types. A node holds a function from a type of branches to its subtrees,
// so the family occurs to the right of an arrow, never to its left: strictly
// positive. A fold reaches each subtree by applying that function and recurses
// on the result, one stage below the node it came from (Martin-Löf,
// _Constructive mathematics and computer programming_, 1982).

// The naturals the fold counts in, their addition, and the two branches.
import "./data-base.gandr" ;

/// Binary trees with the branching written as a function: a node picks its
/// subtree at each branch.
@[ checks ]
data Tree : Type {
  Leaf : Tree;
  Node : (f : +U (Two -> -F Tree)) --> Tree;
}

/// The number of leaves: each subtree is reached through `f` and counted one
/// stage below the node.
@[ checks ]
def rec size(t : Tree) -> -F Nat {
  case t {
    Leaf => Succ(Zero),
    Node(f) => {
      run l <- f(L);
      run r <- f(R);
      run a <- size[<](l);
      run b <- size[<](r);
      plus(a, b)
    }
  }
}

/// Every branch a leaf.
@[ checks ]
def leaves : +U (Two -> -F Tree) ;
def leaves = thunk { fn (x) { Leaf } } ;

/// A node over two leaves.
@[ checks ]
def cherry : Tree ;
def cherry = Node(leaves) ;

/// A node whose left branch is a cherry and whose right is a leaf.
@[ checks ]
def lopsided : Tree ;
def lopsided = Node(thunk { fn (x) { case x -> -F Tree { L => cherry, R => Leaf } } }) ;

/// The cherry's two leaves, counted through its function.
@[ runs("Succ(Succ(Zero))") ]
def cherry_leaves : +U (-F Nat) ;
def cherry_leaves = thunk { size(cherry) } ;

/// Three leaves, the left two reached through two functions.
@[ runs("Succ(Succ(Succ(Zero)))") ]
def deeper : +U (-F Nat) ;
def deeper = thunk { size(lopsided) } ;
