// The folds over a list of naturals — its length, appending and mapping — in
// each spelling an arm admits: a `return` after a `run`, the same with both
// elided, the calls nested in the constructor, and a `run` written inside a
// constructor's field. Each spelling of one fold runs to the same value, and
// the polymorphic length of `recursive-lists.gandr` checks at the naturals. A
// structural recursive call stands one stage below the list it was read from
// (Abel, _Termination checking with types_, doi:10.1051/ita:2004015).

// The naturals, the numerals two and three, and the lists.
import "./data-base.gandr" ;

// The polymorphic length, read at the naturals.
import "./recursive-lists.gandr" ;

/// The length of a list of naturals, returned.
@[ checks ]
def rec length_nat(xs : List(Nat)) -> -F Nat {
  case xs {
    Nil => return Zero,
    Cons(x, rest) => { run r <- length_nat[<](rest); return Succ(r) }
  }
}

/// The length of a list of naturals, the `return`s elided.
@[ checks ]
def rec length_nat_elided(xs : List(Nat)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => { run r <- length_nat_elided[<](rest); Succ(r) }
  }
}

/// Appending lists of naturals, returned.
@[ checks ]
def rec append_nat(ys : List(Nat), xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => return ys,
    Cons(x, rest) => { run r <- append_nat[<](ys, rest); return (Cons(x, r) : List(Nat)) }
  }
}

/// Appending lists of naturals, the `return`s elided.
@[ checks ]
def rec append_nat_elided(ys : List(Nat), xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => ys,
    Cons(x, rest) => { run r <- append_nat_elided[<](ys, rest); (Cons(x, r) : List(Nat)) }
  }
}

/// Mapping over a list of naturals, returned.
@[ checks ]
def rec map_nat(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => return (Nil : List(Nat)),
    Cons(x, rest) => { run y <- f(x); run r <- map_nat[<](f, rest); return (Cons(y, r) : List(Nat)) }
  }
}

/// Mapping over a list of naturals, the `return`s elided.
@[ checks ]
def rec map_nat_elided(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => { run y <- f(x); run r <- map_nat_elided[<](f, rest); (Cons(y, r) : List(Nat)) }
  }
}

/// Mapping over a list of naturals, both calls nested.
@[ checks ]
def rec map_nat_nested(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(f(x), map_nat_nested[<](f, rest)) : List(Nat))
  }
}

/// Mapping over a list of naturals, both calls written `run` in the fields.
@[ checks ]
def rec map_nat_run(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(run f(x), run map_nat_run[<](f, rest)) : List(Nat))
  }
}

/// Two, then zero.
@[ runs("Cons(Succ(Succ(Zero)), Cons(Zero, Nil))") ]
def small : List(Nat) ;
def small = (Cons(two, (Cons(Zero, (Nil : List(Nat))) : List(Nat))) : List(Nat)) ;

/// The successor, returned.
@[ runs("fn (a) { Succ(a) }") ]
def bump : Nat => Nat ;
def bump = thunk { fn (n) { return Succ(n) } } ;

/// The successor, the `return` elided.
@[ runs("fn (a) { Succ(a) }") ]
def bump_elided : Nat => Nat ;
def bump_elided = thunk { fn (n) { Succ(n) } } ;

/// The length of `small`.
@[ runs("Succ(Succ(Zero))") ]
def counted : +U (-F Nat) ;
def counted = thunk { become length_nat(small) } ;

/// The length of `small`, the `return`s elided.
@[ runs("Succ(Succ(Zero))") ]
def counted_elided : +U (-F Nat) ;
def counted_elided = thunk { length_nat_elided(small) } ;

/// `small` with three appended at its head.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Succ(Zero)), Cons(Zero, Nil)))") ]
def joined : +U (-F List(Nat)) ;
def joined = thunk { become append_nat(small, (Cons(three, (Nil : List(Nat))) : List(Nat))) } ;

/// The same append, the `return`s elided.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Succ(Zero)), Cons(Zero, Nil)))") ]
def joined_elided : +U (-F List(Nat)) ;
def joined_elided = thunk { append_nat_elided(small, (Cons(three, (Nil : List(Nat))) : List(Nat))) } ;

/// Each element of `small` bumped.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped : +U (-F List(Nat)) ;
def bumped = thunk { become map_nat(bump, small) } ;

/// The same map, the `return`s elided.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped_elided : +U (-F List(Nat)) ;
def bumped_elided = thunk { map_nat_elided(bump_elided, small) } ;

/// The same map, the calls nested.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped_nested : +U (-F List(Nat)) ;
def bumped_nested = thunk { map_nat_nested(bump, small) } ;

/// The same map, the calls run in the fields.
@[ runs("Cons(Succ(Succ(Succ(Zero))), Cons(Succ(Zero), Nil))") ]
def bumped_run : +U (-F List(Nat)) ;
def bumped_run = thunk { map_nat_run(bump, small) } ;

/// The length of `small` at its element type, returned.
@[ checks ]
def lengthened : +U (-F Nat) ;
def lengthened = thunk { become length(Nat, small) } ;

/// The same length, the `return`s elided.
@[ checks ]
def lengthened_elided : +U (-F Nat) ;
def lengthened_elided = thunk { length_elided(Nat, small) } ;
