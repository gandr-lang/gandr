@[ checks ]
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

@[ checks ]
def rank(c : Color) -> -F Integer {
  case c {
    Red => return 0,
    _ => return 1
  }
}

@[ checks ]
def warm(c : Color) -> -F Integer {
  case c {
    Red | Green => return 1,
    Blue => return 0
  }
}

@[ checks ]
data Inner : Type {
  No : Inner;
  Yes : (n : Integer) --> Inner;
}

@[ checks ]
data Outer : Type {
  None : Outer;
  Some : (i : Inner) --> Outer;
}

@[ checks ]
def depth(m : Outer) -> -F Integer {
  case m {
    Some(Yes(n)) => return n,
    Some(No) => return 0,
    None => return 0
  }
}

@[ checks ]
def inner = (Yes(41) : Inner);

@[ checks ]
def answer = (Some(inner) : Outer);
