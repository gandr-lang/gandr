// Rose trees: a node holds its children, in two forms. Written directly, a
// node holds a `List` of nodes: the list's parameter is strictly positive, so
// each child stands below the node and the family declares (#517). Written as
// a block, a node holds a forest and a forest is empty or a tree before a
// forest: the two families name each other, so they are one block, admitted
// as one and sharing one stage; and the two measures name each other, so they
// are one fixpoint over the sum of their domains, each measure that fixpoint
// at its own summand. A call through either stands one stage below the node or
// forest it was read from. The direct form's measure, recursing through a
// list's map at its children's stage, is refused in
// `../../pathological/data/rose.gandr` until #393.

/// Natural numbers, the measure the fold counts in.
@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

/// Addition by recursion on the second argument.
@[ checks ]
def rec plus(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => n,
    Succ(p) => Succ(plus[<](n, p))
  }
}

/// Lists, whose element stands only where a list holds it: strictly
/// positive, so a family nests through it.
@[ checks ]
data List(a : Type) : Type {
  Nil : List(a);
  Cons : (head : a, tail : List(a)) --> List(a);
}

/// The direct form: a node over a list of nodes, nested through `List`'s
/// strictly positive parameter (#517).
@[ checks ]
data Bush : Type {
  Sprout : (kids : List(Bush)) --> Bush;
}

/// A node without children, written directly.
@[ checks ]
def sprig : Bush ;
def sprig = Sprout((Nil : List(Bush))) ;

/// A node over two childless nodes, written directly.
@[ checks ]
def shrub : Bush ;
def shrub = Sprout((Cons(sprig, (Cons(sprig, (Nil : List(Bush))) : List(Bush))) : List(Bush))) ;

/// The tree and its forest, one block: each family names the other, and
/// the two measures recurse through each other.
rec {
  /// A node over its forest of children.
  @[ checks ]
  data Rose : Type {
    Node : (kids : Forest) --> Rose;
  }

  /// The children of a node, in order.
  @[ checks ]
  data Forest : Type {
    Empty : Forest;
    More : (head : Rose, tail : Forest) --> Forest;
  }

  /// The nodes of a tree: its own and its children's.
  @[ checks ]
  def rec size(t : Rose) -> -F Nat {
    case t {
      Node(kids) => { run s <- sizes[<](kids); return Succ(s) }
    }
  }

  /// The nodes of a forest: each tree's, summed.
  @[ checks ]
  def rec sizes(ts : Forest) -> -F Nat {
    case ts {
      Empty => return Zero,
      More(t, rest) => { run a <- size[<](t); run b <- sizes[<](rest); plus(a, b) }
    }
  }
}

/// A node without children.
@[ checks ]
def leaf : Rose ;
def leaf = Node(Empty) ;

/// A node over two leaves.
@[ checks ]
def cherry : Rose ;
def cherry = Node(More(leaf, More(leaf, Empty))) ;

/// The cherry's three nodes.
@[ runs("Succ(Succ(Succ(Zero)))") ]
def counted : +U (-F Nat) ;
def counted = thunk { size(cherry) } ;

/// A forest of a cherry and a leaf: four nodes.
@[ runs("Succ(Succ(Succ(Succ(Zero))))") ]
def forested : +U (-F Nat) ;
def forested = thunk { sizes(More(cherry, More(leaf, Empty))) } ;
