// Dependent pairs: a record whose later entry's type reads an earlier one,
// split by a match or selected by label or position, and a path between two
// pairs as a path between the first components and, over it, one between
// the second (the HoTT book, §2.7).

/// A family indexed by an integer, with one element at each index.
@[ checks ]
data Ix(n : Integer) : Type {
  MkIx : Ix(n);
}

/// A label a later entry names binds there: the type is a dependent pair.
@[ checks ]
def tagged : #{n : Integer, w : Ix(n)} ;
def tagged = #{3, (MkIx : Ix(3))} ;

/// The first component of a dependent pair, by a match.
@[ checks ]
def tag_of(p : #{n : Integer, w : Ix(n)}) -> -F Integer {
  case p {
    #{m, w} => return m
  }
}

/// The tag of `tagged`.
@[ runs("3") ]
def tag : +U (-F Integer) ;
def tag = thunk { become tag_of(tagged) } ;

/// The first component of a dependent pair, selected by its label.
@[ checks ]
def index_of(p : #{n : Integer, w : Ix(n)}) -> -F Integer {
  return p.n
}

/// The index of `tagged`.
@[ runs("3") ]
def index : +U (-F Integer) ;
def index = thunk { become index_of(tagged) } ;

/// A pair whose second component is a loop at its first.
@[ checks ]
def ring : #{n : Integer, v : Path(Integer, n, n)} ;
def ring = #{2, here(2)} ;

/// The second projection's type reads the first.
@[ checks ]
def lap(p : #{n : Integer, v : Path(Integer, n, n)}) -> -F Path(Integer, p.n, p.n) {
  return p.v
}

/// A selection by position names the same entry: `.0` the first, `.1` the
/// second.
@[ checks ]
def lap_by_position(p : #{n : Integer, v : Path(Integer, n, n)}) -> -F Path(Integer, p.0, p.0) {
  return p.1
}

/// A pair has two positions.
@[ refuses("OutOfFragment") ]
def third(p : Integer * String) -> -F String {
  return p.2
}

/// A split's answer may name its scrutinee: each arm answers it at the pair.
@[ checks ]
def rebuilt(p : #{
  n : Integer,
  v : Path(Integer, n, n)
}) -> -F Path(#{n : Integer, v : Path(Integer, n, n)}, p, p) {
  case p {
    #{.n = m, .v = w} => return here(#{m, w})
  }
}

/// A record of three nests its links; a labelled pattern binds the entries it
/// names, the later one's type reading the earlier.
@[ checks ]
def middle(t : #{a : Integer, b : Integer, c : Path(Integer, a, a)}) -> -F Integer {
  case t {
    #{.a = x, .c = z} => return x
  }
}

/// A path between pairs is a path between the first components and, over
/// it, a path between the second.
@[ checks ]
def both : Path(#{n : Integer, v : Path(Integer, n, n)}, #{2, here(2)}, #{2, here(2)}) ;
def both = #{here(2), here(here(2))} ;

/// A declared pair's path reads the pair it unfolds to.
@[ checks ]
def ring_around : Path(#{n : Integer, v : Path(Integer, n, n)}, ring, ring) ;
def ring_around = #{here(2), here(here(2))} ;

/// The constant path at `tagged`, the second component's over the first's.
@[ checks ]
def tagged_around : Path(#{n : Integer, w : Ix(n)}, tagged, tagged) ;
def tagged_around = #{here(3), here((MkIx : Ix(3)))} ;

/// Five, carried along `both` through the constant family.
@[ checks ]
def moved : +U (-F Integer) ;
def moved = thunk { transport(\s. Integer, both, 5) } ;
