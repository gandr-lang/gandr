@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ checks ]
data List(a : Type) : Type {
  Nil : List(a);
  Cons : (head : a, tail : List(a)) --> List(a);
}

@[ checks ]
def rec plus(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => return n,
    Succ(p) => { run r <- plus[<](n, p); return Succ(r) }
  }
}

@[ checks ]
def rec plus_elided(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => n,
    Succ(p) => { run r <- plus_elided[<](n, p); Succ(r) }
  }
}

@[ checks ]
def rec length(a : Type, xs : List(a)) -> -F Nat {
  case xs {
    Nil => return Zero,
    Cons(x, rest) => { run r <- length[<](a, rest); return Succ(r) }
  }
}

@[ checks ]
def rec length_elided(a : Type, xs : List(a)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => { run r <- length_elided[<](a, rest); Succ(r) }
  }
}

@[ checks ]
def rec append(a : Type, ys : List(a), xs : List(a)) -> -F List(a) {
  case xs {
    Nil => return ys,
    Cons(x, rest) => { run r <- append[<](a, ys, rest); return (Cons(x, r) : List(a)) }
  }
}

@[ checks ]
def rec append_elided(a : Type, ys : List(a), xs : List(a)) -> -F List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => { run r <- append_elided[<](a, ys, rest); (Cons(x, r) : List(a)) }
  }
}

@[ checks ]
def rec map(a : Type, b : Type, f : a => b, xs : List(a)) -> -F List(b) {
  case xs {
    Nil => return (Nil : List(b)),
    Cons(x, rest) => { run y <- f(x); run r <- map[<](a, b, f, rest); return (Cons(y, r) : List(b)) }
  }
}

@[ checks ]
def rec map_elided(a : Type, b : Type, f : a => b, xs : List(a)) -> -F List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(x, rest) => { run y <- f(x); run r <- map_elided[<](a, b, f, rest); (Cons(y, r) : List(b)) }
  }
}

@[ checks ]
def rec length_nat(xs : List(Nat)) -> -F Nat {
  case xs {
    Nil => return Zero,
    Cons(x, rest) => { run r <- length_nat[<](rest); return Succ(r) }
  }
}

@[ checks ]
def rec length_nat_elided(xs : List(Nat)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => { run r <- length_nat_elided[<](rest); Succ(r) }
  }
}

@[ checks ]
def rec append_nat(ys : List(Nat), xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => return ys,
    Cons(x, rest) => { run r <- append_nat[<](ys, rest); return (Cons(x, r) : List(Nat)) }
  }
}

@[ checks ]
def rec append_nat_elided(ys : List(Nat), xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => ys,
    Cons(x, rest) => { run r <- append_nat_elided[<](ys, rest); (Cons(x, r) : List(Nat)) }
  }
}

@[ checks ]
def rec map_nat(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => return (Nil : List(Nat)),
    Cons(x, rest) => { run y <- f(x); run r <- map_nat[<](f, rest); return (Cons(y, r) : List(Nat)) }
  }
}

@[ checks ]
def rec map_nat_elided(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => { run y <- f(x); run r <- map_nat_elided[<](f, rest); (Cons(y, r) : List(Nat)) }
  }
}

@[ checks ]
def rec plus_nested(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => n,
    Succ(p) => Succ(plus_nested[<](n, p))
  }
}

@[ checks ]
def rec plus_run(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => n,
    Succ(p) => Succ(run plus_run[<](n, p))
  }
}

@[ checks ]
def rec length_nested(a : Type, xs : List(a)) -> -F Nat {
  case xs {
    Nil => Zero,
    Cons(x, rest) => Succ(length_nested[<](a, rest))
  }
}

@[ checks ]
def rec append_nested(a : Type, ys : List(a), xs : List(a)) -> -F List(a) {
  case xs {
    Nil => ys,
    Cons(x, rest) => (Cons(x, append_nested[<](a, ys, rest)) : List(a))
  }
}

@[ checks ]
def rec map_nested(a : Type, b : Type, f : a => b, xs : List(a)) -> -F List(b) {
  case xs {
    Nil => (Nil : List(b)),
    Cons(x, rest) => (Cons(f(x), map_nested[<](a, b, f, rest)) : List(b))
  }
}

@[ checks ]
def rec map_nat_nested(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(f(x), map_nat_nested[<](f, rest)) : List(Nat))
  }
}

@[ checks ]
def rec map_nat_run(f : Nat => Nat, xs : List(Nat)) -> -F List(Nat) {
  case xs {
    Nil => (Nil : List(Nat)),
    Cons(x, rest) => (Cons(run f(x), run map_nat_run[<](f, rest)) : List(Nat))
  }
}

@[ runs("ctor[1](ctor[1](ctor[0]()))") ]
def two : Nat ;
def two = Succ(Succ(Zero)) ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[0]())))") ]
def three : Nat ;
def three = Succ(two) ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]())))))") ]
def five : +U (-F Nat) ;
def five = thunk { become plus(two, three) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]())))))") ]
def five_elided : +U (-F Nat) ;
def five_elided = thunk { plus_elided(two, three) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]())))))") ]
def five_nested : +U (-F Nat) ;
def five_nested = thunk { plus_nested(two, three) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]())))))") ]
def five_run : +U (-F Nat) ;
def five_run = thunk { plus_run(two, three) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))))))") ]
def six : +U (-F Nat) ;
def six = thunk { Succ(plus_nested(two, three)) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[0]())), ctor[1](ctor[0](), ctor[0]()))") ]
def small : List(Nat) ;
def small = (Cons(two, (Cons(Zero, (Nil : List(Nat))) : List(Nat))) : List(Nat)) ;

@[ runs("<fun>") ]
def bump : Nat => Nat ;
def bump = thunk { fn (n) { return Succ(n) } } ;

@[ runs("<fun>") ]
def bump_elided : Nat => Nat ;
def bump_elided = thunk { fn (n) { Succ(n) } } ;

@[ runs("ctor[1](ctor[1](ctor[0]()))") ]
def counted : +U (-F Nat) ;
def counted = thunk { become length_nat(small) } ;

@[ runs("ctor[1](ctor[1](ctor[0]()))") ]
def counted_elided : +U (-F Nat) ;
def counted_elided = thunk { length_nat_elided(small) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))), ctor[1](ctor[1](ctor[1](ctor[0]())), ctor[1](ctor[0](), ctor[0]())))") ]
def joined : +U (-F List(Nat)) ;
def joined = thunk { become append_nat(small, (Cons(three, (Nil : List(Nat))) : List(Nat))) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))), ctor[1](ctor[1](ctor[1](ctor[0]())), ctor[1](ctor[0](), ctor[0]())))") ]
def joined_elided : +U (-F List(Nat)) ;
def joined_elided = thunk { append_nat_elided(small, (Cons(three, (Nil : List(Nat))) : List(Nat))) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))), ctor[1](ctor[1](ctor[0]()), ctor[0]()))") ]
def bumped : +U (-F List(Nat)) ;
def bumped = thunk { become map_nat(bump, small) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))), ctor[1](ctor[1](ctor[0]()), ctor[0]()))") ]
def bumped_elided : +U (-F List(Nat)) ;
def bumped_elided = thunk { map_nat_elided(bump_elided, small) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))), ctor[1](ctor[1](ctor[0]()), ctor[0]()))") ]
def bumped_nested : +U (-F List(Nat)) ;
def bumped_nested = thunk { map_nat_nested(bump, small) } ;

@[ runs("ctor[1](ctor[1](ctor[1](ctor[1](ctor[0]()))), ctor[1](ctor[1](ctor[0]()), ctor[0]()))") ]
def bumped_run : +U (-F List(Nat)) ;
def bumped_run = thunk { map_nat_run(bump, small) } ;

@[ checks ]
def lengthened : +U (-F Nat) ;
def lengthened = thunk { become length(Nat, small) } ;

@[ checks ]
def lengthened_elided : +U (-F Nat) ;
def lengthened_elided = thunk { length_elided(Nat, small) } ;
