// A data type with two parameters: the sum of two types, each constructor
// injecting one side. A match on a constructor written with its type takes
// the arm that constructor names (Martin-Löf, _Intuitionistic Type Theory_,
// Bibliopolis, 1984).

/// The sum of `a` and `b`: a value of either side, tagged by its constructor.
@[ checks ]
data Either(a : Type, b : Type) : Type {
  Left : (x : a) --> Either(a, b);
  Right : (y : b) --> Either(a, b);
}

/// The left side of a left injection, or zero for a right one.
@[ checks ]
def from_left() -> -F Integer {
  case (Left(5) : Either(Integer, String)) {
    Left(x) => return x,
    Right(y) => return 0
  }
}
