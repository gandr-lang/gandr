// A short string keeps its bytes inside itself and a long one in a buffer on
// the heap: a string of at most 23 bytes, its zero making 24, needs no
// allocation, and a copy of it is a copy of those bytes. Where the bytes live
// is not observable: a string reads as the same bytes either way (the
// small-string optimisation of libc++'s `std::string`, and of Rust's
// `compact_str`, which keeps 24 bytes inline).

// The lists; the byte lists; the owned bytes.
import "../data/data-base.gandr" ;
import "./string-base.gandr" ;
import "./nul-terminated.gandr" ;

/// Where a string's bytes live, read off its representation.
@[ checks ]
data Place : Type {
  Inside : Place;
  OnHeap : Place;
}

/// A string holding `bs`: inline when they fit the inline capacity, else in a
/// buffer of its own on the heap, held once.
@[ checks ]
def store(bs : List(Integer)) -> -F Repr {
  run n <- count(bs);
  run fits <- n <= inlineCapacity;
  case fits {
    true => Inline(bs),
    false => Shared(1, bs)
  }
}

/// The string of the code points `cs`: their bytes and the zero, stored.
@[ checks ]
def own(cs : List(Integer)) -> -F Repr {
  become store(terminated(cs))
}

/// Where a string's bytes live.
@[ checks ]
def place(s : Repr) -> -F Place {
  case s {
    Inline(bs) => Inside,
    Shared(n, bs) => OnHeap
  }
}

/// `n` copies of the code point `c` before `onto`, built by a loop that
/// carries the list and the count left.
@[ checks ]
def repeatOnto(c : Integer, n : Integer, onto : List(Integer)) -> -F List(Integer) {
  hold acc = onto;
  hold left = n;
  while left > 0 {
    access acc as a { resume(a, (Cons(c, a) : List(Integer))) };
    access left as v { resume(v, v - 1) }
  };
  pure acc
}

/// `hi`, two bytes and the zero: inline.
@[ runs("Inside") ]
def hiPlace : () => Place ;
def hiPlace = thunk {
  become place(own((Cons(104, Cons(105, Nil)) : List(Integer))))
} ;

/// Twenty-three bytes and the zero fill the inline capacity exactly: inline.
@[ runs("Inside") ]
def fullPlace : () => Place ;
def fullPlace = thunk {
  run cs <- repeatOnto(97, 23, (Nil : List(Integer))) ;
  become place(own(cs))
} ;

/// One byte more and the string's bytes go to the heap.
@[ runs("OnHeap") ]
def spilledPlace : () => Place ;
def spilledPlace = thunk {
  run cs <- repeatOnto(97, 24, (Nil : List(Integer))) ;
  become place(own(cs))
} ;

/// Inline or on the heap, a string reads as its owned bytes.
@[ runs("Cons(104, Cons(105, Cons(0, Nil)))") ]
def hiBytes : () => List(Integer) ;
def hiBytes = thunk {
  become bytes(own((Cons(104, Cons(105, Nil)) : List(Integer))))
} ;

/// The spilled string's twenty-four bytes and the zero.
@[ runs("25") ]
def spilledCount : () => Integer ;
def spilledCount = thunk {
  run cs <- repeatOnto(97, 24, (Nil : List(Integer))) ;
  run s <- own(cs) ;
  become count(bytes(s))
} ;
