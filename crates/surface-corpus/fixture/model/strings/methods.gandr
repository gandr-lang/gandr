// A string's methods: a module member whose first parameter is its receiver,
// `self`, written with the mode the receiver is lent in, called off a held
// string as `s.len()`. A call is the access its mode names: a shared receiver
// is lent for reading, an exclusive one, written with no mode, is lent and
// written back, and a consumed one is taken, ending its hold (the `let`,
// `inout` and `sink` conventions of Racordon and Abrahams, "Borrow checking
// Hylo", IWACO 2023).

// The lists; the byte lists; the owned bytes; the writes.
import "../data/data-base.gandr" ;
import "./string-base.gandr" ;
import "./nul-terminated.gandr" ;
import "./small-string.gandr" ;
import "./copy-on-write.gandr" ;
import "./unique-write.gandr" ;

/// A string's methods, one per receiver mode.
module Str {
  /// The number of bytes the string holds, its zero included, read from a
  /// string lent for reading.
  @[ checks ]
  def len(self : shared Repr) -> -F Integer {
    case self {
      Inline(bs) => become count(bs),
      Shared(n, bs) => become count(bs)
    }
  }
  /// A byte written before the zero of a string lent to the write, which
  /// writes it back.
  @[ checks ]
  def push(self : Repr, b : Integer) -> -F Unit {
    access self as v { run w <- pushInPlace(v, b) ; run t <- written(w) ; resume(v, t) }
  }
  /// The bytes of a string taken: nothing reads the string after.
  @[ checks ]
  def bytes(self : consumed Repr) -> -F List(Integer) {
    case self {
      Inline(bs) => bs,
      Shared(n, bs) => bs
    }
  }
}

/// `hi`'s length before and after `!` is pushed onto it: three bytes, then
/// four.
@[ runs("7") ]
def lengths() -> -F Integer {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  run n <- s.len();
  s.push(33);
  run m <- s.len();
  pure n + m
}

/// `hi` with `!` pushed, then taken: the bytes the string ended with.
@[ runs("Cons(104, Cons(105, Cons(33, Cons(0, Nil))))") ]
def taken() -> -F List(Integer) {
  hold s = Inline((Cons(104, Cons(105, Cons(0, Nil))) : List(Integer)));
  s.push(33);
  s.bytes()
}
