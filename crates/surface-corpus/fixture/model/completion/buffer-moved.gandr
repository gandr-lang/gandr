// The buffer a read fills is moved into its submission, not borrowed, because
// the kernel owns it until the operation completes (boats, _Notes on
// io-uring_, 2020), and it is handed back with the completion. The buffer is a
// linear resident, here the end of a forked owner, and moving it into a
// submission is delegation (Honda, Vasconcelos and Kubo,
// doi:10.1007/BFb0053567).

// The ring's protocol and its entries.
import "./ring-base.gandr" ;

/// A buffer moved into the mock kernel's submission and finished there before
/// the completion is posted: the send consumes the submitter's end, and the
/// kernel's receive binds it until the kernel closes it.
@[ checks ]
def bufferMoved() -> -F Unit {
  fork (owner : Ring.Buffer) { close(owner) } as buffer;
  fork (kernel : Ring.Moving) {
    recv(kernel) as held;
    close(held);
    send(kernel, Ring.done);
    close(kernel)
  } as ring;
  send(ring, buffer);
  recv(ring) as cqe;
  close(ring)
}
