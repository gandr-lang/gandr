// A cancellation posts its own completion, and the target's is still owed, in
// either order (io_uring_prep_cancel(3), io_uring_cancelation(7)). The two are
// independent pending completions, not one sequence, so a program may reap
// them in either order. Here each is served by its own mock kernel; a cancel
// that consumes its target's pending completion waits on delegation (#1167).

// The ring's protocol and its entries.
import "./ring-base.gandr" ;

/// The target's completion reaped before the cancellation's.
@[ checks ]
def targetFirst() -> -F Unit {
  fork (target : Ring.Submission) {
    recv(target) as sqe;
    send(target, Ring.done);
    close(target)
  } as pending;
  fork (canceller : Ring.Submission) {
    recv(canceller) as sqe;
    send(canceller, Ring.done);
    close(canceller)
  } as cancel;
  send(pending, Ring.read);
  send(cancel, Ring.read);
  recv(pending) as first;
  recv(cancel) as second;
  close(pending);
  close(cancel)
}

/// The cancellation's completion reaped before the target's.
@[ checks ]
def cancelFirst() -> -F Unit {
  fork (target : Ring.Submission) {
    recv(target) as sqe;
    send(target, Ring.done);
    close(target)
  } as pending;
  fork (canceller : Ring.Submission) {
    recv(canceller) as sqe;
    send(canceller, Ring.done);
    close(canceller)
  } as cancel;
  send(pending, Ring.read);
  send(cancel, Ring.read);
  recv(cancel) as first;
  recv(pending) as second;
  close(cancel);
  close(pending)
}
