// A family applied at a call's result converts with itself. A type that reads
// a call's value runs the call first and binds it, so `tm(extend(g))` is
// `c ← extend(g); tm(c)`; a dependent arrow instantiated at the call
// `extend(g)` binds it ahead of each code that reads the binder, so the type
// it yields is written the same way (#720). The shape is a category with
// families: operations over context extension, laws that apply one operation
// to another's result (Dybjer, _Internal Type Theory_, TYPES 1995, LNCS
// 1158). The same law stated as a record's field reads the record's family
// field by its label in every type it prints (#728). A record holding the
// family and an operation into it checks the operation at the family it holds
// (#721), and its operation's type prints as the arrow the family's argument
// drops (#736).

/// A family applied to an operation's result, met at one argument: `q(g)` is
/// at `tm(extend(g))`, which is `use`'s second domain at `extend(g)` (#720).
@[ checks, form(explicit) ]
def useAtExtension(
  con : Type,
  tm : +U (con -> -F Type),
  extend : +U ((g : con) -> -F con),
  q : +U ((g : con) -> -F tm(extend(g))),
  use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
  g : con
) -> -F Unit {
  become use(extend(g), q(g))
}

/// The same with the family applied to a variable, which needs no call bound
/// ahead of it.
@[ checks ]
def useAtVariable(
  con : Type,
  tm : +U (con -> -F Type),
  q : +U ((g : con) -> -F tm(g)),
  use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
  g : con
) -> -F Unit {
  become use(g, q(g))
}

/// The law of the first stated as a record's field: each later field's type
/// reads the family field, and the types printed at `use` and `q` in the law
/// name it by its label (#728).
@[ checks ]
def fieldAt(
  m : #{
    con : Type,
    tm : +U (con -> -F Type),
    extend : +U ((g : con) -> -F con),
    q : +U ((g : con) -> -F tm(extend(g))),
    use : +U ((g : con) -> (t : tm(g)) -> -F Unit),
    law : +U ((g : con) -> -F Path(Unit, use(extend(g), q(g)), unit))
  }
) -> -F Unit {
  return unit
}

/// A record holding a family and an operation into it: the operation's field
/// is at the family applied to its argument, which the check reads through
/// the family the record holds before it reads `unit` against it (#721); the
/// family drops its argument, so the field prints as `Unit => Unit` (#736).
@[ checks ]
def familyRecord : #{con : Type, tm : +U (con -> -F Type), f : +U ((g : con) -> -F tm(g))} ;
def familyRecord = #{Unit, #{thunk { fn (g) { return Unit } }, thunk { fn (g) { return unit } }}} ;
