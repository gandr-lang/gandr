// A theory's operation written at its type: `oper next : T => T`, the
// value-function alias, is the operation of its domain and its result,
// `(_ : T) --> T`, as `functor-pair.gandr`'s record signature writes `next`;
// so is the thunk of curried arrows it stands for, which a judgment writes
// for more than one input, `oper add : +U (M -> M -> -F M)`, since a
// parenthesised list there opens the judgment's own port group. A port at a
// builtin type the theory does not declare reads that type, so `read`
// returns an `Integer`. A model gives each as the function it writes for an
// operation.

/// A counter, the theory of `functor-pair.gandr`'s signature
/// `#{ type T, zero : T, next : T => T, read : T => Integer }`.
theory Counting {
  sort T : Type;
  oper zero : T;
  oper next : T => T;
  oper read : T => Integer;
}

/// The integers, counting up from zero.
module Counted : Model(Counting) {
  type T = Integer;
  /// The start.
  @[ runs("0") ]
  def zero = 0;
  /// One more.
  @[ checks ]
  def next(n : Integer) -> -F Integer { become n + 1 }
  /// The count itself.
  @[ checks ]
  def read(n : Integer) -> -F Integer { n }
}

/// Two steps from the start, read out through the model's operations.
@[ runs("2") ]
def counted_two() -> -F Integer {
  run one <- Counted.next(Counted.zero) ;
  become Counted.read(Counted.next(one))
}

/// A sum, the theory of `nat-add.gandr`'s signature
/// `#{ type M = Integer, zero : M, add : (M, M) => M }`: two inputs, written
/// as the thunk of two arrows.
theory Summing {
  sort M : Type;
  oper zero : M;
  oper add : +U (M -> M -> -F M);
}

/// The integers under addition.
module Summed : Model(Summing) {
  type M = Integer;
  /// The unit.
  @[ runs("0") ]
  def zero = 0;
  /// The sum.
  @[ checks ]
  def add(x : Integer, y : Integer) -> -F Integer { become x + y }
}
