// A record update at a field the record lacks extends it with that field.

/// A record of one field.
@[ checks ]
def single = #{ a = 1 };

/// The run target adds `b`; the lowering reads no final expression as a run
/// target yet (#1105), and admits no record update (#1110).
@[ refuses("OutOfFragment") ]
#{ single | b = 2 }
