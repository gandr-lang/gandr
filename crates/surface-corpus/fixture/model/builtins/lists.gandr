// A list literal at a stated element type, and a list extended at its front.

/// Three integers, annotated as a list of them; the lowering admits no list
/// literal yet (#1544).
@[ refuses("OutOfFragment") ]
def xs = ([1, 2, 3] : List(Integer));

/// The run target prepends a zero; the lowering reads no final expression as
/// a run target yet (#1105).
@[ refuses("OutOfFragment") ]
[0] ++ xs
