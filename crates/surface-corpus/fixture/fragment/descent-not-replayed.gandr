@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ refuses("DescentNotReplayed") ]
def rec same(n : Nat) -> -F Nat {
  case n {
    Zero => ret n,
    Succ(p) => same[<](n)
  }
}

@[ refuses("DescentNotReplayed") ]
def rec counted(n : Integer) -> -F Integer { counted[<](n) }

@[ checks ]
def rec down(n : Nat) -> -F Nat {
  case n {
    Zero => ret n,
    Succ(p) => down[<](p)
  }
}
