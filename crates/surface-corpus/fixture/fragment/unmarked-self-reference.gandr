@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ refuses("UnmarkedSelfReference") ]
def rec bare(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => become bare(p)
  }
}

@[ checks ]
def rec marked(n : Nat) -> -F Nat {
  case n {
    Zero => n,
    Succ(p) => become marked[<](p)
  }
}

@[ checks ]
def rec idle(n : Nat) -> -F Nat { n }

/// A parameter written before the staged one may vary across the call: it is
/// passed to the fixpoint as a leading argument (#626).
@[ checks ]
def rec varied(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => n,
    Succ(p) => become varied[<](p, p)
  }
}

/// A productive claim outside a copattern block: nothing is observed before
/// the function runs again (#644).
@[ refuses("UnguardedCorecursion") ]
def rec ahead(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => become ahead[>](p)
  }
}

@[ refuses("OutOfFragment") ]
def rec constant() -> -F Nat { return Zero }
