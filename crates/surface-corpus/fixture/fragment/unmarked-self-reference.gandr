@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ refuses("UnmarkedSelfReference") ]
def rec bare(n : Nat) -> -F Nat {
  case n {
    Zero => ret n,
    Succ(p) => bare(p)
  }
}

@[ checks ]
def rec marked(n : Nat) -> -F Nat {
  case n {
    Zero => ret n,
    Succ(p) => marked[<](p)
  }
}

@[ checks ]
def rec idle(n : Nat) -> -F Nat { ret n }

@[ refuses("OutOfFragment") ]
def rec varied(n : Nat, m : Nat) -> -F Nat {
  case m {
    Zero => ret n,
    Succ(p) => varied[<](p, p)
  }
}

@[ refuses("OutOfFragment") ]
def rec ahead(n : Nat) -> -F Nat {
  case n {
    Zero => ret n,
    Succ(p) => ahead[>](p)
  }
}

@[ refuses("OutOfFragment") ]
def rec constant() -> -F Nat { ret Zero }
