@[ checks, form(explicit) ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ checks ]
def rec down(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => become down[<](p)
  }
}

@[ checks ]
def rec down_elided(n : Nat) -> -F Nat {
  case n {
    Zero => n,
    Succ(p) => down_elided[<](p)
  }
}

@[ checks ]
def twice(n : Nat) -> -F Nat {
  run once <- down(n) ;
  become down(once)
}

@[ checks ]
def twice_elided(n : Nat) -> -F Nat {
  run once <- down(n) ;
  down(once)
}

@[ checks ]
def twice_nested(n : Nat) -> -F Nat {
  become down(down(n))
}

@[ checks ]
def twice_run(n : Nat) -> -F Nat {
  down(run down(n))
}

@[ checks ]
def count(n : Nat) -> -F Integer {
  return 1
}

@[ checks ]
def count_elided(n : Nat) -> -F Integer {
  1
}

@[ refuses("TypeMismatch") ]
def mismatched(n : Nat) -> -F Nat {
  become count(n)
}

@[ refuses("TypeMismatch") ]
def mismatched_elided(n : Nat) -> -F Nat {
  count(n)
}

@[ checks ]
def identity : +U (Nat -> -F Nat) ;
def identity = thunk { fn (n) { return n } } ;

@[ checks ]
def identity_elided : +U (Nat -> -F Nat) ;
def identity_elided = thunk { fn (n) { n } } ;

@[ checks ]
def ret : Nat ;
def ret = Zero ;

@[ checks ]
def named(n : Nat) -> -F Nat {
  return ret
}

@[ checks ]
def named_elided(n : Nat) -> -F Nat {
  ret
}

@[ checks ]
def rec stated(n : Nat) -> -F Nat {
  case n {
    Zero => { return n; },
    Succ(p) => { become stated[<](p); }
  }
}

@[ checks ]
def rec stated_elided(n : Nat) -> -F Nat {
  case n {
    Zero => { n },
    Succ(p) => { stated_elided[<](p) }
  }
}

@[ checks ]
def sequenced(n : Nat) -> -F Nat {
  run m <- down(n) ;
  return m ;
}

@[ checks ]
def sequenced_elided(n : Nat) -> -F Nat {
  run m <- down(n) ;
  m
}

@[ checks ]
def sequenced_nested(n : Nat) -> -F Nat {
  return down(n)
}

@[ checks ]
def sequenced_run(n : Nat) -> -F Nat {
  return run down(n)
}

/// A last statement discards its value and the block returns the unit, so a
/// body answering a natural cannot end in one (#1205).
@[ refuses("TypeMismatch") ]
def discarded(n : Nat) -> -F Nat {
  run m <- down(n) ;
  down(m) ;
}

@[ checks ]
def done(n : Nat) -> -F Unit {
  return unit
}

@[ checks ]
def done_elided(n : Nat) -> -F Unit {
  unit
}

@[ checks ]
def discards_unit(n : Nat) -> -F Nat {
  done(n) ;
  return n
}

@[ checks ]
def discards_unit_elided(n : Nat) -> -F Nat {
  done(n) ;
  n
}

@[ refuses("ShapeMismatch") ]
def discards_nat(n : Nat) -> -F Nat {
  down(n) ;
  return n
}

@[ refuses("ShapeMismatch") ]
def discards_nat_elided(n : Nat) -> -F Nat {
  down(n) ;
  n
}

@[ checks ]
def discards_any(n : Nat) -> -F Nat {
  run _ <- down(n) ;
  return n
}

@[ checks ]
def discards_any_elided(n : Nat) -> -F Nat {
  run _ <- down(n) ;
  n
}

@[ refuses("Unreachable") ]
def early(n : Nat) -> -F Nat {
  run m <- return n ;
  return m
}

@[ refuses("Unreachable") ]
def early_elided(n : Nat) -> -F Nat {
  run m <- return n ;
  m
}

@[ refuses("Unreachable") ]
def local(n : Nat) -> -F Nat {
  run m <- become down(n) ;
  return m
}

@[ refuses("Unreachable") ]
def local_elided(n : Nat) -> -F Nat {
  run m <- become down(n) ;
  m
}

@[ refuses("OutOfFragment") ]
def returned = return Zero ;

@[ checks ]
def predecessor(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => return n,
    Succ(p) => pure p,
  } ;
  return m
}

@[ checks ]
def predecessor_elided(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => return n,
    Succ(p) => pure p,
  } ;
  m
}

@[ checks ]
def pick(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => return n,
    Succ(p) => {
      run q <- case p {
        Zero => return n,
        Succ(r) => pure r,
      } ;
      pure q
    },
  } ;
  return Succ(m)
}

@[ checks ]
def pick_elided(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => return n,
    Succ(p) => {
      run q <- case p {
        Zero => return n,
        Succ(r) => pure r,
      } ;
      pure q
    },
  } ;
  Succ(m)
}

@[ runs("Zero") ]
def pick_zero : +U (-F Nat) ;
def pick_zero = thunk { become pick(Zero) } ;

@[ runs("Zero") ]
def pick_zero_elided : +U (-F Nat) ;
def pick_zero_elided = thunk { pick_elided(Zero) } ;

@[ runs("Succ(Zero)") ]
def pick_one : +U (-F Nat) ;
def pick_one = thunk { become pick(Succ(Zero)) } ;

@[ runs("Succ(Zero)") ]
def pick_one_elided : +U (-F Nat) ;
def pick_one_elided = thunk { pick_elided(Succ(Zero)) } ;

@[ runs("Succ(Succ(Zero))") ]
def pick_three : +U (-F Nat) ;
def pick_three = thunk { become pick(Succ(Succ(Succ(Zero)))) } ;

@[ runs("Succ(Succ(Zero))") ]
def pick_three_elided : +U (-F Nat) ;
def pick_three_elided = thunk { pick_elided(Succ(Succ(Succ(Zero)))) } ;

@[ checks ]
def handed(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => become down(n),
    Succ(p) => pure p,
  } ;
  return Succ(m)
}

@[ checks ]
def handed_elided(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => become down(n),
    Succ(p) => pure p,
  } ;
  Succ(m)
}

@[ checks ]
def rec skim(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => {
      run _ <- case p {
        Zero => return p,
        Succ(r) => pure r,
      } ;
      become skim[<](p)
    },
  }
}

@[ checks ]
def rec skim_elided(n : Nat) -> -F Nat {
  case n {
    Zero => n,
    Succ(p) => {
      run _ <- case p {
        Zero => return p,
        Succ(r) => pure r,
      } ;
      skim_elided[<](p)
    },
  }
}

@[ runs("Zero") ]
def skimmed : +U (-F Nat) ;
def skimmed = thunk { become skim(Succ(Succ(Succ(Zero)))) } ;

@[ runs("Zero") ]
def skimmed_elided : +U (-F Nat) ;
def skimmed_elided = thunk { skim_elided(Succ(Succ(Succ(Zero)))) } ;

@[ refuses("OutOfFragment") ]
def joined(n : Nat) -> -F Nat {
  run m <- case n -> -F Nat {
    Zero => return n,
    Succ(p) => pure p,
  } ;
  return m
}

@[ refuses("OutOfFragment") ]
def joined_elided(n : Nat) -> -F Nat {
  run m <- case n -> -F Nat {
    Zero => return n,
    Succ(p) => pure p,
  } ;
  m
}

@[ refuses("MalformedForm") ]
def rec stream(n : Nat) -> Stream(Nat) {
  .head => return n,
  .tail => stream[>](Succ(n))
}
