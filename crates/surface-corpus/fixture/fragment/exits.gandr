@[ checks ]
data Nat : Type {
  Zero : Nat;
  Succ : (n : Nat) --> Nat;
}

@[ checks ]
def rec down(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => become down[<](p)
  }
}

@[ checks ]
def twice(n : Nat) -> -F Nat {
  run once <- down(n) ;
  become down(once)
}

@[ checks ]
def count(n : Nat) -> -F Integer {
  return 1
}

@[ refuses("TypeMismatch") ]
def mismatched(n : Nat) -> -F Nat {
  become count(n)
}

@[ checks ]
def identity : +U (Nat -> -F Nat) ;
def identity = thunk { fn (n) { return n } } ;

@[ checks ]
def ret : Nat ;
def ret = Zero ;

@[ checks ]
def named(n : Nat) -> -F Nat {
  return ret
}

@[ checks ]
def rec stated(n : Nat) -> -F Nat {
  case n {
    Zero => { return n; },
    Succ(p) => { become stated[<](p); }
  }
}

@[ checks ]
def sequenced(n : Nat) -> -F Nat {
  run m <- down(n) ;
  return m ;
}

@[ refuses("OutOfFragment") ]
def discarded(n : Nat) -> -F Nat {
  run m <- down(n) ;
  down(m) ;
}

@[ checks ]
def done(n : Nat) -> -F Unit {
  return unit
}

@[ checks ]
def discards_unit(n : Nat) -> -F Nat {
  done(n) ;
  return n
}

@[ refuses("ShapeMismatch") ]
def discards_nat(n : Nat) -> -F Nat {
  down(n) ;
  return n
}

@[ checks ]
def discards_any(n : Nat) -> -F Nat {
  run _ <- down(n) ;
  return n
}

@[ refuses("Unreachable") ]
def early(n : Nat) -> -F Nat {
  run m <- return n ;
  return m
}

@[ refuses("Unreachable") ]
def local(n : Nat) -> -F Nat {
  run m <- become down(n) ;
  return m
}

@[ refuses("OutOfFragment") ]
def returned = return Zero ;

@[ checks ]
def predecessor(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => return n,
    Succ(p) => pure p,
  } ;
  return m
}

@[ checks ]
def pick(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => return n,
    Succ(p) => {
      run q <- case p {
        Zero => return n,
        Succ(r) => pure r,
      } ;
      pure q
    },
  } ;
  return Succ(m)
}

@[ runs("ctor[0]()") ]
def pick_zero : +U (-F Nat) ;
def pick_zero = thunk { become pick(Zero) } ;

@[ runs("ctor[1](ctor[0]())") ]
def pick_one : +U (-F Nat) ;
def pick_one = thunk { become pick(Succ(Zero)) } ;

@[ runs("ctor[1](ctor[1](ctor[0]()))") ]
def pick_three : +U (-F Nat) ;
def pick_three = thunk { become pick(Succ(Succ(Succ(Zero)))) } ;

@[ checks ]
def handed(n : Nat) -> -F Nat {
  run m <- case n {
    Zero => become down(n),
    Succ(p) => pure p,
  } ;
  return Succ(m)
}

@[ checks ]
def rec skim(n : Nat) -> -F Nat {
  case n {
    Zero => return n,
    Succ(p) => {
      run _ <- case p {
        Zero => return p,
        Succ(r) => pure r,
      } ;
      become skim[<](p)
    },
  }
}

@[ runs("ctor[0]()") ]
def skimmed : +U (-F Nat) ;
def skimmed = thunk { become skim(Succ(Succ(Succ(Zero)))) } ;

@[ refuses("OutOfFragment") ]
def joined(n : Nat) -> -F Nat {
  run m <- case n -> -F Nat {
    Zero => return n,
    Succ(p) => pure p,
  } ;
  return m
}

@[ refuses("MalformedForm") ]
def rec stream(n : Nat) -> Stream(Nat) {
  .head => return n,
  .tail => stream[>](Succ(n))
}
