@[ refuses("LevelMismatch") ]
def too_big : Type ;
def too_big = Type ;

@[ refuses("SortMismatch") ]
def wrong_sort : Type[-] ;
def wrong_sort = Integer ;

@[ refuses("GradedBridge") ]
def graded : Type ;
def graded = +U[1] (-F Integer) ;

@[ runs("fn (a) { fn (b) { b } }") ]
def id(a : Type, x : a) -> -F a { return x }

def chosen : +U (-F Type) ;
def chosen = thunk { return Integer } ;

@[ refuses("TypeMismatch") ]
def escaped : +U (Integer -> -F Integer) ;
def escaped = thunk { run t <- force chosen ; become id(t) } ;
