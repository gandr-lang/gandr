#!/usr/bin/env bash
# The `cargo` of the tests of `hotpath-gate`. A bench runs in the directory of
# its package, as `cargo test --bench` runs it. It writes the report of
# `GATE_REPORT` to `HOTPATH_OUTPUT_PATH`, as the profiler writes its report,
# and the report of `GATE_REPORT_BYTES` when `HOTPATH_ALLOC_METRIC` is `bytes`.
set -euo pipefail
mkdir -p crates/bench
cd crates/bench
if [[ ${HOTPATH_ALLOC_METRIC:?} == bytes ]]; then
  printf '%s' "${GATE_REPORT_BYTES:?}" > "${HOTPATH_OUTPUT_PATH:?}"
else
  printf '%s' "${GATE_REPORT:?}" > "${HOTPATH_OUTPUT_PATH:?}"
fi
