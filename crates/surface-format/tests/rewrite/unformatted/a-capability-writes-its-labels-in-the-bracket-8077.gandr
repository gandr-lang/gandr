// a held capability
def held(a : Cap { print, eprint }) -> Integer =
  1

def spent(c : Cap[1] { exit }) -> Integer =
  1

def placed[r : Region, q : Region](
  a : (Cap { print }) at r,
  // the second region
  b : (Cap { print }) at q
) -> Integer =
  1

def kept(a : Cap[print]) -> Integer =
  1
