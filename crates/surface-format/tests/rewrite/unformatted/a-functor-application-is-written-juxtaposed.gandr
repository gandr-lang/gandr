module MkCounter(S : *{type T, zero : T}) :> *{type T, seed : T} where {
  type T = S.T;
  def seed = S.zero;
}

module Seed where {
  type T = Integer;
  def zero = 0;
}

module Outer where {
  module Inner where {
    type T = Integer;
    def zero = 1;
  }
}

module A = MkCounter(Seed);

/// `B` is the second application.
module B = MkCounter Seed;

/// `D` is documented.
module D = MkCounter(Seed);

module C = MkCounter(Outer.Inner);
