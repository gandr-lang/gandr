theory State where
  sort S : Type+
  sort C : Type
  oper get : (k : (s : S) -> C) --> C

// a held capability names no region
def held(a : Cap {get}) -> Integer =
  1

def placed[r : Region, q : Region](
  a : Cap {get} at r,
  // the second region
  b : Cap { get } at q
) -> [r : State, q : State] Unit =
  pure *{}

def kept[r : Region](a : (Cap {get}) at r, b : Integer at r) -> [r : State] Unit =
  pure *{}
