def none :   #{} ;
def none =#{ } ;
def one : #{ Integer } ;
def one = #{1} ;
def three : #{Integer,String,   Unit} ;
def three = #{ 1 , "a" , unit } ;
def reordered = #{.1 = "b",.0 = 2} ;
def sugar : Integer *  String * Unit ;
def sugared = (1,  "a", unit) ;
def single = ( 1 , ) ;
def point : #{n : Integer,s : String} ;
def point = #{ .s = "x" , .n = 3 } ;
def shorthand = #{n = 3,s = "x"} ;
def bumped = #{point|n = 4} ;
def sigma : #{k : Integer, v : k} ;
def last(t : #{Integer, Integer, Integer}) -> -F Integer {
  case t { #{x,y,z} => return z }
}
def punned(r : #{n : Integer, s : String}) -> -F String {
  case r { #{.n,.s} => return s }
}
def renamed(r : #{n : Integer, s : String}) -> -F Integer {
  case r { #{.n = m} => return m }
}
def absurd(x : +{  }) -> -F Integer { case x {} }
def only : +{Integer} ;
def only = +{.0 = 1} ;
def failed : +{ ok : Integer , err : String } ;
def failed = (+{.err = "no"} : +{ok : Integer, err : String}) ;
def either : Integer +  String + Void ;
def pick(v : +{ok : Integer, err : String}) -> -F Integer {
  case v { +{.ok = n} => return n, +{.err = e} => return 0 }
}
def terminal : +U &{ } ;
def lazy() -> &{get : -F Integer,put : -F String} {
  &{ .put => return "s" , .get => return 1 }
}
def binary : +U (-F Integer  &  -F String) ;
def observe(m : +U &{get : -F Integer, put : -F String}) -> -F Integer { become m.get }
def nothing : ()  => Integer ;
def unary : ( Integer ) => Integer ;
def two : (x : Integer,y : String) => Integer ;
def menu : +U &{get : ! Integer . end, put : ? Integer . end} ;
def choose : +{ok : ! Integer . end, done : end} ;
def wide : #{first_component : Integer, second_component : String, third_component : Unit} ;
def wide = #{.first_component = 1843, .second_component = "ada lovelace", .third_component = unit} ;
