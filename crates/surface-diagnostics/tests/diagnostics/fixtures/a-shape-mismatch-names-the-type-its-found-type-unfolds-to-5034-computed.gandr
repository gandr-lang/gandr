data Nat : Type where {
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
}

data Ty : Type where {
  | Base : Ty
  | Arr : (dom : Ty, cod : Ty) --> Ty
}

data Ctx : Type where {
  | Empty : Ctx
  | Extend : (g : Ctx, a : Ty) --> Ctx
}

def prodOf(a : Type, b : Type) -> Type { return type(a * b) }

def paired(u : Integer, s : Bool) -> prodOf(Integer, Bool) { *{u, s} }

def first(v : prodOf(Integer, Bool)) -> Integer { v.0 }

def second(v : prodOf(Integer, Bool)) -> Bool { v.1 }

def pairOf(a : Type, b : Type) -> Type { return type(*{x : a, y : b}) }

def literal(u : Integer, s : Bool) -> pairOf(Integer, Bool) { *{x = u, y = s} }

def rec tower(n : Nat) -> Type {
  match n {
    | Zero => return Integer
    | Succ(m) => return type(Integer * tower[<](m))
  }
}

def towered(u : Integer, w : Integer) -> tower(Succ Zero) { *{u, w} }

def towerFirst(v : tower(Succ Zero)) -> Integer { v.0 }

def sem(a : Ty, _d : Ctx) -> Type {
  match a {
    | Base => return Integer
    | Arr(_x, _y) => return Unit
  }
}

def rec env(g : Ctx, d : Ctx) -> Type {
  match g {
    | Empty => return Unit
    | Extend(h, a) => return type(env[<](h, d) * sem(a, d))
  }
}

def lookup(d : Ctx, v : env(Extend Empty Base, d)) -> Integer { v.1 }

def single(d : Ctx, n : Integer) -> env(Extend Empty Base, d) { *{*{}, n} }
