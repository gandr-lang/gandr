/// Decidable equality over a carrier some value may be unequal to itself in:
/// symmetric.
pub theory PartialEq {
  sort Carrier : Type;
  oper eq : (a : Carrier, b : Carrier) --> Bool;
  law sym : (a : Carrier, b : Carrier) => Path(Bool, eq(a, b), eq(b, a));
}

/// Decidable equality over a carrier: a partial equality every value is
/// equal to itself in.
pub theory Eq {
  include PartialEq;
  law refl : (a : Carrier) => Path(Bool, eq(a, a), true);
}

/// Structural equality from `T`'s constructors, and its laws.
pub module Eq {
  /// `def eq = Eq.generic(T)`; `def refl = Eq.generic.refl(T)` and `def sym
  /// = Eq.generic.sym(T)` prove its laws.
  def generic : (T : Type) => (T, T) => Bool ;
}

/// Integer equality, the integer primitive, its laws the host's.
pub module EqInteger : Model(Eq) with sort Carrier = Integer {
  /// Whether two integers are equal.
  def eq(a : Integer, b : Integer) -> Bool { int.eq(a, b) }
  law refl admitted;
  law sym admitted;
}

/// String equality, the string primitive, its laws the host's.
pub module EqString : Model(Eq) with sort Carrier = String {
  /// Whether two strings are equal, byte for byte.
  def eq(a : String, b : String) -> Bool { string.eq(a, b) }
  law refl admitted;
  law sym admitted;
}

/// Float equality, the float primitive: symmetric, and no equality, since
/// NaN is equal to nothing, itself included.
pub module PartialEqFloat : Model(PartialEq) with sort Carrier = f64 {
  /// Whether two floats are equal, NaN equal to none.
  def eq(a : f64, b : f64) -> Bool { float64.eq(a, b) }
  law sym admitted;
}

/// Equality through the model of `PartialEq` the operands' type resolves:
/// what `a == b` calls.
pub def eq @[e : Model(PartialEq)] (a : e.Carrier, b : e.Carrier) -> Bool { e.eq(a, b) }

/// A decidable order over a carrier with its equality: below, at most, above
/// and at least.
pub theory Ord {
  include Eq;
  oper lt : (a : Carrier, b : Carrier) --> Bool;
  oper le : (a : Carrier, b : Carrier) --> Bool;
  oper gt : (a : Carrier, b : Carrier) --> Bool;
  oper ge : (a : Carrier, b : Carrier) --> Bool;
}

/// The integers' order, the integer primitives, over `EqInteger`.
pub module OrdInteger : Model(Ord) with sort Carrier = Integer {
  include EqInteger;
  /// Whether one integer is below another.
  def lt(a : Integer, b : Integer) -> Bool { int.lt(a, b) }
  /// Whether one integer is at most another.
  def le(a : Integer, b : Integer) -> Bool { int.le(a, b) }
  /// Whether one integer is above another.
  def gt(a : Integer, b : Integer) -> Bool { int.gt(a, b) }
  /// Whether one integer is at least another.
  def ge(a : Integer, b : Integer) -> Bool { int.ge(a, b) }
}

/// The strings' byte-lexicographic order, the string primitive, over
/// `EqString`.
pub module OrdString : Model(Ord) with sort Carrier = String {
  include EqString;
  /// Whether one string is below another, byte by byte.
  def lt(a : String, b : String) -> Bool { string.lt(a, b) }
  /// Whether one string is at most another.
  def le(a : String, b : String) -> Bool { bool.not(string.lt(b, a)) }
  /// Whether one string is above another.
  def gt(a : String, b : String) -> Bool { string.lt(b, a) }
  /// Whether one string is at least another.
  def ge(a : String, b : String) -> Bool { bool.not(string.lt(a, b)) }
}

/// Below, through the model of `Ord` the operands' type resolves: what `a < b`
/// calls.
pub def lt @[o : Model(Ord)] (a : o.Carrier, b : o.Carrier) -> Bool { o.lt(a, b) }

/// At most, through the operands' model of `Ord`: what `a <= b` calls.
pub def le @[o : Model(Ord)] (a : o.Carrier, b : o.Carrier) -> Bool { o.le(a, b) }

/// Above, through the operands' model of `Ord`: what `a > b` calls.
pub def gt @[o : Model(Ord)] (a : o.Carrier, b : o.Carrier) -> Bool { o.gt(a, b) }

/// At least, through the operands' model of `Ord`: what `a >= b` calls.
pub def ge @[o : Model(Ord)] (a : o.Carrier, b : o.Carrier) -> Bool { o.ge(a, b) }

/// What a package and a workspace both state: the version they release at.
/// `Gandr.Package` and `Gandr.Workspace` include it, so a member reads its
/// version from its workspace's model.
pub theory Versioned {
  /// The version, as a package's manifest records it.
  oper version : String;
}

/// A package: the project a `lib.gandr` roots, described by the model its
/// `module Package : Model(Gandr.Package)` is, from which the checker writes
/// the project's `gandr.toml`.
pub theory Gandr.Package {
  include Versioned;
  /// The package's name, which the manifest records it by.
  oper name : String;
}

/// A workspace: the packages a `workspace.gandr` gathers, described by the
/// model its `module Workspace : Model(Gandr.Workspace)` is, beside the
/// `members` it names. Its members' libraries import it and read what it
/// states.
pub theory Gandr.Workspace {
  include Versioned;
}
