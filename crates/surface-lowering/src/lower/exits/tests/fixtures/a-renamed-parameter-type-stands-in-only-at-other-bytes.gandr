module Seed :> *{ type T, zero : T, next : T -> T } where {
  type T = Integer;
  def zero = 0;
  def next(n : T) -> T { become n + 1 }
}

module MkCounter(S : *{ type T, zero : T, next : T -> T }) :> *{
  type T,
  seed : T,
  step : T -> T
} where {
  type T = S.T;
  def seed = S.zero;
  def step = S.next;
}

module A = MkCounter(Seed);
