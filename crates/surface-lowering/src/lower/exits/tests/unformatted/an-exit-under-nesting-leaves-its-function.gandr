{NAT}def pick(n : Nat) -> -F Nat {{
let m = match n {{
| Zero => return n
| Succ(p) => {{ let q = match p {{ | Zero => return n | Succ(r) => pure r }} ; pure q }}
}} ;
return Succ m
}}
def pick_by_hand(n : Nat) -> -F Nat {{
match n {{
| Zero => return n
| Succ(p) => match p {{ | Zero => return n | Succ(r) => return Succ r }}
}}
}}
def deep(n : Nat) -> -F Nat {{
let m = match n {{ | Succ(Succ(q)) => return q | Succ(Zero) => pure n | Zero => pure n }} ;
return Succ m
}}
def deep_by_hand(n : Nat) -> -F Nat {{
match n {{ | Succ(Succ(q)) => return q | Succ(Zero) => return Succ n | Zero => return Succ n }}
}}
