{NAT}def once(n : Nat) -> -F Nat {{ let m = match n {{ | Zero => return n | Succ(p) => pure p }} ; return Succ m }}
def once_by_hand(n : Nat) -> -F Nat {{ match n {{ | Zero => return n | Succ(p) => return Succ p }} }}
def kept(n : Nat) -> -F Nat {{ let m = match n -> -F Nat {{ | Zero => pure n | Succ(p) => pure p }} ; return Succ m }}
