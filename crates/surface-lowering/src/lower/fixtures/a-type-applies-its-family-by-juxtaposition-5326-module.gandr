data Nat : Type where
  | Zero : Nat
  | Succ : (n : Nat) --> Nat

data Vec(a : Type) : Nat -> Type where
  | VNil : Vec(a, Zero)
  | VCons : (n : Nat, head : a, tail : Vec(a, n)) --> Vec(a, Succ(n))

def called(v : Vec(Integer, Succ(Zero))) -> Vec(Integer, Succ(Zero)) { v }

def juxtaposed(v : Vec Integer (Succ Zero)) -> Vec Integer (Succ Zero) { v }

data Maybe(a : Type) : Type where
  | Nothing : Maybe(a)
  | Just : (x : a) --> Maybe(a)

def opt : Type -> Type[-] = fun (A) { -F Maybe A };
