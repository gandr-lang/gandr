def apply : (Type -> Type) -> Type -> Type = fun (F) { fun (X) { F X } };

def twice : Type -> Type = fun (Y) { type(Y * Y) };

def both : Type -> Type -> Type = fun (A) { fun (B) { type(A * B) } };

def once(n : Integer) -> twice Integer = *{n, n};

def deep(p : apply twice Integer) -> Integer = 1

def mixed(n : Integer) -> both Integer (twice Integer) = *{n, *{n, n}};

def arrowed(f : (twice Integer) -> Integer) -> Integer = f *{1, 1};

def unknown(n : nothing Integer) -> Integer = 1;
