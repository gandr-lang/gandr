def shared(m n : Integer) -> Integer { m }
def apart(m : Integer, n : Integer) -> Integer { m }
def bound(a : Type, x y : a) -> a { y }
def bound_apart(a : Type, x : a, y : a) -> a { y }
def three(b : Bool, k m n : Integer) -> Integer { k }
def three_apart(b : Bool, k : Integer, m : Integer, n : Integer) -> Integer { k }
def linked(a : Type, x y : a, p : Path[.A = a](x, y)) -> a { y }
def linked_apart(a : Type, x : a, y : a, p : Path[.A = a](x, y)) -> a { y }
