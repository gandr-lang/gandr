data Circle : Type where { | Base : Circle | loop : Base <-> Base }
def empty : Path[.A = Circle](Base, Base) = Path.here Base;
def word : Path[.A = Circle](Base, Base) = back loop ∷ loop;
def rec size(p : Path[.A = Circle](Base, Base)) -> Integer {
  match p {
    | here => 0
    | loop ∷ q => become size[<] q
    | back(loop) ∷ q => become size[<] q
  }
}
