data Empty : Type where {}
def aliased(f : Empty -> Integer, v : Empty) -> Integer { f v }
def arrowed(f : Empty -> Integer, v : Empty) -> Integer { f v }
def thunked(v : Empty) -> Integer { aliased (thunk { fun (x) { match x {} } }) v }
def bare(v : Empty) -> Integer { aliased (fun (x) { match x {} }) v }
def stated(v : Empty) -> Integer { aliased (thunk { fun (x) { match x -> -F Integer {} } }) v }
def underArrow(v : Empty) -> Integer { arrowed (thunk { fun (x) { match x {} } }) v }
