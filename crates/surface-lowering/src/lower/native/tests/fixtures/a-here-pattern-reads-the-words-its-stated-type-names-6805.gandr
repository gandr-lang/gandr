/// The first circle.
pub data C1 : Type where
  | B1 : C1
  | l1 : B1 <-> B1

/// The second circle.
pub data C2 : Type where
  | B2 : C2
  | l2 : B2 <-> B2

/// The 2-sphere.
pub data S2 : Type where
  | Base2 : S2
  | surf : Path.here Base2 <-> Path.here Base2

/// The 3-sphere.
pub data S3 : Type where
  | Base3 : S3
  | surf3 : Path.here (Path.here Base3) <-> Path.here (Path.here Base3)

/// The integers, each successor cancelled by a predecessor.
pub data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) <=> x;
  rule : P (S x) <=> x;
}

/// The winding of the first circle's words.
def rec wind1(p : Path[.A = C1](B1, B1)) -> Int =
  match p where
    | here => Z
    | l1 ∷ q => S (wind1[<] q)
    | back(l1) ∷ q => P (wind1[<] q)

/// The winding of the second circle's words.
def rec wind2(p : Path[.A = C2](B2, B2)) -> Int =
  match p where
    | here => Z
    | l2 ∷ q => S (wind2[<] q)
    | back(l2) ∷ q => P (wind2[<] q)

/// The winding of the words at the 3-cell.
def rec wind3(
  p : Path[.A = Path[.A = Path[.A = S3](Base3, Base3)](Path.here Base3, Path.here Base3)](
    Path.here (Path.here Base3),
    Path.here (Path.here Base3)
  )
) -> Int =
  match p where
    | here => Z
    | surf3 ∷ q => S (wind3[<] q)
    | back(surf3) ∷ q => P (wind3[<] q)
