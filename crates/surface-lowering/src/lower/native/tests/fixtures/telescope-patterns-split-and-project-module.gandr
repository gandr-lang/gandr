def middle(t : *{Integer, String, Unit}) -> -F String { match t { | *{x, y, z} => return y } }
def reordered(t : *{Integer, String}) -> -F Integer { match t { | *{.1 = b, .0 = a} => return a } }
def tupled(t : *{Integer, String}) -> -F String { match t { | *{a, b} => return b } }
def punned(r : *{n : Integer, s : String}) -> -F String { match r { | *{.n, .s} => return s } }
def renamed(r : *{n : Integer, s : String}) -> -F Integer { match r { | *{.n = m} => return m } }
