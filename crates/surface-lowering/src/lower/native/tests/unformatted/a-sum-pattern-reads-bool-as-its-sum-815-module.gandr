def braced(b : +{Unit, Unit}) -> -F +{Unit, Unit} { match b { | +{.0 = u} => return +{.1 = u} | +{.1 = u} => return +{.0 = u} } }
def atom(b : Bool) -> -F Bool { match b { | +{.0 = u} => return +{.1 = u} | +{.1 = u} => return +{.0 = u} } }
def past(b : Bool) -> -F Integer { match b { | +{.2 = u} => return 0 | _ => return 1 } }
def bracedLambda : +U (+{Unit, Unit} -> -F Bool) ;
def bracedLambda = thunk { fun (b) { match b { | +{.0 = u} => return +{.1 = u} | +{.1 = u} => return +{.0 = u} } } } ;
def atomLambda : +U (Bool -> -F Bool) ;
def atomLambda = thunk { fun (b) { match b { | +{.0 = u} => return +{.1 = u} | +{.1 = u} => return +{.0 = u} } } } ;
