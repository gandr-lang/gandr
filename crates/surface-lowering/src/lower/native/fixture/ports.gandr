data Expr : Type where {
  | Lit : (n : Integer) --> Expr
  | Share : (e : Expr) --> (left : Expr, right : Expr)
  | Add : (a : Expr, b : Expr) --> Expr
}

def left : Expr;
def left = Share(Lit(1)).left;

def both : Expr;
def both = Add(Share(Lit(1)).left, Share(Lit(1)).right);

def apart : Path(Expr, Share(Lit(1)).left, Share(Lit(1)).right);
def apart = Path.here(Share(Lit(1)).left);

def whole : #{left : Expr, right : Expr};
def whole = Share(Lit(1));

def unpacked() -> -F Expr { match Share(Lit(1)) { #{.left = l, .right = r} => return Add(l, r) } }

def middle : Expr;
def middle = Share(Lit(1)).middle;

def matched(e : Expr) -> -F Integer { match e { Share(x) => return 0, _ => return 1 } }

def measured(e : Expr) -> -F Integer {
  match e { Lit(n) => return n, Add(a, b) => return 2, Share(x).left => return 3, Share(x).right => return 4 }
}

def partial(e : Expr) -> -F Integer {
  match e { Lit(n) => return n, Add(a, b) => return 2, Share(x).left => return 3 }
}

data Tree : Type where {
  | Tip : (n : Integer) --> Tree
  | Split : (t : Tree) --> (front : Tree, back : Tree)
  oper prune : (t : Tree) --> Tree;
  rule : prune(Tip(n)) ==> Tip(n);
  rule : prune(Split(t).front) ==> prune(t);
  rule : prune(Split(t).back) ==> prune(t);
}

data Pair(a : Type) : Type where {
  | Leaf : (x : a) --> Pair(a)
  | Dup : (p : Pair(a)) --> (one : Pair(a), two : Pair(a))
}

def first : Pair(Integer);
def first = Dup(Leaf(1)).one;

def doubled : #{one : Pair(Integer), two : Pair(Integer)};
def doubled = Dup(Leaf(1));

def mismatched : #{one : Pair(Integer), two : Pair(String)};
def mismatched = Dup(Leaf(1));

data Buffer : Type where {
  | Whole : (n : Integer) --> Buffer
  | Halve : (b[1] : Buffer) --> (front : Buffer, back : Buffer)
}

data Twice : Type where {
  | One : Twice
  | Fork : (t : Twice) --> (out : Twice, out : Twice)
}
