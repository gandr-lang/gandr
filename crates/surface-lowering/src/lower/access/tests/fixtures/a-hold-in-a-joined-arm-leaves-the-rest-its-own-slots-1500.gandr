data Nat : Type where { | Zero : Nat | Succ : (n : Nat) --> Nat }
def joined(n : Nat) -> -F Integer {
  var c = 100;
  let m = match n { | Zero => return 7 | Succ(p) => { var c = *{}; pure 1 } };
  pure c
}
def joined_by_hand(n : Nat) -> -F Integer {
  var c = 100;
  match n { | Zero => return 7 | Succ(p) => { var d = *{}; pure c } }
}
