module Counter where {
  def read(self : shared Integer) -> -F Integer { pure self }
  def bump(self : Integer, by : Integer) -> -F Unit {
    access self as v { resume(v, v + by) }
  }
  def spend(self : consumed Integer) -> -F Integer { pure self + 1 }
}
def used() -> -F Integer {
  var s = 1;
  let n = s.read ();
  let _ = s.bump 2;
  let m = s.spend ();
  pure n + m
}
