@[builtin("string.join")]
def unrowed : (a : String, b : String) -> String;

@[builtin("string.append")]
def bodied(a : String, b : String) -> String = a

@[builtin("string.append")]
def narrow : (a : String) -> String;

@[builtin("string.append")]
def first : (a : String, b : String) -> String;

@[builtin("string.append")]
def second : (a : String, b : String) -> String;