data Nat : Type where { | Zero : Nat | Succ : (n : Nat) --> Nat }
def applyAt[i : Size](f : Nat[< i] -> Nat, x : Nat[< i]) -> Nat { f x }
def apply2[j : Size](
  g : (Nat[< j] -> Nat, Nat[< j]) -> Nat,
  f : Nat[< j] -> Nat,
  x : Nat[< j]
) -> Nat { become g f x }
def passAt[k : Size](f : Nat[< k] -> Nat, x : Nat[< k]) -> Nat {
  become apply2[.j = k] applyAt[.i = k] f x
}
