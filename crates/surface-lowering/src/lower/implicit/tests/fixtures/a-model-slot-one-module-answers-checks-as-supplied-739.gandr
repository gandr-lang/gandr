theory Counter where {
  sort C : Type;
  oper zero : C;
  oper incr : (c : C) --> C;
  oper read : (c : C) --> Integer;
}
theory ResetCounter where {include Counter; oper reset : (c : C) --> C;}
module Up : Model(Counter) where {
  type C = Integer;
  def zero = 0;
  def incr(c : Integer) -> Integer { c + 1 }
  def read(c : Integer) -> Integer { c }
}
module Flips : Model(ResetCounter) where {
  type C = Bool;
  def zero = false;
  def incr(c : Bool) -> Bool { match c { | true => false | false => true } }
  def read(c : Bool) -> Integer { match c { | true => 1 | false => 0 } }
  def reset(c : Bool) -> Bool { false }
}
def stepped[s : Model Counter](c : s.C) -> Integer { s.read (s.incr c) }
def counted() -> Integer { stepped 4 }
def flipped() -> Integer { stepped (false : Bool) }
