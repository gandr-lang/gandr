def named[m : Type, combine : +U (m -> -F m)](x : m) -> m = become combine x;
def bare[m : Type, combine : +U (m -> -F m)](x : m) -> m = become combine x;
def twin(m : Type, combine : +U (m -> -F m), x : m) -> m = become combine x;
def keyed[c : +U (t -> -F t)](t : Type, v : t) -> t = become c v;
def keyedTwin(t : Type, c : +U (t -> -F t), v : t) -> t = become c v;
