def named(m : Integer) -> (q : Integer, r : String) { return m }
def unnamed(m : Integer) -> (Integer, String) { return m }
def none(m : Integer) -> () { return m }
def one(m : Integer) -> (q : Integer) { return m }
def bare(m : Integer) -> Integer { return m }
def grouped(m : Integer) -> (Integer) { return m }
def dependent(m : Integer) -> (a : Type, x : a) { return m }
def explicit(m : Integer) -> -F (Integer, String) { return m }
def signed : +U (Integer -> -F (Integer, String));
