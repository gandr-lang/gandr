module Base where { type Ask = ?Integer >> end; }
module Gate :> *{ type T } where { type T = end; }
type Local = !Integer >> end;
type Again = Local;
type Count = Integer;
def asked(seat : Base.Ask) -> -F Unit { let n = recv seat; close seat }
def sent(seat : Local) -> -F Unit { send seat 1; close seat }
def again(seat : Again) -> -F Unit { send seat 2; close seat }
def counted(n : Count) -> -F Integer { pure n }
def sealed(seat : Gate.T) -> -F Unit { close seat }
