data Nat : Type where { | Zero : Nat | Succ : (n : Nat) --> Nat }
def forked(n : Nat) -> Unit {
  let d = fork (c : end) { close c };
  close d;
  let m = match n { | Zero => return *{} | Succ(p) => pure *{} };
  m
}
def forked_by_hand(n : Nat) -> Unit {
  let d = fork (c : end) { close c };
  close d;
  match n { | Zero => *{} | Succ(p) => *{} }
}
def offered(n : Nat) -> Unit {
  let d = fork (c : +{go : end}) { select c go; close c };
  offer d {
    | go => { close d; let m = match n { | Zero => return *{} | Succ(p) => pure *{} }; m }
  }
}
def offered_by_hand(n : Nat) -> Unit {
  let d = fork (c : +{go : end}) { select c go; close c };
  offer d { | go => { close d; match n { | Zero => *{} | Succ(p) => *{} } } }
}
