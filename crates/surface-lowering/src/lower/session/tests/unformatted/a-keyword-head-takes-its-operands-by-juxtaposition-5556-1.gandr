def spoken() -> -F Unit {
  let desk = fork (seat : ?Integer >> !Integer >> end) {
    let asked = recv(seat);
    send seat (asked + 1);
    close(seat)
  };
  send desk 1;
  let answer = recv desk;
  close desk
}
def counted() -> -F Integer {
  var c = 0;
  access c as v { resume v (v + 1) };
  access c as w { abort(w) } unwind { pure *{} };
  return c
}
