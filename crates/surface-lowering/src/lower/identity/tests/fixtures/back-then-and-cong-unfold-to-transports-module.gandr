def flip(a : Integer, b : Integer, p : Path[.A = Integer](a, b)) -> -F Path[.A = Integer](b, a) {
  become Path.back p
}
def join(
  a : Integer,
  b : Integer,
  c : Integer,
  p : Path[.A = Integer](a, b),
  q : Path[.A = Integer](b, c)
) -> -F (Path[.A = Integer](a, c)) {
  become Path.step p q
}
def dbl(x : Integer) -> -F Integer {
  become x + x
}
def image(a : Integer, b : Integer, p : Path[.A = Integer](a, b)) -> -F Path[.A = Integer](
  dbl a,
  dbl b
) {
  become Path.ap dbl p
}
