data S2 : Type where
  | Base2 : S2
  | surf : Path.here Base2 <-> Path.here Base2

def sphereId(x : S2) -> S2 =
  match x where
    | Base2 => Base2
    | surf => surf

def apHere : Path[.A = Path[.A = S2](sphereId Base2, sphereId Base2)](
  Path.ap sphereId (Path.here Base2),
  Path.ap sphereId (Path.here Base2)
) = Path.here (Path.ap sphereId (Path.here Base2));

def apHereTwice : Path[.A = Path[.A = Path[.A = S2](sphereId Base2, sphereId Base2)](
  Path.ap sphereId (Path.here Base2),
  Path.ap sphereId (Path.here Base2)
)](
  Path.ap sphereId (Path.here (Path.here Base2)),
  Path.ap sphereId (Path.here (Path.here Base2))
) = Path.here (Path.ap sphereId (Path.here (Path.here Base2)));
