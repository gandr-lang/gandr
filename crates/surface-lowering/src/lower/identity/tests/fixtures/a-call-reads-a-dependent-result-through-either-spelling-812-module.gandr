data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
}
def up(n : Int) -> Int {
  S n
}
def sugared : (a : Int) -> Path[.A = Int](a, a);
def thunked : (a : Int) -> Path[.A = Int](a, a);
def overSugared(a : Int) -> Path[.A = Int](S a, S a) {
  Path.step (Path.ap up (sugared a)) (Path.here (S a))
}
def overThunked(a : Int) -> Path[.A = Int](S a, S a) {
  Path.step (Path.ap up (thunked a)) (Path.here (S a))
}
def pair : (Int, b : Int) -> Path[.A = Int](b, b);
def overPair(a : Int, b : Int) -> Path[.A = Int](S b, S b) {
  Path.step (Path.ap up (pair a b)) (Path.here (S b))
}
