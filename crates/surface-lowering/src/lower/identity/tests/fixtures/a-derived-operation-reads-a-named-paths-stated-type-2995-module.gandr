data Circle : Type where {
  | Base : Circle
  | loop : Base <-> Base
}
def named : Path[.A = Circle](Base, Base) = loop;
def flipped : Path[.A = Circle](Base, Base) = Path.back named;
def round : Path[.A = Circle](Base, Base) = Path.step named (Path.back named);
def unstated = loop;
def overUnstated : Path[.A = Circle](Base, Base) = Path.back unstated;
