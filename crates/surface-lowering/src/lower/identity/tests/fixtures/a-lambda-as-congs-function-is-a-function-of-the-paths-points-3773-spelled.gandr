def whiskered(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path[.A = A](x, y),
  f2 : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f1, f2),
  g : Path[.A = A](y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step f1 g, Path.step f2 g) {
  Path.walk
    (fun (b) { type(Path[.A = Path[.A = A](x, z)](Path.step f1 g, Path.step b g)) })
    a
    (Path.here (Path.step f1 g))
}
