data Circle : Type where {
  | Base : Circle
  | loop : Base <-> Base
}
data Int : Type where {
  | Z : Int
}
def explicit(f : Circle -> Int) -> Path[.A = Int](f Base, f Base) {
  Path.back (Path.ap f loop)
}
def sugared(f : Circle -> Int) -> Path[.A = Int](f Base, f Base) {
  Path.back (Path.ap f loop)
}
def grouped(f : (Circle -> Int)) -> Path[.A = Int](f Base, f Base) {
  Path.back (Path.ap f loop)
}
