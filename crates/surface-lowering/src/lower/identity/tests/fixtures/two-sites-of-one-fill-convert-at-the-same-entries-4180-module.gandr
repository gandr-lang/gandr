def composite(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z)
) -> Path[.A = A](x, z) {
  Path.step f g
}
def composedCells(A : Type, x : A, y : A, z : A) -> Path[.A = A](x, y) -> (Path[.A = A](
  y,
  z
) -> Path[.A = A](x, z)) {
  thunk { fun (f) { thunk { fun (g) { composite A x y z f g } } } }
}
def cellsTwo(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  p : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f, p),
  g : Path[.A = A](y, z),
  q : Path[.A = A](y, z),
  b : Path[.A = Path[.A = A](y, z)](g, q)
) -> Path[.A = Path[.A = A](x, z)](Path.step f g, Path.step p q) {
  fill[5, 7] (chain 2) (composedCells A x y z) (a, b)
}
def cellsAgain(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  p : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f, p),
  g : Path[.A = A](y, z),
  q : Path[.A = A](y, z),
  b : Path[.A = Path[.A = A](y, z)](g, q)
) -> Path[.A = Path[.A = A](x, z)](Path.step f g, Path.step p q) {
  fill[5, 7] (chain 2) (composedCells A x y z) (a, b)
}
def sitesConvert(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  p : Path[.A = A](x, y),
  a : Path[.A = Path[.A = A](x, y)](f, p),
  g : Path[.A = A](y, z),
  q : Path[.A = A](y, z),
  b : Path[.A = Path[.A = A](y, z)](g, q)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step f g, Path.step p q)](
  cellsTwo A x y z f p a g q b,
  cellsAgain A x y z f p a g q b
) {
  Path.here (cellsTwo A x y z f p a g q b)
}
