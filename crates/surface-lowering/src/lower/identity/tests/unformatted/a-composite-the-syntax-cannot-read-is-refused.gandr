def unary{telescope} -> Path[.A = A](x, x) {{
  compose[1, 3] (chain 1)
}}
def cycled{telescope} -> Path[.A = A](x, x) {{
  compose[1, 3] (cycle 1) p
}}
def counted{telescope} -> Path[.A = A](x, x) {{
  compose[1, 3] 1 p
}}
def named{telescope} -> Path[.A = A](x, x) {{
  compose[1, 3] (chain m) p
}}
