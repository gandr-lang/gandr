def regions() -> -F Unit = effect c : std.process.Exit.Eff {{ effect e : std.process.Exit.Eff {{ let d : Cap[exit] at c = c ; let f : Cap[exit] at e = e ; pure *{{}} }} {clauses} }} {clauses};
