{STATE}{GET_GET}def once() -> -F Integer = effect st : StateGetGet with sort S = Integer {subject} handle {{ | pure(x) => pure x | oper get(k) => k 4 }};
def twice() -> -F Integer = effect st : State with sort S = Integer {subject} handle {{ | pure(x) => pure x | oper get(k) => k 4 | oper put(s, k) => k *{{}} }};
