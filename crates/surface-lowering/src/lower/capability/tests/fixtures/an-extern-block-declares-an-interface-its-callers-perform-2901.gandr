extern "rust" from "boundary" as Boundary {
  def add(x : u32, n : u32) -> u32;
  def negate(x : i64) -> i64;
}
extern "rust" from "idle" as Idle { def peek(x : u64) -> u64; }
def twice(x : u32) -> -F [Boundary] u32 { let y = Boundary.add x x; Boundary.add y y }
def flipped(x : i64) -> -F [Boundary] i64 { Boundary.negate x }
def missing(x : u32) -> -F [Boundary] u32 { Boundary.sub x x }
