def ring() -> -F Unit = effect r : std.io.Ring.Eff {
  let b = r.alloc 4096
  r.free b
} handle { | pure(x) => pure x | oper alloc(n, b, k) => k b | oper free(b, k) => k *{} };
def named() -> -F Unit = effect c : std.process.Exit.Eff { let code = c.exit 1; pure code } handle {
  | pure(x) => pure x
  | oper exit(code, k) => k *{}
};
