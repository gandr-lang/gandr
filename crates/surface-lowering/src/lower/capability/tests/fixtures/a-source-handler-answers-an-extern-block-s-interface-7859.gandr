extern "rust" from "boundary" as Boundary {
  def add(x : u32, n : u32) -> u32;
}

def quadrupled(x : u32) -> [Boundary] u32 =
  let y = Boundary.add x x
  Boundary.add y y

def mocked() -> u32 =
  handle b : Boundary { quadrupled 21u32 } with {
    | pure(r) => r
    | oper add(p, k) => k (u32.wrapping_add p.0 p.1)
  }

def lacked() -> u32 =
  handle b : Boundary { quadrupled 21u32 } with {
    | pure(r) => r
    | oper add(p, k) => k (u32.wrapping_add p.0 p.1)
    | oper sub(p, k) => k p.0
  }

def miscounted() -> u32 =
  handle b : Boundary { quadrupled 21u32 } with {
    | pure(r) => r
    | oper add(k) => k 0u32
  }
