def one() -> Integer = 1;
def became() -> -F Integer = effect c : std.process.Exit.Eff {
  become one
} handle { | pure(x) => pure x | oper exit(code, k) => k *{} };
def broke() -> -F Integer = loop {
  effect c : std.process.Exit.Eff {
    break(1)
  } handle { | pure(x) => pure x | oper exit(code, k) => k *{} }
};
def again() -> -F Integer = loop {
  effect c : std.process.Exit.Eff {
    continue
  } handle { | pure(x) => pure x | oper exit(code, k) => k *{} }
};
def inner() -> -F Integer = effect c : std.process.Exit.Eff {
  let v = loop { break(5) }
  pure v
} handle {
  | pure(x) => pure x
  | oper exit(code, k) => k *{}
};
