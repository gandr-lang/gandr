theory Cat where {
  sort Ob : Type;
  sort Hom(dom : Ob, cod : Ob) : Type;
  oper id : (a : Ob) --> Hom(a, a);
  oper comp : (f : Hom(a, b), g : Hom(b, c)) --> Hom(a, c);
  rule unitL : comp (id a) f ==> f;
}
theory Add where {
  sort Nat : Type;
  oper add : (Nat, Nat) --> Nat;
  rule cong1 : (rule p : x ==> x′, data x : Nat, data y : Nat) ==> (z : Nat) {
    node : p(x) ==> (x′);
    node : add(x′, y) --> (z);
  };
}
