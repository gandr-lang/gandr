theory State where {
  sort S : Type+;
  sort C : Type;
  oper get : (k : pi+ (s : S). C) --> C;
  oper put : (s : S, k : C) --> C;
}
theory Typed where {
  sort VTy : Type;
  sort CTy : Type;
  sort VTm(a : VTy) : Type+;
  sort CTm(b : CTy) : Type;
  oper lam : (t : pi+ (x : VTm a). CTm b) --> CTm b;
}
def state : Model State with sort S = Integer;
def stated : *{c : Type, get : +U (+U (Integer -> -F c) -> -F c), put : +U (Integer -> c -> -F c)};
def typed : Model Typed;
def written : *{
  vty : Type,
  cty : Type,
  vtm : +U (vty -> -F Type),
  ctm : +U (cty -> -F Type),
  lam : +U ((a : vty) -> (b : cty) -> +U (vtm(a) -> -F ctm(b)) -> -F ctm(b))
};
