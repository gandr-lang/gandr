theory Named where {
  @[ inert ]
  oper name : String;
  oper greeting : String;
}
module Hello : Model(Named) where {
  def name = "hello";
  def greeting = "hi";
}
@[ inert ]
def nameOf(n : Model(Named)) -> String { n.name }
@[ inert ]
def helloName = Hello.name;
@[ inert ]
def echoed = helloName;
@[ inert ]
def renamed(n : Model(Named)) -> String { nameOf (n) }
def shown = helloName;
def called(n : Model(Named)) -> String { nameOf (n) }
module Marked where {
  @[ inert ]
  def kept = "kept";
}
