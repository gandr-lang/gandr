theory Pairing where {
  sort A : Type;
  sort B : Type;
  oper left : A;
  oper right : B;
}
def any(m : Model Pairing) -> Model Pairing { m }
def both(m : Model Pairing with sort A = Integer with sort B = Unit) -> Model Pairing {
  become any m
}
def first(m : Model Pairing with sort A = Integer) -> Model Pairing {
  become any m
}
def second(y : Type, m : Model Pairing with sort B = y) -> Model Pairing {
  become any m
}
def again(m : Model Pairing with sort A = Unit) -> Model Pairing {
  become any m
}
