theory Scoped where {
  sort C : Type;
  sort T(g : C) : Type;
  sort M(g : C, a : T g) : Type;
  oper ext : (g : C, a : T g) --> C;
  oper wk : (g : C, a : T g) --> T ext(g, a);
  oper q : (g : C, a : T g) --> M ext(g, a) wk(g, a);
}
def derived : Model Scoped;
def written : *{
  c : Type,
  t : +U (c -> -F Type),
  m : +U ((g : c) -> t(g) -> -F Type),
  ext : +U ((g : c) -> t(g) -> -F c),
  wk : +U ((g : c) -> (a : t(g)) -> -F t(ext(g, a))),
  q : +U ((g : c) -> (a : t(g)) -> -F m(ext(g, a), wk(g, a)))
};
