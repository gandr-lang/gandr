theory Pairing where {
  sort A : Type;
  sort B : Type;
  oper left : A;
  oper right : B;
}
theory Counter where {
  sort C : Type;
  oper zero : C;
}
def any(m : Model(Pairing)) -> -F Model(Pairing) { return m }
def inserted(m : Model(Pairing) with sort A = Integer with sort B = Unit) -> -F Model(Pairing) {
  become any m
}
def written(m : Model(Pairing) with sort A = Integer with sort B = Unit) -> -F Model(Pairing) {
  become forget[sort B = Unit, sort A = Integer](m) at Model(Pairing)
}
def unfixed(m : Model(Counter)) -> -F Model(Counter) {
  become forget[sort C = Integer](m) at Model(Counter)
}
