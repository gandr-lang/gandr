theory Counter where {
  sort C : Type;
  oper start : () --> C;
  oper step : (c : C) --> C;
  oper read : (c : C) --> Integer;
}
module Open : Model(Counter) where {
  type C = Integer;
  def start() -> -F Integer { 0 }
  def step(n : Integer) -> -F Integer { become n + 1 }
  def read(n : Integer) -> -F Integer { n }
}
