theory M.Shape where {
  oper a : String;
}

def shapeOf(presented : Theory) -> -F Type =
  match presented where
    | Theory.Presents(sorts, opers, rules) => return String
    | _ => return Bool

def qualified : shapeOf(M.Shape) = "a";

def mistyped : shapeOf(M.Shape) = true;

def absent : shapeOf(M.Absent) = "a";
