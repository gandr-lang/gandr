module M where {
  def empty() -> Type { return Integer } def same(a : Type) -> Type {
    return a
  } def after(a : Type) -> Integer -> Type = return fun (x) { a };
}
def none(x : M.empty()) -> Integer { x }
def one(x : M.same(Integer)) -> Integer { x }
def twice(n : Integer, x : M.after(Integer)(n)) -> Integer { x }
def other(x : M.same(Integer)) -> String { x }
