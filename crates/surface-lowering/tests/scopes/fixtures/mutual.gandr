data Nat : Type where {
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
}
rec {
  data Rose : Type where { | Node : (kids : Forest) --> Rose }
  data Forest : Type where { | Empty : Forest | More : (head : Rose, tail : Forest) --> Forest }
  def rec size(t : Rose) -> Nat {
    match t { | Node(kids) => { let s = sizes[<] kids; Succ s } }
  }
  def rec sizes(ts : Forest) -> Nat {
    match ts { | Empty => Zero | More(t, rest) => { let a = size[<] t; sizes[<] rest } }
  }
}
