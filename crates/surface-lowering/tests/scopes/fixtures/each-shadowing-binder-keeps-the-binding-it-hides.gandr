data Nat : Type where {
  | Zero : Nat
  | Succ : (n : Nat) --> Nat
}
def answer : Integer = 1;
module Counting where {
  def two = 2;
}
def rec shadowed(n : Nat, m : Nat) -> -F Nat {
  match m {
    | Zero => return n
    | Succ(n) => return n
  }
}
def hides(answer : Integer) -> -F Integer { return answer }
def opened() -> -F Integer { import Counting; let two = 3; return two }
def ahead(after : Integer) -> -F Integer { return after }
def after : Integer = 4;
