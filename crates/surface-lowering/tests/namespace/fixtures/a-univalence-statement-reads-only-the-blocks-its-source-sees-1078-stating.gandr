theory Magma where {
  sort M : Type;
  oper mul : (x : M, y : M) --> (z : M);
  oper one : () --> (z : M);
}
def exchange(b : Bool) -> Bool {
  match b {
    | true => +{.1 = *{}}
    | false => +{.0 = *{}}
  }
}
def keep(e : +{Unit}) -> +{Unit} {
  e
}
def unnamed = ua[1, 4] Monoid Magma (*{mul = exchange, one = keep}) (*{mul = exchange, one = keep});
