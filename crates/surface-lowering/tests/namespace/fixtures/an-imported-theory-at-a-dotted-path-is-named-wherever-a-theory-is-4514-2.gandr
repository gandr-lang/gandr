import "./store.gandr";
def read() -> [st : Store.Eff with sort S = Integer] Integer { st.get () }
def scoped() -> Integer {
  handle st : Store.Eff with sort S = Integer {
    read ()
  } with { | pure(x) => pure x | oper get(k) => k 4 }
}
module Fixed : Model(Store.Eff) with sort S = Integer where {
  type C = Integer;
  def get(k : Integer -> Integer) -> Integer { k 4 }
}
def answered() -> Integer { handle st : Store.Eff with sort S = Integer { read () } with Fixed }
theory Marks where {
  sort C : Type;
  oper mark : (k : C) --> C;
  rule kept : mark (mark k) <=> mark k where {| under [Store.Eff | r]};
}
