import "./base.gandr";
def appliedAgain[k : Size](f : Nat[< k] -> Nat, x : Nat[< k]) -> -F Nat {
  applyAt[.i = k] f x
}
def crossedAgain[r : Region](k : (() -> Integer) at r) -> -F Integer {
  force k
}
def fixed[s : Model(Counter) with sort C = Integer](c : Integer) -> -F Integer {
  s.read (s.incr (c + s.zero))
}
def omittedAgain() -> -F Integer { stepped 5 }
def forgetfulAgain() -> -F Integer {
  handle st : StatePutLaws with sort S = Integer {
    st.put 2;
    st.get ()
  } with { | pure(x) => pure x | oper get(k) => k 4 | oper put(s, k) => k *{} }
}
data Bit : Type where {
  | Off : Bit
  | On : Bit
  oper not : (a : Bit) --> Bit;
  rule : not Off ==> On;
  rule : not On ==> Off;
}
