pub def shown : Integer;
def shown = 2;
def hidden : Integer;
pub def hidden = 1;
@[ checks ]
pub def checked : Integer;
def checked = 4;
pub @[ checks ]
def early : Integer;
def early = 5;
def secret = 3;
pub data Bit : Type where { | O : Bit }
data Hid : Type where { | H : Hid }
pub theory Pointed where {
  sort P : Type;
  oper pt : () --> P;
}
theory Closed where {
  sort Q : Type;
  oper qt : () --> Q;
}
pub module Open where { def x = 6; }
module Shut where { def y = 7; }
pub module Methods where { def width(self : shared Integer) -> -F Integer { pure self } }
module Hidden where { def depth(self : shared Integer) -> -F Integer { pure self } }
