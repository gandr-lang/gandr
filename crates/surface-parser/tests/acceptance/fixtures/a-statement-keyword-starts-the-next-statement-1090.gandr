def swapped() -> -F Unit = {
  effect c : Proc {
    effect e : Proc {
      let d : Cap[exit] at e c ;
      let f : Cap[exit] at c = e ;
      return *{}
    } handle {
      | pure(x) => return x
      | oper exit(code, k) => return *{}
    }
  } handle {
    | pure(x) => return x
    | oper exit(code, k) => return *{}
  }
};
