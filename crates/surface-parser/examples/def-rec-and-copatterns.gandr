def rec fact(n: Integer) -> F Integer {
  fact[<](n)
}

def rec nats(n: Integer) -> Stream(Integer) {
  .head => n,
  .tail => nats[>](plus(n, 1))
}

def rec loopy(n: Integer) -> Stream(Integer) {
  .head => n,
  _ => nats(n)
}

def rec measured(n: Integer) -> F Integer { ret measured[n <](n) }
def rec explicit(n: Integer) -> F Integer { ret explicit[n = 1](n) }
def rec sized(n: Integer) -> F Integer { ret sized[size = 1](n) }
def rec bounded(n: Integer) -> F Integer { ret bounded[cost = 1](n) }
def rec tailing(n: Integer) -> F Integer { ret tailing[tail](n) }
