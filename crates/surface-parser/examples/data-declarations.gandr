data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

data Maybe(a : Type) : Type {
  None : Maybe(a);
  Some : (x : a) --> Maybe(a);
}

data Tree(a : Type) : Type {
  Leaf : Tree(a);
  Node : (l : Tree(a), x : a, r : Tree(a)) --> Tree(a);
}

data Vec(a : Type) : Nat -> Type {
  Nil : Vec(a, 0);
  Cons : (n : Nat, x : a, xs : Vec(a, n)) --> Vec(a, 1 + n);
}

data Empty : Type {}
