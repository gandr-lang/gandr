// A width enters the randomness of std at a draw. `std.rand.lcg` sends each
// draw it cannot answer to the model outside it. The exact model refuses a
// width outside 1 to 64 by name, and answers a narrower draw.

// The seeded generator, a model of the host interface of randomness.
import std.rand (lcg);
// The multiplier of the multiply-shift family.
import std.hash (multiplier);
// The key of the one-time pad.
import std.crypto (key);

/// A draw of no bits under the generator.
@[ distributes("1 0") ]
def empty() -> [std.rand.Eff] Integer =
  lcg 8 0 (thunk { std.rand.draw 0 })

/// A draw of 65 bits under the generator.
@[ distributes("1 0") ]
def wide() -> [std.rand.Eff] Integer =
  lcg 8 0 (thunk { std.rand.draw 65 })

/// A generator of 70 bits.
@[ distributes("1 0") ]
def wideGenerator() -> [std.rand.Eff] Integer =
  lcg 70 0 (thunk { std.rand.draw 2 })

/// A key of 65 bits.
@[ distributes("1 0") ]
def wideKey() -> [std.rand.Eff] Integer =
  key 65

/// A multiplier of no bits.
@[ distributes("1 0") ]
def emptyMultiplier() -> [std.rand.Eff] Integer =
  multiplier 0

/// A draw of 2 bits under a generator of 1 bit: the exact model answers it.
@[ distributes(("1/4 0", "1/4 1", "1/4 2", "1/4 3")) ]
def passedOn() -> [std.rand.Eff] Integer =
  lcg 1 0 (thunk { std.rand.draw 2 })
