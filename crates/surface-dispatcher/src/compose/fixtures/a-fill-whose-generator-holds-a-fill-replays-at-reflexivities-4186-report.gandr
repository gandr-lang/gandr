/// The composite of two paths, whose type states its endpoints.
def join(
  A : Type,
  x : A,
  y : A,
  z : A,
  p : Path[.A = A](x, y),
  q : Path[.A = A](y, z)
) -> Path[.A = A](x, z) {
  Path.step p q
}
/// The composite of two cells, one cell at a time.
def composedCells(A : Type, x : A, y : A, z : A) -> Path[.A = A](x, y) -> (Path[.A = A](
  y,
  z
) -> Path[.A = A](x, z)) {
  thunk { fun (f) { thunk { fun (g) { join A x y z f g } } } }
}
/// The composite's reflexivity by `fill`, at its sides.
def selfFill(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path[.A = A](x, y),
  g : Path[.A = A](y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step f g, Path.step f g) {
  fill[5, 7] (chain 2) (composedCells A x y z) (Path.here f, g)
}
/// That reflexivity, one cell at a time: a generator whose body is a fill.
def selfFillOver(A : Type, x : A, y : A, z : A) -> (f : Path[.A = A](x, y)) -> ((g : Path[.A = A](
  y,
  z
)) -> Path[.A = Path[.A = A](x, z)](Path.step f g, Path.step f g)) {
  thunk { fun (f) { thunk { fun (g) { selfFill A x y z f g } } } }
}
/// The right whisker the outer fill lifts by.
def liftRight(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path[.A = A](y, z)
) -> Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fp g) {
  Path.walk
    (fun (c) { type(Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step c g)) })
    fa
    (Path.here (Path.step fm g))
}
/// The outer fill, its generator's body a fill.
def nestedFill(
  A : Type,
  x : A,
  y : A,
  z : A,
  fm : Path[.A = A](x, y),
  fp : Path[.A = A](x, y),
  fa : Path[.A = Path[.A = A](x, y)](fm, fp),
  g : Path[.A = A](y, z)
) -> Path[.A = Path[.A = Path[.A = A](x, z)](Path.step fm g, Path.step fp g)](
  Path.step (selfFill A x y z fm g) (liftRight A x y z fm fp fa g),
  Path.step (liftRight A x y z fm fp fa g) (selfFill A x y z fp g)
) {
  fill[5, 7] (chain 2) (selfFillOver A x y z) (fa, g)
}
/// The nested fill at reflexivities.
def nestedAtHere(A : Type, x : A) -> Path[.A = Path[.A = Path[.A = Path[.A = A](x, x)](
  Path.step (Path.here x) (Path.here x),
  Path.step (Path.here x) (Path.here x)
)](
  Path.here (Path.step (Path.here x) (Path.here x)),
  Path.here (Path.step (Path.here x) (Path.here x))
)](
  nestedFill A x x x (Path.here x) (Path.here x) (Path.here (Path.here x)) (Path.here x),
  Path.here (Path.here (Path.step (Path.here x) (Path.here x)))
) {
  Path.here (Path.here (Path.here (Path.step (Path.here x) (Path.here x))))
}
