def kept(n : Integer) -> Integer { n }
def bound(n : Integer) -> Integer { kept (kept n) }
def nested(n : Integer) -> Integer { kept (kept n) }
def nested_printed(a : Integer) -> Integer { kept (kept a) }
def written(n : Integer) -> Integer { kept (run kept n) }
def written_printed(a : Integer) -> Integer { kept (run kept a) }
