def kept(n : Integer) -> Integer { n }
def kept_elided(n : Integer) -> Integer { n }
def kept_printed(a : Integer) -> Integer { a }
def called(n : Integer) -> Integer { become kept n }
def called_elided(n : Integer) -> Integer { kept n }
def called_printed(a : Integer) -> Integer { kept a }
def sequenced(n : Integer) -> Integer { become kept (kept n) }
def sequenced_elided(n : Integer) -> Integer { kept (kept n) }
def sequenced_printed(a : Integer) -> Integer { kept (kept a) }
def suspended(n : Integer) -> () -> Integer { thunk { become kept n } }
def suspended_elided(n : Integer) -> () -> Integer { thunk { kept n } }
def suspended_printed(a : Integer) -> (() -> Integer) { thunk { kept a } }
