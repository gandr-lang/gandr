data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) ==> x;
  rule : P (S x) ==> x;
}
def rec tell(n : Int) -> -F Int {
  match n {
    | Z => Z
    | S(x) => S (tell[<] x)
    | P(x) => P (tell[<] x)
  }
}
def one : Integer;
def one = 1;
def owed : Integer;
def lost = nowhere;
def bad : Integer;
def bad = "bad";
