data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) ==> x;
  rule : P (S x) ==> x;
}
def rec dbl(n : Int) -> Int =
  match n { | Z => Z | S(x) => S (S (dbl[<] x)) | P(x) => P (P (dbl[<] x)) }
def rec bound(n : Int) -> Int =
  match n where
    | Z => Z
    | S(x) => S (S (bound[<] x))
    | P(x) => P (P (bound[<] x))
