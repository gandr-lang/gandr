theory Cat where {
  sort Ob : Type;
  sort Hom(dom : Ob, cod : Ob) : Type;
  oper id : (a : Ob) --> Hom a a;
  oper comp : (f : Hom a b, g : Hom b c) --> Hom a c;
  rule unitL : comp (id a) f <=> f;
}

module Fns : Model(Cat) where {
  type Ob = Type;
  type Hom(a : Ob, b : Ob) = a -> b;
  def ident(t : Type, x : t) -> t { x }
  def compose(
    t : Type,
    u : Type,
    v : Type,
    f : t -> u,
    g : u -> v,
    x : t
  ) -> v {
    become g (f x)
  }
  def id(t : Type) -> t -> t { thunk { become ident t } }
  def comp(
    t : Type,
    u : Type,
    v : Type,
    f : t -> u,
    g : u -> v
  ) -> t -> v {
    thunk { become compose t u v f g }
  }
  def unitL(p : Type, q : Type, f : p -> q) -> Path[.A = (p -> q)](
    comp p p q (id p) f,
    f
  ) {
    Path.here f
  }
}
