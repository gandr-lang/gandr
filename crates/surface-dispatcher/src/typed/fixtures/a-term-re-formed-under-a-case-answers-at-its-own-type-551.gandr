def made(
  a : Type,
  b : Type,
  i : *{
    to : a -> b,
    back : b -> a,
    sect : (x : a) -> Path[.A = a](back (to x), x),
    retr : (y : b) -> Path[.A = b](to (back y), y)
  }
) -> *{
  to : a -> b,
  linv : *{g : b -> a, sect : (x : a) -> Path[.A = a](g (to x), x)},
  rinv : *{h : b -> a, retr : (y : b) -> Path[.A = b](to (h y), y)}
} {
  match i {
    | *{t, k, s, r} => *{t, *{*{k, s}, *{k, r}}}
  }
}
