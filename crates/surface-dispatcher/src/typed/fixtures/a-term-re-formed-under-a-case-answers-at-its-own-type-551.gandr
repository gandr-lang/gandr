def made(
  a : Type,
  b : Type,
  i : *{
    to : +U (a -> -F b),
    back : +U (b -> -F a),
    sect : (x : a) -> Path[.A = a](back (to x), x),
    retr : (y : b) -> Path[.A = b](to (back y), y)
  }
) -> -F *{
  to : +U (a -> -F b),
  linv : *{g : +U (b -> -F a), sect : (x : a) -> Path[.A = a](g (to x), x)},
  rinv : *{h : +U (b -> -F a), retr : (y : b) -> Path[.A = b](to (h y), y)}
} {
  match i {
    | *{t, k, s, r} => *{t, *{*{k, s}, *{k, r}}}
  }
}
