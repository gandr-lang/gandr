data N : Type where {
  | Z : N
  | S : (n : N) --> N
}

data T : Type where {
  | V : T
}

def ext(g : N) -> N { S g }

def k(g : N, t : T) -> T { t }

def w : *{
  c : Type,
  tm : c -> Type,
  e : c -> c,
  a : (g : c, tm(e(g))) -> tm(g),
  b : (g : c, tm(e(g))) -> tm(g)
} = *{N, *{fun (g) { return T }, *{ext, *{k, k}}}};
