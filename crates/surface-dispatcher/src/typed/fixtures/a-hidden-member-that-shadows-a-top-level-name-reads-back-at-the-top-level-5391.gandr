theory Fam where { sort Con : Type; oper base : Con; }
def first(_n : Integer) -> Type { return Integer }
def wrap(x : first(1)) -> first(1) { return x }
module Left : Model(Fam) where
  type Con = Type;
  def base() -> Type { return Unit }
  def first(_n : Integer) -> Type { return Bool }
  def held(x : first(1)) -> first(1) { return x }
  def u = wrap;
def after(n : Integer) -> Integer { return n }
