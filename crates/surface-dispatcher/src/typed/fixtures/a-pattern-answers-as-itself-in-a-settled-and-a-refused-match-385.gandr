data Circle : Type where {
  | Base : Circle
  | loop : Base <-> Base
}

data Int : Type where {
  | Z : Int
  | S : (x : Int) --> Int
  | P : (x : Int) --> Int
  rule : S (P x) <=> x;
  rule : P (S x) <=> x;
}

def tell(p : Path[.A = Circle](Base, Base)) -> Integer {
  match p {
    | here => 0
    | loop ∷ q => 1
    | back(loop) ∷ q => 2
  }
}

def rec spin(n : Int) -> Path[.A = Circle](Base, Base) {
  match n {
    | Z => Path.here Base
    | S(x) => loop ∷ spin[<] x
    | P(x) => back (loop) ∷ spin[<] x
  }
}

def flip(x : Circle) -> Circle {
  match x {
    | Base => Base
    | loop => Path.back (loop)
  }
}
