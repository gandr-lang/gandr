data Sig(a : Type, b : +U (a -> -F Type)) : Type where
  | MkSig : (x : a, y : b(x)) --> Sig a b
data IR(d : Type) : Type[+, 1] where
  | Iota : (e : d) --> IR d
  | DeltaC : (a : Type, f : (a -> d) -> IR d) --> IR d
def rec args(d : Type, c : IR d, x : Type, t : x -> d) -> Type =
  match c where
    | Iota(e) => return Unit
    | DeltaC(a, f) => return (Sig (a -> x) fun (h) { args[<] d (f fun (z) { t (h z) }) x t })
def keep(d : Type, c : IR d, x : Type, t : x -> d, w : args(d, c, x, t)) -> Unit =
  *{}
def delta(
  d : Type,
  a : Type,
  f : (a -> d) -> IR d,
  x : Type,
  t : x -> d,
  v : args(d, (DeltaC a f : IR d), x, t)
) -> Unit =
  match v where
    | MkSig(h, r) => keep d (f fun (z) { t (h z) }) x t r
