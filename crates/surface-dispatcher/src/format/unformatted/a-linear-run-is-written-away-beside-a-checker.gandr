data Nat : Type where { | Zero : Nat | Succ : (n : Nat) --> Nat }

def twice(n : Nat) -> Nat { Succ (Succ n) }

def second(a : Nat, b : Nat) -> Nat { b }

def make(n : Nat) -> () -> Nat { thunk { twice n } }

def apply(t : () -> Nat) -> Nat { force t }

def field(n : Nat) -> Nat {
  let m = twice n;
  Succ m
}

def paired(n : Nat) -> Nat {
  let p = twice n;
  let q = twice Zero;
  second p q
}

def chained(n : Nat) -> Nat {
  let a = twice n;
  let b = twice a;
  become twice b
}

def suspended(n : Nat) -> Nat {
  let t = make n;
  apply t
}
