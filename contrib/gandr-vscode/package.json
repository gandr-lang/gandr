{
  "name": "gandr-vscode",
  "displayName": "gandr",
  "version": "0.1.0",
  "private": true,
  "description": "gandr language support for Visual Studio Code",
  "categories": [
    "Programming Languages"
  ],
  "license": "Apache-2.0 WITH LLVM-exception",
  "repository": {
    "type": "git",
    "url": "https://github.com/gandr-lang/gandr",
    "directory": "contrib/gandr-vscode"
  },
  "publisher": "gandr-lang",
  "main": "./dist/extension.js",
  "scripts": {
    "bundle": "esbuild dist/src/extension.js --bundle --minify --outfile=dist/extension.js --platform=node --format=cjs --target=node24 --external:vscode",
    "clean": "rimraf dist",
    "compile": "aube run clean && tsc -p ./",
    "package": "vsce package --no-dependencies --skip-license",
    "vscode:prepublish": "aube run compile && aube run bundle",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.2"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^24.19.2",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "contributes": {
    "configuration": {
      "title": "gandr",
      "properties": {
        "gandr.diagnostics.verbosity": {
          "type": "string",
          "enum": [
            "user",
            "detailed",
            "debug",
            "json"
          ],
          "enumDescriptions": [
            "The message, the labels, the nested reasons and the note.",
            "Adds the report's class, the checker's own wording and the offending source text.",
            "Adds every locus's byte span and the checker's refusal as its implementers print it.",
            "The whole report as one line of JSON, for tools and agents."
          ],
          "default": "user",
          "markdownDescription": "How much of each report a diagnostic shows, as `gandr check --verbosity` chooses it."
        },
        "gandr.diagnostics.quiet": {
          "type": "number",
          "minimum": 0,
          "default": 1.5,
          "markdownDescription": "Seconds a file goes without a change before a diagnostic of the form being typed shows. A diagnostic elsewhere shows at once; `0` shows every diagnostic at once."
        },
        "gandr.inlineCompletion.trigger": {
          "type": "string",
          "enum": [
            "invoked",
            "automatic"
          ],
          "enumDescriptions": [
            "Ghost text shows only when asked for, with **Trigger Inline Suggestion** (`Alt+\\`).",
            "Ghost text shows as you type."
          ],
          "default": "invoked",
          "markdownDescription": "When the expected syntax shows as ghost text."
        },
        "gandr.presentation.form": {
          "type": "string",
          "enum": [
            "sugared",
            "explicit"
          ],
          "enumDescriptions": [
            "Every sugar the surface reads where the type has its shape: `A => B`, `A * B`, `A + B`, `C & D`, `(a, b)`.",
            "The formers the core is made of: `+U (A -> -F B)`, `#{A, B}`, `+{A, B}`, `&{C, D}`, `#{a, b}`."
          ],
          "default": "sugared",
          "markdownDescription": "How a hover spells a type. **gandr: Toggle sugared/explicit types** flips it."
        },
        "gandr.presentation.spelling": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "unicode",
            "ascii"
          ],
          "enumDescriptions": [
            "The spelling `presentation.spelling` names in the user's `gandr/config.toml`, else Unicode.",
            "Each glyph: `≃`, `≅`, `⇝`, `∷`.",
            "Each glyph's ASCII spelling: `<~>`, `Iso(A, B)`, `~~>`, `::`."
          ],
          "default": null,
          "markdownDescription": "How a hover and a diagnostic write a construct that has a glyph, as `gandr --spelling` chooses it. Unset, the server follows the user's configuration file."
        }
      }
    },
    "colors": [
      {
        "id": "gandr.hover.keyword",
        "description": "The colour of a keyword in a hover, as the `keyword` semantic token.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#AF00DB",
          "highContrast": "#C586C0",
          "highContrastLight": "#B5200D"
        }
      },
      {
        "id": "gandr.hover.boolean",
        "description": "The colour of a boolean literal in a hover, as the `keyword` semantic token.",
        "defaults": {
          "dark": "#C586C0",
          "light": "#AF00DB",
          "highContrast": "#C586C0",
          "highContrastLight": "#B5200D"
        }
      },
      {
        "id": "gandr.hover.operator",
        "description": "The colour of an operator in a hover, as the `operator` semantic token.",
        "defaults": {
          "dark": "#D4D4D4",
          "light": "#000000",
          "highContrast": "#D4D4D4",
          "highContrastLight": "#000000"
        }
      },
      {
        "id": "gandr.hover.functionDef",
        "description": "The colour of a defined function name in a hover, as the `function` semantic token.",
        "defaults": {
          "dark": "#DCDCAA",
          "light": "#795E26",
          "highContrast": "#DCDCAA",
          "highContrastLight": "#5E2CBC"
        }
      },
      {
        "id": "gandr.hover.functionCall",
        "description": "The colour of a called function name in a hover, as the `function` semantic token.",
        "defaults": {
          "dark": "#DCDCAA",
          "light": "#795E26",
          "highContrast": "#DCDCAA",
          "highContrastLight": "#5E2CBC"
        }
      },
      {
        "id": "gandr.hover.variableDef",
        "description": "The colour of a defined value or binder name in a hover, as the `variable` semantic token.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "gandr.hover.variable",
        "description": "The colour of a variable reference in a hover, as the `variable` semantic token.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "gandr.hover.variableParam",
        "description": "The colour of a parameter binder in a hover, as the `parameter` semantic token.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "gandr.hover.member",
        "description": "The colour of a record or co-record member in a hover, as the `property` semantic token.",
        "defaults": {
          "dark": "#9CDCFE",
          "light": "#001080",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#001080"
        }
      },
      {
        "id": "gandr.hover.constructor",
        "description": "The colour of a constructor in a hover, as the `enumMember` semantic token.",
        "defaults": {
          "dark": "#4FC1FF",
          "light": "#0070C1",
          "highContrast": "#9CDCFE",
          "highContrastLight": "#02715D"
        }
      },
      {
        "id": "gandr.hover.type",
        "description": "The colour of a type name in a hover, as the `type` semantic token.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#267F99",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#185E73"
        }
      },
      {
        "id": "gandr.hover.typeBuiltin",
        "description": "The colour of a built-in type in a hover, as the `type.defaultLibrary` semantic token.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#267F99",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#185E73"
        }
      },
      {
        "id": "gandr.hover.typeVariable",
        "description": "The colour of a type variable in a hover, as the `typeParameter` semantic token.",
        "defaults": {
          "dark": "#4EC9B0",
          "light": "#267F99",
          "highContrast": "#4EC9B0",
          "highContrastLight": "#185E73"
        }
      },
      {
        "id": "gandr.hover.number",
        "description": "The colour of a numeric literal in a hover, as the `number` semantic token.",
        "defaults": {
          "dark": "#B5CEA8",
          "light": "#098658",
          "highContrast": "#B5CEA8",
          "highContrastLight": "#096D48"
        }
      },
      {
        "id": "gandr.hover.stringLit",
        "description": "The colour of a string literal in a hover, as the `string` semantic token.",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515",
          "highContrast": "#CE9178",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "gandr.hover.character",
        "description": "The colour of a character literal in a hover, as the `string` semantic token.",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515",
          "highContrast": "#CE9178",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "gandr.hover.escape",
        "description": "The colour of an escape sequence in a hover, as the `string` semantic token.",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515",
          "highContrast": "#CE9178",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "gandr.hover.path",
        "description": "The colour of a shell word or path in a hover, as the `string` semantic token.",
        "defaults": {
          "dark": "#CE9178",
          "light": "#A31515",
          "highContrast": "#CE9178",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "gandr.hover.comment",
        "description": "The colour of a comment in a hover, as the `comment` semantic token.",
        "defaults": {
          "dark": "#6A9955",
          "light": "#008000",
          "highContrast": "#7CA668",
          "highContrastLight": "#515151"
        }
      },
      {
        "id": "gandr.hover.hole",
        "description": "The colour of a typed hole in a hover, as the `macro` semantic token.",
        "defaults": {
          "dark": "#569CD6",
          "light": "#0000FF",
          "highContrast": "#DCDCAA",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "gandr.hover.directive",
        "description": "The colour of a directive in a hover, as the `macro` semantic token.",
        "defaults": {
          "dark": "#569CD6",
          "light": "#0000FF",
          "highContrast": "#DCDCAA",
          "highContrastLight": "#0F4A85"
        }
      },
      {
        "id": "gandr.hover.label",
        "description": "The colour of a label in a hover, as the `label` semantic token.",
        "defaults": {
          "dark": "editorHoverWidget.foreground",
          "light": "editorHoverWidget.foreground",
          "highContrast": "editorHoverWidget.foreground",
          "highContrastLight": "editorHoverWidget.foreground"
        }
      }
    ],
    "commands": [
      {
        "command": "gandr.toggleForm",
        "title": "Toggle sugared/explicit types",
        "category": "gandr"
      },
      {
        "command": "gandr.showSyntaxTree",
        "title": "Show syntax tree",
        "category": "gandr",
        "enablement": "editorLangId == gandr"
      }
    ],
    "grammars": [
      {
        "language": "gandr",
        "scopeName": "source.gandr",
        "path": "./syntaxes/gandr.tmLanguage.json"
      }
    ],
    "languages": [
      {
        "id": "gandr",
        "extensions": [
          ".gandr"
        ],
        "configuration": "./languages/gandr/language-configuration.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "value",
        "description": "A name read as a value: a binder, a constructor, an argument passed along."
      },
      {
        "id": "computation",
        "description": "A name run as a computation: a thunk forced where it is written, as a call forces the function it names."
      }
    ]
  },
  "activationEvents": [
    "workspaceContains:**/*.gandr"
  ],
  "extensionKind": [
    "workspace"
  ],
  "engines": {
    "vscode": "^1.140.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "enabledApiProposals": []
}
