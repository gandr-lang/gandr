// `math.path`: the algebra of paths, written as library definitions.
//
// The composites of naturality and coherence state their types in a
// path's endpoints and its action under a function. The native forms
// `then` and `cong` synthesise their types from their operands, so a
// statement over a variable function needs the endpoints written. A
// reflexivity reads its type off its point (#3834). These definitions write
// the endpoints, and prove the groupoid laws of composition beside them.
//
// Each law is a definition at its path type. The associator and the left
// unitor go by based path induction on their last path, the telescope
// form of `transport`. The right unitor holds by conversion, because a
// composite with a reflexivity on the right reduces to its left operand.
// The whiskers are `ap` of a composition with a fixed path.
//
// `apComp` is `ap`'s functoriality, and `natural` is a homotopy's
// naturality along a path. Both go by based path induction on the path.
// `natural` is the naturality operation at one variable, the `Path`
// family's filler. Its type is written in `join` and `ap`, the family's
// composite and action, so a generator over the family takes it by name.
//
// - see: #3711 — the naturality meta-operation these definitions serve
// - see: #3922 — `natural`, and `assoc_nat` as its instance
// - see: #628 — `math` beside `std`, and the groupoid laws it holds

/// The composite of two paths, whose type states its endpoints.
pub def join(A : Type, x : A, y : A, z : A, p : Path(A, x, y), q : Path(A, y, z)) -> Path(A, x, z) {
  p then q
}

/// A function's action on a path, whose type states its endpoints.
pub def ap(A : Type, B : Type, F : A => B, x : A, y : A, p : Path(A, x, y)) -> Path(B, F(x), F(y)) {
  cong(F, p)
}

/// The left whisker: a path composed before a path of paths, by the action of composing with it.
pub def whiskerLeft(
  A : Type,
  x : A,
  y : A,
  z : A,
  f : Path(A, x, y),
  g1 : Path(A, y, z),
  g2 : Path(A, y, z),
  b : Path(Path(A, y, z), g1, g2)
) -> Path(Path(A, x, z), f then g1, f then g2) {
  ap(
    Path(A, y, z),
    Path(A, x, z),
    (fn (q : Path(A, y, z)) { f then q } : Path(A, y, z) => Path(A, x, z)),
    g1,
    g2,
    b
  )
}

/// The right whisker: a path composed after a path of paths, by the action of composing with it.
pub def whiskerRight(
  A : Type,
  x : A,
  y : A,
  z : A,
  f1 : Path(A, x, y),
  f2 : Path(A, x, y),
  a : Path(Path(A, x, y), f1, f2),
  g : Path(A, y, z)
) -> Path(Path(A, x, z), f1 then g, f2 then g) {
  ap(
    Path(A, x, y),
    Path(A, x, z),
    (fn (q : Path(A, x, y)) { q then g } : Path(A, x, y) => Path(A, x, z)),
    f1,
    f2,
    a
  )
}

/// A dependent function's action on a path: its value at the start carried along the path meets its value at the end.
pub def apd(
  A : Type,
  P : A => Type,
  F : (a : A) => P(a),
  x : A,
  y : A,
  p : Path(A, x, y)
) -> Path(P(y), transport(\a. P(a), p, F(x)), F(y)) {
  transport(
    (v : A, k : Path(A, x, v)) => Path(P(v), transport(\a. P(a), k, F(x)), F(v)),
    p,
    here(x),
    here(p),
    here(F(x))
  )
}

/// The action of a composite is the action of the outer function on the inner action, by based path induction on the path.
pub def apComp(
  A : Type,
  B : Type,
  C : Type,
  F : A => B,
  G : B => C,
  x : A,
  y : A,
  p : Path(A, x, y)
) -> Path(
  Path(C, G(F(x)), G(F(y))),
  ap(A, C, (fn (a : A) { G(F(a)) } : A => C), x, y, p),
  ap(B, C, G, F(x), F(y), ap(A, B, F, x, y, p))
) {
  transport(
    (v : A, k : Path(A, x, v)) => Path(
      Path(C, G(F(x)), G(F(v))),
      ap(A, C, (fn (a : A) { G(F(a)) } : A => C), x, v, k),
      ap(B, C, G, F(x), F(v), ap(A, B, F, x, v, k))
    ),
    p,
    here(x),
    here(p),
    here(here(G(F(x))))
  )
}

/// The associator: composition is associative, by based path induction on the last path.
pub def assoc(
  A : Type,
  x : A,
  y : A,
  z : A,
  w : A,
  f : Path(A, x, y),
  g : Path(A, y, z),
  h : Path(A, z, w)
) -> Path(Path(A, x, w), (f then g) then h, f then (g then h)) {
  transport(
    (v : A, k : Path(A, z, v)) => Path(Path(A, x, v), (f then g) then k, f then (g then k)),
    h,
    here(z),
    here(h),
    here(f then g)
  )
}

/// The left unitor: a reflexivity composed on the left leaves a path, by based path induction on it.
pub def leftUnit(A : Type, x : A, y : A, p : Path(A, x, y)) -> Path(
  Path(A, x, y),
  join(A, x, x, y, here(x), p),
  p
) {
  transport(
    (v : A, k : Path(A, x, v)) => Path(Path(A, x, v), join(A, x, x, v, here(x), k), k),
    p,
    here(x),
    here(p),
    here(here(x))
  )
}

/// The right unitor: a reflexivity composed on the right leaves a path, by conversion.
pub def rightUnit(A : Type, x : A, y : A, p : Path(A, x, y)) -> Path(
  Path(A, x, y),
  join(A, x, y, y, p, here(y)),
  p
) {
  here(p)
}

/// A homotopy's naturality along a path: the homotopy at the start then `G`'s action meets `F`'s action then the homotopy at the end, by based path induction on the path.
pub def natural(
  A : Type,
  B : Type,
  F : A => B,
  G : A => B,
  H : (q : A) => Path(B, F(q), G(q)),
  a : A,
  b : A,
  p : Path(A, a, b)
) -> Path(
  Path(B, F(a), G(b)),
  join(B, F(a), G(a), G(b), H(a), ap(A, B, G, a, b, p)),
  join(B, F(a), F(b), G(b), ap(A, B, F, a, b, p), H(b))
) {
  transport(
    (v : A, k : Path(A, a, v)) => Path(
      Path(B, F(a), G(v)),
      join(B, F(a), G(a), G(v), H(a), ap(A, B, G, a, v, k)),
      join(B, F(a), F(v), G(v), ap(A, B, F, a, v, k), H(v))
    ),
    p,
    here(a),
    here(p),
    here(H(a))
  )
}
