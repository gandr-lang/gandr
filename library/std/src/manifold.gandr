// `std.manifold`: the theories a site's file and a manifold's file are read
// from. A site is one place a world runs at, its file declaring `module Site
// : Model(Site)` and exporting it packed as `pub def site : Model(Site)`. A
// manifold binds a program's worlds onto sites, its file declaring `module
// Manifold : Model(Manifold)` beside the `placements` it lists. `gandr host
// --site` and `gandr run --manifold` read them as the `--net-bind`,
// `--net-secret` and `--world` flags they desugar to (#3374), the secret read
// by its name (#3375). Neither enters the program's identity: a deployment
// binds a program to places and never addresses it.
//
// A site's file may declare beside its site `pub module Offers : Model(T)`,
// what the site offers a world placed there. A program's world written
// `world w requires R ;` is placed only at a site whose `Offers` packs at
// `Model(R)`, which `gandr check` of the manifold judges before any process
// starts; a site declaring no `Offers` offers nothing (#3376).

/// One place a world runs at: the key it proves, where it is reached, and the
/// name of the key's secret. The hosting process reads the secret by that
/// name through a model of `std.secret`'s `Secrets`; the file never holds it.
pub theory Site {
  /// The public key the site proves, 64 hexadecimal digits.
  oper key : String;
  /// The sockets the site binds and is dialled at, each `ip:port`, as one
  /// line of `,`-separated entries until an operation's port can be a list
  /// (#2993); empty when the site is found by its key alone, over multicast
  /// DNS.
  oper sockets : String;
  /// The name of the key's secret, which the hosting process reads as 64
  /// hexadecimal digits.
  oper secret : String;
}

/// The binding of a program's worlds onto sites: the program it deploys,
/// beside the `placements` its file lists as `pub def placements :
/// List(Placement)`, a definition of its own until an operation's port can be
/// a list (#2993).
pub theory Manifold {
  /// The program deployed: the path of its source, read from the manifold's
  /// file.
  oper artifact : String;
}

/// One world of the program bound to a site, the site's model as its file
/// exports it: `At("far", far.site)`. The manifold imports each site's file,
/// and a site is matched to its file by its key.
pub data Placement : Type {
  /// The world `name` run as one process at the site.
  At : (name : String, site : Model(Site)) --> Placement;
  /// The world `name` run as `count` processes at the site.
  Instances : (name : String, site : Model(Site), count : Integer) --> Placement;
}
