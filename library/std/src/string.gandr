// `std.string`: the native string's everyday functions, each over the native
// `string` namespace, and the laws of joining beside them. Equality and order
// are the prelude's `==` and `<`, through its `Eq` and `Ord` models of
// strings. A rule names only its own block's operations, so the laws are
// stated over joining presented as an operation (#525 admits a law over the
// definition itself). Scanning a string waits on its primitives (#318).

/// The empty string, the unit of joining.
pub def empty : String = "";

/// The string `a` followed by the string `b`.
pub def concat(a : String, b : String) -> String {
  string.append(a, b)
}

/// Whether `s` is the empty string.
pub def isEmpty(s : String) -> Bool {
  s == empty
}

/// The laws of `concat` and `empty`: joining is associative and the empty
/// string is its unit on both sides, so strings under joining are a monoid.
/// The coincidence check certifies the three rules, and the row fires them.
@[ normalizes("concat(concat(empty, empty), concat(empty, empty)) ~> empty") ]
pub theory Strings {
  /// The strings, as the sort the laws range over.
  sort S : Type;

  /// The empty string, `std.string`'s `empty`.
  oper empty : S;
  /// Joining, `std.string`'s `concat`.
  oper concat : (a : S, b : S) --> S;

  /// The empty string on the left of a join leaves the other string.
  rule unitLeft : concat(empty(), s) <=> s;
  /// The empty string on the right of a join leaves the other string.
  rule unitRight : concat(s, empty()) <=> s;
  /// Joining is associative: a join of three strings is one string.
  rule assoc : concat(concat(x, y), z) <=> concat(x, concat(y, z));
}
