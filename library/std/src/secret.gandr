// `std.secret`: a secret and the theory that reads one by name. A `Secret.T`
// holds its text under a seal with no mark: `seal` puts text in, and no member
// reads it back. The checker refuses its crossing to another world, the
// printer spells it opaque at `Secret`, and no module of `std` compares two.
//
// Where the text comes from is a model of `Secrets`, which the user writes. A
// site names its key's secret, and the hosting process reads it through the
// model `gandr host --secrets` names. Without that model it reads the
// environment variable `GANDR_SECRET_<NAME>`. A model's operation is pure, so
// a handler that decrypts runs before gandr does, and hands over its source.
//
// - see: #3375

/// A secret: text with a way in and no way out.
pub module Secret :> *{
  type T,
  seal : String -> T
} where
  /// The text, inside the seal.
  type T = String;
  /// The seal around the text.
  def seal(text : String) -> String { text }

/// Secrets by name: a name reads as a secret of the sort `K`, which a handler
/// fixes at `Secret.T`.
pub theory Secrets where
  /// What a name reads as.
  sort K : Type+;
  /// The secret `name` names.
  oper secret : (name : String) --> K;
