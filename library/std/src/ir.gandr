// `std.ir`: Dybjer and Setzer's codes for inductive-recursive definitions,
// as data, with the arguments a code asks for and their decode.
//
// A code describes a family and its decoder at once. A code asks for a value
// of a type, for values of the family, or for a stop. The values of the
// family come through their decodes. A stop names one decode.
//
// The codes are a large type: a field of a code holds a type. `args` gives
// the type of the arguments a code asks for over a family `x`, which `t`
// decodes. `decodeArgs` decodes those arguments. Each recurses on the code.
//
// Each of the four holds a role by its `builtin` mark: `Sig` holds `irPair`,
// `IR` holds `irSignature`, `args` holds `irArgs` and `decodeArgs` holds
// `irDecode`. A role has one holder, and the checker refuses a second. The
// checker compares each holder with the canonical form of its role, and
// `args` and `decodeArgs` with the canonical bodies at each code.
//
// - owes: #3575 — the core formers that read the four by role
// - cites: [Dybjer-1999-finite_axiomatization_inductiverecursive_definitions]
//
// [Dybjer-1999-finite_axiomatization_inductiverecursive_definitions]: https://doi.org/10.1007/3-540-48959-2_11 "Dybjer and Setzer, A finite axiomatization of inductive-recursive definitions"

/// The dependent pairs over a family of types, as data.
@[ builtin(irPair) ]
pub data Sig(a : Type, b : a -> Type) : Type where
  /// A value of the first type with a value of the type it picks.
  | MkSig : (x : a, y : b(x)) --> Sig(a, b)

/// The codes over a type of decodes `d`, a large type.
@[ builtin(irSignature) ]
pub data IR(d : Type) : Type[+, 1] where
  /// No argument, the decode `e`.
  | Iota : (e : d) --> IR(d)
  /// A value of the type `a`, and the code the rest reads it by.
  | SigmaC : (a : Type, f : a -> IR(d)) --> IR(d)
  /// A function from `a` into the family. The rest reads it through its
  /// decodes.
  | DeltaC : (a : Type, f : (a -> d) -> IR(d)) --> IR(d)

/// The arguments a code asks for over a family `x`. The function `t` decodes
/// the family.
@[ builtin(irArgs) ]
pub def rec args(d : Type, c : IR(d), x : Type, t : x -> d) -> Type =
  match c where
    | Iota(e) => return Unit
    | SigmaC(a, f) => return (Sig a (fun (y) { args[<] d (f y) x t }))
    | DeltaC(a, f) => return (Sig (a -> x) (fun (h) { args[<] d (f (fun (z) { t (h z) })) x t }))

/// The decode of the arguments a code asks for. The code's case refines their
/// type, since the marked call stages the code.
@[ builtin(irDecode), form(explicit) ]
pub def rec decodeArgs(d : Type, c : IR(d), x : Type, t : x -> d, v : args(d, c, x, t)) -> d =
  match c where
    | Iota(e) => e
    | SigmaC(a, f) => match v where
      | MkSig(y, r) => decodeArgs[<] d (f y) x t r
    | DeltaC(a, f) => match v where
      | MkSig(h, r) => decodeArgs[<] d (f (fun (z) { t (h z) })) x t r
