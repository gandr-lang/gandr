// `std`: the standard library, a package like any other. Its modules and the
// host seams they stand on are mapped in `../README.md`; `std.package` is the
// first to land. Until a package imports another by name (#533 p3), a
// project imports `std.package` by the relative path to its source.
import package (Gandr);

/// The package: `std`, at the version `gandr.toml` records.
pub module Package : Model(Gandr.Package) {
  /// The package's name, `std`.
  def name = "std";
  /// The version `std` releases at.
  def version = "0.1.0";
}
