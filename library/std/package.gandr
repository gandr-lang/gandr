// `std`: the standard library, a package like any other. Its README maps its
// modules and the host seams they stand on. Until a package imports another
// by name, a project imports a module of `std` by the relative path to its
// source.
//
// - see: `README.md` — the map of modules and host seams
// - owes: #533 — a package importing another by name
import build (Gandr);

/// The package: `std`, at the version `gandr.toml` records.
pub module Package : Model(Gandr.Package) where {
  /// The package's name, `std`.
  def name = "std";
  /// The version `std` releases at.
  def version = "0.1.0";
  /// The authors of `std`.
  def authors = "The gandr authors";
  /// The licence `std` carries, an SPDX expression.
  def licence = "MIT OR Apache-2.0";
  /// The address the documentation of `std` stands at.
  def documentation = "https://github.com/gandr-lang/gandr/tree/main/library/std";
  /// The address a resolver may fetch `std` from.
  def endpoint = "https://github.com/gandr-lang/gandr";
  /// The least language version `std` targets.
  def gandr = ">= 0.0";
  /// The features `std` asks the toolchain for: none it names yet.
  def features = "";
  /// The systems `std` builds on: any.
  def systems = "";
  /// The spelling `std` asks for: the reader's own.
  def spelling = "";
  /// The directory the modules of `std` sit under.
  def sources = "src";
}
